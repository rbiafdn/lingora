[
  {"id":"de-idiom-ich-verstehe-nur-bahnhof","languageId":"de","category":"idioms","level":"B1","sourceText":"Ich verstehe nur Bahnhof.","translations":{"tr":["hiçbir şey anlamıyorum"]},"details":{"explanation":"Söylenenden hiçbir şey anlamadığını belirtmek."},"examples":[{"text":"Der Lehrer erklärt Physik, aber ich verstehe nur Bahnhof.","tr":"Öğretmen fizik anlatıyor ama hiçbir şey anlamıyorum."}]},
  {"id":"de-idiom-das-ist-mir-wurst","languageId":"de","category":"idioms","level":"B1","sourceText":"Das ist mir Wurst.","translations":{"tr":["umurumda değil","bana fark etmez"]},"details":{"explanation":"Bir şeyin kişi için hiç önemli olmadığını söylemek."},"examples":[{"text":"Pizza oder Pasta? Das ist mir Wurst.","tr":"Pizza mı makarna mı? Bana fark etmez."}]},
  {"id":"de-idiom-die-nase-voll-haben","languageId":"de","category":"idioms","level":"B1","sourceText":"die Nase voll haben","translations":{"tr":["bıkmak","gına gelmek"]},"details":{"explanation":"Bir şeyden artık tamamen bıkmış olmak.","turkishEquivalent":"gına gelmek"},"examples":[{"text":"Ich habe die Nase voll von diesem Regen.","tr":"Bu yağmurdan bıktım artık."}]},
  {"id":"de-idiom-schwein-haben","languageId":"de","category":"idioms","level":"B1","sourceText":"Schwein haben","translations":{"tr":["şanslı olmak","şansı yaver gitmek"]},"details":{"explanation":"Beklenmedik biçimde şanslı olmak."},"examples":[{"text":"Der Bus war schon weg, aber ich hatte Schwein: Er kam zurück.","tr":"Otobüs gitmişti ama şansım yaver gitti, geri geldi."}]},
  {"id":"de-idiom-hals-und-beinbruch","languageId":"de","category":"idioms","level":"B1","sourceText":"Hals- und Beinbruch!","translations":{"tr":["bol şans!","başarılar!"]},"details":{"explanation":"Özellikle bir sınav ya da gösteri öncesi şans dilemek için söylenir."},"examples":[{"text":"Morgen ist deine Premiere? Hals- und Beinbruch!","tr":"Yarın galan mı var? Bol şans!"}]},
  {"id":"de-idiom-jemandem-auf-den-keks-gehen","languageId":"de","category":"idioms","level":"B1","sourceText":"jemandem auf den Keks gehen","translations":{"tr":["sinirini bozmak","bıktırmak"]},"details":{"explanation":"Birini sürekli rahatsız ederek sinirlendirmek.","turkishEquivalent":"sinirine dokunmak"},"examples":[{"text":"Dein ständiges Pfeifen geht mir auf den Keks.","tr":"Durmadan ıslık çalman sinirimi bozuyor."}]},
  {"id":"de-idiom-alles-in-butter","languageId":"de","category":"idioms","level":"B1","sourceText":"Alles in Butter.","translations":{"tr":["her şey yolunda"]},"details":{"explanation":"Her şeyin sorunsuz ve düzgün olduğunu söylemek."},"examples":[{"text":"Keine Sorge, alles in Butter!","tr":"Merak etme, her şey yolunda!"}]},
  {"id":"de-idiom-ich-glaub-ich-spinne","languageId":"de","category":"idioms","level":"B1","sourceText":"Ich glaub, ich spinne!","translations":{"tr":["inanamıyorum!","bu da ne!"]},"details":{"explanation":"Şaşkınlık ya da öfke belirtir."},"examples":[{"text":"Ich glaub, ich spinne! Wer hat mein Auto zugeparkt?","tr":"İnanamıyorum! Arabamın önünü kim kapattı?"}]},
  {"id":"de-idiom-den-kopf-verlieren","languageId":"de","category":"idioms","level":"B1","sourceText":"den Kopf verlieren","translations":{"tr":["paniğe kapılmak","kendini kaybetmek"]},"details":{"explanation":"Heyecan ya da korkudan sakin düşünemez olmak."},"examples":[{"text":"Bleib ruhig und verlier nicht den Kopf.","tr":"Sakin ol ve paniğe kapılma."}]},
  {"id":"de-idiom-unter-vier-augen","languageId":"de","category":"idioms","level":"B1","sourceText":"unter vier Augen","translations":{"tr":["baş başa","özel olarak"]},"details":{"explanation":"Başkaları olmadan, iki kişi arasında.","turkishEquivalent":"baş başa"},"examples":[{"text":"Kann ich dich kurz unter vier Augen sprechen?","tr":"Seninle biraz baş başa konuşabilir miyim?"}]},
  {"id":"de-idiom-jemanden-aus-den-augen-verlieren","languageId":"de","category":"idioms","level":"B1","sourceText":"jemanden aus den Augen verlieren","translations":{"tr":["gözden kaybetmek","bağlantıyı kaybetmek"]},"details":{"explanation":"Biriyle zamanla iletişimi kaybetmek."},"examples":[{"text":"Nach der Schule haben wir uns aus den Augen verloren.","tr":"Okuldan sonra birbirimizi kaybettik."}]},
  {"id":"de-idiom-grosse-augen-machen","languageId":"de","category":"idioms","level":"B1","sourceText":"große Augen machen","translations":{"tr":["şaşırmak","gözleri büyümek"]},"details":{"explanation":"Çok şaşırmak ya da hayran kalmak.","turkishEquivalent":"gözleri fal taşı gibi açılmak"},"examples":[{"text":"Die Kinder machten große Augen, als sie die Geschenke sahen.","tr":"Çocukların hediyeleri görünce gözleri fal taşı gibi açıldı."}]},
  {"id":"de-idiom-seinen-augen-nicht-trauen","languageId":"de","category":"idioms","level":"B1","sourceText":"seinen Augen nicht trauen","translations":{"tr":["gözlerine inanamamak"]},"details":{"explanation":"Gördüğü şeye çok şaşırmak.","turkishEquivalent":"gözlerine inanamamak"},"examples":[{"text":"Ich traute meinen Augen nicht: Da stand mein alter Freund!","tr":"Gözlerime inanamadım: Karşımda eski arkadaşım duruyordu!"}]},
  {"id":"de-idiom-immer-der-nase-nach","languageId":"de","category":"idioms","level":"B1","sourceText":"immer der Nase nach","translations":{"tr":["dümdüz git","burnunun dikine"]},"details":{"explanation":"Dönmeden dümdüz ilerlemek."},"examples":[{"text":"Zum Bahnhof? Immer der Nase nach!","tr":"İstasyona mı? Hep dümdüz git!"}]},
  {"id":"de-idiom-von-ganzem-herzen","languageId":"de","category":"idioms","level":"B1","sourceText":"von ganzem Herzen","translations":{"tr":["candan","tüm kalbiyle"]},"details":{"explanation":"İçtenlikle, gerçekten.","turkishEquivalent":"can-ı gönülden"},"examples":[{"text":"Ich danke dir von ganzem Herzen.","tr":"Sana can-ı gönülden teşekkür ederim."}]},
  {"id":"de-idiom-jemandem-das-herz-brechen","languageId":"de","category":"idioms","level":"B1","sourceText":"jemandem das Herz brechen","translations":{"tr":["kalbini kırmak"]},"details":{"explanation":"Birini aşk ya da sevgi konusunda derinden üzmek.","turkishEquivalent":"kalbini kırmak"},"examples":[{"text":"Sie hat ihm das Herz gebrochen.","tr":"Onun kalbini kırdı."}]},
  {"id":"de-idiom-mit-leeren-handen-dastehen","languageId":"de","category":"idioms","level":"B1","sourceText":"mit leeren Händen dastehen","translations":{"tr":["eli boş kalmak"]},"details":{"explanation":"Hiçbir şey elde edememek.","turkishEquivalent":"eli boş dönmek"},"examples":[{"text":"Nach der Trennung stand sie mit leeren Händen da.","tr":"Ayrılıktan sonra eli boş kaldı."}]},
  {"id":"de-idiom-schmetterlinge-im-bauch-haben","languageId":"de","category":"idioms","level":"B1","sourceText":"Schmetterlinge im Bauch haben","translations":{"tr":["âşık olmak","heyecanlanmak"]},"details":{"explanation":"Âşık olunca hissedilen heyecanı yaşamak."},"examples":[{"text":"Wenn ich ihn sehe, habe ich Schmetterlinge im Bauch.","tr":"Onu görünce içim kıpır kıpır oluyor."}]},
  {"id":"de-idiom-hundemude-sein","languageId":"de","category":"idioms","level":"B1","sourceText":"hundemüde sein","translations":{"tr":["çok yorgun olmak"]},"details":{"explanation":"Aşırı derecede yorgun olmak.","turkishEquivalent":"leş gibi yorgun olmak"},"examples":[{"text":"Nach der Wanderung war ich hundemüde.","tr":"Yürüyüşten sonra leş gibi yorgundum."}]},
  {"id":"de-idiom-gansehaut-bekommen","languageId":"de","category":"idioms","level":"B1","sourceText":"Gänsehaut bekommen","translations":{"tr":["ürpermek","tüyleri diken diken olmak"]},"details":{"explanation":"Korku, soğuk ya da güçlü bir duyguyla ürpermek.","turkishEquivalent":"tüyleri diken diken olmak"},"examples":[{"text":"Bei diesem Lied bekomme ich immer Gänsehaut.","tr":"Bu şarkıda hep tüylerim diken diken olur."}]},
  {"id":"de-idiom-keinen-bock-haben","languageId":"de","category":"idioms","level":"B1","sourceText":"keinen Bock haben","translations":{"tr":["canı istememek","hevesi olmamak"]},"details":{"explanation":"Bir şeyi yapmayı hiç istememek (gündelik dil)."},"examples":[{"text":"Ich habe heute keinen Bock auf Hausaufgaben.","tr":"Bugün hiç ödev yapasım yok."}]},
  {"id":"de-idiom-einen-barenhunger-haben","languageId":"de","category":"idioms","level":"B1","sourceText":"einen Bärenhunger haben","translations":{"tr":["çok acıkmak"]},"details":{"explanation":"Çok aç olmak.","turkishEquivalent":"kurt gibi acıkmak"},"examples":[{"text":"Nach dem Sport habe ich einen Bärenhunger.","tr":"Spordan sonra kurt gibi acıkıyorum."}]},
  {"id":"de-idiom-zwei-fliegen-mit-einer-klappe-schlagen","languageId":"de","category":"idioms","level":"B1","sourceText":"zwei Fliegen mit einer Klappe schlagen","translations":{"tr":["tek hamlede iki iş görmek"]},"details":{"explanation":"Tek bir eylemle iki amaca ulaşmak.","turkishEquivalent":"bir taşla iki kuş vurmak"},"examples":[{"text":"Wenn ich mit dem Rad fahre, schlage ich zwei Fliegen mit einer Klappe: Sport und Geld sparen.","tr":"Bisikletle gidince bir taşla iki kuş vuruyorum: hem spor hem tasarruf."}]},
  {"id":"de-idiom-einen-kater-haben","languageId":"de","category":"idioms","level":"B1","sourceText":"einen Kater haben","translations":{"tr":["akşamdan kalma olmak"]},"details":{"explanation":"Çok içtikten sonraki gün kendini kötü hissetmek.","turkishEquivalent":"akşamdan kalma olmak"},"examples":[{"text":"Nach der Party hatte ich einen fürchterlichen Kater.","tr":"Partiden sonra fena akşamdan kalmaydım."}]},
  {"id":"de-idiom-das-ist-ein-katzensprung","languageId":"de","category":"idioms","level":"B1","sourceText":"Das ist ein Katzensprung.","translations":{"tr":["çok yakın","iki adım"]},"details":{"explanation":"Bir yerin çok yakın olduğunu söylemek.","turkishEquivalent":"iki adımlık yol"},"examples":[{"text":"Bis zum Strand ist es nur ein Katzensprung.","tr":"Plaj iki adımlık yol."}]},
  {"id":"de-idiom-rot-werden-wie-eine-tomate","languageId":"de","category":"idioms","level":"B1","sourceText":"rot werden wie eine Tomate","translations":{"tr":["kıpkırmızı olmak","utanmak"]},"details":{"explanation":"Utançtan yüzü kızarmak.","turkishEquivalent":"pancar gibi kızarmak"},"examples":[{"text":"Als er sie ansprach, wurde sie rot wie eine Tomate.","tr":"Onunla konuşunca pancar gibi kızardı."}]},
  {"id":"de-idiom-schwarzfahren","languageId":"de","category":"idioms","level":"B1","sourceText":"schwarzfahren","translations":{"tr":["biletsiz binmek"]},"details":{"explanation":"Toplu taşımada bilet almadan yolculuk etmek.","turkishEquivalent":"kaçak binmek"},"examples":[{"text":"Wer schwarzfährt, muss 60 Euro Strafe zahlen.","tr":"Biletsiz binen 60 avro ceza öder."}]}
]
