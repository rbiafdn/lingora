[
  {"id":"de-idiom-tomaten-auf-den-augen-haben","languageId":"de","category":"idioms","level":"B2","sourceText":"Tomaten auf den Augen haben","translations":{"tr":["görmemek","dikkatsiz olmak"]},"details":{"explanation":"Apaçık olan bir şeyi fark etmemek."},"examples":[{"text":"Hast du Tomaten auf den Augen? Das Schild ist doch riesig!","tr":"Gözün görmüyor mu? Tabela kocaman!"}]},
  {"id":"de-idiom-ins-fettnapfchen-treten","languageId":"de","category":"idioms","level":"B2","sourceText":"ins Fettnäpfchen treten","translations":{"tr":["pot kırmak","gaf yapmak"]},"details":{"explanation":"Farkında olmadan utandırıcı ya da kırıcı bir şey söylemek veya yapmak.","turkishEquivalent":"pot kırmak"},"examples":[{"text":"Mit der Frage nach seiner Ex-Frau bin ich voll ins Fettnäpfchen getreten.","tr":"Eski karısını sorarak fena pot kırdım."}]},
  {"id":"de-idiom-auf-dem-holzweg-sein","languageId":"de","category":"idioms","level":"B2","sourceText":"auf dem Holzweg sein","translations":{"tr":["yanılmak","yanlış yolda olmak"]},"details":{"explanation":"Bir konuda tamamen yanlış düşünmek ya da yanlış yöntem izlemek."},"examples":[{"text":"Wenn du glaubst, dass ich dir das Geld leihe, bist du auf dem Holzweg.","tr":"Sana o parayı vereceğimi sanıyorsan yanılıyorsun."}]},
  {"id":"de-idiom-die-katze-im-sack-kaufen","languageId":"de","category":"idioms","level":"B2","sourceText":"die Katze im Sack kaufen","translations":{"tr":["görmeden almak"]},"details":{"explanation":"Bir şeyi önceden incelemeden satın almak ya da kabul etmek."},"examples":[{"text":"Ich will das Auto erst sehen, ich kaufe doch nicht die Katze im Sack.","tr":"Arabayı önce görmek istiyorum, görmeden almam."}]},
  {"id":"de-idiom-die-katze-aus-dem-sack-lassen","languageId":"de","category":"idioms","level":"B2","sourceText":"die Katze aus dem Sack lassen","translations":{"tr":["sırrı açıklamak","ağzından kaçırmak"]},"details":{"explanation":"Gizli tutulan bir şeyi sonunda açıklamak.","turkishEquivalent":"baklayı ağzından çıkarmak"},"examples":[{"text":"Nach langem Zögern ließ er die Katze aus dem Sack: Er kündigt.","tr":"Uzun tereddütten sonra baklayı ağzından çıkardı: İstifa ediyor."}]},
  {"id":"de-idiom-das-ist-nicht-mein-bier","languageId":"de","category":"idioms","level":"B2","sourceText":"Das ist nicht mein Bier.","translations":{"tr":["beni ilgilendirmez","benim sorunum değil"]},"details":{"explanation":"Bir konunun kendi sorumluluğunda olmadığını söylemek."},"examples":[{"text":"Wie er sein Geld ausgibt, ist nicht mein Bier.","tr":"Parasını nasıl harcadığı beni ilgilendirmez."}]},
  {"id":"de-idiom-um-den-heissen-brei-herumreden","languageId":"de","category":"idioms","level":"B2","sourceText":"um den heißen Brei herumreden","translations":{"tr":["lafı dolandırmak"]},"details":{"explanation":"Asıl konuya gelmeden etrafında konuşmak.","turkishEquivalent":"lafı dolandırmak"},"examples":[{"text":"Hör auf, um den heißen Brei herumzureden, und sag die Wahrheit!","tr":"Lafı dolandırmayı bırak da doğruyu söyle!"}]},
  {"id":"de-idiom-auf-wolke-sieben-schweben","languageId":"de","category":"idioms","level":"B2","sourceText":"auf Wolke sieben schweben","translations":{"tr":["çok mutlu olmak","havalara uçmak"]},"details":{"explanation":"Özellikle aşık olduğu için çok mutlu olmak.","turkishEquivalent":"havalara uçmak"},"examples":[{"text":"Seit sie verliebt ist, schwebt sie auf Wolke sieben.","tr":"Âşık olduğundan beri havalara uçuyor."}]},
  {"id":"de-idiom-sich-zum-affen-machen","languageId":"de","category":"idioms","level":"B2","sourceText":"sich zum Affen machen","translations":{"tr":["kendini rezil etmek","maskara olmak"]},"details":{"explanation":"Gülünç davranarak kendini küçük düşürmek.","turkishEquivalent":"maskara olmak"},"examples":[{"text":"Ich tanze nicht, ich will mich nicht zum Affen machen.","tr":"Dans etmiyorum, kendimi rezil etmek istemem."}]},
  {"id":"de-idiom-wenn-man-vom-teufel-spricht","languageId":"de","category":"idioms","level":"B2","sourceText":"Wenn man vom Teufel spricht …","translations":{"tr":["iti an çomağı hazırla"]},"details":{"explanation":"Hakkında konuşulan kişi o anda ortaya çıktığında söylenir.","turkishEquivalent":"iti an çomağı hazırla"},"examples":[{"text":"Wenn man vom Teufel spricht – da kommt Peter!","tr":"İti an çomağı hazırla, işte Peter geliyor!"}]},
  {"id":"de-idiom-sich-den-kopf-zerbrechen","languageId":"de","category":"idioms","level":"B2","sourceText":"sich den Kopf zerbrechen","translations":{"tr":["kafa yormak","kafa patlatmak"]},"details":{"explanation":"Bir sorun üzerine uzun uzun düşünmek.","turkishEquivalent":"kafa patlatmak"},"examples":[{"text":"Ich zerbreche mir den Kopf über das Geschenk für Mama.","tr":"Annem için hediye konusunda kafa patlatıyorum."}]},
  {"id":"de-idiom-den-kopf-in-den-sand-stecken","languageId":"de","category":"idioms","level":"B2","sourceText":"den Kopf in den Sand stecken","translations":{"tr":["gerçekleri görmezden gelmek"]},"details":{"explanation":"Bir sorunla yüzleşmek yerine onu yok saymak.","turkishEquivalent":"devekuşu gibi başını kuma gömmek"},"examples":[{"text":"Bei Problemen steckt er immer den Kopf in den Sand.","tr":"Sorun olunca hep devekuşu gibi başını kuma gömer."}]},
  {"id":"de-idiom-etwas-auf-den-kopf-stellen","languageId":"de","category":"idioms","level":"B2","sourceText":"etwas auf den Kopf stellen","translations":{"tr":["altüst etmek","her yeri aramak"]},"details":{"explanation":"Bir yeri karıştırmak ya da bir şeyi tamamen değiştirmek.","turkishEquivalent":"altüst etmek"},"examples":[{"text":"Ich habe die ganze Wohnung auf den Kopf gestellt, aber den Schlüssel nicht gefunden.","tr":"Bütün evi altüst ettim ama anahtarı bulamadım."}]},
  {"id":"de-idiom-jemandem-den-kopf-verdrehen","languageId":"de","category":"idioms","level":"B2","sourceText":"jemandem den Kopf verdrehen","translations":{"tr":["birini kendine âşık etmek"]},"details":{"explanation":"Birini kendine çekip aklını başından almak.","turkishEquivalent":"aklını başından almak"},"examples":[{"text":"Die neue Kollegin hat ihm völlig den Kopf verdreht.","tr":"Yeni iş arkadaşı onun aklını tamamen başından aldı."}]},
  {"id":"de-idiom-sich-etwas-aus-dem-kopf-schlagen","languageId":"de","category":"idioms","level":"B2","sourceText":"sich etwas aus dem Kopf schlagen","translations":{"tr":["vazgeçmek","aklından çıkarmak"]},"details":{"explanation":"Bir plan ya da düşünceden vazgeçmek.","turkishEquivalent":"aklından çıkarmak"},"examples":[{"text":"Das Motorrad kannst du dir aus dem Kopf schlagen!","tr":"Motosikleti aklından çıkar!"}]},
  {"id":"de-idiom-alle-hande-voll-zu-tun-haben","languageId":"de","category":"idioms","level":"B2","sourceText":"alle Hände voll zu tun haben","translations":{"tr":["çok işi olmak","işi başından aşkın olmak"]},"details":{"explanation":"Çok meşgul olmak.","turkishEquivalent":"başını kaşıyacak vakti olmamak"},"examples":[{"text":"Vor Weihnachten haben wir im Laden alle Hände voll zu tun.","tr":"Noel'den önce dükkânda başımızı kaşıyacak vaktimiz olmaz."}]},
  {"id":"de-idiom-zwei-linke-hande-haben","languageId":"de","category":"idioms","level":"B2","sourceText":"zwei linke Hände haben","translations":{"tr":["beceriksiz olmak"]},"details":{"explanation":"El işlerinde hiç becerikli olmamak.","turkishEquivalent":"eli iş tutmamak"},"examples":[{"text":"Ich kann kein Regal aufbauen, ich habe zwei linke Hände.","tr":"Raf kuramam, elim hiç iş tutmaz."}]},
  {"id":"de-idiom-ein-auge-zudrucken","languageId":"de","category":"idioms","level":"B2","sourceText":"ein Auge zudrücken","translations":{"tr":["göz yummak","hoş görmek"]},"details":{"explanation":"Bir hatayı ya da kural ihlalini görmezden gelmek.","turkishEquivalent":"göz yummak"},"examples":[{"text":"Diesmal drücke ich noch ein Auge zu.","tr":"Bu sefer de göz yumuyorum."}]},
  {"id":"de-idiom-ins-auge-fallen","languageId":"de","category":"idioms","level":"B2","sourceText":"ins Auge fallen","translations":{"tr":["göze çarpmak","dikkat çekmek"]},"details":{"explanation":"Hemen fark edilmek.","turkishEquivalent":"göze çarpmak"},"examples":[{"text":"Das rote Kleid fällt sofort ins Auge.","tr":"Kırmızı elbise hemen göze çarpıyor."}]},
  {"id":"de-idiom-ein-auge-auf-jemanden-werfen","languageId":"de","category":"idioms","level":"B2","sourceText":"ein Auge auf jemanden werfen","translations":{"tr":["gözüne kestirmek","ilgilenmek"]},"details":{"explanation":"Birinden ya da bir şeyden hoşlanıp onu istemek.","turkishEquivalent":"gözüne kestirmek"},"examples":[{"text":"Ich glaube, Tom hat ein Auge auf dich geworfen.","tr":"Bence Tom seni gözüne kestirdi."}]},
  {"id":"de-idiom-kein-auge-zutun","languageId":"de","category":"idioms","level":"B2","sourceText":"kein Auge zutun","translations":{"tr":["hiç uyumamak","gözüne uyku girmemek"]},"details":{"explanation":"Bütün gece uyuyamamak.","turkishEquivalent":"gözüne uyku girmemek"},"examples":[{"text":"Vor Aufregung habe ich die ganze Nacht kein Auge zugetan.","tr":"Heyecandan bütün gece gözüme uyku girmedi."}]},
  {"id":"de-idiom-jemandem-die-augen-offnen","languageId":"de","category":"idioms","level":"B2","sourceText":"jemandem die Augen öffnen","translations":{"tr":["gözünü açmak","gerçeği göstermek"]},"details":{"explanation":"Birinin gerçeği fark etmesini sağlamak.","turkishEquivalent":"gözünü açmak"},"examples":[{"text":"Das Gespräch mit ihr hat mir die Augen geöffnet.","tr":"Onunla yaptığım konuşma gözümü açtı."}]},
  {"id":"de-idiom-die-ohren-spitzen","languageId":"de","category":"idioms","level":"B2","sourceText":"die Ohren spitzen","translations":{"tr":["kulak kabartmak","dikkatle dinlemek"]},"details":{"explanation":"Dikkatle dinlemeye başlamak.","turkishEquivalent":"kulak kabartmak"},"examples":[{"text":"Als sein Name fiel, spitzte er die Ohren.","tr":"Adı geçince kulak kabarttı."}]},
  {"id":"de-idiom-bis-uber-beide-ohren-verliebt-sein","languageId":"de","category":"idioms","level":"B2","sourceText":"bis über beide Ohren verliebt sein","translations":{"tr":["sırılsıklam âşık olmak"]},"details":{"explanation":"Birine çok âşık olmak.","turkishEquivalent":"sırılsıklam âşık olmak"},"examples":[{"text":"Max ist bis über beide Ohren in Lena verliebt.","tr":"Max, Lena'ya sırılsıklam âşık."}]},
  {"id":"de-idiom-viel-um-die-ohren-haben","languageId":"de","category":"idioms","level":"B2","sourceText":"viel um die Ohren haben","translations":{"tr":["çok meşgul olmak"]},"details":{"explanation":"Yapacak çok işi olmak.","turkishEquivalent":"işi başından aşkın olmak"},"examples":[{"text":"Diese Woche habe ich viel um die Ohren.","tr":"Bu hafta işim başımdan aşkın."}]},
  {"id":"de-idiom-jemanden-ubers-ohr-hauen","languageId":"de","category":"idioms","level":"B2","sourceText":"jemanden übers Ohr hauen","translations":{"tr":["kazıklamak","dolandırmak"]},"details":{"explanation":"Birini özellikle parada kandırmak.","turkishEquivalent":"kazıklamak"},"examples":[{"text":"Der Händler hat uns übers Ohr gehauen.","tr":"Satıcı bizi kazıkladı."}]},
  {"id":"de-idiom-noch-grun-hinter-den-ohren-sein","languageId":"de","category":"idioms","level":"B2","sourceText":"noch grün hinter den Ohren sein","translations":{"tr":["toy olmak","tecrübesiz olmak"]},"details":{"explanation":"Genç ve deneyimsiz olmak.","turkishEquivalent":"ağzı süt kokmak"},"examples":[{"text":"Der neue Praktikant ist noch grün hinter den Ohren.","tr":"Yeni stajyerin ağzı hâlâ süt kokuyor."}]},
  {"id":"de-idiom-ich-bin-ganz-ohr","languageId":"de","category":"idioms","level":"B2","sourceText":"Ich bin ganz Ohr.","translations":{"tr":["seni dinliyorum","dikkatle dinliyorum"]},"details":{"explanation":"Tüm dikkatle dinlemeye hazır olduğunu söylemek."},"examples":[{"text":"Erzähl schon, ich bin ganz Ohr!","tr":"Anlat hadi, can kulağıyla dinliyorum!"}]},
  {"id":"de-idiom-auf-die-nase-fallen","languageId":"de","category":"idioms","level":"B2","sourceText":"auf die Nase fallen","translations":{"tr":["başarısız olmak","çuvallamak"]},"details":{"explanation":"Bir girişimde başarısız olmak."},"examples":[{"text":"Mit seiner ersten Firma ist er auf die Nase gefallen.","tr":"İlk şirketiyle çuvalladı."}]},
  {"id":"de-idiom-pi-mal-daumen","languageId":"de","category":"idioms","level":"B2","sourceText":"Pi mal Daumen","translations":{"tr":["kabaca","aşağı yukarı"]},"details":{"explanation":"Tam hesaplamadan, tahmini olarak.","turkishEquivalent":"göz kararı"},"examples":[{"text":"Pi mal Daumen kostet das 200 Euro.","tr":"Kabaca 200 avro tutar."}]},
  {"id":"de-idiom-jemandem-den-mund-wassrig-machen","languageId":"de","category":"idioms","level":"B2","sourceText":"jemandem den Mund wässrig machen","translations":{"tr":["ağzını sulandırmak","iştahını kabartmak"]},"details":{"explanation":"Birinde bir şeye karşı istek uyandırmak.","turkishEquivalent":"ağzını sulandırmak"},"examples":[{"text":"Mit deinen Urlaubsfotos machst du mir den Mund wässrig.","tr":"Tatil fotoğraflarınla ağzımı sulandırıyorsun."}]},
  {"id":"de-idiom-die-zahne-zusammenbeissen","languageId":"de","category":"idioms","level":"B2","sourceText":"die Zähne zusammenbeißen","translations":{"tr":["dişini sıkmak","katlanmak"]},"details":{"explanation":"Zorluğa ya da acıya sessizce dayanmak.","turkishEquivalent":"dişini sıkmak"},"examples":[{"text":"Noch zwei Kilometer – Zähne zusammenbeißen!","tr":"İki kilometre kaldı, dişini sık!"}]},
  {"id":"de-idiom-jemandem-auf-der-zunge-liegen","languageId":"de","category":"idioms","level":"B2","sourceText":"jemandem auf der Zunge liegen","translations":{"tr":["dilinin ucunda olmak"]},"details":{"explanation":"Bir kelimeyi hatırlamak üzere olup söyleyememek.","turkishEquivalent":"dilinin ucunda olmak"},"examples":[{"text":"Sein Name liegt mir auf der Zunge.","tr":"Adı dilimin ucunda."}]},
  {"id":"de-idiom-hals-uber-kopf","languageId":"de","category":"idioms","level":"B2","sourceText":"Hals über Kopf","translations":{"tr":["apar topar","aceleyle"]},"details":{"explanation":"Çok aceleyle, düşünmeden.","turkishEquivalent":"apar topar"},"examples":[{"text":"Sie haben Hals über Kopf geheiratet.","tr":"Apar topar evlendiler."}]},
  {"id":"de-idiom-jemandem-um-den-hals-fallen","languageId":"de","category":"idioms","level":"B2","sourceText":"jemandem um den Hals fallen","translations":{"tr":["boynuna sarılmak"]},"details":{"explanation":"Sevinçle birine sarılmak.","turkishEquivalent":"boynuna sarılmak"},"examples":[{"text":"Als sie ihn sah, fiel sie ihm um den Hals.","tr":"Onu görünce boynuna sarıldı."}]},
  {"id":"de-idiom-jemandem-die-kalte-schulter-zeigen","languageId":"de","category":"idioms","level":"B2","sourceText":"jemandem die kalte Schulter zeigen","translations":{"tr":["soğuk davranmak","yüz vermemek"]},"details":{"explanation":"Birine ilgisiz ve soğuk davranmak.","turkishEquivalent":"yüz vermemek"},"examples":[{"text":"Nach dem Streit zeigt sie mir die kalte Schulter.","tr":"Kavgadan sonra bana yüz vermiyor."}]},
  {"id":"de-idiom-etwas-auf-die-leichte-schulter-nehmen","languageId":"de","category":"idioms","level":"B2","sourceText":"etwas auf die leichte Schulter nehmen","translations":{"tr":["hafife almak"]},"details":{"explanation":"Önemli bir şeyi ciddiye almamak.","turkishEquivalent":"hafife almak"},"examples":[{"text":"Du solltest die Erkältung nicht auf die leichte Schulter nehmen.","tr":"Soğuk algınlığını hafife almamalısın."}]},
  {"id":"de-idiom-jemandem-den-rucken-kehren","languageId":"de","category":"idioms","level":"B2","sourceText":"jemandem den Rücken kehren","translations":{"tr":["sırt çevirmek","terk etmek"]},"details":{"explanation":"Biriyle ya da bir şeyle ilişkiyi kesmek.","turkishEquivalent":"sırt çevirmek"},"examples":[{"text":"Viele junge Leute kehren dem Dorf den Rücken.","tr":"Birçok genç köye sırt çeviriyor."}]},
  {"id":"de-idiom-jemandem-am-herzen-liegen","languageId":"de","category":"idioms","level":"B2","sourceText":"jemandem am Herzen liegen","translations":{"tr":["çok önemli olmak"]},"details":{"explanation":"Bir şeyin ya da birinin kişi için çok önemli olması."},"examples":[{"text":"Die Umwelt liegt mir sehr am Herzen.","tr":"Çevre benim için çok önemli."}]},
  {"id":"de-idiom-sich-etwas-zu-herzen-nehmen","languageId":"de","category":"idioms","level":"B2","sourceText":"sich etwas zu Herzen nehmen","translations":{"tr":["kafaya takmak","ciddiye almak"]},"details":{"explanation":"Bir sözü ya da eleştiriyi çok ciddiye almak ve etkilenmek.","turkishEquivalent":"dert etmek"},"examples":[{"text":"Nimm dir seine Worte nicht so zu Herzen.","tr":"Onun sözlerini bu kadar dert etme."}]},
  {"id":"de-idiom-ein-herz-aus-stein-haben","languageId":"de","category":"idioms","level":"B2","sourceText":"ein Herz aus Stein haben","translations":{"tr":["taş kalpli olmak","acımasız olmak"]},"details":{"explanation":"Duygusuz ve merhametsiz olmak.","turkishEquivalent":"taş kalpli olmak"},"examples":[{"text":"Wer da nicht weint, hat ein Herz aus Stein.","tr":"Buna ağlamayan taş kalplidir."}]},
  {"id":"de-idiom-mir-fallt-ein-stein-vom-herzen","languageId":"de","category":"idioms","level":"B2","sourceText":"Mir fällt ein Stein vom Herzen.","translations":{"tr":["çok rahatladım"]},"details":{"explanation":"Bir endişeden kurtulup rahatlamak.","turkishEquivalent":"yüreğime su serpildi"},"examples":[{"text":"Du bist gesund? Da fällt mir ein Stein vom Herzen!","tr":"Sağlıklı mısın? Yüreğime su serpildi!"}]},
  {"id":"de-idiom-hand-aufs-herz","languageId":"de","category":"idioms","level":"B2","sourceText":"Hand aufs Herz","translations":{"tr":["dürüst ol","açık konuş"]},"details":{"explanation":"Birinden dürüst bir cevap istemek.","turkishEquivalent":"elini vicdanına koy"},"examples":[{"text":"Hand aufs Herz: Hast du das Buch wirklich gelesen?","tr":"Elini vicdanına koy: Kitabı gerçekten okudun mu?"}]},
  {"id":"de-idiom-kalte-fusse-bekommen","languageId":"de","category":"idioms","level":"B2","sourceText":"kalte Füße bekommen","translations":{"tr":["son anda korkmak","cayıp vazgeçmek"]},"details":{"explanation":"Bir işe girişmeden hemen önce korkup vazgeçmek."},"examples":[{"text":"Kurz vor der Hochzeit hat er kalte Füße bekommen.","tr":"Düğünden hemen önce korkup caydı."}]},
  {"id":"de-idiom-mit-dem-linken-fuss-aufstehen","languageId":"de","category":"idioms","level":"B2","sourceText":"mit dem linken Fuß aufstehen","translations":{"tr":["güne kötü başlamak"]},"details":{"explanation":"Güne huysuz ya da şanssız başlamak.","turkishEquivalent":"ters tarafından kalkmak"},"examples":[{"text":"Was ist los mit dir? Bist du mit dem linken Fuß aufgestanden?","tr":"Neyin var? Yatağın ters tarafından mı kalktın?"}]},
  {"id":"de-idiom-auf-eigenen-fussen-stehen","languageId":"de","category":"idioms","level":"B2","sourceText":"auf eigenen Füßen stehen","translations":{"tr":["kendi ayakları üzerinde durmak","bağımsız olmak"]},"details":{"explanation":"Başkasına muhtaç olmadan yaşamak.","turkishEquivalent":"kendi ayakları üzerinde durmak"},"examples":[{"text":"Mit 20 wollte ich endlich auf eigenen Füßen stehen.","tr":"Yirmi yaşında artık kendi ayaklarımın üzerinde durmak istedim."}]},
  {"id":"de-idiom-aus-erster-hand","languageId":"de","category":"idioms","level":"B2","sourceText":"aus erster Hand","translations":{"tr":["doğrudan kaynaktan"]},"details":{"explanation":"Bilgiyi aracısız, doğrudan kaynağından almak.","turkishEquivalent":"birinci ağızdan"},"examples":[{"text":"Ich habe die Nachricht aus erster Hand.","tr":"Haberi birinci ağızdan aldım."}]},
  {"id":"de-idiom-ein-handchen-fur-etwas-haben","languageId":"de","category":"idioms","level":"B2","sourceText":"ein Händchen für etwas haben","translations":{"tr":["yeteneği olmak","eli yatkın olmak"]},"details":{"explanation":"Bir konuda doğal bir beceriye sahip olmak.","turkishEquivalent":"eli yatkın olmak"},"examples":[{"text":"Sie hat ein Händchen für Pflanzen.","tr":"Bitkilere eli çok yatkın."}]},
  {"id":"de-idiom-sich-die-hande-reiben","languageId":"de","category":"idioms","level":"B2","sourceText":"sich die Hände reiben","translations":{"tr":["sevinmek","ellerini ovuşturmak"]},"details":{"explanation":"Bir şeyden memnun olup çıkar sağlamayı beklemek.","turkishEquivalent":"ellerini ovuşturmak"},"examples":[{"text":"Die Konkurrenz reibt sich schon die Hände.","tr":"Rakipler şimdiden ellerini ovuşturuyor."}]},
  {"id":"de-idiom-die-finger-von-etwas-lassen","languageId":"de","category":"idioms","level":"B2","sourceText":"die Finger von etwas lassen","translations":{"tr":["uzak durmak","bulaşmamak"]},"details":{"explanation":"Tehlikeli ya da zararlı bir şeyden uzak durmak."},"examples":[{"text":"Lass die Finger von Drogen!","tr":"Uyuşturucudan uzak dur!"}]},
  {"id":"de-idiom-keinen-finger-ruhren","languageId":"de","category":"idioms","level":"B2","sourceText":"keinen Finger rühren","translations":{"tr":["hiçbir şey yapmamak"]},"details":{"explanation":"Hiç yardım etmemek, en ufak çabayı göstermemek.","turkishEquivalent":"parmağını bile kıpırdatmamak"},"examples":[{"text":"Im Haushalt rührt er keinen Finger.","tr":"Ev işlerinde parmağını bile kıpırdatmıyor."}]},
  {"id":"de-idiom-um-ein-haar","languageId":"de","category":"idioms","level":"B2","sourceText":"um ein Haar","translations":{"tr":["kıl payı","az kalsın"]},"details":{"explanation":"Çok az bir farkla.","turkishEquivalent":"kıl payı"},"examples":[{"text":"Um ein Haar hätte ich den Flug verpasst.","tr":"Az kalsın uçağı kaçırıyordum."}]},
  {"id":"de-idiom-nur-noch-haut-und-knochen-sein","languageId":"de","category":"idioms","level":"B2","sourceText":"nur noch Haut und Knochen sein","translations":{"tr":["çok zayıf olmak"]},"details":{"explanation":"Aşırı zayıflamış olmak.","turkishEquivalent":"bir deri bir kemik kalmak"},"examples":[{"text":"Nach der Krankheit war er nur noch Haut und Knochen.","tr":"Hastalıktan sonra bir deri bir kemik kalmıştı."}]},
  {"id":"de-idiom-jemandem-ein-bein-stellen","languageId":"de","category":"idioms","level":"B2","sourceText":"jemandem ein Bein stellen","translations":{"tr":["çelme takmak","engel olmak"]},"details":{"explanation":"Birinin başarısını gizlice engellemeye çalışmak.","turkishEquivalent":"çelme takmak"},"examples":[{"text":"Ein Kollege wollte mir ein Bein stellen.","tr":"Bir iş arkadaşı bana çelme takmak istedi."}]},
  {"id":"de-idiom-das-gesicht-verlieren","languageId":"de","category":"idioms","level":"B2","sourceText":"das Gesicht verlieren","translations":{"tr":["itibarını kaybetmek","rezil olmak"]},"details":{"explanation":"Başkalarının gözünde saygınlığını yitirmek."},"examples":[{"text":"Er will vor seinen Freunden nicht das Gesicht verlieren.","tr":"Arkadaşlarının önünde itibarını kaybetmek istemiyor."}]},
  {"id":"de-idiom-ein-langes-gesicht-machen","languageId":"de","category":"idioms","level":"B2","sourceText":"ein langes Gesicht machen","translations":{"tr":["hayal kırıklığına uğramak","surat asmak"]},"details":{"explanation":"Hayal kırıklığını yüz ifadesiyle göstermek.","turkishEquivalent":"yüzü düşmek"},"examples":[{"text":"Als es kein Eis gab, machten die Kinder lange Gesichter.","tr":"Dondurma olmadığını duyunca çocukların yüzü düştü."}]},
  {"id":"de-idiom-aus-dem-bauch-heraus","languageId":"de","category":"idioms","level":"B2","sourceText":"aus dem Bauch heraus","translations":{"tr":["içgüdüyle","sezgiyle"]},"details":{"explanation":"Uzun düşünmeden, hislerine göre."},"examples":[{"text":"Ich habe die Entscheidung aus dem Bauch heraus getroffen.","tr":"Kararı içgüdüyle verdim."}]},
  {"id":"de-idiom-sich-den-bauch-vollschlagen","languageId":"de","category":"idioms","level":"B2","sourceText":"sich den Bauch vollschlagen","translations":{"tr":["tıka basa yemek"]},"details":{"explanation":"Çok fazla yemek.","turkishEquivalent":"tıka basa yemek"},"examples":[{"text":"Beim Buffet haben wir uns den Bauch vollgeschlagen.","tr":"Açık büfede tıka basa yedik."}]},
  {"id":"de-idiom-jemandem-im-blut-liegen","languageId":"de","category":"idioms","level":"B2","sourceText":"jemandem im Blut liegen","translations":{"tr":["kanında olmak"]},"details":{"explanation":"Bir yeteneğin doğuştan gelmesi.","turkishEquivalent":"kanında olmak"},"examples":[{"text":"Musik liegt ihr im Blut.","tr":"Müzik onun kanında var."}]},
  {"id":"de-idiom-ruhig-blut","languageId":"de","category":"idioms","level":"B2","sourceText":"Ruhig Blut!","translations":{"tr":["sakin ol!"]},"details":{"explanation":"Heyecanlanan birini sakinleştirmek için söylenir."},"examples":[{"text":"Ruhig Blut, wir schaffen das noch!","tr":"Sakin ol, yetiştireceğiz!"}]},
  {"id":"de-idiom-die-nerven-verlieren","languageId":"de","category":"idioms","level":"B2","sourceText":"die Nerven verlieren","translations":{"tr":["sinirlerine hâkim olamamak"]},"details":{"explanation":"Stres altında sakinliğini kaybetmek.","turkishEquivalent":"sinirleri bozulmak"},"examples":[{"text":"Im entscheidenden Moment hat der Torwart die Nerven verloren.","tr":"Kaleci kritik anda sinirlerine hâkim olamadı."}]},
  {"id":"de-idiom-jemanden-auf-den-arm-nehmen","languageId":"de","category":"idioms","level":"B2","sourceText":"jemanden auf den Arm nehmen","translations":{"tr":["dalga geçmek","işletmek"]},"details":{"explanation":"Birine şaka yapıp onu kandırmak.","turkishEquivalent":"işletmek"},"examples":[{"text":"Du hast im Lotto gewonnen? Du willst mich auf den Arm nehmen!","tr":"Lotoda mı kazandın? Beni işletiyorsun!"}]},
  {"id":"de-idiom-wie-hund-und-katze-sein","languageId":"de","category":"idioms","level":"B2","sourceText":"wie Hund und Katze sein","translations":{"tr":["hiç anlaşamamak"]},"details":{"explanation":"Sürekli kavga etmek.","turkishEquivalent":"kedi köpek gibi olmak"},"examples":[{"text":"Die beiden Brüder sind wie Hund und Katze.","tr":"İki kardeş kedi köpek gibi."}]},
  {"id":"de-idiom-einen-vogel-haben","languageId":"de","category":"idioms","level":"B2","sourceText":"einen Vogel haben","translations":{"tr":["kafadan çatlak olmak","deli olmak"]},"details":{"explanation":"Birinin tuhaf ya da çılgınca davranması.","turkishEquivalent":"kafadan kontak olmak"},"examples":[{"text":"Du willst im Winter im See baden? Du hast doch einen Vogel!","tr":"Kışın gölde mi yüzeceksin? Sen kafadan kontaksın!"}]},
  {"id":"de-idiom-das-schwarze-schaf","languageId":"de","category":"idioms","level":"B2","sourceText":"das schwarze Schaf","translations":{"tr":["yüz karası","ailenin kötüsü"]},"details":{"explanation":"Bir grupta diğerlerinden olumsuz şekilde ayrılan kişi.","turkishEquivalent":"kara koyun"},"examples":[{"text":"Er ist das schwarze Schaf der Familie.","tr":"O, ailenin kara koyunu."}]},
  {"id":"de-idiom-ein-schlauer-fuchs","languageId":"de","category":"idioms","level":"B2","sourceText":"ein schlauer Fuchs","translations":{"tr":["kurnaz biri"]},"details":{"explanation":"Çok zeki ve kurnaz kişi.","turkishEquivalent":"kurnaz tilki"},"examples":[{"text":"Unser Anwalt ist ein schlauer Fuchs.","tr":"Avukatımız kurnaz bir tilki."}]},
  {"id":"de-idiom-sich-wie-ein-elefant-im-porzellanladen-benehmen","languageId":"de","category":"idioms","level":"B2","sourceText":"sich wie ein Elefant im Porzellanladen benehmen","translations":{"tr":["kaba ve sakar davranmak"]},"details":{"explanation":"Hassas bir durumda düşüncesiz ve kaba davranmak.","turkishEquivalent":"züccaciye dükkânına girmiş fil gibi"},"examples":[{"text":"Bei dem Treffen hat er sich wie ein Elefant im Porzellanladen benommen.","tr":"Toplantıda züccaciye dükkânına girmiş fil gibi davrandı."}]},
  {"id":"de-idiom-aus-einer-mucke-einen-elefanten-machen","languageId":"de","category":"idioms","level":"B2","sourceText":"aus einer Mücke einen Elefanten machen","translations":{"tr":["abartmak","büyütmek"]},"details":{"explanation":"Küçük bir sorunu çok büyük göstermek.","turkishEquivalent":"pireyi deve yapmak"},"examples":[{"text":"Es ist nur ein Kratzer, mach doch aus einer Mücke keinen Elefanten.","tr":"Sadece bir çizik, pireyi deve yapma."}]},
  {"id":"de-idiom-sich-wie-ein-fisch-im-wasser-fuhlen","languageId":"de","category":"idioms","level":"B2","sourceText":"sich wie ein Fisch im Wasser fühlen","translations":{"tr":["kendini çok rahat hissetmek"]},"details":{"explanation":"Bir ortamda kendini çok rahat ve mutlu hissetmek.","turkishEquivalent":"suda balık gibi olmak"},"examples":[{"text":"Auf der Bühne fühlt sie sich wie ein Fisch im Wasser.","tr":"Sahnede suda balık gibi."}]},
  {"id":"de-idiom-im-schneckentempo","languageId":"de","category":"idioms","level":"B2","sourceText":"im Schneckentempo","translations":{"tr":["çok yavaş"]},"details":{"explanation":"Son derece yavaş bir şekilde.","turkishEquivalent":"kaplumbağa hızıyla"},"examples":[{"text":"Im Stau ging es nur im Schneckentempo voran.","tr":"Trafikte kaplumbağa hızıyla ilerledik."}]},
  {"id":"de-idiom-das-ist-doch-kase","languageId":"de","category":"idioms","level":"B2","sourceText":"Das ist doch Käse!","translations":{"tr":["saçmalık!"]},"details":{"explanation":"Bir sözün saçma olduğunu söylemek."},"examples":[{"text":"Was du da erzählst, ist doch Käse!","tr":"Anlattığın şey saçmalık!"}]},
  {"id":"de-idiom-seinen-senf-dazugeben","languageId":"de","category":"idioms","level":"B2","sourceText":"seinen Senf dazugeben","translations":{"tr":["istenmeden fikir belirtmek"]},"details":{"explanation":"Kimse sormadan her konuda yorum yapmak.","turkishEquivalent":"maydanoz olmak"},"examples":[{"text":"Mein Schwiegervater muss immer seinen Senf dazugeben.","tr":"Kayınpederim her konuya maydanoz olmak zorunda."}]},
  {"id":"de-idiom-salz-in-die-wunde-streuen","languageId":"de","category":"idioms","level":"B2","sourceText":"Salz in die Wunde streuen","translations":{"tr":["acısını artırmak"]},"details":{"explanation":"Zaten üzgün birini daha da üzmek.","turkishEquivalent":"yarasına tuz basmak"},"examples":[{"text":"Musst du jetzt auch noch Salz in die Wunde streuen?","tr":"Bir de yarama tuz mu basacaksın?"}]},
  {"id":"de-idiom-ach-du-dickes-ei","languageId":"de","category":"idioms","level":"B2","sourceText":"Ach du dickes Ei!","translations":{"tr":["eyvah!","vay canına!"]},"details":{"explanation":"Şaşkınlık ya da hoş olmayan bir sürpriz karşısında söylenir."},"examples":[{"text":"Ach du dickes Ei, ich habe den Termin vergessen!","tr":"Eyvah, randevuyu unuttum!"}]},
  {"id":"de-idiom-apfel-mit-birnen-vergleichen","languageId":"de","category":"idioms","level":"B2","sourceText":"Äpfel mit Birnen vergleichen","translations":{"tr":["kıyaslanamayacak şeyleri kıyaslamak"]},"details":{"explanation":"Birbirinden çok farklı şeyleri karşılaştırmak.","turkishEquivalent":"elmayla armudu karıştırmak"},"examples":[{"text":"Ein Auto mit einem Fahrrad zu vergleichen, heißt Äpfel mit Birnen vergleichen.","tr":"Arabayı bisikletle kıyaslamak, elmayla armudu karıştırmaktır."}]},
  {"id":"de-idiom-abwarten-und-tee-trinken","languageId":"de","category":"idioms","level":"B2","sourceText":"Abwarten und Tee trinken!","translations":{"tr":["sabırla bekle"]},"details":{"explanation":"Acele etmeden sonucu beklemeyi önermek."},"examples":[{"text":"Wir wissen noch nichts – abwarten und Tee trinken.","tr":"Henüz bir şey bilmiyoruz, sabırla bekleyelim."}]},
  {"id":"de-idiom-eine-harte-nuss","languageId":"de","category":"idioms","level":"B2","sourceText":"eine harte Nuss","translations":{"tr":["zor bir sorun","zorlu kişi"]},"details":{"explanation":"Çözülmesi ya da baş edilmesi zor şey veya kişi.","turkishEquivalent":"çetin ceviz"},"examples":[{"text":"Diese Aufgabe ist eine harte Nuss.","tr":"Bu soru çetin ceviz."}]},
  {"id":"de-idiom-etwas-unter-den-teppich-kehren","languageId":"de","category":"idioms","level":"B2","sourceText":"etwas unter den Teppich kehren","translations":{"tr":["örtbas etmek","gizlemek"]},"details":{"explanation":"Bir sorunu ya da hatayı saklamak.","turkishEquivalent":"halının altına süpürmek"},"examples":[{"text":"Die Firma wollte den Skandal unter den Teppich kehren.","tr":"Şirket skandalı halının altına süpürmek istedi."}]},
  {"id":"de-idiom-den-faden-verlieren","languageId":"de","category":"idioms","level":"B2","sourceText":"den Faden verlieren","translations":{"tr":["ne söyleyeceğini unutmak"]},"details":{"explanation":"Konuşurken düşüncenin akışını kaybetmek.","turkishEquivalent":"lafın ucunu kaçırmak"},"examples":[{"text":"Entschuldigung, ich habe den Faden verloren.","tr":"Pardon, lafın ucunu kaçırdım."}]},
  {"id":"de-idiom-eine-stecknadel-im-heuhaufen-suchen","languageId":"de","category":"idioms","level":"B2","sourceText":"eine Stecknadel im Heuhaufen suchen","translations":{"tr":["imkânsızı aramak"]},"details":{"explanation":"Bulunması neredeyse imkânsız bir şeyi aramak.","turkishEquivalent":"samanlıkta iğne aramak"},"examples":[{"text":"In dieser Stadt eine Wohnung zu finden, ist wie eine Stecknadel im Heuhaufen suchen.","tr":"Bu şehirde ev bulmak samanlıkta iğne aramak gibi."}]},
  {"id":"de-idiom-ins-wasser-fallen","languageId":"de","category":"idioms","level":"B2","sourceText":"ins Wasser fallen","translations":{"tr":["iptal olmak","gerçekleşmemek"]},"details":{"explanation":"Planlanan bir şeyin gerçekleşmemesi.","turkishEquivalent":"suya düşmek"},"examples":[{"text":"Unser Ausflug ist wegen des Regens ins Wasser gefallen.","tr":"Gezimiz yağmur yüzünden suya düştü."}]},
  {"id":"de-idiom-mit-dem-feuer-spielen","languageId":"de","category":"idioms","level":"B2","sourceText":"mit dem Feuer spielen","translations":{"tr":["tehlikeyle oynamak"]},"details":{"explanation":"Bilerek büyük bir risk almak.","turkishEquivalent":"ateşle oynamak"},"examples":[{"text":"Wer betrunken fährt, spielt mit dem Feuer.","tr":"Sarhoş araba kullanan ateşle oynar."}]},
  {"id":"de-idiom-ol-ins-feuer-giessen","languageId":"de","category":"idioms","level":"B2","sourceText":"Öl ins Feuer gießen","translations":{"tr":["durumu kızıştırmak"]},"details":{"explanation":"Zaten gergin bir durumu daha da kötüleştirmek.","turkishEquivalent":"yangına körükle gitmek"},"examples":[{"text":"Mit deinem Kommentar gießt du nur Öl ins Feuer.","tr":"Bu yorumunla yangına körükle gidiyorsun."}]},
  {"id":"de-idiom-jemanden-wie-luft-behandeln","languageId":"de","category":"idioms","level":"B2","sourceText":"jemanden wie Luft behandeln","translations":{"tr":["yok saymak"]},"details":{"explanation":"Birini hiç görmüyormuş gibi davranmak.","turkishEquivalent":"adam yerine koymamak"},"examples":[{"text":"Seit dem Streit behandelt sie mich wie Luft.","tr":"Kavgadan beri beni yok sayıyor."}]},
  {"id":"de-idiom-luftschlosser-bauen","languageId":"de","category":"idioms","level":"B2","sourceText":"Luftschlösser bauen","translations":{"tr":["hayal kurmak","olmayacak planlar yapmak"]},"details":{"explanation":"Gerçekleşmesi imkânsız hayaller kurmak."},"examples":[{"text":"Statt Luftschlösser zu bauen, solltest du dir einen Job suchen.","tr":"Olmayacak hayaller kuracağına kendine bir iş bulmalısın."}]},
  {"id":"de-idiom-aus-heiterem-himmel","languageId":"de","category":"idioms","level":"B2","sourceText":"aus heiterem Himmel","translations":{"tr":["birdenbire","beklenmedik şekilde"]},"details":{"explanation":"Hiç beklenmedik bir anda.","turkishEquivalent":"durup dururken"},"examples":[{"text":"Aus heiterem Himmel hat er gekündigt.","tr":"Durup dururken istifa etti."}]},
  {"id":"de-idiom-schnee-von-gestern","languageId":"de","category":"idioms","level":"B2","sourceText":"Schnee von gestern","translations":{"tr":["eski hikâye","geçmişte kaldı"]},"details":{"explanation":"Artık önemi kalmamış eski bir konu."},"examples":[{"text":"Unser Streit ist doch Schnee von gestern.","tr":"Kavgamız artık eski hikâye."}]},
  {"id":"de-idiom-das-eis-brechen","languageId":"de","category":"idioms","level":"B2","sourceText":"das Eis brechen","translations":{"tr":["gerginliği gidermek"]},"details":{"explanation":"Yabancılar arasındaki çekingenliği ortadan kaldırmak.","turkishEquivalent":"buzları eritmek"},"examples":[{"text":"Ein kleiner Witz hat das Eis gebrochen.","tr":"Küçük bir şaka buzları eritti."}]},
  {"id":"de-idiom-etwas-auf-eis-legen","languageId":"de","category":"idioms","level":"B2","sourceText":"etwas auf Eis legen","translations":{"tr":["ertelemek","askıya almak"]},"details":{"explanation":"Bir planı şimdilik durdurmak.","turkishEquivalent":"rafa kaldırmak"},"examples":[{"text":"Das Projekt wurde vorerst auf Eis gelegt.","tr":"Proje şimdilik rafa kaldırıldı."}]},
  {"id":"de-idiom-der-zug-ist-abgefahren","languageId":"de","category":"idioms","level":"B2","sourceText":"Der Zug ist abgefahren.","translations":{"tr":["iş işten geçti"]},"details":{"explanation":"Bir fırsatın artık kaçtığını söylemek.","turkishEquivalent":"iş işten geçti"},"examples":[{"text":"Für eine Entschuldigung ist es zu spät, der Zug ist abgefahren.","tr":"Özür için çok geç, iş işten geçti."}]},
  {"id":"de-idiom-im-falschen-film-sein","languageId":"de","category":"idioms","level":"B2","sourceText":"im falschen Film sein","translations":{"tr":["olanlara inanamamak"]},"details":{"explanation":"Bir durumun gerçek dışı ve absürt gelmesi."},"examples":[{"text":"Als ich die Rechnung sah, dachte ich, ich bin im falschen Film.","tr":"Faturayı görünce rüya görüyorum sandım."}]},
  {"id":"de-idiom-das-kommt-mir-spanisch-vor","languageId":"de","category":"idioms","level":"B2","sourceText":"Das kommt mir spanisch vor.","translations":{"tr":["bu bana tuhaf geliyor"]},"details":{"explanation":"Bir şeyin garip ya da şüpheli görünmesi."},"examples":[{"text":"Sein Verhalten kommt mir spanisch vor.","tr":"Davranışları bana tuhaf geliyor."}]},
  {"id":"de-idiom-ich-bin-doch-nicht-von-gestern","languageId":"de","category":"idioms","level":"B2","sourceText":"Ich bin doch nicht von gestern!","translations":{"tr":["ben saf değilim"]},"details":{"explanation":"Kolay kandırılamayacağını söylemek.","turkishEquivalent":"dünkü çocuk değilim"},"examples":[{"text":"Das glaube ich dir nicht, ich bin doch nicht von gestern!","tr":"Buna inanmıyorum, dünkü çocuk değilim!"}]},
  {"id":"de-idiom-die-zeit-totschlagen","languageId":"de","category":"idioms","level":"B2","sourceText":"die Zeit totschlagen","translations":{"tr":["vakit geçirmek"]},"details":{"explanation":"Boş zamanı anlamsız şeylerle doldurmak.","turkishEquivalent":"vakit öldürmek"},"examples":[{"text":"Am Flughafen haben wir mit Kartenspielen die Zeit totgeschlagen.","tr":"Havalimanında kâğıt oynayarak vakit öldürdük."}]},
  {"id":"de-idiom-das-geld-zum-fenster-hinauswerfen","languageId":"de","category":"idioms","level":"B2","sourceText":"das Geld zum Fenster hinauswerfen","translations":{"tr":["parayı boşa harcamak"]},"details":{"explanation":"Parayı gereksiz şeylere harcamak.","turkishEquivalent":"parayı sokağa atmak"},"examples":[{"text":"Für so ein teures Handy wirfst du dein Geld zum Fenster hinaus.","tr":"Böyle pahalı bir telefona parayı sokağa atıyorsun."}]},
  {"id":"de-idiom-knapp-bei-kasse-sein","languageId":"de","category":"idioms","level":"B2","sourceText":"knapp bei Kasse sein","translations":{"tr":["parası az olmak"]},"details":{"explanation":"O an fazla parası olmamak.","turkishEquivalent":"eli dar olmak"},"examples":[{"text":"Am Monatsende bin ich immer knapp bei Kasse.","tr":"Ay sonunda elim hep dar olur."}]},
  {"id":"de-idiom-blau-sein","languageId":"de","category":"idioms","level":"B2","sourceText":"blau sein","translations":{"tr":["sarhoş olmak"]},"details":{"explanation":"Alkol yüzünden sarhoş olmak (gündelik dil)."},"examples":[{"text":"Nach drei Bier war er total blau.","tr":"Üç biradan sonra küp gibi sarhoştu."}]},
  {"id":"de-idiom-blaumachen","languageId":"de","category":"idioms","level":"B2","sourceText":"blaumachen","translations":{"tr":["işi ya da okulu kırmak"]},"details":{"explanation":"Hasta olmadan işe veya okula gitmemek.","turkishEquivalent":"kaytarmak"},"examples":[{"text":"Am Freitag hat er einfach blaugemacht.","tr":"Cuma günü düpedüz işi kırdı."}]},
  {"id":"de-idiom-grun-vor-neid-sein","languageId":"de","category":"idioms","level":"B2","sourceText":"grün vor Neid sein","translations":{"tr":["çok kıskanmak"]},"details":{"explanation":"Birini çok kıskanmak.","turkishEquivalent":"kıskançlıktan çatlamak"},"examples":[{"text":"Als sie sein neues Auto sah, wurde sie grün vor Neid.","tr":"Yeni arabasını görünce kıskançlıktan çatladı."}]},
  {"id":"de-idiom-grunes-licht-geben","languageId":"de","category":"idioms","level":"B2","sourceText":"grünes Licht geben","translations":{"tr":["izin vermek","onaylamak"]},"details":{"explanation":"Bir işin başlamasına izin vermek.","turkishEquivalent":"yeşil ışık yakmak"},"examples":[{"text":"Der Chef hat grünes Licht für das Projekt gegeben.","tr":"Patron projeye yeşil ışık yaktı."}]},
  {"id":"de-idiom-schwarzsehen","languageId":"de","category":"idioms","level":"B2","sourceText":"schwarzsehen","translations":{"tr":["karamsar olmak"]},"details":{"explanation":"Geleceğe olumsuz bakmak."},"examples":[{"text":"Für die Prüfung sehe ich schwarz.","tr":"Sınav konusunda karamsarım."}]},
  {"id":"de-idiom-schwarz-auf-weiss","languageId":"de","category":"idioms","level":"B2","sourceText":"schwarz auf weiß","translations":{"tr":["yazılı olarak"]},"details":{"explanation":"Bir şeyin kesin ve yazılı biçimde belgelenmesi."},"examples":[{"text":"Ich will das schwarz auf weiß haben.","tr":"Bunu yazılı olarak istiyorum."}]}
]
