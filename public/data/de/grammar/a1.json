[
  {"id":"de-gr-artikel-und-genus","languageId":"de","category":"grammar","level":"A1","sourceText":"Artikel und Genus","translations":{"tr":["Artikeller ve Cinsiyet"]},"grammar":{"summary":"Almancada her ismin bir cinsiyeti vardır: eril der, dişil die, nötr das; belirsiz artikel ein/eine'dir.","uses":["Bilinen ya da daha önce geçen şeyler için belirli artikel (der/die/das)","İlk kez söz edilen ya da herhangi bir şey için belirsiz artikel (ein/eine)","Her ismi artikeliyle birlikte ezberlemek için"],"sections":[{"kind":"other","title":"Belirli artikel","formula":[{"tr":"der / die / das","en":"bestimmter Artikel","role":"x"},{"tr":"İsim","en":"Nomen","role":"o"}],"examples":[{"text":"[x:Der] [o:Tisch] ist groß.","tr":"Masa büyük."},{"text":"[x:Die] [o:Lampe] ist neu. [x:Das] [o:Buch] ist alt.","tr":"Lamba yeni. Kitap eski."}],"notes":["Çoğulda tüm cinsiyetler için die kullanılır: die Tische, die Bücher."]},{"kind":"other","title":"Belirsiz artikel","formula":[{"tr":"ein / eine / ein","en":"unbestimmter Artikel","role":"x"},{"tr":"İsim","en":"Nomen","role":"o"}],"examples":[{"text":"Das ist [x:ein] [o:Stuhl].","tr":"Bu bir sandalye."},{"text":"Ich habe [x:eine] [o:Schwester].","tr":"Bir kız kardeşim var."}],"notes":["Belirsiz artikelin çoğulu yoktur: Ich habe Bücher."]},{"kind":"other","title":"Cinsiyet ipuçları","formula":[{"tr":"-ung / -heit / -keit / -ion","en":"feminin (die)","role":"x"},{"tr":"-chen / -lein","en":"neutral (das)","role":"x"},{"tr":"-er / -ling","en":"maskulin (der)","role":"x"}],"examples":[{"text":"[x:die] Zeitung, [x:die] Freiheit, [x:die] Station","tr":"gazete, özgürlük, istasyon"},{"text":"[x:das] Mädchen, [x:der] Lehrer","tr":"kız çocuk, öğretmen"}]}],"rules":["İsimler her zaman büyük harfle yazılır.","Bileşik isimlerde cinsiyeti son kelime belirler: das Haus + die Tür → die Haustür.","Cinsiyet çoğu zaman anlamla ilgili değildir; isimleri artikelle öğren."],"exceptions":["das Mädchen anlamca dişi olsa da -chen eki yüzünden nötrdür."],"mistakes":[{"wrong":"Die Buch ist interessant.","right":"Das Buch ist interessant.","note":"Buch nötrdür (das)."},{"wrong":"Ich habe ein Schwester.","right":"Ich habe eine Schwester.","note":"Dişil isimlerde belirsiz artikel eine olur."},{"wrong":"der tisch","right":"der Tisch","note":"İsimler büyük harfle başlar."}]}},
  {"id":"de-gr-personalpronomen","languageId":"de","category":"grammar","level":"A1","sourceText":"Personalpronomen","translations":{"tr":["Şahıs Zamirleri"]},"grammar":{"summary":"Yalın hâldeki şahıs zamirleri (ich, du, er, sie, es, wir, ihr, sie, Sie) cümlenin öznesidir ve fiil bunlara göre çekilir.","uses":["Cümlenin öznesini belirtmek","Bir ismin yerine kullanmak (der Tisch → er)","Resmî hitap için Sie"],"sections":[{"kind":"other","title":"Tekil zamirler","formula":[{"tr":"ich / du / er / sie / es","en":"Singular","role":"s"},{"tr":"Çekimli fiil","en":"Verb","role":"v"}],"examples":[{"text":"[s:Ich] [v:komme] aus der Türkei.","tr":"Türkiye'den geliyorum."},{"text":"[s:Er] [v:wohnt] in Köln.","tr":"O Köln'de oturuyor."}]},{"kind":"other","title":"Çoğul zamirler ve Sie","formula":[{"tr":"wir / ihr / sie / Sie","en":"Plural / Höflichkeitsform","role":"s"},{"tr":"Çekimli fiil","en":"Verb","role":"v"}],"examples":[{"text":"[s:Wir] [v:lernen] Deutsch.","tr":"Biz Almanca öğreniyoruz."},{"text":"Woher [v:kommen] [s:Sie]?","tr":"Nerelisiniz?"}],"notes":["Resmî Sie her zaman büyük harfle yazılır ve çoğul fiil alır."]},{"kind":"other","title":"İsim yerine zamir","formula":[{"tr":"der → er","en":"maskulin","role":"s"},{"tr":"die → sie","en":"feminin","role":"s"},{"tr":"das → es","en":"neutral","role":"s"}],"examples":[{"text":"Der Tisch ist neu. [s:Er] [v:ist] schön.","tr":"Masa yeni. O (masa) güzel."},{"text":"Die Tasche ist teuer. [s:Sie] [v:kostet] 80 Euro.","tr":"Çanta pahalı. 80 avro tutuyor."}]}],"rules":["Türkçedeki gibi özne düşürülemez; zamir mutlaka yazılır.","sie küçük harfle 'o (kadın)' ya da 'onlar', Sie büyük harfle 'siz (resmî)' demektir; fiil çekimi ayırt etmeye yardım eder.","Eşyalar da cinsiyetlerine göre er/sie/es ile karşılanır."],"exceptions":[],"mistakes":[{"wrong":"Komme aus Ankara.","right":"Ich komme aus Ankara.","note":"Özne zamiri düşürülmez."},{"wrong":"Der Computer ist alt. Es ist langsam.","right":"Der Computer ist alt. Er ist langsam.","note":"Computer eril olduğu için er ile karşılanır."}]}},
  {"id":"de-gr-sein-und-haben","languageId":"de","category":"grammar","level":"A1","sourceText":"sein und haben","translations":{"tr":["sein (olmak) ve haben (sahip olmak)"]},"grammar":{"summary":"sein 'olmak', haben 'sahip olmak / -si var' anlamına gelir; ikisi de düzensiz çekilir ve en sık kullanılan fiillerdir.","uses":["Kimlik, meslek, köken, özellik (sein)","Sahiplik, yaş dışındaki 'var' cümleleri (haben)","Perfekt'te yardımcı fiil olarak"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"bin/bist/ist/sind/seid · habe/hast/hat/haben/habt","en":"sein / haben","role":"a"},{"tr":"Tümleç","en":"Ergänzung","role":"o"}],"examples":[{"text":"[s:Ich] [a:bin] [o:Lehrerin].","tr":"Ben öğretmenim."},{"text":"[s:Er] [a:hat] [o:ein Auto].","tr":"Onun bir arabası var."}],"notes":["sein: ich bin, du bist, er ist, wir sind, ihr seid, sie sind. haben: ich habe, du hast, er hat, wir haben, ihr habt, sie haben."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"sein / haben","en":"Verb","role":"a"},{"tr":"nicht / kein","en":"Negation","role":"x"},{"tr":"Tümleç","en":"Ergänzung","role":"o"}],"examples":[{"text":"[s:Sie] [a:ist] [x:nicht] [o:müde].","tr":"O yorgun değil."},{"text":"[s:Wir] [a:haben] [x:keine] [o:Zeit].","tr":"Vaktimiz yok."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"sein / haben","en":"Verb","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Tümleç?","en":"Ergänzung","role":"o"}],"examples":[{"text":"[a:Bist] [s:du] [o:verheiratet]?","tr":"Evli misin?"},{"text":"[a:Haben] [s:Sie] [o:Kinder]?","tr":"Çocuklarınız var mı?"}]},{"kind":"wh","title":"W-soruları","formula":[{"tr":"Soru kelimesi","en":"W-Wort","role":"q"},{"tr":"sein / haben","en":"Verb","role":"a"},{"tr":"Özne?","en":"Subjekt","role":"s"}],"examples":[{"text":"[q:Wie alt] [a:bist] [s:du]?","tr":"Kaç yaşındasın?"},{"text":"[q:Was] [a:hast] [s:du] heute?","tr":"Bugün neyin var?"}]}],"rules":["Yaş sein ile söylenir: Ich bin 25 (Jahre alt).","'Bir şeyim var' cümleleri haben ile kurulur: Ich habe Hunger (Acıktım).","Meslek ve milliyet önünde artikel kullanılmaz: Ich bin Arzt."],"exceptions":["'Var' anlamında genel durum için es gibt kullanılır: Hier gibt es ein Café."],"mistakes":[{"wrong":"Ich habe 20 Jahre.","right":"Ich bin 20 Jahre alt.","note":"Yaş haben ile değil sein ile söylenir."},{"wrong":"Ich bin ein Student.","right":"Ich bin Student.","note":"Meslek/statü önünde artikel kullanılmaz."},{"wrong":"Du habst Zeit.","right":"Du hast Zeit.","note":"haben düzensizdir: du hast, er hat."}]}},
  {"id":"de-gr-prasens-regelmassige-verben","languageId":"de","category":"grammar","level":"A1","sourceText":"Präsens: regelmäßige Verben","translations":{"tr":["Şimdiki/Geniş Zaman: Düzenli Fiiller"]},"grammar":{"summary":"Präsens, fiil köküne kişi eki (-e, -st, -t, -en, -t, -en) eklenerek kurulur; hem şimdiki hem geniş zamanı karşılar.","uses":["Şu an olan eylemler","Alışkanlıklar ve genel gerçekler","Zaman ifadesiyle yakın gelecek (Morgen fahre ich nach Hause.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil kökü + ek","en":"Verbstamm + Endung","role":"v"},{"tr":"Nesne / Tümleç","en":"Objekt","role":"o"}],"examples":[{"text":"[s:Ich] [v:lerne] [o:Deutsch].","tr":"Almanca öğreniyorum."},{"text":"[s:Sie] [v:wohnt] [o:in Hamburg].","tr":"O Hamburg'da oturuyor."}],"notes":["Ekler: ich -e, du -st, er/sie/es -t, wir -en, ihr -t, sie/Sie -en."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Çekimli fiil","en":"Verb","role":"v"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"nicht","en":"nicht","role":"x"}],"examples":[{"text":"[s:Ich] [v:arbeite] [o:heute] [x:nicht].","tr":"Bugün çalışmıyorum."},{"text":"[s:Er] [v:spielt] [x:nicht] [o:gut] Fußball.","tr":"O iyi futbol oynamaz."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Çekimli fiil","en":"Verb","role":"v"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Nesne?","en":"Objekt","role":"o"}],"examples":[{"text":"[v:Spielst] [s:du] [o:Gitarre]?","tr":"Gitar çalar mısın?"},{"text":"[v:Wohnen] [s:Sie] [o:hier]?","tr":"Burada mı oturuyorsunuz?"}]},{"kind":"wh","title":"W-soruları","formula":[{"tr":"Soru kelimesi","en":"W-Wort","role":"q"},{"tr":"Çekimli fiil","en":"Verb","role":"v"},{"tr":"Özne?","en":"Subjekt","role":"s"}],"examples":[{"text":"[q:Was] [v:machst] [s:du]?","tr":"Ne yapıyorsun?"},{"text":"[q:Wo] [v:arbeitet] [s:ihr]?","tr":"Nerede çalışıyorsunuz?"}]}],"rules":["Almancada ayrı bir şimdiki zaman yoktur; Präsens her ikisini karşılar.","Kökü -t/-d ile bitenler araya -e- alır: du arbeitest, er findet.","Kökü -s/-ß/-z ile bitenlerde du için sadece -t eklenir: du heißt, du tanzt."],"exceptions":["-eln ile biten fiillerde ich çekiminde e düşer: sammeln → ich sammle."],"mistakes":[{"wrong":"Ich bin lernen Deutsch.","right":"Ich lerne Deutsch.","note":"İngilizcedeki 'am learning' gibi yardımcı fiil kullanılmaz."},{"wrong":"Du arbeitst viel.","right":"Du arbeitest viel.","note":"Kökü -t ile biten fiil araya -e- alır."},{"wrong":"Er wohnen in Berlin.","right":"Er wohnt in Berlin.","note":"er/sie/es ile fiil -t alır."}]}},
  {"id":"de-gr-prasens-verben-mit-vokalwechsel","languageId":"de","category":"grammar","level":"A1","sourceText":"Präsens: Verben mit Vokalwechsel","translations":{"tr":["Şimdiki Zaman: Ünlü Değişimli Fiiller"]},"grammar":{"summary":"Bazı güçlü fiiller du ve er/sie/es çekiminde kök ünlüsünü değiştirir: e→i, e→ie, a→ä, au→äu.","uses":["fahren, schlafen, essen, sprechen, lesen, sehen, nehmen gibi çok sık fiilleri doğru çekmek"],"sections":[{"kind":"other","title":"e → i / ie","formula":[{"tr":"du / er, sie, es","en":"2./3. Person Singular","role":"s"},{"tr":"Kök e → i / ie","en":"Vokalwechsel e → i(e)","role":"v"}],"examples":[{"text":"[s:Du] [v:sprichst] gut Deutsch.","tr":"İyi Almanca konuşuyorsun."},{"text":"[s:Sie] [v:liest] ein Buch.","tr":"O bir kitap okuyor."}],"notes":["sprechen, essen (isst), geben (gibt), nehmen (nimmt), helfen (hilft); lesen (liest), sehen (sieht)."]},{"kind":"other","title":"a → ä, au → äu","formula":[{"tr":"du / er, sie, es","en":"2./3. Person Singular","role":"s"},{"tr":"Kök a → ä","en":"Vokalwechsel a → ä","role":"v"}],"examples":[{"text":"[s:Er] [v:fährt] mit dem Bus.","tr":"O otobüsle gidiyor."},{"text":"[s:Das Baby] [v:schläft].","tr":"Bebek uyuyor."}],"notes":["fahren (fährt), schlafen (schläft), tragen (trägt), waschen (wäscht), laufen (läuft)."]},{"kind":"other","title":"Diğer kişiler değişmez","formula":[{"tr":"ich / wir / ihr / sie","en":"andere Personen","role":"s"},{"tr":"Düzenli kök","en":"Verbstamm","role":"v"}],"examples":[{"text":"[s:Ich] [v:fahre] nach Berlin, [s:wir] [v:fahren] zusammen.","tr":"Berlin'e gidiyorum, birlikte gidiyoruz."}]}],"rules":["Değişim sadece du ve er/sie/es çekiminde olur.","Sözlükte bu fiiller genelde 3. tekil ile verilir: fahren (fährt).","nehmen düzensizdir: du nimmst, er nimmt."],"exceptions":["wissen tamamen düzensizdir: ich weiß, du weißt, er weiß."],"mistakes":[{"wrong":"Er fahrt nach Hause.","right":"Er fährt nach Hause.","note":"fahren er çekiminde ä alır."},{"wrong":"Du esst viel.","right":"Du isst viel.","note":"essen: du isst, er isst."},{"wrong":"Ich spreche, wir sprichen.","right":"Ich spreche, wir sprechen.","note":"Ünlü değişimi çoğulda olmaz."}]}},
  {"id":"de-gr-satzbau-verbzweitstellung","languageId":"de","category":"grammar","level":"A1","sourceText":"Satzbau: Verbzweitstellung","translations":{"tr":["Cümle Yapısı: Fiil İkinci Sırada"]},"grammar":{"summary":"Almanca ana cümlede çekimli fiil her zaman ikinci sıradadır; başa başka bir öğe gelirse özne fiilden sonraya geçer.","uses":["Düz cümle kurmak","Zaman ya da yer ifadesini vurgulamak için başa almak","Türkçedeki 'fiil sonda' alışkanlığını düzeltmek"],"sections":[{"kind":"other","title":"Özne başta","formula":[{"tr":"Özne (1)","en":"Subjekt (Position 1)","role":"s"},{"tr":"Çekimli fiil (2)","en":"Verb (Position 2)","role":"v"},{"tr":"Diğer öğeler","en":"Mittelfeld","role":"o"}],"examples":[{"text":"[s:Ich] [v:trinke] [o:morgens Kaffee].","tr":"Sabahları kahve içerim."}]},{"kind":"other","title":"Başka öğe başta (devrik)","formula":[{"tr":"Zaman / yer (1)","en":"Position 1","role":"x"},{"tr":"Çekimli fiil (2)","en":"Verb (Position 2)","role":"v"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Diğer öğeler","en":"Mittelfeld","role":"o"}],"examples":[{"text":"[x:Morgens] [v:trinke] [s:ich] [o:Kaffee].","tr":"Sabahları kahve içerim."},{"text":"[x:Heute] [v:gehen] [s:wir] [o:ins Kino].","tr":"Bugün sinemaya gidiyoruz."}]},{"kind":"other","title":"Zaman – neden – şekil – yer (TeKaMoLo)","formula":[{"tr":"Zaman","en":"temporal","role":"x"},{"tr":"Neden","en":"kausal","role":"x"},{"tr":"Şekil","en":"modal","role":"x"},{"tr":"Yer","en":"lokal","role":"x"}],"examples":[{"text":"Ich fahre [x:morgen] [x:wegen der Arbeit] [x:mit dem Zug] [x:nach München].","tr":"Yarın iş yüzünden trenle Münih'e gidiyorum."}]}],"rules":["Fiil ikinci 'öğe'dir, ikinci kelime değil: Am Montag gehe ich… (Am Montag tek öğedir).","Başa gelen öğe öznenin değilse özne hemen fiilden sonra gelir.","und, aber, oder, denn sıra almaz (0. pozisyon)."],"exceptions":["Evet/hayır soruları ve emir cümleleri fiille başlar."],"mistakes":[{"wrong":"Heute ich gehe ins Kino.","right":"Heute gehe ich ins Kino.","note":"Fiil ikinci sırada kalmalı, özne fiilden sonraya geçer."},{"wrong":"Ich Kaffee trinke.","right":"Ich trinke Kaffee.","note":"Türkçedeki gibi fiil sona gitmez."}]}},
  {"id":"de-gr-fragen-ja-nein-fragen-und-w-fragen","languageId":"de","category":"grammar","level":"A1","sourceText":"Fragen: Ja/Nein-Fragen und W-Fragen","translations":{"tr":["Sorular: Evet/Hayır ve W-Soruları"]},"grammar":{"summary":"Evet/hayır sorusunda çekimli fiil başa gelir; W-sorusunda soru kelimesi başta, fiil ikinci sıradadır.","uses":["Bilgi sormak (wer, was, wo, woher, wohin, wann, wie, warum)","Evet/hayır cevabı beklenen sorular","Kısa cevaplar: ja, nein, doch"],"sections":[{"kind":"question","title":"Evet/hayır sorusu","formula":[{"tr":"Çekimli fiil","en":"Verb","role":"v"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Diğer öğeler?","en":"Ergänzung","role":"o"}],"examples":[{"text":"[v:Kommst] [s:du] [o:heute]?","tr":"Bugün geliyor musun?"},{"text":"[v:Sprechen] [s:Sie] [o:Englisch]?","tr":"İngilizce konuşuyor musunuz?"}]},{"kind":"wh","title":"W-soruları","formula":[{"tr":"W-kelimesi","en":"W-Wort","role":"q"},{"tr":"Çekimli fiil","en":"Verb","role":"v"},{"tr":"Özne?","en":"Subjekt","role":"s"}],"examples":[{"text":"[q:Woher] [v:kommst] [s:du]?","tr":"Nerelisin?"},{"text":"[q:Wann] [v:beginnt] [s:der Kurs]?","tr":"Kurs ne zaman başlıyor?"}],"notes":["wo = nerede, woher = nereden, wohin = nereye."]},{"kind":"short-answers","title":"Kısa cevaplar: ja, nein, doch","formula":[{"tr":"ja / nein / doch","en":"Antwortpartikel","role":"x"},{"tr":"Cümle","en":"Satz","role":"o"}],"examples":[{"text":"Hast du keinen Hunger? — [x:Doch], [o:ich habe Hunger].","tr":"Aç değil misin? — Hayır, açım."},{"text":"Bist du müde? — [x:Nein], [o:ich bin nicht müde].","tr":"Yorgun musun? — Hayır, değilim."}]}],"rules":["Olumsuz bir soruya olumlu cevap doch ile verilir.","Soru cümlesinde Türkçedeki 'mi' gibi ayrı bir ek yoktur; fiil başa gelir.","wer (kim) Nominativ, wen Akkusativ, wem Dativ hâlidir."],"exceptions":[],"mistakes":[{"wrong":"Du kommst aus Izmir?","right":"Kommst du aus Izmir?","note":"Standart soruda fiil başa gelir (düz cümle sadece tonlamayla da kullanılır ama doğal soru bu değildir)."},{"wrong":"Wo du wohnst?","right":"Wo wohnst du?","note":"W-sorusunda fiil ikinci sırada."},{"wrong":"Wo gehst du? (nereye)","right":"Wohin gehst du?","note":"Yön sorarken wohin kullanılır."}]}},
  {"id":"de-gr-negation-nicht-und-kein","languageId":"de","category":"grammar","level":"A1","sourceText":"Negation: nicht und kein","translations":{"tr":["Olumsuzluk: nicht ve kein"]},"grammar":{"summary":"Artikelsiz ya da ein/eine'li isimler kein ile, fiil, sıfat ve belirli isimler nicht ile olumsuz yapılır.","uses":["İsmi olumsuzlamak (kein)","Fiili, sıfatı, zarfı ya da tüm cümleyi olumsuzlamak (nicht)"],"sections":[{"kind":"other","title":"kein + isim","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"kein / keine","en":"Negativartikel","role":"x"},{"tr":"İsim","en":"Nomen","role":"o"}],"examples":[{"text":"[s:Ich] [v:habe] [x:kein] [o:Auto].","tr":"Arabam yok."},{"text":"[s:Er] [v:trinkt] [x:keinen] [o:Kaffee].","tr":"O kahve içmez."}],"notes":["kein, ein gibi çekilir; çoğulu keine'dir: Ich habe keine Kinder."]},{"kind":"other","title":"nicht + fiil / sıfat","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"nicht","en":"nicht","role":"x"},{"tr":"Sıfat / zarf","en":"Adjektiv","role":"o"}],"examples":[{"text":"[s:Das Essen] [v:ist] [x:nicht] [o:warm].","tr":"Yemek sıcak değil."},{"text":"[s:Ich] [v:komme] [x:nicht].","tr":"Gelmiyorum."}]},{"kind":"other","title":"nicht + belirli isim","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"Belirli nesne","en":"Objekt","role":"o"},{"tr":"nicht","en":"nicht","role":"x"}],"examples":[{"text":"[s:Ich] [v:kenne] [o:den Mann] [x:nicht].","tr":"Adamı tanımıyorum."}]}],"rules":["ein/eine yerine kein/keine gelir; artikelsiz isim de kein ile olumsuzlanır.","nicht tüm cümleyi olumsuzlarken genelde sona doğru gelir, ama sıfat ve yer ifadelerinden önce durur: Ich wohne nicht in Berlin.","Belirli artikelli isimler (der/die/das) ve özel isimler nicht ile olumsuzlanır."],"exceptions":[],"mistakes":[{"wrong":"Ich habe nicht ein Auto.","right":"Ich habe kein Auto.","note":"ein yerine kein kullanılır."},{"wrong":"Ich habe nicht Zeit.","right":"Ich habe keine Zeit.","note":"Artikelsiz isim kein ile olumsuzlanır."},{"wrong":"Ich nicht komme.","right":"Ich komme nicht.","note":"nicht fiilden sonra gelir."}]}},
  {"id":"de-gr-plural-der-nomen","languageId":"de","category":"grammar","level":"A1","sourceText":"Plural der Nomen","translations":{"tr":["İsimlerin Çoğulu"]},"grammar":{"summary":"Almancada çoğul tek bir ekle yapılmaz; isimler -e, -(e)n, -er, -s ekleri, ünlü değişimi (Umlaut) ya da eksiz çoğul alır ve artikel her zaman die olur.","uses":["Birden fazla şeyden söz etmek","Sözlükte isimle birlikte çoğulunu öğrenmek"],"sections":[{"kind":"other","title":"-e / ¨-e","formula":[{"tr":"die","en":"Artikel Plural","role":"x"},{"tr":"İsim + -e (bazen Umlaut)","en":"Nomen + -e","role":"o"}],"examples":[{"text":"der Tisch → [x:die] [o:Tische]; der Stuhl → [x:die] [o:Stühle]","tr":"masalar; sandalyeler"}]},{"kind":"other","title":"-(e)n","formula":[{"tr":"die","en":"Artikel Plural","role":"x"},{"tr":"İsim + -(e)n","en":"Nomen + -(e)n","role":"o"}],"examples":[{"text":"die Lampe → [x:die] [o:Lampen]; die Frau → [x:die] [o:Frauen]","tr":"lambalar; kadınlar"}],"notes":["Dişil isimlerin çoğu -(e)n alır; -in ile bitenler -nen alır: Lehrerinnen."]},{"kind":"other","title":"-er / ¨-er","formula":[{"tr":"die","en":"Artikel Plural","role":"x"},{"tr":"İsim + -er (Umlaut)","en":"Nomen + -er","role":"o"}],"examples":[{"text":"das Kind → [x:die] [o:Kinder]; das Buch → [x:die] [o:Bücher]","tr":"çocuklar; kitaplar"}]},{"kind":"other","title":"-s ve eksiz","formula":[{"tr":"die","en":"Artikel Plural","role":"x"},{"tr":"İsim + -s / –","en":"Nomen + -s / –","role":"o"}],"examples":[{"text":"das Auto → [x:die] [o:Autos]; der Lehrer → [x:die] [o:Lehrer]","tr":"arabalar; öğretmenler"}],"notes":["-s çoğunlukla yabancı kökenli ve ünlüyle biten isimlerdedir; -er, -el, -en ile biten eril/nötr isimler genelde eksizdir."]}],"rules":["Çoğulda artikel her zaman die'dir.","Çoğul ekini isimle birlikte ezberle: das Haus, die Häuser.","Dativ çoğulda isim -n alır (zaten -n/-s ile bitmiyorsa): mit den Kindern."],"exceptions":["Bazı isimlerin çoğulu yoktur ya da nadiren kullanılır: die Milch, das Obst."],"mistakes":[{"wrong":"die Kinds","right":"die Kinder","note":"-s çoğulu sadece belirli isimlerde kullanılır."},{"wrong":"der Bücher","right":"die Bücher","note":"Çoğul artikel her zaman die'dir."}]}},
  {"id":"de-gr-der-akkusativ","languageId":"de","category":"grammar","level":"A1","sourceText":"Der Akkusativ","translations":{"tr":["Belirtme Hâli (-i hâli)"]},"grammar":{"summary":"Akkusativ, fiilin doğrudan nesnesidir; sadece eril artikel değişir: der → den, ein → einen, kein → keinen.","uses":["Doğrudan nesne (haben, brauchen, kaufen, sehen, möchten…)","Akkusativ edatlarından sonra (für, ohne, durch…)","es gibt yapısından sonra"],"sections":[{"kind":"other","title":"Eril: der → den","formula":[{"tr":"Özne","en":"Subjekt (Nominativ)","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"den / einen + İsim","en":"Akkusativobjekt","role":"o"}],"examples":[{"text":"[s:Ich] [v:sehe] [o:den Mann].","tr":"Adamı görüyorum."},{"text":"[s:Wir] [v:brauchen] [o:einen Tisch].","tr":"Bir masaya ihtiyacımız var."}]},{"kind":"other","title":"Dişil, nötr, çoğul değişmez","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"die / das / die + İsim","en":"Akkusativobjekt","role":"o"}],"examples":[{"text":"[s:Sie] [v:kauft] [o:eine Jacke].","tr":"O bir ceket alıyor."},{"text":"[s:Er] [v:liest] [o:das Buch].","tr":"O kitabı okuyor."}]},{"kind":"other","title":"es gibt + Akkusativ","formula":[{"tr":"es gibt","en":"es gibt","role":"a"},{"tr":"Akkusativ","en":"Akkusativ","role":"o"}],"examples":[{"text":"Hier [a:gibt es] [o:einen Park].","tr":"Burada bir park var."}]}],"rules":["Sadece eril tekilde değişiklik olur: der/ein/kein/mein → den/einen/keinen/meinen.","Soru kelimesi: wen (kimi), was (neyi).","Türkçede belirsiz nesne ek almaz ama Almancada eril nesne her zaman einen olur: Ich kaufe einen Apfel."],"exceptions":["Bazı eril isimler Akkusativ'de -n/-en alır (n-Deklination): den Studenten, den Herrn."],"mistakes":[{"wrong":"Ich habe ein Bruder.","right":"Ich habe einen Bruder.","note":"Bruder eril; Akkusativ'de einen olur."},{"wrong":"Ich sehe der Hund.","right":"Ich sehe den Hund.","note":"Doğrudan nesne Akkusativ'dir: den."},{"wrong":"Es gibt ein Supermarkt.","right":"Es gibt einen Supermarkt.","note":"es gibt Akkusativ ister."}]}},
  {"id":"de-gr-possessivartikel","languageId":"de","category":"grammar","level":"A1","sourceText":"Possessivartikel","translations":{"tr":["İyelik Artikelleri"]},"grammar":{"summary":"mein, dein, sein, ihr, unser, euer, ihr/Ihr kime ait olduğunu gösterir ve ein gibi çekilir.","uses":["Sahiplik belirtmek (benim, senin, onun…)","Aile ve eşyalardan söz etmek"],"sections":[{"kind":"other","title":"Kişiye göre iyelik","formula":[{"tr":"mein / dein / sein / ihr","en":"Possessivartikel","role":"x"},{"tr":"unser / euer / ihr / Ihr","en":"Possessivartikel","role":"x"},{"tr":"İsim","en":"Nomen","role":"o"}],"examples":[{"text":"Das ist [x:mein] [o:Vater].","tr":"Bu benim babam."},{"text":"Wo ist [x:Ihr] [o:Pass]?","tr":"Pasaportunuz nerede?"}],"notes":["sein = onun (erkek/nötr), ihr = onun (kadın) ya da onların."]},{"kind":"other","title":"Ek: ismin cinsiyetine göre","formula":[{"tr":"mein (der/das)","en":"maskulin / neutral","role":"x"},{"tr":"meine (die / çoğul)","en":"feminin / Plural","role":"x"},{"tr":"meinen (Akk. eril)","en":"Akkusativ maskulin","role":"x"}],"examples":[{"text":"[x:Meine] Schwester und [x:mein] Bruder wohnen in Bonn.","tr":"Kız kardeşim ve erkek kardeşim Bonn'da oturuyor."},{"text":"Ich suche [x:meinen] Schlüssel.","tr":"Anahtarımı arıyorum."}]}],"rules":["Kök sahibine göre seçilir (mein/dein/sein…), ek ise sahip olunan ismin cinsiyeti ve hâline göre.","euer, ek alınca e düşer: eure Kinder.","Türkçedeki iyelik eki yerine isimden önce iyelik artikeli gelir; ayrıca artikel kullanılmaz."],"exceptions":[],"mistakes":[{"wrong":"Das ist sein Mutter.","right":"Das ist seine Mutter.","note":"Mutter dişil; ek -e olur."},{"wrong":"Anna und sein Bruder","right":"Anna und ihr Bruder","note":"Sahip kadın olduğu için ihr kullanılır."},{"wrong":"die meine Tasche","right":"meine Tasche","note":"İyelik artikeliyle birlikte der/die/das kullanılmaz."}]}},
  {"id":"de-gr-modalverben","languageId":"de","category":"grammar","level":"A1","sourceText":"Modalverben","translations":{"tr":["Kip Fiilleri"]},"grammar":{"summary":"können, müssen, wollen, dürfen, sollen, mögen/möchten ikinci sırada çekilir, asıl fiil mastar hâlinde cümlenin sonuna gider.","uses":["Yetenek ve imkân (können)","Zorunluluk (müssen), izin (dürfen), tavsiye (sollen)","İstek (wollen, möchten)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Modal fiil","en":"Modalverb","role":"a"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"Mastar (sonda)","en":"Infinitiv","role":"v"}],"examples":[{"text":"[s:Ich] [a:kann] [o:gut Deutsch] [v:sprechen].","tr":"İyi Almanca konuşabiliyorum."},{"text":"[s:Wir] [a:müssen] [o:heute] [v:arbeiten].","tr":"Bugün çalışmak zorundayız."}],"notes":["ich ve er/sie/es çekimi aynıdır ve ek almaz: ich kann, er kann; ich muss, er muss."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Modal fiil","en":"Modalverb","role":"a"},{"tr":"nicht / kein","en":"Negation","role":"x"},{"tr":"Mastar","en":"Infinitiv","role":"v"}],"examples":[{"text":"[s:Du] [a:darfst] hier [x:nicht] [v:rauchen].","tr":"Burada sigara içemezsin (izin yok)."},{"text":"[s:Sie] [a:muss] [x:nicht] [v:kommen].","tr":"Onun gelmesi gerekmiyor."}],"notes":["nicht müssen = gerekmemek; 'yasak' anlamı için nicht dürfen kullanılır."]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Modal fiil","en":"Modalverb","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"Mastar?","en":"Infinitiv","role":"v"}],"examples":[{"text":"[a:Kannst] [s:du] [o:mir] [v:helfen]?","tr":"Bana yardım edebilir misin?"},{"text":"[a:Darf] [s:ich] [o:das Fenster] [v:öffnen]?","tr":"Pencereyi açabilir miyim?"}]},{"kind":"wh","title":"W-soruları","formula":[{"tr":"W-kelimesi","en":"W-Wort","role":"q"},{"tr":"Modal fiil","en":"Modalverb","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Mastar?","en":"Infinitiv","role":"v"}],"examples":[{"text":"[q:Was] [a:möchtest] [s:du] [v:trinken]?","tr":"Ne içmek istersin?"},{"text":"[q:Wann] [a:musst] [s:ihr] [v:gehen]?","tr":"Ne zaman gitmeniz gerekiyor?"}]}],"rules":["Asıl fiil mastar hâlinde cümlenin en sonuna gider (Satzklammer).","Çoğu modal fiil tekilde ünlü değiştirir: können → ich kann, müssen → ich muss, dürfen → ich darf, wollen → ich will.","möchten kibar istek bildirir ve çok sık kullanılır: Ich möchte einen Tee."],"exceptions":["Bağlam açıksa asıl fiil düşebilir: Ich kann Deutsch. Ich muss nach Hause."],"mistakes":[{"wrong":"Ich kann sprechen gut Deutsch.","right":"Ich kann gut Deutsch sprechen.","note":"Mastar cümlenin sonuna gider."},{"wrong":"Er kannt schwimmen.","right":"Er kann schwimmen.","note":"Modal fiiller er/sie/es ile ek almaz."},{"wrong":"Ich will zu gehen.","right":"Ich will gehen.","note":"Modal fiilden sonra zu kullanılmaz."}]}},
  {"id":"de-gr-trennbare-verben","languageId":"de","category":"grammar","level":"A1","sourceText":"Trennbare Verben","translations":{"tr":["Ayrılabilen Fiiller"]},"grammar":{"summary":"aufstehen, anrufen, einkaufen gibi fiillerde ön ek çekimli cümlede ayrılır ve cümlenin sonuna gider.","uses":["Günlük rutinleri anlatmak (aufstehen, anfangen, fernsehen)","Telefon, alışveriş, davet (anrufen, einkaufen, einladen)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil kökü","en":"Verbstamm","role":"v"},{"tr":"Diğer öğeler","en":"Mittelfeld","role":"o"},{"tr":"Ön ek (sonda)","en":"Präfix","role":"x"}],"examples":[{"text":"[s:Ich] [v:stehe] [o:um 7 Uhr] [x:auf].","tr":"Saat 7'de kalkarım."},{"text":"[s:Sie] [v:ruft] [o:ihre Mutter] [x:an].","tr":"Annesini arıyor."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Fiil kökü","en":"Verbstamm","role":"v"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Diğer öğeler","en":"Mittelfeld","role":"o"},{"tr":"Ön ek?","en":"Präfix","role":"x"}],"examples":[{"text":"[v:Kaufst] [s:du] [o:heute] [x:ein]?","tr":"Bugün alışveriş yapıyor musun?"},{"text":"Wann [v:fängt] [s:der Film] [x:an]?","tr":"Film ne zaman başlıyor?"}]},{"kind":"other","title":"Modal fiille: birleşik mastar","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Modal fiil","en":"Modalverb","role":"a"},{"tr":"Birleşik mastar","en":"Infinitiv (ungetrennt)","role":"v"}],"examples":[{"text":"[s:Ich] [a:muss] morgen früh [v:aufstehen].","tr":"Yarın erken kalkmam gerek."}]}],"rules":["Ayrılabilen ön ekler vurgulu olur: ab-, an-, auf-, aus-, ein-, mit-, vor-, zu-, zurück-, fern-.","Yan cümlede ve mastarda fiil birleşik kalır: …, weil ich früh aufstehe.","Partizip II'de -ge- ön ekle kök arasına girer: angerufen, eingekauft."],"exceptions":["be-, ver-, er-, ent-, zer-, ge- ön ekleri ayrılmaz: verstehen → ich verstehe."],"mistakes":[{"wrong":"Ich aufstehe um 6 Uhr.","right":"Ich stehe um 6 Uhr auf.","note":"Ön ek ayrılır ve sona gider."},{"wrong":"Ich rufe an dich.","right":"Ich rufe dich an.","note":"Ön ek cümlenin en sonunda durur."},{"wrong":"Ich verstehe nicht ver.","right":"Ich verstehe nicht.","note":"ver- ayrılmayan bir ön ektir."}]}},
  {"id":"de-gr-imperativ","languageId":"de","category":"grammar","level":"A1","sourceText":"Imperativ","translations":{"tr":["Emir Kipi"]},"grammar":{"summary":"Emir kipi du, ihr ve Sie için ayrı biçimlerle kurulur ve fiil cümlenin başına gelir.","uses":["Rica ve talimat vermek","Tarif ve yön tarifi","bitte ile kibar istek"],"sections":[{"kind":"other","title":"du-Imperativ","formula":[{"tr":"Fiil kökü (-st/du yok)","en":"Verbstamm","role":"v"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"(bitte)","en":"bitte","role":"x"}],"examples":[{"text":"[v:Komm] [o:her]!","tr":"Buraya gel!"},{"text":"[v:Nimm] [o:den Bus], [x:bitte]!","tr":"Lütfen otobüse bin!"}],"notes":["e→i değişen fiiller değişimi korur (nehmen → nimm, lesen → lies); a→ä değişimi olmaz (fahren → fahr)."]},{"kind":"other","title":"ihr-Imperativ","formula":[{"tr":"ihr çekimi (zamir yok)","en":"Verb (ihr-Form)","role":"v"},{"tr":"Nesne","en":"Objekt","role":"o"}],"examples":[{"text":"[v:Macht] [o:die Bücher] auf!","tr":"Kitapları açın!"}]},{"kind":"other","title":"Sie-Imperativ","formula":[{"tr":"Mastar","en":"Infinitiv","role":"v"},{"tr":"Sie","en":"Sie","role":"s"},{"tr":"Nesne","en":"Objekt","role":"o"}],"examples":[{"text":"[v:Warten] [s:Sie] [o:bitte hier].","tr":"Lütfen burada bekleyin."},{"text":"[v:Rufen] [s:Sie] [o:mich] an!","tr":"Beni arayın!"}]}],"rules":["du ve ihr emirde zamir kullanılmaz; Sie emirde zamir kalır.","Ayrılabilen fiillerde ön ek sona gider: Steh auf!","sein düzensizdir: Sei ruhig! Seid ruhig! Seien Sie ruhig!"],"exceptions":["Kökü -t/-d ile bitenler du emrinde -e alır: Warte! Arbeite!"],"mistakes":[{"wrong":"Du komm her!","right":"Komm her!","note":"du emrinde zamir kullanılmaz."},{"wrong":"Nehm das!","right":"Nimm das!","note":"e→i değişimi emirde korunur."},{"wrong":"Fährst du langsam!","right":"Fahr langsam!","note":"Emirde -st eki ve a→ä değişimi olmaz."}]}}
]
