[
  {"id":"de-gr-der-dativ","languageId":"de","category":"grammar","level":"A2","sourceText":"Der Dativ","translations":{"tr":["Yönelme/Bulunma Hâli (Dativ)"]},"grammar":{"summary":"Dativ dolaylı nesne hâlidir (kime?); artikeller dem, der, dem, den(+n) olur.","uses":["Dolaylı nesne: geben, schenken, zeigen, erklären","Dativ fiilleri: helfen, danken, gefallen, gehören, schmecken","Dativ edatlarından sonra (mit, bei, zu…)"],"sections":[{"kind":"other","title":"Dativ artikelleri","formula":[{"tr":"dem / einem (der, das)","en":"maskulin / neutral","role":"x"},{"tr":"der / einer (die)","en":"feminin","role":"x"},{"tr":"den + İsim-n (çoğul)","en":"Plural","role":"x"}],"examples":[{"text":"Ich helfe [x:dem] Mann und [x:der] Frau.","tr":"Adama ve kadına yardım ediyorum."},{"text":"Er spielt mit [x:den] Kindern.","tr":"Çocuklarla oynuyor."}]},{"kind":"other","title":"Dolaylı + doğrudan nesne","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"Kime? (Dativ)","en":"Dativobjekt","role":"o"},{"tr":"Neyi? (Akkusativ)","en":"Akkusativobjekt","role":"o"}],"examples":[{"text":"[s:Ich] [v:schenke] [o:meiner Mutter] [o:Blumen].","tr":"Anneme çiçek hediye ediyorum."},{"text":"[s:Er] [v:zeigt] [o:dem Gast] [o:das Zimmer].","tr":"Misafire odayı gösteriyor."}],"notes":["İki isim nesnede sıra: önce Dativ, sonra Akkusativ."]},{"kind":"other","title":"Dativ fiilleri","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"helfen / gefallen / gehören","en":"Dativverb","role":"v"},{"tr":"Dativ","en":"Dativobjekt","role":"o"}],"examples":[{"text":"[s:Das Kleid] [v:gefällt] [o:mir].","tr":"Elbiseyi beğeniyorum."},{"text":"[s:Wem] [v:gehört] [o:die Tasche]?","tr":"Çanta kimin?"}]}],"rules":["Soru kelimesi: wem (kime).","Dativ çoğulda isim -n alır: den Freunden (-s çoğullu isimler hariç: den Autos).","gefallen'da Türkçenin tersine beğenilen şey öznedir, beğenen kişi Dativ'dir."],"exceptions":["n-Deklination isimleri Dativ'de de -(e)n alır: dem Kollegen, dem Herrn."],"mistakes":[{"wrong":"Ich helfe dich.","right":"Ich helfe dir.","note":"helfen Dativ ister."},{"wrong":"Ich gefalle das Buch.","right":"Das Buch gefällt mir.","note":"Beğenilen şey özne, beğenen Dativ olur."},{"wrong":"mit den Kinder","right":"mit den Kindern","note":"Dativ çoğulda isme -n eklenir."}]}},
  {"id":"de-gr-personalpronomen-im-akkusativ-und-dativ","languageId":"de","category":"grammar","level":"A2","sourceText":"Personalpronomen im Akkusativ und Dativ","translations":{"tr":["Akkusativ ve Dativ Şahıs Zamirleri"]},"grammar":{"summary":"Şahıs zamirleri nesne olduğunda değişir: Akkusativ mich, dich, ihn, sie, es…; Dativ mir, dir, ihm, ihr, ihm…","uses":["Nesne olarak kişi ya da şeyi tekrar etmeden anmak","Dativ fiilleri ve edatlarla (mit mir, hilf mir)"],"sections":[{"kind":"other","title":"Akkusativ zamirleri","formula":[{"tr":"mich / dich / ihn / sie / es","en":"Akkusativ Singular","role":"o"},{"tr":"uns / euch / sie / Sie","en":"Akkusativ Plural","role":"o"}],"examples":[{"text":"Ich liebe [o:dich].","tr":"Seni seviyorum."},{"text":"Kennst du [o:ihn]?","tr":"Onu tanıyor musun?"}]},{"kind":"other","title":"Dativ zamirleri","formula":[{"tr":"mir / dir / ihm / ihr / ihm","en":"Dativ Singular","role":"o"},{"tr":"uns / euch / ihnen / Ihnen","en":"Dativ Plural","role":"o"}],"examples":[{"text":"Kannst du [o:mir] helfen?","tr":"Bana yardım edebilir misin?"},{"text":"Wie geht es [o:Ihnen]?","tr":"Nasılsınız?"}]},{"kind":"other","title":"İki zamir birlikte","formula":[{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"Akkusativ zamir","en":"Akkusativpronomen","role":"o"},{"tr":"Dativ zamir","en":"Dativpronomen","role":"o"}],"examples":[{"text":"Ich [v:gebe] [o:es] [o:dir].","tr":"Onu sana veriyorum."}],"notes":["İki zamirde sıra: Akkusativ önce, Dativ sonra."]}],"rules":["Zamir nesneler isim nesnelerden önce gelir: Ich gebe dir das Buch.","er'in Akkusativ'i ihn, Dativ'i ihm'dir; karıştırma.","ihr (onun-kadın) Dativ'de, ihnen (onlara) çoğulda kullanılır."],"exceptions":[],"mistakes":[{"wrong":"Ich sehe er.","right":"Ich sehe ihn.","note":"Nesne olduğunda er → ihn."},{"wrong":"Er hilft mich.","right":"Er hilft mir.","note":"helfen Dativ ister."},{"wrong":"Ich gebe dir es.","right":"Ich gebe es dir.","note":"İki zamirde önce Akkusativ gelir."}]}},
  {"id":"de-gr-prapositionen-mit-akkusativ","languageId":"de","category":"grammar","level":"A2","sourceText":"Präpositionen mit Akkusativ","translations":{"tr":["Akkusativ Alan Edatlar"]},"grammar":{"summary":"durch, für, gegen, ohne, um (ve bis, entlang) her zaman Akkusativ ister.","uses":["Amaç ve alıcı (für)","Yokluk (ohne), karşıtlık (gegen)","Yer ve saat (durch, um)"],"sections":[{"kind":"other","title":"Edat + Akkusativ","formula":[{"tr":"durch / für / gegen / ohne / um","en":"Präposition","role":"x"},{"tr":"Akkusativ","en":"Akkusativ","role":"o"}],"examples":[{"text":"Das Geschenk ist [x:für] [o:meinen Vater].","tr":"Hediye babam için."},{"text":"Ich trinke Kaffee [x:ohne] [o:Zucker].","tr":"Kahveyi şekersiz içerim."}]},{"kind":"other","title":"Yer ve zaman","formula":[{"tr":"durch / um","en":"Präposition","role":"x"},{"tr":"Akkusativ / saat","en":"Akkusativ","role":"o"}],"examples":[{"text":"Wir gehen [x:durch] [o:den Park].","tr":"Parkın içinden yürüyoruz."},{"text":"Der Kurs beginnt [x:um] [o:9 Uhr].","tr":"Kurs saat 9'da başlıyor."}]}],"rules":["Ezber kısaltması: DOGFU (durch, ohne, gegen, für, um).","Eril artikel değişir: für den / einen / meinen.","Kaynaşma: durch das → durchs, für das → fürs, um das → ums (konuşmada)."],"exceptions":[],"mistakes":[{"wrong":"für mir","right":"für mich","note":"für Akkusativ ister."},{"wrong":"gegen dem Wind","right":"gegen den Wind","note":"gegen Akkusativ ister."}]}},
  {"id":"de-gr-prapositionen-mit-dativ","languageId":"de","category":"grammar","level":"A2","sourceText":"Präpositionen mit Dativ","translations":{"tr":["Dativ Alan Edatlar"]},"grammar":{"summary":"aus, bei, mit, nach, seit, von, zu, gegenüber her zaman Dativ ister.","uses":["Köken (aus, von)","Araç ve beraberlik (mit)","Yön (nach, zu), yer (bei), zaman (seit)"],"sections":[{"kind":"other","title":"Edat + Dativ","formula":[{"tr":"aus / bei / mit / nach / seit / von / zu","en":"Präposition","role":"x"},{"tr":"Dativ","en":"Dativ","role":"o"}],"examples":[{"text":"Ich fahre [x:mit] [o:dem Fahrrad].","tr":"Bisikletle gidiyorum."},{"text":"Sie wohnt [x:bei] [o:ihren Eltern].","tr":"Ailesinin yanında oturuyor."}]},{"kind":"other","title":"nach mı zu mu?","formula":[{"tr":"nach + şehir/ülke","en":"nach + Ort","role":"x"},{"tr":"zu + kişi/kurum","en":"zu + Person/Ort","role":"x"}],"examples":[{"text":"Ich fliege [x:nach] Berlin.","tr":"Berlin'e uçuyorum."},{"text":"Ich gehe [x:zum] Arzt.","tr":"Doktora gidiyorum."}],"notes":["nach Hause = eve (yön), zu Hause = evde (yer)."]},{"kind":"other","title":"seit + Dativ","formula":[{"tr":"Özne + Präsens","en":"Präsens","role":"v"},{"tr":"seit + Dativ","en":"seit + Dativ","role":"o"}],"examples":[{"text":"Ich [v:lerne] Deutsch [o:seit einem Jahr].","tr":"Bir yıldır Almanca öğreniyorum."}],"notes":["seit ile hâlâ süren durumlar Präsens ile anlatılır."]}],"rules":["Kaynaşmalar: zu dem → zum, zu der → zur, bei dem → beim, von dem → vom.","aus = içinden/kökeninden (aus der Türkei), von = -den (von der Arbeit).","Edat Dativ istiyorsa fiil ne olursa olsun Dativ kullanılır."],"exceptions":["Artikelli ülkelerde nach yerine in + Akkusativ kullanılır: in die Türkei, in die Schweiz."],"mistakes":[{"wrong":"mit den Bus","right":"mit dem Bus","note":"mit Dativ ister."},{"wrong":"Ich gehe nach Arzt.","right":"Ich gehe zum Arzt.","note":"Kişi ve kurumlara zu ile gidilir."},{"wrong":"Ich lerne seit zwei Jahren Deutsch gelernt.","right":"Ich lerne seit zwei Jahren Deutsch.","note":"seit ile süren durumlar Präsens ile anlatılır."}]}},
  {"id":"de-gr-wechselprapositionen","languageId":"de","category":"grammar","level":"A2","sourceText":"Wechselpräpositionen","translations":{"tr":["İki Hâlli Edatlar"]},"grammar":{"summary":"an, auf, hinter, in, neben, über, unter, vor, zwischen yön/hareket bildirirse (wohin?) Akkusativ, konum bildirirse (wo?) Dativ alır.","uses":["Bir şeyin nerede olduğunu söylemek (Dativ)","Bir şeyin nereye konduğunu/gittiğini söylemek (Akkusativ)"],"sections":[{"kind":"other","title":"Wo? → Dativ (konum)","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"sein / liegen / stehen / hängen","en":"Positionsverb","role":"v"},{"tr":"Edat + Dativ","en":"Präposition + Dativ","role":"o"}],"examples":[{"text":"[s:Das Buch] [v:liegt] [o:auf dem Tisch].","tr":"Kitap masanın üstünde duruyor."},{"text":"[s:Wir] [v:sind] [o:im Kino].","tr":"Sinemadayız."}]},{"kind":"other","title":"Wohin? → Akkusativ (yön)","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"legen / stellen / hängen / gehen","en":"Richtungsverb","role":"v"},{"tr":"Edat + Akkusativ","en":"Präposition + Akkusativ","role":"o"}],"examples":[{"text":"[s:Ich] [v:lege] [o:das Buch] [o:auf den Tisch].","tr":"Kitabı masanın üstüne koyuyorum."},{"text":"[s:Wir] [v:gehen] [o:ins Kino].","tr":"Sinemaya gidiyoruz."}]},{"kind":"other","title":"Fiil çiftleri","formula":[{"tr":"liegen ↔ legen","en":"Wo? ↔ Wohin?","role":"v"},{"tr":"stehen ↔ stellen","en":"Wo? ↔ Wohin?","role":"v"},{"tr":"hängen ↔ hängen","en":"Wo? ↔ Wohin?","role":"v"}],"examples":[{"text":"Die Flasche [v:steht] im Kühlschrank. Ich [v:stelle] sie in den Kühlschrank.","tr":"Şişe buzdolabında duruyor. Onu buzdolabına koyuyorum."}]}],"rules":["Türkçede -de ↔ Dativ, -e ↔ Akkusativ diye düşünmek işe yarar.","Kaynaşma: in dem → im, in das → ins, an dem → am, an das → ans.","Hareket bir yerin içinde oluyorsa (yer değiştirmiyorsa) Dativ kullanılır: Ich laufe im Park."],"exceptions":[],"mistakes":[{"wrong":"Ich gehe in der Schule.","right":"Ich gehe in die Schule.","note":"Yön (wohin?) Akkusativ ister."},{"wrong":"Das Bild hängt an die Wand.","right":"Das Bild hängt an der Wand.","note":"Konum (wo?) Dativ ister."},{"wrong":"Ich stehe die Vase auf den Tisch.","right":"Ich stelle die Vase auf den Tisch.","note":"Koymak = stellen; stehen durmak demektir."}]}},
  {"id":"de-gr-das-perfekt","languageId":"de","category":"grammar","level":"A2","sourceText":"Das Perfekt","translations":{"tr":["Geçmiş Zaman (Perfekt)"]},"grammar":{"summary":"Perfekt, konuşma dilinde geçmişi anlatmanın ana yoludur: haben/sein + Partizip II (cümle sonunda).","uses":["Konuşmada tamamlanmış geçmiş olaylar","Mektup, mesaj ve günlük anlatım","Sonucu şimdiyi ilgilendiren olaylar"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"haben / sein","en":"Hilfsverb","role":"a"},{"tr":"Nesne / Tümleç","en":"Mittelfeld","role":"o"},{"tr":"Partizip II (sonda)","en":"Partizip II","role":"v"}],"examples":[{"text":"[s:Ich] [a:habe] [o:gestern Pizza] [v:gegessen].","tr":"Dün pizza yedim."},{"text":"[s:Wir] [a:sind] [o:nach Wien] [v:gefahren].","tr":"Viyana'ya gittik."}],"notes":["Düzenli: ge- + kök + -t (gemacht, gekauft); düzensiz: ge- + kök + -en (gegessen, geschrieben)."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"haben / sein","en":"Hilfsverb","role":"a"},{"tr":"nicht / kein","en":"Negation","role":"x"},{"tr":"Partizip II","en":"Partizip II","role":"v"}],"examples":[{"text":"[s:Er] [a:hat] [x:nicht] [v:angerufen].","tr":"Aramadı."},{"text":"[s:Ich] [a:habe] [x:keine] Zeit [v:gehabt].","tr":"Vaktim olmadı."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"haben / sein","en":"Hilfsverb","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Nesne","en":"Mittelfeld","role":"o"},{"tr":"Partizip II?","en":"Partizip II","role":"v"}],"examples":[{"text":"[a:Hast] [s:du] [o:die Hausaufgaben] [v:gemacht]?","tr":"Ödevleri yaptın mı?"},{"text":"[a:Seid] [s:ihr] [o:gut] [v:angekommen]?","tr":"İyi vardınız mı?"}]},{"kind":"wh","title":"W-soruları","formula":[{"tr":"W-kelimesi","en":"W-Wort","role":"q"},{"tr":"haben / sein","en":"Hilfsverb","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Partizip II?","en":"Partizip II","role":"v"}],"examples":[{"text":"[q:Was] [a:hast] [s:du] am Wochenende [v:gemacht]?","tr":"Hafta sonu ne yaptın?"},{"text":"[q:Wann] [a:bist] [s:du] [v:aufgestanden]?","tr":"Ne zaman kalktın?"}]}],"rules":["Yer değiştirme (gehen, fahren, kommen) ve durum değişimi (aufwachen, sterben, werden) bildiren fiiller sein alır; ayrıca sein ve bleiben.","Diğer fiillerin çoğu haben alır.","Ayrılabilen fiillerde -ge- araya girer (eingekauft); be-/ver-/er- ile başlayan ve -ieren ile biten fiiller ge- almaz (besucht, verstanden, studiert)."],"exceptions":["sein ve haben ile modal fiiller konuşmada da genelde Präteritum'da kullanılır: Ich war krank. Ich hatte Zeit."],"mistakes":[{"wrong":"Ich habe nach Berlin gefahren.","right":"Ich bin nach Berlin gefahren.","note":"Yer değiştirme bildiren fiiller sein alır."},{"wrong":"Ich habe gegessen eine Pizza.","right":"Ich habe eine Pizza gegessen.","note":"Partizip II cümlenin sonuna gider."},{"wrong":"Er hat gestudiert.","right":"Er hat studiert.","note":"-ieren fiilleri ge- almaz."}]}},
  {"id":"de-gr-prateritum-sein-haben-und-modalverben","languageId":"de","category":"grammar","level":"A2","sourceText":"Präteritum: sein, haben und Modalverben","translations":{"tr":["Geçmiş Zaman: sein, haben ve Kip Fiilleri"]},"grammar":{"summary":"sein, haben ve modal fiiller konuşmada da geçmişte genelde Präteritum ile kullanılır: war, hatte, konnte, musste…","uses":["Geçmişteki durum ve sahiplik (war, hatte)","Geçmişteki zorunluluk, yetenek, istek (musste, konnte, wollte)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"war / hatte / konnte…","en":"Präteritum","role":"a"},{"tr":"Tümleç","en":"Ergänzung","role":"o"}],"examples":[{"text":"[s:Ich] [a:war] [o:gestern krank].","tr":"Dün hastaydım."},{"text":"[s:Wir] [a:mussten] [o:lange] warten.","tr":"Uzun süre beklemek zorunda kaldık."}],"notes":["sein: war, warst, war, waren, wart, waren · haben: hatte, hattest, hatte, hatten, hattet, hatten."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Präteritum","en":"Präteritum","role":"a"},{"tr":"nicht / kein","en":"Negation","role":"x"},{"tr":"Tümleç","en":"Ergänzung","role":"o"}],"examples":[{"text":"[s:Er] [a:hatte] [x:keine] [o:Zeit].","tr":"Vakti yoktu."},{"text":"[s:Ich] [a:konnte] [x:nicht] [o:kommen].","tr":"Gelemedim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Präteritum","en":"Präteritum","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Tümleç?","en":"Ergänzung","role":"o"}],"examples":[{"text":"[a:Warst] [s:du] [o:schon in Wien]?","tr":"Hiç Viyana'da bulundun mu?"}]},{"kind":"wh","title":"W-soruları","formula":[{"tr":"W-kelimesi","en":"W-Wort","role":"q"},{"tr":"Präteritum","en":"Präteritum","role":"a"},{"tr":"Özne?","en":"Subjekt","role":"s"}],"examples":[{"text":"[q:Wo] [a:wart] [s:ihr] im Urlaub?","tr":"Tatilde neredeydiniz?"}]}],"rules":["Modal fiillerin Präteritum'unda Umlaut düşer: können → konnte, müssen → musste, dürfen → durfte.","ich ve er/sie/es biçimleri aynıdır ve ek almaz: ich war, er war.","möchten'in geçmişi wollte'dir."],"exceptions":[],"mistakes":[{"wrong":"Als Kind ich konnte gut schwimmen.","right":"Als Kind konnte ich gut schwimmen.","note":"Çekimli fiil ikinci sırada kalır."},{"wrong":"Ich konnte nicht kommen gestern.","right":"Ich konnte gestern nicht kommen.","note":"Mastar cümlenin sonuna gider."},{"wrong":"Ich möchtete…","right":"Ich wollte…","note":"möchten'in geçmişi wollte'dir."}]}},
  {"id":"de-gr-reflexive-verben","languageId":"de","category":"grammar","level":"A2","sourceText":"Reflexive Verben","translations":{"tr":["Dönüşlü Fiiller"]},"grammar":{"summary":"Dönüşlü fiiller özneyi tekrar eden bir zamirle (mich, dich, sich…) kullanılır: sich freuen, sich waschen, sich interessieren.","uses":["Öznenin kendine yaptığı eylem (sich waschen)","Kalıplaşmış dönüşlü fiiller (sich freuen, sich beeilen, sich erinnern)"],"sections":[{"kind":"other","title":"Akkusativ dönüşlü zamir","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"mich / dich / sich / uns / euch / sich","en":"Reflexivpronomen (Akk.)","role":"o"}],"examples":[{"text":"[s:Ich] [v:freue] [o:mich] auf den Urlaub.","tr":"Tatili dört gözle bekliyorum."},{"text":"[s:Er] [v:interessiert] [o:sich] für Musik.","tr":"Müzikle ilgileniyor."}]},{"kind":"other","title":"Dativ dönüşlü zamir","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"mir / dir / sich…","en":"Reflexivpronomen (Dat.)","role":"o"},{"tr":"Akkusativ nesne","en":"Akkusativobjekt","role":"o"}],"examples":[{"text":"[s:Ich] [v:wasche] [o:mir] [o:die Hände].","tr":"Ellerimi yıkıyorum."},{"text":"[s:Du] [v:putzt] [o:dir] [o:die Zähne].","tr":"Dişlerini fırçalıyorsun."}],"notes":["Ayrı bir Akkusativ nesne varsa dönüşlü zamir Dativ olur."]},{"kind":"other","title":"Devrik cümle ve Perfekt","formula":[{"tr":"Zaman ifadesi","en":"Position 1","role":"x"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Dönüşlü zamir","en":"Reflexivpronomen","role":"o"}],"examples":[{"text":"[x:Morgen] [v:treffe] [s:ich] [o:mich] mit Ali.","tr":"Yarın Ali ile buluşuyorum."},{"text":"Ich [v:habe] [o:mich] [v:beeilt].","tr":"Acele ettim."}]}],"rules":["Dönüşlü fiiller Perfekt'te haben alır.","Üçüncü şahıs ve Sie için zamir her zaman sich'tir (küçük harf).","sich freuen auf (gelecek), sich freuen über (olmuş şey) farklıdır."],"exceptions":[],"mistakes":[{"wrong":"Ich freue auf das Wochenende.","right":"Ich freue mich auf das Wochenende.","note":"sich freuen dönüşlü zamirsiz kullanılmaz."},{"wrong":"Ich wasche mich die Hände.","right":"Ich wasche mir die Hände.","note":"Ayrı nesne varsa zamir Dativ olur."},{"wrong":"Ich bin mich beeilt.","right":"Ich habe mich beeilt.","note":"Dönüşlü fiiller haben ile Perfekt kurar."}]}},
  {"id":"de-gr-komparativ-und-superlativ","languageId":"de","category":"grammar","level":"A2","sourceText":"Komparativ und Superlativ","translations":{"tr":["Karşılaştırma ve Üstünlük"]},"grammar":{"summary":"Karşılaştırma sıfata -er (+als), üstünlük am …-sten ile yapılır; eşitlik so … wie ile kurulur.","uses":["İki şeyi karşılaştırmak (größer als)","En üst dereceyi söylemek (am größten)","Eşitlik (so groß wie)"],"sections":[{"kind":"other","title":"Komparativ: -er + als","formula":[{"tr":"A","en":"Subjekt","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"Sıfat + -er","en":"Komparativ","role":"o"},{"tr":"als + B","en":"als","role":"x"}],"examples":[{"text":"[s:Berlin] [v:ist] [o:größer] [x:als München].","tr":"Berlin Münih'ten büyük."},{"text":"[s:Ich] [v:laufe] [o:schneller] [x:als du].","tr":"Senden hızlı koşarım."}]},{"kind":"other","title":"Superlativ: am …-sten","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"am + Sıfat + -(e)sten","en":"Superlativ","role":"o"}],"examples":[{"text":"[s:Der Zug] [v:ist] [o:am schnellsten].","tr":"En hızlısı tren."},{"text":"[s:Sie] [v:ist] [o:die beste] Schülerin.","tr":"O en iyi öğrenci."}],"notes":["İsimden önce artikel + -ste kullanılır: der höchste Berg."]},{"kind":"other","title":"Eşitlik: so … wie","formula":[{"tr":"A","en":"Subjekt","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"(nicht) so + Sıfat","en":"so + Adjektiv","role":"o"},{"tr":"wie + B","en":"wie","role":"x"}],"examples":[{"text":"[s:Er] [v:ist] [o:so alt] [x:wie ich].","tr":"O benim kadar yaşlı (yaşıtım)."}]}],"rules":["Tek heceli birçok sıfat Umlaut alır: alt → älter → am ältesten, groß → größer, jung → jünger.","-t, -d, -s, -z ile bitenler -esten alır: am kältesten.","Karşılaştırmada als, eşitlikte wie kullanılır."],"exceptions":["Düzensizler: gut – besser – am besten; viel – mehr – am meisten; gern – lieber – am liebsten; hoch – höher – am höchsten."],"mistakes":[{"wrong":"Er ist größer wie ich.","right":"Er ist größer als ich.","note":"Komparativ'den sonra als gelir."},{"wrong":"mehr schön","right":"schöner","note":"Almancada more gibi yardımcı kelime yoktur; -er eklenir."},{"wrong":"am gutesten","right":"am besten","note":"gut düzensizdir."}]}},
  {"id":"de-gr-konjunktionen-und-aber-oder-denn-sondern","languageId":"de","category":"grammar","level":"A2","sourceText":"Konjunktionen: und, aber, oder, denn, sondern","translations":{"tr":["Bağlaçlar: und, aber, oder, denn, sondern"]},"grammar":{"summary":"und, aber, oder, denn, sondern iki ana cümleyi bağlar ve kelime sırasını değiştirmez (0. pozisyon).","uses":["Ekleme (und), karşıtlık (aber), seçenek (oder)","Neden (denn)","Olumsuzdan sonra düzeltme (sondern)"],"sections":[{"kind":"other","title":"Bağlaç + ana cümle","formula":[{"tr":"Ana cümle 1","en":"Hauptsatz","role":"o"},{"tr":"und / aber / oder / denn","en":"Konjunktion (Position 0)","role":"x"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"}],"examples":[{"text":"[o:Ich bleibe zu Hause], [x:denn] [s:ich] [v:bin] krank.","tr":"Evde kalıyorum, çünkü hastayım."},{"text":"[o:Er ist müde], [x:aber] [s:er] [v:arbeitet] weiter.","tr":"Yorgun ama çalışmaya devam ediyor."}]},{"kind":"other","title":"nicht …, sondern …","formula":[{"tr":"Olumsuz kısım (nicht/kein)","en":"Negation","role":"o"},{"tr":"sondern","en":"sondern","role":"x"},{"tr":"Doğru bilgi","en":"Korrektur","role":"o"}],"examples":[{"text":"[o:Das ist kein Tee], [x:sondern] [o:Kaffee].","tr":"Bu çay değil, kahve."}]}],"rules":["Bu bağlaçlardan sonra fiil yine ikinci öğedir: …, denn ich habe Zeit.","aber ve sondern'den önce virgül konur; und ve oder'dan önce genellikle konmaz.","denn ile weil aynı anlamdadır, ama weil fiili sona gönderir."],"exceptions":[],"mistakes":[{"wrong":"…, denn ich krank bin.","right":"…, denn ich bin krank.","note":"denn'den sonra ana cümle sırası korunur."},{"wrong":"Nicht heute, aber morgen.","right":"Nicht heute, sondern morgen.","note":"Olumsuzu düzeltirken sondern kullanılır."}]}},
  {"id":"de-gr-nebensatze-mit-weil-dass-und-wenn","languageId":"de","category":"grammar","level":"A2","sourceText":"Nebensätze mit weil, dass und wenn","translations":{"tr":["weil, dass, wenn ile Yan Cümleler"]},"grammar":{"summary":"weil (çünkü), dass (-dığını), wenn (-ırsa / -dığında) yan cümle kurar ve çekimli fiili cümlenin en sonuna gönderir.","uses":["Neden bildirmek (weil)","Düşünce, bilgi, fikir aktarmak (dass)","Koşul ve tekrar eden zaman (wenn)"],"sections":[{"kind":"other","title":"Ana cümle + yan cümle","formula":[{"tr":"Ana cümle","en":"Hauptsatz","role":"o"},{"tr":"weil / dass / wenn","en":"Subjunktion","role":"x"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"… Çekimli fiil (sonda)","en":"Verb (Endposition)","role":"v"}],"examples":[{"text":"[o:Ich komme nicht], [x:weil] [s:ich] keine Zeit [v:habe].","tr":"Gelmiyorum çünkü vaktim yok."},{"text":"[o:Ich glaube], [x:dass] [s:er] morgen [v:kommt].","tr":"Yarın geleceğini düşünüyorum."}]},{"kind":"other","title":"Yan cümle başta","formula":[{"tr":"Yan cümle (1)","en":"Nebensatz (Position 1)","role":"o"},{"tr":"Çekimli fiil (2)","en":"Verb","role":"v"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"…","en":"Rest","role":"x"}],"examples":[{"text":"[o:Wenn es regnet], [v:bleiben] [s:wir] zu Hause.","tr":"Yağmur yağarsa evde kalırız."}],"notes":["Yan cümle tek öğe sayılır; ardından hemen ana cümlenin fiili gelir: fiil, fiil."]},{"kind":"other","title":"Modal / Perfekt ile","formula":[{"tr":"weil / dass / wenn","en":"Subjunktion","role":"x"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Mastar / Partizip","en":"Infinitiv / Partizip II","role":"v"},{"tr":"Çekimli fiil (en sonda)","en":"finites Verb","role":"a"}],"examples":[{"text":"…, weil [s:ich] arbeiten [a:muss].","tr":"…, çünkü çalışmam gerekiyor."},{"text":"…, dass [s:sie] angerufen [a:hat].","tr":"…, aradığını."}]}],"rules":["Yan cümle her zaman virgülle ayrılır.","Ayrılabilen fiiller yan cümlede birleşir: …, weil ich früh aufstehe.","Konuşmada dass bazen düşer ve ana cümle sırası gelir: Ich glaube, er kommt."],"exceptions":["Geçmişte tek seferlik olay için wenn değil als kullanılır (B1 konusu)."],"mistakes":[{"wrong":"…, weil ich habe keine Zeit.","right":"…, weil ich keine Zeit habe.","note":"weil fiili sona gönderir."},{"wrong":"Wenn es regnet, wir bleiben zu Hause.","right":"Wenn es regnet, bleiben wir zu Hause.","note":"Yan cümleden sonra hemen ana cümlenin fiili gelir."},{"wrong":"Ich denke das er kommt.","right":"Ich denke, dass er kommt.","note":"Bağlaç dass (çift s) ve önünde virgül."}]}},
  {"id":"de-gr-adjektivdeklination-einfuhrung","languageId":"de","category":"grammar","level":"A2","sourceText":"Adjektivdeklination: Einführung","translations":{"tr":["Sıfat Çekimi: Giriş"]},"grammar":{"summary":"İsimden önce gelen sıfat artikele, cinsiyete ve hâle göre ek alır; yüklem olarak kullanılan sıfat ek almaz.","uses":["İsmi niteleyen sıfat (ein großes Haus)","Yüklem sıfat ek almaz (Das Haus ist groß)"],"sections":[{"kind":"other","title":"Belirli artikelden sonra","formula":[{"tr":"der / die / das","en":"bestimmter Artikel","role":"x"},{"tr":"Sıfat + -e / -en","en":"Adjektiv + Endung","role":"o"},{"tr":"İsim","en":"Nomen","role":"s"}],"examples":[{"text":"[x:der] [o:neue] [s:Lehrer], [x:die] [o:kleine] [s:Katze]","tr":"yeni öğretmen, küçük kedi"},{"text":"Ich kaufe [x:den] [o:roten] [s:Pullover].","tr":"Kırmızı kazağı alıyorum."}],"notes":["Nominativ tekilde ve dişil/nötr Akkusativ'de -e, diğer her yerde -en."]},{"kind":"other","title":"Belirsiz artikelden sonra","formula":[{"tr":"ein / eine / ein","en":"unbestimmter Artikel","role":"x"},{"tr":"Sıfat + -er / -e / -es","en":"Adjektiv + Endung","role":"o"},{"tr":"İsim","en":"Nomen","role":"s"}],"examples":[{"text":"[x:ein] [o:großer] [s:Tisch], [x:eine] [o:große] [s:Lampe], [x:ein] [o:großes] [s:Bett]","tr":"büyük bir masa, büyük bir lamba, büyük bir yatak"},{"text":"Ich habe [x:einen] [o:neuen] [s:Job].","tr":"Yeni bir işim var."}],"notes":["ein cinsiyeti göstermediği için sıfat gösterir: -er (eril), -es (nötr)."]},{"kind":"other","title":"Yüklem sıfat","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"sein","en":"sein","role":"a"},{"tr":"Sıfat (eksiz)","en":"prädikatives Adjektiv","role":"o"}],"examples":[{"text":"[s:Der Kaffee] [a:ist] [o:heiß].","tr":"Kahve sıcak."}]}],"rules":["Dativ'de ve çoğulda (belirli artikelle) sıfat her zaman -en alır: mit dem neuen Auto, die neuen Autos.","kein, mein, dein… ein gibi davranır: mein alter Freund.","Sıfat ek almadan isimden önce kullanılmaz."],"exceptions":["lila, rosa, prima gibi bazı sıfatlar çekilmez."],"mistakes":[{"wrong":"ein groß Haus","right":"ein großes Haus","note":"İsimden önce sıfat ek alır."},{"wrong":"Das Haus ist großes.","right":"Das Haus ist groß.","note":"Yüklem sıfat ek almaz."},{"wrong":"mit dem neue Auto","right":"mit dem neuen Auto","note":"Dativ'de sıfat -en alır."}]}},
  {"id":"de-gr-konjunktiv-ii-hoflichkeit","languageId":"de","category":"grammar","level":"A2","sourceText":"Konjunktiv II: Höflichkeit","translations":{"tr":["Dilek Kipi II: Kibarlık"]},"grammar":{"summary":"hätte gern, könnte, würde ve wäre ile kibar rica, istek ve öneri dile getirilir.","uses":["Kibar sipariş ve istek (Ich hätte gern…)","Kibar rica (Könnten Sie…? Würden Sie…?)","Öneri (Wir könnten…)"],"sections":[{"kind":"other","title":"İstek: hätte gern / möchte","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"hätte gern","en":"Konjunktiv II","role":"a"},{"tr":"Nesne","en":"Akkusativobjekt","role":"o"}],"examples":[{"text":"[s:Ich] [a:hätte gern] [o:einen Kaffee].","tr":"Bir kahve alabilir miyim? (Bir kahve rica ederim.)"}]},{"kind":"question","title":"Kibar rica","formula":[{"tr":"Könnten / Würden","en":"Konjunktiv II","role":"a"},{"tr":"Sie / du","en":"Subjekt","role":"s"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"Mastar?","en":"Infinitiv","role":"v"}],"examples":[{"text":"[a:Könnten] [s:Sie] [o:mir] bitte [v:helfen]?","tr":"Bana yardım edebilir misiniz lütfen?"},{"text":"[a:Würdest] [s:du] [o:das Fenster] [v:schließen]?","tr":"Pencereyi kapatır mısın?"}]},{"kind":"other","title":"Öneri: könnten / sollten","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"könnten / sollten","en":"Konjunktiv II","role":"a"},{"tr":"Mastar","en":"Infinitiv","role":"v"}],"examples":[{"text":"[s:Wir] [a:könnten] heute ins Kino [v:gehen].","tr":"Bugün sinemaya gidebiliriz."},{"text":"[s:Du] [a:solltest] mehr [v:schlafen].","tr":"Daha çok uyumalısın."}]}],"rules":["Biçimler: hätte, wäre, könnte, würde, sollte; ich ve er aynıdır.","Kibarlıkta bitte eklemek yaygındır.","Wäre es möglich, …? çok resmî ve kibar bir ricadır."],"exceptions":[],"mistakes":[{"wrong":"Ich will einen Kaffee. (garsona)","right":"Ich hätte gern einen Kaffee.","note":"will kaba gelebilir; hätte gern ya da möchte kullan."},{"wrong":"Könnten Sie mir helfen bitte?","right":"Könnten Sie mir bitte helfen?","note":"Mastar sonda kalır."}]}}
]
