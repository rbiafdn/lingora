[
  {"id":"de-gr-prapositionen-mit-dem-genitiv","languageId":"de","category":"grammar","level":"B2","sourceText":"Präpositionen mit dem Genitiv","translations":{"tr":["Genitiv alan edatlar"]},"grammar":{"summary":"wegen, trotz, während, statt, innerhalb, außerhalb gibi edatlardan sonra isim Genitiv hâlinde gelir.","uses":["Sebep: wegen","Karşıtlık: trotz","Zaman: während, innerhalb","Yerine geçme: statt / anstatt"],"sections":[{"kind":"other","title":"wegen (… yüzünden)","formula":[{"tr":"wegen","en":"wegen","role":"x"},{"tr":"Genitiv öbeği","en":"Nomen im Genitiv","role":"o"}],"examples":[{"text":"[x:Wegen] [o:des Regens] bleiben wir zu Hause.","tr":"Yağmur yüzünden evde kalıyoruz."}]},{"kind":"other","title":"trotz (… rağmen)","formula":[{"tr":"trotz","en":"trotz","role":"x"},{"tr":"Genitiv öbeği","en":"Nomen im Genitiv","role":"o"}],"examples":[{"text":"[x:Trotz] [o:der Kälte] sind wir spazieren gegangen.","tr":"Soğuğa rağmen yürüyüşe çıktık."}]},{"kind":"other","title":"während (… sırasında)","formula":[{"tr":"während","en":"während","role":"x"},{"tr":"Genitiv öbeği","en":"Nomen im Genitiv","role":"o"}],"examples":[{"text":"[x:Während] [o:des Unterrichts] bleibt das Handy aus.","tr":"Ders sırasında telefon kapalı kalır."}]},{"kind":"other","title":"innerhalb / außerhalb / statt","formula":[{"tr":"innerhalb / außerhalb / statt","en":"Präposition","role":"x"},{"tr":"Genitiv öbeği","en":"Nomen im Genitiv","role":"o"}],"examples":[{"text":"[x:Innerhalb] [o:einer Woche] bekommen Sie eine Antwort.","tr":"Bir hafta içinde cevap alacaksınız."},{"text":"[x:Statt] [o:eines Autos] hat er ein Fahrrad gekauft.","tr":"Araba yerine bisiklet aldı."}]}],"rules":["Konuşmada wegen, trotz ve statt sık sık Dativ’le kullanılır (wegen dem Regen); yazıda Genitiv tercih edilir.","während hem edat (+ Genitiv) hem bağlaç (+ yan cümle) olabilir.","Genitiv görünmüyorsa von + Dativ kullanılır: innerhalb von drei Tagen."],"exceptions":["Artikelsiz tekil isimde ek düşebilir: wegen Krankheit geschlossen."],"mistakes":[{"wrong":"Während dem Film hat er geschlafen.","right":"Während des Films hat er geschlafen.","note":"Yazı dilinde während Genitiv alır."},{"wrong":"innerhalb drei Tage","right":"innerhalb von drei Tagen","note":"Genitiv belli olmuyorsa von + Dativ kullanılır."},{"wrong":"Wegen ich krank war, …","right":"Weil ich krank war, …","note":"wegen edattır, yan cümle bağlamaz; weil kullanılır."}]}},
  {"id":"de-gr-die-n-deklination","languageId":"de","category":"grammar","level":"B2","sourceText":"Die n-Deklination","translations":{"tr":["n-çekimi (zayıf eril isimler)"]},"grammar":{"summary":"Bazı eril isimler Nominativ tekil dışındaki tüm hâllerde -(e)n eki alır: der Student → den/dem/des Studenten.","uses":["-e ile biten canlı eril isimler: der Junge, der Kollege, der Kunde","-ent, -ant, -ist, -at, -oge ile bitenler: der Student, der Polizist","Bazı tek isimler: der Mensch, der Herr, der Nachbar, der Bär"],"sections":[{"kind":"other","title":"Nominativ → diğer hâller","formula":[{"tr":"der + İsim","en":"der + Nomen (Nominativ)","role":"s"},{"tr":"den / dem / des + İsim-(e)n","en":"Nomen + -(e)n","role":"o"}],"examples":[{"text":"[s:Der Kollege] ist nett. Ich helfe [o:dem Kollegen].","tr":"Meslektaşım iyi biri. Ona yardım ediyorum."}]},{"kind":"other","title":"Akkusativ","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"den / einen + İsim-(e)n","en":"Akkusativ + -(e)n","role":"o"}],"examples":[{"text":"Kennst [s:du] [o:den Jungen] dort?","tr":"Oradaki çocuğu tanıyor musun?"},{"text":"[s:Wir] [v:haben] [o:einen Polizisten] gefragt.","tr":"Bir polise sorduk."}]},{"kind":"other","title":"Dativ ve Genitiv","formula":[{"tr":"dem / des + İsim-(e)n","en":"Dativ / Genitiv + -(e)n","role":"o"}],"examples":[{"text":"Ich gebe [o:dem Kunden] die Rechnung.","tr":"Müşteriye faturayı veriyorum."},{"text":"Das ist das Büro [o:des Präsidenten].","tr":"Bu, başkanın ofisi."}]},{"kind":"other","title":"Özel durum: -ns (der Name)","formula":[{"tr":"des + İsim-ns","en":"Genitiv + -ns","role":"o"}],"examples":[{"text":"Was ist die Bedeutung [o:des Namens]?","tr":"Bu ismin anlamı ne?"}],"notes":["der Name, der Gedanke, der Glaube, der Buchstabe: Genitivde -ns."]}],"rules":["Çoğulda tüm hâller -(e)n alır: die Studenten.","Genitivde ayrıca -s eklenmez: des Studenten (✗ des Studentens).","Herr tekilde -n, çoğulda -en alır: Herrn / Herren."],"exceptions":["das Herz nötr ama düzensizdir: des Herzens, dem Herzen."],"mistakes":[{"wrong":"Ich frage den Student.","right":"Ich frage den Studenten.","note":"n-Deklination isimleri Akkusativ’de -en alır."},{"wrong":"Ich spreche mit dem Kollege.","right":"Ich spreche mit dem Kollegen.","note":"Dativ’de de -n eki gerekir."},{"wrong":"das Auto des Nachbars","right":"das Auto des Nachbarn","note":"Genitivde -s değil -n gelir."}]}},
  {"id":"de-gr-das-plusquamperfekt","languageId":"de","category":"grammar","level":"B2","sourceText":"Das Plusquamperfekt","translations":{"tr":["Önceki geçmiş zaman (-mişti)"]},"grammar":{"summary":"Geçmişteki bir olaydan daha önce olmuş olayı anlatır: hatte / war + Partizip II.","uses":["Geçmişteki iki olaydan önce olanı göstermek","nachdem ile kurulan yan cümlelerde","Hikâye ve anlatılarda geriye dönüş"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"hatte / war","en":"Hilfsverb (Präteritum)","role":"a"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"Partizip II","en":"Partizip II","role":"v"}],"examples":[{"text":"[s:Ich] [a:hatte] [o:das Buch] schon [v:gelesen].","tr":"Kitabı çoktan okumuştum."},{"text":"[s:Der Zug] [a:war] schon [v:abgefahren].","tr":"Tren çoktan kalkmıştı."}],"notes":["haben/sein seçimi Perfekt’teki gibidir: hareket/durum değişikliği → war."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"hatte / war","en":"Hilfsverb","role":"a"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"nicht","en":"nicht","role":"x"},{"tr":"Partizip II","en":"Partizip II","role":"v"}],"examples":[{"text":"[s:Wir] [a:hatten] [o:den Film] noch [x:nicht] [v:gesehen].","tr":"Filmi henüz görmemiştik."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"hatte / war","en":"Hilfsverb","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"Partizip II?","en":"Partizip II?","role":"v"}],"examples":[{"text":"[a:Hattest] [s:du] [o:die Tür] [v:abgeschlossen]?","tr":"Kapıyı kilitlemiş miydin?"}]},{"kind":"wh","title":"W-soruları","formula":[{"tr":"Soru kelimesi","en":"Fragewort","role":"q"},{"tr":"hatte / war","en":"Hilfsverb","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Partizip II?","en":"Partizip II?","role":"v"}],"examples":[{"text":"[q:Wohin] [a:war] [s:er] [v:gegangen]?","tr":"Nereye gitmişti?"}]},{"kind":"other","title":"nachdem + Plusquamperfekt","formula":[{"tr":"nachdem","en":"nachdem","role":"x"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Partizip II + hatte/war","en":"Partizip II + Hilfsverb","role":"v"},{"tr":"Ana cümle (Präteritum)","en":"Hauptsatz (Präteritum)","role":"o"}],"examples":[{"text":"[x:Nachdem] [s:wir] [v:gegessen hatten], [o:gingen wir spazieren].","tr":"Yemek yedikten sonra yürüyüşe çıktık."}]}],"rules":["Plusquamperfekt tek başına pek kullanılmaz; diğer olay Präteritum veya Perfekt’tedir.","nachdem’li yan cümle Plusquamperfekt, ana cümle Präteritum olur.","Yan cümlede çekimli hatte/war en sona gider."],"exceptions":[],"mistakes":[{"wrong":"Nachdem ich esse, ging ich.","right":"Nachdem ich gegessen hatte, ging ich.","note":"nachdem ile önce olan olay Plusquamperfekt olur."},{"wrong":"Ich hatte nach Hause gegangen.","right":"Ich war nach Hause gegangen.","note":"Hareket fiilleri war ile kurulur."}]}},
  {"id":"de-gr-das-futur-i","languageId":"de","category":"grammar","level":"B2","sourceText":"Das Futur I","translations":{"tr":["Gelecek zaman ve tahmin (Futur I)"]},"grammar":{"summary":"werden + mastar ile gelecek, niyet, söz ve şimdiki zamana dair tahmin anlatılır.","uses":["Söz, kesin niyet ve tahmin","Şimdiye dair tahmin (wohl ile): Er wird wohl krank sein.","Kararlı emir veya uyarı: Du wirst jetzt schlafen!"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"werden (çekimli)","en":"werden (konjugiert)","role":"a"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"Mastar","en":"Infinitiv","role":"v"}],"examples":[{"text":"[s:Ich] [a:werde] [o:dich] morgen [v:anrufen].","tr":"Seni yarın arayacağım."},{"text":"[s:Es] [a:wird] bald [v:regnen].","tr":"Birazdan yağmur yağacak."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"werden","en":"werden","role":"a"},{"tr":"nicht / kein","en":"nicht / kein","role":"x"},{"tr":"Mastar","en":"Infinitiv","role":"v"}],"examples":[{"text":"[s:Das] [a:wird] [x:nicht] [v:passieren].","tr":"Bu olmayacak."},{"text":"[s:Wir] [a:werden] [x:keine] [o:Zeit] [v:haben].","tr":"Vaktimiz olmayacak."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"werden","en":"werden","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"Mastar?","en":"Infinitiv?","role":"v"}],"examples":[{"text":"[a:Wirst] [s:du] [o:zur Party] [v:kommen]?","tr":"Partiye gelecek misin?"}]},{"kind":"wh","title":"W-soruları","formula":[{"tr":"Soru kelimesi","en":"Fragewort","role":"q"},{"tr":"werden","en":"werden","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Mastar?","en":"Infinitiv?","role":"v"}],"examples":[{"text":"[q:Wann] [a:werdet] [s:ihr] [v:umziehen]?","tr":"Ne zaman taşınacaksınız?"}]},{"kind":"other","title":"Tahmin: wohl / sicher","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"werden","en":"werden","role":"a"},{"tr":"wohl / sicher","en":"wohl / sicher","role":"x"},{"tr":"Mastar","en":"Infinitiv","role":"v"}],"examples":[{"text":"[s:Er] [a:wird] [x:wohl] [o:im Büro] [v:sein].","tr":"Herhâlde ofistedir."}]}],"rules":["Zaman zarfı varsa günlük dilde Präsens daha yaygındır: Morgen fahre ich nach Berlin.","Çekim: werde, wirst, wird, werden, werdet, werden.","Mastar sona gider; yan cümlede werden en sondadır: …, dass er kommen wird."],"exceptions":[],"mistakes":[{"wrong":"Ich werde gehen morgen.","right":"Ich werde morgen gehen.","note":"Mastar cümlenin sonunda olur."},{"wrong":"Du wirdst kommen.","right":"Du wirst kommen.","note":"du ile çekim: wirst."},{"wrong":"…, dass er wird kommen.","right":"…, dass er kommen wird.","note":"Yan cümlede çekimli werden en sona gider."}]}},
  {"id":"de-gr-das-futur-ii","languageId":"de","category":"grammar","level":"B2","sourceText":"Das Futur II","translations":{"tr":["Gelecekte bitmiş zaman (Futur II)"]},"grammar":{"summary":"werden + Partizip II + haben/sein ile gelecekte bir ana kadar bitmiş olacak eylemi veya geçmişe dair tahmini anlatır.","uses":["Gelecekte bir ana kadar tamamlanmış olacak eylemler (bis morgen)","Geçmişe dair tahmin (wohl): Er wird den Zug verpasst haben."],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"werden","en":"werden","role":"a"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"Partizip II","en":"Partizip II","role":"v"},{"tr":"haben / sein","en":"haben / sein","role":"a"}],"examples":[{"text":"[s:Ich] [a:werde] [o:die Arbeit] bis Freitag [v:beendet] [a:haben].","tr":"Cumaya kadar işi bitirmiş olacağım."},{"text":"[s:Er] [a:wird] wohl [v:eingeschlafen] [a:sein].","tr":"Herhâlde uyuyakalmıştır."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"werden","en":"werden","role":"a"},{"tr":"nicht","en":"nicht","role":"x"},{"tr":"Partizip II","en":"Partizip II","role":"v"},{"tr":"haben / sein","en":"haben / sein","role":"a"}],"examples":[{"text":"[s:Sie] [a:wird] [o:den Brief] noch [x:nicht] [v:bekommen] [a:haben].","tr":"Mektubu herhâlde henüz almamıştır."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"werden","en":"werden","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Partizip II","en":"Partizip II","role":"v"},{"tr":"haben / sein?","en":"haben / sein?","role":"a"}],"examples":[{"text":"[a:Wirst] [s:du] [o:das Buch] bis Montag [v:gelesen] [a:haben]?","tr":"Pazartesiye kadar kitabı okumuş olacak mısın?"}]},{"kind":"wh","title":"W-soruları","formula":[{"tr":"Soru kelimesi","en":"Fragewort","role":"q"},{"tr":"werden","en":"werden","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Partizip II","en":"Partizip II","role":"v"},{"tr":"haben / sein?","en":"haben / sein?","role":"a"}],"examples":[{"text":"[q:Was] [a:wird] [s:er] ihr [v:gesagt] [a:haben]?","tr":"Ona ne söylemiş olabilir?"}]}],"rules":["Gelecekte bitmişlik için günlük dilde çoğu zaman Perfekt kullanılır: Bis Freitag habe ich es gemacht.","haben/sein seçimi Perfekt’teki gibidir.","Tahmin anlamında genellikle wohl, sicher, bestimmt eşlik eder."],"exceptions":[],"mistakes":[{"wrong":"Ich werde es gemacht.","right":"Ich werde es gemacht haben.","note":"haben/sein mastarı unutulmamalı."},{"wrong":"Er wird gegangen haben.","right":"Er wird gegangen sein.","note":"Hareket fiilleri sein alır."}]}},
  {"id":"de-gr-das-vorgangspassiv-passiv-mit-werden","languageId":"de","category":"grammar","level":"B2","sourceText":"Das Vorgangspassiv (Passiv mit werden)","translations":{"tr":["Edilgen çatı (werden ile)"]},"grammar":{"summary":"werden + Partizip II ile eylemin kendisi vurgulanır; yapan önemsizse söylenmez, gerekirse von + Dativ ile verilir.","uses":["Yapan kişi önemsiz veya bilinmiyorsa","Süreçler, talimatlar, haberler","Resmî ve yazılı dil"],"sections":[{"kind":"other","title":"Präsens: werden + Partizip II","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"werden","en":"werden","role":"a"},{"tr":"(von + Dativ)","en":"(von + Dativ)","role":"o"},{"tr":"Partizip II","en":"Partizip II","role":"v"}],"examples":[{"text":"[s:Das Haus] [a:wird] [o:von einer Firma] [v:renoviert].","tr":"Ev bir firma tarafından yenileniyor."},{"text":"[s:Die Briefe] [a:werden] täglich [v:verschickt].","tr":"Mektuplar her gün gönderilir."}]},{"kind":"other","title":"Präteritum: wurde + Partizip II","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"wurde","en":"wurde","role":"a"},{"tr":"Partizip II","en":"Partizip II","role":"v"}],"examples":[{"text":"[s:Das Auto] [a:wurde] gestern [v:repariert].","tr":"Araba dün tamir edildi."}]},{"kind":"other","title":"Perfekt: ist + Partizip II + worden","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"sein","en":"sein","role":"a"},{"tr":"Partizip II","en":"Partizip II","role":"v"},{"tr":"worden","en":"worden","role":"a"}],"examples":[{"text":"[s:Der Täter] [a:ist] [v:verhaftet] [a:worden].","tr":"Fail tutuklandı."}],"notes":["Plusquamperfekt: war … worden: Das Haus war verkauft worden."]},{"kind":"other","title":"Aktiv → Passiv","formula":[{"tr":"Akkusativ nesne → Özne","en":"Akkusativobjekt → Subjekt","role":"s"},{"tr":"werden","en":"werden","role":"a"},{"tr":"von + Dativ","en":"von + Dativ","role":"o"},{"tr":"Partizip II","en":"Partizip II","role":"v"}],"examples":[{"text":"Der Arzt untersucht den Patienten. → [s:Der Patient] [a:wird] [o:vom Arzt] [v:untersucht].","tr":"Doktor hastayı muayene ediyor. → Hasta doktor tarafından muayene ediliyor."}]},{"kind":"other","title":"Öznesiz edilgen","formula":[{"tr":"(Es) / Zaman öğesi","en":"(Es) / Vorfeld","role":"x"},{"tr":"wird","en":"wird","role":"a"},{"tr":"Partizip II","en":"Partizip II","role":"v"}],"examples":[{"text":"[x:Sonntags] [a:wird] nicht [v:gearbeitet].","tr":"Pazar günleri çalışılmaz."},{"text":"[x:Es] [a:wird] hier viel [v:gelacht].","tr":"Burada çok gülünür."}]}],"rules":["Aktif cümlenin Akkusativ nesnesi Passiv’de özne (Nominativ) olur.","Perfekt’te geworden değil worden kullanılır.","Dativ nesne Dativ olarak kalır: Mir wurde geholfen.","von kişi/canlı için, durch araç/sebep için: durch ein Feuer zerstört."],"exceptions":["Akkusativ nesnesi olmayan fiillerle (helfen, tanzen) öznesiz edilgen kurulur."],"mistakes":[{"wrong":"Das Haus ist gebaut geworden.","right":"Das Haus ist gebaut worden.","note":"Passiv Perfekt’te worden kullanılır."},{"wrong":"Ich wurde geholfen.","right":"Mir wurde geholfen.","note":"helfen Dativ alır; Passiv’de de Dativ kalır."},{"wrong":"Das Buch wurde von Goethe geschreibt.","right":"Das Buch wurde von Goethe geschrieben.","note":"Düzensiz fiilin Partizip II biçimi kullanılır."}]}},
  {"id":"de-gr-passiv-mit-modalverben","languageId":"de","category":"grammar","level":"B2","sourceText":"Passiv mit Modalverben","translations":{"tr":["Kiplik fiilleriyle edilgen"]},"grammar":{"summary":"Modal fiil + Partizip II + werden ile gereklilik, olanak veya yasak edilgen olarak anlatılır: Das muss repariert werden.","uses":["Yapılması gerekenler (müssen, sollen)","Olanak (können)","Yasak ve izin (dürfen)"],"sections":[{"kind":"other","title":"Präsens","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Kiplik fiili","en":"Modalverb","role":"a"},{"tr":"Partizip II","en":"Partizip II","role":"v"},{"tr":"werden","en":"werden (Infinitiv)","role":"a"}],"examples":[{"text":"[s:Das Fenster] [a:muss] [v:repariert] [a:werden].","tr":"Pencerenin tamir edilmesi gerekiyor."},{"text":"[s:Das Formular] [a:kann] online [v:ausgefüllt] [a:werden].","tr":"Form internetten doldurulabilir."}]},{"kind":"other","title":"Präteritum","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Kiplik fiili (Präteritum)","en":"Modalverb (Präteritum)","role":"a"},{"tr":"Partizip II","en":"Partizip II","role":"v"},{"tr":"werden","en":"werden","role":"a"}],"examples":[{"text":"[s:Der Termin] [a:musste] [v:verschoben] [a:werden].","tr":"Randevunun ertelenmesi gerekti."}]},{"kind":"other","title":"Olumsuz: nicht dürfen / nicht müssen","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Kiplik fiili","en":"Modalverb","role":"a"},{"tr":"nicht","en":"nicht","role":"x"},{"tr":"Partizip II","en":"Partizip II","role":"v"},{"tr":"werden","en":"werden","role":"a"}],"examples":[{"text":"[s:Dieses Medikament] [a:darf] [x:nicht] mit Alkohol [v:eingenommen] [a:werden].","tr":"Bu ilaç alkolle birlikte alınmamalı."}],"notes":["nicht dürfen = yasak; nicht müssen = gerek yok."]},{"kind":"other","title":"Yan cümlede","formula":[{"tr":"weil / dass","en":"weil / dass","role":"x"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Partizip II","en":"Partizip II","role":"v"},{"tr":"werden","en":"werden","role":"a"},{"tr":"Kiplik fiili","en":"Modalverb","role":"a"}],"examples":[{"text":"…, [x:weil] [s:das Problem] schnell [v:gelöst] [a:werden] [a:muss].","tr":"…, çünkü sorunun hızla çözülmesi gerekiyor."}]}],"rules":["Modal fiil çekimlenir; Partizip II ve werden sona gider.","Geçmişte günlük dilde Präteritum tercih edilir (musste … werden).","Yan cümlede çekimli modal fiil en sondadır."],"exceptions":[],"mistakes":[{"wrong":"Das muss werden repariert.","right":"Das muss repariert werden.","note":"Sıra: Partizip II + werden."},{"wrong":"Das Auto muss repariert sein. (süreç kastedilerek)","right":"Das Auto muss repariert werden.","note":"Süreç için werden; sonuç durumu için sein (Zustandspassiv)."}]}},
  {"id":"de-gr-das-zustandspassiv-passiv-mit-sein","languageId":"de","category":"grammar","level":"B2","sourceText":"Das Zustandspassiv (Passiv mit sein)","translations":{"tr":["Durum edilgeni (sein ile)"]},"grammar":{"summary":"sein + Partizip II, bir eylemin sonucunda oluşan durumu anlatır: Die Tür ist geöffnet.","uses":["Bir işin sonucu olan durumu belirtmek","Tabelalar ve duyurular: Heute geschlossen","Vorgangspassiv (süreç) ile karşıtlık"],"sections":[{"kind":"other","title":"Präsens: ist + Partizip II","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"sein","en":"sein","role":"a"},{"tr":"Partizip II","en":"Partizip II","role":"v"}],"examples":[{"text":"[s:Die Tür] [a:ist] [v:geschlossen].","tr":"Kapı kapalı."},{"text":"[s:Der Tisch] [a:ist] schon [v:gedeckt].","tr":"Masa çoktan kurulmuş."}]},{"kind":"other","title":"Präteritum: war + Partizip II","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"war","en":"war","role":"a"},{"tr":"Partizip II","en":"Partizip II","role":"v"}],"examples":[{"text":"[s:Das Geschäft] [a:war] [v:geschlossen].","tr":"Dükkân kapalıydı."}]},{"kind":"other","title":"Süreç ↔ Durum","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"wird (süreç) / ist (durum)","en":"wird / ist","role":"a"},{"tr":"Partizip II","en":"Partizip II","role":"v"}],"examples":[{"text":"[s:Die Bank] [a:wird] um 16 Uhr [v:geschlossen]. Jetzt [a:ist] [s:sie] [v:geschlossen].","tr":"Banka saat 16’da kapatılır. Şu an kapalı."}]},{"kind":"other","title":"Kiplik fiili + Zustandspassiv","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Kiplik fiili","en":"Modalverb","role":"a"},{"tr":"Partizip II","en":"Partizip II","role":"v"},{"tr":"sein","en":"sein","role":"a"}],"examples":[{"text":"[s:Die Arbeit] [a:muss] bis Montag [v:erledigt] [a:sein].","tr":"İş pazartesiye kadar bitmiş olmalı."}]}],"rules":["Sadece sonuç bırakan geçişli fiillerle kurulur (öffnen, schließen, reparieren).","Yapan (von …) genellikle söylenmez.","Zustandspassiv, Vorgangspassiv Perfekt’in sonucudur: Die Tür ist geöffnet worden → Die Tür ist geöffnet."],"exceptions":[],"mistakes":[{"wrong":"Die Tür ist geöffnet worden. (şu an açık anlamında)","right":"Die Tür ist geöffnet.","note":"Durumu anlatmak için worden kullanılmaz."},{"wrong":"Das Museum wird montags geschlossen. (kapalıdır anlamında)","right":"Das Museum ist montags geschlossen.","note":"Kapalı olma durumu sein ile anlatılır."}]}},
  {"id":"de-gr-konjunktiv-ii-der-gegenwart","languageId":"de","category":"grammar","level":"B2","sourceText":"Konjunktiv II der Gegenwart","translations":{"tr":["Dilek-şart kipi (şimdiki zaman)"]},"grammar":{"summary":"Gerçek dışı durumlar, dilekler ve kibar ricalar için würde + mastar veya wäre, hätte, könnte gibi biçimler kullanılır.","uses":["Gerçek dışı koşul: Wenn ich Zeit hätte, …","Dilek: Wenn ich doch … wäre!","Kibar rica ve öneri: Könnten Sie …? Du solltest …"],"sections":[{"kind":"other","title":"würde + Infinitiv","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"würde","en":"würde","role":"a"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"Mastar","en":"Infinitiv","role":"v"}],"examples":[{"text":"[s:Ich] [a:würde] gern [o:mehr] [v:reisen].","tr":"Daha çok seyahat etmek isterdim."}]},{"kind":"other","title":"Kendi biçimi: wäre, hätte, könnte","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Konjunktiv II biçimi","en":"Konjunktiv-II-Form","role":"v"},{"tr":"Nesne","en":"Objekt","role":"o"}],"examples":[{"text":"[s:Ich] [v:hätte] gern [o:einen Kaffee].","tr":"Bir kahve rica ediyorum."},{"text":"[s:Das] [v:wäre] [o:toll]!","tr":"Bu harika olurdu!"}]},{"kind":"other","title":"Gerçek dışı koşul: wenn …","formula":[{"tr":"wenn","en":"wenn","role":"x"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Konj. II fiil (sonda)","en":"Konjunktiv II (am Ende)","role":"v"},{"tr":"Ana cümle (Konj. II)","en":"Hauptsatz (Konjunktiv II)","role":"o"}],"examples":[{"text":"[x:Wenn] [s:ich] reich [v:wäre], [o:würde ich ein Haus kaufen].","tr":"Zengin olsaydım bir ev alırdım."}]},{"kind":"other","title":"Dilek: wenn … doch / nur","formula":[{"tr":"wenn","en":"wenn","role":"x"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"doch / nur","en":"doch / nur","role":"x"},{"tr":"Konj. II fiil","en":"Konjunktiv II","role":"v"}],"examples":[{"text":"[x:Wenn] [s:ich] [x:doch] mehr Zeit [v:hätte]!","tr":"Keşke daha çok vaktim olsa!"}]},{"kind":"other","title":"Kibar rica","formula":[{"tr":"Konj. II kiplik fiili","en":"Modalverb im Konjunktiv II","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"Mastar?","en":"Infinitiv?","role":"v"}],"examples":[{"text":"[a:Könnten] [s:Sie] [o:mir] bitte [v:helfen]?","tr":"Bana yardım edebilir misiniz?"}]}],"rules":["sein, haben ve modal fiillerde kendi biçim kullanılır: wäre, hätte, könnte, müsste, dürfte, sollte.","Bazı güçlü fiillerin biçimleri yazıda yaşar: käme, ginge, wüsste, gäbe.","Diğer fiillerde würde + mastar kullanılır.","wenn düşürülüp fiil başa alınabilir: Hätte ich Zeit, käme ich mit."],"exceptions":[],"mistakes":[{"wrong":"Wenn ich Zeit haben würde, …","right":"Wenn ich Zeit hätte, …","note":"haben için hätte kullanılır."},{"wrong":"Wenn ich reich bin, würde ich …","right":"Wenn ich reich wäre, würde ich …","note":"Gerçek dışı koşulda iki taraf da Konjunktiv II olur."},{"wrong":"Kannst du mir helfen? (resmî ortamda)","right":"Könnten Sie mir bitte helfen?","note":"Kibar ricada Konjunktiv II ve Sie daha uygundur."}]}},
  {"id":"de-gr-konjunktiv-ii-der-vergangenheit","languageId":"de","category":"grammar","level":"B2","sourceText":"Konjunktiv II der Vergangenheit","translations":{"tr":["Geçmişe ait dilek-şart (-saydı … -ırdı)"]},"grammar":{"summary":"hätte / wäre + Partizip II ile geçmişte gerçekleşmemiş durumlar, pişmanlıklar ve sitemler anlatılır.","uses":["Geçmişte gerçekleşmemiş koşul","Pişmanlık, keşke","Sitem ve eleştiri: Du hättest anrufen sollen."],"sections":[{"kind":"other","title":"hätte / wäre + Partizip II","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"hätte / wäre","en":"hätte / wäre","role":"a"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"Partizip II","en":"Partizip II","role":"v"}],"examples":[{"text":"[s:Ich] [a:hätte] [o:dir] gern [v:geholfen].","tr":"Sana seve seve yardım ederdim."},{"text":"[s:Wir] [a:wären] gern [v:gekommen].","tr":"Gelmeyi çok isterdik."}]},{"kind":"other","title":"Gerçek dışı koşul (geçmiş)","formula":[{"tr":"wenn","en":"wenn","role":"x"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Partizip II + hätte/wäre","en":"Partizip II + hätte/wäre","role":"v"},{"tr":"Ana cümle (hätte/wäre + Part. II)","en":"Hauptsatz","role":"o"}],"examples":[{"text":"[x:Wenn] [s:du] früher [v:gekommen wärst], [o:hättest du ihn gesehen].","tr":"Daha erken gelseydin onu görürdün."}]},{"kind":"other","title":"Keşke: Hätte … nur / doch","formula":[{"tr":"hätte / wäre","en":"hätte / wäre","role":"a"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"nur / doch","en":"nur / doch","role":"x"},{"tr":"Partizip II!","en":"Partizip II!","role":"v"}],"examples":[{"text":"[a:Hätte] [s:ich] [x:nur] mehr [v:gelernt]!","tr":"Keşke daha çok çalışsaydım!"}]},{"kind":"other","title":"Kiplik fiiliyle: çift mastar","formula":[{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"hätte","en":"hätte","role":"a"},{"tr":"Nesne","en":"Objekt","role":"o"},{"tr":"Mastar","en":"Infinitiv","role":"v"},{"tr":"Kiplik fiili (mastar)","en":"Modalverb (Infinitiv)","role":"a"}],"examples":[{"text":"[s:Du] [a:hättest] [o:mich] [v:anrufen] [a:sollen].","tr":"Beni araman gerekirdi."},{"text":"[s:Er] [a:hätte] [o:das] [v:wissen] [a:müssen].","tr":"Bunu bilmesi gerekirdi."}]}],"rules":["haben/sein seçimi Perfekt’teki gibidir.","Modal fiillerde Partizip II değil çift mastar kullanılır: hätte machen können.","Yan cümlede çift mastarla hätte öne geçer: …, dass er hätte kommen müssen."],"exceptions":[],"mistakes":[{"wrong":"Wenn ich das gewusst würde, …","right":"Wenn ich das gewusst hätte, …","note":"Geçmişte würde değil hätte/wäre kullanılır."},{"wrong":"Du hättest anrufen gesollt.","right":"Du hättest anrufen sollen.","note":"Modal fiil çift mastar olur."},{"wrong":"Wenn er gekommen hätte, …","right":"Wenn er gekommen wäre, …","note":"kommen sein ile kurulur."}]}},
  {"id":"de-gr-relativsatze-mit-praposition-genitiv-wo-und-was","languageId":"de","category":"grammar","level":"B2","sourceText":"Relativsätze mit Präposition, Genitiv, wo und was","translations":{"tr":["Gelişmiş ilgi cümleleri"]},"grammar":{"summary":"İlgi zamiri edatla veya Genitiv (dessen/deren) olarak kullanılabilir; was ve wo özel durumlarda gelir.","uses":["Edatlı fiillerle ilgi cümlesi: mit dem, auf die","Aitlik: dessen / deren","alles, etwas, nichts veya bütün bir cümleye atıf: was","Yer bildirmek: wo"],"sections":[{"kind":"other","title":"Edat + ilgi zamiri","formula":[{"tr":"İsim","en":"Bezugswort","role":"o"},{"tr":"Edat + ilgi zamiri","en":"Präposition + Relativpronomen","role":"x"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil (sonda)","en":"Verb (am Ende)","role":"v"}],"examples":[{"text":"Das ist [o:der Freund], [x:mit dem] [s:ich] in Urlaub [v:fahre].","tr":"Bu, birlikte tatile gittiğim arkadaş."},{"text":"[o:Die Stadt], [x:in der] [s:ich] [v:wohne], ist klein.","tr":"Yaşadığım şehir küçük."}]},{"kind":"other","title":"Genitiv: dessen / deren","formula":[{"tr":"İsim","en":"Bezugswort","role":"o"},{"tr":"dessen / deren","en":"dessen / deren","role":"x"},{"tr":"İsim (artikelsiz)","en":"Nomen ohne Artikel","role":"s"},{"tr":"Fiil (sonda)","en":"Verb (am Ende)","role":"v"}],"examples":[{"text":"[o:Der Mann], [x:dessen] [s:Auto] hier [v:steht], ist mein Nachbar.","tr":"Arabası burada duran adam komşum."},{"text":"[o:Die Kollegin], [x:deren] [s:Kinder] in Berlin [v:wohnen], kommt aus Wien.","tr":"Çocukları Berlin’de yaşayan meslektaşım Viyanalı."}]},{"kind":"other","title":"was: alles, etwas, nichts, das Beste …","formula":[{"tr":"alles / nichts / Cümle","en":"alles / nichts / Satz","role":"o"},{"tr":"was","en":"was","role":"x"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil (sonda)","en":"Verb (am Ende)","role":"v"}],"examples":[{"text":"Das ist [o:alles], [x:was] [s:ich] [v:weiß].","tr":"Bütün bildiğim bu."},{"text":"[o:Er hat die Prüfung bestanden], [x:was] [s:mich] sehr [v:freut].","tr":"Sınavı geçti, bu da beni çok sevindiriyor."}]},{"kind":"other","title":"wo / wohin / woher (yer)","formula":[{"tr":"Yer ismi","en":"Ortsangabe","role":"o"},{"tr":"wo / wohin / woher","en":"wo / wohin / woher","role":"x"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil (sonda)","en":"Verb (am Ende)","role":"v"}],"examples":[{"text":"Das ist [o:das Café], [x:wo] [s:wir] uns [v:kennengelernt haben].","tr":"Burası tanıştığımız kafe."}]}],"rules":["Zamirin cinsiyeti/sayısı önceki isimden, hâli ilgi cümlesindeki görevinden gelir.","dessen eril/nötr, deren dişil/çoğul için; ardından gelen isim artikelsizdir.","Edat her zaman ilgi zamirinin önüne gelir.","Çekimli fiil ilgi cümlesinin sonuna gider."],"exceptions":[],"mistakes":[{"wrong":"Die Frau, die ihr Sohn hier wohnt, …","right":"Die Frau, deren Sohn hier wohnt, …","note":"Aitlikte deren/dessen kullanılır."},{"wrong":"Das ist alles, das ich weiß.","right":"Das ist alles, was ich weiß.","note":"alles, nichts, etwas’tan sonra was gelir."},{"wrong":"Der Freund, dem ich mit fahre, …","right":"Der Freund, mit dem ich fahre, …","note":"Edat ilgi zamirinden önce gelir."}]}},
  {"id":"de-gr-infinitiv-mit-zu","languageId":"de","category":"grammar","level":"B2","sourceText":"Infinitiv mit zu","translations":{"tr":["zu’lu mastar yapıları"]},"grammar":{"summary":"Bazı fiil, sıfat ve isimlerden sonra ikinci eylem zu + mastar ile verilir: Ich habe vergessen, dich anzurufen.","uses":["Belirli fiillerden sonra: versuchen, vergessen, anfangen, vorhaben","es ist + sıfat: Es ist schwer, …","Bazı isimlerden sonra: Lust, Zeit, Angst haben"],"sections":[{"kind":"other","title":"Fiil + zu + mastar","formula":[{"tr":"Ana cümle","en":"Hauptsatz","role":"o"},{"tr":"Tümleç","en":"Ergänzung","role":"x"},{"tr":"zu + Mastar","en":"zu + Infinitiv","role":"v"}],"examples":[{"text":"[o:Ich habe vergessen], [x:dich] [v:anzurufen].","tr":"Seni aramayı unuttum."},{"text":"[o:Er versucht], [x:pünktlich] [v:zu sein].","tr":"Dakik olmaya çalışıyor."}]},{"kind":"other","title":"Es ist + sıfat + zu + mastar","formula":[{"tr":"Es ist + sıfat","en":"Es ist + Adjektiv","role":"o"},{"tr":"Tümleç","en":"Ergänzung","role":"x"},{"tr":"zu + Mastar","en":"zu + Infinitiv","role":"v"}],"examples":[{"text":"[o:Es ist wichtig], [x:genug Wasser] [v:zu trinken].","tr":"Yeterince su içmek önemli."}]},{"kind":"other","title":"İsim + zu + mastar","formula":[{"tr":"Ana cümle (isim)","en":"Hauptsatz (Nomen)","role":"o"},{"tr":"Tümleç","en":"Ergänzung","role":"x"},{"tr":"zu + Mastar","en":"zu + Infinitiv","role":"v"}],"examples":[{"text":"[o:Hast du Lust], [x:ins Kino] [v:zu gehen]?","tr":"Sinemaya gitmek ister misin?"}]},{"kind":"other","title":"Ayrılabilen fiiller: anzurufen","formula":[{"tr":"Önek + zu + fiil","en":"Präfix + zu + Verb","role":"v"}],"examples":[{"text":"Vergiss nicht, die Tür [v:abzuschließen].","tr":"Kapıyı kilitlemeyi unutma."}]},{"kind":"other","title":"Geçmiş mastar: Partizip II + zu haben/sein","formula":[{"tr":"Ana cümle","en":"Hauptsatz","role":"o"},{"tr":"Partizip II + zu haben/sein","en":"Infinitiv Perfekt","role":"v"}],"examples":[{"text":"[o:Ich bin froh], dich [v:kennengelernt zu haben].","tr":"Seninle tanıştığıma memnunum."}]}],"rules":["Ana cümlenin öznesi veya nesnesi mastarın da öznesi olmalı; değilse dass kullanılır.","Modal fiillerden ve lassen, sehen, hören, gehen’den sonra zu kullanılmaz.","Ayrılabilen fiillerde zu önek ile kökün arasına girer: aufzustehen."],"exceptions":[],"mistakes":[{"wrong":"Ich möchte zu schlafen.","right":"Ich möchte schlafen.","note":"Modal fiillerden sonra zu gelmez."},{"wrong":"Ich habe vergessen, zu anrufen.","right":"Ich habe vergessen anzurufen.","note":"Ayrılabilen fiilde zu ortaya girer."}]}},
  {"id":"de-gr-um-zu-damit-ohne-zu-statt-zu","languageId":"de","category":"grammar","level":"B2","sourceText":"um … zu / damit / ohne … zu / statt … zu","translations":{"tr":["Amaç ve durum bildiren mastar yapıları"]},"grammar":{"summary":"Amaç için um … zu veya damit; yapılmayan eylem için ohne … zu / ohne dass; yerine yapılan için statt … zu / statt dass kullanılır.","uses":["Amaç bildirmek (-mek için)","Bir eylemin yapılmadığını belirtmek (-meden)","Bir şeyin yerine başka bir şey yapmak (-mek yerine)"],"sections":[{"kind":"other","title":"um … zu (amaç, aynı özne)","formula":[{"tr":"Ana cümle","en":"Hauptsatz","role":"o"},{"tr":"um","en":"um","role":"x"},{"tr":"Tümleç","en":"Ergänzung","role":"o"},{"tr":"zu + Mastar","en":"zu + Infinitiv","role":"v"}],"examples":[{"text":"Ich lerne Deutsch, [x:um] [o:in Deutschland] [v:zu studieren].","tr":"Almanya’da okumak için Almanca öğreniyorum."}]},{"kind":"other","title":"damit (amaç, farklı özne)","formula":[{"tr":"Ana cümle","en":"Hauptsatz","role":"o"},{"tr":"damit","en":"damit","role":"x"},{"tr":"Özne","en":"Subjekt","role":"s"},{"tr":"Fiil (sonda)","en":"Verb (am Ende)","role":"v"}],"examples":[{"text":"Ich spreche langsam, [x:damit] [s:du] mich [v:verstehst].","tr":"Beni anlayasın diye yavaş konuşuyorum."}]},{"kind":"other","title":"ohne … zu / ohne dass","formula":[{"tr":"Ana cümle","en":"Hauptsatz","role":"o"},{"tr":"ohne / ohne dass","en":"ohne / ohne dass","role":"x"},{"tr":"zu + Mastar / Yan cümle","en":"zu + Infinitiv / Nebensatz","role":"v"}],"examples":[{"text":"Er ging, [x:ohne] sich [v:zu verabschieden].","tr":"Vedalaşmadan gitti."},{"text":"Sie nahm das Geld, [x:ohne dass] [s:es] jemand [v:merkte].","tr":"Kimse fark etmeden parayı aldı."}]},{"kind":"other","title":"statt … zu / statt dass","formula":[{"tr":"statt / statt dass","en":"(an)statt / statt dass","role":"x"},{"tr":"zu + Mastar / Yan cümle","en":"zu + Infinitiv / Nebensatz","role":"v"},{"tr":"Ana cümle","en":"Hauptsatz","role":"o"}],"examples":[{"text":"[x:Statt] [v:zu lernen], [o:spielt er Computerspiele].","tr":"Ders çalışmak yerine bilgisayar oyunu oynuyor."}]}],"rules":["Özneler aynıysa um/ohne/statt + zu tercih edilir; farklıysa damit / ohne dass / statt dass.","um … zu yapısında wollen veya möchten kullanılmaz.","Mastar yapı ana cümleden virgülle ayrılır."],"exceptions":[],"mistakes":[{"wrong":"Ich lerne, um ich die Prüfung bestehe.","right":"Ich lerne, um die Prüfung zu bestehen.","note":"um … zu yapısında özne tekrar edilmez."},{"wrong":"Ich rufe an, um du Bescheid weißt.","right":"Ich rufe an, damit du Bescheid weißt.","note":"Özne farklıysa damit kullanılır."},{"wrong":"Er ging, ohne zu sagen Tschüss.","right":"Er ging, ohne Tschüss zu sagen.","note":"zu + mastar sona gider."}]}}
]
