[
  {"id":"de-daily-hallo","languageId":"de","category":"daily","level":"A1","sourceText":"Hallo!","translations":{"tr":["merhaba!"]},"details":{"register":"neutral","context":"Her ortamda selamlaşırken."},"examples":[{"text":"Hallo, ich bin Lisa!","tr":"Merhaba, ben Lisa!"}]},
  {"id":"de-daily-guten-morgen","languageId":"de","category":"daily","level":"A1","sourceText":"Guten Morgen!","translations":{"tr":["günaydın!"]},"details":{"register":"neutral","context":"Sabahtan yaklaşık saat 10–11'e kadar."},"examples":[{"text":"Guten Morgen! Gut geschlafen?","tr":"Günaydın! İyi uyudun mu?"}]},
  {"id":"de-daily-guten-tag","languageId":"de","category":"daily","level":"A1","sourceText":"Guten Tag!","translations":{"tr":["iyi günler!","merhaba!"]},"details":{"register":"formal","context":"Gün içinde, özellikle resmî ortamlarda selamlaşırken."},"examples":[{"text":"Guten Tag, Frau Müller!","tr":"İyi günler, Bayan Müller!"}]},
  {"id":"de-daily-guten-abend","languageId":"de","category":"daily","level":"A1","sourceText":"Guten Abend!","translations":{"tr":["iyi akşamlar!"]},"details":{"register":"neutral","context":"Akşam saatlerinde karşılaşınca selam olarak."},"examples":[{"text":"Guten Abend, meine Damen und Herren!","tr":"İyi akşamlar, bayanlar baylar!"}]},
  {"id":"de-daily-gute-nacht","languageId":"de","category":"daily","level":"A1","sourceText":"Gute Nacht!","translations":{"tr":["iyi geceler!"]},"details":{"register":"neutral","context":"Yatmadan önce ya da gece ayrılırken; selam olarak kullanılmaz."},"examples":[{"text":"Ich gehe ins Bett. Gute Nacht!","tr":"Yatmaya gidiyorum. İyi geceler!"}]},
  {"id":"de-daily-alles-klar","languageId":"de","category":"daily","level":"A1","sourceText":"Alles klar!","translations":{"tr":["tamam!","anlaşıldı!","her şey yolunda"]},"details":{"register":"informal","context":"Onay verirken; soru olarak (\"Alles klar?\") gençler arasında selam da olur."},"examples":[{"text":"Hey, alles klar? – Ja, alles klar!","tr":"Hey, her şey yolunda mı? – Evet, yolunda!"}]},
  {"id":"de-daily-und-dir","languageId":"de","category":"daily","level":"A1","sourceText":"Und dir?","translations":{"tr":["ya sen?","sen nasılsın?"]},"details":{"register":"informal","context":"\"Nasılsın?\" sorusuna cevap verip soruyu geri yöneltirken; resmîsi \"Und Ihnen?\""},"examples":[{"text":"Mir geht's gut, danke. Und dir?","tr":"İyiyim, teşekkürler. Ya sen?"}]},
  {"id":"de-daily-mir-gehts-gut","languageId":"de","category":"daily","level":"A1","sourceText":"Mir geht's gut.","translations":{"tr":["iyiyim"]},"details":{"register":"neutral","context":"\"Wie geht's?\" sorusuna cevap."},"examples":[{"text":"Wie geht's? – Mir geht's gut, danke!","tr":"Nasılsın? – İyiyim, teşekkürler!"}]},
  {"id":"de-daily-nicht-so-gut","languageId":"de","category":"daily","level":"A1","sourceText":"Nicht so gut.","translations":{"tr":["pek iyi değilim"]},"details":{"register":"neutral","context":"Keyifsizken \"nasılsın?\" sorusuna cevap."},"examples":[{"text":"Wie geht's? – Nicht so gut, ich bin erkältet.","tr":"Nasılsın? – Pek iyi değilim, soğuk algınlığım var."}]},
  {"id":"de-daily-tschuss","languageId":"de","category":"daily","level":"A1","sourceText":"Tschüss!","translations":{"tr":["hoşça kal!","görüşürüz!"]},"details":{"register":"informal","context":"En yaygın samimi veda."},"examples":[{"text":"Tschüss, bis morgen!","tr":"Hoşça kal, yarın görüşürüz!"}]},
  {"id":"de-daily-auf-wiedersehen","languageId":"de","category":"daily","level":"A1","sourceText":"Auf Wiedersehen!","translations":{"tr":["hoşça kalın!","güle güle!"]},"details":{"register":"formal","context":"Resmî ortamlarda vedalaşırken."},"examples":[{"text":"Vielen Dank und auf Wiedersehen!","tr":"Çok teşekkürler, hoşça kalın!"}]},
  {"id":"de-daily-bis-spater","languageId":"de","category":"daily","level":"A1","sourceText":"Bis später!","translations":{"tr":["sonra görüşürüz!"]},"details":{"register":"neutral","context":"Aynı gün tekrar görüşülecekse."},"examples":[{"text":"Ich gehe einkaufen. Bis später!","tr":"Alışverişe gidiyorum. Sonra görüşürüz!"}]},
  {"id":"de-daily-bis-bald","languageId":"de","category":"daily","level":"A1","sourceText":"Bis bald!","translations":{"tr":["yakında görüşmek üzere!"]},"details":{"register":"neutral","context":"Yakın zamanda görüşmeyi umarak vedalaşırken."},"examples":[{"text":"Es war schön mit dir. Bis bald!","tr":"Seninle güzeldi. Yakında görüşmek üzere!"}]},
  {"id":"de-daily-bis-morgen","languageId":"de","category":"daily","level":"A1","sourceText":"Bis morgen!","translations":{"tr":["yarın görüşürüz!"]},"details":{"register":"neutral","context":"Ertesi gün görüşülecekse."},"examples":[{"text":"Gute Nacht und bis morgen!","tr":"İyi geceler, yarın görüşürüz!"}]},
  {"id":"de-daily-bis-dann","languageId":"de","category":"daily","level":"A1","sourceText":"Bis dann!","translations":{"tr":["o zaman görüşürüz!"]},"details":{"register":"informal","context":"Belirli bir buluşma ayarlandıktan sonra."},"examples":[{"text":"Also um sieben am Bahnhof. Bis dann!","tr":"Yani yedide garda. O zaman görüşürüz!"}]},
  {"id":"de-daily-bis-gleich","languageId":"de","category":"daily","level":"A1","sourceText":"Bis gleich!","translations":{"tr":["birazdan görüşürüz!"]},"details":{"register":"informal","context":"Çok kısa süre sonra tekrar görüşülecekse."},"examples":[{"text":"Ich bin in fünf Minuten da. Bis gleich!","tr":"Beş dakikaya oradayım. Birazdan görüşürüz!"}]},
  {"id":"de-daily-bis-nachste-woche","languageId":"de","category":"daily","level":"A1","sourceText":"Bis nächste Woche!","translations":{"tr":["haftaya görüşürüz!"]},"details":{"register":"neutral","context":"Bir sonraki hafta görüşülecekse."},"examples":[{"text":"Schönes Wochenende und bis nächste Woche!","tr":"İyi hafta sonları, haftaya görüşürüz!"}]},
  {"id":"de-daily-ciao","languageId":"de","category":"daily","level":"A1","sourceText":"Ciao!","translations":{"tr":["hoşça kal!","selam!"]},"details":{"register":"informal","context":"Arkadaşlar arasında veda (bazen selam)."},"examples":[{"text":"Ciao, bis morgen!","tr":"Hoşça kal, yarın görüşürüz!"}]},
  {"id":"de-daily-schonen-tag-noch","languageId":"de","category":"daily","level":"A1","sourceText":"Schönen Tag noch!","translations":{"tr":["iyi günler!"]},"details":{"register":"neutral","context":"Mağaza veya kafede ayrılırken."},"examples":[{"text":"Danke und schönen Tag noch! – Danke, gleichfalls!","tr":"Teşekkürler, iyi günler! – Teşekkürler, size de!"}]},
  {"id":"de-daily-schones-wochenende","languageId":"de","category":"daily","level":"A1","sourceText":"Schönes Wochenende!","translations":{"tr":["iyi hafta sonları!"]},"details":{"register":"neutral","context":"Cuma günü vedalaşırken."},"examples":[{"text":"Bis Montag und schönes Wochenende!","tr":"Pazartesi görüşürüz, iyi hafta sonları!"}]},
  {"id":"de-daily-guten-appetit","languageId":"de","category":"daily","level":"A1","sourceText":"Guten Appetit!","translations":{"tr":["afiyet olsun!"]},"details":{"register":"neutral","context":"Yemeğe başlarken."},"examples":[{"text":"Das Essen ist fertig. Guten Appetit!","tr":"Yemek hazır. Afiyet olsun!"}]},
  {"id":"de-daily-prost","languageId":"de","category":"daily","level":"A1","sourceText":"Prost!","translations":{"tr":["şerefe!"]},"details":{"register":"informal","context":"Kadeh kaldırırken; göz teması kurmak âdettir."},"examples":[{"text":"Auf deinen Geburtstag! Prost!","tr":"Doğum gününe! Şerefe!"}]},
  {"id":"de-daily-gesundheit","languageId":"de","category":"daily","level":"A1","sourceText":"Gesundheit!","translations":{"tr":["çok yaşa!"]},"details":{"register":"neutral","context":"Biri hapşırınca söylenir; cevap \"Danke!\""},"examples":[{"text":"Hatschi! – Gesundheit! – Danke!","tr":"Hapşu! – Çok yaşa! – Teşekkürler!"}]},
  {"id":"de-daily-freut-mich","languageId":"de","category":"daily","level":"A1","sourceText":"Freut mich!","translations":{"tr":["memnun oldum!"]},"details":{"register":"neutral","context":"Biriyle tanışınca; tam hâli \"Freut mich, Sie kennenzulernen\"."},"examples":[{"text":"Ich bin Jonas. – Freut mich! Ich heiße Elif.","tr":"Ben Jonas. – Memnun oldum! Benim adım Elif."}]},
  {"id":"de-daily-herzlich-willkommen","languageId":"de","category":"daily","level":"A1","sourceText":"Herzlich willkommen!","translations":{"tr":["hoş geldiniz!"]},"details":{"register":"neutral","context":"Misafiri ya da katılımcıları karşılarken."},"examples":[{"text":"Herzlich willkommen in Hamburg!","tr":"Hamburg'a hoş geldiniz!"}]},
  {"id":"de-daily-komm-rein","languageId":"de","category":"daily","level":"A1","sourceText":"Komm rein!","translations":{"tr":["içeri gel!","gir!"]},"details":{"register":"informal","context":"Misafiri içeri davet ederken; resmîsi \"Kommen Sie herein!\""},"examples":[{"text":"Hallo! Komm rein, es ist kalt draußen.","tr":"Merhaba! İçeri gel, dışarısı soğuk."}]},
  {"id":"de-daily-hier-bitte","languageId":"de","category":"daily","level":"A1","sourceText":"Hier, bitte.","translations":{"tr":["buyurun","al bakalım"]},"details":{"register":"neutral","context":"Bir şeyi uzatırken."},"examples":[{"text":"Haben Sie einen Stift? – Hier, bitte.","tr":"Kaleminiz var mı? – Buyurun."}]},
  {"id":"de-daily-bitte","languageId":"de","category":"daily","level":"A1","sourceText":"Bitte?","translations":{"tr":["efendim?","buyurun?"]},"details":{"register":"neutral","context":"Duyamadığında ya da birinin ne istediğini sorarken."},"examples":[{"text":"Bitte? Ich habe Sie nicht verstanden.","tr":"Efendim? Sizi anlayamadım."}]},
  {"id":"de-daily-danke","languageId":"de","category":"daily","level":"A1","sourceText":"Danke!","translations":{"tr":["teşekkürler!","sağ ol!"]},"details":{"register":"neutral","context":"Her durumda teşekkür ederken."},"examples":[{"text":"Hier ist dein Buch. – Danke!","tr":"İşte kitabın. – Sağ ol!"}]},
  {"id":"de-daily-nein-danke","languageId":"de","category":"daily","level":"A1","sourceText":"Nein, danke.","translations":{"tr":["hayır, teşekkürler"]},"details":{"register":"neutral","context":"Bir teklifi kibarca reddederken."},"examples":[{"text":"Möchtest du noch Tee? – Nein, danke.","tr":"Biraz daha çay ister misin? – Hayır, teşekkürler."}]},
  {"id":"de-daily-ja-gern","languageId":"de","category":"daily","level":"A1","sourceText":"Ja, gern!","translations":{"tr":["evet, memnuniyetle!"]},"details":{"register":"neutral","context":"Bir teklifi kabul ederken."},"examples":[{"text":"Möchten Sie einen Kaffee? – Ja, gern!","tr":"Kahve ister misiniz? – Evet, memnuniyetle!"}]},
  {"id":"de-daily-gerne","languageId":"de","category":"daily","level":"A1","sourceText":"Gerne!","translations":{"tr":["seve seve!","rica ederim!"]},"details":{"register":"neutral","context":"Teklife evet derken ya da teşekküre cevap verirken."},"examples":[{"text":"Danke für die Hilfe! – Gerne!","tr":"Yardım için teşekkürler! – Rica ederim!"}]},
  {"id":"de-daily-kein-problem","languageId":"de","category":"daily","level":"A1","sourceText":"Kein Problem!","translations":{"tr":["sorun değil!"]},"details":{"register":"neutral","context":"Teşekküre ya da özre cevap verirken."},"examples":[{"text":"Danke fürs Warten! – Kein Problem!","tr":"Beklediğin için teşekkürler! – Sorun değil!"}]},
  {"id":"de-daily-entschuldigung","languageId":"de","category":"daily","level":"A1","sourceText":"Entschuldigung!","translations":{"tr":["pardon!","özür dilerim!","affedersiniz!"]},"details":{"register":"neutral","context":"Özür dilerken ya da birinin dikkatini çekerken."},"examples":[{"text":"Entschuldigung, ist hier noch frei?","tr":"Affedersiniz, burası boş mu?"}]},
  {"id":"de-daily-okay","languageId":"de","category":"daily","level":"A1","sourceText":"Okay!","translations":{"tr":["tamam!"]},"details":{"register":"informal","context":"Onay verirken; Almancada çok yaygın."},"examples":[{"text":"Wir gehen um fünf. – Okay!","tr":"Beşte gidiyoruz. – Tamam!"}]},
  {"id":"de-daily-klar","languageId":"de","category":"daily","level":"A1","sourceText":"Klar!","translations":{"tr":["tabii!","elbette!"]},"details":{"register":"informal","context":"Gündelik onay."},"examples":[{"text":"Hilfst du mir? – Klar!","tr":"Bana yardım eder misin? – Tabii!"}]},
  {"id":"de-daily-gute-idee","languageId":"de","category":"daily","level":"A1","sourceText":"Gute Idee!","translations":{"tr":["iyi fikir!"]},"details":{"register":"neutral","context":"Bir öneriyi beğenince."},"examples":[{"text":"Wollen wir Pizza bestellen? – Gute Idee!","tr":"Pizza söyleyelim mi? – İyi fikir!"}]},
  {"id":"de-daily-ich-weiss-nicht","languageId":"de","category":"daily","level":"A1","sourceText":"Ich weiß nicht.","translations":{"tr":["bilmiyorum"]},"details":{"register":"neutral","context":"Bilmediğini söylerken."},"examples":[{"text":"Wo ist der Bahnhof? – Ich weiß nicht, tut mir leid.","tr":"Gar nerede? – Bilmiyorum, kusura bakmayın."}]},
  {"id":"de-daily-ich-auch","languageId":"de","category":"daily","level":"A1","sourceText":"Ich auch.","translations":{"tr":["ben de"]},"details":{"register":"neutral","context":"Olumlu bir cümleye katılırken."},"examples":[{"text":"Ich habe Hunger. – Ich auch.","tr":"Açım. – Ben de."}]},
  {"id":"de-daily-ich-auch-nicht","languageId":"de","category":"daily","level":"A1","sourceText":"Ich auch nicht.","translations":{"tr":["ben de değil","ben de …mıyorum"]},"details":{"register":"neutral","context":"Olumsuz bir cümleye katılırken."},"examples":[{"text":"Ich mag keinen Fisch. – Ich auch nicht.","tr":"Balık sevmem. – Ben de sevmem."}]},
  {"id":"de-daily-ach-so","languageId":"de","category":"daily","level":"A1","sourceText":"Ach so!","translations":{"tr":["haa, anladım!","öyle mi!"]},"details":{"register":"neutral","context":"Bir şeyi yeni anladığında."},"examples":[{"text":"Er ist im Urlaub. – Ach so, deshalb ist er nicht da!","tr":"İzinde. – Haa, o yüzden burada değil!"}]},
  {"id":"de-daily-aha","languageId":"de","category":"daily","level":"A1","sourceText":"Aha!","translations":{"tr":["anladım!","demek öyle!"]},"details":{"register":"neutral","context":"Dinlediğini ya da anladığını belirtirken."},"examples":[{"text":"Ich arbeite jetzt in Köln. – Aha! Seit wann?","tr":"Artık Köln'de çalışıyorum. – Demek öyle! Ne zamandan beri?"}]},
  {"id":"de-daily-wie-war-dein-tag","languageId":"de","category":"daily","level":"A1","sourceText":"Wie war dein Tag?","translations":{"tr":["günün nasıl geçti?"]},"details":{"register":"informal","context":"Akşam eve gelen birine sorulur."},"examples":[{"text":"Hallo Schatz! Wie war dein Tag?","tr":"Merhaba canım! Günün nasıl geçti?"}]},
  {"id":"de-daily-was-machst-du-heute","languageId":"de","category":"daily","level":"A1","sourceText":"Was machst du heute?","translations":{"tr":["bugün ne yapıyorsun?"]},"details":{"register":"informal","context":"Plan sorarken."},"examples":[{"text":"Was machst du heute Abend?","tr":"Bu akşam ne yapıyorsun?"}]},
  {"id":"de-daily-hast-du-zeit","languageId":"de","category":"daily","level":"A1","sourceText":"Hast du Zeit?","translations":{"tr":["vaktin var mı?"]},"details":{"register":"informal","context":"Buluşma ya da yardım teklifinden önce."},"examples":[{"text":"Hast du am Samstag Zeit?","tr":"Cumartesi vaktin var mı?"}]},
  {"id":"de-daily-wann-treffen-wir-uns","languageId":"de","category":"daily","level":"A1","sourceText":"Wann treffen wir uns?","translations":{"tr":["ne zaman buluşuyoruz?"]},"details":{"register":"neutral","context":"Buluşma ayarlarken."},"examples":[{"text":"Wann treffen wir uns morgen?","tr":"Yarın ne zaman buluşuyoruz?"}]},
  {"id":"de-daily-wo-treffen-wir-uns","languageId":"de","category":"daily","level":"A1","sourceText":"Wo treffen wir uns?","translations":{"tr":["nerede buluşuyoruz?"]},"details":{"register":"neutral","context":"Buluşma yeri ayarlarken."},"examples":[{"text":"Wo treffen wir uns? Am Bahnhof?","tr":"Nerede buluşuyoruz? Garda mı?"}]},
  {"id":"de-daily-ist-hier-noch-frei","languageId":"de","category":"daily","level":"A1","sourceText":"Ist hier noch frei?","translations":{"tr":["burası boş mu?"]},"details":{"register":"neutral","context":"Kafe, tren ya da otobüste boş yer sorarken."},"examples":[{"text":"Entschuldigung, ist hier noch frei? – Ja, bitte.","tr":"Affedersiniz, burası boş mu? – Evet, buyurun."}]},
  {"id":"de-daily-wo-ist-die-toilette","languageId":"de","category":"daily","level":"A1","sourceText":"Wo ist die Toilette?","translations":{"tr":["tuvalet nerede?"]},"details":{"register":"neutral","context":"Restoran ya da mağazada sorulur."},"examples":[{"text":"Entschuldigung, wo ist die Toilette?","tr":"Affedersiniz, tuvalet nerede?"}]},
  {"id":"de-daily-kann-ich-ihnen-helfen","languageId":"de","category":"daily","level":"A1","sourceText":"Kann ich Ihnen helfen?","translations":{"tr":["yardımcı olabilir miyim?"]},"details":{"register":"formal","context":"Mağazada satıcı müşteriye sorar."},"examples":[{"text":"Guten Tag, kann ich Ihnen helfen?","tr":"İyi günler, yardımcı olabilir miyim?"}]},
  {"id":"de-daily-ich-nehme-das","languageId":"de","category":"daily","level":"A1","sourceText":"Ich nehme das.","translations":{"tr":["bunu alıyorum"]},"details":{"register":"neutral","context":"Alışverişte karar verince."},"examples":[{"text":"Die Jacke gefällt mir. Ich nehme sie.","tr":"Ceketi beğendim. Onu alıyorum."}]},
  {"id":"de-daily-kann-ich-mit-karte-zahlen","languageId":"de","category":"daily","level":"A1","sourceText":"Kann ich mit Karte zahlen?","translations":{"tr":["kartla ödeyebilir miyim?"]},"details":{"register":"neutral","context":"Almanya'da bazı yerler sadece nakit alır; önceden sorulur."},"examples":[{"text":"Kann ich hier mit Karte zahlen?","tr":"Burada kartla ödeyebilir miyim?"}]},
  {"id":"de-daily-einmal-bitte","languageId":"de","category":"daily","level":"A1","sourceText":"Einmal …, bitte.","translations":{"tr":["bir tane …, lütfen"]},"details":{"register":"neutral","context":"Sipariş verirken sayı belirtmek için."},"examples":[{"text":"Einmal Currywurst mit Pommes, bitte.","tr":"Bir köri sosis patatesle, lütfen."}]},
  {"id":"de-daily-noch-einen-kaffee","languageId":"de","category":"daily","level":"A1","sourceText":"Noch einen Kaffee?","translations":{"tr":["bir kahve daha?"]},"details":{"register":"neutral","context":"İkram ederken."},"examples":[{"text":"Noch einen Kaffee? – Gern, danke.","tr":"Bir kahve daha? – Memnuniyetle, teşekkürler."}]},
  {"id":"de-daily-lecker","languageId":"de","category":"daily","level":"A1","sourceText":"Lecker!","translations":{"tr":["nefis!","çok lezzetli!"]},"details":{"register":"informal","context":"Yemeği beğenince."},"examples":[{"text":"Hm, die Suppe ist lecker!","tr":"Hmm, çorba nefis!"}]},
  {"id":"de-daily-das-schmeckt-gut","languageId":"de","category":"daily","level":"A1","sourceText":"Das schmeckt gut!","translations":{"tr":["bu çok güzel olmuş!","tadı güzel!"]},"details":{"register":"neutral","context":"Yemeği övmek için."},"examples":[{"text":"Wie schmeckt's? – Das schmeckt sehr gut!","tr":"Tadı nasıl? – Çok güzel olmuş!"}]},
  {"id":"de-daily-ich-bin-satt","languageId":"de","category":"daily","level":"A1","sourceText":"Ich bin satt.","translations":{"tr":["doydum"]},"details":{"register":"neutral","context":"Daha fazla yemek istemediğinde."},"examples":[{"text":"Noch etwas Kuchen? – Nein danke, ich bin satt.","tr":"Biraz daha pasta? – Hayır teşekkürler, doydum."}]},
  {"id":"de-daily-ich-habe-hunger","languageId":"de","category":"daily","level":"A1","sourceText":"Ich habe Hunger.","translations":{"tr":["acıktım","açım"]},"details":{"register":"neutral","context":"Aç olduğunu söylerken; \"Ich bin hungrig\" daha az kullanılır."},"examples":[{"text":"Ich habe Hunger. Gehen wir essen?","tr":"Açım. Yemeğe gidelim mi?"}]},
  {"id":"de-daily-ich-habe-durst","languageId":"de","category":"daily","level":"A1","sourceText":"Ich habe Durst.","translations":{"tr":["susadım"]},"details":{"register":"neutral","context":"Susadığını söylerken."},"examples":[{"text":"Ich habe Durst. Hast du Wasser?","tr":"Susadım. Suyun var mı?"}]},
  {"id":"de-daily-mir-ist-kalt","languageId":"de","category":"daily","level":"A1","sourceText":"Mir ist kalt.","translations":{"tr":["üşüyorum"]},"details":{"register":"neutral","context":"Üşüdüğünü söylerken; \"Ich bin kalt\" yanlış olur."},"examples":[{"text":"Mir ist kalt. Kannst du das Fenster zumachen?","tr":"Üşüyorum. Pencereyi kapatabilir misin?"}]},
  {"id":"de-daily-mir-ist-warm","languageId":"de","category":"daily","level":"A1","sourceText":"Mir ist warm.","translations":{"tr":["sıcakladım","terledim"]},"details":{"register":"neutral","context":"Sıcaklandığını söylerken."},"examples":[{"text":"Mir ist warm, ich ziehe die Jacke aus.","tr":"Sıcakladım, ceketimi çıkarıyorum."}]},
  {"id":"de-daily-ich-bin-mude","languageId":"de","category":"daily","level":"A1","sourceText":"Ich bin müde.","translations":{"tr":["yorgunum","uykum var"]},"details":{"register":"neutral","context":"Yorgunluğunu söylerken."},"examples":[{"text":"Ich bin müde, ich gehe schlafen.","tr":"Yorgunum, yatmaya gidiyorum."}]},
  {"id":"de-daily-ich-komme-gleich","languageId":"de","category":"daily","level":"A1","sourceText":"Ich komme gleich!","translations":{"tr":["hemen geliyorum!"]},"details":{"register":"neutral","context":"Çağrılınca birazdan geleceğini söylerken."},"examples":[{"text":"Essen ist fertig! – Ich komme gleich!","tr":"Yemek hazır! – Hemen geliyorum!"}]},
  {"id":"de-daily-wo-bist-du","languageId":"de","category":"daily","level":"A1","sourceText":"Wo bist du?","translations":{"tr":["neredesin?"]},"details":{"register":"informal","context":"Telefonda ya da mesajda."},"examples":[{"text":"Wo bist du? Ich warte schon!","tr":"Neredesin? Bekliyorum!"}]},
  {"id":"de-daily-einen-moment-bitte","languageId":"de","category":"daily","level":"A1","sourceText":"Einen Moment, bitte.","translations":{"tr":["bir dakika lütfen"]},"details":{"register":"neutral","context":"Birini kısa süre bekletirken; telefonda da."},"examples":[{"text":"Einen Moment, bitte, ich verbinde Sie.","tr":"Bir dakika lütfen, sizi bağlıyorum."}]},
  {"id":"de-daily-vorsicht","languageId":"de","category":"daily","level":"A1","sourceText":"Vorsicht!","translations":{"tr":["dikkat!"]},"details":{"register":"neutral","context":"Tehlikeye karşı uyarırken."},"examples":[{"text":"Vorsicht, der Teller ist heiß!","tr":"Dikkat, tabak sıcak!"}]},
  {"id":"de-daily-pass-auf","languageId":"de","category":"daily","level":"A1","sourceText":"Pass auf!","translations":{"tr":["dikkat et!"]},"details":{"register":"informal","context":"Birini uyarırken."},"examples":[{"text":"Pass auf, da kommt ein Auto!","tr":"Dikkat et, araba geliyor!"}]},
