[
  {"id":"de-daily-gruezi","languageId":"de","category":"daily","level":"B1","sourceText":"Grüezi!","translations":{"tr":["merhaba!"]},"details":{"register":"neutral","context":"İsviçre'de kibar selamlaşma."},"examples":[{"text":"Grüezi mitenand!","tr":"Herkese merhaba!"}]},
  {"id":"de-daily-man-sieht-sich","languageId":"de","category":"daily","level":"B1","sourceText":"Man sieht sich!","translations":{"tr":["görüşürüz!","yolumuz kesişir!"]},"details":{"register":"informal","context":"Belirli bir buluşma olmadan rahat veda."},"examples":[{"text":"Also dann, man sieht sich!","tr":"Eh o zaman, görüşürüz!"}]},
  {"id":"de-daily-feierabend","languageId":"de","category":"daily","level":"B1","sourceText":"Feierabend!","translations":{"tr":["paydos!","mesai bitti!"]},"details":{"register":"informal","context":"İşin bittiğini ilan ederken."},"examples":[{"text":"So, Feierabend! Ich gehe nach Hause.","tr":"Evet, paydos! Eve gidiyorum."}]},
  {"id":"de-daily-mahlzeit","languageId":"de","category":"daily","level":"B1","sourceText":"Mahlzeit!","translations":{"tr":["afiyet olsun!","öğlen selamı"]},"details":{"register":"informal","context":"İş yerinde öğle saatinde selam olarak ya da yemekte."},"examples":[{"text":"Mahlzeit! Gehst du auch in die Kantine?","tr":"Afiyet olsun! Sen de yemekhaneye mi gidiyorsun?"}]},
  {"id":"de-daily-lass-es-dir-schmecken","languageId":"de","category":"daily","level":"B1","sourceText":"Lass es dir schmecken!","translations":{"tr":["afiyet olsun!"]},"details":{"register":"informal","context":"Birine yemek ikram ederken; resmîsi \"Lassen Sie es sich schmecken!\""},"examples":[{"text":"Hier ist dein Kuchen. Lass es dir schmecken!","tr":"İşte pastan. Afiyet olsun!"}]},
  {"id":"de-daily-ebenfalls","languageId":"de","category":"daily","level":"B1","sourceText":"Ebenfalls!","translations":{"tr":["size de!","aynen!"]},"details":{"register":"neutral","context":"İyi dileğe aynısıyla karşılık verirken."},"examples":[{"text":"Guten Appetit! – Danke, ebenfalls!","tr":"Afiyet olsun! – Teşekkürler, size de!"}]},
  {"id":"de-daily-angenehm","languageId":"de","category":"daily","level":"B1","sourceText":"Angenehm!","translations":{"tr":["memnun oldum!"]},"details":{"register":"formal","context":"Resmî tanışmada kısa cevap."},"examples":[{"text":"Darf ich vorstellen: Herr Weber. – Angenehm!","tr":"Tanıştırayım: Bay Weber. – Memnun oldum!"}]},
  {"id":"de-daily-ganz-meinerseits","languageId":"de","category":"daily","level":"B1","sourceText":"Ganz meinerseits!","translations":{"tr":["ben de memnun oldum!"]},"details":{"register":"formal","context":"\"Freut mich\" diyene cevap."},"examples":[{"text":"Freut mich, Sie kennenzulernen. – Ganz meinerseits!","tr":"Tanıştığıma memnun oldum. – Ben de!"}]},
  {"id":"de-daily-fuhl-dich-wie-zu-hause","languageId":"de","category":"daily","level":"B1","sourceText":"Fühl dich wie zu Hause!","translations":{"tr":["kendi evin gibi rahat ol!"]},"details":{"register":"informal","context":"Misafire ev sahibi söyler."},"examples":[{"text":"Leg deine Jacke ab und fühl dich wie zu Hause!","tr":"Ceketini çıkar ve kendi evin gibi rahat ol!"}]},
  {"id":"de-daily-bedien-dich","languageId":"de","category":"daily","level":"B1","sourceText":"Bedien dich!","translations":{"tr":["buyur, al!","kendin al!"]},"details":{"register":"informal","context":"Misafire yiyecek-içecek ikram ederken."},"examples":[{"text":"Da ist Kuchen und Kaffee. Bedien dich!","tr":"Pasta ve kahve var. Buyur al!"}]},
  {"id":"de-daily-greif-zu","languageId":"de","category":"daily","level":"B1","sourceText":"Greif zu!","translations":{"tr":["buyur, al!","çekinme!"]},"details":{"register":"informal","context":"Yemek ikram ederken çekinmemesini söylerken."},"examples":[{"text":"Die Pizza ist für alle. Greift zu!","tr":"Pizza herkes için. Buyurun alın!"}]},
  {"id":"de-daily-mit-vergnugen","languageId":"de","category":"daily","level":"B1","sourceText":"Mit Vergnügen!","translations":{"tr":["memnuniyetle!","seve seve!"]},"details":{"register":"neutral","context":"Bir ricayı ya da daveti sevinerek kabul ederken."},"examples":[{"text":"Kannst du mir helfen? – Mit Vergnügen!","tr":"Bana yardım edebilir misin? – Seve seve!"}]},
  {"id":"de-daily-jederzeit","languageId":"de","category":"daily","level":"B1","sourceText":"Jederzeit!","translations":{"tr":["her zaman!"]},"details":{"register":"neutral","context":"Teşekküre, tekrar yardım etmeye hazır olduğunu söyleyerek cevap verirken."},"examples":[{"text":"Danke für deine Hilfe! – Jederzeit!","tr":"Yardımın için teşekkürler! – Her zaman!"}]},
  {"id":"de-daily-verzeihung","languageId":"de","category":"daily","level":"B1","sourceText":"Verzeihung!","translations":{"tr":["affedersiniz!","özür dilerim!"]},"details":{"register":"formal","context":"Kibar ve biraz resmî özür."},"examples":[{"text":"Verzeihung, darf ich mal vorbei?","tr":"Affedersiniz, geçebilir miyim?"}]},
  {"id":"de-daily-halb-so-schlimm","languageId":"de","category":"daily","level":"B1","sourceText":"Halb so schlimm.","translations":{"tr":["o kadar da kötü değil"]},"details":{"register":"neutral","context":"Bir sorunu küçümseyip teselli ederken."},"examples":[{"text":"Ich habe den Bus verpasst. – Halb so schlimm, der nächste kommt gleich.","tr":"Otobüsü kaçırdım. – O kadar da kötü değil, sonraki hemen gelir."}]},
  {"id":"de-daily-kein-stress","languageId":"de","category":"daily","level":"B1","sourceText":"Kein Stress!","translations":{"tr":["acele yok!","sıkıntı yok!"]},"details":{"register":"informal","context":"Birinin acele etmesine ya da gerilmesine gerek olmadığını söylerken."},"examples":[{"text":"Ich komme zehn Minuten später. – Kein Stress!","tr":"On dakika geç geleceğim. – Sıkıntı yok!"}]},
  {"id":"de-daily-passt-schon","languageId":"de","category":"daily","level":"B1","sourceText":"Passt schon!","translations":{"tr":["sorun yok!","olur, idare eder!"]},"details":{"register":"informal","context":"Güney Almanya'da yaygın; \"önemli değil\" ya da \"yeter\" anlamında."},"examples":[{"text":"Soll ich dir das Geld zurückgeben? – Passt schon!","tr":"Parayı geri vereyim mi? – Sorun yok!"}]},
  {"id":"de-daily-passt","languageId":"de","category":"daily","level":"B1","sourceText":"Passt!","translations":{"tr":["uyar!","tamam!"]},"details":{"register":"informal","context":"Bir öneriyi ya da zamanı kabul ederken."},"examples":[{"text":"Morgen um zehn? – Passt!","tr":"Yarın onda mı? – Uyar!"}]},
  {"id":"de-daily-geht-klar","languageId":"de","category":"daily","level":"B1","sourceText":"Geht klar!","translations":{"tr":["tamamdır!","olur!"]},"details":{"register":"informal","context":"Bir ricayı ya da planı onaylarken."},"examples":[{"text":"Kannst du Brot mitbringen? – Geht klar!","tr":"Ekmek getirebilir misin? – Tamamdır!"}]},
  {"id":"de-daily-einverstanden","languageId":"de","category":"daily","level":"B1","sourceText":"Einverstanden!","translations":{"tr":["anlaştık!","kabul!"]},"details":{"register":"neutral","context":"Bir öneriyi kabul ederken."},"examples":[{"text":"Wir teilen die Rechnung. – Einverstanden!","tr":"Hesabı bölüşüyoruz. – Anlaştık!"}]},
  {"id":"de-daily-von-mir-aus","languageId":"de","category":"daily","level":"B1","sourceText":"Von mir aus.","translations":{"tr":["bana göre hava hoş","bence olur"]},"details":{"register":"informal","context":"Pek umursamadan izin verirken."},"examples":[{"text":"Darf ich das Fenster aufmachen? – Von mir aus.","tr":"Pencereyi açabilir miyim? – Bence olur."}]},
  {"id":"de-daily-meinetwegen","languageId":"de","category":"daily","level":"B1","sourceText":"Meinetwegen.","translations":{"tr":["bence fark etmez","tamam, öyle olsun"]},"details":{"register":"informal","context":"İsteksiz onay verirken."},"examples":[{"text":"Können wir heute Fisch essen? – Meinetwegen.","tr":"Bugün balık yiyebilir miyiz? – Tamam, öyle olsun."}]},
  {"id":"de-daily-schauen-wir-mal","languageId":"de","category":"daily","level":"B1","sourceText":"Schauen wir mal.","translations":{"tr":["bir bakalım","görürüz"]},"details":{"register":"informal","context":"Güney Almanya'da yaygın; olayların gelişimini beklerken."},"examples":[{"text":"Ob das klappt? Schauen wir mal.","tr":"İşe yarar mı? Bir bakalım."}]},
  {"id":"de-daily-ich-bin-dabei","languageId":"de","category":"daily","level":"B1","sourceText":"Ich bin dabei!","translations":{"tr":["ben varım!","ben de katılıyorum!"]},"details":{"register":"informal","context":"Bir plana katıldığını söylerken."},"examples":[{"text":"Wer kommt mit ins Kino? – Ich bin dabei!","tr":"Sinemaya kim geliyor? – Ben varım!"}]},
  {"id":"de-daily-nicht-wahr","languageId":"de","category":"daily","level":"B1","sourceText":"…, nicht wahr?","translations":{"tr":["…, değil mi?"]},"details":{"register":"neutral","context":"Onay isterken; \"oder?\"dan daha kibar ve resmî."},"examples":[{"text":"Das Wetter ist schön, nicht wahr?","tr":"Hava güzel, değil mi?"}]},
  {"id":"de-daily-gell","languageId":"de","category":"daily","level":"B1","sourceText":"…, gell?","translations":{"tr":["…, değil mi?"]},"details":{"register":"informal","context":"Güney Almanya ve Avusturya'da onay sorusu."},"examples":[{"text":"Du rufst mich an, gell?","tr":"Beni ararsın, değil mi?"}]},
  {"id":"de-daily-ne","languageId":"de","category":"daily","level":"B1","sourceText":"…, ne?","translations":{"tr":["…, di mi?"]},"details":{"register":"informal","context":"Kuzey Almanya'da konuşmada onay sorusu."},"examples":[{"text":"Das war lustig, ne?","tr":"Komikti, di mi?"}]},
  {"id":"de-daily-echt-jetzt","languageId":"de","category":"daily","level":"B1","sourceText":"Echt jetzt?","translations":{"tr":["cidden mi?","şaka mı bu?"]},"details":{"register":"informal","context":"Şaşkınlık ya da hafif sinir bildirirken."},"examples":[{"text":"Der Zug fällt schon wieder aus. – Echt jetzt?","tr":"Tren yine iptal. – Cidden mi?"}]},
  {"id":"de-daily-ernsthaft","languageId":"de","category":"daily","level":"B1","sourceText":"Ernsthaft?","translations":{"tr":["ciddi misin?","cidden mi?"]},"details":{"register":"informal","context":"İnanamadığında."},"examples":[{"text":"Du hast gekündigt? Ernsthaft?","tr":"İstifa mı ettin? Ciddi misin?"}]},
  {"id":"de-daily-das-gibts-doch-nicht","languageId":"de","category":"daily","level":"B1","sourceText":"Das gibt's doch nicht!","translations":{"tr":["olamaz!","inanmıyorum!"]},"details":{"register":"informal","context":"Büyük şaşkınlık ya da öfke anında."},"examples":[{"text":"Mein Fahrrad ist weg! Das gibt's doch nicht!","tr":"Bisikletim yok! İnanmıyorum!"}]},
  {"id":"de-daily-wahnsinn","languageId":"de","category":"daily","level":"B1","sourceText":"Wahnsinn!","translations":{"tr":["inanılmaz!","müthiş!"]},"details":{"register":"informal","context":"Büyük şaşkınlık ya da hayranlıkta."},"examples":[{"text":"Schau mal, die Aussicht! Wahnsinn!","tr":"Şu manzaraya bak! Müthiş!"}]},
  {"id":"de-daily-so-ein-zufall","languageId":"de","category":"daily","level":"B1","sourceText":"So ein Zufall!","translations":{"tr":["ne tesadüf!"]},"details":{"register":"neutral","context":"Beklenmedik karşılaşmalarda."},"examples":[{"text":"Du bist auch hier? So ein Zufall!","tr":"Sen de mi buradasın? Ne tesadüf!"}]},
  {"id":"de-daily-na-so-was","languageId":"de","category":"daily","level":"B1","sourceText":"Na so was!","translations":{"tr":["vay canına!","bak sen!"]},"details":{"register":"informal","context":"Hafif şaşkınlıkta."},"examples":[{"text":"Na so was, das hätte ich nicht gedacht!","tr":"Bak sen, bunu hiç düşünmezdim!"}]},
  {"id":"de-daily-wie-laufts","languageId":"de","category":"daily","level":"B1","sourceText":"Wie läuft's?","translations":{"tr":["işler nasıl gidiyor?"]},"details":{"register":"informal","context":"İş, okul ya da genel durum hakkında rahat soru."},"examples":[{"text":"Wie läuft's im neuen Job?","tr":"Yeni işte işler nasıl gidiyor?"}]},
  {"id":"de-daily-was-machst-du-so","languageId":"de","category":"daily","level":"B1","sourceText":"Was machst du so?","translations":{"tr":["neler yapıyorsun?","ne iş yapıyorsun?"]},"details":{"register":"informal","context":"Sohbette kişinin hayatını ya da işini sorarken."},"examples":[{"text":"Und, was machst du so beruflich?","tr":"Peki, ne iş yapıyorsun?"}]},
  {"id":"de-daily-passt-dir-das","languageId":"de","category":"daily","level":"B1","sourceText":"Passt dir das?","translations":{"tr":["sana uyar mı?"]},"details":{"register":"informal","context":"Zaman ya da plan önerirken."},"examples":[{"text":"Morgen um drei – passt dir das?","tr":"Yarın üçte – sana uyar mı?"}]},
  {"id":"de-daily-das-geht-auf-mich","languageId":"de","category":"daily","level":"B1","sourceText":"Das geht auf mich.","translations":{"tr":["bu benden","ben ödüyorum"]},"details":{"register":"informal","context":"Hesabı üstlenirken."},"examples":[{"text":"Steck dein Geld weg, das geht auf mich.","tr":"Paranı koy, bu benden."}]},
  {"id":"de-daily-ich-bin-dann-mal-weg","languageId":"de","category":"daily","level":"B1","sourceText":"Ich bin dann mal weg.","translations":{"tr":["ben kaçtım","ben çıkıyorum"]},"details":{"register":"informal","context":"Rahat bir şekilde ayrılırken."},"examples":[{"text":"So, ich bin dann mal weg. Tschüss!","tr":"Evet, ben kaçtım. Hoşça kalın!"}]},
  {"id":"de-daily-ich-bin-spat-dran","languageId":"de","category":"daily","level":"B1","sourceText":"Ich bin spät dran.","translations":{"tr":["geç kaldım","geciktim"]},"details":{"register":"informal","context":"Geç kaldığını ya da acele etmesi gerektiğini söylerken."},"examples":[{"text":"Sorry, ich bin spät dran. Ich komme gleich!","tr":"Kusura bakma, geciktim. Hemen geliyorum!"}]},
  {"id":"de-daily-auf-gehts","languageId":"de","category":"daily","level":"B1","sourceText":"Auf geht's!","translations":{"tr":["haydi bakalım!"]},"details":{"register":"informal","context":"Harekete geçmeye çağırırken."},"examples":[{"text":"Die Sonne scheint – auf geht's an den See!","tr":"Güneş açtı – haydi göle!"}]},
  {"id":"de-daily-lass-mich-in-ruhe","languageId":"de","category":"daily","level":"B1","sourceText":"Lass mich in Ruhe!","translations":{"tr":["beni rahat bırak!"]},"details":{"register":"informal","context":"Rahatsız edildiğinde; sert bir ifadedir."},"examples":[{"text":"Lass mich in Ruhe, ich will schlafen!","tr":"Beni rahat bırak, uyumak istiyorum!"}]},
  {"id":"de-daily-mist","languageId":"de","category":"daily","level":"B1","sourceText":"Mist!","translations":{"tr":["kahretsin!","tüh!"]},"details":{"register":"informal","context":"Bir şey ters gittiğinde; hafif ve kabul edilebilir bir küfür."},"examples":[{"text":"Mist! Ich habe den Schlüssel vergessen!","tr":"Tüh! Anahtarı unuttum!"}]},
  {"id":"de-daily-ach-du-meine-gute","languageId":"de","category":"daily","level":"B1","sourceText":"Ach du meine Güte!","translations":{"tr":["aman tanrım!","vay başıma gelenler!"]},"details":{"register":"neutral","context":"Şaşkınlık ya da dehşet anında."},"examples":[{"text":"Ach du meine Güte, was ist denn hier passiert?","tr":"Aman tanrım, burada ne oldu böyle?"}]},
  {"id":"de-daily-hoppla","languageId":"de","category":"daily","level":"B1","sourceText":"Hoppla!","translations":{"tr":["hoppala!"]},"details":{"register":"informal","context":"Küçük bir sakarlıkta ya da tökezleyince."},"examples":[{"text":"Hoppla, fast wäre ich gefallen!","tr":"Hoppala, az kalsın düşüyordum!"}]},
  {"id":"de-daily-igitt","languageId":"de","category":"daily","level":"B1","sourceText":"Igitt!","translations":{"tr":["iğrenç!","ıyy!"]},"details":{"register":"informal","context":"İğrenme bildirirken."},"examples":[{"text":"Igitt, da ist ein Haar in der Suppe!","tr":"Iyy, çorbada saç var!"}]},
  {"id":"de-daily-quatsch","languageId":"de","category":"daily","level":"B1","sourceText":"Quatsch!","translations":{"tr":["saçmalık!","boş laf!"]},"details":{"register":"informal","context":"Bir sözü saçma bulunca."},"examples":[{"text":"Du bist dick? Quatsch!","tr":"Sen mi şişmansın? Saçmalık!"}]},
  {"id":"de-daily-ach-komm","languageId":"de","category":"daily","level":"B1","sourceText":"Ach komm!","translations":{"tr":["hadi canım!","yapma ya!"]},"details":{"register":"informal","context":"İnanmadığında ya da birini ikna etmeye çalışırken."},"examples":[{"text":"Ach komm, das glaubst du doch selbst nicht!","tr":"Hadi canım, buna sen de inanmıyorsun!"}]},
  {"id":"de-daily-weiter-so","languageId":"de","category":"daily","level":"B1","sourceText":"Weiter so!","translations":{"tr":["böyle devam!"]},"details":{"register":"neutral","context":"Birini teşvik ederken."},"examples":[{"text":"Deine Noten sind besser geworden. Weiter so!","tr":"Notların iyileşmiş. Böyle devam!"}]},
  {"id":"de-daily-respekt","languageId":"de","category":"daily","level":"B1","sourceText":"Respekt!","translations":{"tr":["helal olsun!","tebrikler!"]},"details":{"register":"informal","context":"Takdir bildirirken."},"examples":[{"text":"Du bist den Marathon gelaufen? Respekt!","tr":"Maraton mu koştun? Helal olsun!"}]},
  {"id":"de-daily-ich-drucke-dir-die-daumen","languageId":"de","category":"daily","level":"B1","sourceText":"Ich drücke dir die Daumen!","translations":{"tr":["sana şans diliyorum!"]},"details":{"register":"neutral","context":"Sınav, mülakat gibi durumlardan önce; başparmaklar avuç içine kapatılır."},"examples":[{"text":"Morgen ist deine Prüfung? Ich drücke dir die Daumen!","tr":"Yarın sınavın mı var? Sana şans diliyorum!"}]},
  {"id":"de-daily-erhol-dich-gut","languageId":"de","category":"daily","level":"B1","sourceText":"Erhol dich gut!","translations":{"tr":["iyi dinlen!"]},"details":{"register":"informal","context":"Tatile çıkan ya da hasta olan birine."},"examples":[{"text":"Bleib im Bett und erhol dich gut!","tr":"Yatakta kal ve iyi dinlen!"}]},
  {"id":"de-daily-melde-dich","languageId":"de","category":"daily","level":"B1","sourceText":"Melde dich!","translations":{"tr":["haber ver!","ara beni!"]},"details":{"register":"informal","context":"Vedalaşırken haberleşmeyi isterken."},"examples":[{"text":"Melde dich, wenn du in Berlin bist!","tr":"Berlin'e gelince haber ver!"}]},
  {"id":"de-daily-sie-haben-sich-verwahlt","languageId":"de","category":"daily","level":"B1","sourceText":"Sie haben sich verwählt.","translations":{"tr":["yanlış numara çevirdiniz"]},"details":{"register":"formal","context":"Telefonda yanlış numara arandığında."},"examples":[{"text":"Hier gibt es keinen Herrn Klein. Sie haben sich verwählt.","tr":"Burada Bay Klein yok. Yanlış numara çevirdiniz."}]},
  {"id":"de-daily-das-ist-lieb-von-dir","languageId":"de","category":"daily","level":"B1","sourceText":"Das ist lieb von dir.","translations":{"tr":["çok tatlısın","ne incesin"]},"details":{"register":"informal","context":"Yakınların bir jestine teşekkür ederken."},"examples":[{"text":"Du hast an meinen Geburtstag gedacht? Das ist lieb von dir!","tr":"Doğum günümü hatırladın mı? Çok tatlısın!"}]}
]
