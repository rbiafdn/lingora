[
  {"id":"de-daily-moin","languageId":"de","category":"daily","level":"A2","sourceText":"Moin!","translations":{"tr":["merhaba!","selam!"]},"details":{"register":"informal","context":"Kuzey Almanya'da günün her saatinde selam."},"examples":[{"text":"Moin! Alles gut bei dir?","tr":"Selam! Senin için her şey yolunda mı?"}]},
  {"id":"de-daily-servus","languageId":"de","category":"daily","level":"A2","sourceText":"Servus!","translations":{"tr":["selam!","hoşça kal!"]},"details":{"register":"informal","context":"Bavyera ve Avusturya'da hem selam hem veda."},"examples":[{"text":"Servus, Andi! Lange nicht gesehen!","tr":"Selam Andi! Uzun zamandır görüşemedik!"}]},
  {"id":"de-daily-gruss-gott","languageId":"de","category":"daily","level":"A2","sourceText":"Grüß Gott!","translations":{"tr":["merhaba!","iyi günler!"]},"details":{"register":"neutral","context":"Güney Almanya ve Avusturya'da selamlaşma."},"examples":[{"text":"Grüß Gott! Was darf ich Ihnen bringen?","tr":"İyi günler! Size ne getirebilirim?"}]},
  {"id":"de-daily-gruss-dich","languageId":"de","category":"daily","level":"A2","sourceText":"Grüß dich!","translations":{"tr":["selam!"]},"details":{"register":"informal","context":"Tanıdık birini selamlarken."},"examples":[{"text":"Grüß dich, Peter! Wie geht's?","tr":"Selam Peter! Nasılsın?"}]},
  {"id":"de-daily-na","languageId":"de","category":"daily","level":"A2","sourceText":"Na?","translations":{"tr":["ee, n'aber?","naber?"]},"details":{"register":"informal","context":"Arkadaşlar arasında kısa selam ya da \"nasıl gidiyor?\" sorusu."},"examples":[{"text":"Na? Alles klar bei dir?","tr":"N'aber? Her şey yolunda mı?"}]},
  {"id":"de-daily-na-wie-gehts","languageId":"de","category":"daily","level":"A2","sourceText":"Na, wie geht's?","translations":{"tr":["ee, nasılsın?"]},"details":{"register":"informal","context":"Tanıdığa samimi selam."},"examples":[{"text":"Hey Tom! Na, wie geht's?","tr":"Hey Tom! Ee, nasılsın?"}]},
  {"id":"de-daily-es-geht","languageId":"de","category":"daily","level":"A2","sourceText":"Es geht.","translations":{"tr":["idare eder","şöyle böyle"]},"details":{"register":"neutral","context":"Ne iyi ne kötü olduğunu belirtirken."},"examples":[{"text":"Wie geht's dir? – Es geht.","tr":"Nasılsın? – İdare eder."}]},
  {"id":"de-daily-auf-wiederhoren","languageId":"de","category":"daily","level":"A2","sourceText":"Auf Wiederhören!","translations":{"tr":["hoşça kalın!"]},"details":{"register":"formal","context":"Telefonda resmî vedalaşma."},"examples":[{"text":"Danke für Ihren Anruf. Auf Wiederhören!","tr":"Aradığınız için teşekkürler. Hoşça kalın!"}]},
  {"id":"de-daily-machs-gut","languageId":"de","category":"daily","level":"A2","sourceText":"Mach's gut!","translations":{"tr":["kendine iyi bak!","hoşça kal!"]},"details":{"register":"informal","context":"Samimi vedalaşmada."},"examples":[{"text":"Tschüss, mach's gut!","tr":"Hoşça kal, kendine iyi bak!"}]},
  {"id":"de-daily-pass-auf-dich-auf","languageId":"de","category":"daily","level":"A2","sourceText":"Pass auf dich auf!","translations":{"tr":["kendine dikkat et!"]},"details":{"register":"informal","context":"Sevdiğin biriyle vedalaşırken."},"examples":[{"text":"Gute Reise und pass auf dich auf!","tr":"İyi yolculuklar, kendine dikkat et!"}]},
  {"id":"de-daily-wir-sehen-uns","languageId":"de","category":"daily","level":"A2","sourceText":"Wir sehen uns!","translations":{"tr":["görüşürüz!"]},"details":{"register":"informal","context":"Tekrar görüşeceğinden emin olarak vedalaşırken."},"examples":[{"text":"Okay, wir sehen uns am Montag!","tr":"Tamam, pazartesi görüşürüz!"}]},
  {"id":"de-daily-schonen-feierabend","languageId":"de","category":"daily","level":"A2","sourceText":"Schönen Feierabend!","translations":{"tr":["iyi akşamlar!","işin bittiyse iyi dinlenmeler!"]},"details":{"register":"neutral","context":"İş günü sonunda iş yerinden ayrılırken."},"examples":[{"text":"Ich gehe jetzt. Schönen Feierabend! – Danke, dir auch!","tr":"Ben çıkıyorum. İyi akşamlar! – Sağ ol, sana da!"}]},
  {"id":"de-daily-zum-wohl","languageId":"de","category":"daily","level":"A2","sourceText":"Zum Wohl!","translations":{"tr":["şerefe!","sağlığınıza!"]},"details":{"register":"formal","context":"Daha resmî kadeh kaldırma, özellikle şarapla."},"examples":[{"text":"Auf unser Treffen! Zum Wohl!","tr":"Buluşmamıza! Sağlığınıza!"}]},
  {"id":"de-daily-danke-gleichfalls","languageId":"de","category":"daily","level":"A2","sourceText":"Danke, gleichfalls!","translations":{"tr":["teşekkürler, size de!"]},"details":{"register":"neutral","context":"Biri sana iyi dilekte bulununca aynısını geri dilerken."},"examples":[{"text":"Schönes Wochenende! – Danke, gleichfalls!","tr":"İyi hafta sonları! – Teşekkürler, size de!"}]},
  {"id":"de-daily-darf-ich-vorstellen","languageId":"de","category":"daily","level":"A2","sourceText":"Darf ich vorstellen?","translations":{"tr":["tanıştırayım"]},"details":{"register":"neutral","context":"Birini başkasıyla tanıştırırken."},"examples":[{"text":"Darf ich vorstellen? Das ist meine Frau, Sabine.","tr":"Tanıştırayım, bu eşim Sabine."}]},
  {"id":"de-daily-herein","languageId":"de","category":"daily","level":"A2","sourceText":"Herein!","translations":{"tr":["girin!"]},"details":{"register":"neutral","context":"Kapı çalınınca içeriden seslenilir."},"examples":[{"text":"*klopf klopf* – Herein!","tr":"*tak tak* – Girin!"}]},
  {"id":"de-daily-nehmen-sie-platz","languageId":"de","category":"daily","level":"A2","sourceText":"Nehmen Sie Platz!","translations":{"tr":["buyurun, oturun!"]},"details":{"register":"formal","context":"Resmî ortamda birine yer gösterirken."},"examples":[{"text":"Guten Tag, nehmen Sie bitte Platz.","tr":"İyi günler, buyurun oturun lütfen."}]},
  {"id":"de-daily-bitte-sehr","languageId":"de","category":"daily","level":"A2","sourceText":"Bitte sehr!","translations":{"tr":["buyurun!","rica ederim!"]},"details":{"register":"neutral","context":"Bir şey verirken ya da teşekküre karşılık; \"Bitte schön\" ile aynı."},"examples":[{"text":"Ihr Kaffee, bitte sehr!","tr":"Kahveniz, buyurun!"}]},
  {"id":"de-daily-sorry","languageId":"de","category":"daily","level":"A2","sourceText":"Sorry!","translations":{"tr":["pardon!","kusura bakma!"]},"details":{"register":"informal","context":"Arkadaşlar arasında küçük özürlerde."},"examples":[{"text":"Sorry, ich bin zu spät!","tr":"Kusura bakma, geç kaldım!"}]},
  {"id":"de-daily-schon-gut","languageId":"de","category":"daily","level":"A2","sourceText":"Schon gut.","translations":{"tr":["tamam, önemli değil","geçti gitti"]},"details":{"register":"neutral","context":"Özre karşılık verirken ya da konuyu kapatırken."},"examples":[{"text":"Es tut mir leid! – Schon gut.","tr":"Özür dilerim! – Tamam, önemli değil."}]},
  {"id":"de-daily-nicht-schlimm","languageId":"de","category":"daily","level":"A2","sourceText":"Nicht schlimm!","translations":{"tr":["önemli değil!","dert etme!"]},"details":{"register":"neutral","context":"Özür dileyeni rahatlatırken."},"examples":[{"text":"Ich habe dein Glas kaputt gemacht. – Nicht schlimm!","tr":"Bardağını kırdım. – Önemli değil!"}]},
  {"id":"de-daily-keine-sorge","languageId":"de","category":"daily","level":"A2","sourceText":"Keine Sorge!","translations":{"tr":["merak etme!","endişelenme!"]},"details":{"register":"neutral","context":"Birini rahatlatırken."},"examples":[{"text":"Keine Sorge, ich mache das schon.","tr":"Merak etme, ben hallederim."}]},
  {"id":"de-daily-mach-dir-keine-sorgen","languageId":"de","category":"daily","level":"A2","sourceText":"Mach dir keine Sorgen!","translations":{"tr":["hiç dert etme!","endişelenme!"]},"details":{"register":"informal","context":"Endişeli birini rahatlatırken."},"examples":[{"text":"Mach dir keine Sorgen, alles wird gut.","tr":"Endişelenme, her şey yoluna girecek."}]},
  {"id":"de-daily-na-klar","languageId":"de","category":"daily","level":"A2","sourceText":"Na klar!","translations":{"tr":["tabii!","elbette!"]},"details":{"register":"informal","context":"Bir isteğe hevesle evet derken."},"examples":[{"text":"Kommst du mit? – Na klar!","tr":"Geliyor musun? – Tabii!"}]},
  {"id":"de-daily-klingt-gut","languageId":"de","category":"daily","level":"A2","sourceText":"Klingt gut!","translations":{"tr":["kulağa hoş geliyor!","olur!"]},"details":{"register":"informal","context":"Bir planı onaylarken."},"examples":[{"text":"Wir könnten am Samstag grillen. – Klingt gut!","tr":"Cumartesi mangal yapabiliriz. – Olur, güzel!"}]},
  {"id":"de-daily-na-gut","languageId":"de","category":"daily","level":"A2","sourceText":"Na gut.","translations":{"tr":["peki","tamam o zaman"]},"details":{"register":"informal","context":"İsteksizce ya da ikna olarak kabul ederken."},"examples":[{"text":"Bitte, nur noch zehn Minuten! – Na gut.","tr":"Lütfen, sadece on dakika daha! – Peki."}]},
  {"id":"de-daily-wie-du-willst","languageId":"de","category":"daily","level":"A2","sourceText":"Wie du willst.","translations":{"tr":["nasıl istersen"]},"details":{"register":"informal","context":"Kararı karşı tarafa bırakırken; resmîsi \"Wie Sie wollen\"."},"examples":[{"text":"Gehen wir zu Fuß oder fahren wir? – Wie du willst.","tr":"Yürüyelim mi, arabayla mı gidelim? – Nasıl istersen."}]},
  {"id":"de-daily-egal","languageId":"de","category":"daily","level":"A2","sourceText":"Egal.","translations":{"tr":["fark etmez","boş ver"]},"details":{"register":"informal","context":"Seçimin önemli olmadığını söylerken; ton sertse kaba olabilir."},"examples":[{"text":"Rot oder blau? – Egal.","tr":"Kırmızı mı mavi mi? – Fark etmez."}]},
  {"id":"de-daily-mal-sehen","languageId":"de","category":"daily","level":"A2","sourceText":"Mal sehen.","translations":{"tr":["bakalım","göreceğiz"]},"details":{"register":"informal","context":"Karar vermeyi erteleyip belirsiz kalırken."},"examples":[{"text":"Kommst du morgen? – Mal sehen.","tr":"Yarın geliyor musun? – Bakalım."}]},
  {"id":"de-daily-mir-auch","languageId":"de","category":"daily","level":"A2","sourceText":"Mir auch.","translations":{"tr":["bana da","ben de"]},"details":{"register":"neutral","context":"Datifli cümlelere katılırken (Mir ist kalt / Mir gefällt …)."},"examples":[{"text":"Mir ist kalt. – Mir auch.","tr":"Üşüyorum. – Ben de."}]},
  {"id":"de-daily-oder","languageId":"de","category":"daily","level":"A2","sourceText":"…, oder?","translations":{"tr":["…, değil mi?"]},"details":{"register":"neutral","context":"Cümle sonunda onay isterken."},"examples":[{"text":"Du kommst morgen, oder?","tr":"Yarın geliyorsun, değil mi?"}]},
  {"id":"de-daily-echt","languageId":"de","category":"daily","level":"A2","sourceText":"Echt?","translations":{"tr":["gerçekten mi?","sahi mi?"]},"details":{"register":"informal","context":"Şaşırınca."},"examples":[{"text":"Ich habe im Lotto gewonnen! – Echt?","tr":"Lotoda kazandım! – Sahi mi?"}]},
  {"id":"de-daily-unglaublich","languageId":"de","category":"daily","level":"A2","sourceText":"Unglaublich!","translations":{"tr":["inanılmaz!"]},"details":{"register":"neutral","context":"Hayret ya da hayranlık bildirirken."},"examples":[{"text":"Er ist 90 und läuft noch Marathon. Unglaublich!","tr":"90 yaşında ve hâlâ maraton koşuyor. İnanılmaz!"}]},
  {"id":"de-daily-lange-nicht-gesehen","languageId":"de","category":"daily","level":"A2","sourceText":"Lange nicht gesehen!","translations":{"tr":["görüşmeyeli uzun zaman oldu!"]},"details":{"register":"informal","context":"Uzun süre sonra karşılaşınca."},"examples":[{"text":"Hallo Mia! Lange nicht gesehen!","tr":"Merhaba Mia! Görüşmeyeli uzun zaman oldu!"}]},
  {"id":"de-daily-schon-dich-zu-sehen","languageId":"de","category":"daily","level":"A2","sourceText":"Schön, dich zu sehen!","translations":{"tr":["seni görmek ne güzel!"]},"details":{"register":"informal","context":"Bir tanıdıkla karşılaşınca; resmîsi \"Schön, Sie zu sehen\"."},"examples":[{"text":"Hey! Schön, dich zu sehen!","tr":"Hey! Seni görmek ne güzel!"}]},
  {"id":"de-daily-was-gibts-neues","languageId":"de","category":"daily","level":"A2","sourceText":"Was gibt's Neues?","translations":{"tr":["ne var ne yok?","yeni ne var?"]},"details":{"register":"informal","context":"Tanıdıkla sohbet açarken."},"examples":[{"text":"Hallo Sara! Was gibt's Neues?","tr":"Merhaba Sara! Ne var ne yok?"}]},
  {"id":"de-daily-wie-wars","languageId":"de","category":"daily","level":"A2","sourceText":"Wie war's?","translations":{"tr":["nasıldı?"]},"details":{"register":"informal","context":"Bir etkinlik ya da gezi sonrası sorulur."},"examples":[{"text":"Du warst im Konzert? Wie war's?","tr":"Konserde miydin? Nasıldı?"}]},
  {"id":"de-daily-ich-lade-dich-ein","languageId":"de","category":"daily","level":"A2","sourceText":"Ich lade dich ein.","translations":{"tr":["benden","seni davet ediyorum"]},"details":{"register":"neutral","context":"Hesabı ödemeyi teklif ederken."},"examples":[{"text":"Lass mal, heute lade ich dich ein.","tr":"Bırak, bugün benden."}]},
  {"id":"de-daily-besetzt","languageId":"de","category":"daily","level":"A2","sourceText":"Besetzt.","translations":{"tr":["dolu"]},"details":{"register":"neutral","context":"Yer ya da tuvalet dolu olduğunda."},"examples":[{"text":"Ist der Platz frei? – Nein, leider besetzt.","tr":"Yer boş mu? – Hayır, maalesef dolu."}]},
  {"id":"de-daily-ich-schaue-nur","languageId":"de","category":"daily","level":"A2","sourceText":"Ich schaue nur.","translations":{"tr":["sadece bakıyorum"]},"details":{"register":"neutral","context":"Mağazada satıcının yardım teklifine cevap."},"examples":[{"text":"Kann ich Ihnen helfen? – Danke, ich schaue nur.","tr":"Yardımcı olabilir miyim? – Teşekkürler, sadece bakıyorum."}]},
  {"id":"de-daily-bar-oder-mit-karte","languageId":"de","category":"daily","level":"A2","sourceText":"Bar oder mit Karte?","translations":{"tr":["nakit mi kartla mı?"]},"details":{"register":"neutral","context":"Kasada ödeme şekli sorulur."},"examples":[{"text":"Das macht 12 Euro. Bar oder mit Karte?","tr":"12 euro ediyor. Nakit mi kartla mı?"}]},
  {"id":"de-daily-brauchen-sie-eine-tute","languageId":"de","category":"daily","level":"A2","sourceText":"Brauchen Sie eine Tüte?","translations":{"tr":["poşet ister misiniz?"]},"details":{"register":"neutral","context":"Kasada sorulur; poşetler genelde ücretlidir."},"examples":[{"text":"Brauchen Sie eine Tüte? – Nein, danke.","tr":"Poşet ister misiniz? – Hayır, teşekkürler."}]},
  {"id":"de-daily-der-nachste-bitte","languageId":"de","category":"daily","level":"A2","sourceText":"Der Nächste, bitte!","translations":{"tr":["sıradaki lütfen!"]},"details":{"register":"neutral","context":"Kasa veya gişede sıradakini çağırırken."},"examples":[{"text":"Der Nächste, bitte! Was bekommen Sie?","tr":"Sıradaki lütfen! Ne alırsınız?"}]},
  {"id":"de-daily-wer-ist-dran","languageId":"de","category":"daily","level":"A2","sourceText":"Wer ist dran?","translations":{"tr":["sıra kimde?"]},"details":{"register":"neutral","context":"Fırın veya tezgâhta sırayı sorarken."},"examples":[{"text":"Wer ist jetzt dran? – Ich, glaube ich.","tr":"Şimdi sıra kimde? – Sanırım bende."}]},
  {"id":"de-daily-mir-ist-langweilig","languageId":"de","category":"daily","level":"A2","sourceText":"Mir ist langweilig.","translations":{"tr":["canım sıkılıyor"]},"details":{"register":"neutral","context":"Sıkıldığını söylerken; \"Ich bin langweilig\" = \"Ben sıkıcıyım\" demektir!"},"examples":[{"text":"Mir ist langweilig. Was können wir machen?","tr":"Canım sıkılıyor. Ne yapabiliriz?"}]},
  {"id":"de-daily-mir-ist-schlecht","languageId":"de","category":"daily","level":"A2","sourceText":"Mir ist schlecht.","translations":{"tr":["midem bulanıyor","kendimi kötü hissediyorum"]},"details":{"register":"neutral","context":"Fiziksel olarak kötü hissederken."},"examples":[{"text":"Mir ist schlecht, ich glaube, das Essen war nicht gut.","tr":"Midem bulanıyor, sanırım yemek iyi değildi."}]},
  {"id":"de-daily-ich-muss-los","languageId":"de","category":"daily","level":"A2","sourceText":"Ich muss los.","translations":{"tr":["gitmem lazım","kaçmam lazım"]},"details":{"register":"informal","context":"Ayrılma vaktinin geldiğini söylerken."},"examples":[{"text":"Oh, schon so spät! Ich muss los.","tr":"Ah, saat çok geç olmuş! Gitmem lazım."}]},
  {"id":"de-daily-bin-gleich-wieder-da","languageId":"de","category":"daily","level":"A2","sourceText":"Bin gleich wieder da.","translations":{"tr":["hemen dönerim"]},"details":{"register":"informal","context":"Kısa süreliğine ayrılırken."},"examples":[{"text":"Ich hole nur schnell Brot. Bin gleich wieder da!","tr":"Hızlıca ekmek alıyorum. Hemen dönerim!"}]},
  {"id":"de-daily-ich-bin-unterwegs","languageId":"de","category":"daily","level":"A2","sourceText":"Ich bin unterwegs.","translations":{"tr":["yoldayım","geliyorum"]},"details":{"register":"neutral","context":"Buluşmaya giderken mesaj ya da telefonda."},"examples":[{"text":"Wo bist du? – Ich bin unterwegs, in zehn Minuten bin ich da.","tr":"Neredesin? – Yoldayım, on dakikaya oradayım."}]},
  {"id":"de-daily-moment-mal","languageId":"de","category":"daily","level":"A2","sourceText":"Moment mal!","translations":{"tr":["bir dakika!","dur bakalım!"]},"details":{"register":"informal","context":"Birini durdurmak ya da itiraz etmek için."},"examples":[{"text":"Moment mal, das ist mein Platz!","tr":"Bir dakika, orası benim yerim!"}]},
  {"id":"de-daily-warte-mal","languageId":"de","category":"daily","level":"A2","sourceText":"Warte mal!","translations":{"tr":["bekle!","dur bir!"]},"details":{"register":"informal","context":"Birinin durmasını isterken."},"examples":[{"text":"Warte mal, ich komme mit!","tr":"Dur bir, ben de geliyorum!"}]},
  {"id":"de-daily-beeil-dich","languageId":"de","category":"daily","level":"A2","sourceText":"Beeil dich!","translations":{"tr":["acele et!"]},"details":{"register":"informal","context":"Birini aceleye getirirken; çoğulu \"Beeilt euch!\""},"examples":[{"text":"Beeil dich, der Bus kommt!","tr":"Acele et, otobüs geliyor!"}]},
  {"id":"de-daily-komm-schon","languageId":"de","category":"daily","level":"A2","sourceText":"Komm schon!","translations":{"tr":["hadi ama!","haydi!"]},"details":{"register":"informal","context":"Birini ikna etmeye ya da cesaretlendirmeye çalışırken."},"examples":[{"text":"Komm schon, nur ein Stück Kuchen!","tr":"Hadi ama, sadece bir dilim pasta!"}]},
  {"id":"de-daily-los-gehts","languageId":"de","category":"daily","level":"A2","sourceText":"Los geht's!","translations":{"tr":["hadi başlayalım!","haydi gidelim!"]},"details":{"register":"informal","context":"Bir işe ya da yola başlarken."},"examples":[{"text":"Alle da? Los geht's!","tr":"Herkes burada mı? Hadi başlayalım!"}]},
  {"id":"de-daily-hor-auf","languageId":"de","category":"daily","level":"A2","sourceText":"Hör auf!","translations":{"tr":["kes!","yeter!"]},"details":{"register":"informal","context":"Birinin bir şeyi bırakmasını isterken."},"examples":[{"text":"Hör auf damit, das nervt!","tr":"Kes şunu, sinir bozucu!"}]},
  {"id":"de-daily-lass-das","languageId":"de","category":"daily","level":"A2","sourceText":"Lass das!","translations":{"tr":["bırak onu!","yapma!"]},"details":{"register":"informal","context":"Birinin bir şeyi yapmasını engellerken."},"examples":[{"text":"Lass das, das ist gefährlich!","tr":"Yapma, tehlikeli!"}]},
  {"id":"de-daily-wie-schade","languageId":"de","category":"daily","level":"A2","sourceText":"Wie schade!","translations":{"tr":["ne yazık!","çok yazık!"]},"details":{"register":"neutral","context":"Üzüntü bildirirken."},"examples":[{"text":"Das Konzert fällt aus. – Wie schade!","tr":"Konser iptal. – Çok yazık!"}]},
  {"id":"de-daily-oje","languageId":"de","category":"daily","level":"A2","sourceText":"Oje!","translations":{"tr":["eyvah!","vah vah!"]},"details":{"register":"informal","context":"Kötü bir habere tepki."},"examples":[{"text":"Ich habe mir das Bein gebrochen. – Oje!","tr":"Bacağımı kırdım. – Vah vah!"}]},
  {"id":"de-daily-oh-mein-gott","languageId":"de","category":"daily","level":"A2","sourceText":"Oh mein Gott!","translations":{"tr":["aman tanrım!"]},"details":{"register":"informal","context":"Büyük şaşkınlıkta."},"examples":[{"text":"Oh mein Gott, ist das schön!","tr":"Aman tanrım, ne kadar güzel!"}]},
  {"id":"de-daily-gott-sei-dank","languageId":"de","category":"daily","level":"A2","sourceText":"Gott sei Dank!","translations":{"tr":["çok şükür!","Allah'a şükür!"]},"details":{"register":"neutral","context":"Rahatlama anında."},"examples":[{"text":"Gott sei Dank, du bist gesund!","tr":"Çok şükür, sağlıklısın!"}]},
  {"id":"de-daily-klasse","languageId":"de","category":"daily","level":"A2","sourceText":"Klasse!","translations":{"tr":["harika!","süper!"]},"details":{"register":"informal","context":"Beğeni bildirirken."},"examples":[{"text":"Wir fahren ans Meer! – Klasse!","tr":"Denize gidiyoruz! – Süper!"}]},
  {"id":"de-daily-prima","languageId":"de","category":"daily","level":"A2","sourceText":"Prima!","translations":{"tr":["mükemmel!","çok iyi!"]},"details":{"register":"informal","context":"Memnuniyet bildirirken; biraz eski moda ama yaygın."},"examples":[{"text":"Alles fertig? Prima!","tr":"Her şey hazır mı? Çok iyi!"}]},
  {"id":"de-daily-gut-gemacht","languageId":"de","category":"daily","level":"A2","sourceText":"Gut gemacht!","translations":{"tr":["aferin!","iyi iş çıkardın!"]},"details":{"register":"neutral","context":"Birini övmek için."},"examples":[{"text":"Du hast die Prüfung bestanden? Gut gemacht!","tr":"Sınavı geçtin mi? Aferin!"}]},
  {"id":"de-daily-guten-rutsch","languageId":"de","category":"daily","level":"A2","sourceText":"Guten Rutsch!","translations":{"tr":["iyi yıllar!","yeni yıla iyi girişler!"]},"details":{"register":"neutral","context":"Yılbaşından önceki günlerde."},"examples":[{"text":"Bis nächstes Jahr und guten Rutsch!","tr":"Seneye görüşürüz, yeni yıla iyi girişler!"}]},
  {"id":"de-daily-frohe-ostern","languageId":"de","category":"daily","level":"A2","sourceText":"Frohe Ostern!","translations":{"tr":["mutlu Paskalyalar!"]},"details":{"register":"neutral","context":"Paskalya bayramında."},"examples":[{"text":"Frohe Ostern an die ganze Familie!","tr":"Bütün aileye mutlu Paskalyalar!"}]},
  {"id":"de-daily-schone-feiertage","languageId":"de","category":"daily","level":"A2","sourceText":"Schöne Feiertage!","translations":{"tr":["iyi bayramlar!","iyi tatiller!"]},"details":{"register":"neutral","context":"Resmî tatil ve bayramlardan önce vedalaşırken."},"examples":[{"text":"Schöne Feiertage und erholt euch gut!","tr":"İyi bayramlar, iyi dinlenin!"}]},
  {"id":"de-daily-gute-fahrt","languageId":"de","category":"daily","level":"A2","sourceText":"Gute Fahrt!","translations":{"tr":["iyi yolculuklar!"]},"details":{"register":"neutral","context":"Arabayla ya da trenle yola çıkan birine."},"examples":[{"text":"Gute Fahrt und ruf an, wenn du da bist!","tr":"İyi yolculuklar, varınca ara!"}]},
  {"id":"de-daily-komm-gut-nach-hause","languageId":"de","category":"daily","level":"A2","sourceText":"Komm gut nach Hause!","translations":{"tr":["eve sağ salim git!"]},"details":{"register":"informal","context":"Akşam ayrılan bir misafire."},"examples":[{"text":"Danke für den schönen Abend! – Komm gut nach Hause!","tr":"Güzel akşam için teşekkürler! – Eve sağ salim git!"}]},
  {"id":"de-daily-traum-was-schones","languageId":"de","category":"daily","level":"A2","sourceText":"Träum was Schönes!","translations":{"tr":["tatlı rüyalar!"]},"details":{"register":"informal","context":"Özellikle çocuklara ve sevgiliye, yatmadan önce."},"examples":[{"text":"Gute Nacht, mein Schatz. Träum was Schönes!","tr":"İyi geceler, canım. Tatlı rüyalar!"}]},
  {"id":"de-daily-grusse-an","languageId":"de","category":"daily","level":"A2","sourceText":"Grüße an …","translations":{"tr":["…a selam söyle"]},"details":{"register":"neutral","context":"Vedalaşırken birine selam iletmek için; uzun hâli \"Schöne Grüße an …\"."},"examples":[{"text":"Tschüss und schöne Grüße an deine Eltern!","tr":"Hoşça kal, annenle babana selam söyle!"}]},
  {"id":"de-daily-hier-ist","languageId":"de","category":"daily","level":"A2","sourceText":"Hier ist …","translations":{"tr":["ben …","… arıyor"]},"details":{"register":"neutral","context":"Telefonda kendini tanıtırken."},"examples":[{"text":"Hallo, hier ist Ayşe. Ist Martin da?","tr":"Merhaba, ben Ayşe. Martin orada mı?"}]},
  {"id":"de-daily-wer-spricht-da","languageId":"de","category":"daily","level":"A2","sourceText":"Wer spricht da?","translations":{"tr":["kiminle görüşüyorum?","kim o?"]},"details":{"register":"neutral","context":"Telefonda arayanı sorarken."},"examples":[{"text":"Hallo? Wer spricht da, bitte?","tr":"Alo? Kiminle görüşüyorum lütfen?"}]},
  {"id":"de-daily-ich-rufe-zuruck","languageId":"de","category":"daily","level":"A2","sourceText":"Ich rufe zurück.","translations":{"tr":["seni geri ararım"]},"details":{"register":"neutral","context":"Telefonda konuşamayacak durumdayken."},"examples":[{"text":"Ich bin gerade im Zug. Ich rufe dich später zurück.","tr":"Şu an trendeyim. Seni sonra geri ararım."}]},
  {"id":"de-daily-ich-vermisse-dich","languageId":"de","category":"daily","level":"A2","sourceText":"Ich vermisse dich.","translations":{"tr":["seni özledim"]},"details":{"register":"informal","context":"Sevdiklerine."},"examples":[{"text":"Wann kommst du zurück? Ich vermisse dich.","tr":"Ne zaman dönüyorsun? Seni özledim."}]},
  {"id":"de-daily-hab-dich-lieb","languageId":"de","category":"daily","level":"A2","sourceText":"Hab dich lieb!","translations":{"tr":["seni seviyorum!"]},"details":{"register":"informal","context":"Aile ve yakın arkadaşlara sevgi ifadesi; \"Ich liebe dich\"ten daha hafif."},"examples":[{"text":"Gute Nacht, Mama! Hab dich lieb!","tr":"İyi geceler anne! Seni seviyorum!"}]},
  {"id":"de-daily-das-ist-nett-von-dir","languageId":"de","category":"daily","level":"A2","sourceText":"Das ist nett von dir.","translations":{"tr":["çok naziksin"]},"details":{"register":"neutral","context":"Bir iyiliğe teşekkür ederken; resmîsi \"von Ihnen\"."},"examples":[{"text":"Ich habe dir Kaffee mitgebracht. – Das ist nett von dir!","tr":"Sana kahve getirdim. – Çok naziksin!"}]},
  {"id":"de-daily-wie-ist-deine-nummer","languageId":"de","category":"daily","level":"A2","sourceText":"Wie ist deine Nummer?","translations":{"tr":["numaran ne?"]},"details":{"register":"informal","context":"Telefon numarası isterken."},"examples":[{"text":"Wie ist deine Nummer? Ich schreibe dir.","tr":"Numaran ne? Sana yazarım."}]}
]
