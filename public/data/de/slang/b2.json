  {"id":"de-slang-kippe","languageId":"de","category":"slang","level":"B2","sourceText":"Kippe","translations":{"tr":["sigara","izmarit"]},"details":{"usage":"Sigara veya izmarit için.","register":"informal"},"examples":[{"text":"Hast du 'ne Kippe für mich?","tr":"Bana bir sigara var mı?"}]},
