  {"id":"de-slang-vermasseln","languageId":"de","category":"slang","level":"B2","sourceText":"vermasseln","translations":{"tr":["berbat etmek","batırmak"]},"details":{"usage":"Bir işi bozmak.","register":"informal"},"examples":[{"text":"Ich hab die Prüfung vermasselt.","tr":"Sınavı batırdım."}]},
