  {"id":"de-slang-anbaggern","languageId":"de","category":"slang","level":"B2","sourceText":"anbaggern","translations":{"tr":["asılmak","kur yapmak"]},"details":{"usage":"Birine ısrarla yaklaşmak.","register":"slang"},"examples":[{"text":"Er hat sie den ganzen Abend angebaggert.","tr":"Bütün akşam kıza asıldı."}]},
