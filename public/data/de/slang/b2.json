  {"id":"de-slang-vollidiot","languageId":"de","category":"slang","level":"B2","sourceText":"Vollidiot","translations":{"tr":["tam bir aptal","salak"]},"details":{"usage":"Güçlü hakaret.","register":"offensive"},"examples":[{"text":"Welcher Vollidiot parkt hier?","tr":"Hangi salak buraya park ediyor?"}]},
