[
  {"id":"de-slang-machste","languageId":"de","category":"slang","level":"B2","sourceText":"machste","translations":{"tr":["yapıyor musun","ne yapıyorsun"]},"tags":["reduced-form"],"details":{"usage":"Arkadaşlar arasında konuşmada.","register":"informal","expansion":"machst du"},"examples":[{"text":"Was machste heute Abend?","tr":"Bu akşam ne yapıyorsun?"}]},
