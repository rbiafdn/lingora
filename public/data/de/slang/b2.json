  {"id":"de-slang-gluckspilz","languageId":"de","category":"slang","level":"B2","sourceText":"Glückspilz","translations":{"tr":["şanslı kişi"]},"details":{"usage":"Çok şanslı biri için.","register":"informal"},"examples":[{"text":"Du hast schon wieder gewonnen, du Glückspilz!","tr":"Yine kazandın, seni şanslı!"}]},
