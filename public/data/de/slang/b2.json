  {"id":"de-slang-pinkeln","languageId":"de","category":"slang","level":"B2","sourceText":"pinkeln","translations":{"tr":["çiş yapmak"]},"details":{"usage":"Kaba değil ama samimi.","register":"informal"},"examples":[{"text":"Ich muss mal pinkeln.","tr":"Çişim geldi."}]},
