  {"id":"de-slang-dings","languageId":"de","category":"slang","level":"B2","sourceText":"Dings","translations":{"tr":["şey","zımbırtı"]},"details":{"usage":"Adını hatırlamadığın şey veya kişi için; 'Dingsbums' da denir.","register":"informal"},"examples":[{"text":"Gib mir mal das Dings da.","tr":"Şu şeyi bana ver."}]},
  {"id":"de-slang-abzocke","languageId":"de","category":"slang","level":"B2","sourceText":"Abzocke","translations":{"tr":["kazık","soygun"]},"details":{"usage":"Fahiş fiyat için.","register":"informal"},"examples":[{"text":"Zehn Euro für ein Bier? Das ist Abzocke!","tr":"Bir biraya on avro mu? Bu kazık!"}]}
