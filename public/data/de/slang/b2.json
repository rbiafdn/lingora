  {"id":"de-slang-servus","languageId":"de","category":"slang","level":"B2","sourceText":"Servus","translations":{"tr":["selam","hoşça kal"]},"details":{"usage":"Bavyera ve Avusturya'da hem merhaba hem hoşça kal.","register":"informal"},"examples":[{"text":"Servus, bis morgen!","tr":"Hoşça kal, yarın görüşürüz!"}]},
  {"id":"de-slang-abhangen","languageId":"de","category":"slang","level":"B2","sourceText":"abhängen","translations":{"tr":["takılmak","vakit geçirmek"]},"details":{"usage":"Arkadaşlarla boş vakit geçirmek.","register":"informal"},"examples":[{"text":"Wir hängen im Park ab.","tr":"Parkta takılıyoruz."}]},
