[
  {"id":"de-expr-von-zeit-zu-zeit","languageId":"de","category":"expressions","level":"B1","sourceText":"von Zeit zu Zeit","translations":{"tr":["zaman zaman"]},"details":{"register":"neutral"},"examples":[{"text":"Von Zeit zu Zeit rufe ich ihn an.","tr":"Zaman zaman onu ararım."}]},
  {"id":"de-expr-zurzeit","languageId":"de","category":"expressions","level":"B1","sourceText":"zurzeit","translations":{"tr":["şu sıralar","bu aralar"]},"details":{"usage":"Tek kelime yazılır; \"zur Zeit + genitif\" ise \"…döneminde\" demektir.","register":"neutral"},"examples":[{"text":"Zurzeit arbeite ich von zu Hause.","tr":"Bu aralar evden çalışıyorum."}]},
  {"id":"de-expr-jedenfalls","languageId":"de","category":"expressions","level":"B1","sourceText":"jedenfalls","translations":{"tr":["neyse","her neyse","en azından"]},"tags":["discourse-marker"],"details":{"usage":"Konuşmada konuyu toparlarken sık kullanılır.","register":"neutral"},"examples":[{"text":"Jedenfalls hat es am Ende geklappt.","tr":"Her neyse, sonunda işe yaradı."}]},
  {"id":"de-expr-sowieso","languageId":"de","category":"expressions","level":"B1","sourceText":"sowieso","translations":{"tr":["zaten","nasılsa"]},"details":{"register":"neutral"},"examples":[{"text":"Ich muss sowieso in die Stadt.","tr":"Zaten şehre gitmem gerekiyor."}]},
  {"id":"de-expr-daher","languageId":"de","category":"expressions","level":"B1","sourceText":"daher","translations":{"tr":["bu nedenle","dolayısıyla"]},"tags":["connector"],"details":{"register":"neutral"},"examples":[{"text":"Er hat viel geübt, daher spielt er so gut.","tr":"Çok çalıştı, bu nedenle bu kadar iyi çalıyor."}]},
  {"id":"de-expr-schliesslich","languageId":"de","category":"expressions","level":"B1","sourceText":"schließlich","translations":{"tr":["sonuçta","nihayetinde","ne de olsa"]},"tags":["connector"],"details":{"usage":"\"ne de olsa\" anlamında gerekçe bildirir.","register":"neutral"},"examples":[{"text":"Ich helfe ihm, er ist schließlich mein Bruder.","tr":"Ona yardım ediyorum, ne de olsa kardeşim."}]},
  {"id":"de-expr-einerseits-andererseits","languageId":"de","category":"expressions","level":"B1","sourceText":"einerseits … andererseits","translations":{"tr":["bir yandan … öte yandan"]},"tags":["connector"],"details":{"register":"neutral"},"examples":[{"text":"Einerseits will ich reisen, andererseits fehlt mir das Geld.","tr":"Bir yandan seyahat etmek istiyorum, öte yandan param yok."}]},
  {"id":"de-expr-im-gegenteil","languageId":"de","category":"expressions","level":"B1","sourceText":"im Gegenteil","translations":{"tr":["aksine","tam tersine"]},"details":{"register":"neutral"},"examples":[{"text":"Ich bin nicht müde, im Gegenteil!","tr":"Yorgun değilim, tam tersine!"}]},
  {"id":"de-expr-im-gegensatz-zu","languageId":"de","category":"expressions","level":"B1","sourceText":"im Gegensatz zu","translations":{"tr":["…nın aksine","…dan farklı olarak"]},"details":{"usage":"Datif ister: im Gegensatz zu dir.","register":"neutral"},"examples":[{"text":"Im Gegensatz zu mir mag er Sport.","tr":"Benim aksime o sporu sever."}]},
  {"id":"de-expr-selbstverstandlich","languageId":"de","category":"expressions","level":"B1","sourceText":"selbstverständlich","translations":{"tr":["elbette","doğal olarak"]},"details":{"usage":"\"natürlich\"ten daha vurgulu ve kibar.","register":"neutral"},"examples":[{"text":"Selbstverständlich können Sie hier parken.","tr":"Elbette buraya park edebilirsiniz."}]},
  {"id":"de-expr-eben","languageId":"de","category":"expressions","level":"B1","sourceText":"eben","translations":{"tr":["işte","zaten","az önce"]},"tags":["discourse-marker"],"details":{"usage":"Onay: \"Eben!\" = \"İşte!\"; zaman: \"Er war eben hier\" = az önce buradaydı.","register":"neutral"},"examples":[{"text":"Das ist eben so.","tr":"Bu işte böyle."}]},
  {"id":"de-expr-halt","languageId":"de","category":"expressions","level":"B1","sourceText":"halt","translations":{"tr":["işte","ne yapalım"]},"tags":["discourse-marker"],"details":{"usage":"Güney Almanya'da yaygın; değiştirilemeyen durumu vurgular.","register":"informal"},"examples":[{"text":"Dann musst du halt warten.","tr":"O zaman beklemen lazım işte."}]},
  {"id":"de-expr-ja","languageId":"de","category":"expressions","level":"B1","sourceText":"ja","translations":{"tr":["ya","malum","zaten"]},"tags":["discourse-marker"],"details":{"usage":"Cümle içinde bilinen bir şeyi hatırlatır, cevap \"evet\" değildir.","register":"neutral"},"examples":[{"text":"Du weißt ja, wie er ist.","tr":"Biliyorsun ya, nasıl biri olduğunu."}]},
  {"id":"de-expr-schon","languageId":"de","category":"expressions","level":"B1","sourceText":"schon","translations":{"tr":["herhalde","elbet","zaten"]},"tags":["discourse-marker"],"details":{"usage":"Teselli/güven verir: \"Das wird schon!\" = \"Olur, merak etme!\"","register":"neutral"},"examples":[{"text":"Keine Sorge, das klappt schon.","tr":"Merak etme, olur elbet."}]},
  {"id":"de-expr-uberhaupt","languageId":"de","category":"expressions","level":"B1","sourceText":"überhaupt","translations":{"tr":["hiç","zaten","esasen"]},"details":{"usage":"Olumsuzda vurgu: \"überhaupt nicht\" = hiç de değil.","register":"neutral"},"examples":[{"text":"Das stimmt überhaupt nicht!","tr":"Bu hiç de doğru değil!"}]},
  {"id":"de-expr-so-bald-wie-moglich","languageId":"de","category":"expressions","level":"B1","sourceText":"so bald wie möglich","translations":{"tr":["mümkün olan en kısa sürede"]},"details":{"usage":"Resmî yazışmada \"baldmöglichst\" da denir.","register":"neutral"},"examples":[{"text":"Bitte antworten Sie so bald wie möglich.","tr":"Lütfen en kısa sürede cevap verin."}]},
  {"id":"de-expr-so-viel-wie-moglich","languageId":"de","category":"expressions","level":"B1","sourceText":"so viel wie möglich","translations":{"tr":["olabildiğince çok"]},"details":{"register":"neutral"},"examples":[{"text":"Ich versuche, so viel wie möglich zu lernen.","tr":"Olabildiğince çok öğrenmeye çalışıyorum."}]},
  {"id":"de-expr-ich-bin-der-meinung-dass","languageId":"de","category":"expressions","level":"B1","sourceText":"ich bin der Meinung, dass …","translations":{"tr":["…şeklinde düşünüyorum"]},"tags":["opinion"],"details":{"usage":"Tartışma ve yazılı sınavlarda kalıp ifade.","register":"neutral"},"examples":[{"text":"Ich bin der Meinung, dass Rauchen verboten werden sollte.","tr":"Sigaranın yasaklanması gerektiğini düşünüyorum."}]},
  {"id":"de-expr-soviel-ich-weiss","languageId":"de","category":"expressions","level":"B1","sourceText":"soviel ich weiß","translations":{"tr":["bildiğim kadarıyla"]},"details":{"register":"neutral"},"examples":[{"text":"Soviel ich weiß, ist das Geschäft heute zu.","tr":"Bildiğim kadarıyla dükkân bugün kapalı."}]},
  {"id":"de-expr-ich-stimme-zu","languageId":"de","category":"expressions","level":"B1","sourceText":"ich stimme zu","translations":{"tr":["katılıyorum"]},"tags":["opinion"],"details":{"usage":"Kişiye: \"Ich stimme dir zu.\"","register":"neutral"},"examples":[{"text":"Da stimme ich dir völlig zu.","tr":"Bu konuda sana tamamen katılıyorum."}]},
  {"id":"de-expr-das-sehe-ich-anders","languageId":"de","category":"expressions","level":"B1","sourceText":"das sehe ich anders","translations":{"tr":["ben farklı düşünüyorum"]},"tags":["opinion"],"details":{"usage":"Kibarca karşı çıkmanın yolu.","register":"neutral"},"examples":[{"text":"Das sehe ich anders, der Plan ist zu teuer.","tr":"Ben farklı düşünüyorum, plan çok pahalı."}]},
  {"id":"de-expr-es-kommt-darauf-an","languageId":"de","category":"expressions","level":"B1","sourceText":"es kommt darauf an","translations":{"tr":["duruma bağlı","değişir"]},"details":{"usage":"Neye bağlı olduğunu söylemek için: \"Es kommt darauf an, ob …\"","register":"neutral"},"examples":[{"text":"Kommst du mit? – Es kommt darauf an, wann ihr geht.","tr":"Geliyor musun? – Ne zaman gittiğinize bağlı."}]},
  {"id":"de-expr-es-geht-um","languageId":"de","category":"expressions","level":"B1","sourceText":"es geht um","translations":{"tr":["söz konusu olan","konu …"]},"details":{"usage":"Akuzatif ister: Es geht um die Arbeit.","register":"neutral"},"examples":[{"text":"In dem Film geht es um eine Familie.","tr":"Film bir aile hakkında."}]},
  {"id":"de-expr-es-lohnt-sich","languageId":"de","category":"expressions","level":"B1","sourceText":"es lohnt sich","translations":{"tr":["değer","buna değer"]},"details":{"register":"neutral"},"examples":[{"text":"Der Ausflug lohnt sich auf jeden Fall.","tr":"Gezi kesinlikle buna değer."}]},
  {"id":"de-expr-nichts-zu-danken","languageId":"de","category":"expressions","level":"B1","sourceText":"nichts zu danken","translations":{"tr":["teşekküre gerek yok"]},"details":{"register":"neutral"},"examples":[{"text":"Danke! – Nichts zu danken.","tr":"Teşekkürler! – Teşekküre gerek yok."}]},
  {"id":"de-expr-mein-beileid","languageId":"de","category":"expressions","level":"B1","sourceText":"Mein Beileid","translations":{"tr":["başın sağ olsun"]},"details":{"usage":"Daha resmî: Herzliches Beileid.","register":"neutral"},"examples":[{"text":"Ich habe von deinem Vater gehört. Mein Beileid.","tr":"Babanı duydum. Başın sağ olsun."}]},
  {"id":"de-expr-in-der-regel","languageId":"de","category":"expressions","level":"B1","sourceText":"in der Regel","translations":{"tr":["genellikle","kural olarak"]},"details":{"register":"neutral"},"examples":[{"text":"In der Regel stehe ich um sieben Uhr auf.","tr":"Genellikle saat yedide kalkarım."}]},
  {"id":"de-expr-im-allgemeinen","languageId":"de","category":"expressions","level":"B1","sourceText":"im Allgemeinen","translations":{"tr":["genel olarak"]},"details":{"register":"neutral"},"examples":[{"text":"Im Allgemeinen bin ich zufrieden.","tr":"Genel olarak memnunum."}]},
  {"id":"de-expr-unter-anderem","languageId":"de","category":"expressions","level":"B1","sourceText":"unter anderem","translations":{"tr":["diğerlerinin yanı sıra","bunlar arasında"]},"details":{"usage":"Kısaltması: u. a.","register":"neutral"},"examples":[{"text":"Er spricht unter anderem Spanisch und Türkisch.","tr":"Başka dillerin yanı sıra İspanyolca ve Türkçe de konuşuyor."}]},
  {"id":"de-expr-das-heisst","languageId":"de","category":"expressions","level":"B1","sourceText":"das heißt","translations":{"tr":["yani","başka bir deyişle"]},"details":{"usage":"Kısaltması: d. h.","register":"neutral"},"examples":[{"text":"Ich komme am Montag, das heißt in drei Tagen.","tr":"Pazartesi geliyorum, yani üç gün sonra."}]},
  {"id":"de-expr-kurz-gesagt","languageId":"de","category":"expressions","level":"B1","sourceText":"kurz gesagt","translations":{"tr":["kısacası","kısaca"]},"details":{"register":"neutral"},"examples":[{"text":"Kurz gesagt, es war ein Desaster.","tr":"Kısacası, tam bir felaketti."}]},
  {"id":"de-expr-ehrlich-gesagt","languageId":"de","category":"expressions","level":"B1","sourceText":"ehrlich gesagt","translations":{"tr":["açıkçası","dürüst olmak gerekirse"]},"details":{"register":"neutral"},"examples":[{"text":"Ehrlich gesagt habe ich keine Lust.","tr":"Açıkçası canım istemiyor."}]},
  {"id":"de-expr-wie-gesagt","languageId":"de","category":"expressions","level":"B1","sourceText":"wie gesagt","translations":{"tr":["dediğim gibi"]},"details":{"register":"neutral"},"examples":[{"text":"Wie gesagt, ich kann morgen nicht.","tr":"Dediğim gibi, yarın yapamam."}]},
  {"id":"de-expr-wie-schon-gesagt","languageId":"de","category":"expressions","level":"B1","sourceText":"wie schon gesagt","translations":{"tr":["daha önce de dediğim gibi"]},"details":{"register":"neutral"},"examples":[{"text":"Wie schon gesagt, das Meeting fällt aus.","tr":"Daha önce de dediğim gibi toplantı iptal."}]},
  {"id":"de-expr-auf-einmal","languageId":"de","category":"expressions","level":"B1","sourceText":"auf einmal","translations":{"tr":["birden","aniden","aynı anda"]},"details":{"register":"neutral"},"examples":[{"text":"Auf einmal ging das Licht aus.","tr":"Birden ışık söndü."}]},
  {"id":"de-expr-nach-und-nach","languageId":"de","category":"expressions","level":"B1","sourceText":"nach und nach","translations":{"tr":["yavaş yavaş","azar azar"]},"details":{"register":"neutral"},"examples":[{"text":"Nach und nach verstehe ich mehr.","tr":"Yavaş yavaş daha çok anlıyorum."}]},
  {"id":"de-expr-schritt-fur-schritt","languageId":"de","category":"expressions","level":"B1","sourceText":"Schritt für Schritt","translations":{"tr":["adım adım"]},"details":{"register":"neutral"},"examples":[{"text":"Wir lösen das Problem Schritt für Schritt.","tr":"Sorunu adım adım çözüyoruz."}]},
  {"id":"de-expr-so-weit","languageId":"de","category":"expressions","level":"B1","sourceText":"so weit","translations":{"tr":["o noktaya kadar","şimdilik"]},"details":{"usage":"\"Es ist so weit\" = vakit geldi.","register":"neutral"},"examples":[{"text":"Endlich ist es so weit: Wir fahren in den Urlaub!","tr":"Nihayet vakit geldi: tatile gidiyoruz!"}]},
  {"id":"de-expr-bisher","languageId":"de","category":"expressions","level":"B1","sourceText":"bisher","translations":{"tr":["şimdiye dek","şu ana kadar"]},"details":{"register":"neutral"},"examples":[{"text":"Bisher hat niemand angerufen.","tr":"Şu ana kadar kimse aramadı."}]},
  {"id":"de-expr-ab-sofort","languageId":"de","category":"expressions","level":"B1","sourceText":"ab sofort","translations":{"tr":["derhal","hemen şimdiden itibaren"]},"details":{"register":"neutral"},"examples":[{"text":"Ab sofort ist Rauchen hier verboten.","tr":"Şu andan itibaren burada sigara içmek yasak."}]},
  {"id":"de-expr-fruher-oder-spater","languageId":"de","category":"expressions","level":"B1","sourceText":"früher oder später","translations":{"tr":["er ya da geç"]},"details":{"register":"neutral"},"examples":[{"text":"Früher oder später findet er es heraus.","tr":"Er ya da geç bunu öğrenecek."}]},
  {"id":"de-expr-wurden-sie-mir-helfen","languageId":"de","category":"expressions","level":"B1","sourceText":"Würden Sie mir helfen?","translations":{"tr":["bana yardım eder misiniz?"]},"tags":["politeness"],"details":{"register":"formal"},"examples":[{"text":"Entschuldigung, würden Sie mir kurz helfen?","tr":"Affedersiniz, bana kısaca yardım eder misiniz?"}]},
  {"id":"de-expr-das-ist-mir-peinlich","languageId":"de","category":"expressions","level":"B1","sourceText":"Das ist mir peinlich.","translations":{"tr":["bundan utanıyorum","mahcup oldum"]},"details":{"register":"neutral"},"examples":[{"text":"Ich habe seinen Namen vergessen, das ist mir peinlich.","tr":"Adını unuttum, çok mahcup oldum."}]},
  {"id":"de-expr-das-ist-nicht-mein-ding","languageId":"de","category":"expressions","level":"B1","sourceText":"Das ist nicht mein Ding.","translations":{"tr":["bana göre değil","benim işim değil"]},"details":{"register":"informal"},"examples":[{"text":"Tanzen ist nicht mein Ding.","tr":"Dans bana göre değil."}]},
  {"id":"de-expr-das-hangt-davon-ab","languageId":"de","category":"expressions","level":"B1","sourceText":"Das hängt davon ab.","translations":{"tr":["buna bağlı","duruma göre değişir"]},"details":{"register":"neutral"},"examples":[{"text":"Ob wir fahren, hängt davon ab, wie das Wetter ist.","tr":"Gidip gitmememiz havanın nasıl olacağına bağlı."}]},
  {"id":"de-expr-das-ist-doch-klar","languageId":"de","category":"expressions","level":"B1","sourceText":"Das ist doch klar.","translations":{"tr":["bu açık","belli"]},"details":{"register":"informal"},"examples":[{"text":"Natürlich helfe ich dir, das ist doch klar.","tr":"Tabii ki yardım ederim, bu çok açık."}]},
  {"id":"de-expr-es-eilig-haben","languageId":"de","category":"expressions","level":"B1","sourceText":"es eilig haben","translations":{"tr":["acelesi olmak"]},"details":{"register":"neutral"},"examples":[{"text":"Tut mir leid, ich habe es eilig.","tr":"Kusura bakma, acelem var."}]},
  {"id":"de-expr-allerdings","languageId":"de","category":"expressions","level":"B1","sourceText":"allerdings","translations":{"tr":["ancak","gerçi","fakat"]},"tags":["connector"],"details":{"usage":"Önceki söze kısıtlama getirir.","register":"neutral"},"examples":[{"text":"Das Hotel ist schön, allerdings sehr teuer.","tr":"Otel güzel, ancak çok pahalı."}]},
  {"id":"de-expr-jedoch","languageId":"de","category":"expressions","level":"B1","sourceText":"jedoch","translations":{"tr":["ancak","fakat"]},"tags":["connector"],"details":{"register":"formal"},"examples":[{"text":"Wir haben angerufen, jedoch hat niemand geantwortet.","tr":"Aradık, ancak kimse cevap vermedi."}]},
  {"id":"de-expr-zwar-aber","languageId":"de","category":"expressions","level":"B1","sourceText":"zwar … aber","translations":{"tr":["gerçi … ama","… olsa da"]},"tags":["connector"],"details":{"register":"neutral"},"examples":[{"text":"Das Auto ist zwar alt, aber es fährt gut.","tr":"Araba gerçi eski ama iyi gidiyor."}]},
  {"id":"de-expr-nicht-nur-sondern-auch","languageId":"de","category":"expressions","level":"B1","sourceText":"nicht nur … sondern auch","translations":{"tr":["sadece … değil, aynı zamanda …"]},"tags":["connector"],"details":{"register":"neutral"},"examples":[{"text":"Sie spricht nicht nur Deutsch, sondern auch Japanisch.","tr":"Sadece Almanca değil, Japonca da konuşuyor."}]},
  {"id":"de-expr-sowohl-als-auch","languageId":"de","category":"expressions","level":"B1","sourceText":"sowohl … als auch","translations":{"tr":["hem … hem de"]},"tags":["connector"],"details":{"register":"neutral"},"examples":[{"text":"Sowohl mein Bruder als auch meine Schwester studieren.","tr":"Hem erkek kardeşim hem de kız kardeşim üniversitede okuyor."}]},
  {"id":"de-expr-weder-noch","languageId":"de","category":"expressions","level":"B1","sourceText":"weder … noch","translations":{"tr":["ne … ne de"]},"tags":["connector"],"details":{"register":"neutral"},"examples":[{"text":"Ich trinke weder Kaffee noch Tee.","tr":"Ne kahve ne de çay içerim."}]},
  {"id":"de-expr-entweder-oder","languageId":"de","category":"expressions","level":"B1","sourceText":"entweder … oder","translations":{"tr":["ya … ya da"]},"tags":["connector"],"details":{"register":"neutral"},"examples":[{"text":"Entweder du kommst mit oder du bleibst hier.","tr":"Ya benimle gelirsin ya da burada kalırsın."}]},
  {"id":"de-expr-je-desto","languageId":"de","category":"expressions","level":"B1","sourceText":"je … desto","translations":{"tr":["ne kadar … o kadar"]},"tags":["connector"],"details":{"usage":"\"je\"li yan cümlede fiil sonda: Je mehr ich lerne, desto besser verstehe ich.","register":"neutral"},"examples":[{"text":"Je früher wir losfahren, desto besser.","tr":"Ne kadar erken yola çıkarsak o kadar iyi."}]},
  {"id":"de-expr-anstatt-zu","languageId":"de","category":"expressions","level":"B1","sourceText":"anstatt zu","translations":{"tr":["…cağına","…mak yerine"]},"tags":["connector"],"details":{"register":"neutral"},"examples":[{"text":"Anstatt zu lernen, spielt er Computerspiele.","tr":"Ders çalışacağına bilgisayar oyunu oynuyor."}]},
  {"id":"de-expr-ohne-zu","languageId":"de","category":"expressions","level":"B1","sourceText":"ohne zu","translations":{"tr":["…madan"]},"tags":["connector"],"details":{"register":"neutral"},"examples":[{"text":"Er ging, ohne Tschüss zu sagen.","tr":"Hoşça kal demeden gitti."}]},
  {"id":"de-expr-aus-diesem-grund","languageId":"de","category":"expressions","level":"B1","sourceText":"aus diesem Grund","translations":{"tr":["bu sebeple"]},"tags":["connector"],"details":{"register":"neutral"},"examples":[{"text":"Aus diesem Grund haben wir den Termin verschoben.","tr":"Bu sebeple randevuyu erteledik."}]},
  {"id":"de-expr-im-vergleich-zu","languageId":"de","category":"expressions","level":"B1","sourceText":"im Vergleich zu","translations":{"tr":["…a kıyasla"]},"details":{"usage":"Datif ister.","register":"neutral"},"examples":[{"text":"Im Vergleich zu letztem Jahr ist es teurer.","tr":"Geçen yıla kıyasla daha pahalı."}]},
  {"id":"de-expr-tatsachlich","languageId":"de","category":"expressions","level":"B1","sourceText":"tatsächlich","translations":{"tr":["gerçekten","sahiden"]},"details":{"register":"neutral"},"examples":[{"text":"Er hat tatsächlich gewonnen!","tr":"Sahiden kazandı!"}]},
  {"id":"de-expr-anscheinend","languageId":"de","category":"expressions","level":"B1","sourceText":"anscheinend","translations":{"tr":["anlaşılan","görünüşe göre"]},"details":{"register":"neutral"},"examples":[{"text":"Anscheinend ist niemand zu Hause.","tr":"Anlaşılan evde kimse yok."}]},
  {"id":"de-expr-zumindest","languageId":"de","category":"expressions","level":"B1","sourceText":"zumindest","translations":{"tr":["en azından"]},"details":{"register":"neutral"},"examples":[{"text":"Ruf zumindest kurz an!","tr":"En azından kısaca bir ara!"}]},
  {"id":"de-expr-wenigstens","languageId":"de","category":"expressions","level":"B1","sourceText":"wenigstens","translations":{"tr":["hiç değilse","en azından"]},"details":{"register":"neutral"},"examples":[{"text":"Wenigstens regnet es nicht.","tr":"Hiç değilse yağmur yağmıyor."}]},
  {"id":"de-expr-nicht-einmal","languageId":"de","category":"expressions","level":"B1","sourceText":"nicht einmal","translations":{"tr":["bile … değil","… bile"]},"details":{"usage":"Konuşmada \"nicht mal\".","register":"neutral"},"examples":[{"text":"Er hat nicht einmal Danke gesagt.","tr":"Teşekkür bile etmedi."}]},
  {"id":"de-expr-mehr-oder-weniger","languageId":"de","category":"expressions","level":"B1","sourceText":"mehr oder weniger","translations":{"tr":["az çok","aşağı yukarı"]},"details":{"register":"neutral"},"examples":[{"text":"Das Projekt ist mehr oder weniger fertig.","tr":"Proje az çok bitti."}]},
  {"id":"de-expr-vor-kurzem","languageId":"de","category":"expressions","level":"B1","sourceText":"vor Kurzem","translations":{"tr":["kısa süre önce","yakınlarda"]},"details":{"register":"neutral"},"examples":[{"text":"Wir sind vor Kurzem umgezogen.","tr":"Kısa süre önce taşındık."}]},
  {"id":"de-expr-in-letzter-zeit","languageId":"de","category":"expressions","level":"B1","sourceText":"in letzter Zeit","translations":{"tr":["son zamanlarda"]},"details":{"register":"neutral"},"examples":[{"text":"In letzter Zeit schlafe ich schlecht.","tr":"Son zamanlarda kötü uyuyorum."}]},
  {"id":"de-expr-im-voraus","languageId":"de","category":"expressions","level":"B1","sourceText":"im Voraus","translations":{"tr":["şimdiden","önceden"]},"details":{"usage":"\"Vielen Dank im Voraus\" = Şimdiden teşekkürler.","register":"neutral"},"examples":[{"text":"Vielen Dank im Voraus für Ihre Hilfe.","tr":"Yardımınız için şimdiden çok teşekkürler."}]},
  {"id":"de-expr-in-ruhe","languageId":"de","category":"expressions","level":"B1","sourceText":"in Ruhe","translations":{"tr":["sakince","rahat rahat"]},"details":{"usage":"\"Lass mich in Ruhe!\" = Beni rahat bırak!","register":"neutral"},"examples":[{"text":"Lass uns das in Ruhe besprechen.","tr":"Bunu sakince konuşalım."}]},
  {"id":"de-expr-ich-freue-mich-auf-ihre-antwort","languageId":"de","category":"expressions","level":"B1","sourceText":"Ich freue mich auf Ihre Antwort.","translations":{"tr":["cevabınızı bekliyorum"]},"tags":["writing"],"details":{"usage":"Resmî mektup kapanışından önce.","register":"formal"},"examples":[{"text":"Ich freue mich auf Ihre Antwort. Mit freundlichen Grüßen …","tr":"Cevabınızı dört gözle bekliyorum. Saygılarımla …"}]},
  {"id":"de-expr-im-anhang","languageId":"de","category":"expressions","level":"B1","sourceText":"im Anhang","translations":{"tr":["ekte"]},"tags":["writing"],"details":{"usage":"E-postalarda: \"Im Anhang finden Sie …\"","register":"formal"},"examples":[{"text":"Im Anhang finden Sie meinen Lebenslauf.","tr":"Özgeçmişimi ekte bulabilirsiniz."}]},
