  {"id":"de-expr-auf-jeden-fall","languageId":"de","category":"expressions","level":"A2","sourceText":"auf jeden Fall","translations":{"tr":["kesinlikle","her halükârda","mutlaka"]},"details":{"register":"neutral"},"examples":[{"text":"Ich komme auf jeden Fall zu deiner Party.","tr":"Partine kesinlikle geleceğim."}]},
  {"id":"de-expr-auf-keinen-fall","languageId":"de","category":"expressions","level":"A2","sourceText":"auf keinen Fall","translations":{"tr":["asla","kesinlikle hayır"]},"details":{"register":"neutral"},"examples":[{"text":"Das mache ich auf keinen Fall!","tr":"Bunu asla yapmam!"}]},
  {"id":"de-expr-trotzdem","languageId":"de","category":"expressions","level":"A2","sourceText":"trotzdem","translations":{"tr":["yine de","buna rağmen"]},"tags":["connector"],"details":{"usage":"Cümle başında gelirse fiil hemen ardından gelir: Trotzdem gehe ich.","register":"neutral"},"examples":[{"text":"Es regnet, trotzdem gehe ich spazieren.","tr":"Yağmur yağıyor, yine de yürüyüşe çıkıyorum."}]},
