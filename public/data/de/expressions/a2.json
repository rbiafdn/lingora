  {"id":"de-expr-ab-und-zu","languageId":"de","category":"expressions","level":"A2","sourceText":"ab und zu","translations":{"tr":["arada bir","ara sıra"]},"details":{"register":"neutral"},"examples":[{"text":"Ab und zu gehen wir ins Kino.","tr":"Arada bir sinemaya gideriz."}]},
