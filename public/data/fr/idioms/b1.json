[
  {"id":"fr-idiom-avoir-le-cafard","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir le cafard","translations":{"tr":["canı sıkkın olmak","moral bozukluğu"]},"details":{"explanation":"Hüzünlü, keyifsiz ve karamsar hissetmek."},"examples":[{"text":"Depuis son départ, j'ai le cafard.","tr":"O gittiğinden beri moralim bozuk."}]},
  {"id":"fr-idiom-poser-un-lapin-a-quelquun","languageId":"fr","category":"idioms","level":"B1","sourceText":"poser un lapin à quelqu'un","translations":{"tr":["ekmek","randevuya gelmemek"]},"details":{"explanation":"Buluşmaya haber vermeden gitmemek.","turkishEquivalent":"birini ekmek"},"examples":[{"text":"Il m'a posé un lapin hier soir.","tr":"Dün akşam beni ekti."}]},
  {"id":"fr-idiom-couter-les-yeux-de-la-tete","languageId":"fr","category":"idioms","level":"B1","sourceText":"coûter les yeux de la tête","translations":{"tr":["çok pahalı olmak"]},"details":{"explanation":"Bir şeyin fiyatının aşırı yüksek olması.","turkishEquivalent":"ateş pahası olmak"},"examples":[{"text":"Cette voiture coûte les yeux de la tête.","tr":"Bu araba ateş pahası."}]},
  {"id":"fr-idiom-avoir-la-peche","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir la pêche","translations":{"tr":["enerjik olmak","keyfi yerinde olmak"]},"details":{"explanation":"Kendini dinç ve enerji dolu hissetmek."},"examples":[{"text":"Ce matin, j'ai la pêche !","tr":"Bu sabah enerjim tavan!"}]},
  {"id":"fr-idiom-tomber-dans-les-pommes","languageId":"fr","category":"idioms","level":"B1","sourceText":"tomber dans les pommes","translations":{"tr":["bayılmak"]},"details":{"explanation":"Kendinden geçmek, bilincini kaybetmek."},"examples":[{"text":"Il faisait si chaud qu'elle est tombée dans les pommes.","tr":"O kadar sıcaktı ki bayıldı."}]},
  {"id":"fr-idiom-avoir-le-coup-de-foudre","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir le coup de foudre","translations":{"tr":["ilk görüşte âşık olmak"]},"details":{"explanation":"Birine ya da bir şeye anında âşık olmak.","turkishEquivalent":"ilk görüşte aşk"},"examples":[{"text":"J'ai eu le coup de foudre pour cette ville.","tr":"Bu şehre ilk görüşte âşık oldum."}]},
  {"id":"fr-idiom-casser-les-pieds-a-quelquun","languageId":"fr","category":"idioms","level":"B1","sourceText":"casser les pieds à quelqu'un","translations":{"tr":["bıktırmak","başının etini yemek"]},"details":{"explanation":"Birini sürekli rahatsız edip sıkmak.","turkishEquivalent":"başının etini yemek"},"examples":[{"text":"Arrête de me casser les pieds !","tr":"Başımın etini yemeyi bırak!"}]},
  {"id":"fr-idiom-un-froid-de-canard","languageId":"fr","category":"idioms","level":"B1","sourceText":"un froid de canard","translations":{"tr":["dondurucu soğuk"]},"details":{"explanation":"Çok sert, dondurucu soğuk hava."},"examples":[{"text":"Il fait un froid de canard ce matin.","tr":"Bu sabah dondurucu bir soğuk var."}]},
  {"id":"fr-idiom-donner-sa-langue-au-chat","languageId":"fr","category":"idioms","level":"B1","sourceText":"donner sa langue au chat","translations":{"tr":["bilemedim, söyle","tahmini bırakmak"]},"details":{"explanation":"Bir bilmecenin cevabını bulamayıp vazgeçmek."},"examples":[{"text":"Je ne sais pas, je donne ma langue au chat.","tr":"Bilmiyorum, pes ediyorum, söyle."}]},
  {"id":"fr-idiom-avoir-un-chat-dans-la-gorge","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir un chat dans la gorge","translations":{"tr":["sesi kısılmak","boğazı gıcıklanmak"]},"details":{"explanation":"Boğazdaki gıcık yüzünden net konuşamamak."},"examples":[{"text":"Excusez-moi, j'ai un chat dans la gorge.","tr":"Pardon, boğazım gıcıklanıyor."}]},
  {"id":"fr-idiom-tetu-comme-une-mule","languageId":"fr","category":"idioms","level":"B1","sourceText":"têtu comme une mule","translations":{"tr":["çok inatçı"]},"details":{"explanation":"Aşırı inatçı olan kişi için söylenir.","turkishEquivalent":"katır gibi inatçı"},"examples":[{"text":"Mon père est têtu comme une mule.","tr":"Babam katır gibi inatçıdır."}]},
  {"id":"fr-idiom-avoir-la-tete-dans-les-nuages","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir la tête dans les nuages","translations":{"tr":["dalgın olmak","hayallere dalmak"]},"details":{"explanation":"Dikkati dağınık, aklı başka yerde olmak."},"examples":[{"text":"Il a toujours la tête dans les nuages en classe.","tr":"Derste aklı hep başka yerde."}]},
  {"id":"fr-idiom-perdre-la-tete","languageId":"fr","category":"idioms","level":"B1","sourceText":"perdre la tête","translations":{"tr":["aklını kaçırmak","kendini kaybetmek"]},"details":{"explanation":"Mantıklı düşünemez hale gelmek.","turkishEquivalent":"aklını oynatmak"},"examples":[{"text":"Tu as perdu la tête ou quoi ?","tr":"Aklını mı kaçırdın?"}]},
  {"id":"fr-idiom-se-casser-la-tete","languageId":"fr","category":"idioms","level":"B1","sourceText":"se casser la tête","translations":{"tr":["kafa yormak","uğraşmak"]},"details":{"explanation":"Bir sorunu çözmek için çok düşünmek.","turkishEquivalent":"kafa patlatmak"},"examples":[{"text":"Ne te casse pas la tête, c'est simple.","tr":"Kafa yorma, basit bir şey."}]},
  {"id":"fr-idiom-mon-oeil","languageId":"fr","category":"idioms","level":"B1","sourceText":"mon œil !","translations":{"tr":["hadi canım!","yemezler!"]},"details":{"explanation":"Söylenene inanmadığını belirtmek için kullanılır.","turkishEquivalent":"yemezler!"},"examples":[{"text":"Tu as fini tes devoirs ? Mon œil !","tr":"Ödevlerini mi bitirdin? Yemezler!"}]},
  {"id":"fr-idiom-ne-pas-fermer-loeil-de-la-nuit","languageId":"fr","category":"idioms","level":"B1","sourceText":"ne pas fermer l'œil de la nuit","translations":{"tr":["bütün gece uyuyamamak"]},"details":{"explanation":"Geceyi hiç uyumadan geçirmek.","turkishEquivalent":"gözünü kırpmamak"},"examples":[{"text":"Avec ce bruit, je n'ai pas fermé l'œil de la nuit.","tr":"Bu gürültüyle bütün gece gözümü kırpmadım."}]},
  {"id":"fr-idiom-en-un-clin-doeil","languageId":"fr","category":"idioms","level":"B1","sourceText":"en un clin d'œil","translations":{"tr":["bir anda","çabucak"]},"details":{"explanation":"Çok kısa sürede.","turkishEquivalent":"göz açıp kapayıncaya kadar"},"examples":[{"text":"Elle a tout rangé en un clin d'œil.","tr":"Her şeyi göz açıp kapayıncaya kadar topladı."}]},
  {"id":"fr-idiom-occupe-toi-de-tes-oignons","languageId":"fr","category":"idioms","level":"B1","sourceText":"occupe-toi de tes oignons","translations":{"tr":["sen kendi işine bak"]},"details":{"explanation":"Birine başkasının işine karışmamasını söylemek."},"examples":[{"text":"Ma vie privée ? Occupe-toi de tes oignons !","tr":"Özel hayatım mı? Sen kendi işine bak!"}]},
  {"id":"fr-idiom-ce-ne-sont-pas-mes-oignons","languageId":"fr","category":"idioms","level":"B1","sourceText":"ce ne sont pas mes oignons","translations":{"tr":["beni ilgilendirmez"]},"details":{"explanation":"Bir konunun kendisini ilgilendirmediğini söylemek."},"examples":[{"text":"Leurs disputes, ce ne sont pas mes oignons.","tr":"Kavgaları beni ilgilendirmez."}]},
  {"id":"fr-idiom-tomber-a-leau","languageId":"fr","category":"idioms","level":"B1","sourceText":"tomber à l'eau","translations":{"tr":["suya düşmek","boşa çıkmak"]},"details":{"explanation":"Bir planın gerçekleşmemesi.","turkishEquivalent":"suya düşmek"},"examples":[{"text":"Nos projets de vacances sont tombés à l'eau.","tr":"Tatil planlarımız suya düştü."}]},
  {"id":"fr-idiom-haut-comme-trois-pommes","languageId":"fr","category":"idioms","level":"B1","sourceText":"haut comme trois pommes","translations":{"tr":["boyu bir karış","çok küçük"]},"details":{"explanation":"Çok kısa boylu, küçük bir çocuk için söylenir.","turkishEquivalent":"boyu bir karış"},"examples":[{"text":"Je le connais depuis qu'il est haut comme trois pommes.","tr":"Onu boyu bir karışken tanırım."}]},
  {"id":"fr-idiom-avoir-la-chair-de-poule","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir la chair de poule","translations":{"tr":["tüyleri diken diken olmak"]},"details":{"explanation":"Korku, soğuk ya da heyecandan tüyleri ürpermek.","turkishEquivalent":"tüyleri diken diken olmak"},"examples":[{"text":"Cette chanson me donne la chair de poule.","tr":"Bu şarkı tüylerimi diken diken ediyor."}]},
  {"id":"fr-idiom-comme-un-poisson-dans-leau","languageId":"fr","category":"idioms","level":"B1","sourceText":"comme un poisson dans l'eau","translations":{"tr":["kendini evinde hissetmek","rahat"]},"details":{"explanation":"Bir ortamda kendini çok rahat ve uyumlu hissetmek.","turkishEquivalent":"suda balık gibi"},"examples":[{"text":"À Paris, elle est comme un poisson dans l'eau.","tr":"Paris'te kendini evinde gibi hissediyor."}]},
  {"id":"fr-idiom-avoir-une-memoire-delephant","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir une mémoire d'éléphant","translations":{"tr":["hafızası çok güçlü olmak"]},"details":{"explanation":"Her şeyi uzun süre hatırlamak.","turkishEquivalent":"fil hafızası"},"examples":[{"text":"Ne lui mens pas, il a une mémoire d'éléphant.","tr":"Ona yalan söyleme, fil hafızası var."}]},
  {"id":"fr-idiom-il-ny-a-pas-un-chat","languageId":"fr","category":"idioms","level":"B1","sourceText":"il n'y a pas un chat","translations":{"tr":["kimsecikler yok"]},"details":{"explanation":"Bir yerde hiç kimsenin olmaması.","turkishEquivalent":"in cin top oynuyor"},"examples":[{"text":"À cette heure, il n'y a pas un chat dans la rue.","tr":"Bu saatte sokakta in cin top oynuyor."}]},
  {"id":"fr-idiom-un-temps-de-chien","languageId":"fr","category":"idioms","level":"B1","sourceText":"un temps de chien","translations":{"tr":["berbat hava"]},"details":{"explanation":"Çok kötü, yağmurlu ya da soğuk hava."},"examples":[{"text":"Quel temps de chien aujourd'hui !","tr":"Bugün ne berbat bir hava!"}]},
  {"id":"fr-idiom-sentendre-comme-chien-et-chat","languageId":"fr","category":"idioms","level":"B1","sourceText":"s'entendre comme chien et chat","translations":{"tr":["hiç anlaşamamak"]},"details":{"explanation":"Sürekli kavga etmek, hiç geçinememek.","turkishEquivalent":"kedi köpek gibi olmak"},"examples":[{"text":"Mes deux frères s'entendent comme chien et chat.","tr":"İki erkek kardeşim kedi köpek gibi."}]},
  {"id":"fr-idiom-jeter-largent-par-les-fenetres","languageId":"fr","category":"idioms","level":"B1","sourceText":"jeter l'argent par les fenêtres","translations":{"tr":["parayı çarçur etmek","savurganlık"]},"details":{"explanation":"Parayı düşüncesizce harcamak.","turkishEquivalent":"parayı sokağa atmak"},"examples":[{"text":"Acheter ça, c'est jeter l'argent par les fenêtres.","tr":"Bunu almak parayı sokağa atmak demek."}]},
  {"id":"fr-idiom-avoir-un-coeur-dor","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir un cœur d'or","translations":{"tr":["altın kalpli olmak"]},"details":{"explanation":"Çok iyi kalpli olmak.","turkishEquivalent":"altın kalpli"},"examples":[{"text":"Il paraît dur, mais il a un cœur d'or.","tr":"Sert görünür ama altın gibi bir kalbi var."}]},
  {"id":"fr-idiom-de-bon-coeur","languageId":"fr","category":"idioms","level":"B1","sourceText":"de bon cœur","translations":{"tr":["seve seve","içtenlikle"]},"details":{"explanation":"İsteyerek, gönülden.","turkishEquivalent":"canıgönülden"},"examples":[{"text":"Je t'aide de bon cœur.","tr":"Sana seve seve yardım ederim."}]},
  {"id":"fr-idiom-avoir-mal-au-coeur","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir mal au cœur","translations":{"tr":["midesi bulanmak"]},"details":{"explanation":"Mide bulantısı hissetmek."},"examples":[{"text":"En bateau, j'ai toujours mal au cœur.","tr":"Teknede hep midem bulanır."}]},
  {"id":"fr-idiom-avoir-un-mot-sur-le-bout-de-la-langue","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir un mot sur le bout de la langue","translations":{"tr":["dilinin ucunda olmak"]},"details":{"explanation":"Bir kelimeyi hatırlamak üzere olup söyleyememek.","turkishEquivalent":"dilinin ucunda olmak"},"examples":[{"text":"Son nom ? Je l'ai sur le bout de la langue.","tr":"Adı mı? Dilimin ucunda."}]},
  {"id":"fr-idiom-faire-froid-dans-le-dos","languageId":"fr","category":"idioms","level":"B1","sourceText":"faire froid dans le dos","translations":{"tr":["tüylerini ürpertmek"]},"details":{"explanation":"Korku ya da dehşet uyandırmak.","turkishEquivalent":"tüylerini ürpertmek"},"examples":[{"text":"Cette histoire me fait froid dans le dos.","tr":"Bu hikâye tüylerimi ürpertiyor."}]},
  {"id":"fr-idiom-tourner-le-dos-a-quelquun","languageId":"fr","category":"idioms","level":"B1","sourceText":"tourner le dos à quelqu'un","translations":{"tr":["sırt çevirmek"]},"details":{"explanation":"Birini yüzüstü bırakmak, ondan uzaklaşmak.","turkishEquivalent":"sırt çevirmek"},"examples":[{"text":"Ses amis lui ont tourné le dos.","tr":"Arkadaşları ona sırt çevirdi."}]},
  {"id":"fr-idiom-se-lever-du-pied-gauche","languageId":"fr","category":"idioms","level":"B1","sourceText":"se lever du pied gauche","translations":{"tr":["güne kötü başlamak","huysuz olmak"]},"details":{"explanation":"Sabahtan itibaren huysuz ve keyifsiz olmak.","turkishEquivalent":"ters tarafından kalkmak"},"examples":[{"text":"Le patron s'est levé du pied gauche ce matin.","tr":"Patron bu sabah yatağın ters tarafından kalkmış."}]},
  {"id":"fr-idiom-avoir-les-pieds-sur-terre","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir les pieds sur terre","translations":{"tr":["gerçekçi olmak"]},"details":{"explanation":"Ayakları yere basan, mantıklı biri olmak.","turkishEquivalent":"ayakları yere basmak"},"examples":[{"text":"C'est un rêveur, mais sa femme a les pieds sur terre.","tr":"O hayalperest ama karısının ayakları yere basıyor."}]},
  {"id":"fr-idiom-briser-la-glace","languageId":"fr","category":"idioms","level":"B1","sourceText":"briser la glace","translations":{"tr":["buzları eritmek"]},"details":{"explanation":"Tanışma sırasındaki gerginliği gidermek.","turkishEquivalent":"buzları kırmak"},"examples":[{"text":"Une petite blague pour briser la glace ?","tr":"Buzları kırmak için küçük bir şaka?"}]},
  {"id":"fr-idiom-etre-dans-la-lune","languageId":"fr","category":"idioms","level":"B1","sourceText":"être dans la lune","translations":{"tr":["dalgın olmak"]},"details":{"explanation":"Dikkatini toplayamamak, hayallere dalmak."},"examples":[{"text":"Excuse-moi, j'étais dans la lune.","tr":"Kusura bakma, dalmışım."}]},
  {"id":"fr-idiom-faire-dune-pierre-deux-coups","languageId":"fr","category":"idioms","level":"B1","sourceText":"faire d'une pierre deux coups","translations":{"tr":["aynı anda iki iş görmek"]},"details":{"explanation":"Tek bir hareketle iki sonuç elde etmek.","turkishEquivalent":"bir taşla iki kuş vurmak"},"examples":[{"text":"En passant par la poste, je fais d'une pierre deux coups.","tr":"Postaneye uğrayarak bir taşla iki kuş vuruyorum."}]},
  {"id":"fr-idiom-cest-du-chinois","languageId":"fr","category":"idioms","level":"B1","sourceText":"c'est du chinois","translations":{"tr":["hiç anlaşılmıyor"]},"details":{"explanation":"Bir şeyin tamamen anlaşılmaz olduğunu söylemek."},"examples":[{"text":"Ces formules de maths, pour moi c'est du chinois.","tr":"Bu matematik formülleri bana Çince gibi geliyor."}]},
  {"id":"fr-idiom-se-ressembler-comme-deux-gouttes-deau","languageId":"fr","category":"idioms","level":"B1","sourceText":"se ressembler comme deux gouttes d'eau","translations":{"tr":["tıpatıp benzemek"]},"details":{"explanation":"Birbirine çok benzemek.","turkishEquivalent":"elmanın yarısı o yarısı bu"},"examples":[{"text":"Les jumelles se ressemblent comme deux gouttes d'eau.","tr":"İkiz kızlar tıpatıp birbirine benziyor."}]},
  {"id":"fr-idiom-avoir-le-dernier-mot","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir le dernier mot","translations":{"tr":["son sözü söylemek"]},"details":{"explanation":"Bir tartışmada sonunda haklı çıkmak.","turkishEquivalent":"son sözü söylemek"},"examples":[{"text":"Elle veut toujours avoir le dernier mot.","tr":"Hep son sözü söylemek ister."}]},
  {"id":"fr-idiom-quand-on-parle-du-loup-on-en-voit-la-queue","languageId":"fr","category":"idioms","level":"B1","sourceText":"quand on parle du loup (on en voit la queue)","translations":{"tr":["tam da ondan bahsediyorduk"]},"details":{"explanation":"Hakkında konuşulan kişi o anda ortaya çıkınca söylenir.","turkishEquivalent":"iti an çomağı hazırla"},"examples":[{"text":"Quand on parle du loup ! On disait justement que tu étais en retard.","tr":"İti an çomağı hazırla! Tam da geç kaldığını söylüyorduk."}]},
  {"id":"fr-idiom-dormir-comme-un-loir","languageId":"fr","category":"idioms","level":"B1","sourceText":"dormir comme un loir","translations":{"tr":["çok derin uyumak"]},"details":{"explanation":"Uzun ve deliksiz uyumak.","turkishEquivalent":"kütük gibi uyumak"},"examples":[{"text":"Après la randonnée, j'ai dormi comme un loir.","tr":"Yürüyüşten sonra kütük gibi uyudum."}]},
  {"id":"fr-idiom-ruse-comme-un-renard","languageId":"fr","category":"idioms","level":"B1","sourceText":"rusé comme un renard","translations":{"tr":["çok kurnaz"]},"details":{"explanation":"Son derece kurnaz biri için söylenir.","turkishEquivalent":"tilki gibi kurnaz"},"examples":[{"text":"Méfie-toi, il est rusé comme un renard.","tr":"Dikkat et, tilki gibi kurnazdır."}]},
  {"id":"fr-idiom-avoir-des-papillons-dans-le-ventre","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir des papillons dans le ventre","translations":{"tr":["heyecanlanmak","kelebekler uçuşmak"]},"details":{"explanation":"Âşıkken ya da heyecanlıyken midede kıpırtı hissetmek.","turkishEquivalent":"midesinde kelebekler uçuşmak"},"examples":[{"text":"Quand je le vois, j'ai des papillons dans le ventre.","tr":"Onu görünce midemde kelebekler uçuşuyor."}]},
  {"id":"fr-idiom-la-cerise-sur-le-gateau","languageId":"fr","category":"idioms","level":"B1","sourceText":"la cerise sur le gâteau","translations":{"tr":["işin cabası","üstüne bir de"]},"details":{"explanation":"Zaten iyi olan bir şeyin üstüne gelen ek güzellik (bazen ironik)."},"examples":[{"text":"Et cerise sur le gâteau, il a fait beau tout le week-end !","tr":"Üstüne bir de bütün hafta sonu hava güzeldi!"}]},
  {"id":"fr-idiom-avoir-leau-a-la-bouche","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir l'eau à la bouche","translations":{"tr":["ağzı sulanmak"]},"details":{"explanation":"Bir yemeği görünce ya da düşününce iştahı kabarmak.","turkishEquivalent":"ağzı sulanmak"},"examples":[{"text":"Rien que l'odeur me met l'eau à la bouche.","tr":"Kokusu bile ağzımı sulandırıyor."}]},
  {"id":"fr-idiom-trempe-jusquaux-os","languageId":"fr","category":"idioms","level":"B1","sourceText":"trempé jusqu'aux os","translations":{"tr":["sırılsıklam"]},"details":{"explanation":"Yağmurda tamamen ıslanmış olmak.","turkishEquivalent":"iliklerine kadar ıslanmak"},"examples":[{"text":"Sans parapluie, je suis rentré trempé jusqu'aux os.","tr":"Şemsiyesiz, iliklerime kadar ıslanmış döndüm."}]},
  {"id":"fr-idiom-avoir-un-coeur-de-pierre","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir un cœur de pierre","translations":{"tr":["taş kalpli olmak"]},"details":{"explanation":"Hiç merhameti olmamak.","turkishEquivalent":"taş kalpli"},"examples":[{"text":"Il faut avoir un cœur de pierre pour abandonner un chien.","tr":"Bir köpeği terk etmek için taş kalpli olmak gerek."}]},
  {"id":"fr-idiom-avoir-la-flemme","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir la flemme","translations":{"tr":["üşenmek"]},"details":{"explanation":"Bir şey yapmaya hiç isteği olmamak (gündelik).","turkishEquivalent":"üşenmek"},"examples":[{"text":"J'ai la flemme de faire la vaisselle.","tr":"Bulaşık yıkamaya üşeniyorum."}]},
  {"id":"fr-idiom-avoir-le-trac","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir le trac","translations":{"tr":["sahne korkusu yaşamak","heyecanlanmak"]},"details":{"explanation":"Bir gösteri ya da sınav öncesi heyecan ve korku duymak."},"examples":[{"text":"Avant chaque concert, elle a le trac.","tr":"Her konserden önce sahne heyecanı yaşar."}]},
  {"id":"fr-idiom-cest-la-galere","languageId":"fr","category":"idioms","level":"B1","sourceText":"c'est la galère","translations":{"tr":["tam bir çile","eziyet"]},"details":{"explanation":"Bir durumun çok zahmetli olduğunu söylemek (gündelik)."},"examples":[{"text":"Trouver un logement à Paris, c'est la galère.","tr":"Paris'te ev bulmak tam bir çile."}]},
  {"id":"fr-idiom-un-coup-de-pouce","languageId":"fr","category":"idioms","level":"B1","sourceText":"un coup de pouce","translations":{"tr":["küçük bir destek"]},"details":{"explanation":"Bir işi kolaylaştıran küçük yardım."},"examples":[{"text":"Il m'a donné un coup de pouce pour trouver du travail.","tr":"İş bulmam için bana biraz destek oldu."}]},
  {"id":"fr-idiom-un-coup-de-coeur","languageId":"fr","category":"idioms","level":"B1","sourceText":"un coup de cœur","translations":{"tr":["anında beğeni","vurulmak"]},"details":{"explanation":"Bir şeyi görür görmez çok beğenmek."},"examples":[{"text":"Ce livre, c'est mon coup de cœur de l'année.","tr":"Bu kitap, bu yıl en çok vurulduğum kitap."}]},
  {"id":"fr-idiom-tenir-le-coup","languageId":"fr","category":"idioms","level":"B1","sourceText":"tenir le coup","translations":{"tr":["dayanmak","direnmek"]},"details":{"explanation":"Zor bir duruma katlanmak.","turkishEquivalent":"dayanmak"},"examples":[{"text":"Courage, il faut tenir le coup encore une semaine.","tr":"Sabret, bir hafta daha dayanmak lazım."}]},
  {"id":"fr-idiom-faire-du-leche-vitrine","languageId":"fr","category":"idioms","level":"B1","sourceText":"faire du lèche-vitrine","translations":{"tr":["vitrin gezmek"]},"details":{"explanation":"Bir şey almadan mağaza vitrinlerine bakarak dolaşmak."},"examples":[{"text":"Le samedi, on fait du lèche-vitrine en ville.","tr":"Cumartesileri şehirde vitrin gezeriz."}]},
  {"id":"fr-idiom-faire-le-pont","languageId":"fr","category":"idioms","level":"B1","sourceText":"faire le pont","translations":{"tr":["köprü izni yapmak"]},"details":{"explanation":"Tatil ile hafta sonu arasındaki iş gününü de izin yapmak.","turkishEquivalent":"köprü yapmak"},"examples":[{"text":"Jeudi est férié, alors on fait le pont vendredi.","tr":"Perşembe tatil, o yüzden cumayı da köprü yapıyoruz."}]},
  {"id":"fr-idiom-etre-bien-dans-sa-peau","languageId":"fr","category":"idioms","level":"B1","sourceText":"être bien dans sa peau","translations":{"tr":["kendiyle barışık olmak"]},"details":{"explanation":"Kendini iyi ve rahat hissetmek."},"examples":[{"text":"Depuis qu'elle fait du sport, elle est bien dans sa peau.","tr":"Spor yapmaya başladığından beri kendiyle barışık."}]},
  {"id":"fr-idiom-mettre-quelquun-a-la-porte","languageId":"fr","category":"idioms","level":"B1","sourceText":"mettre quelqu'un à la porte","translations":{"tr":["kapı dışarı etmek","kovmak"]},"details":{"explanation":"Birini evden ya da işten çıkarmak.","turkishEquivalent":"kapı dışarı etmek"},"examples":[{"text":"Son patron l'a mis à la porte.","tr":"Patronu onu kapı dışarı etti."}]},
  {"id":"fr-idiom-aller-droit-au-but","languageId":"fr","category":"idioms","level":"B1","sourceText":"aller droit au but","translations":{"tr":["sadede gelmek"]},"details":{"explanation":"Dolambaçsız, doğrudan konuşmak.","turkishEquivalent":"sadede gelmek"},"examples":[{"text":"Je vais aller droit au but : j'ai besoin d'argent.","tr":"Sadede geleyim: paraya ihtiyacım var."}]},
  {"id":"fr-idiom-connaitre-comme-sa-poche","languageId":"fr","category":"idioms","level":"B1","sourceText":"connaître comme sa poche","translations":{"tr":["çok iyi bilmek"]},"details":{"explanation":"Bir yeri ya da kişiyi en ince ayrıntısına kadar bilmek.","turkishEquivalent":"avucunun içi gibi bilmek"},"examples":[{"text":"Je connais ce quartier comme ma poche.","tr":"Bu mahalleyi avucumun içi gibi bilirim."}]},
  {"id":"fr-idiom-voir-la-vie-en-rose","languageId":"fr","category":"idioms","level":"B1","sourceText":"voir la vie en rose","translations":{"tr":["iyimser olmak"]},"details":{"explanation":"Hayata hep olumlu bakmak.","turkishEquivalent":"hayata pembe gözlükle bakmak"},"examples":[{"text":"Depuis qu'elle est amoureuse, elle voit la vie en rose.","tr":"Âşık olduğundan beri hayata pembe gözlükle bakıyor."}]},
  {"id":"fr-idiom-donner-le-feu-vert","languageId":"fr","category":"idioms","level":"B1","sourceText":"donner le feu vert","translations":{"tr":["izin vermek","onay vermek"]},"details":{"explanation":"Bir işin başlamasına izin vermek.","turkishEquivalent":"yeşil ışık yakmak"},"examples":[{"text":"Le directeur a donné le feu vert au projet.","tr":"Müdür projeye yeşil ışık yaktı."}]},
  {"id":"fr-idiom-avoir-le-moral-a-zero","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir le moral à zéro","translations":{"tr":["moralı sıfır olmak"]},"details":{"explanation":"Morali çok bozuk olmak.","turkishEquivalent":"moralı yerlerde olmak"},"examples":[{"text":"Avec ce temps gris, j'ai le moral à zéro.","tr":"Bu gri havayla moralim yerlerde."}]},
  {"id":"fr-idiom-tourner-la-page","languageId":"fr","category":"idioms","level":"B1","sourceText":"tourner la page","translations":{"tr":["geride bırakmak"]},"details":{"explanation":"Geçmişi unutup yeni bir döneme başlamak.","turkishEquivalent":"yeni bir sayfa açmak"},"examples":[{"text":"Après le divorce, elle a tourné la page.","tr":"Boşanmadan sonra yeni bir sayfa açtı."}]},
  {"id":"fr-idiom-tourner-en-rond","languageId":"fr","category":"idioms","level":"B1","sourceText":"tourner en rond","translations":{"tr":["yerinde saymak"]},"details":{"explanation":"İlerleme kaydedemeden aynı şeyleri yapmak.","turkishEquivalent":"yerinde saymak"},"examples":[{"text":"Cette discussion tourne en rond.","tr":"Bu tartışma yerinde sayıyor."}]},
  {"id":"fr-idiom-etre-dans-le-meme-bateau","languageId":"fr","category":"idioms","level":"B1","sourceText":"être dans le même bateau","translations":{"tr":["aynı durumda olmak"]},"details":{"explanation":"Aynı zorluğu paylaşmak.","turkishEquivalent":"aynı gemide olmak"},"examples":[{"text":"Ne t'inquiète pas, on est tous dans le même bateau.","tr":"Merak etme, hepimiz aynı gemideyiz."}]},
  {"id":"fr-idiom-jouer-avec-le-feu","languageId":"fr","category":"idioms","level":"B1","sourceText":"jouer avec le feu","translations":{"tr":["tehlikeyle oynamak"]},"details":{"explanation":"Bilerek riskli davranmak.","turkishEquivalent":"ateşle oynamak"},"examples":[{"text":"Conduire si vite, c'est jouer avec le feu.","tr":"Bu kadar hızlı sürmek ateşle oynamak demek."}]},
  {"id":"fr-idiom-avoir-un-trou-de-memoire","languageId":"fr","category":"idioms","level":"B1","sourceText":"avoir un trou de mémoire","translations":{"tr":["bir anda unutmak"]},"details":{"explanation":"Bildiği bir şeyi o an hatırlayamamak."},"examples":[{"text":"Pendant l'examen, j'ai eu un trou de mémoire.","tr":"Sınav sırasında bir anda her şey aklımdan uçtu."}]},
  {"id":"fr-idiom-du-jour-au-lendemain","languageId":"fr","category":"idioms","level":"B1","sourceText":"du jour au lendemain","translations":{"tr":["birdenbire","bir gecede"]},"details":{"explanation":"Çok kısa sürede, aniden.","turkishEquivalent":"bir gecede"},"examples":[{"text":"Il est devenu célèbre du jour au lendemain.","tr":"Bir gecede ünlü oldu."}]},
  {"id":"fr-idiom-a-bras-ouverts","languageId":"fr","category":"idioms","level":"B1","sourceText":"à bras ouverts","translations":{"tr":["kucak açarak","sıcak karşılamak"]},"details":{"explanation":"Büyük bir sevgi ve içtenlikle karşılamak.","turkishEquivalent":"kucak açmak"},"examples":[{"text":"Sa famille m'a accueilli à bras ouverts.","tr":"Ailesi beni kucak açarak karşıladı."}]},
  {"id":"fr-idiom-main-dans-la-main","languageId":"fr","category":"idioms","level":"B1","sourceText":"main dans la main","translations":{"tr":["el ele"]},"details":{"explanation":"Birlikte, iş birliği içinde.","turkishEquivalent":"el ele"},"examples":[{"text":"Les deux pays travaillent main dans la main.","tr":"İki ülke el ele çalışıyor."}]},
  {"id":"fr-idiom-se-faire-avoir","languageId":"fr","category":"idioms","level":"B1","sourceText":"se faire avoir","translations":{"tr":["kandırılmak"]},"details":{"explanation":"Aldatılmak ya da kazıklanmak (gündelik).","turkishEquivalent":"kazık yemek"},"examples":[{"text":"Cinquante euros pour ça ? Tu t'es fait avoir !","tr":"Buna elli avro mu? Kazık yemişsin!"}]},
  {"id":"fr-idiom-mort-de-rire","languageId":"fr","category":"idioms","level":"B1","sourceText":"mort de rire","translations":{"tr":["gülmekten ölmek"]},"details":{"explanation":"Bir şeye çok fazla gülmek.","turkishEquivalent":"gülmekten ölmek"},"examples":[{"text":"Sa blague ? J'étais mort de rire !","tr":"Şakası mı? Gülmekten öldüm!"}]},
  {"id":"fr-idiom-mourir-denvie-de","languageId":"fr","category":"idioms","level":"B1","sourceText":"mourir d'envie de","translations":{"tr":["bir şeyi çok istemek"]},"details":{"explanation":"Bir şeyi yapmayı çok arzulamak.","turkishEquivalent":"can atmak"},"examples":[{"text":"Je meurs d'envie de voir ce film.","tr":"Bu filmi görmek için can atıyorum."}]},
  {"id":"fr-idiom-faire-le-premier-pas","languageId":"fr","category":"idioms","level":"B1","sourceText":"faire le premier pas","translations":{"tr":["ilk adımı atmak"]},"details":{"explanation":"Bir ilişkide ya da barışmada ilk girişimi yapmak.","turkishEquivalent":"ilk adımı atmak"},"examples":[{"text":"Après la dispute, c'est elle qui a fait le premier pas.","tr":"Kavgadan sonra ilk adımı o attı."}]},
  {"id":"fr-idiom-un-coup-de-foudre","languageId":"fr","category":"idioms","level":"B1","sourceText":"un coup de foudre","translations":{"tr":["yıldırım aşkı"]},"details":{"explanation":"İlk görüşte yaşanan ani ve güçlü aşk.","turkishEquivalent":"ilk görüşte aşk"},"examples":[{"text":"Entre eux, ça a été un vrai coup de foudre.","tr":"Aralarında gerçek bir ilk görüşte aşk yaşandı."}]}
