  {"id":"fr-expr-a-lheure","languageId":"fr","category":"expressions","level":"A1","sourceText":"à l'heure","translations":{"tr":["zamanında","tam vaktinde"]},"details":{"register":"neutral"},"examples":[{"text":"Le train est arrivé à l'heure.","tr":"Tren zamanında geldi."}]},
