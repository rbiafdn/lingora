  {"id":"fr-expr-en-vacances","languageId":"fr","category":"expressions","level":"A1","sourceText":"en vacances","translations":{"tr":["tatilde","tatile"]},"details":{"register":"neutral"},"examples":[{"text":"Nous partons en vacances en juillet.","tr":"Temmuzda tatile çıkıyoruz."}]},
