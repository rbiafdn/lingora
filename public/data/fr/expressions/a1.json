[
  {"id":"fr-expr-par-exemple","languageId":"fr","category":"expressions","level":"A1","sourceText":"par exemple","translations":{"tr":["örneğin","mesela"]},"details":{"usage":"Yazıda kısaltması: p. ex.","register":"neutral"},"examples":[{"text":"J'aime les fruits, par exemple les pommes.","tr":"Meyve severim, örneğin elma."}]},
