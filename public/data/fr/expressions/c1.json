[
  {"id":"fr-expr-faute-de","languageId":"fr","category":"expressions","level":"C1","sourceText":"faute de","translations":{"tr":["… olmadığından","… yokluğunda"]},"details":{"register":"formal"},"examples":[{"text":"Faute de temps, je n'ai pas fini.","tr":"Zaman olmadığından bitiremedim."}]},
  {"id":"fr-expr-a-legard-de","languageId":"fr","category":"expressions","level":"C1","sourceText":"à l'égard de","translations":{"tr":["… karşı","… konusunda"]},"details":{"register":"formal"},"examples":[{"text":"Il est très gentil à l'égard de ses voisins.","tr":"Komşularına karşı çok nazik."}]},
  {"id":"fr-expr-en-tout-etat-de-cause","languageId":"fr","category":"expressions","level":"C1","sourceText":"en tout état de cause","translations":{"tr":["her halükârda"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"En tout état de cause, la décision vous appartient.","tr":"Her halükârda karar sizin."}]},
  {"id":"fr-expr-a-la-rigueur","languageId":"fr","category":"expressions","level":"C1","sourceText":"à la rigueur","translations":{"tr":["en kötü ihtimalle","gerekirse"]},"details":{"register":"neutral"},"examples":[{"text":"À la rigueur, je peux venir lundi.","tr":"Gerekirse pazartesi gelebilirim."}]},
  {"id":"fr-expr-dautant-plus-que","languageId":"fr","category":"expressions","level":"C1","sourceText":"d'autant plus que","translations":{"tr":["üstelik","hele ki"]},"details":{"register":"neutral"},"examples":[{"text":"Je reste, d'autant plus qu'il pleut.","tr":"Kalıyorum, hele ki yağmur yağıyor."}]},
  {"id":"fr-expr-de-sorte-que","languageId":"fr","category":"expressions","level":"C1","sourceText":"de sorte que","translations":{"tr":["öyle ki","böylece"]},"details":{"register":"formal"},"examples":[{"text":"Il a parlé fort, de sorte que tout le monde l'a entendu.","tr":"Yüksek sesle konuştu, öyle ki herkes duydu."}]},
  {"id":"fr-expr-si-bien-que","languageId":"fr","category":"expressions","level":"C1","sourceText":"si bien que","translations":{"tr":["öyle ki","o kadar ki"]},"details":{"register":"formal"},"examples":[{"text":"Il a beaucoup neigé, si bien que l'école a fermé.","tr":"Çok kar yağdı, öyle ki okul kapandı."}]},
  {"id":"fr-expr-a-moins-que","languageId":"fr","category":"expressions","level":"C1","sourceText":"à moins que","translations":{"tr":["-medikçe","… olmadıkça"]},"details":{"usage":"Ardından subjonctif, çoğu zaman ne explétif: à moins qu'il ne pleuve.","register":"formal"},"examples":[{"text":"Je viendrai, à moins qu'il ne pleuve.","tr":"Yağmur yağmadıkça geleceğim."}]},
  {"id":"fr-expr-de-crainte-que","languageId":"fr","category":"expressions","level":"C1","sourceText":"de crainte que","translations":{"tr":["korkusuyla","-mesin diye"]},"details":{"usage":"Ardından subjonctif.","register":"formal"},"examples":[{"text":"Il se tait de crainte qu'on se moque de lui.","tr":"Alay edilmekten korktuğu için susuyor."}]},
  {"id":"fr-expr-pour-autant","languageId":"fr","category":"expressions","level":"C1","sourceText":"pour autant","translations":{"tr":["yine de","bu yüzden … değil"]},"tags":["discourse-marker"],"details":{"usage":"Genelde olumsuzla: Il est riche, mais il n'est pas heureux pour autant.","register":"formal"},"examples":[{"text":"Il a échoué, sans pour autant abandonner.","tr":"Başarısız oldu ama yine de vazgeçmedi."}]},
  {"id":"fr-expr-en-loccurrence","languageId":"fr","category":"expressions","level":"C1","sourceText":"en l'occurrence","translations":{"tr":["bu durumda","söz konusu durumda"]},"details":{"register":"formal"},"examples":[{"text":"Le responsable, en l'occurrence M. Petit, est absent.","tr":"Sorumlu kişi, bu durumda Bay Petit, burada değil."}]},
  {"id":"fr-expr-le-cas-echeant","languageId":"fr","category":"expressions","level":"C1","sourceText":"le cas échéant","translations":{"tr":["gerekirse","icabında"]},"details":{"register":"formal"},"examples":[{"text":"Le cas échéant, nous vous contacterons.","tr":"Gerekirse sizinle iletişime geçeceğiz."}]},
  {"id":"fr-expr-a-cet-egard","languageId":"fr","category":"expressions","level":"C1","sourceText":"à cet égard","translations":{"tr":["bu bakımdan","bu konuda"]},"details":{"register":"formal"},"examples":[{"text":"À cet égard, la loi est très claire.","tr":"Bu konuda yasa çok açık."}]},
  {"id":"fr-expr-compte-tenu-de","languageId":"fr","category":"expressions","level":"C1","sourceText":"compte tenu de","translations":{"tr":["göz önünde bulundurulursa"]},"details":{"register":"formal"},"examples":[{"text":"Compte tenu de la situation, on annule.","tr":"Durum göz önüne alınınca iptal ediyoruz."}]},
  {"id":"fr-expr-dans-la-mesure-ou","languageId":"fr","category":"expressions","level":"C1","sourceText":"dans la mesure où","translations":{"tr":["-diği ölçüde","-diği için"]},"details":{"register":"formal"},"examples":[{"text":"Je t'aiderai dans la mesure où je peux.","tr":"Elimden geldiği ölçüde sana yardım edeceğim."}]},
  {"id":"fr-expr-en-outre","languageId":"fr","category":"expressions","level":"C1","sourceText":"en outre","translations":{"tr":["bunun yanı sıra","ayrıca"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"En outre, le contrat prévoit une pénalité.","tr":"Ayrıca sözleşme bir ceza öngörüyor."}]},
  {"id":"fr-expr-du-reste","languageId":"fr","category":"expressions","level":"C1","sourceText":"du reste","translations":{"tr":["zaten","üstelik"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Il n'est pas venu ; du reste, personne ne l'attendait.","tr":"Gelmedi; zaten kimse de onu beklemiyordu."}]},
  {"id":"fr-expr-or","languageId":"fr","category":"expressions","level":"C1","sourceText":"or","translations":{"tr":["oysa","ne var ki"]},"tags":["discourse-marker"],"details":{"usage":"Akıl yürütmede yeni bir veri sunar; 'altın' (l'or) ile karıştırma.","register":"formal"},"examples":[{"text":"Il devait venir ; or, il n'est pas là.","tr":"Gelmesi gerekiyordu; oysa burada değil."}]},
  {"id":"fr-expr-voire","languageId":"fr","category":"expressions","level":"C1","sourceText":"voire","translations":{"tr":["hatta","hatta ve hatta"]},"details":{"register":"formal"},"examples":[{"text":"Cela prendra des semaines, voire des mois.","tr":"Bu haftalar, hatta aylar sürecek."}]},
  {"id":"fr-expr-a-titre-de","languageId":"fr","category":"expressions","level":"C1","sourceText":"à titre de","translations":{"tr":["olarak","… niteliğinde"]},"details":{"usage":"Sık kalıp: à titre d'exemple, à titre indicatif.","register":"formal"},"examples":[{"text":"À titre d'exemple, prenons la France.","tr":"Örnek olarak Fransa'yı ele alalım."}]},
  {"id":"fr-expr-au-sein-de","languageId":"fr","category":"expressions","level":"C1","sourceText":"au sein de","translations":{"tr":["bünyesinde","içinde"]},"details":{"register":"formal"},"examples":[{"text":"Il travaille au sein d'une grande entreprise.","tr":"Büyük bir şirket bünyesinde çalışıyor."}]},
  {"id":"fr-expr-en-vue-de","languageId":"fr","category":"expressions","level":"C1","sourceText":"en vue de","translations":{"tr":["amacıyla","… için"]},"details":{"register":"formal"},"examples":[{"text":"Il économise en vue de son voyage.","tr":"Seyahati için para biriktiriyor."}]},
  {"id":"fr-expr-a-lissue-de","languageId":"fr","category":"expressions","level":"C1","sourceText":"à l'issue de","translations":{"tr":["sonunda","… bitiminde"]},"details":{"register":"formal"},"examples":[{"text":"À l'issue de la réunion, un accord a été signé.","tr":"Toplantının sonunda bir anlaşma imzalandı."}]},
  {"id":"fr-expr-il-nempeche-que","languageId":"fr","category":"expressions","level":"C1","sourceText":"il n'empêche que","translations":{"tr":["yine de","buna rağmen"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Il est gentil ; il n'empêche qu'il m'a menti.","tr":"Nazik biri; yine de bana yalan söyledi."}]},
  {"id":"fr-expr-toujours-est-il-que","languageId":"fr","category":"expressions","level":"C1","sourceText":"toujours est-il que","translations":{"tr":["ne olursa olsun","gerçek şu ki"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Toujours est-il qu'il n'a pas payé.","tr":"Gerçek şu ki ödemedi."}]},
  {"id":"fr-expr-force-est-de-constater-que","languageId":"fr","category":"expressions","level":"C1","sourceText":"force est de constater que","translations":{"tr":["kabul etmek gerekir ki"]},"details":{"register":"formal"},"examples":[{"text":"Force est de constater que la méthode a échoué.","tr":"Yöntemin başarısız olduğunu kabul etmek gerekir."}]},
  {"id":"fr-expr-il-va-de-soi-que","languageId":"fr","category":"expressions","level":"C1","sourceText":"il va de soi que","translations":{"tr":["söylemeye gerek yok ki","elbette"]},"details":{"register":"formal"},"examples":[{"text":"Il va de soi que vous serez payé.","tr":"Size ödeme yapılacağı söylemeye gerek yok."}]},
  {"id":"fr-expr-il-nen-reste-pas-moins-que","languageId":"fr","category":"expressions","level":"C1","sourceText":"il n'en reste pas moins que","translations":{"tr":["yine de şu bir gerçek ki"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Il n'en reste pas moins que le problème existe.","tr":"Yine de sorunun var olduğu bir gerçek."}]}
]
