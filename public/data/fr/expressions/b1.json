[
  {"id":"fr-expr-selon-moi","languageId":"fr","category":"expressions","level":"B1","sourceText":"selon moi","translations":{"tr":["bana göre","bence"]},"tags":["opinion"],"details":{"register":"neutral"},"examples":[{"text":"Selon moi, il a tort.","tr":"Bana göre haksız."}]},
  {"id":"fr-expr-au-fait","languageId":"fr","category":"expressions","level":"B1","sourceText":"au fait","translations":{"tr":["bu arada","aklıma gelmişken"]},"tags":["discourse-marker"],"details":{"usage":"Konu değiştirirken; en fait ile karıştırılmamalı.","register":"informal"},"examples":[{"text":"Au fait, tu as vu Paul ?","tr":"Bu arada, Paul'ü gördün mü?"}]},
  {"id":"fr-expr-du-coup","languageId":"fr","category":"expressions","level":"B1","sourceText":"du coup","translations":{"tr":["bu yüzden","o yüzden","haliyle"]},"tags":["discourse-marker"],"details":{"usage":"Konuşmada donc yerine çok sık kullanılır.","register":"informal"},"examples":[{"text":"Il pleuvait, du coup on est restés.","tr":"Yağmur yağıyordu, o yüzden kaldık."}]},
  {"id":"fr-expr-en-tout-cas","languageId":"fr","category":"expressions","level":"B1","sourceText":"en tout cas","translations":{"tr":["her halükârda","neyse","her durumda"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"En tout cas, merci pour ton aide.","tr":"Her halükârda, yardımın için teşekkürler."}]},
  {"id":"fr-expr-de-toute-facon","languageId":"fr","category":"expressions","level":"B1","sourceText":"de toute façon","translations":{"tr":["nasılsa","zaten","her türlü"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"De toute façon, c'est trop tard.","tr":"Nasılsa artık çok geç."}]},
  {"id":"fr-expr-dailleurs","languageId":"fr","category":"expressions","level":"B1","sourceText":"d'ailleurs","translations":{"tr":["zaten","hem de","üstelik"]},"tags":["discourse-marker"],"details":{"usage":"Önceki söze ek bir kanıt/bilgi eklerken.","register":"neutral"},"examples":[{"text":"Je n'ai pas faim ; d'ailleurs, j'ai déjà mangé.","tr":"Aç değilim; zaten yemek yedim."}]},
  {"id":"fr-expr-en-revanche","languageId":"fr","category":"expressions","level":"B1","sourceText":"en revanche","translations":{"tr":["buna karşılık","oysa"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Il est timide ; en revanche, sa sœur parle beaucoup.","tr":"O utangaç; buna karşılık kız kardeşi çok konuşuyor."}]},
  {"id":"fr-expr-pourtant","languageId":"fr","category":"expressions","level":"B1","sourceText":"pourtant","translations":{"tr":["oysa","halbuki","yine de"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Il a échoué ; pourtant, il avait travaillé.","tr":"Başarısız oldu; oysa çalışmıştı."}]},
  {"id":"fr-expr-bref","languageId":"fr","category":"expressions","level":"B1","sourceText":"bref","translations":{"tr":["kısacası","neyse"]},"tags":["discourse-marker"],"details":{"usage":"Anlatımı kısa kesip özetlerken.","register":"informal"},"examples":[{"text":"Bref, on a raté le train.","tr":"Kısacası, treni kaçırdık."}]},
  {"id":"fr-expr-de-plus","languageId":"fr","category":"expressions","level":"B1","sourceText":"de plus","translations":{"tr":["ayrıca","bunun yanı sıra"]},"tags":["discourse-marker"],"details":{"usage":"en plus'ın daha yazılı/resmî karşılığı.","register":"formal"},"examples":[{"text":"De plus, le prix est raisonnable.","tr":"Ayrıca fiyatı makul."}]},
  {"id":"fr-expr-cest-pourquoi","languageId":"fr","category":"expressions","level":"B1","sourceText":"c'est pourquoi","translations":{"tr":["bu nedenle","işte bu yüzden"]},"details":{"register":"formal"},"examples":[{"text":"Il pleut, c'est pourquoi le match est annulé.","tr":"Yağmur yağıyor, bu nedenle maç iptal edildi."}]},
  {"id":"fr-expr-a-la-fois","languageId":"fr","category":"expressions","level":"B1","sourceText":"à la fois","translations":{"tr":["aynı anda","hem … hem"]},"details":{"register":"neutral"},"examples":[{"text":"Elle est à la fois drôle et intelligente.","tr":"Hem komik hem zeki."}]},
  {"id":"fr-expr-pas-mal-de","languageId":"fr","category":"expressions","level":"B1","sourceText":"pas mal de","translations":{"tr":["epey","bir hayli"]},"details":{"usage":"'Kötü değil' değil, 'oldukça çok' anlamında.","register":"informal"},"examples":[{"text":"Il y a pas mal de touristes ici.","tr":"Burada epey turist var."}]},
  {"id":"fr-expr-a-lavance","languageId":"fr","category":"expressions","level":"B1","sourceText":"à l'avance","translations":{"tr":["önceden","peşin"]},"details":{"register":"neutral"},"examples":[{"text":"Il faut réserver à l'avance.","tr":"Önceden rezervasyon yapmak gerekiyor."}]},
  {"id":"fr-expr-a-temps","languageId":"fr","category":"expressions","level":"B1","sourceText":"à temps","translations":{"tr":["vaktinde","zamanında"]},"details":{"usage":"Bir şey için yetişmek: arriver à temps pour le train.","register":"neutral"},"examples":[{"text":"On est arrivés juste à temps.","tr":"Tam vaktinde yetiştik."}]},
  {"id":"fr-expr-au-bout-de","languageId":"fr","category":"expressions","level":"B1","sourceText":"au bout de","translations":{"tr":["sonunda","-in ucunda","… sonra"]},"details":{"usage":"Yer: au bout de la rue; zaman: au bout d'une heure.","register":"neutral"},"examples":[{"text":"C'est au bout de la rue.","tr":"Sokağın sonunda."}]},
  {"id":"fr-expr-pendant-que","languageId":"fr","category":"expressions","level":"B1","sourceText":"pendant que","translations":{"tr":["-ken","-diği sırada"]},"details":{"register":"neutral"},"examples":[{"text":"Il lit pendant que je cuisine.","tr":"Ben yemek yaparken o kitap okuyor."}]},
  {"id":"fr-expr-apres-avoir","languageId":"fr","category":"expressions","level":"B1","sourceText":"après avoir","translations":{"tr":["-dikten sonra"]},"details":{"usage":"Geçmiş mastarla: après avoir mangé, après être sorti.","register":"neutral"},"examples":[{"text":"Après avoir dîné, on est sortis.","tr":"Akşam yemeğini yedikten sonra dışarı çıktık."}]},
  {"id":"fr-expr-des-que","languageId":"fr","category":"expressions","level":"B1","sourceText":"dès que","translations":{"tr":["-ir -mez","-dığı anda"]},"details":{"usage":"Gelecek için futur kullanılır: dès que j'arriverai.","register":"neutral"},"examples":[{"text":"Appelle-moi dès que tu arrives.","tr":"Varır varmaz beni ara."}]},
  {"id":"fr-expr-depuis-que","languageId":"fr","category":"expressions","level":"B1","sourceText":"depuis que","translations":{"tr":["-den beri"]},"details":{"register":"neutral"},"examples":[{"text":"Depuis qu'il habite ici, il est heureux.","tr":"Burada yaşadığından beri mutlu."}]},
  {"id":"fr-expr-il-y-a-que","languageId":"fr","category":"expressions","level":"B1","sourceText":"il y a … que","translations":{"tr":["…'dir","… zamandır"]},"details":{"usage":"Süre vurgusu: Il y a trois ans que je l'attends.","register":"neutral"},"examples":[{"text":"Il y a deux heures que je t'attends !","tr":"İki saattir seni bekliyorum!"}]},
  {"id":"fr-expr-etre-sur-le-point-de","languageId":"fr","category":"expressions","level":"B1","sourceText":"être sur le point de","translations":{"tr":["… -mak üzere olmak"]},"details":{"register":"neutral"},"examples":[{"text":"Le train est sur le point de partir.","tr":"Tren kalkmak üzere."}]},
  {"id":"fr-expr-il-sagit-de","languageId":"fr","category":"expressions","level":"B1","sourceText":"il s'agit de","translations":{"tr":["söz konusu olan","konu …"]},"details":{"usage":"Özne her zaman il: il s'agit de ton avenir.","register":"neutral"},"examples":[{"text":"Dans ce livre, il s'agit d'une famille pauvre.","tr":"Bu kitap yoksul bir aile hakkında."}]},
  {"id":"fr-expr-il-vaut-mieux","languageId":"fr","category":"expressions","level":"B1","sourceText":"il vaut mieux","translations":{"tr":["… daha iyi olur"]},"details":{"usage":"Ardından mastar ya da que + subjonctif.","register":"neutral"},"examples":[{"text":"Il vaut mieux partir tôt.","tr":"Erken çıkmak daha iyi olur."}]},
  {"id":"fr-expr-a-propos-de","languageId":"fr","category":"expressions","level":"B1","sourceText":"à propos de","translations":{"tr":["hakkında","… konusunda"]},"details":{"usage":"Tek başına À propos ! = Aklıma gelmişken!","register":"neutral"},"examples":[{"text":"Je voudrais vous parler à propos de votre fils.","tr":"Oğlunuz hakkında sizinle konuşmak istiyorum."}]},
  {"id":"fr-expr-en-ce-qui-concerne","languageId":"fr","category":"expressions","level":"B1","sourceText":"en ce qui concerne","translations":{"tr":["… konusuna gelince","… ile ilgili olarak"]},"details":{"register":"formal"},"examples":[{"text":"En ce qui concerne le prix, on peut discuter.","tr":"Fiyata gelince, konuşabiliriz."}]},
  {"id":"fr-expr-par-consequent","languageId":"fr","category":"expressions","level":"B1","sourceText":"par conséquent","translations":{"tr":["sonuç olarak","bu nedenle"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Le train est en grève ; par conséquent, je prends la voiture.","tr":"Trenler grevde; bu nedenle arabayla gidiyorum."}]},
  {"id":"fr-expr-en-effet","languageId":"fr","category":"expressions","level":"B1","sourceText":"en effet","translations":{"tr":["gerçekten de","nitekim","çünkü"]},"tags":["discourse-marker"],"details":{"usage":"Önceki sözü doğrular veya gerekçelendirir; en fait ile karıştırma.","register":"formal"},"examples":[{"text":"Il est fatigué ; en effet, il a peu dormi.","tr":"Yorgun; nitekim az uyudu."}]},
  {"id":"fr-expr-cependant","languageId":"fr","category":"expressions","level":"B1","sourceText":"cependant","translations":{"tr":["ancak","bununla birlikte"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Le projet est intéressant ; cependant, il coûte cher.","tr":"Proje ilginç; ancak pahalı."}]},
  {"id":"fr-expr-dune-part-dautre-part","languageId":"fr","category":"expressions","level":"B1","sourceText":"d'une part … d'autre part","translations":{"tr":["bir yandan … öte yandan"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"D'une part c'est cher, d'autre part c'est loin.","tr":"Bir yandan pahalı, öte yandan uzak."}]},
  {"id":"fr-expr-dun-cote-de-lautre","languageId":"fr","category":"expressions","level":"B1","sourceText":"d'un côté … de l'autre","translations":{"tr":["bir taraftan … diğer taraftan"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"D'un côté j'ai envie de partir, de l'autre j'ai peur.","tr":"Bir taraftan gitmek istiyorum, diğer taraftan korkuyorum."}]},
  {"id":"fr-expr-tout-dabord","languageId":"fr","category":"expressions","level":"B1","sourceText":"tout d'abord","translations":{"tr":["her şeyden önce","ilk olarak"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Tout d'abord, merci d'être venus.","tr":"Her şeyden önce, geldiğiniz için teşekkürler."}]},
  {"id":"fr-expr-pour-conclure","languageId":"fr","category":"expressions","level":"B1","sourceText":"pour conclure","translations":{"tr":["sonuç olarak","son olarak"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Pour conclure, je dirais que tout s'est bien passé.","tr":"Sonuç olarak her şeyin iyi geçtiğini söyleyebilirim."}]},
  {"id":"fr-expr-en-resume","languageId":"fr","category":"expressions","level":"B1","sourceText":"en résumé","translations":{"tr":["özetle"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"En résumé, le projet est un succès.","tr":"Özetle, proje başarılı."}]},
  {"id":"fr-expr-en-bref","languageId":"fr","category":"expressions","level":"B1","sourceText":"en bref","translations":{"tr":["kısaca","kısacası"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"En bref, tout va bien.","tr":"Kısacası, her şey yolunda."}]},
  {"id":"fr-expr-autrement-dit","languageId":"fr","category":"expressions","level":"B1","sourceText":"autrement dit","translations":{"tr":["başka bir deyişle","yani"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Il est parti sans payer, autrement dit il a volé.","tr":"Ödemeden gitti, başka bir deyişle çaldı."}]},
  {"id":"fr-expr-a-vrai-dire","languageId":"fr","category":"expressions","level":"B1","sourceText":"à vrai dire","translations":{"tr":["doğrusu","açıkçası"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"À vrai dire, je n'y ai pas pensé.","tr":"Doğrusu, bunu hiç düşünmedim."}]},
  {"id":"fr-expr-en-realite","languageId":"fr","category":"expressions","level":"B1","sourceText":"en réalité","translations":{"tr":["gerçekte","aslında"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Il a l'air sévère, mais en réalité il est gentil.","tr":"Sert görünüyor ama aslında nazik biri."}]},
  {"id":"fr-expr-franchement","languageId":"fr","category":"expressions","level":"B1","sourceText":"franchement","translations":{"tr":["açıkçası","dürüst olmak gerekirse"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Franchement, ce film était nul.","tr":"Açıkçası bu film berbattı."}]},
  {"id":"fr-expr-dapres-moi","languageId":"fr","category":"expressions","level":"B1","sourceText":"d'après moi","translations":{"tr":["bana göre"]},"tags":["opinion"],"details":{"register":"neutral"},"examples":[{"text":"D'après moi, il ne viendra pas.","tr":"Bana göre gelmeyecek."}]},
  {"id":"fr-expr-il-me-semble-que","languageId":"fr","category":"expressions","level":"B1","sourceText":"il me semble que","translations":{"tr":["bana öyle geliyor ki","sanki"]},"tags":["opinion"],"details":{"register":"neutral"},"examples":[{"text":"Il me semble qu'il a changé.","tr":"Bana öyle geliyor ki değişmiş."}]},
  {"id":"fr-expr-il-est-vrai-que","languageId":"fr","category":"expressions","level":"B1","sourceText":"il est vrai que","translations":{"tr":["doğrudur ki","gerçi"]},"tags":["discourse-marker"],"details":{"usage":"Bir noktayı kabul edip karşı görüşe geçerken.","register":"neutral"},"examples":[{"text":"Il est vrai que c'est cher, mais c'est de qualité.","tr":"Pahalı olduğu doğru ama kaliteli."}]},
  {"id":"fr-expr-malgre-tout","languageId":"fr","category":"expressions","level":"B1","sourceText":"malgré tout","translations":{"tr":["her şeye rağmen"]},"details":{"register":"neutral"},"examples":[{"text":"Malgré tout, je garde espoir.","tr":"Her şeye rağmen umudumu koruyorum."}]},
  {"id":"fr-expr-malgre","languageId":"fr","category":"expressions","level":"B1","sourceText":"malgré","translations":{"tr":["-e rağmen"]},"details":{"usage":"Ardından isim: malgré la pluie.","register":"neutral"},"examples":[{"text":"Ils sont sortis malgré la pluie.","tr":"Yağmura rağmen dışarı çıktılar."}]},
  {"id":"fr-expr-pour-que","languageId":"fr","category":"expressions","level":"B1","sourceText":"pour que","translations":{"tr":["-sin diye","-mesi için"]},"details":{"usage":"Ardından subjonctif: pour que tu comprennes.","register":"neutral"},"examples":[{"text":"Je parle lentement pour que tu comprennes.","tr":"Anlayasın diye yavaş konuşuyorum."}]},
  {"id":"fr-expr-afin-de","languageId":"fr","category":"expressions","level":"B1","sourceText":"afin de","translations":{"tr":["-mek için","amacıyla"]},"details":{"usage":"pour'un daha resmî karşılığı; ardından mastar.","register":"formal"},"examples":[{"text":"Il travaille afin de payer ses études.","tr":"Okul masrafını ödemek için çalışıyor."}]},
  {"id":"fr-expr-au-cas-ou","languageId":"fr","category":"expressions","level":"B1","sourceText":"au cas où","translations":{"tr":["olur da","ne olur ne olmaz"]},"details":{"usage":"Ardından conditionnel: au cas où il pleuvrait.","register":"neutral"},"examples":[{"text":"Prends un parapluie, au cas où.","tr":"Ne olur ne olmaz, şemsiye al."}]},
  {"id":"fr-expr-sauf-si","languageId":"fr","category":"expressions","level":"B1","sourceText":"sauf si","translations":{"tr":["-medikçe","… olmadıkça"]},"details":{"register":"neutral"},"examples":[{"text":"On sort, sauf s'il pleut.","tr":"Yağmur yağmadıkça dışarı çıkıyoruz."}]},
  {"id":"fr-expr-meme-si","languageId":"fr","category":"expressions","level":"B1","sourceText":"même si","translations":{"tr":["-se bile"]},"details":{"register":"neutral"},"examples":[{"text":"Je viendrai, même s'il neige.","tr":"Kar yağsa bile geleceğim."}]},
  {"id":"fr-expr-comme-si","languageId":"fr","category":"expressions","level":"B1","sourceText":"comme si","translations":{"tr":["-mış gibi"]},"details":{"usage":"Ardından imparfait veya plus-que-parfait.","register":"neutral"},"examples":[{"text":"Il parle comme s'il savait tout.","tr":"Her şeyi biliyormuş gibi konuşuyor."}]},
  {"id":"fr-expr-alors-que","languageId":"fr","category":"expressions","level":"B1","sourceText":"alors que","translations":{"tr":["oysa","halbuki","-iken"]},"details":{"register":"neutral"},"examples":[{"text":"Il est sorti alors qu'il était malade.","tr":"Hasta olduğu halde dışarı çıktı."}]},
  {"id":"fr-expr-puisque","languageId":"fr","category":"expressions","level":"B1","sourceText":"puisque","translations":{"tr":["madem","-diğine göre"]},"details":{"usage":"Sebep bilinen/açık olduğunda.","register":"neutral"},"examples":[{"text":"Puisque tu es là, aide-moi.","tr":"Madem buradasın, bana yardım et."}]},
  {"id":"fr-expr-comme","languageId":"fr","category":"expressions","level":"B1","sourceText":"comme","translations":{"tr":["-diği için","madem"]},"details":{"usage":"Sebep anlamında cümle başında gelir.","register":"neutral"},"examples":[{"text":"Comme il pleuvait, on est restés à la maison.","tr":"Yağmur yağdığı için evde kaldık."}]},
  {"id":"fr-expr-peu-a-peu","languageId":"fr","category":"expressions","level":"B1","sourceText":"peu à peu","translations":{"tr":["azar azar","yavaş yavaş"]},"details":{"register":"neutral"},"examples":[{"text":"Peu à peu, il a appris la langue.","tr":"Yavaş yavaş dili öğrendi."}]},
  {"id":"fr-expr-petit-a-petit","languageId":"fr","category":"expressions","level":"B1","sourceText":"petit à petit","translations":{"tr":["yavaş yavaş","adım adım"]},"details":{"register":"neutral"},"examples":[{"text":"Petit à petit, la ville se réveille.","tr":"Yavaş yavaş şehir uyanıyor."}]},
  {"id":"fr-expr-de-plus-en-plus","languageId":"fr","category":"expressions","level":"B1","sourceText":"de plus en plus","translations":{"tr":["gittikçe daha","giderek"]},"details":{"usage":"Zıttı: de moins en moins.","register":"neutral"},"examples":[{"text":"Il fait de plus en plus chaud.","tr":"Hava giderek ısınıyor."}]},
  {"id":"fr-expr-de-moins-en-moins","languageId":"fr","category":"expressions","level":"B1","sourceText":"de moins en moins","translations":{"tr":["gittikçe daha az"]},"details":{"register":"neutral"},"examples":[{"text":"Les jeunes lisent de moins en moins.","tr":"Gençler gittikçe daha az okuyor."}]},
  {"id":"fr-expr-plus-ou-moins","languageId":"fr","category":"expressions","level":"B1","sourceText":"plus ou moins","translations":{"tr":["aşağı yukarı","az çok"]},"details":{"register":"neutral"},"examples":[{"text":"J'ai plus ou moins compris.","tr":"Az çok anladım."}]},
  {"id":"fr-expr-en-principe","languageId":"fr","category":"expressions","level":"B1","sourceText":"en principe","translations":{"tr":["normalde","prensipte"]},"details":{"register":"neutral"},"examples":[{"text":"En principe, il arrive à huit heures.","tr":"Normalde saat sekizde gelir."}]},
  {"id":"fr-expr-en-tout","languageId":"fr","category":"expressions","level":"B1","sourceText":"en tout","translations":{"tr":["toplamda"]},"details":{"register":"neutral"},"examples":[{"text":"Ça fait cinquante euros en tout.","tr":"Toplamda elli euro ediyor."}]},
  {"id":"fr-expr-au-total","languageId":"fr","category":"expressions","level":"B1","sourceText":"au total","translations":{"tr":["toplam olarak"]},"details":{"register":"neutral"},"examples":[{"text":"Au total, nous étions vingt.","tr":"Toplam yirmi kişiydik."}]},
  {"id":"fr-expr-en-particulier","languageId":"fr","category":"expressions","level":"B1","sourceText":"en particulier","translations":{"tr":["özellikle"]},"details":{"register":"neutral"},"examples":[{"text":"J'aime la musique, en particulier le jazz.","tr":"Müziği severim, özellikle cazı."}]},
  {"id":"fr-expr-a-part","languageId":"fr","category":"expressions","level":"B1","sourceText":"à part","translations":{"tr":["dışında","hariç"]},"details":{"register":"neutral"},"examples":[{"text":"À part ça, tout va bien ?","tr":"Bunun dışında her şey yolunda mı?"}]},
  {"id":"fr-expr-par-rapport-a","languageId":"fr","category":"expressions","level":"B1","sourceText":"par rapport à","translations":{"tr":["… göre","… ile kıyasla"]},"details":{"register":"neutral"},"examples":[{"text":"Par rapport à l'an dernier, les prix ont augmenté.","tr":"Geçen yıla göre fiyatlar arttı."}]},
  {"id":"fr-expr-nimporte-ou","languageId":"fr","category":"expressions","level":"B1","sourceText":"n'importe où","translations":{"tr":["herhangi bir yer","nereye olursa"]},"details":{"register":"neutral"},"examples":[{"text":"On peut s'asseoir n'importe où.","tr":"Herhangi bir yere oturabiliriz."}]},
  {"id":"fr-expr-nimporte-quand","languageId":"fr","category":"expressions","level":"B1","sourceText":"n'importe quand","translations":{"tr":["ne zaman olursa","her an"]},"details":{"register":"neutral"},"examples":[{"text":"Appelle-moi n'importe quand.","tr":"Beni istediğin zaman ara."}]},
  {"id":"fr-expr-nimporte-qui","languageId":"fr","category":"expressions","level":"B1","sourceText":"n'importe qui","translations":{"tr":["herhangi biri","kim olsa"]},"details":{"register":"neutral"},"examples":[{"text":"N'importe qui peut le faire.","tr":"Bunu herkes yapabilir."}]},
  {"id":"fr-expr-a-peine","languageId":"fr","category":"expressions","level":"B1","sourceText":"à peine","translations":{"tr":["ancak","güç bela","henüz"]},"details":{"usage":"'Zar zor' ya da 'tam … -mıştı ki' anlamı.","register":"neutral"},"examples":[{"text":"Je le connais à peine.","tr":"Onu zar zor tanıyorum."}]},
  {"id":"fr-expr-apres-tout","languageId":"fr","category":"expressions","level":"B1","sourceText":"après tout","translations":{"tr":["sonuçta","ne de olsa"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Après tout, c'est ton choix.","tr":"Ne de olsa bu senin seçimin."}]},
  {"id":"fr-expr-ainsi","languageId":"fr","category":"expressions","level":"B1","sourceText":"ainsi","translations":{"tr":["böylece","bu şekilde"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Ainsi, nous pourrons gagner du temps.","tr":"Böylece zaman kazanabiliriz."}]},
  {"id":"fr-expr-ni-ni","languageId":"fr","category":"expressions","level":"B1","sourceText":"ni … ni","translations":{"tr":["ne … ne"]},"details":{"usage":"Fiilden önce ne gelir: Je n'aime ni le thé ni le café.","register":"neutral"},"examples":[{"text":"Il ne boit ni vin ni bière.","tr":"Ne şarap ne bira içiyor."}]},
  {"id":"fr-expr-tot-ou-tard","languageId":"fr","category":"expressions","level":"B1","sourceText":"tôt ou tard","translations":{"tr":["er ya da geç"]},"details":{"register":"neutral"},"examples":[{"text":"Tôt ou tard, il comprendra.","tr":"Er ya da geç anlayacak."}]},
