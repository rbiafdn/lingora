[
  {"id":"fr-expr-quant-a","languageId":"fr","category":"expressions","level":"B2","sourceText":"quant à","translations":{"tr":["…'e gelince"]},"details":{"register":"formal"},"examples":[{"text":"Quant à moi, je reste ici.","tr":"Bana gelince, ben burada kalıyorum."}]},
  {"id":"fr-expr-neanmoins","languageId":"fr","category":"expressions","level":"B2","sourceText":"néanmoins","translations":{"tr":["yine de","buna rağmen"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"C'était difficile, néanmoins nous avons réussi.","tr":"Zordu, buna rağmen başardık."}]},
  {"id":"fr-expr-toutefois","languageId":"fr","category":"expressions","level":"B2","sourceText":"toutefois","translations":{"tr":["bununla beraber","ne var ki"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"L'idée est bonne ; toutefois, elle n'est pas réaliste.","tr":"Fikir iyi; ne var ki gerçekçi değil."}]},
  {"id":"fr-expr-en-premier-lieu","languageId":"fr","category":"expressions","level":"B2","sourceText":"en premier lieu","translations":{"tr":["ilk olarak","öncelikle"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"En premier lieu, je voudrais vous remercier.","tr":"Öncelikle size teşekkür etmek isterim."}]},
  {"id":"fr-expr-en-somme","languageId":"fr","category":"expressions","level":"B2","sourceText":"en somme","translations":{"tr":["sonuçta","özetle"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"En somme, ce fut une belle soirée.","tr":"Sonuçta güzel bir akşamdı."}]},
  {"id":"fr-expr-en-dautres-termes","languageId":"fr","category":"expressions","level":"B2","sourceText":"en d'autres termes","translations":{"tr":["başka bir deyişle"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"En d'autres termes, nous devons économiser.","tr":"Başka bir deyişle, tasarruf etmeliyiz."}]},
  {"id":"fr-expr-a-mon-sens","languageId":"fr","category":"expressions","level":"B2","sourceText":"à mon sens","translations":{"tr":["bence","kanımca"]},"tags":["opinion"],"details":{"register":"formal"},"examples":[{"text":"À mon sens, cette décision est une erreur.","tr":"Kanımca bu karar bir hata."}]},
  {"id":"fr-expr-certes","languageId":"fr","category":"expressions","level":"B2","sourceText":"certes","translations":{"tr":["elbette","gerçi"]},"tags":["discourse-marker"],"details":{"usage":"Genelde ardından mais gelir: certes…, mais…","register":"formal"},"examples":[{"text":"Certes, il est jeune, mais il est compétent.","tr":"Gerçi genç ama yetkin."}]},
  {"id":"fr-expr-bien-que","languageId":"fr","category":"expressions","level":"B2","sourceText":"bien que","translations":{"tr":["-diği halde","-e rağmen"]},"details":{"usage":"Ardından subjonctif gelir: bien qu'il soit malade.","register":"neutral"},"examples":[{"text":"Bien qu'il soit tard, je ne suis pas fatigué.","tr":"Geç olmasına rağmen yorgun değilim."}]},
  {"id":"fr-expr-a-condition-que","languageId":"fr","category":"expressions","level":"B2","sourceText":"à condition que","translations":{"tr":["şartıyla","yeter ki"]},"details":{"usage":"Ardından subjonctif.","register":"neutral"},"examples":[{"text":"Je viens, à condition que tu conduises.","tr":"Gelirim, yeter ki sen sür."}]},
  {"id":"fr-expr-tandis-que","languageId":"fr","category":"expressions","level":"B2","sourceText":"tandis que","translations":{"tr":["oysa","-iken"]},"details":{"register":"formal"},"examples":[{"text":"Il aime la ville, tandis que sa femme préfère la campagne.","tr":"O şehri seviyor, oysa karısı kırsalı tercih ediyor."}]},
  {"id":"fr-expr-etant-donne-que","languageId":"fr","category":"expressions","level":"B2","sourceText":"étant donné que","translations":{"tr":["göz önüne alınırsa","-diğine göre"]},"details":{"register":"formal"},"examples":[{"text":"Étant donné qu'il est absent, on reporte la réunion.","tr":"Kendisi olmadığına göre toplantıyı erteliyoruz."}]},
  {"id":"fr-expr-vu-que","languageId":"fr","category":"expressions","level":"B2","sourceText":"vu que","translations":{"tr":["-diğine göre","madem"]},"details":{"register":"informal"},"examples":[{"text":"Vu qu'il fait beau, on mange dehors.","tr":"Hava güzel olduğuna göre dışarıda yiyelim."}]},
  {"id":"fr-expr-a-force-de","languageId":"fr","category":"expressions","level":"B2","sourceText":"à force de","translations":{"tr":["… -e -e","çok … sonucunda"]},"details":{"register":"neutral"},"examples":[{"text":"À force de travailler, il a réussi.","tr":"Çalışa çalışa başardı."}]},
  {"id":"fr-expr-au-fur-et-a-mesure","languageId":"fr","category":"expressions","level":"B2","sourceText":"au fur et à mesure","translations":{"tr":["yavaş yavaş","… oldukça"]},"details":{"register":"neutral"},"examples":[{"text":"Je range au fur et à mesure.","tr":"Kullandıkça topluyorum."}]},
  {"id":"fr-expr-a-priori","languageId":"fr","category":"expressions","level":"B2","sourceText":"a priori","translations":{"tr":["ilk bakışta","şimdilik"]},"details":{"usage":"Konuşmada 'normalde, öyle görünüyor' anlamında sık.","register":"neutral"},"examples":[{"text":"A priori, ça devrait marcher.","tr":"İlk bakışta işe yaraması lazım."}]},
  {"id":"fr-expr-notamment","languageId":"fr","category":"expressions","level":"B2","sourceText":"notamment","translations":{"tr":["özellikle","başta … olmak üzere"]},"details":{"register":"formal"},"examples":[{"text":"Plusieurs pays, notamment la France, ont voté pour.","tr":"Başta Fransa olmak üzere birçok ülke lehte oy verdi."}]},
  {"id":"fr-expr-y-compris","languageId":"fr","category":"expressions","level":"B2","sourceText":"y compris","translations":{"tr":["dahil"]},"details":{"register":"neutral"},"examples":[{"text":"Tout le monde est invité, y compris les enfants.","tr":"Çocuklar dahil herkes davetli."}]},
  {"id":"fr-expr-en-dehors-de","languageId":"fr","category":"expressions","level":"B2","sourceText":"en dehors de","translations":{"tr":["dışında"]},"details":{"register":"neutral"},"examples":[{"text":"En dehors du travail, il fait de la musique.","tr":"İş dışında müzikle uğraşıyor."}]},
  {"id":"fr-expr-vis-a-vis-de","languageId":"fr","category":"expressions","level":"B2","sourceText":"vis-à-vis de","translations":{"tr":["… karşı","… ile ilgili olarak"]},"details":{"register":"neutral"},"examples":[{"text":"Je me sens coupable vis-à-vis d'elle.","tr":"Ona karşı kendimi suçlu hissediyorum."}]},
  {"id":"fr-expr-grosso-modo","languageId":"fr","category":"expressions","level":"B2","sourceText":"grosso modo","translations":{"tr":["kabaca","aşağı yukarı"]},"details":{"register":"informal"},"examples":[{"text":"Grosso modo, il faut deux jours.","tr":"Kabaca iki gün gerekiyor."}]},
  {"id":"fr-expr-du-moins","languageId":"fr","category":"expressions","level":"B2","sourceText":"du moins","translations":{"tr":["en azından"]},"details":{"usage":"Önceki sözü sınırlar/düzeltir.","register":"neutral"},"examples":[{"text":"Il est content, du moins il le dit.","tr":"Memnun, en azından öyle diyor."}]},
  {"id":"fr-expr-a-la-limite","languageId":"fr","category":"expressions","level":"B2","sourceText":"à la limite","translations":{"tr":["en fazla","olmadı","neyse ki"]},"details":{"usage":"Konuşmada 'olmadı şöyle yaparız' anlamında.","register":"informal"},"examples":[{"text":"À la limite, on peut prendre un taxi.","tr":"Olmadı taksiye bineriz."}]},
  {"id":"fr-expr-quoi-quil-en-soit","languageId":"fr","category":"expressions","level":"B2","sourceText":"quoi qu'il en soit","translations":{"tr":["ne olursa olsun","her neyse"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Quoi qu'il en soit, nous partons demain.","tr":"Ne olursa olsun yarın gidiyoruz."}]},
  {"id":"fr-expr-quoi-quil-arrive","languageId":"fr","category":"expressions","level":"B2","sourceText":"quoi qu'il arrive","translations":{"tr":["ne olursa olsun"]},"details":{"register":"neutral"},"examples":[{"text":"Quoi qu'il arrive, je serai là.","tr":"Ne olursa olsun yanında olacağım."}]},
  {"id":"fr-expr-a-tout-prix","languageId":"fr","category":"expressions","level":"B2","sourceText":"à tout prix","translations":{"tr":["ne pahasına olursa olsun"]},"details":{"register":"neutral"},"examples":[{"text":"Il veut gagner à tout prix.","tr":"Ne pahasına olursa olsun kazanmak istiyor."}]},
  {"id":"fr-expr-tant-que","languageId":"fr","category":"expressions","level":"B2","sourceText":"tant que","translations":{"tr":["-dikçe","-diği sürece"]},"details":{"register":"neutral"},"examples":[{"text":"Tant que tu es là, tout va bien.","tr":"Sen burada olduğun sürece her şey yolunda."}]},
  {"id":"fr-expr-en-fin-de-compte","languageId":"fr","category":"expressions","level":"B2","sourceText":"en fin de compte","translations":{"tr":["sonuçta","neticede"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"En fin de compte, on a eu raison.","tr":"Sonuçta haklı çıktık."}]},
  {"id":"fr-expr-au-bout-du-compte","languageId":"fr","category":"expressions","level":"B2","sourceText":"au bout du compte","translations":{"tr":["sonuçta","eninde sonunda"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Au bout du compte, ça n'a rien changé.","tr":"Sonuçta hiçbir şey değişmedi."}]},
  {"id":"fr-expr-par-ailleurs","languageId":"fr","category":"expressions","level":"B2","sourceText":"par ailleurs","translations":{"tr":["öte yandan","ayrıca"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Par ailleurs, il faut noter que les coûts augmentent.","tr":"Ayrıca maliyetlerin arttığını belirtmek gerekir."}]},
  {"id":"fr-expr-cest-ainsi-que","languageId":"fr","category":"expressions","level":"B2","sourceText":"c'est ainsi que","translations":{"tr":["işte böylece","bu şekilde"]},"details":{"register":"neutral"},"examples":[{"text":"C'est ainsi qu'ils se sont rencontrés.","tr":"İşte böyle tanıştılar."}]},
  {"id":"fr-expr-soit-soit","languageId":"fr","category":"expressions","level":"B2","sourceText":"soit … soit","translations":{"tr":["ya … ya"]},"details":{"register":"neutral"},"examples":[{"text":"On part soit lundi, soit mardi.","tr":"Ya pazartesi ya salı gidiyoruz."}]},
  {"id":"fr-expr-non-seulement-mais-aussi","languageId":"fr","category":"expressions","level":"B2","sourceText":"non seulement … mais aussi","translations":{"tr":["sadece … değil, aynı zamanda"]},"details":{"register":"neutral"},"examples":[{"text":"Elle parle non seulement anglais, mais aussi chinois.","tr":"Sadece İngilizce değil, Çince de konuşuyor."}]},
  {"id":"fr-expr-autant-que","languageId":"fr","category":"expressions","level":"B2","sourceText":"autant que","translations":{"tr":["… kadar"]},"details":{"register":"neutral"},"examples":[{"text":"Il travaille autant que moi.","tr":"O da benim kadar çalışıyor."}]},
  {"id":"fr-expr-une-fois-pour-toutes","languageId":"fr","category":"expressions","level":"B2","sourceText":"une fois pour toutes","translations":{"tr":["kesin olarak","son kez ve kesin"]},"details":{"register":"neutral"},"examples":[{"text":"Réglons ce problème une fois pour toutes.","tr":"Bu sorunu kesin olarak çözelim."}]},
  {"id":"fr-expr-dans-le-fond","languageId":"fr","category":"expressions","level":"B2","sourceText":"dans le fond","translations":{"tr":["aslında","özünde"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Dans le fond, il n'a pas tort.","tr":"Aslında haksız değil."}]},
  {"id":"fr-expr-en-tant-que","languageId":"fr","category":"expressions","level":"B2","sourceText":"en tant que","translations":{"tr":["olarak","sıfatıyla"]},"details":{"register":"neutral"},"examples":[{"text":"Il travaille en tant que traducteur.","tr":"Çevirmen olarak çalışıyor."}]},
  {"id":"fr-expr-lors-de","languageId":"fr","category":"expressions","level":"B2","sourceText":"lors de","translations":{"tr":["sırasında","… esnasında"]},"details":{"register":"formal"},"examples":[{"text":"Je l'ai rencontré lors d'un voyage.","tr":"Onunla bir seyahat sırasında tanıştım."}]}
