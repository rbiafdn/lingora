  {"id":"fr-slang-con-conne","languageId":"fr","category":"slang","level":"B2","sourceText":"con / conne","translations":{"tr":["aptal","salak"]},"details":{"usage":"Hakaret; arkadaşlar arasında \"c'est con\" = saçma, yazık.","register":"offensive"},"examples":[{"text":"C'est con, on a raté le début du film.","tr":"Yazık, filmin başını kaçırdık."}]},
  {"id":"fr-slang-degueulasse","languageId":"fr","category":"slang","level":"B2","sourceText":"dégueulasse","translations":{"tr":["iğrenç","pis"]},"details":{"usage":"Kısaca \"dégueu\"; hafif kaba.","register":"informal"},"examples":[{"text":"Ce café est dégueulasse.","tr":"Bu kahve iğrenç."}]},
