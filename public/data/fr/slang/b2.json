  {"id":"fr-slang-vla","languageId":"fr","category":"slang","level":"B2","sourceText":"v'là","translations":{"tr":["işte"]},"tags":["reduced-form"],"details":{"register":"informal","expansion":"voilà"},"examples":[{"text":"V'là le bus !","tr":"İşte otobüs!"}]},
