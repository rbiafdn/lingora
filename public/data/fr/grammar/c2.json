[
  {"id":"fr-gr-le-passe-simple","languageId":"fr","category":"grammar","level":"C2","sourceText":"Le passé simple","translations":{"tr":["Basit geçmiş zaman (yazı dili)"]},"grammar":{"summary":"Edebî ve tarihî metinlerde kullanılan, geçmişte bitmiş eylemleri anlatan yazı dili zamanıdır; konuşmada passé composé kullanılır.","uses":["Romanlarda, masallarda, tarih kitaplarında","Biyografi ve resmî anlatılarda","Okurken tanımak için öğrenilir (aktif kullanım nadir)"],"sections":[{"kind":"affirmative","title":"-er fiilleri: -ai, -as, -a, -âmes, -âtes, -èrent","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Kök + -a / -èrent","en":"Radical + terminaison","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Il] [v:entra] [o:dans la pièce].","tr":"Odaya girdi."},{"text":"[s:Ils] [v:arrivèrent] [o:le soir].","tr":"Akşam vardılar."}]},{"kind":"other","title":"-ir / -re fiilleri: -is, -it, -irent","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Kök + -it / -irent","en":"Radical + -i-","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Elle] [v:finit] [o:sa lettre].","tr":"Mektubunu bitirdi."},{"text":"[s:Ils] [v:prirent] [o:la route].","tr":"Yola koyuldular."}]},{"kind":"other","title":"Düzensiz: -us, -ut, -urent / -ins","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"fut / eut / vint / fit","en":"Passé simple irrégulier","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Ce] [v:fut] [o:une belle journée].","tr":"Güzel bir gündü."},{"text":"[s:Il] [v:eut] [o:peur].","tr":"Korktu."},{"text":"[s:Napoléon] [v:naquit] [o:en 1769].","tr":"Napolyon 1769'da doğdu."}],"notes":["être: fut, furent · avoir: eut, eurent · faire: fit · venir: vint · naître: naquit · voir: vit."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne","en":"ne","role":"a"},{"tr":"Passé simple","en":"Passé simple","role":"v"},{"tr":"pas / jamais","en":"pas / jamais","role":"a"}],"examples":[{"text":"[s:Il] [a:ne] [v:répondit] [a:pas].","tr":"Cevap vermedi."}]}],"rules":["Anlatıda passé simple ana olayları, imparfait arka planı verir.","Konuşma dilinde ve mektuplarda passé composé kullanılır."],"exceptions":["nous/vous biçimleri (-âmes, -âtes) çok nadir görülür."],"mistakes":[{"wrong":"Hier, je fus au cinéma. (konuşmada)","right":"Hier, je suis allé au cinéma.","note":"Konuşma dilinde passé simple kullanılmaz."},{"wrong":"Il prenit le train.","right":"Il prit le train.","note":"prendre'nin passé simple biçimi prit'tir."}]}},
  {"id":"fr-gr-le-passe-anterieur","languageId":"fr","category":"grammar","level":"C2","sourceText":"Le passé antérieur","translations":{"tr":["Önceki geçmiş zaman (yazı dili)"]},"grammar":{"summary":"Edebî dilde passé simple'dan hemen önce tamamlanmış bir eylemi anlatır.","uses":["quand, lorsque, dès que, après que ile passé simple'dan önceki eylem","Romanlarda hızlı art arda gelen olaylar","Okurken tanımak için öğrenilir"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Dès que / Quand","en":"Conjonction de temps","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"eut / fut (passé simple)","en":"Auxiliaire au passé simple","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":", Ana cümle (passé simple)","en":", Proposition au passé simple","role":"o"}],"examples":[{"text":"[x:Dès qu'] [s:il] [a:eut] [v:fini], [o:il sortit].","tr":"Bitirir bitirmez çıktı."},{"text":"[x:Quand] [s:elle] [a:fut] [v:partie], [o:il pleura].","tr":"O gidince ağladı."}]},{"kind":"other","title":"Après que / Lorsque","formula":[{"tr":"Après que / Lorsque","en":"Conjonction de temps","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"eurent / furent","en":"Auxiliaire au passé simple","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":", Passé simple","en":", Proposition au passé simple","role":"o"}],"examples":[{"text":"[x:Après qu'] [s:ils] [a:eurent] [v:dîné], [o:ils sortirent].","tr":"Akşam yemeğini yedikten sonra dışarı çıktılar."},{"text":"[x:Lorsqu'] [s:il] [a:eut] [v:parlé], [o:tout le monde applaudit].","tr":"O konuştuktan sonra herkes alkışladı."}]},{"kind":"other","title":"À peine … que","formula":[{"tr":"À peine","en":"À peine","role":"x"},{"tr":"Yardımcı fiil + özne","en":"Auxiliaire + sujet (inversion)","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":"que + passé simple","en":"que + passé simple","role":"o"}],"examples":[{"text":"[x:À peine] [a:fut-il] [v:arrivé] [o:qu'il repartit].","tr":"Daha yeni gelmişti ki tekrar gitti."}]}],"rules":["Yardımcı fiil seçimi ve uyum passé composé ile aynıdır.","Konuşma dilinde yerini plus-que-parfait veya passé composé alır."],"exceptions":[],"mistakes":[{"wrong":"Dès qu'il avait fini, il sortit.","right":"Dès qu'il eut fini, il sortit.","note":"Edebî anlatıda passé simple ile passé antérieur eşleşir."},{"wrong":"Quand elle eut partie…","right":"Quand elle fut partie…","note":"partir être ile çekimlenir."}]}},
  {"id":"fr-gr-le-subjonctif-imparfait-et-plus-que-parfait","languageId":"fr","category":"grammar","level":"C2","sourceText":"Le subjonctif imparfait et plus-que-parfait","translations":{"tr":["Dilek kipinin hikâye ve geçmiş zamanı (edebî)"]},"grammar":{"summary":"Klasik edebiyatta ana fiil geçmişteyken kullanılan subjonctif zamanlarıdır; günümüzde sadece yazıda, çoğunlukla 3. tekil şahısta görülür.","uses":["Klasik metinleri okurken tanımak","Çok resmî/edebî yazıda il fût, qu'il eût","Edebî koşul: eût-il su… (= s'il avait su)"],"sections":[{"kind":"other","title":"Subjonctif imparfait","formula":[{"tr":"Ana cümle (geçmiş)","en":"Proposition principale au passé","role":"x"},{"tr":"que","en":"que","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"-ât / -ît / -ût","en":"Subjonctif imparfait","role":"v"}],"examples":[{"text":"Il fallait [x:qu'] [s:il] [v:partît].","tr":"Gitmesi gerekiyordu."},{"text":"Je voulais [x:qu'] [s:elle] [v:fût] heureuse.","tr":"Mutlu olmasını istiyordum."}],"notes":["3. tekil: passé simple'ın şapkalı biçimi: il parla → qu'il parlât, il fut → qu'il fût."]},{"kind":"other","title":"Subjonctif plus-que-parfait","formula":[{"tr":"que","en":"que","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"eût / fût","en":"Auxiliaire au subjonctif imparfait","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"}],"examples":[{"text":"Bien [x:qu'] [s:il] [a:eût] [v:compris], il se tut.","tr":"Anlamış olmasına rağmen sustu."}]},{"kind":"other","title":"Edebî koşul (conditionnel passé 2e forme)","formula":[{"tr":"Özne / Si'siz koşul","en":"Sujet","role":"s"},{"tr":"eût / fût","en":"Auxiliaire","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"}],"examples":[{"text":"[s:On] [a:eût] [v:dit] un enfant.","tr":"Çocuk sanırdınız (çocuk denirdi)."},{"text":"Si j'avais su, [s:je] [a:fusse] [v:venu].","tr":"Bilseydim gelirdim."}]}],"rules":["Günümüz dilinde yerini subjonctif présent ve passé alır: Il fallait qu'il parte.","qu'il fût (subjonctif) ile il fut (passé simple) arasındaki fark şapkadır."],"exceptions":[],"mistakes":[{"wrong":"Il fallait qu'il partait.","right":"Il fallait qu'il parte. (edebî: qu'il partît)","note":"Gereklilikten sonra imparfait değil subjonctif gelir."},{"wrong":"Bien qu'il fut riche…","right":"Bien qu'il fût riche…","note":"Subjonctif imparfait'te şapka (fût) unutulmamalı."}]}},
  {"id":"fr-gr-linversion-du-sujet","languageId":"fr","category":"grammar","level":"C2","sourceText":"L'inversion du sujet","translations":{"tr":["Öznenin devrik kullanımı"]},"grammar":{"summary":"Bazı zarflardan sonra, alıntılarda ve resmî dilde özne fiilden sonra gelir.","uses":["peut-être, sans doute, aussi, ainsi, à peine ile başlayan cümleler","Alıntı fiilleri: « Viens », dit-il.","İlgi cümlesinde ve resmî üslupta: la maison qu'a construite mon père"],"sections":[{"kind":"other","title":"Zarf + fiil + özne zamiri","formula":[{"tr":"Peut-être / Sans doute / Aussi","en":"Adverbe en tête","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"-Özne zamiri","en":"-Pronom sujet","role":"s"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[x:Peut-être] [v:a]-t-[s:il] [o:raison].","tr":"Belki de haklıdır."},{"text":"[x:Sans doute] [v:viendra]-t-[s:elle] [o:demain].","tr":"Muhtemelen yarın gelecek."}],"notes":["Bu zarflar cümle başında değilse devrik yapı gerekmez: Il a peut-être raison."]},{"kind":"other","title":"Alıntı fiili","formula":[{"tr":"« Sözler »","en":"Discours direct","role":"o"},{"tr":",","en":",","role":"x"},{"tr":"dit / répondit / demanda","en":"Verbe de parole","role":"v"},{"tr":"Özne","en":"Sujet","role":"s"}],"examples":[{"text":"[o:« Je pars »], [v:dit]-[s:il].","tr":"\"Gidiyorum\" dedi."},{"text":"[o:« Pourquoi ? »] [v:demanda] [s:Marie].","tr":"\"Neden?\" diye sordu Marie."}]},{"kind":"other","title":"İsim özneyle: isim + fiil + -il","formula":[{"tr":"Aussi / Ainsi","en":"Adverbe en tête","role":"x"},{"tr":"İsim özne","en":"Sujet nominal","role":"s"},{"tr":"Fiil + -t-il / -elle","en":"Verbe + pronom de reprise","role":"v"}],"examples":[{"text":"[x:Aussi] [s:le gouvernement] [v:a-t-il] décidé d'agir.","tr":"Bu yüzden hükümet harekete geçmeye karar verdi."}]},{"kind":"other","title":"İlgi cümlesinde devrik yapı","formula":[{"tr":"İsim","en":"Antécédent","role":"o"},{"tr":"que / où","en":"Pronom relatif","role":"q"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Özne","en":"Sujet","role":"s"}],"examples":[{"text":"[o:La ville] [q:où] [v:habitent] [s:mes parents] est calme.","tr":"Annemle babamın oturduğu şehir sakin."}]}],"rules":["Cümle başındaki aussi 'bu yüzden' anlamındadır ve devrik yapı ister.","Fiil ünlüyle bitiyorsa -t- eklenir: a-t-il, viendra-t-elle."],"exceptions":[],"mistakes":[{"wrong":"Peut-être il a raison.","right":"Peut-être a-t-il raison. / Peut-être qu'il a raison.","note":"Cümle başındaki peut-être devrik yapı veya que ister."},{"wrong":"« Je pars », il dit.","right":"« Je pars », dit-il.","note":"Alıntıdan sonra özne fiilin arkasına geçer."}]}},
  {"id":"fr-gr-la-negation-litteraire-et-les-emplois-de-ne-seul","languageId":"fr","category":"grammar","level":"C2","sourceText":"La négation littéraire et les emplois de ne seul","translations":{"tr":["Edebî olumsuzluk ve tek başına ne"]},"grammar":{"summary":"Resmî ve edebî dilde bazı fiillerle olumsuzluk sadece ne ile yapılır; ne … que ise 'sadece' anlamı verir.","uses":["pouvoir, savoir, oser, cesser + mastar ile tek başına ne","ne … que: sadece, yalnızca","ne … guère, ne … point gibi edebî olumsuzluklar"],"sections":[{"kind":"negative","title":"ne + savoir / pouvoir / oser / cesser","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne","en":"ne","role":"a"},{"tr":"sais / puis / ose / cesse","en":"Verbe","role":"v"},{"tr":"Mastar / Tümleç","en":"Infinitif / Complément","role":"o"}],"examples":[{"text":"[s:Je] [a:ne] [v:sais] [o:que dire].","tr":"Ne diyeceğimi bilemiyorum."},{"text":"[s:Il] [a:n'][v:ose] [o:le lui demander].","tr":"Bunu ona sormaya cesaret edemiyor."},{"text":"[s:Elle] [a:ne] [v:cesse] [o:de pleurer].","tr":"Durmadan ağlıyor."}]},{"kind":"other","title":"ne … que (sadece)","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne","en":"ne","role":"a"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"que + sınırlanan öğe","en":"que + élément restreint","role":"o"}],"examples":[{"text":"[s:Je] [a:n'][v:ai] [o:que dix euros].","tr":"Sadece on avrom var."},{"text":"[s:Il] [a:ne] [v:pense] [o:qu'à lui].","tr":"Sadece kendini düşünüyor."}],"notes":["ne … que olumsuz değildir; partitif de'ye dönüşmez: Je n'ai que du pain."]},{"kind":"other","title":"ne … guère / ne … point","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne","en":"ne","role":"a"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"guère / point","en":"Forclusif littéraire","role":"a"}],"examples":[{"text":"[s:Il] [a:ne] [v:mange] [a:guère].","tr":"Neredeyse hiç yemiyor."},{"text":"[s:Je] [a:ne] [v:le crois] [a:point].","tr":"Buna hiç inanmıyorum."}]}],"rules":["guère = pas beaucoup, point = pas du tout (edebî).","Konuşma dilinde tersine ne çoğunlukla düşer: J'sais pas."],"exceptions":["Je ne puis = Je ne peux pas (çok resmî)."],"mistakes":[{"wrong":"Je n'ai que de pain.","right":"Je n'ai que du pain.","note":"ne … que olumsuzluk sayılmaz, partitif korunur."},{"wrong":"Il ne mange guère pas.","right":"Il ne mange guère.","note":"guère pas ile birlikte kullanılmaz."}]}},
  {"id":"fr-gr-le-conditionnel-de-linformation-non-confirmee","languageId":"fr","category":"grammar","level":"C2","sourceText":"Le conditionnel de l'information non confirmée","translations":{"tr":["Doğrulanmamış bilgi için conditionnel"]},"grammar":{"summary":"Basında ve resmî dilde conditionnel, kaynağı belirtilmiş ama doğrulanmamış bilgiyi aktarır ('-mış, -dığı iddia ediliyor').","uses":["Haberlerde söylenti ve iddialar","selon, d'après gibi kaynak ifadeleriyle","Geçmiş olay için conditionnel passé"],"sections":[{"kind":"other","title":"Şimdi / gelecek: conditionnel présent","formula":[{"tr":"Selon / D'après + kaynak","en":"Selon + source","role":"x"},{"tr":", Özne","en":", Sujet","role":"s"},{"tr":"Conditionnel présent","en":"Conditionnel présent","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[x:Selon la presse], [s:le ministre] [v:démissionnerait] [o:demain].","tr":"Basına göre bakan yarın istifa edecekmiş."},{"text":"[s:Le suspect] [v:serait] [o:en fuite].","tr":"Şüphelinin kaçak olduğu bildiriliyor."}]},{"kind":"other","title":"Geçmiş: conditionnel passé","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"aurait / serait","en":"Auxiliaire au conditionnel","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:L'incendie] [a:aurait] [v:fait] [o:trois victimes].","tr":"Yangında üç kişinin öldüğü bildiriliyor."},{"text":"[s:Le chanteur] [a:se serait] [v:marié] [o:en secret].","tr":"Şarkıcının gizlice evlendiği söyleniyor."}]}],"rules":["Kaynak doğrulanmışsa indicatif kullanılır.","Türkçedeki -mış ekine benzer bir mesafe koyar."],"exceptions":[],"mistakes":[{"wrong":"Selon la police, le voleur est entré par la fenêtre. (doğrulanmamış)","right":"Selon la police, le voleur serait entré par la fenêtre.","note":"Doğrulanmamış bilgide conditionnel kullanılır."},{"wrong":"Le ministre démissionnera, selon des rumeurs.","right":"Le ministre démissionnerait, selon des rumeurs.","note":"Söylentide futur değil conditionnel gelir."}]}},
  {"id":"fr-gr-la-proposition-participiale","languageId":"fr","category":"grammar","level":"C2","sourceText":"La proposition participiale","translations":{"tr":["Bağımsız ortaç cümlesi"]},"grammar":{"summary":"Kendi öznesi olan ortaçlı yan cümledir; zaman veya sebep bildirir ve yazı dilinde kullanılır.","uses":["Zaman: Le travail terminé, il partit. (iş bitince)","Sebep: La nuit tombant, nous rentrâmes.","Resmî ve edebî anlatım"],"sections":[{"kind":"other","title":"İsim + geçmiş ortaç","formula":[{"tr":"İsim (özne)","en":"Sujet de la participiale","role":"s"},{"tr":"Geçmiş ortaç (uyumlu)","en":"Participe passé accordé","role":"v"},{"tr":", Ana cümle","en":", Proposition principale","role":"o"}],"examples":[{"text":"[s:Le repas] [v:terminé], [o:les invités sont partis].","tr":"Yemek bitince misafirler gitti."},{"text":"[s:Les valises] [v:faites], [o:nous avons quitté l'hôtel].","tr":"Valizler hazırlanınca otelden ayrıldık."}]},{"kind":"other","title":"İsim + participe présent","formula":[{"tr":"İsim (özne)","en":"Sujet de la participiale","role":"s"},{"tr":"-ant","en":"Participe présent","role":"v"},{"tr":", Ana cümle","en":", Proposition principale","role":"o"}],"examples":[{"text":"[s:La nuit] [v:tombant], [o:nous sommes rentrés].","tr":"Gece çökünce eve döndük."},{"text":"[s:Le train] [v:ayant] du retard, [o:j'ai manqué ma correspondance].","tr":"Tren geciktiği için aktarmamı kaçırdım."}]},{"kind":"other","title":"Une fois + ortaç","formula":[{"tr":"Une fois","en":"Une fois","role":"x"},{"tr":"İsim + ortaç","en":"Nom + participe passé","role":"s"},{"tr":", Ana cümle","en":", Proposition principale","role":"o"}],"examples":[{"text":"[x:Une fois] [s:la décision prise], [o:il faut agir].","tr":"Karar alındıktan sonra harekete geçmek gerekir."}]}],"rules":["Ortaç cümlesinin öznesi ana cümleninkinden farklıdır.","Geçmiş ortaç kendi öznesiyle uyum yapar: la décision prise."],"exceptions":[],"mistakes":[{"wrong":"Arrivant à la gare, le train était parti.","right":"Arrivé à la gare, j'ai vu que le train était parti.","note":"Öznesi yazılmayan ortaç ana cümlenin öznesine bağlanır; özneler uyuşmalı."},{"wrong":"La porte fermé, il dormit.","right":"La porte fermée, il dormit.","note":"Ortaç kendi öznesiyle uyum yapar."}]}},
  {"id":"fr-gr-lhypothese-sans-si","languageId":"fr","category":"grammar","level":"C2","sourceText":"L'hypothèse sans si","translations":{"tr":["si'siz varsayım ve koşul"]},"grammar":{"summary":"au cas où, pour peu que, à supposer que, quand bien même gibi yapılarla nüanslı koşul ve varsayım anlatılır.","uses":["au cas où + conditionnel: -rsa diye, olur da","à supposer que, pour peu que, pourvu que + subjonctif","quand bien même + conditionnel: -se bile"],"sections":[{"kind":"other","title":"au cas où + conditionnel","formula":[{"tr":"Ana cümle","en":"Proposition principale","role":"s"},{"tr":"au cas où","en":"au cas où","role":"q"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Conditionnel","en":"Conditionnel","role":"v"}],"examples":[{"text":"[s:Prends un parapluie] [q:au cas où] [s:il] [v:pleuvrait].","tr":"Yağmur yağar diye şemsiye al."}]},{"kind":"other","title":"à supposer que / pour peu que + subjonctif","formula":[{"tr":"À supposer que / Pour peu que","en":"Locution d'hypothèse","role":"q"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Subjonctif","en":"Subjonctif","role":"v"},{"tr":", Ana cümle","en":", Proposition principale","role":"o"}],"examples":[{"text":"[q:À supposer qu'] [s:il] [v:accepte], [o:qui paiera ?]","tr":"Kabul ettiğini varsayalım, kim ödeyecek?"},{"text":"[q:Pour peu qu'] [s:on] [v:l'encourage], [o:il réussira].","tr":"Biraz cesaretlendirilse başaracak."}]},{"kind":"other","title":"quand bien même + conditionnel","formula":[{"tr":"Quand bien même","en":"Quand bien même","role":"q"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Conditionnel","en":"Conditionnel","role":"v"},{"tr":", Ana cümle (conditionnel)","en":", Proposition principale","role":"o"}],"examples":[{"text":"[q:Quand bien même] [s:il] [v:s'excuserait], [o:je ne lui pardonnerais pas].","tr":"Özür dilese bile onu affetmezdim."}]},{"kind":"other","title":"Ters yapılı conditionnel","formula":[{"tr":"Conditionnel 1","en":"Conditionnel (hypothèse)","role":"v"},{"tr":"Özne (devrik)","en":"Sujet inversé","role":"s"},{"tr":", Conditionnel 2","en":", Conditionnel (conséquence)","role":"o"}],"examples":[{"text":"[v:Serait]-[s:il] riche, [o:il ne serait pas heureux].","tr":"Zengin olsa bile mutlu olmazdı."},{"text":"[v:Viendrait]-[s:il], [o:je ne le recevrais pas].","tr":"Gelse bile onu kabul etmezdim."}]}],"rules":["au cas où ve quand bien même conditionnel; à condition que, à supposer que, pour peu que subjonctif alır.","en cas de + isim: en cas de problème (sorun olursa)."],"exceptions":[],"mistakes":[{"wrong":"Au cas où il pleut, on reste.","right":"Au cas où il pleuvrait, on reste.","note":"au cas où conditionnel ister."},{"wrong":"À supposer qu'il accepte pas…","right":"À supposer qu'il n'accepte pas…","note":"Yazı dilinde ne atlanmaz."},{"wrong":"Quand bien même il s'excuse…","right":"Quand bien même il s'excuserait…","note":"quand bien même conditionnel ister."}]}},
  {"id":"fr-gr-le-discours-indirect-libre","languageId":"fr","category":"grammar","level":"C2","sourceText":"Le discours indirect libre","translations":{"tr":["Serbest dolaylı anlatım"]},"grammar":{"summary":"Karakterin düşünce ve sözlerini bağlaç ve aktarma fiili olmadan, dolaylı anlatımın zaman ve şahıslarıyla veren edebî tekniktir.","uses":["Romanlarda karakterin iç sesini vermek","Anlatıcı ile karakterin sesini harmanlamak","Edebî metinleri okurken tanımak"],"sections":[{"kind":"other","title":"Doğrudan → serbest dolaylı","formula":[{"tr":"Doğrudan anlatım","en":"Discours direct","role":"s"},{"tr":"→","en":"→","role":"x"},{"tr":"Imparfait / Conditionnel, 3. şahıs","en":"Discours indirect libre","role":"o"}],"examples":[{"text":"[s:Il pensa : « Je partirai demain. »] [x:→] [o:Il partirait demain.]","tr":"\"Yarın gideceğim\" diye düşündü → Yarın gidecekti."},{"text":"[s:« Comme je suis bête ! »] [x:→] [o:Comme elle était bête !]","tr":"\"Ne aptalım!\" → Ne aptaldı!"}]},{"kind":"other","title":"Ünlem ve sorular korunur","formula":[{"tr":"Anlatı (passé simple)","en":"Récit","role":"s"},{"tr":".","en":".","role":"x"},{"tr":"Soru / ünlem (imparfait)","en":"Question / exclamation","role":"o"}],"examples":[{"text":"[s:Elle regarda la lettre.] [o:Que voulait-il donc ? Viendrait-il vraiment ?]","tr":"Mektuba baktı. Ne istiyordu ki? Gerçekten gelecek miydi?"}]}],"rules":["que veya dire gibi aktarma öğeleri yoktur; zaman ve şahıs dolaylı anlatımdaki gibi değişir.","Ünlemler, sorular ve konuşma dili ifadeleri korunur."],"exceptions":[],"mistakes":[{"wrong":"Il pensa qu'il partirait demain. (serbest dolaylı sanılarak)","right":"Il partirait demain.","note":"Serbest dolaylıda que ve aktarma fiili kullanılmaz."},{"wrong":"Elle regarda la lettre. Que veut-il donc ?","right":"Elle regarda la lettre. Que voulait-il donc ?","note":"Serbest dolaylıda zaman, anlatının geçmiş zamanına göre geri kayar."}]}}
]
