[
  {"id":"fr-gr-les-articles-partitifs","languageId":"fr","category":"grammar","level":"A2","sourceText":"Les articles partitifs","translations":{"tr":["Partitif (Kısmi) Artikeller"]},"grammar":{"summary":"du, de la, de l', des sayılamayan ya da belirsiz miktardaki şeyler için \"biraz\" anlamında kullanılır.","uses":["Yiyecek ve içecek: Je bois du café.","Belirsiz miktar: Il y a de la neige.","faire + partitif: faire du sport, faire de la musique"],"sections":[{"kind":"other","title":"Partitif artikel","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"du / de la / de l' / des","en":"article partitif","role":"x"},{"tr":"İsim","en":"Nom","role":"o"}],"examples":[{"text":"[s:Je] [v:mange] [x:du] [o:pain].","tr":"Ekmek yiyorum."},{"text":"[s:Tu] [v:veux] [x:de l'][o:eau] ?","tr":"Su ister misin?"}]},{"kind":"other","title":"Olumsuzda de","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas de (d')","en":"pas de","role":"x"},{"tr":"İsim","en":"Nom","role":"o"}],"examples":[{"text":"[s:Je] [x:ne] [v:bois] [x:pas de] [o:vin].","tr":"Şarap içmem."},{"text":"[s:Il] [x:n'y a plus de] [o:lait].","tr":"Süt kalmadı."}]},{"kind":"other","title":"Miktar + de","formula":[{"tr":"Miktar","en":"Quantité","role":"x"},{"tr":"de (d')","en":"de","role":"x"},{"tr":"İsim","en":"Nom","role":"o"}],"examples":[{"text":"Il a [x:beaucoup de] [o:travail].","tr":"Çok işi var."},{"text":"[x:un kilo de] [o:tomates], [x:une bouteille d'][o:eau]","tr":"bir kilo domates, bir şişe su"}]},{"kind":"other","title":"Partitif mi belirli mi?","formula":[{"tr":"aimer + le / la / les","en":"article défini","role":"x"},{"tr":"manger + du / de la","en":"article partitif","role":"x"}],"examples":[{"text":"J'aime [x:le] [o:chocolat], alors je mange [x:du] [o:chocolat].","tr":"Çikolatayı severim, bu yüzden çikolata yerim."}],"notes":["aimer, adorer, détester, préférer genel anlamda belirli artikel alır."]}],"rules":["Türkçede artikel yoktur ama Fransızcada \"ekmek yerim\" cümlesinde bile partitif gerekir.","Olumsuzda ve miktar ifadelerinden sonra sadece de kalır.","Bütün olarak sayılan şey belirsiz artikel alır: un gâteau (bir pasta) / du gâteau (biraz pasta)."],"exceptions":[],"mistakes":[{"wrong":"Je mange pain.","right":"Je mange du pain.","note":"Artikel atılamaz."},{"wrong":"Je ne bois pas du café.","right":"Je ne bois pas de café.","note":"Olumsuzda de."},{"wrong":"beaucoup des amis","right":"beaucoup d'amis","note":"Miktar ifadesinden sonra de."}]}},
  {"id":"fr-gr-le-passe-compose-avec-avoir","languageId":"fr","category":"grammar","level":"A2","sourceText":"Le passé composé avec avoir","translations":{"tr":["Bileşik Geçmiş Zaman (avoir ile)"]},"grammar":{"summary":"avoir'ın présent çekimi + geçmiş ortaç (participe passé) ile tamamlanmış geçmiş olaylar anlatılır.","uses":["Geçmişte bitmiş tek seferlik olaylar","Hikâyede sırayla olan olaylar","Belirli zamanlı geçmiş: hier, l'année dernière"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"avoir (présent)","en":"avoir","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:J'][a:ai] [v:mangé] [o:une pizza].","tr":"Bir pizza yedim."},{"text":"[s:Nous] [a:avons] [v:fini] [o:le travail].","tr":"İşi bitirdik."}],"notes":["-er → -é (parlé), -ir → -i (fini), -re → -u (vendu)."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"avoir","en":"avoir","role":"a"},{"tr":"pas","en":"pas","role":"x"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Il] [x:n'][a:a] [x:pas] [v:compris] [o:la question].","tr":"Soruyu anlamadı."},{"text":"[s:Je] [x:n'][a:ai] [x:pas] [v:dormi].","tr":"Uyumadım."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Est-ce que","en":"Est-ce que","role":"q"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"avoir","en":"avoir","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":"Tümleç?","en":"Complément ?","role":"o"}],"examples":[{"text":"[q:Est-ce que] [s:tu] [a:as] [v:vu] [o:ce film] ?","tr":"Bu filmi gördün mü?"},{"text":"[a:Avez]-[s:vous] [v:réservé] [o:une table] ?","tr":"Masa ayırttınız mı?"}]},{"kind":"wh","title":"Soru kelimeli soru","formula":[{"tr":"Soru kelimesi","en":"Mot interrogatif","role":"q"},{"tr":"est-ce que","en":"est-ce que","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"avoir","en":"avoir","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"}],"examples":[{"text":"[q:Qu'est-ce que] [s:tu] [a:as] [v:fait] [o:hier] ?","tr":"Dün ne yaptın?"},{"text":"[q:Où] [x:est-ce que] [s:vous] [a:avez] [v:acheté] [o:ce sac] ?","tr":"Bu çantayı nereden aldınız?"}]}],"rules":["Fransızcada passé composé hem -dı'lı geçmişi hem \"yaptım\" gibi yakın geçmişi karşılar.","Olumsuzda ne … pas yardımcı fiili sarar.","Sık düzensiz ortaçlar: faire → fait, prendre → pris, voir → vu, avoir → eu, être → été, boire → bu, lire → lu."],"exceptions":["Hareket fiillerinin çoğu ve dönüşlü fiiller avoir değil être alır."],"mistakes":[{"wrong":"J'ai mangeé.","right":"J'ai mangé.","note":"-er fiilinin ortaç eki -é."},{"wrong":"Je n'ai mangé pas.","right":"Je n'ai pas mangé.","note":"pas yardımcı fiilden sonra gelir."},{"wrong":"J'ai prendu le bus.","right":"J'ai pris le bus.","note":"prendre'nin ortacı pris."}]}},
  {"id":"fr-gr-le-passe-compose-avec-etre","languageId":"fr","category":"grammar","level":"A2","sourceText":"Le passé composé avec être","translations":{"tr":["Bileşik Geçmiş Zaman (être ile)"]},"grammar":{"summary":"Hareket ya da durum değişikliği bildiren yaklaşık 15 fiil ve dönüşlü fiiller passé composé'de être alır; ortaç özneye uyar.","uses":["aller, venir, arriver, partir, entrer, sortir, monter, descendre, naître, mourir, rester, tomber, retourner, rentrer, passer","Bunlardan türeyenler: revenir, devenir","Tüm dönüşlü fiiller: je me suis levé"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"être (présent)","en":"être","role":"a"},{"tr":"Geçmiş ortaç (+e / +s)","en":"Participe passé accordé","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Elle] [a:est] [v:allée] [o:au marché].","tr":"Pazara gitti."},{"text":"[s:Nous] [a:sommes] [v:arrivés] [o:hier soir].","tr":"Dün akşam geldik."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"être","en":"être","role":"a"},{"tr":"pas","en":"pas","role":"x"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"}],"examples":[{"text":"[s:Ils] [x:ne] [a:sont] [x:pas] [v:venus].","tr":"Gelmediler."},{"text":"[s:Je] [x:ne] [a:suis] [x:pas] [v:resté] [o:longtemps].","tr":"Uzun süre kalmadım."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Est-ce que","en":"Est-ce que","role":"q"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"être","en":"être","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":"Tümleç?","en":"Complément ?","role":"o"}],"examples":[{"text":"[q:Est-ce que] [s:tu] [a:es] [v:sorti] [o:samedi] ?","tr":"Cumartesi dışarı çıktın mı?"},{"text":"[a:Est]-[s:elle] déjà [v:partie] ?","tr":"O çoktan gitti mi?"}]},{"kind":"wh","title":"Soru kelimeli soru","formula":[{"tr":"Soru kelimesi","en":"Mot interrogatif","role":"q"},{"tr":"être","en":"être","role":"a"},{"tr":"- Özne zamiri","en":"- pronom sujet","role":"s"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"}],"examples":[{"text":"[q:Quand] [a:êtes]-[s:vous] [v:arrivé] [o:en France] ?","tr":"Fransa'ya ne zaman geldiniz?"},{"text":"[q:À quelle heure] [x:est-ce qu'][s:elle] [a:est] [v:rentrée] ?","tr":"Eve saat kaçta döndü?"}]}],"rules":["être ile ortaç özneye cinsiyet ve sayıca uyar: elle est partie, ils sont partis.","Ezber için \"DR MRS VANDERTRAMP\" kısaltması kullanılır.","monter, descendre, sortir, passer nesne alırsa avoir kullanılır: J'ai monté les valises."],"exceptions":["vous tek kişiye nezaketle söyleniyorsa ortaç tekil kalır: Vous êtes arrivé, monsieur ?"],"mistakes":[{"wrong":"J'ai allé au cinéma.","right":"Je suis allé au cinéma.","note":"aller être alır."},{"wrong":"Elle est parti.","right":"Elle est partie.","note":"Ortaç dişil özneye uyar."},{"wrong":"Ils sont venu.","right":"Ils sont venus.","note":"Ortaç çoğula uyar."}]}},
  {"id":"fr-gr-les-verbes-pronominaux","languageId":"fr","category":"grammar","level":"A2","sourceText":"Les verbes pronominaux","translations":{"tr":["Dönüşlü Fiiller"]},"grammar":{"summary":"Dönüşlü fiiller, özneyle aynı kişiyi gösteren me, te, se, nous, vous, se zamiriyle kullanılır.","uses":["Kişinin kendine yaptığı eylemler: se laver, s'habiller","Günlük rutin: se lever, se coucher","Karşılıklı eylemler: Ils s'aiment."],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"me / te / se / nous / vous / se","en":"pronom réfléchi","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"[s:Je] [o:me] [v:lève] à sept heures.","tr":"Saat yedide kalkarım."},{"text":"[s:Nous] [o:nous] [v:promenons] dans le parc.","tr":"Parkta yürüyüş yapıyoruz."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Dönüşlü zamir","en":"pronom réfléchi","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas","en":"pas","role":"x"}],"examples":[{"text":"[s:Il] [x:ne] [o:se] [v:rase] [x:pas].","tr":"Tıraş olmuyor."},{"text":"[s:Tu] [x:ne] [o:te] [v:dépêches] [x:pas] ?","tr":"Acele etmiyor musun?"}]},{"kind":"other","title":"Passé composé","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Dönüşlü zamir","en":"pronom réfléchi","role":"o"},{"tr":"être","en":"être","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"}],"examples":[{"text":"[s:Elle] [o:s'][a:est] [v:réveillée] tard.","tr":"Geç uyandı."},{"text":"[s:Nous] [o:nous] [a:sommes] [v:amusés].","tr":"Eğlendik."}]},{"kind":"other","title":"Emir kipi","formula":[{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"-toi / -nous / -vous","en":"pronom tonique","role":"o"}],"examples":[{"text":"[v:Lève]-[o:toi] !","tr":"Kalk!"},{"text":"[x:Ne] [o:t'][v:inquiète] [x:pas] !","tr":"Merak etme!"}]}],"rules":["Zamir ünlüden önce m', t', s' olur: je m'appelle.","Passé composé'de her zaman être kullanılır.","Mastarda zamir özneye uyar: Je vais me coucher."],"exceptions":[],"mistakes":[{"wrong":"Je lève à 7 heures.","right":"Je me lève à 7 heures.","note":"Dönüşlü zamir atılmaz."},{"wrong":"Je m'ai levé.","right":"Je me suis levé.","note":"Dönüşlü fiiller être alır."},{"wrong":"Je vais se coucher.","right":"Je vais me coucher.","note":"Zamir özneye uyar."}]}},
  {"id":"fr-gr-limparfait","languageId":"fr","category":"grammar","level":"A2","sourceText":"L'imparfait","translations":{"tr":["Hikâye Geçmiş Zamanı (Imparfait)"]},"grammar":{"summary":"Imparfait geçmişte süren durumları, alışkanlıkları ve arka planı anlatır: nous kökü + -ais, -ais, -ait, -ions, -iez, -aient.","uses":["Geçmişteki alışkanlıklar (-ardı / -erdi)","Geçmişte süren eylem (-yordu)","Tasvir: hava, yaş, duygu, ortam"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"nous kökü + -ais/-ais/-ait/-ions/-iez/-aient","en":"Imparfait","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [v:jouais] [o:au foot] tous les jours.","tr":"Her gün futbol oynardım."},{"text":"[s:Il] [v:faisait] [o:beau].","tr":"Hava güzeldi."}],"notes":["nous parlons → parl- → je parlais; nous finissons → finiss- → je finissais."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas","en":"pas","role":"x"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Elle] [x:n'][v:aimait] [x:pas] [o:l'école].","tr":"Okulu sevmezdi."},{"text":"[s:On] [x:n'][v:avait] [x:pas] [o:de télé].","tr":"Televizyonumuz yoktu."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Est-ce que","en":"Est-ce que","role":"q"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Tümleç?","en":"Complément ?","role":"o"}],"examples":[{"text":"[q:Est-ce que] [s:tu] [v:habitais] [o:à Paris] ?","tr":"Paris'te mi oturuyordun?"},{"text":"[v:Étiez]-[s:vous] [o:fatigués] ?","tr":"Yorgun muydunuz?"}]},{"kind":"wh","title":"Soru kelimeli soru","formula":[{"tr":"Soru kelimesi","en":"Mot interrogatif","role":"q"},{"tr":"est-ce que","en":"est-ce que","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"[q:Qu'est-ce que] [s:vous] [v:faisiez] [o:à minuit] ?","tr":"Gece yarısı ne yapıyordunuz?"},{"text":"[q:Où] [x:est-ce que] [s:tu] [v:travaillais] ?","tr":"Nerede çalışıyordun?"}]}],"rules":["Kök, présent'teki nous çekiminden gelir.","-ais, -ait, -aient aynı okunur.","Kibar istekte de kullanılır: Je voulais vous demander…"],"exceptions":["Tek düzensiz kök être'dir: j'étais, nous étions."],"mistakes":[{"wrong":"Je suis été fatigué.","right":"J'étais fatigué.","note":"Geçmişteki durum imparfait ile."},{"wrong":"Je mangais.","right":"Je mangeais.","note":"-ger fiillerinde a önünde e korunur."},{"wrong":"Quand j'ai été petit…","right":"Quand j'étais petit…","note":"Geçmişteki yaş ve durum imparfait ile."}]}},
  {"id":"fr-gr-les-pronoms-cod","languageId":"fr","category":"grammar","level":"A2","sourceText":"Les pronoms COD","translations":{"tr":["Doğrudan Nesne Zamirleri"]},"grammar":{"summary":"Doğrudan nesne zamirleri me, te, le, la, nous, vous, les nesnenin yerini alır ve fiilden önce gelir.","uses":["Tekrarı önlemek: Tu vois Marie ? — Oui, je la vois.","Edatsız nesne alan fiillerle: voir, aimer, prendre, regarder, connaître"],"sections":[{"kind":"other","title":"Zamir + fiil","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"me / te / le / la / nous / vous / les","en":"pronom COD","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"Tu connais Paul ? — Oui, [s:je] [o:le] [v:connais].","tr":"Paul'ü tanıyor musun? — Evet, onu tanıyorum."},{"text":"Ces fraises ? [s:Je] [o:les] [v:achète].","tr":"Bu çilekler mi? Onları alıyorum."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Zamir","en":"pronom COD","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas","en":"pas","role":"x"}],"examples":[{"text":"[s:Je] [x:ne] [o:la] [v:regarde] [x:pas].","tr":"Ona bakmıyorum."},{"text":"[s:Il] [x:ne] [o:nous] [v:comprend] [x:pas].","tr":"Bizi anlamıyor."}]},{"kind":"other","title":"Çekimli fiil + mastar","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Çekimli fiil","en":"Verbe conjugué","role":"a"},{"tr":"Zamir","en":"pronom COD","role":"o"},{"tr":"Mastar","en":"Infinitif","role":"v"}],"examples":[{"text":"[s:Je] [a:vais] [o:l'][v:appeler].","tr":"Onu arayacağım."},{"text":"[s:Tu] [a:peux] [o:les] [v:prendre].","tr":"Onları alabilirsin."}]},{"kind":"other","title":"Passé composé","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Zamir","en":"pronom COD","role":"o"},{"tr":"avoir","en":"avoir","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"}],"examples":[{"text":"Marie ? [s:Je] [o:l'][a:ai] [v:vue] hier.","tr":"Marie mi? Onu dün gördüm."}],"notes":["Nesne zamiri önde olunca ortaç ona uyar: la → vue, les → vus."]}],"rules":["le / la ünlüden önce l' olur.","Zamir çekimli fiilden önce; modal fiil ya da aller varsa mastardan önce gelir.","Olumlu emir kipinde fiilden sonra gelir: Prends-le !"],"exceptions":[],"mistakes":[{"wrong":"Je vois la.","right":"Je la vois.","note":"Zamir fiilden önce gelir."},{"wrong":"Je la vais appeler.","right":"Je vais l'appeler.","note":"Zamir mastarın önüne gelir."},{"wrong":"Je ne vois le pas.","right":"Je ne le vois pas.","note":"Zamir ne ile fiil arasında."}]}},
  {"id":"fr-gr-les-pronoms-coi","languageId":"fr","category":"grammar","level":"A2","sourceText":"Les pronoms COI","translations":{"tr":["Dolaylı Nesne Zamirleri"]},"grammar":{"summary":"à + kişi alan fiillerde nesnenin yerine me, te, lui, nous, vous, leur kullanılır.","uses":["parler à, téléphoner à, donner à, écrire à, répondre à, demander à gibi fiiller","Türkçede çoğu zaman -e / -a hâlindeki kişi"],"sections":[{"kind":"other","title":"Zamir + fiil","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"me / te / lui / nous / vous / leur","en":"pronom COI","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [o:lui] [v:téléphone] ce soir.","tr":"Bu akşam ona telefon ediyorum."},{"text":"[s:Il] [o:leur] [v:écrit] [o:une lettre].","tr":"Onlara bir mektup yazıyor."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Zamir","en":"pronom COI","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas","en":"pas","role":"x"}],"examples":[{"text":"[s:Elle] [x:ne] [o:me] [v:répond] [x:pas].","tr":"Bana cevap vermiyor."},{"text":"[s:Je] [x:ne] [o:leur] [v:parle] [x:pas].","tr":"Onlarla konuşmuyorum."}]},{"kind":"other","title":"Passé composé","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Zamir","en":"pronom COI","role":"o"},{"tr":"avoir","en":"avoir","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [o:lui] [a:ai] [v:donné] [o:le livre].","tr":"Kitabı ona verdim."}],"notes":["COI ile ortaç uyumu yoktur."]},{"kind":"other","title":"COD mi COI mi?","formula":[{"tr":"voir / aimer + qqn → le, la","en":"COD","role":"o"},{"tr":"parler / téléphoner à qqn → lui","en":"COI","role":"o"}],"examples":[{"text":"Je [o:la] vois. / Je [o:lui] parle.","tr":"Onu görüyorum. / Onunla konuşuyorum."}]}],"rules":["lui hem erkek hem kadın için kullanılır: Je lui parle.","leur zamiri değişmez; leurs olmaz.","à + şey ya da yer için lui değil y kullanılır."],"exceptions":[],"mistakes":[{"wrong":"Je le téléphone.","right":"Je lui téléphone.","note":"téléphoner à → COI."},{"wrong":"Je leurs parle.","right":"Je leur parle.","note":"Zamir leur'a s gelmez."},{"wrong":"Je parle à lui.","right":"Je lui parle.","note":"Normal cümlede zamir fiilden önce gelir."}]}},
  {"id":"fr-gr-le-pronom-y","languageId":"fr","category":"grammar","level":"A2","sourceText":"Le pronom y","translations":{"tr":["y Zamiri"]},"grammar":{"summary":"y, à + şey ya da yer ifadesinin yerini alır; \"oraya, orada, ona\" anlamındadır.","uses":["Yer: Je vais à Paris → J'y vais.","à + şey alan fiiller: penser à, répondre à, s'intéresser à","Kalıplar: il y a, on y va, ça y est"],"sections":[{"kind":"other","title":"Yer yerine y","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"y","en":"pronom y","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"Tu vas à la plage ? — Oui, [s:j'][o:y] [v:vais].","tr":"Plaja gidiyor musun? — Evet, oraya gidiyorum."},{"text":"[s:Nous] [o:y] [v:habitons] depuis dix ans.","tr":"On yıldır orada oturuyoruz."}]},{"kind":"other","title":"à + şey yerine y","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"y","en":"pronom y","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"Tu penses à ton examen ? — Oui, [s:j'][o:y] [v:pense].","tr":"Sınavını düşünüyor musun? — Evet, düşünüyorum."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"y","en":"pronom y","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas","en":"pas","role":"x"}],"examples":[{"text":"[s:Je] [x:n'][o:y] [v:vais] [x:pas].","tr":"Oraya gitmiyorum."}]},{"kind":"other","title":"Kalıplar","formula":[{"tr":"on y va / ça y est / vas-y","en":"expressions avec y","role":"x"}],"examples":[{"text":"[x:On y va] !","tr":"Hadi gidelim!"},{"text":"[x:Ça y est], j'ai fini !","tr":"Tamam, bitirdim!"}]}],"rules":["y çekimli fiilden önce gelir; mastar varsa mastardan önce: Je vais y aller.","à + kişi için y değil lui / leur ya da à + vurgulu zamir kullanılır.","Emir kipinde: Vas-y ! (va'ya s eklenir)."],"exceptions":[],"mistakes":[{"wrong":"Je vais y.","right":"J'y vais.","note":"y fiilden önce gelir."},{"wrong":"Je y pense.","right":"J'y pense.","note":"je → j'."},{"wrong":"Marie ? J'y pense souvent.","right":"Marie ? Je pense souvent à elle.","note":"Kişiler için y kullanılmaz."}]}},
  {"id":"fr-gr-le-pronom-en","languageId":"fr","category":"grammar","level":"A2","sourceText":"Le pronom en","translations":{"tr":["en Zamiri"]},"grammar":{"summary":"en, de + isim ya da miktar bildiren ifadelerin yerini alır; \"ondan, ondan biraz\" anlamındadır.","uses":["Partitifin yerine: Tu veux du café ? — Oui, j'en veux.","Sayı ve miktarla: J'en ai deux.","de alan fiiller: parler de, avoir besoin de, s'occuper de"],"sections":[{"kind":"other","title":"Partitif yerine","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"en","en":"pronom en","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"Tu bois du thé ? — Oui, [s:j'][o:en] [v:bois].","tr":"Çay içer misin? — Evet, içerim."}]},{"kind":"other","title":"Sayı / miktarla","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"en","en":"pronom en","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Sayı / Miktar","en":"Quantité","role":"x"}],"examples":[{"text":"Tu as des frères ? — [s:J'][o:en] [v:ai] [x:deux].","tr":"Erkek kardeşin var mı? — İki tane var."},{"text":"Des livres ? [s:Il] [o:en] [v:a] [x:beaucoup].","tr":"Kitap mı? Onda çok var."}]},{"kind":"other","title":"de + şey yerine","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"en","en":"pronom en","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"Tu parles de ton travail ? — Oui, [s:j'][o:en] [v:parle].","tr":"İşinden bahsediyor musun? — Evet, bahsediyorum."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"en","en":"pronom en","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas","en":"pas","role":"x"}],"examples":[{"text":"[s:Je] [x:n'][o:en] [v:veux] [x:pas].","tr":"İstemiyorum."}]}],"rules":["Sayı ve miktar sözcüğü cümlede kalır: J'en ai trois.","y ve en birlikte: Il y en a (ondan var).","Kişiler için genelde de + vurgulu zamir: Je parle de lui."],"exceptions":[],"mistakes":[{"wrong":"J'ai deux.","right":"J'en ai deux.","note":"Miktarla en atılmaz."},{"wrong":"Je ne veux pas en.","right":"Je n'en veux pas.","note":"en fiilden önce gelir."},{"wrong":"Il y a en trois.","right":"Il y en a trois.","note":"Sıra: y en."}]}},
  {"id":"fr-gr-le-comparatif-et-le-superlatif","languageId":"fr","category":"grammar","level":"A2","sourceText":"Le comparatif et le superlatif","translations":{"tr":["Karşılaştırma ve Üstünlük"]},"grammar":{"summary":"plus / moins / aussi … que ile karşılaştırma, le / la / les plus ile üstünlük yapılır.","uses":["İki şeyi karşılaştırmak","Bir grubun en … olanını söylemek","İsim ve fiillerle: plus de, autant de, autant que"],"sections":[{"kind":"other","title":"Karşılaştırma","formula":[{"tr":"İsim 1","en":"Nom 1","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"plus / moins / aussi","en":"plus / moins / aussi","role":"x"},{"tr":"Sıfat","en":"Adjectif","role":"o"},{"tr":"que","en":"que","role":"x"},{"tr":"İsim 2","en":"Nom 2","role":"s"}],"examples":[{"text":"[s:Paris] [v:est] [x:plus] [o:grand] [x:que] [s:Lyon].","tr":"Paris Lyon'dan büyük."},{"text":"[s:Marie] [v:est] [x:aussi] [o:grande] [x:que] [s:sa sœur].","tr":"Marie kız kardeşi kadar uzun."}]},{"kind":"other","title":"Üstünlük","formula":[{"tr":"le / la / les plus (moins)","en":"superlatif","role":"x"},{"tr":"Sıfat","en":"Adjectif","role":"o"},{"tr":"de","en":"de","role":"x"},{"tr":"Grup","en":"Groupe","role":"s"}],"examples":[{"text":"C'est [x:la plus] [o:belle] ville [x:du] [s:monde].","tr":"Dünyanın en güzel şehri."},{"text":"C'est le pull [x:le moins] [o:cher] [x:de] [s:la boutique].","tr":"Mağazanın en ucuz kazağı."}]},{"kind":"other","title":"İsim ve fiille","formula":[{"tr":"plus de / moins de / autant de","en":"plus de + nom","role":"x"},{"tr":"İsim","en":"Nom","role":"o"},{"tr":"que","en":"que","role":"x"}],"examples":[{"text":"J'ai [x:plus de] [o:travail] [x:que] toi.","tr":"Senden daha çok işim var."},{"text":"Il travaille [x:autant que] moi.","tr":"O da benim kadar çalışıyor."}]}],"rules":["Sıfat isme uyar: plus grande, plus grands.","İsimle plus de / moins de / autant de; fiille plus / moins / autant.","İsimden sonra gelen sıfatta artikel tekrarlanır: la ville la plus belle."],"exceptions":["bon → meilleur (le meilleur), bien → mieux (le mieux).","mauvais → pire ya da plus mauvais."],"mistakes":[{"wrong":"plus bon","right":"meilleur","note":"bon'un karşılaştırması meilleur."},{"wrong":"Il est plus grand de moi.","right":"Il est plus grand que moi.","note":"Karşılaştırmada que kullanılır."},{"wrong":"Il chante plus bien.","right":"Il chante mieux.","note":"bien → mieux."}]}},
  {"id":"fr-gr-limperatif","languageId":"fr","category":"grammar","level":"A2","sourceText":"L'impératif","translations":{"tr":["Emir Kipi"]},"grammar":{"summary":"Emir kipi tu, nous ve vous için kullanılır; özne zamiri yazılmaz.","uses":["Emir ve talimat","Öneri: Allons-y !","Rica ve yol tarifi: Prenez la deuxième rue."],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Fiil (tu / nous / vous)","en":"Impératif","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[v:Ferme] [o:la porte] !","tr":"Kapıyı kapat!"},{"text":"[v:Allons] [o:au parc] !","tr":"Parka gidelim!"},{"text":"[v:Prenez] [o:la première rue] à droite.","tr":"Sağdaki ilk sokağa girin."}],"notes":["-er fiillerinde tu çekiminden s düşer: tu parles → Parle !"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Fiil","en":"Impératif","role":"v"},{"tr":"pas","en":"pas","role":"x"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[x:Ne] [v:parle] [x:pas] [o:si fort] !","tr":"Bu kadar yüksek sesle konuşma!"},{"text":"[x:Ne] [v:touchez] [x:pas] !","tr":"Dokunmayın!"}]},{"kind":"other","title":"Zamirle","formula":[{"tr":"Fiil","en":"Impératif","role":"v"},{"tr":"-moi / -le / -lui…","en":"pronom","role":"o"}],"examples":[{"text":"[v:Donne]-[o:moi] le sel, s'il te plaît.","tr":"Tuzu bana ver lütfen."},{"text":"[x:Ne] [o:le] [v:fais] [x:pas] !","tr":"Onu yapma!"}],"notes":["Olumluda zamir fiilden sonra gelir (me → moi); olumsuzda fiilden önce."]}],"rules":["Düzensizler: être → sois, soyons, soyez; avoir → aie, ayons, ayez; savoir → sache; vouloir → veuillez.","Dönüşlü fiiller: Lève-toi ! / Ne te lève pas !","y ve en önünde -er fiili s'yi geri alır: Vas-y ! Manges-en !"],"exceptions":[],"mistakes":[{"wrong":"Tu parle !","right":"Parle !","note":"Emirde özne zamiri yok."},{"wrong":"Parles !","right":"Parle !","note":"-er fiillerinde tu emrinde s düşer."},{"wrong":"Donne-me le livre.","right":"Donne-moi le livre.","note":"Olumlu emirde me → moi."}]}},
  {"id":"fr-gr-la-negation-jamais-rien-personne-plus","languageId":"fr","category":"grammar","level":"A2","sourceText":"La négation : jamais, rien, personne, plus","translations":{"tr":["Diğer Olumsuzluklar"]},"grammar":{"summary":"ne … pas yerine ne … jamais (asla), ne … rien (hiçbir şey), ne … personne (kimse), ne … plus (artık) kullanılabilir.","uses":["Hiçbir zaman: ne … jamais","Hiçbir şey / kimse: ne … rien, ne … personne","Artık değil: ne … plus; sadece: ne … que"],"sections":[{"kind":"negative","title":"ne … jamais / ne … plus","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"jamais / plus","en":"jamais / plus","role":"x"}],"examples":[{"text":"[s:Je] [x:ne] [v:fume] [x:jamais].","tr":"Asla sigara içmem."},{"text":"[s:Il] [x:n'][v:habite] [x:plus] ici.","tr":"Artık burada oturmuyor."}]},{"kind":"negative","title":"ne … rien / ne … personne","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"rien / personne","en":"rien / personne","role":"x"}],"examples":[{"text":"[s:Je] [x:ne] [v:vois] [x:rien].","tr":"Hiçbir şey görmüyorum."},{"text":"[s:Il] [x:ne] [v:connaît] [x:personne].","tr":"Kimseyi tanımıyor."}]},{"kind":"other","title":"Özne olarak rien / personne","formula":[{"tr":"Rien / Personne","en":"sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"[s:Personne] [x:ne] [v:répond].","tr":"Kimse cevap vermiyor."},{"text":"[s:Rien] [x:n'][v:est] impossible.","tr":"Hiçbir şey imkânsız değil."}]},{"kind":"other","title":"Passé composé'de","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"avoir / être","en":"auxiliaire","role":"a"},{"tr":"rien / jamais / plus","en":"négation","role":"x"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"}],"examples":[{"text":"[s:Je] [x:n'][a:ai] [x:rien] [v:mangé].","tr":"Hiçbir şey yemedim."},{"text":"[s:Je] [x:n'][a:ai] [v:vu] [x:personne].","tr":"Kimseyi görmedim."}],"notes":["rien, jamais, plus yardımcı fiilden sonra; personne ortaçtan sonra gelir."]}],"rules":["Bu sözcüklerle pas kullanılmaz.","ne … que olumsuz değildir, \"sadece\" demektir: Je n'ai que dix euros.","Kısa cevapta tek başına kullanılır: Qui est là ? — Personne."],"exceptions":[],"mistakes":[{"wrong":"Je ne vois pas rien.","right":"Je ne vois rien.","note":"pas ile rien birlikte kullanılmaz."},{"wrong":"Je n'ai vu rien.","right":"Je n'ai rien vu.","note":"rien yardımcı fiilden sonra gelir."},{"wrong":"Personne ne répond pas.","right":"Personne ne répond.","note":"Fazladan pas yok."}]}},
  {"id":"fr-gr-le-futur-simple","languageId":"fr","category":"grammar","level":"A2","sourceText":"Le futur simple","translations":{"tr":["Gelecek Zaman (Futur simple)"]},"grammar":{"summary":"Futur simple, mastar + -ai, -as, -a, -ons, -ez, -ont ekleriyle kurulur ve gelecekteki olayları anlatır.","uses":["Gelecekle ilgili tahminler","Sözler ve kararlar","Resmî ve yazılı dilde gelecek; quand + gelecek"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Mastar + -ai/-as/-a/-ons/-ez/-ont","en":"Futur simple","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [v:partirai] [o:demain].","tr":"Yarın gideceğim."},{"text":"[s:Nous] [v:parlerons] [o:de ça] plus tard.","tr":"Bunu sonra konuşacağız."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas","en":"pas","role":"x"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Il] [x:ne] [v:viendra] [x:pas] [o:ce soir].","tr":"Bu akşam gelmeyecek."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Est-ce que","en":"Est-ce que","role":"q"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Tümleç?","en":"Complément ?","role":"o"}],"examples":[{"text":"[q:Est-ce qu'][s:il] [v:fera] [o:beau] demain ?","tr":"Yarın hava güzel olacak mı?"},{"text":"[v:Seras]-[s:tu] [o:là] samedi ?","tr":"Cumartesi orada olacak mısın?"}]},{"kind":"wh","title":"Soru kelimeli soru","formula":[{"tr":"Soru kelimesi","en":"Mot interrogatif","role":"q"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"- Özne zamiri","en":"- pronom sujet","role":"s"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[q:Quand] [v:finirez]-[s:vous] [o:ce projet] ?","tr":"Bu projeyi ne zaman bitireceksiniz?"},{"text":"[q:Où] [v:irons]-[s:nous] [o:en vacances] ?","tr":"Tatile nereye gideceğiz?"}]}],"rules":["-re fiillerinde mastarın son e'si düşer: prendre → je prendrai.","Düzensiz kökler: être → ser-, avoir → aur-, aller → ir-, faire → fer-, venir → viendr-, pouvoir → pourr-, voir → verr-, vouloir → voudr-.","quand gelecek anlamındaysa futur alır: Quand je serai grand…"],"exceptions":[],"mistakes":[{"wrong":"Je prendreai.","right":"Je prendrai.","note":"-re fiillerinde e düşer."},{"wrong":"Quand je suis riche, j'achèterai une maison.","right":"Quand je serai riche, j'achèterai une maison.","note":"Gelecekteki quand cümlesi futur alır."},{"wrong":"J'allerai.","right":"J'irai.","note":"aller'in kökü ir-."}]}},
  {"id":"fr-gr-le-passe-recent-et-le-present-progressif","languageId":"fr","category":"grammar","level":"A2","sourceText":"Le passé récent et le présent progressif","translations":{"tr":["venir de ve être en train de"]},"grammar":{"summary":"venir de + mastar \"az önce yaptı\", être en train de + mastar \"şu anda yapmakta\" anlamındadır.","uses":["Az önce olan olaylar: Il vient de partir.","Tam şu anda süren eylemi vurgulamak","Futur proche ile birlikte zaman ekseni: venir de → être en train de → aller"],"sections":[{"kind":"other","title":"Yakın geçmiş: venir de","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"venir (présent) + de","en":"venir de","role":"a"},{"tr":"Mastar","en":"Infinitif","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [a:viens de] [v:finir] [o:mon travail].","tr":"İşimi az önce bitirdim."},{"text":"[s:Le train] [a:vient de] [v:partir].","tr":"Tren az önce kalktı."}]},{"kind":"other","title":"Süreklilik: être en train de","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"être en train de","en":"être en train de","role":"a"},{"tr":"Mastar","en":"Infinitif","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [a:suis en train de] [v:cuisiner].","tr":"Şu anda yemek yapıyorum."},{"text":"[s:Ils] [a:sont en train de] [v:regarder] [o:un film].","tr":"Şu an film izliyorlar."}]},{"kind":"other","title":"Geçmişte","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"venait de / était en train de","en":"imparfait","role":"a"},{"tr":"Mastar","en":"Infinitif","role":"v"}],"examples":[{"text":"[s:Il] [a:venait de] [v:sortir] quand tu as appelé.","tr":"Sen aradığında o yeni çıkmıştı."},{"text":"[s:J'][a:étais en train de] [v:lire].","tr":"Kitap okumaktaydım."}]}],"rules":["venir de ünlüden önce venir d' olur: Il vient d'arriver.","Basit présent de -yor anlamı verir; en train de sadece vurgu içindir.","Geçmişte imparfait ile kullanılır: venait de, était en train de."],"exceptions":[],"mistakes":[{"wrong":"Je viens finir.","right":"Je viens de finir.","note":"venir finir \"bitirmeye geliyorum\" demek olur."},{"wrong":"Je suis en train manger.","right":"Je suis en train de manger.","note":"de atlanmaz."}]}}
]
