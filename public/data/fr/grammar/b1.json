[
  {"id":"fr-gr-passe-compose-ou-imparfait","languageId":"fr","category":"grammar","level":"B1","sourceText":"Passé composé ou imparfait ?","translations":{"tr":["Passé composé mi Imparfait mi?"]},"grammar":{"summary":"Passé composé tamamlanmış olayları, imparfait arka planı ve süren durumları anlatır; hikâyede ikisi birlikte kullanılır.","uses":["Passé composé: bir kez olan, biten, sırayla ilerleyen olaylar","Imparfait: tasvir, alışkanlık, süren eylem","Süren eylemi kesen olay: imparfait + passé composé"],"sections":[{"kind":"other","title":"Arka plan + olay","formula":[{"tr":"Imparfait (süren)","en":"Imparfait","role":"v"},{"tr":"quand","en":"quand","role":"x"},{"tr":"Passé composé (olay)","en":"Passé composé","role":"a"}],"examples":[{"text":"Je [v:dormais] [x:quand] le téléphone [a:a sonné].","tr":"Telefon çaldığında uyuyordum."},{"text":"Il [v:pleuvait], alors nous [a:sommes restés] à la maison.","tr":"Yağmur yağıyordu, bu yüzden evde kaldık."}]},{"kind":"other","title":"Alışkanlık / tek sefer","formula":[{"tr":"Imparfait (her zaman)","en":"Imparfait","role":"v"},{"tr":"Passé composé (bir kez)","en":"Passé composé","role":"a"}],"examples":[{"text":"Chaque été, nous [v:allions] à la mer. Cet été-là, nous [a:sommes allés] à la montagne.","tr":"Her yaz denize giderdik. O yaz dağa gittik."}]},{"kind":"other","title":"Tasvir + olay sırası","formula":[{"tr":"Imparfait (tasvir)","en":"Imparfait","role":"v"},{"tr":"Passé composé (olaylar)","en":"Passé composé","role":"a"}],"examples":[{"text":"Il [v:était] tard. Je [a:suis rentré], j'[a:ai mangé] et je [a:me suis couché].","tr":"Geç olmuştu. Eve döndüm, yemek yedim ve yattım."}]},{"kind":"other","title":"Anlam farkı","formula":[{"tr":"Imparfait","en":"Imparfait","role":"v"},{"tr":"Passé composé","en":"Passé composé","role":"a"}],"examples":[{"text":"Je [v:connaissais] Léa. / J'[a:ai connu] Léa en 2010.","tr":"Léa'yı tanıyordum. / Léa ile 2010'da tanıştım."}],"notes":["Bazı fiillerde zaman anlamı değiştirir: savais (biliyordum) / ai su (öğrendim)."]}],"rules":["Belirli süre ya da sayı (pendant deux heures, trois fois) varsa passé composé.","tous les jours, souvent, d'habitude gibi alışkanlık sözcükleri genelde imparfait ister.","Hava, saat, yaş ve duygu tasviri imparfait ile yapılır."],"exceptions":[],"mistakes":[{"wrong":"Quand j'ai été enfant, j'ai habité à Izmir.","right":"Quand j'étais enfant, j'habitais à Izmir.","note":"Geçmişteki süregelen durum imparfait."},{"wrong":"Je regardais la télé quand il arrivait.","right":"Je regardais la télé quand il est arrivé.","note":"Kesen olay passé composé."},{"wrong":"Hier, je travaillais pendant huit heures.","right":"Hier, j'ai travaillé pendant huit heures.","note":"Sınırlı süre passé composé."}]}},
  {"id":"fr-gr-le-plus-que-parfait","languageId":"fr","category":"grammar","level":"B1","sourceText":"Le plus-que-parfait","translations":{"tr":["Geçmişte Önce Olan (Plus-que-parfait)"]},"grammar":{"summary":"avoir / être'nin imparfait'i + geçmiş ortaç ile, geçmişteki bir olaydan daha önce olanlar anlatılır (-mıştı).","uses":["Geçmişteki bir olaydan önce olan olay","Pişmanlık: Si j'avais su… (bilseydim)","Dolaylı anlatımda passé composé'nin karşılığı"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"avoir / être (imparfait)","en":"auxiliaire à l'imparfait","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"Quand je suis arrivé, [s:le film] [a:avait] [v:commencé].","tr":"Ben vardığımda film başlamıştı."},{"text":"[s:Elle] [a:était] déjà [v:partie].","tr":"O çoktan gitmişti."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"avoir / être","en":"auxiliaire","role":"a"},{"tr":"pas / jamais","en":"négation","role":"x"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [x:n'][a:avais] [x:jamais] [v:vu] [o:la mer] avant.","tr":"Daha önce hiç deniz görmemiştim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"avoir / être","en":"auxiliaire","role":"a"},{"tr":"- Özne zamiri","en":"- pronom sujet","role":"s"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":"Tümleç?","en":"Complément ?","role":"o"}],"examples":[{"text":"[a:Aviez]-[s:vous] déjà [v:visité] [o:Paris] ?","tr":"Daha önce Paris'i gezmiş miydiniz?"}]},{"kind":"wh","title":"Soru kelimeli soru","formula":[{"tr":"Soru kelimesi","en":"Mot interrogatif","role":"q"},{"tr":"avoir / être","en":"auxiliaire","role":"a"},{"tr":"- Özne zamiri","en":"- pronom sujet","role":"s"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"}],"examples":[{"text":"[q:Pourquoi] [a:avait]-[s:il] [v:menti] ?","tr":"Neden yalan söylemişti?"}]}],"rules":["Yardımcı fiil seçimi passé composé ile aynıdır: être alanlar burada da être alır.","Ortaç uyumu passé composé kurallarıyla aynıdır.","déjà ve jamais genelde yardımcı fiil ile ortaç arasına gelir."],"exceptions":[],"mistakes":[{"wrong":"Quand je suis arrivé, il est parti.","right":"Quand je suis arrivé, il était parti.","note":"Ben varmadan önce olan olay plus-que-parfait."},{"wrong":"Elle avait parti.","right":"Elle était partie.","note":"partir être alır."}]}},
  {"id":"fr-gr-le-conditionnel-present","languageId":"fr","category":"grammar","level":"B1","sourceText":"Le conditionnel présent","translations":{"tr":["Şart Kipi (Conditionnel)"]},"grammar":{"summary":"Futur kökü + imparfait ekleri (-ais, -ais, -ait, -ions, -iez, -aient) ile kurulur; istek, nezaket ve varsayım anlatır.","uses":["Kibar istek: Je voudrais un café.","Tavsiye: Tu devrais dormir.","Hayal ve varsayım: J'aimerais voyager.","Doğrulanmamış bilgi: Selon la presse, il serait malade."],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Futur kökü + -ais/-ait/-ions/-iez/-aient","en":"Conditionnel","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [v:voudrais] [o:un café], s'il vous plaît.","tr":"Bir kahve rica ediyorum."},{"text":"[s:Tu] [v:devrais] [o:te reposer].","tr":"Dinlenmelisin."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas","en":"pas","role":"x"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [x:ne] [v:ferais] [x:pas] [o:ça] à ta place.","tr":"Senin yerinde olsam bunu yapmazdım."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"- Özne zamiri","en":"- pronom sujet","role":"s"},{"tr":"Tümleç?","en":"Complément ?","role":"o"}],"examples":[{"text":"[v:Pourriez]-[s:vous] [o:m'aider] ?","tr":"Bana yardım edebilir misiniz?"},{"text":"[v:Aimerais]-[s:tu] [o:venir] ?","tr":"Gelmek ister miydin?"}]},{"kind":"wh","title":"Soru kelimeli soru","formula":[{"tr":"Soru kelimesi","en":"Mot interrogatif","role":"q"},{"tr":"est-ce que","en":"est-ce que","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"[q:Qu'est-ce que] [s:tu] [v:ferais] [o:avec un million] ?","tr":"Bir milyonla ne yapardın?"}]}],"rules":["Kök futur simple ile aynıdır: être → ser-, avoir → aur-, pouvoir → pourr-, vouloir → voudr-.","je voudrais, je pourrais, j'aimerais günlük nezaketin temel kalıplarıdır.","si + imparfait cümlesinin ana cümlesi conditionnel alır."],"exceptions":[],"mistakes":[{"wrong":"Je veux un café, s'il vous plaît.","right":"Je voudrais un café, s'il vous plaît.","note":"Rica ederken conditionnel daha kibardır."},{"wrong":"Si j'aurais le temps, je viendrais.","right":"Si j'avais le temps, je viendrais.","note":"si'den sonra conditionnel gelmez."},{"wrong":"Je voudrai un café (rica).","right":"Je voudrais un café.","note":"-ai futur, -ais conditionnel; anlam farklıdır."}]}},
  {"id":"fr-gr-lhypothese-avec-si","languageId":"fr","category":"grammar","level":"B1","sourceText":"L'hypothèse avec si","translations":{"tr":["si ile Koşul Cümleleri"]},"grammar":{"summary":"si + présent gerçek ve olası koşulu, si + imparfait hayalî koşulu anlatır.","uses":["Gerçek / olası koşul: si + présent → présent, futur ya da impératif","Hayalî koşul: si + imparfait → conditionnel","Öneri: Si on allait au cinéma ?"],"sections":[{"kind":"other","title":"Gerçek koşul","formula":[{"tr":"Si","en":"Si","role":"x"},{"tr":"Présent","en":"Présent","role":"v"},{"tr":"Futur / Présent / Impératif","en":"Proposition principale","role":"a"}],"examples":[{"text":"[x:Si] il [v:pleut], nous [a:resterons] à la maison.","tr":"Yağmur yağarsa evde kalacağız."},{"text":"[x:Si] tu [v:es] fatigué, [a:repose]-toi.","tr":"Yorgunsan dinlen."}]},{"kind":"other","title":"Hayalî koşul","formula":[{"tr":"Si","en":"Si","role":"x"},{"tr":"Imparfait","en":"Imparfait","role":"v"},{"tr":"Conditionnel présent","en":"Conditionnel","role":"a"}],"examples":[{"text":"[x:Si] j'[v:avais] de l'argent, j'[a:achèterais] une maison.","tr":"Param olsa bir ev alırdım."},{"text":"[x:Si] j'[v:étais] toi, je [a:partirais].","tr":"Senin yerinde olsam giderdim."}]},{"kind":"other","title":"Öneri","formula":[{"tr":"Si on / Si tu","en":"Si on","role":"x"},{"tr":"Imparfait … ?","en":"Imparfait","role":"v"}],"examples":[{"text":"[x:Si on] [v:allait] au cinéma ?","tr":"Sinemaya gitsek mi?"},{"text":"[x:Si tu] [v:venais] avec nous ?","tr":"Bizimle gelsene?"}]},{"kind":"other","title":"Ana cümle başta","formula":[{"tr":"Ana cümle","en":"Proposition principale","role":"a"},{"tr":"si","en":"si","role":"x"},{"tr":"Koşul","en":"Condition","role":"v"}],"examples":[{"text":"J'[a:achèterais] une maison [x:si] j'[v:avais] de l'argent.","tr":"Param olsa bir ev alırdım."}],"notes":["Ana cümle başa gelince virgül kullanılmaz."]}],"rules":["si'den sonra asla futur ya da conditionnel gelmez.","si + il / ils → s'il / s'ils; si + elle değişmez.","Geçmişteki gerçekleşmemiş koşul (si + plus-que-parfait) B2 konusudur."],"exceptions":[],"mistakes":[{"wrong":"Si j'aurais de l'argent…","right":"Si j'avais de l'argent…","note":"si + conditionnel olmaz."},{"wrong":"Si il vient…","right":"S'il vient…","note":"si + il → s'il."},{"wrong":"S'il pleuvra, je resterai.","right":"S'il pleut, je resterai.","note":"si + futur olmaz."}]}},
  {"id":"fr-gr-les-pronoms-relatifs-qui-que-ou-dont","languageId":"fr","category":"grammar","level":"B1","sourceText":"Les pronoms relatifs (qui, que, où, dont)","translations":{"tr":["İlgi Zamirleri"]},"grammar":{"summary":"İlgi zamirleri iki cümleyi bağlar: qui (özne), que (nesne), où (yer/zaman), dont (de + isim).","uses":["İsmi tanımlamak: l'homme qui parle","Türkçedeki -an, -dığı sıfat-fiillerini karşılamak"],"sections":[{"kind":"other","title":"qui (özne)","formula":[{"tr":"İsim","en":"Antécédent","role":"o"},{"tr":"qui","en":"qui","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"C'est [o:l'homme] [x:qui] [v:habite] à côté.","tr":"Yan tarafta oturan adam bu."},{"text":"J'ai [o:un ami] [x:qui] [v:parle] chinois.","tr":"Çince konuşan bir arkadaşım var."}]},{"kind":"other","title":"que (nesne)","formula":[{"tr":"İsim","en":"Antécédent","role":"o"},{"tr":"que (qu')","en":"que","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"[o:Le livre] [x:que] [s:je] [v:lis] est génial.","tr":"Okuduğum kitap harika."},{"text":"[o:La femme] [x:qu'][s:il] [v:aime] s'appelle Léa.","tr":"Sevdiği kadının adı Léa."}]},{"kind":"other","title":"où (yer / zaman)","formula":[{"tr":"Yer / Zaman","en":"Antécédent","role":"o"},{"tr":"où","en":"où","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"[o:La ville] [x:où] [s:j'][v:habite] est calme.","tr":"Oturduğum şehir sakin."},{"text":"Je me souviens [o:du jour] [x:où] [s:il] [v:est arrivé].","tr":"Geldiği günü hatırlıyorum."}]},{"kind":"other","title":"dont (de + …)","formula":[{"tr":"İsim","en":"Antécédent","role":"o"},{"tr":"dont","en":"dont","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"[o:Le film] [x:dont] [s:je] [v:parle] est français.","tr":"Bahsettiğim film Fransız."},{"text":"C'est [o:l'ami] [x:dont] [s:la sœur] [v:est] médecin.","tr":"Kız kardeşi doktor olan arkadaş bu."}]}],"rules":["que ünlüden önce qu' olur; qui hiç kısalmaz.","dont, de alan fiillerle kullanılır: parler de, avoir besoin de, être fier de.","que'den sonra avoir ile ortaç nesneye uyar: la robe que j'ai achetée."],"exceptions":[],"mistakes":[{"wrong":"L'homme que habite ici.","right":"L'homme qui habite ici.","note":"Özne ise qui."},{"wrong":"Le film que je parle.","right":"Le film dont je parle.","note":"parler de → dont."},{"wrong":"La ville que j'habite.","right":"La ville où j'habite.","note":"Yer için où."}]}},
  {"id":"fr-gr-le-subjonctif-present","languageId":"fr","category":"grammar","level":"B1","sourceText":"Le subjonctif présent","translations":{"tr":["Dilek Kipi (Subjonctif)"]},"grammar":{"summary":"Subjonctif; zorunluluk, istek, duygu ve şüphe bildiren ifadelerden sonra que ile gelen yan cümlede kullanılır.","uses":["Zorunluluk: il faut que","İstek: vouloir que, souhaiter que","Duygu: être content que, avoir peur que","Bazı bağlaçlar: pour que, bien que, avant que"],"sections":[{"kind":"other","title":"Il faut que","formula":[{"tr":"Il faut que","en":"Il faut que","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Subjonctif","en":"Subjonctif","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[x:Il faut que] [s:tu] [v:viennes] [o:demain].","tr":"Yarın gelmen gerekiyor."},{"text":"[x:Il faut qu'][s:on] [v:parte] [o:tôt].","tr":"Erken çıkmamız lazım."}]},{"kind":"other","title":"İstek / duygu + que","formula":[{"tr":"Ana fiil (istek, duygu)","en":"Verbe de volonté / sentiment","role":"a"},{"tr":"que","en":"que","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Subjonctif","en":"Subjonctif","role":"v"}],"examples":[{"text":"Je [a:veux] [x:que] [s:tu] [v:sois] heureux.","tr":"Mutlu olmanı istiyorum."},{"text":"Je [a:suis content] [x:que] [s:vous] [v:soyez] là.","tr":"Burada olmanıza sevindim."}]},{"kind":"other","title":"Kuruluş","formula":[{"tr":"ils kökü (présent)","en":"radical de « ils »","role":"v"},{"tr":"+ -e/-es/-e/-ions/-iez/-ent","en":"terminaisons","role":"x"}],"examples":[{"text":"ils parlent → que je [v:parle], que nous [v:parlions]","tr":"(ki) konuşayım, (ki) konuşalım"},{"text":"ils prennent → que tu [v:prennes], qu'ils [v:prennent]","tr":"(ki) alasın, (ki) alsınlar"}]},{"kind":"other","title":"Bağlaçlarla","formula":[{"tr":"pour que / bien que / avant que","en":"conjonction","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Subjonctif","en":"Subjonctif","role":"v"}],"examples":[{"text":"Je t'explique [x:pour que] [s:tu] [v:comprennes].","tr":"Anlaman için açıklıyorum."},{"text":"[x:Bien qu'][s:il] [v:fasse] froid, on sort.","tr":"Hava soğuk olsa da çıkıyoruz."}]}],"rules":["Özne aynıysa subjonctif değil mastar kullanılır: Je veux partir.","Düzensizler: être → sois, avoir → aie, aller → aille, faire → fasse, pouvoir → puisse, savoir → sache, vouloir → veuille.","penser que, croire que olumluda indicatif, olumsuzda subjonctif alır: Je ne pense pas qu'il vienne."],"exceptions":["espérer que indicatif alır: J'espère qu'il viendra."],"mistakes":[{"wrong":"Il faut que tu viens.","right":"Il faut que tu viennes.","note":"il faut que + subjonctif."},{"wrong":"Je veux que je parte.","right":"Je veux partir.","note":"Aynı öznede mastar."},{"wrong":"J'espère qu'il vienne.","right":"J'espère qu'il viendra.","note":"espérer indicatif alır."}]}},
  {"id":"fr-gr-les-doubles-pronoms","languageId":"fr","category":"grammar","level":"B1","sourceText":"Les doubles pronoms","translations":{"tr":["Çift Zamirler ve Sıralaması"]},"grammar":{"summary":"İki nesne zamiri birlikte gelince sabit bir sıra izlenir: me/te/nous/vous → le/la/les → lui/leur → y → en.","uses":["Hem şeyi hem kişiyi zamirle söylemek: Je te le donne.","y ve en ile kalıplar: il y en a"],"sections":[{"kind":"other","title":"me / te / nous / vous + le / la / les","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"me / te / nous / vous","en":"COI","role":"o"},{"tr":"le / la / les","en":"COD","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"Le livre ? [s:Je] [o:te] [o:le] [v:prête].","tr":"Kitap mı? Onu sana ödünç veriyorum."},{"text":"[s:Il] [o:nous] [o:les] [v:montre].","tr":"Onları bize gösteriyor."}]},{"kind":"other","title":"le / la / les + lui / leur","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"le / la / les","en":"COD","role":"o"},{"tr":"lui / leur","en":"COI","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"La lettre ? [s:Je] [o:la] [o:lui] [v:envoie].","tr":"Mektup mu? Onu ona gönderiyorum."},{"text":"Les clés ? [s:Elle] [o:les] [o:leur] [v:a données].","tr":"Anahtarlar mı? Onları onlara verdi."}]},{"kind":"other","title":"y ve en ile","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Zamir","en":"pronom","role":"o"},{"tr":"y / en","en":"y / en","role":"o"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"[s:Il] [o:y] [o:en] [v:a] trois.","tr":"Üç tane var."},{"text":"[s:Je] [o:vous] [o:en] [v:donne] deux.","tr":"Size ondan iki tane veriyorum."}]},{"kind":"other","title":"Olumlu emirde","formula":[{"tr":"Fiil","en":"Impératif","role":"v"},{"tr":"-le / -la / -les","en":"COD","role":"o"},{"tr":"-moi / -lui / -leur","en":"COI","role":"o"}],"examples":[{"text":"[v:Donne]-[o:le]-[o:moi] !","tr":"Onu bana ver!"},{"text":"[v:Envoyez]-[o:la]-[o:leur].","tr":"Onu onlara gönderin."}]}],"rules":["Olumlu emirde sıra: fiil + COD + COI (Donne-le-moi).","Olumsuzda zamirler ne'den sonra, fiilden önce gelir: Je ne le lui dis pas.","en her zaman en sondadır: Donne-m'en."],"exceptions":[],"mistakes":[{"wrong":"Je le te donne.","right":"Je te le donne.","note":"me / te önce gelir."},{"wrong":"Je lui le donne.","right":"Je le lui donne.","note":"le / la / les, lui / leur'dan önce gelir."},{"wrong":"Donne-moi-le.","right":"Donne-le-moi.","note":"Olumlu emirde COD önce."}]}},
  {"id":"fr-gr-le-discours-indirect","languageId":"fr","category":"grammar","level":"B1","sourceText":"Le discours indirect","translations":{"tr":["Dolaylı Anlatım"]},"grammar":{"summary":"Başkasının sözünü aktarırken dire que, demander si gibi yapılar kullanılır; zamirler ve gerekirse zamanlar değişir.","uses":["Bir sözü aktarmak: Il dit qu'il est malade.","Soru aktarmak: Elle demande si tu viens.","Emir aktarmak: Il me dit de partir."],"sections":[{"kind":"other","title":"Bildirme","formula":[{"tr":"Özne + dire","en":"Verbe introducteur","role":"a"},{"tr":"que","en":"que","role":"x"},{"tr":"Cümle","en":"Proposition","role":"o"}],"examples":[{"text":"« Je suis fatiguée. » → Marie [a:dit] [x:qu'][o:elle est fatiguée].","tr":"Marie yorgun olduğunu söylüyor."}]},{"kind":"other","title":"Evet / hayır sorusu","formula":[{"tr":"demander","en":"demander","role":"a"},{"tr":"si","en":"si","role":"x"},{"tr":"Cümle","en":"Proposition","role":"o"}],"examples":[{"text":"« Tu viens ? » → Il [a:demande] [x:si] [o:tu viens].","tr":"Gelip gelmediğini soruyor."}]},{"kind":"other","title":"Soru kelimeli soru","formula":[{"tr":"demander","en":"demander","role":"a"},{"tr":"Soru kelimesi / ce que","en":"Mot interrogatif / ce que","role":"q"},{"tr":"Cümle","en":"Proposition","role":"o"}],"examples":[{"text":"« Qu'est-ce que tu fais ? » → Il [a:demande] [q:ce que] [o:tu fais].","tr":"Ne yaptığını soruyor."},{"text":"« Où habites-tu ? » → Elle me [a:demande] [q:où] [o:j'habite].","tr":"Bana nerede oturduğumu soruyor."}]},{"kind":"other","title":"Emir","formula":[{"tr":"dire de","en":"dire de","role":"a"},{"tr":"Mastar","en":"Infinitif","role":"v"}],"examples":[{"text":"« Ferme la porte ! » → Il me [a:dit de] [v:fermer] la porte.","tr":"Bana kapıyı kapatmamı söylüyor."}]},{"kind":"other","title":"Geçmişte zaman kayması","formula":[{"tr":"Ana fiil (geçmiş)","en":"Verbe au passé","role":"a"},{"tr":"que","en":"que","role":"x"},{"tr":"Imparfait / Plus-que-parfait / Conditionnel","en":"Concordance des temps","role":"o"}],"examples":[{"text":"Il [a:a dit] [x:qu'][o:il était malade].","tr":"Hasta olduğunu söyledi."},{"text":"Elle [a:a dit] [x:qu'][o:elle viendrait].","tr":"Geleceğini söyledi."}],"notes":["Ana fiil geçmişteyse: présent → imparfait, passé composé → plus-que-parfait, futur → conditionnel."]}],"rules":["Qu'est-ce que → ce que, qu'est-ce qui → ce qui.","Aktarılan soruda devrik yapı ve soru işareti olmaz.","Zamirler konuşana göre değişir: je → il / elle."],"exceptions":[],"mistakes":[{"wrong":"Il demande est-ce que tu viens.","right":"Il demande si tu viens.","note":"est-ce que → si."},{"wrong":"Il demande qu'est-ce que tu fais.","right":"Il demande ce que tu fais.","note":"qu'est-ce que → ce que."},{"wrong":"Il a dit qu'il viendra.","right":"Il a dit qu'il viendrait.","note":"Geçmişte aktarılan gelecek conditionnel olur."}]}},
  {"id":"fr-gr-le-gerondif","languageId":"fr","category":"grammar","level":"B1","sourceText":"Le gérondif","translations":{"tr":["Gérondif (en + -ant)"]},"grammar":{"summary":"en + -ant ortacıyla aynı öznenin eşzamanlı eylemi, yöntemi ya da koşulu anlatılır.","uses":["Aynı anda iki eylem: -arken","Yöntem: -arak","Koşul: En partant maintenant, tu arriveras à l'heure."],"sections":[{"kind":"other","title":"Kuruluş","formula":[{"tr":"en","en":"en","role":"x"},{"tr":"nous kökü + -ant","en":"participe présent","role":"v"}],"examples":[{"text":"nous parlons → [x:en] [v:parlant]","tr":"konuşarak / konuşurken"},{"text":"nous finissons → [x:en] [v:finissant]","tr":"bitirerek / bitirirken"}]},{"kind":"other","title":"Eşzamanlılık","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"en","en":"en","role":"x"},{"tr":"-ant","en":"participe présent","role":"v"}],"examples":[{"text":"[s:Il] [v:chante] [x:en] [v:prenant] sa douche.","tr":"Duş alırken şarkı söylüyor."},{"text":"[s:Je] l'[v:ai vu] [x:en] [v:sortant] du métro.","tr":"Metrodan çıkarken onu gördüm."}]},{"kind":"other","title":"Yöntem / koşul","formula":[{"tr":"en","en":"en","role":"x"},{"tr":"-ant","en":"participe présent","role":"v"},{"tr":"Ana cümle","en":"Proposition principale","role":"o"}],"examples":[{"text":"On apprend une langue [x:en] [v:pratiquant].","tr":"Dil pratik yaparak öğrenilir."},{"text":"[x:En] [v:partant] maintenant, [o:tu arriveras à l'heure].","tr":"Şimdi çıkarsan zamanında varırsın."}]}],"rules":["Gérondif'in öznesi ana cümlenin öznesiyle aynıdır.","Düzensizler: être → étant, avoir → ayant, savoir → sachant.","tout en + -ant zıtlık ya da eşzamanlılığı vurgular: Il mange tout en travaillant."],"exceptions":[],"mistakes":[{"wrong":"en parlé","right":"en parlant","note":"Ek -ant'tır."},{"wrong":"Il travaille en écoutent de la musique.","right":"Il travaille en écoutant de la musique.","note":"Gérondif çekilmez, hep -ant."},{"wrong":"En sortant du cinéma, la pluie a commencé.","right":"En sortant du cinéma, nous avons vu la pluie.","note":"Gérondif ile ana cümlenin öznesi aynı olmalı."}]}},
  {"id":"fr-gr-la-voix-passive","languageId":"fr","category":"grammar","level":"B1","sourceText":"La voix passive","translations":{"tr":["Edilgen Yapı"]},"grammar":{"summary":"Edilgen yapı être + geçmiş ortaç ile kurulur; eylemi yapan par ile belirtilir.","uses":["Eylemden çok etkilenene odaklanmak","Haber ve resmî dil","Yapanı bilinmeyen ya da önemsiz olan eylemler"],"sections":[{"kind":"other","title":"Edilgen yapı","formula":[{"tr":"Etkilenen","en":"Sujet passif","role":"s"},{"tr":"être (çekimli)","en":"être","role":"a"},{"tr":"Geçmiş ortaç (uyumlu)","en":"Participe passé","role":"v"},{"tr":"par + Yapan","en":"complément d'agent","role":"o"}],"examples":[{"text":"[s:La lettre] [a:est] [v:écrite] [o:par Paul].","tr":"Mektup Paul tarafından yazılıyor."},{"text":"[s:Le musée] [a:a été] [v:construit] [o:en 1900].","tr":"Müze 1900'de inşa edildi."}]},{"kind":"other","title":"Etken → edilgen","formula":[{"tr":"Etken nesne → edilgen özne","en":"COD → sujet","role":"s"},{"tr":"être","en":"être","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":"par + özne","en":"par + agent","role":"o"}],"examples":[{"text":"Le chat mange la souris. → [s:La souris] [a:est] [v:mangée] [o:par le chat].","tr":"Kedi fareyi yiyor. → Fare kedi tarafından yeniliyor."}]},{"kind":"other","title":"Farklı zamanlarda","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"sera / a été / était","en":"être (temps)","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"}],"examples":[{"text":"[s:Les résultats] [a:seront] [v:publiés] demain.","tr":"Sonuçlar yarın yayımlanacak."},{"text":"[s:Le voleur] [a:a été] [v:arrêté].","tr":"Hırsız yakalandı."}]},{"kind":"other","title":"on ile alternatif","formula":[{"tr":"on","en":"on","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"Ici, [s:on] [v:parle] [o:français].","tr":"Burada Fransızca konuşulur."},{"text":"[s:On] [v:a volé] [o:mon vélo].","tr":"Bisikletim çalındı."}],"notes":["Günlük dilde edilgen yerine on daha sık kullanılır."]}],"rules":["Ortaç özneye cinsiyet ve sayıca uyar.","Zamanı être gösterir: est fait, a été fait, sera fait.","Bazı duygu ve durum fiillerinde par yerine de: Il est aimé de tous."],"exceptions":[],"mistakes":[{"wrong":"La maison est construit.","right":"La maison est construite.","note":"Ortaç özneye uyar."},{"wrong":"La lettre a écrite par Paul.","right":"La lettre a été écrite par Paul.","note":"Edilgenin yardımcı fiili être'dir."}]}},
  {"id":"fr-gr-laccord-du-participe-passe","languageId":"fr","category":"grammar","level":"B1","sourceText":"L'accord du participe passé","translations":{"tr":["Geçmiş Ortaç Uyumu"]},"grammar":{"summary":"Geçmiş ortaç être ile özneye, avoir ile ise sadece önde gelen doğrudan nesneye uyar.","uses":["Yazıda doğru ek (-e, -s, -es)","Nesne zamiri ve que'den sonra ortaç uyumu"],"sections":[{"kind":"other","title":"être ile: özneye uyum","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"être","en":"être","role":"a"},{"tr":"Ortaç + e / s","en":"Participe passé accordé","role":"v"}],"examples":[{"text":"[s:Elles] [a:sont] [v:arrivées].","tr":"Geldiler (kadınlar)."},{"text":"[s:Mes parents] [a:sont] [v:partis].","tr":"Ailem gitti."}]},{"kind":"other","title":"avoir ile: uyum yok","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"avoir","en":"avoir","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Elle] [a:a] [v:mangé] [o:une pomme].","tr":"Bir elma yedi."}],"notes":["Nesne fiilden sonra gelirse ortaç değişmez."]},{"kind":"other","title":"avoir + önde gelen nesne","formula":[{"tr":"COD (la, les, que…)","en":"COD placé avant","role":"o"},{"tr":"avoir","en":"avoir","role":"a"},{"tr":"Ortaç + e / s","en":"Participe passé accordé","role":"v"}],"examples":[{"text":"La pomme ? Elle [o:l'][a:a] [v:mangée].","tr":"Elma mı? Onu yedi."},{"text":"[o:Les photos] que j'[a:ai] [v:prises] sont belles.","tr":"Çektiğim fotoğraflar güzel."}]},{"kind":"other","title":"Dönüşlü fiiller","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"se","en":"pronom réfléchi","role":"o"},{"tr":"être","en":"être","role":"a"},{"tr":"Geçmiş ortaç","en":"Participe passé","role":"v"}],"examples":[{"text":"[s:Elle] [o:s'][a:est] [v:lavée].","tr":"Yıkandı."},{"text":"[s:Elle] [o:s'][a:est] [v:lavé] les mains.","tr":"Ellerini yıkadı."}],"notes":["Dönüşlü zamir dolaylı nesneyse (se laver les mains) uyum olmaz."]}],"rules":["être → özneye uyum.","avoir → sadece önde gelen COD'ye uyum.","en ve COI (lui, leur) ile uyum yoktur."],"exceptions":[],"mistakes":[{"wrong":"Elle est allé.","right":"Elle est allée.","note":"être ile özneye uyum."},{"wrong":"Elle a mangée une pomme.","right":"Elle a mangé une pomme.","note":"Nesne sonra gelince uyum yok."},{"wrong":"Les clés ? Je les ai pris.","right":"Les clés ? Je les ai prises.","note":"Önde gelen COD dişil çoğul."}]}},
  {"id":"fr-gr-les-pronoms-demonstratifs-et-possessifs","languageId":"fr","category":"grammar","level":"B1","sourceText":"Les pronoms démonstratifs et possessifs","translations":{"tr":["İşaret ve İyelik Zamirleri"]},"grammar":{"summary":"celui / celle / ceux / celles ve le mien / la mienne… ismi tekrar etmemek için kullanılır.","uses":["İsmi tekrarlamadan göstermek: celui-ci, celle de Paul","Sahipliği zamirle söylemek: C'est le mien."],"sections":[{"kind":"other","title":"İşaret zamiri","formula":[{"tr":"celui / celle / ceux / celles","en":"pronom démonstratif","role":"o"},{"tr":"-ci / -là / de","en":"complément","role":"x"}],"examples":[{"text":"Quelle robe ? [o:Celle]-[x:ci] ou [o:celle]-[x:là] ?","tr":"Hangi elbise? Bu mu, şu mu?"},{"text":"C'est la voiture de Marc ? — Non, c'est [o:celle] [x:de] Julie.","tr":"Marc'ın arabası mı? — Hayır, Julie'ninki."}]},{"kind":"other","title":"celui qui / celui que","formula":[{"tr":"celui / ceux…","en":"pronom démonstratif","role":"o"},{"tr":"qui / que","en":"pronom relatif","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"[o:Celui] [x:qui] [v:arrive] le premier gagne.","tr":"İlk gelen kazanır."},{"text":"Prends [o:ceux] [x:que] tu [v:veux].","tr":"İstediklerini al."}]},{"kind":"other","title":"İyelik zamiri","formula":[{"tr":"le mien / la mienne / les miens / les miennes","en":"pronom possessif","role":"o"}],"examples":[{"text":"Ce n'est pas ton stylo, c'est [o:le mien].","tr":"Bu senin kalemin değil, benimki."},{"text":"Ta maison est grande, [o:la nôtre] est petite.","tr":"Senin evin büyük, bizimki küçük."}]},{"kind":"other","title":"Diğer kişiler","formula":[{"tr":"le tien · le sien · le nôtre · le vôtre · le leur","en":"pronoms possessifs","role":"o"}],"examples":[{"text":"Mon vélo est rouge, [o:le tien] est bleu.","tr":"Benim bisikletim kırmızı, seninki mavi."},{"text":"Ce sont nos clés, pas [o:les leurs].","tr":"Bunlar bizim anahtarlarımız, onlarınki değil."}]}],"rules":["Zamir yerini aldığı ismin cinsiyet ve sayısına uyar: ma clé → la mienne.","celui tek başına kullanılmaz; ardından -ci / -là, de ya da qui / que gelir.","le nôtre / le vôtre şapkalı (ô), notre / votre şapkasız yazılır."],"exceptions":[],"mistakes":[{"wrong":"C'est le mienne.","right":"C'est la mienne.","note":"Artikel ve zamir uyuşur."},{"wrong":"Je préfère celui.","right":"Je préfère celui-ci.","note":"celui tek başına kalmaz."},{"wrong":"Ce livre est à moi, c'est mon.","right":"Ce livre est à moi, c'est le mien.","note":"mon sıfattır; zamiri le mien."}]}}
]
