[
  {"id":"fr-gr-les-articles-et-le-genre","languageId":"fr","category":"grammar","level":"A1","sourceText":"Les articles et le genre","translations":{"tr":["Artikeller ve Cinsiyet"]},"grammar":{"summary":"Fransızcada her isim eril (le/un) ya da dişildir (la/une); çoğulda les/des kullanılır.","uses":["Bilinen ya da genel şeyler için belirli artikel (le, la, l', les)","İlk kez söz edilen şeyler için belirsiz artikel (un, une, des)","Sevme/sevmeme fiillerinden sonra genel anlamda belirli artikel: J'aime le café."],"sections":[{"kind":"other","title":"Belirli artikel","formula":[{"tr":"le / la / l' / les","en":"article défini","role":"x"},{"tr":"İsim","en":"Nom","role":"o"}],"examples":[{"text":"[x:Le] [o:livre] est sur [x:la] [o:table].","tr":"Kitap masanın üstünde."},{"text":"[x:L'][o:école] est grande. [x:Les] [o:enfants] jouent.","tr":"Okul büyük. Çocuklar oynuyor."}],"notes":["Ünlü veya sessiz h ile başlayan isimlerde le/la → l': l'ami, l'heure."]},{"kind":"other","title":"Belirsiz artikel","formula":[{"tr":"un / une / des","en":"article indéfini","role":"x"},{"tr":"İsim","en":"Nom","role":"o"}],"examples":[{"text":"J'ai [x:un] [o:frère] et [x:une] [o:sœur].","tr":"Bir erkek kardeşim ve bir kız kardeşim var."},{"text":"Il y a [x:des] [o:pommes] sur la table.","tr":"Masada elmalar var."}],"notes":["des Türkçeye çevrilmez ama Fransızcada atılamaz."]},{"kind":"other","title":"Cinsiyet ipuçları","formula":[{"tr":"-tion / -té / -ette / -ure","en":"féminin (la)","role":"x"},{"tr":"-ment / -age / -eau / -isme","en":"masculin (le)","role":"x"}],"examples":[{"text":"[x:la] nation, [x:la] liberté, [x:la] voiture","tr":"millet, özgürlük, araba"},{"text":"[x:le] moment, [x:le] fromage, [x:le] bureau","tr":"an, peynir, büro"}]}],"rules":["Her ismi artikeliyle birlikte öğren: la maison, le livre.","Fransızcada isim neredeyse hiç artikelsiz kullanılmaz.","Çoğulda cinsiyet fark etmez: les livres, les maisons."],"exceptions":["Bazı -age ile biten isimler dişildir: la page, la plage, l'image."],"mistakes":[{"wrong":"J'ai frère.","right":"J'ai un frère.","note":"İsmin önüne artikel gerekir."},{"wrong":"le école","right":"l'école","note":"Ünlüden önce le/la → l' olur."},{"wrong":"J'aime café.","right":"J'aime le café.","note":"Sevmek fiillerinden sonra genel anlamda belirli artikel kullanılır."}]}},
  {"id":"fr-gr-les-pronoms-sujets-et-toniques","languageId":"fr","category":"grammar","level":"A1","sourceText":"Les pronoms sujets et toniques","translations":{"tr":["Özne ve Vurgulu Zamirler"]},"grammar":{"summary":"Fransızcada özne zamiri her zaman yazılır: je, tu, il, elle, on, nous, vous, ils, elles.","uses":["Cümlenin öznesini belirtmek","tu (samimi) ile vous (resmî ya da çoğul) arasında seçim yapmak","on ile \"biz\" ya da genel olarak \"insanlar\" demek","Vurgu ve edatlardan sonra moi, toi, lui…"],"sections":[{"kind":"other","title":"Tekil özne zamirleri","formula":[{"tr":"je / tu / il / elle / on","en":"pronom sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [v:parle] [o:français].","tr":"Fransızca konuşuyorum."},{"text":"[s:Elle] [v:habite] [o:à Paris].","tr":"O, Paris'te oturuyor."}],"notes":["je ünlüden önce j' olur: j'aime, j'habite."]},{"kind":"other","title":"Çoğul özne zamirleri","formula":[{"tr":"nous / vous / ils / elles","en":"pronom sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Nous] [v:aimons] [o:le cinéma].","tr":"Sinemayı severiz."},{"text":"[s:Ils] [v:travaillent] [o:ici].","tr":"Onlar burada çalışıyor."}],"notes":["Grupta bir erkek bile varsa ils kullanılır."]},{"kind":"other","title":"tu / vous","formula":[{"tr":"tu (samimi) / vous (resmî)","en":"tutoiement / vouvoiement","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Tu] [v:es] [o:prêt] ?","tr":"Hazır mısın?"},{"text":"[s:Vous] [v:êtes] [o:madame Martin] ?","tr":"Siz Madam Martin misiniz?"}]},{"kind":"other","title":"Vurgulu zamirler","formula":[{"tr":"moi / toi / lui / elle / nous / vous / eux / elles","en":"pronom tonique","role":"s"},{"tr":"Özne zamiri","en":"Pronom sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"[s:Moi], [s:je] [v:suis] [o:turc].","tr":"Ben Türk'üm."},{"text":"Il vient avec [o:moi].","tr":"Benimle geliyor."}]}],"rules":["Fransızcada özne düşmez: Parle français ✗ → Je parle français ✓","on günlük dilde nous yerine çok kullanılır ve fiil 3. tekil çekilir: on va.","Edatlardan sonra vurgulu zamir gelir: avec moi, pour toi, chez eux."],"exceptions":["Emir kipinde özne zamiri kullanılmaz: Parle !"],"mistakes":[{"wrong":"Avec je.","right":"Avec moi.","note":"Edattan sonra vurgulu zamir gelir."},{"wrong":"Suis étudiant.","right":"Je suis étudiant.","note":"Özne zamiri atılmaz."},{"wrong":"On allons au cinéma.","right":"On va au cinéma.","note":"on 3. tekil gibi çekilir."}]}},
  {"id":"fr-gr-etre-et-avoir","languageId":"fr","category":"grammar","level":"A1","sourceText":"Être et avoir","translations":{"tr":["être ve avoir Fiilleri"]},"grammar":{"summary":"être (olmak) ve avoir (sahip olmak) en temel iki düzensiz fiildir ve birleşik zamanlarda yardımcı fiil olur.","uses":["Kimlik, meslek, milliyet, nitelik: Je suis étudiant.","Sahiplik: J'ai une voiture.","Yaş ve bazı durumlar avoir ile: J'ai 20 ans, j'ai faim."],"sections":[{"kind":"affirmative","title":"Olumlu cümle (être)","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"suis / es / est / sommes / êtes / sont","en":"être","role":"a"},{"tr":"Sıfat / İsim","en":"Attribut","role":"o"}],"examples":[{"text":"[s:Je] [a:suis] [o:turc].","tr":"Türk'üm."},{"text":"[s:Nous] [a:sommes] [o:fatigués].","tr":"Yorgunuz."}]},{"kind":"affirmative","title":"Olumlu cümle (avoir)","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ai / as / a / avons / avez / ont","en":"avoir","role":"a"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:J'][a:ai] [o:deux sœurs].","tr":"İki kız kardeşim var."},{"text":"[s:Ils] [a:ont] [o:un chien].","tr":"Onların bir köpeği var."}],"notes":["Yaş avoir ile söylenir: J'ai vingt ans."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"être / avoir","en":"Verbe","role":"a"},{"tr":"pas","en":"pas","role":"x"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [x:ne] [a:suis] [x:pas] [o:français].","tr":"Fransız değilim."},{"text":"[s:Il] [x:n'][a:a] [x:pas] [o:de voiture].","tr":"Arabası yok."}],"notes":["avoir olumsuzunda un/une/des → de: Je n'ai pas de chat."]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Est-ce que","en":"Est-ce que","role":"q"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"être / avoir","en":"Verbe","role":"a"},{"tr":"Tümleç?","en":"Complément ?","role":"o"}],"examples":[{"text":"[q:Est-ce que] [s:tu] [a:es] [o:prêt] ?","tr":"Hazır mısın?"},{"text":"[a:Avez]-[s:vous] [o:des enfants] ?","tr":"Çocuklarınız var mı?"}]}],"rules":["je ünlüden önce j' olur: j'ai.","Duygu ve durum ifadeleri avoir ile: avoir faim, avoir soif, avoir froid, avoir peur.","Tanıtırken c'est + isim kullanılır: C'est mon ami."],"exceptions":["Meslekten önce artikel kullanılmaz: Il est médecin (ama C'est un médecin)."],"mistakes":[{"wrong":"Je suis 20 ans.","right":"J'ai 20 ans.","note":"Yaş avoir ile söylenir."},{"wrong":"Je suis faim.","right":"J'ai faim.","note":"Açlık, susuzluk, korku avoir ile."},{"wrong":"Il est un professeur.","right":"Il est professeur.","note":"il est + meslek artikelsizdir."}]}},
  {"id":"fr-gr-le-present-verbes-en-er","languageId":"fr","category":"grammar","level":"A1","sourceText":"Le présent : verbes en -er","translations":{"tr":["Şimdiki Zaman: -er Fiilleri"]},"grammar":{"summary":"-er ile biten düzenli fiiller (parler, aimer) kök + -e, -es, -e, -ons, -ez, -ent ekleriyle çekilir.","uses":["Şu an yapılan işler (Türkçedeki -yor)","Alışkanlıklar ve genel gerçekler","Yakın gelecekteki kesin planlar"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Kök + -e/-es/-e/-ons/-ez/-ent","en":"Radical + terminaison","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [v:parle] [o:anglais].","tr":"İngilizce konuşuyorum."},{"text":"[s:Nous] [v:habitons] [o:à Lyon].","tr":"Lyon'da oturuyoruz."}],"notes":["-e, -es, -ent ekleri okunmaz: je parle, tu parles, ils parlent aynı okunur."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas","en":"pas","role":"x"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [x:ne] [v:mange] [x:pas] [o:de viande].","tr":"Et yemem."},{"text":"[s:Elle] [x:n'][v:aime] [x:pas] [o:le sport].","tr":"Sporu sevmez."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Est-ce que","en":"Est-ce que","role":"q"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Tümleç?","en":"Complément ?","role":"o"}],"examples":[{"text":"[q:Est-ce que] [s:tu] [v:travailles] [o:aujourd'hui] ?","tr":"Bugün çalışıyor musun?"},{"text":"[v:Parlez]-[s:vous] [o:français] ?","tr":"Fransızca konuşuyor musunuz?"}]},{"kind":"wh","title":"Soru kelimeli soru","formula":[{"tr":"Soru kelimesi","en":"Mot interrogatif","role":"q"},{"tr":"est-ce que","en":"est-ce que","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"[q:Où] [x:est-ce que] [s:tu] [v:habites] ?","tr":"Nerede oturuyorsun?"},{"text":"[q:Qu'est-ce que] [s:vous] [v:cherchez] ?","tr":"Ne arıyorsunuz?"}]}],"rules":["Fransızcada ayrı bir \"-yor\" zamanı yoktur; présent hem -yor hem geniş zamanı karşılar.","-ger fiilleri nous ile e alır (nous mangeons); -cer fiilleri ç alır (nous commençons).","acheter, appeler gibi fiillerde kök değişir: j'achète, j'appelle."],"exceptions":["aller -er ile biter ama düzensizdir: je vais, tu vas, il va."],"mistakes":[{"wrong":"Je suis parle français.","right":"Je parle français.","note":"-yor için être eklenmez."},{"wrong":"Nous mangons.","right":"Nous mangeons.","note":"-ger fiillerinde nous ile e korunur."},{"wrong":"Ils parlont.","right":"Ils parlent.","note":"3. çoğul eki -ent'tir ve okunmaz."}]}},
  {"id":"fr-gr-le-present-verbes-en-ir-et-re","languageId":"fr","category":"grammar","level":"A1","sourceText":"Le présent : verbes en -ir et -re","translations":{"tr":["Şimdiki Zaman: -ir ve -re Fiilleri"]},"grammar":{"summary":"finir tipi fiiller -is, -is, -it, -issons, -issez, -issent; vendre tipi fiiller -s, -s, -, -ons, -ez, -ent ile çekilir.","uses":["Düzenli -ir fiiller: finir, choisir, réussir, grandir","Düzenli -re fiiller: vendre, attendre, répondre, entendre","Şu an, alışkanlık ve genel durumlar"],"sections":[{"kind":"affirmative","title":"Olumlu cümle (-ir: finir)","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Kök + -is/-is/-it/-issons/-issez/-issent","en":"Verbe en -ir","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [v:finis] [o:mon travail] à six heures.","tr":"İşimi altıda bitiririm."},{"text":"[s:Nous] [v:choisissons] [o:un film].","tr":"Bir film seçiyoruz."}]},{"kind":"affirmative","title":"Olumlu cümle (-re: vendre)","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Kök + -s/-s/-/-ons/-ez/-ent","en":"Verbe en -re","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:J'][v:attends] [o:le bus].","tr":"Otobüsü bekliyorum."},{"text":"[s:Il] [v:vend] [o:sa voiture].","tr":"Arabasını satıyor."}],"notes":["3. tekilde ek yoktur: il vend, il attend."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas","en":"pas","role":"x"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Elle] [x:ne] [v:répond] [x:pas] [o:au téléphone].","tr":"Telefona cevap vermiyor."},{"text":"[s:Ils] [x:ne] [v:finissent] [x:pas] [o:leurs devoirs].","tr":"Ödevlerini bitirmiyorlar."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Est-ce que","en":"Est-ce que","role":"q"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Tümleç?","en":"Complément ?","role":"o"}],"examples":[{"text":"[q:Est-ce que] [s:vous] [v:entendez] [o:ce bruit] ?","tr":"Bu sesi duyuyor musunuz?"},{"text":"[v:Choisis]-[s:tu] [o:le rouge] ?","tr":"Kırmızıyı mı seçiyorsun?"}]},{"kind":"wh","title":"Soru kelimeli soru","formula":[{"tr":"Soru kelimesi","en":"Mot interrogatif","role":"q"},{"tr":"est-ce que","en":"est-ce que","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"[q:Qui] [x:est-ce que] [s:vous] [v:attendez] ?","tr":"Kimi bekliyorsunuz?"},{"text":"[q:Quand] [x:est-ce que] [s:tu] [v:finis] ?","tr":"Ne zaman bitiriyorsun?"}]}],"rules":["finir tipi fiillerin çoğulunda -iss- eklenir: nous finissons.","partir, sortir, dormir finir gibi çekilmez: je pars, nous partons.","prendre -re ile biter ama düzensizdir: nous prenons, ils prennent."],"exceptions":["ouvrir, offrir -er fiili gibi çekilir: j'ouvre, tu ouvres."],"mistakes":[{"wrong":"Nous finons.","right":"Nous finissons.","note":"Çoğulda -iss- gerekir."},{"wrong":"Il attendt.","right":"Il attend.","note":"-re fiillerinde 3. tekil eksizdir."},{"wrong":"Nous partissons.","right":"Nous partons.","note":"partir, finir gibi çekilmez."}]}},
  {"id":"fr-gr-le-present-verbes-irreguliers","languageId":"fr","category":"grammar","level":"A1","sourceText":"Le présent : verbes irréguliers","translations":{"tr":["Şimdiki Zaman: Düzensiz Fiiller"]},"grammar":{"summary":"aller, faire, venir, prendre, pouvoir, vouloir, devoir gibi en sık fiiller düzensiz çekilir ve ezberlenmelidir.","uses":["Günlük konuşmanın en sık fiilleri","pouvoir / vouloir / devoir + mastar kalıpları","aller ve venir ile gitme ve gelme"],"sections":[{"kind":"other","title":"aller / venir","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"vais, vas, va, allons, allez, vont","en":"aller","role":"v"},{"tr":"Yer","en":"Lieu","role":"o"}],"examples":[{"text":"[s:Je] [v:vais] [o:au travail].","tr":"İşe gidiyorum."},{"text":"[s:Ils] [v:viennent] [o:de Turquie].","tr":"Türkiye'den geliyorlar."}],"notes":["venir: viens, viens, vient, venons, venez, viennent."]},{"kind":"other","title":"faire / prendre","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"fais, fais, fait, faisons, faites, font","en":"faire","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Vous] [v:faites] [o:du sport] ?","tr":"Spor yapıyor musunuz?"},{"text":"[s:Nous] [v:prenons] [o:le métro].","tr":"Metroya biniyoruz."}],"notes":["prendre: prends, prends, prend, prenons, prenez, prennent."]},{"kind":"other","title":"Modal fiil + mastar","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"pouvoir / vouloir / devoir","en":"Verbe modal","role":"a"},{"tr":"Mastar","en":"Infinitif","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [a:veux] [v:apprendre] [o:le français].","tr":"Fransızca öğrenmek istiyorum."},{"text":"[s:Tu] [a:peux] [v:fermer] [o:la porte] ?","tr":"Kapıyı kapatabilir misin?"}],"notes":["pouvoir: peux, peux, peut, pouvons, pouvez, peuvent · vouloir: veux, veux, veut, voulons, voulez, veulent · devoir: dois, dois, doit, devons, devez, doivent."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Modal fiil","en":"Verbe modal","role":"a"},{"tr":"pas","en":"pas","role":"x"},{"tr":"Mastar","en":"Infinitif","role":"v"}],"examples":[{"text":"[s:Je] [x:ne] [a:peux] [x:pas] [v:venir] demain.","tr":"Yarın gelemem."},{"text":"[s:Il] [x:ne] [a:doit] [x:pas] [v:fumer].","tr":"Sigara içmemeli."}]}],"rules":["vous faites ve vous dites -ez ile bitmez.","Modal fiilden sonra ikinci fiil mastar kalır.","savoir (bilmek, yapabilmek) ile connaître (tanımak) farklıdır."],"exceptions":[],"mistakes":[{"wrong":"Vous faisez.","right":"Vous faites.","note":"faire'in vous çekimi düzensizdir."},{"wrong":"Je veux je mange.","right":"Je veux manger.","note":"Modal fiilden sonra mastar gelir."},{"wrong":"Ils allent.","right":"Ils vont.","note":"aller düzensizdir."}]}},
  {"id":"fr-gr-la-negation-ne-pas","languageId":"fr","category":"grammar","level":"A1","sourceText":"La négation : ne… pas","translations":{"tr":["Olumsuzluk: ne… pas"]},"grammar":{"summary":"Olumsuzluk, çekimli fiili ne … pas arasına alarak yapılır.","uses":["Bir cümleyi olumsuz yapmak","Olumsuzda un/une/des/du → de","Mastarı olumsuz yapmak: ne pas + mastar"],"sections":[{"kind":"negative","title":"Temel olumsuzluk","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas","en":"pas","role":"x"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [x:ne] [v:parle] [x:pas] [o:espagnol].","tr":"İspanyolca konuşmuyorum."},{"text":"[s:Il] [x:n'][v:habite] [x:pas] [o:ici].","tr":"Burada oturmuyor."}]},{"kind":"other","title":"Olumsuzda de","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas de (d')","en":"pas de","role":"x"},{"tr":"İsim","en":"Nom","role":"o"}],"examples":[{"text":"[s:Je] [x:n'][v:ai] [x:pas de] [o:voiture].","tr":"Arabam yok."},{"text":"[s:Elle] [x:ne] [v:boit] [x:pas de] [o:café].","tr":"Kahve içmez."}],"notes":["être ile değişmez: Ce n'est pas un problème."]},{"kind":"other","title":"Modal fiil ve mastarla","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"Çekimli fiil","en":"Verbe conjugué","role":"a"},{"tr":"pas","en":"pas","role":"x"},{"tr":"Mastar","en":"Infinitif","role":"v"}],"examples":[{"text":"[s:Je] [x:ne] [a:veux] [x:pas] [v:partir].","tr":"Gitmek istemiyorum."},{"text":"Il est important de [x:ne pas] [v:fumer].","tr":"Sigara içmemek önemli."}]},{"kind":"other","title":"Günlük konuşma","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"pas","en":"pas","role":"x"}],"examples":[{"text":"[s:Je] [v:sais] [x:pas].","tr":"Bilmiyorum."},{"text":"[s:C'est] [x:pas] grave.","tr":"Önemli değil."}],"notes":["Konuşmada ne çoğu zaman düşer; yazıda mutlaka kullanılır."]}],"rules":["ne ünlüden önce n' olur: Je n'aime pas.","ne … pas çekimli fiili sarar; mastarın önünde ikisi birlikte gelir: ne pas fumer.","Olumsuz soruya olumlu cevapta oui yerine si kullanılır: Tu ne viens pas ? — Si !"],"exceptions":["Belirli artikel olumsuzda değişmez: Je n'aime pas le café."],"mistakes":[{"wrong":"Je ne parle français.","right":"Je ne parle pas français.","note":"Yazıda pas atlanmaz."},{"wrong":"Je n'ai pas une voiture.","right":"Je n'ai pas de voiture.","note":"Olumsuzda un/une → de."},{"wrong":"Je pas aime.","right":"Je n'aime pas.","note":"pas fiilden sonra gelir."}]}},
  {"id":"fr-gr-poser-une-question","languageId":"fr","category":"grammar","level":"A1","sourceText":"Poser une question","translations":{"tr":["Soru Kurma"]},"grammar":{"summary":"Evet/hayır sorusu üç yolla kurulur: tonlama, est-ce que ve devrik yapı (inversion).","uses":["Günlük konuşma: sadece tonlama","Nötr, her yerde: est-ce que","Resmî ve yazılı dil: devrik yapı"],"sections":[{"kind":"question","title":"Tonlama ile","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Tümleç?","en":"Complément ?","role":"o"}],"examples":[{"text":"[s:Tu] [v:viens] [o:ce soir] ?","tr":"Bu akşam geliyor musun?"},{"text":"[s:Vous] [v:aimez] [o:le thé] ?","tr":"Çay sever misiniz?"}],"notes":["Cümle sonunda ses yükselir."]},{"kind":"question","title":"est-ce que ile","formula":[{"tr":"Est-ce que (qu')","en":"Est-ce que","role":"q"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Tümleç?","en":"Complément ?","role":"o"}],"examples":[{"text":"[q:Est-ce que] [s:tu] [v:parles] [o:anglais] ?","tr":"İngilizce konuşuyor musun?"},{"text":"[q:Est-ce qu'][s:il] [v:travaille] [o:demain] ?","tr":"Yarın çalışıyor mu?"}]},{"kind":"question","title":"Devrik yapı","formula":[{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"- Özne zamiri","en":"- pronom sujet","role":"s"},{"tr":"Tümleç?","en":"Complément ?","role":"o"}],"examples":[{"text":"[v:Parlez]-[s:vous] [o:français] ?","tr":"Fransızca konuşuyor musunuz?"},{"text":"[v:A]-t-[s:il] [o:une voiture] ?","tr":"Arabası var mı?"}],"notes":["Fiil ünlüyle bitiyorsa il/elle/on önüne -t- eklenir: Va-t-il ?"]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Oui / Non / Si","en":"Oui / Non / Si","role":"x"}],"examples":[{"text":"Tu aimes le café ? — [x:Oui], j'adore.","tr":"Kahve sever misin? — Evet, bayılırım."},{"text":"Tu n'aimes pas le café ? — [x:Si] !","tr":"Kahve sevmez misin? — Severim tabii!"}]}],"rules":["Devrik yapıda fiil ile zamir arasına tire (-) konur.","est-ce que ünlüden önce est-ce qu' olur.","Olumsuz soruya olumlu cevap si ile verilir."],"exceptions":["je ile devrik yapı neredeyse hiç kullanılmaz (sadece Puis-je ?, Suis-je ? gibi kalıplar)."],"mistakes":[{"wrong":"Est-ce que parles-tu français ?","right":"Est-ce que tu parles français ?","note":"est-ce que ile devrik yapı birlikte kullanılmaz."},{"wrong":"A il une voiture ?","right":"A-t-il une voiture ?","note":"İki ünlü arasına -t- girer."},{"wrong":"Tu ne viens pas ? — Oui !","right":"Tu ne viens pas ? — Si !","note":"Olumsuz soruya olumlu cevap si ile."}]}},
  {"id":"fr-gr-les-mots-interrogatifs","languageId":"fr","category":"grammar","level":"A1","sourceText":"Les mots interrogatifs","translations":{"tr":["Soru Kelimeleri"]},"grammar":{"summary":"qui, que, où, quand, comment, pourquoi, combien ve quel ile bilgi soruları kurulur.","uses":["Kişi: qui; şey: que / quoi","Yer, zaman, şekil, sebep: où, quand, comment, pourquoi","Miktar: combien (de); seçim: quel"],"sections":[{"kind":"wh","title":"Soru kelimesi + est-ce que","formula":[{"tr":"Soru kelimesi","en":"Mot interrogatif","role":"q"},{"tr":"est-ce que","en":"est-ce que","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"}],"examples":[{"text":"[q:Où] [x:est-ce que] [s:tu] [v:travailles] ?","tr":"Nerede çalışıyorsun?"},{"text":"[q:Pourquoi] [x:est-ce qu'][s:il] [v:pleure] ?","tr":"Neden ağlıyor?"}]},{"kind":"wh","title":"Konuşma dili: soru kelimesi sonda","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"Soru kelimesi","en":"Mot interrogatif","role":"q"}],"examples":[{"text":"[s:Tu] [v:habites] [q:où] ?","tr":"Nerede oturuyorsun?"},{"text":"[s:Ça] [v:coûte] [q:combien] ?","tr":"Bu ne kadar?"}]},{"kind":"wh","title":"Devrik yapı","formula":[{"tr":"Soru kelimesi","en":"Mot interrogatif","role":"q"},{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"- Özne zamiri","en":"- pronom sujet","role":"s"}],"examples":[{"text":"[q:Comment] [v:allez]-[s:vous] ?","tr":"Nasılsınız?"},{"text":"[q:Quand] [v:part]-[s:il] ?","tr":"Ne zaman gidiyor?"}]},{"kind":"other","title":"quel / quelle / quels / quelles","formula":[{"tr":"quel(le)(s)","en":"adjectif interrogatif","role":"q"},{"tr":"İsim","en":"Nom","role":"o"}],"examples":[{"text":"[q:Quelle] [o:heure] est-il ?","tr":"Saat kaç?"},{"text":"[q:Quel] [o:âge] as-tu ?","tr":"Kaç yaşındasın?"}],"notes":["quel, isimle cinsiyet ve sayıca uyuşur."]}],"rules":["que + est-ce que → Qu'est-ce que: Qu'est-ce que tu fais ?","Soru kelimesi sona gelirse que → quoi olur: Tu fais quoi ?","combien de + isim: Combien de frères as-tu ?"],"exceptions":[],"mistakes":[{"wrong":"Que tu fais ?","right":"Qu'est-ce que tu fais ?","note":"que normal cümle sırasıyla tek başına kullanılmaz."},{"wrong":"Quel est ta voiture ?","right":"Quelle est ta voiture ?","note":"voiture dişildir."},{"wrong":"Combien frères tu as ?","right":"Combien de frères tu as ?","note":"combien'den sonra de gelir."}]}},
  {"id":"fr-gr-laccord-et-la-place-de-ladjectif","languageId":"fr","category":"grammar","level":"A1","sourceText":"L'accord et la place de l'adjectif","translations":{"tr":["Sıfat Uyumu ve Yeri"]},"grammar":{"summary":"Sıfatlar nitelediği isimle cinsiyet ve sayıca uyuşur ve çoğunlukla ismin arkasına gelir.","uses":["İsmi nitelemek: une voiture rouge","être ile nitelik bildirmek: Elle est contente."],"sections":[{"kind":"other","title":"Dişil: + e","formula":[{"tr":"Eril sıfat","en":"adjectif masculin","role":"x"},{"tr":"+ e","en":"féminin","role":"x"}],"examples":[{"text":"un homme [x:grand] → une femme [x:grande]","tr":"uzun boylu bir adam → uzun boylu bir kadın"},{"text":"Il est [x:content]. Elle est [x:contente].","tr":"O (erkek) memnun. O (kadın) memnun."}],"notes":["Zaten -e ile bitiyorsa değişmez: rapide, jeune."]},{"kind":"other","title":"Çoğul: + s","formula":[{"tr":"Sıfat","en":"Adjectif","role":"x"},{"tr":"+ s (-x)","en":"pluriel","role":"x"}],"examples":[{"text":"des livres [x:intéressants]","tr":"ilginç kitaplar"},{"text":"des filles [x:sérieuses]","tr":"ciddi kızlar"}]},{"kind":"other","title":"Sıfatın yeri","formula":[{"tr":"İsim","en":"Nom","role":"o"},{"tr":"Sıfat","en":"Adjectif","role":"x"}],"examples":[{"text":"une [o:voiture] [x:rouge]","tr":"kırmızı bir araba"},{"text":"un [x:petit] [o:appartement]","tr":"küçük bir daire"}],"notes":["Kısa ve sık sıfatlar (beau, bon, grand, petit, jeune, vieux, nouveau, joli) ismin önüne gelir."]}],"rules":["Renk ve milliyet sıfatları ismin arkasına gelir: un livre français.","-eux → -euse (heureuse), -if → -ive (sportive), -el → -elle (naturelle).","Karışık (eril + dişil) gruplarda sıfat eril çoğul olur."],"exceptions":["beau, nouveau, vieux ünlüden önce bel, nouvel, vieil olur: un bel homme.","Düzensiz dişiller: blanc → blanche, long → longue, gentil → gentille."],"mistakes":[{"wrong":"une maison blanc","right":"une maison blanche","note":"Sıfat dişil isme uyar."},{"wrong":"un rouge livre","right":"un livre rouge","note":"Renk sıfatı ismin arkasına gelir."},{"wrong":"les voitures noir","right":"les voitures noires","note":"Sıfat çoğula da uyar."}]}},
  {"id":"fr-gr-les-adjectifs-possessifs","languageId":"fr","category":"grammar","level":"A1","sourceText":"Les adjectifs possessifs","translations":{"tr":["İyelik Sıfatları"]},"grammar":{"summary":"İyelik sıfatları sahibe göre seçilir ama sahip olunan ismin cinsiyet ve sayısına uyar.","uses":["Benim, senin, onun… demek","Ailenden ve eşyalarından söz etmek"],"sections":[{"kind":"other","title":"Tek sahip","formula":[{"tr":"mon / ma / mes · ton / ta / tes · son / sa / ses","en":"adjectif possessif","role":"x"},{"tr":"İsim","en":"Nom","role":"o"}],"examples":[{"text":"[x:Mon] [o:frère] et [x:ma] [o:sœur] habitent à Lyon.","tr":"Erkek kardeşim ve kız kardeşim Lyon'da oturuyor."},{"text":"[x:Tes] [o:amis] sont sympas.","tr":"Arkadaşların cana yakın."}]},{"kind":"other","title":"Çok sahip","formula":[{"tr":"notre / nos · votre / vos · leur / leurs","en":"adjectif possessif","role":"x"},{"tr":"İsim","en":"Nom","role":"o"}],"examples":[{"text":"[x:Notre] [o:maison] est petite.","tr":"Evimiz küçük."},{"text":"[x:Leurs] [o:enfants] sont à l'école.","tr":"Çocukları okulda."}]},{"kind":"other","title":"Ünlüden önce mon / ton / son","formula":[{"tr":"mon / ton / son","en":"devant voyelle","role":"x"},{"tr":"Dişil isim (ünlüyle)","en":"Nom féminin","role":"o"}],"examples":[{"text":"[x:mon] [o:amie], [x:ton] [o:école], [x:son] [o:adresse]","tr":"kız arkadaşım, okulun, onun adresi"}],"notes":["Dişil isim ünlüyle başlıyorsa ma/ta/sa yerine mon/ton/son kullanılır."]}],"rules":["son/sa/ses sahibin cinsiyetini göstermez: sa voiture = onun (erkeğin ya da kadının) arabası.","leur tekil nesne, leurs çoğul nesne içindir: leur voiture, leurs voitures."],"exceptions":[],"mistakes":[{"wrong":"ma amie","right":"mon amie","note":"Ünlüden önce mon."},{"wrong":"Il aime son mère.","right":"Il aime sa mère.","note":"mère dişildir; sahibin cinsiyeti önemli değil."},{"wrong":"leur enfants","right":"leurs enfants","note":"Çoğul isimde leurs."}]}},
  {"id":"fr-gr-les-adjectifs-demonstratifs","languageId":"fr","category":"grammar","level":"A1","sourceText":"Les adjectifs démonstratifs","translations":{"tr":["İşaret Sıfatları"]},"grammar":{"summary":"ce, cet, cette, ces \"bu/şu\" anlamında ismin önüne gelir.","uses":["Yakındaki ya da gösterilen bir şeyi belirtmek","Zaman ifadeleri: ce soir, cette année"],"sections":[{"kind":"other","title":"ce / cet / cette","formula":[{"tr":"ce / cet / cette","en":"adjectif démonstratif","role":"x"},{"tr":"İsim","en":"Nom","role":"o"}],"examples":[{"text":"[x:Ce] [o:livre] est intéressant.","tr":"Bu kitap ilginç."},{"text":"[x:Cet] [o:hôtel] est cher. [x:Cette] [o:chambre] est petite.","tr":"Bu otel pahalı. Bu oda küçük."}]},{"kind":"other","title":"ces (çoğul)","formula":[{"tr":"ces","en":"pluriel","role":"x"},{"tr":"İsim","en":"Nom","role":"o"}],"examples":[{"text":"[x:Ces] [o:chaussures] sont belles.","tr":"Bu ayakkabılar güzel."}]},{"kind":"other","title":"-ci / -là","formula":[{"tr":"ce + İsim","en":"ce + nom","role":"x"},{"tr":"-ci (bu) / -là (şu)","en":"-ci / -là","role":"x"}],"examples":[{"text":"Je préfère [x:ce] [o:pull]-[x:ci], pas [x:ce] [o:pull]-[x:là].","tr":"Bu kazağı tercih ediyorum, şunu değil."}]}],"rules":["cet, ünlü veya sessiz h ile başlayan eril isimlerden önce: cet ami, cet homme.","Fransızcada \"bu\" ve \"şu\" çoğu zaman ayrılmaz; gerekirse -ci / -là eklenir.","Zaman ifadelerinde \"bu\" anlamı: ce matin, cette semaine."],"exceptions":[],"mistakes":[{"wrong":"ce homme","right":"cet homme","note":"Sessiz h ve ünlüden önce cet."},{"wrong":"cette livre","right":"ce livre","note":"livre erildir."},{"wrong":"ces livre","right":"ces livres","note":"ces + çoğul isim."}]}},
  {"id":"fr-gr-les-prepositions-a-et-de-au-du","languageId":"fr","category":"grammar","level":"A1","sourceText":"Les prépositions à et de (au, du)","translations":{"tr":["à ve de Edatları, Birleşik Artikeller"]},"grammar":{"summary":"à ve de, le ve les ile birleşir: à + le = au, à + les = aux, de + le = du, de + les = des.","uses":["Bir yere gitmek ya da orada bulunmak: au cinéma","Bir yerden gelmek: du bureau","Şehir ve ülke edatları: à Paris, en France, au Japon"],"sections":[{"kind":"other","title":"à + artikel","formula":[{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"au / à la / à l' / aux","en":"à + article","role":"x"},{"tr":"Yer","en":"Lieu","role":"o"}],"examples":[{"text":"Je [v:vais] [x:au] [o:cinéma].","tr":"Sinemaya gidiyorum."},{"text":"Il [v:est] [x:à la] [o:maison].","tr":"Evde."}]},{"kind":"other","title":"de + artikel","formula":[{"tr":"Fiil","en":"Verbe","role":"v"},{"tr":"du / de la / de l' / des","en":"de + article","role":"x"},{"tr":"İsim","en":"Nom","role":"o"}],"examples":[{"text":"Elle [v:revient] [x:du] [o:marché].","tr":"Pazardan dönüyor."},{"text":"C'[v:est] le livre [x:des] [o:étudiants].","tr":"Bu, öğrencilerin kitabı."}]},{"kind":"other","title":"Şehir ve ülke","formula":[{"tr":"à / en / au / aux","en":"préposition","role":"x"},{"tr":"Şehir / Ülke","en":"Ville / Pays","role":"o"}],"examples":[{"text":"J'habite [x:à] [o:Istanbul], [x:en] [o:Turquie].","tr":"İstanbul'da, Türkiye'de oturuyorum."},{"text":"Ils vont [x:au] [o:Canada] et [x:aux] [o:États-Unis].","tr":"Kanada'ya ve ABD'ye gidiyorlar."}],"notes":["Dişil ülkeler (çoğu -e ile biter) en, eril ülkeler au, çoğul ülkeler aux alır."]}],"rules":["à la ve à l' birleşmez: à la gare, à l'école.","Şehirlerde her zaman à: à Paris, à Ankara.","de iyelik bildirir: le chat de Marie (Marie'nin kedisi)."],"exceptions":["le Mexique -e ile bittiği hâlde eril: au Mexique."],"mistakes":[{"wrong":"Je vais à le cinéma.","right":"Je vais au cinéma.","note":"à + le = au."},{"wrong":"Je vais à la France.","right":"Je vais en France.","note":"Dişil ülkelerde en."},{"wrong":"le livre de le professeur","right":"le livre du professeur","note":"de + le = du."}]}},
  {"id":"fr-gr-le-futur-proche","languageId":"fr","category":"grammar","level":"A1","sourceText":"Le futur proche","translations":{"tr":["Yakın Gelecek Zaman"]},"grammar":{"summary":"aller'in présent çekimi + mastar ile yakın gelecek ve planlar anlatılır.","uses":["Yakında olacak şeyler","Planlar ve niyetler","Belirtilere dayalı tahmin: Il va pleuvoir."],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"aller (présent)","en":"aller","role":"a"},{"tr":"Mastar","en":"Infinitif","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Je] [a:vais] [v:manger] [o:au restaurant].","tr":"Restoranda yemek yiyeceğim."},{"text":"[s:Il] [a:va] [v:pleuvoir].","tr":"Yağmur yağacak."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"ne (n')","en":"ne","role":"x"},{"tr":"aller","en":"aller","role":"a"},{"tr":"pas","en":"pas","role":"x"},{"tr":"Mastar","en":"Infinitif","role":"v"},{"tr":"Tümleç","en":"Complément","role":"o"}],"examples":[{"text":"[s:Nous] [x:n'][a:allons] [x:pas] [v:sortir] [o:ce soir].","tr":"Bu akşam dışarı çıkmayacağız."},{"text":"[s:Je] [x:ne] [a:vais] [x:pas] [v:attendre].","tr":"Beklemeyeceğim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Est-ce que","en":"Est-ce que","role":"q"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"aller","en":"aller","role":"a"},{"tr":"Mastar","en":"Infinitif","role":"v"},{"tr":"Tümleç?","en":"Complément ?","role":"o"}],"examples":[{"text":"[q:Est-ce que] [s:tu] [a:vas] [v:venir] ?","tr":"Gelecek misin?"},{"text":"[a:Allez]-[s:vous] [v:acheter] [o:cette maison] ?","tr":"Bu evi alacak mısınız?"}]},{"kind":"wh","title":"Soru kelimeli soru","formula":[{"tr":"Soru kelimesi","en":"Mot interrogatif","role":"q"},{"tr":"est-ce que","en":"est-ce que","role":"x"},{"tr":"Özne","en":"Sujet","role":"s"},{"tr":"aller","en":"aller","role":"a"},{"tr":"Mastar","en":"Infinitif","role":"v"}],"examples":[{"text":"[q:Qu'est-ce que] [s:tu] [a:vas] [v:faire] [o:demain] ?","tr":"Yarın ne yapacaksın?"},{"text":"[q:Quand] [x:est-ce qu'][s:elle] [a:va] [v:arriver] ?","tr":"Ne zaman gelecek?"}]}],"rules":["Olumsuzda ne … pas çekimli aller'i sarar, mastar dışarıda kalır.","Günlük konuşmada gelecek için futur simple'dan daha sık kullanılır.","aller + aller da doğrudur: Je vais aller à Paris."],"exceptions":[],"mistakes":[{"wrong":"Je vais mange.","right":"Je vais manger.","note":"aller'den sonra mastar gelir."},{"wrong":"Je ne vais manger pas.","right":"Je ne vais pas manger.","note":"pas çekimli fiilden hemen sonra gelir."},{"wrong":"Je va partir.","right":"Je vais partir.","note":"je ile vais."}]}}
]
