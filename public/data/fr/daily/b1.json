[
  {"id":"fr-daily-tu-rigoles","languageId":"fr","category":"daily","level":"B1","sourceText":"Tu rigoles ?","translations":{"tr":["şaka mı yapıyorsun?"]},"details":{"register":"informal","context":"İnanılmaz bir habere tepki."},"examples":[{"text":"Le concert est annulé ? Tu rigoles ?","tr":"Konser iptal mi? Şaka mı yapıyorsun?"}]},
  {"id":"fr-daily-ca-ne-me-dit-rien","languageId":"fr","category":"daily","level":"B1","sourceText":"Ça ne me dit rien.","translations":{"tr":["canım istemiyor.","bana bir şey çağrıştırmıyor."]},"details":{"register":"neutral","context":"Bir öneriyi geri çevirirken veya bir ismi hatırlamadığında."},"examples":[{"text":"Le musée ? Ça ne me dit rien aujourd'hui.","tr":"Müze mi? Bugün canım istemiyor."}]},
  {"id":"fr-daily-je-men-fiche","languageId":"fr","category":"daily","level":"B1","sourceText":"Je m'en fiche.","translations":{"tr":["umurumda değil."]},"details":{"register":"informal","context":"Kayıtsızlık; biraz kaba olabilir."},"examples":[{"text":"Ce qu'il pense ? Je m'en fiche.","tr":"Onun ne düşündüğü mü? Umurumda değil."}]},
  {"id":"fr-daily-peu-importe","languageId":"fr","category":"daily","level":"B1","sourceText":"Peu importe.","translations":{"tr":["fark etmez.","önemi yok."]},"details":{"register":"neutral","context":"Bir ayrıntının önemsiz olduğunu belirtirken."},"examples":[{"text":"Peu importe le prix, je le prends.","tr":"Fiyatı önemli değil, alıyorum."}]},
  {"id":"fr-daily-ca-tombe-bien","languageId":"fr","category":"daily","level":"B1","sourceText":"Ça tombe bien !","translations":{"tr":["tam zamanında!","ne iyi denk geldi!"]},"details":{"register":"neutral","context":"Bir şey uygun anda olunca."},"examples":[{"text":"Tu as du pain ? Ça tombe bien, j'en ai besoin.","tr":"Ekmeğin mi var? İyi denk geldi, ihtiyacım vardı."}]},
  {"id":"fr-daily-tinquiete","languageId":"fr","category":"daily","level":"B1","sourceText":"T'inquiète !","translations":{"tr":["merak etme!","takma kafana!"]},"details":{"register":"informal","context":"Gençler arasında 'Ne t'inquiète pas' kısaltması."},"examples":[{"text":"Tu me rends l'argent demain ? — T'inquiète !","tr":"Parayı yarın geri verir misin? — Merak etme!"}]},
  {"id":"fr-daily-laisse-tomber","languageId":"fr","category":"daily","level":"B1","sourceText":"Laisse tomber.","translations":{"tr":["boş ver.","unut gitsin."]},"details":{"register":"informal","context":"Bir konuyu kapatırken."},"examples":[{"text":"Laisse tomber, ce n'est pas important.","tr":"Boş ver, önemli değil."}]},
  {"id":"fr-daily-laisse-moi-tranquille","languageId":"fr","category":"daily","level":"B1","sourceText":"Laisse-moi tranquille !","translations":{"tr":["beni rahat bırak!"]},"details":{"register":"informal","context":"Rahatsız edilince."},"examples":[{"text":"Laisse-moi tranquille, je travaille !","tr":"Beni rahat bırak, çalışıyorum!"}]},
  {"id":"fr-daily-fais-gaffe","languageId":"fr","category":"daily","level":"B1","sourceText":"Fais gaffe !","translations":{"tr":["dikkat et!"]},"details":{"register":"informal","context":"Samimi uyarı; 'Fais attention' anlamında."},"examples":[{"text":"Fais gaffe, la route est glissante !","tr":"Dikkat et, yol kaygan!"}]},
  {"id":"fr-daily-je-suis-creve-e","languageId":"fr","category":"daily","level":"B1","sourceText":"Je suis crevé(e).","translations":{"tr":["çok yorgunum.","bittim."]},"details":{"register":"informal","context":"Aşırı yorgunluğu anlatırken."},"examples":[{"text":"Quelle journée ! Je suis crevé.","tr":"Ne gündü ama! Bittim."}]},
  {"id":"fr-daily-jen-ai-marre","languageId":"fr","category":"daily","level":"B1","sourceText":"J'en ai marre !","translations":{"tr":["bıktım!","yeter artık!"]},"details":{"register":"informal","context":"Bıkkınlığı ifade ederken."},"examples":[{"text":"J'en ai marre de cette pluie !","tr":"Bu yağmurdan bıktım!"}]},
  {"id":"fr-daily-jai-la-flemme","languageId":"fr","category":"daily","level":"B1","sourceText":"J'ai la flemme.","translations":{"tr":["üşeniyorum.","hiç canım istemiyor."]},"details":{"register":"informal","context":"Bir şeyi yapmaya üşendiğini söylerken."},"examples":[{"text":"Sortir ce soir ? J'ai la flemme.","tr":"Bu akşam çıkmak mı? Üşeniyorum."}]},
  {"id":"fr-daily-ca-me-fait-de-la-peine","languageId":"fr","category":"daily","level":"B1","sourceText":"Ça me fait de la peine.","translations":{"tr":["üzülüyorum.","içim acıyor."]},"details":{"register":"neutral","context":"Birinin durumuna üzülürken."},"examples":[{"text":"Ça me fait de la peine de te voir triste.","tr":"Seni üzgün görmek içimi acıtıyor."}]},
  {"id":"fr-daily-je-nen-reviens-pas","languageId":"fr","category":"daily","level":"B1","sourceText":"Je n'en reviens pas !","translations":{"tr":["inanamıyorum!","şaşkınlıktan dilim tutuldu!"]},"details":{"register":"neutral","context":"Büyük şaşkınlık belirtirken."},"examples":[{"text":"Tu t'es marié ? Je n'en reviens pas !","tr":"Evlendin mi? İnanamıyorum!"}]},
  {"id":"fr-daily-ca-alors","languageId":"fr","category":"daily","level":"B1","sourceText":"Ça alors !","translations":{"tr":["vay be!","hayret!"]},"details":{"register":"neutral","context":"Şaşkınlık anında."},"examples":[{"text":"Ça alors ! Toi ici ?","tr":"Hayret! Sen burada mı?"}]},
  {"id":"fr-daily-et-alors","languageId":"fr","category":"daily","level":"B1","sourceText":"Et alors ?","translations":{"tr":["ne olmuş yani?","eee?"]},"details":{"register":"informal","context":"Kayıtsızca veya meydan okuyarak."},"examples":[{"text":"Il est riche. — Et alors ?","tr":"Zengin. — Ne olmuş yani?"}]},
  {"id":"fr-daily-ca-ne-te-regarde-pas","languageId":"fr","category":"daily","level":"B1","sourceText":"Ça ne te regarde pas.","translations":{"tr":["seni ilgilendirmez."]},"details":{"register":"informal","context":"Kişisel bir soruyu geri çevirirken; sert olabilir."},"examples":[{"text":"Tu gagnes combien ? — Ça ne te regarde pas.","tr":"Ne kadar kazanıyorsun? — Seni ilgilendirmez."}]},
  {"id":"fr-daily-je-nai-pas-le-choix","languageId":"fr","category":"daily","level":"B1","sourceText":"Je n'ai pas le choix.","translations":{"tr":["başka seçeneğim yok."]},"details":{"register":"neutral","context":"Bir zorunluluğu açıklarken."},"examples":[{"text":"Je dois travailler samedi, je n'ai pas le choix.","tr":"Cumartesi çalışmak zorundayım, başka seçeneğim yok."}]},
  {"id":"fr-daily-jespere-bien","languageId":"fr","category":"daily","level":"B1","sourceText":"J'espère bien !","translations":{"tr":["umarım öyledir!","öyle olsa iyi olur!"]},"details":{"register":"neutral","context":"Güçlü bir beklentiyi belirtirken."},"examples":[{"text":"Il viendra ? — J'espère bien !","tr":"Gelecek mi? — Umarım öyle!"}]},
  {"id":"fr-daily-moi-si","languageId":"fr","category":"daily","level":"B1","sourceText":"Moi, si.","translations":{"tr":["ben ise evet.","ben seviyorum/yaparım."]},"details":{"register":"neutral","context":"Olumsuz bir cümleye karşı kendi durumunu söylerken."},"examples":[{"text":"Je n'aime pas le jazz. — Moi, si.","tr":"Cazı sevmiyorum. — Ben seviyorum."}]},
  {"id":"fr-daily-carrement","languageId":"fr","category":"daily","level":"B1","sourceText":"Carrément !","translations":{"tr":["kesinlikle!","tabii ki!"]},"details":{"register":"informal","context":"Coşkulu onay."},"examples":[{"text":"Tu viens à la fête ? — Carrément !","tr":"Partiye geliyor musun? — Tabii ki!"}]},
  {"id":"fr-daily-pas-question","languageId":"fr","category":"daily","level":"B1","sourceText":"Pas question !","translations":{"tr":["söz konusu bile değil!","asla!"]},"details":{"register":"informal","context":"Kesin ret."},"examples":[{"text":"Prêter ma voiture ? Pas question !","tr":"Arabamı ödünç vermek mi? Asla!"}]},
  {"id":"fr-daily-cest-clair","languageId":"fr","category":"daily","level":"B1","sourceText":"C'est clair.","translations":{"tr":["kesinlikle.","orası kesin."]},"details":{"register":"informal","context":"Konuşmada güçlü onay olarak."},"examples":[{"text":"Il exagère ! — C'est clair.","tr":"Abartıyor! — Kesinlikle."}]},
  {"id":"fr-daily-tu-sais-quoi","languageId":"fr","category":"daily","level":"B1","sourceText":"Tu sais quoi ?","translations":{"tr":["biliyor musun ne oldu?"]},"details":{"register":"informal","context":"Bir habere giriş yaparken."},"examples":[{"text":"Tu sais quoi ? J'ai trouvé un travail !","tr":"Biliyor musun ne oldu? İş buldum!"}]},
  {"id":"fr-daily-ca-te-gene-si","languageId":"fr","category":"daily","level":"B1","sourceText":"Ça te gêne si …?","translations":{"tr":["… sakıncası var mı?"]},"details":{"register":"neutral","context":"Kibarca izin isterken."},"examples":[{"text":"Ça te gêne si j'ouvre la fenêtre ?","tr":"Pencereyi açmamın sakıncası var mı?"}]},
  {"id":"fr-daily-ca-tombe-mal","languageId":"fr","category":"daily","level":"B1","sourceText":"Ça tombe mal.","translations":{"tr":["kötü denk geldi.","tam da yanlış zamanda."]},"details":{"register":"neutral","context":"Bir şey uygunsuz anda olunca."},"examples":[{"text":"Ma voiture est en panne, ça tombe mal !","tr":"Arabam bozuldu, tam da yanlış zamanda!"}]},
  {"id":"fr-daily-je-nen-peux-plus","languageId":"fr","category":"daily","level":"B1","sourceText":"Je n'en peux plus.","translations":{"tr":["dayanamıyorum artık.","bittim."]},"details":{"register":"neutral","context":"Fiziksel veya ruhsal tükenmişlikte."},"examples":[{"text":"Il fait trop chaud, je n'en peux plus !","tr":"Hava çok sıcak, dayanamıyorum artık!"}]},
  {"id":"fr-daily-cest-pas-la-peine","languageId":"fr","category":"daily","level":"B1","sourceText":"C'est pas la peine.","translations":{"tr":["gerek yok.","zahmet etme."]},"details":{"register":"informal","context":"Birinin bir şey yapmasına gerek olmadığını söylerken."},"examples":[{"text":"Je te raccompagne ? — C'est pas la peine, merci.","tr":"Seni geçireyim mi? — Gerek yok, sağ ol."}]},
  {"id":"fr-daily-ne-vous-derangez-pas","languageId":"fr","category":"daily","level":"B1","sourceText":"Ne vous dérangez pas.","translations":{"tr":["zahmet etmeyin.","rahatınızı bozmayın."]},"details":{"register":"formal","context":"Kibarca, birinin zahmete girmesini istemediğinde."},"examples":[{"text":"Ne vous dérangez pas, je connais le chemin.","tr":"Zahmet etmeyin, yolu biliyorum."}]},
  {"id":"fr-daily-tu-exageres","languageId":"fr","category":"daily","level":"B1","sourceText":"Tu exagères !","translations":{"tr":["abartıyorsun!","bu kadarı da fazla!"]},"details":{"register":"informal","context":"Birinin abartmasına veya haddini aşmasına tepki."},"examples":[{"text":"Trois heures de retard ? Tu exagères !","tr":"Üç saat geç mi? Bu kadarı da fazla!"}]},
  {"id":"fr-daily-bien-joue","languageId":"fr","category":"daily","level":"B1","sourceText":"Bien joué !","translations":{"tr":["aferin!","iyi iş!"]},"details":{"register":"informal","context":"Birinin başarılı hamlesini takdir ederken."},"examples":[{"text":"Tu as eu le prix ? Bien joué !","tr":"Ödülü aldın mı? Aferin!"}]},
  {"id":"fr-daily-avec-joie","languageId":"fr","category":"daily","level":"B1","sourceText":"Avec joie !","translations":{"tr":["seve seve!","büyük bir zevkle!"]},"details":{"register":"neutral","context":"Bir isteği coşkuyla kabul ederken."},"examples":[{"text":"Tu peux garder le chat ? — Avec joie !","tr":"Kediye bakabilir misin? — Seve seve!"}]},
  {"id":"fr-daily-bonne-continuation","languageId":"fr","category":"daily","level":"B1","sourceText":"Bonne continuation !","translations":{"tr":["işlerin rast gitsin!","başarılar!"]},"details":{"register":"neutral","context":"Uzun süre görüşmeyecek birine veda ederken."},"examples":[{"text":"Merci pour tout, et bonne continuation !","tr":"Her şey için teşekkürler, başarılar!"}]},
  {"id":"fr-daily-mes-condoleances","languageId":"fr","category":"daily","level":"B1","sourceText":"Mes condoléances.","translations":{"tr":["başınız sağ olsun."]},"details":{"register":"formal","context":"Bir kayıp yaşayan birine."},"examples":[{"text":"J'ai appris pour votre père. Mes condoléances.","tr":"Babanızı duydum. Başınız sağ olsun."}]}
]
