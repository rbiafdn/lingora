  {"id":"fr-daily-on-y-va","languageId":"fr","category":"daily","level":"A1","sourceText":"On y va ?","translations":{"tr":["gidelim mi?","başlayalım mı?"]},"details":{"register":"informal","context":"Yola çıkmayı veya başlamayı önerirken."},"examples":[{"text":"Tout le monde est prêt ? On y va ?","tr":"Herkes hazır mı? Gidelim mi?"}]},
  {"id":"fr-daily-attends","languageId":"fr","category":"daily","level":"A1","sourceText":"Attends !","translations":{"tr":["bekle!","dur!"]},"details":{"register":"informal","context":"Birini durdururken; resmîde 'Attendez !'."},"examples":[{"text":"Attends, j'arrive !","tr":"Bekle, geliyorum!"}]},
  {"id":"fr-daily-une-seconde","languageId":"fr","category":"daily","level":"A1","sourceText":"Une seconde !","translations":{"tr":["bir saniye!"]},"details":{"register":"informal","context":"Kısa beklemesini isterken."},"examples":[{"text":"Une seconde, je cherche mes clés.","tr":"Bir saniye, anahtarlarımı arıyorum."}]},
  {"id":"fr-daily-jarrive","languageId":"fr","category":"daily","level":"A1","sourceText":"J'arrive !","translations":{"tr":["geliyorum!"]},"details":{"register":"neutral","context":"Çağrıldığında cevap olarak."},"examples":[{"text":"Le repas est prêt ! — J'arrive !","tr":"Yemek hazır! — Geliyorum!"}]},
  {"id":"fr-daily-allo","languageId":"fr","category":"daily","level":"A1","sourceText":"Allô ?","translations":{"tr":["alo?"]},"details":{"register":"neutral","context":"Telefonu açarken."},"examples":[{"text":"Allô ? Oui, c'est moi.","tr":"Alo? Evet, benim."}]},
  {"id":"fr-daily-quelle-heure-est-il","languageId":"fr","category":"daily","level":"A1","sourceText":"Quelle heure est-il ?","translations":{"tr":["saat kaç?"]},"details":{"register":"neutral","context":"Saat sorarken; konuşmada 'Il est quelle heure ?'."},"examples":[{"text":"Excusez-moi, quelle heure est-il ?","tr":"Affedersiniz, saat kaç?"}]},
  {"id":"fr-daily-quel-temps-fait-il","languageId":"fr","category":"daily","level":"A1","sourceText":"Quel temps fait-il ?","translations":{"tr":["hava nasıl?"]},"details":{"register":"neutral","context":"Hava durumunu sorarken."},"examples":[{"text":"Quel temps fait-il à Paris ?","tr":"Paris'te hava nasıl?"}]},
  {"id":"fr-daily-bienvenue","languageId":"fr","category":"daily","level":"A1","sourceText":"Bienvenue !","translations":{"tr":["hoş geldin!","hoş geldiniz!"]},"details":{"register":"neutral","context":"Birini karşılarken."},"examples":[{"text":"Bienvenue à Paris !","tr":"Paris'e hoş geldiniz!"}]},
  {"id":"fr-daily-je-suis-la","languageId":"fr","category":"daily","level":"A1","sourceText":"Je suis là !","translations":{"tr":["buradayım!","geldim!"]},"details":{"register":"neutral","context":"Eve gelince veya bulunduğunu belirtirken."},"examples":[{"text":"Coucou, je suis là !","tr":"Selam, ben geldim!"}]},
  {"id":"fr-daily-je-suis-pret-e","languageId":"fr","category":"daily","level":"A1","sourceText":"Je suis prêt(e).","translations":{"tr":["hazırım."]},"details":{"register":"neutral","context":"Çıkmaya veya başlamaya hazır olunca."},"examples":[{"text":"Tu es prête ? — Oui, je suis prête !","tr":"Hazır mısın? — Evet, hazırım!"}]},
  {"id":"fr-daily-jai-compris","languageId":"fr","category":"daily","level":"A1","sourceText":"J'ai compris.","translations":{"tr":["anladım."]},"details":{"register":"neutral","context":"Açıklamayı anladığını belirtirken."},"examples":[{"text":"Ah, d'accord, j'ai compris !","tr":"Ha, tamam, anladım!"}]},
  {"id":"fr-daily-je-taime","languageId":"fr","category":"daily","level":"A1","sourceText":"Je t'aime.","translations":{"tr":["seni seviyorum."]},"details":{"register":"neutral","context":"Sevgiliye, aileye; arkadaşa 'Je t'aime bien' (hoşlanıyorum) daha hafiftir."},"examples":[{"text":"Bonne nuit, je t'aime.","tr":"İyi geceler, seni seviyorum."}]},
  {"id":"fr-daily-bisous","languageId":"fr","category":"daily","level":"A1","sourceText":"Bisous !","translations":{"tr":["öpücükler!","öptüm!"]},"details":{"register":"informal","context":"Yakınlara mesaj veya telefon sonunda."},"examples":[{"text":"À demain, bisous !","tr":"Yarın görüşürüz, öptüm!"}]},
  {"id":"fr-daily-pourquoi-pas","languageId":"fr","category":"daily","level":"A1","sourceText":"Pourquoi pas ?","translations":{"tr":["neden olmasın?"]},"details":{"register":"neutral","context":"Bir öneriyi kabul ederken."},"examples":[{"text":"On mange italien ? — Pourquoi pas ?","tr":"İtalyan yemeği yiyelim mi? — Neden olmasın?"}]},
  {"id":"fr-daily-vraiment","languageId":"fr","category":"daily","level":"A1","sourceText":"Vraiment ?","translations":{"tr":["gerçekten mi?","cidden mi?"]},"details":{"register":"neutral","context":"Şaşkınlık veya şüphe belirtirken."},"examples":[{"text":"Elle a cinquante ans ? Vraiment ?","tr":"Elli yaşında mı? Gerçekten mi?"}]},
  {"id":"fr-daily-oh-la-la","languageId":"fr","category":"daily","level":"A1","sourceText":"Oh là là !","translations":{"tr":["vay canına!","eyvah!","aman aman!"]},"details":{"register":"neutral","context":"Şaşkınlık, hayranlık veya üzüntü; tonuna göre anlam değişir."},"examples":[{"text":"Oh là là, il est déjà midi !","tr":"Eyvah, saat şimdiden on iki olmuş!"}]},
  {"id":"fr-daily-aie","languageId":"fr","category":"daily","level":"A1","sourceText":"Aïe !","translations":{"tr":["ay!","of!"]},"details":{"register":"informal","context":"Acı hissedince."},"examples":[{"text":"Aïe ! Je me suis coupé.","tr":"Ay! Elimi kestim."}]},
  {"id":"fr-daily-chut","languageId":"fr","category":"daily","level":"A1","sourceText":"Chut !","translations":{"tr":["şşş!","sus!"]},"details":{"register":"informal","context":"Birini susturmak için."},"examples":[{"text":"Chut ! Le bébé dort.","tr":"Şşş! Bebek uyuyor."}]},
  {"id":"fr-daily-euh","languageId":"fr","category":"daily","level":"A1","sourceText":"Euh …","translations":{"tr":["ıı…","şey…"]},"details":{"register":"informal","context":"Düşünürken duraksama sesi."},"examples":[{"text":"Euh… je ne me souviens plus.","tr":"Iı… hatırlamıyorum."}]},
  {"id":"fr-daily-quoi","languageId":"fr","category":"daily","level":"A1","sourceText":"Quoi ?","translations":{"tr":["ne?"]},"details":{"register":"informal","context":"Şaşkınlıkla veya duyamayınca; samimi ortamda."},"examples":[{"text":"Quoi ? Il est déjà parti ?","tr":"Ne? Gitti mi bile?"}]},
  {"id":"fr-daily-cest-genial","languageId":"fr","category":"daily","level":"A1","sourceText":"C'est génial !","translations":{"tr":["harika!","süper!"]},"details":{"register":"neutral","context":"Coşkuyla beğeni belirtirken."},"examples":[{"text":"On part en Italie ? C'est génial !","tr":"İtalya'ya mı gidiyoruz? Harika!"}]},
  {"id":"fr-daily-cest-super","languageId":"fr","category":"daily","level":"A1","sourceText":"C'est super !","translations":{"tr":["süper!","çok iyi!"]},"details":{"register":"informal","context":"Beğeni veya sevinç belirtirken."},"examples":[{"text":"Tu as trouvé un appart ? C'est super !","tr":"Ev mi buldun? Süper!"}]},
  {"id":"fr-daily-attention","languageId":"fr","category":"daily","level":"A1","sourceText":"Attention !","translations":{"tr":["dikkat!"]},"details":{"register":"neutral","context":"Ani bir tehlikeye karşı uyarırken."},"examples":[{"text":"Attention, une voiture !","tr":"Dikkat, araba!"}]},
  {"id":"fr-daily-au-secours","languageId":"fr","category":"daily","level":"A1","sourceText":"Au secours !","translations":{"tr":["imdat!"]},"details":{"register":"neutral","context":"Acil yardım isterken."},"examples":[{"text":"Au secours ! Il y a le feu !","tr":"İmdat! Yangın var!"}]},
  {"id":"fr-daily-vite","languageId":"fr","category":"daily","level":"A1","sourceText":"Vite !","translations":{"tr":["çabuk!","acele et!"]},"details":{"register":"neutral","context":"Birini acele ettirirken."},"examples":[{"text":"Vite, le film commence !","tr":"Çabuk, film başlıyor!"}]},
  {"id":"fr-daily-tu-es-sur-e","languageId":"fr","category":"daily","level":"A1","sourceText":"Tu es sûr(e) ?","translations":{"tr":["emin misin?"]},"details":{"register":"neutral","context":"Şüphe belirtirken veya teyit isterken."},"examples":[{"text":"C'est par là. — Tu es sûr ?","tr":"Bu taraftan. — Emin misin?"}]},
  {"id":"fr-daily-moi-aussi","languageId":"fr","category":"daily","level":"A1","sourceText":"Moi aussi.","translations":{"tr":["ben de."]},"details":{"register":"neutral","context":"Olumlu bir cümleye katılırken."},"examples":[{"text":"J'adore le chocolat. — Moi aussi !","tr":"Çikolataya bayılırım. — Ben de!"}]},
  {"id":"fr-daily-je-peux","languageId":"fr","category":"daily","level":"A1","sourceText":"Je peux ?","translations":{"tr":["olur mu?","alabilir miyim?"]},"details":{"register":"neutral","context":"Bir şeyi alıp kullanmak için izin isterken."},"examples":[{"text":"Cette chaise est libre ? Je peux ?","tr":"Bu sandalye boş mu? Alabilir miyim?"}]},
  {"id":"fr-daily-tu-peux-maider","languageId":"fr","category":"daily","level":"A1","sourceText":"Tu peux m'aider ?","translations":{"tr":["bana yardım eder misin?"]},"details":{"register":"neutral","context":"Yardım isterken; resmîde 'Vous pouvez m'aider ?'."},"examples":[{"text":"Tu peux m'aider à porter ça ?","tr":"Bunu taşımama yardım eder misin?"}]},
  {"id":"fr-daily-bonne-idee","languageId":"fr","category":"daily","level":"A1","sourceText":"Bonne idée !","translations":{"tr":["iyi fikir!"]},"details":{"register":"neutral","context":"Bir öneriyi beğenince."},"examples":[{"text":"On commande une pizza ? — Bonne idée !","tr":"Pizza sipariş edelim mi? — İyi fikir!"}]}
]
