  {"id":"fr-daily-sante","languageId":"fr","category":"daily","level":"A1","sourceText":"Santé !","translations":{"tr":["şerefe!"]},"details":{"register":"neutral","context":"Kadeh tokuştururken; resmîde 'À votre santé !'."},"examples":[{"text":"Allez, santé !","tr":"Hadi, şerefe!"}]},
  {"id":"fr-daily-bon-anniversaire","languageId":"fr","category":"daily","level":"A1","sourceText":"Bon anniversaire !","translations":{"tr":["doğum günün kutlu olsun!"]},"details":{"register":"neutral","context":"Doğum günü kutlarken."},"examples":[{"text":"Bon anniversaire, ma chérie !","tr":"Doğum günün kutlu olsun, canım!"}]},
