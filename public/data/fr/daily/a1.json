  {"id":"fr-daily-bonne-annee","languageId":"fr","category":"daily","level":"A1","sourceText":"Bonne année !","translations":{"tr":["mutlu yıllar!","iyi seneler!"]},"details":{"register":"neutral","context":"Yılbaşında ve ocak ayı boyunca."},"examples":[{"text":"Bonne année et bonne santé !","tr":"Mutlu yıllar, sağlıklı bir yıl dilerim!"}]},
