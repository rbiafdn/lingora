  {"id":"fr-daily-bonne-journee","languageId":"fr","category":"daily","level":"A1","sourceText":"Bonne journée !","translations":{"tr":["iyi günler!"]},"details":{"register":"neutral","context":"Gündüz vedalaşırken; selam için değil."},"examples":[{"text":"Merci, bonne journée !","tr":"Teşekkürler, iyi günler!"}]},
  {"id":"fr-daily-bonne-soiree","languageId":"fr","category":"daily","level":"A1","sourceText":"Bonne soirée !","translations":{"tr":["iyi akşamlar!"]},"details":{"register":"neutral","context":"Akşam vedalaşırken."},"examples":[{"text":"Au revoir, bonne soirée !","tr":"Hoşça kalın, iyi akşamlar!"}]},
  {"id":"fr-daily-bon-week-end","languageId":"fr","category":"daily","level":"A1","sourceText":"Bon week-end !","translations":{"tr":["iyi hafta sonları!"]},"details":{"register":"neutral","context":"Cuma günü vedalaşırken."},"examples":[{"text":"À lundi, bon week-end !","tr":"Pazartesi görüşürüz, iyi hafta sonları!"}]},
  {"id":"fr-daily-ca-va","languageId":"fr","category":"daily","level":"A1","sourceText":"Ça va ?","translations":{"tr":["nasılsın?","iyi misin?"]},"details":{"register":"informal","context":"Samimi selamlaşmada; cevap da 'Ça va' olabilir."},"examples":[{"text":"Salut ! Ça va ? — Ça va, et toi ?","tr":"Selam! Nasılsın? — İyiyim, sen?"}]},
  {"id":"fr-daily-comment-allez-vous","languageId":"fr","category":"daily","level":"A1","sourceText":"Comment allez-vous ?","translations":{"tr":["nasılsınız?"]},"details":{"register":"formal","context":"Resmî ortamda veya tanımadığın birine."},"examples":[{"text":"Bonjour, monsieur. Comment allez-vous ?","tr":"Merhaba beyefendi. Nasılsınız?"}]},
  {"id":"fr-daily-comment-ca-va","languageId":"fr","category":"daily","level":"A1","sourceText":"Comment ça va ?","translations":{"tr":["nasılsın?","nasıl gidiyor?"]},"details":{"register":"neutral","context":"Tanıdıklar arasında."},"examples":[{"text":"Comment ça va, depuis le temps ?","tr":"Uzun zaman oldu, nasılsın?"}]},
  {"id":"fr-daily-tres-bien-merci","languageId":"fr","category":"daily","level":"A1","sourceText":"Très bien, merci.","translations":{"tr":["çok iyiyim, teşekkürler."]},"details":{"register":"neutral","context":"Hâl hatır sorusuna cevap."},"examples":[{"text":"Comment allez-vous ? — Très bien, merci.","tr":"Nasılsınız? — Çok iyiyim, teşekkürler."}]},
  {"id":"fr-daily-et-toi","languageId":"fr","category":"daily","level":"A1","sourceText":"Et toi ?","translations":{"tr":["ya sen?","sen nasılsın?"]},"details":{"register":"informal","context":"Soruyu karşıdakine çevirirken; resmîde 'Et vous ?'."},"examples":[{"text":"Ça va bien, et toi ?","tr":"İyiyim, ya sen?"}]},
  {"id":"fr-daily-pas-mal","languageId":"fr","category":"daily","level":"A1","sourceText":"Pas mal.","translations":{"tr":["fena değil."]},"details":{"register":"informal","context":"Nasılsın sorusuna veya bir şeyi değerlendirirken."},"examples":[{"text":"Ça va ? — Pas mal, et toi ?","tr":"Nasılsın? — Fena değil, sen?"}]},
  {"id":"fr-daily-enchante","languageId":"fr","category":"daily","level":"A1","sourceText":"Enchanté !","translations":{"tr":["memnun oldum!","tanıştığıma memnun oldum!"]},"details":{"register":"neutral","context":"Biriyle ilk tanışırken; kadın konuşursa yazıda 'Enchantée'."},"examples":[{"text":"Je m'appelle Paul. — Enchantée !","tr":"Adım Paul. — Memnun oldum!"}]},
  {"id":"fr-daily-je-mappelle","languageId":"fr","category":"daily","level":"A1","sourceText":"Je m'appelle …","translations":{"tr":["adım …"]},"details":{"register":"neutral","context":"Kendini tanıtırken."},"examples":[{"text":"Bonjour, je m'appelle Ayşe.","tr":"Merhaba, adım Ayşe."}]},
  {"id":"fr-daily-comment-tu-tappelles","languageId":"fr","category":"daily","level":"A1","sourceText":"Comment tu t'appelles ?","translations":{"tr":["adın ne?"]},"details":{"register":"informal","context":"Samimi ortamda isim sorarken; resmîde 'Comment vous appelez-vous ?'."},"examples":[{"text":"Salut ! Comment tu t'appelles ?","tr":"Selam! Adın ne?"}]},
  {"id":"fr-daily-tu-viens-dou","languageId":"fr","category":"daily","level":"A1","sourceText":"Tu viens d'où ?","translations":{"tr":["nerelisin?"]},"details":{"register":"informal","context":"Samimi ortamda; resmîde 'D'où venez-vous ?'."},"examples":[{"text":"Tu viens d'où ? — Je viens de Turquie.","tr":"Nerelisin? — Türkiye'denim."}]},
  {"id":"fr-daily-merci","languageId":"fr","category":"daily","level":"A1","sourceText":"Merci !","translations":{"tr":["teşekkürler!","sağ ol!"]},"details":{"register":"neutral","context":"Her ortamda teşekkür ederken."},"examples":[{"text":"Voilà votre café. — Merci !","tr":"Kahveniz. — Teşekkürler!"}]},
  {"id":"fr-daily-merci-beaucoup","languageId":"fr","category":"daily","level":"A1","sourceText":"Merci beaucoup !","translations":{"tr":["çok teşekkürler!"]},"details":{"register":"neutral","context":"Güçlü teşekkür; 'Merci bien' de denir."},"examples":[{"text":"Merci beaucoup pour le cadeau !","tr":"Hediye için çok teşekkürler!"}]},
  {"id":"fr-daily-de-rien","languageId":"fr","category":"daily","level":"A1","sourceText":"De rien.","translations":{"tr":["rica ederim.","bir şey değil."]},"details":{"register":"neutral","context":"Teşekküre en yaygın cevap."},"examples":[{"text":"Merci ! — De rien.","tr":"Teşekkürler! — Rica ederim."}]},
  {"id":"fr-daily-avec-plaisir","languageId":"fr","category":"daily","level":"A1","sourceText":"Avec plaisir !","translations":{"tr":["memnuniyetle!","seve seve!"]},"details":{"register":"neutral","context":"Bir teklifi kabul ederken ya da teşekküre cevap verirken."},"examples":[{"text":"Tu viens dîner ? — Avec plaisir !","tr":"Yemeğe gelir misin? — Seve seve!"}]},
  {"id":"fr-daily-sil-vous-plait","languageId":"fr","category":"daily","level":"A1","sourceText":"S'il vous plaît.","translations":{"tr":["lütfen."]},"details":{"register":"formal","context":"Resmî ya da yabancıya; samimide 'S'il te plaît'."},"examples":[{"text":"Un café, s'il vous plaît.","tr":"Bir kahve, lütfen."}]},
  {"id":"fr-daily-sil-te-plait","languageId":"fr","category":"daily","level":"A1","sourceText":"S'il te plaît.","translations":{"tr":["lütfen."]},"details":{"register":"informal","context":"Arkadaş ve aile arasında."},"examples":[{"text":"Passe-moi le sel, s'il te plaît.","tr":"Tuzu uzatır mısın, lütfen."}]},
  {"id":"fr-daily-excusez-moi","languageId":"fr","category":"daily","level":"A1","sourceText":"Excusez-moi.","translations":{"tr":["affedersiniz.","pardon."]},"details":{"register":"formal","context":"Birine seslenirken veya küçük bir rahatsızlık için."},"examples":[{"text":"Excusez-moi, où est la gare ?","tr":"Affedersiniz, gar nerede?"}]},
  {"id":"fr-daily-pardon","languageId":"fr","category":"daily","level":"A1","sourceText":"Pardon !","translations":{"tr":["pardon!","özür dilerim!"]},"details":{"register":"neutral","context":"Birine çarpınca, yol isterken veya duyamayınca."},"examples":[{"text":"Pardon, je peux passer ?","tr":"Pardon, geçebilir miyim?"}]},
  {"id":"fr-daily-comment","languageId":"fr","category":"daily","level":"A1","sourceText":"Comment ?","translations":{"tr":["efendim?","nasıl?"]},"details":{"register":"neutral","context":"Duyamadığında tekrar istemek için; Quoi ? dan daha kibar."},"examples":[{"text":"Comment ? Je n'ai pas entendu.","tr":"Efendim? Duyamadım."}]},
  {"id":"fr-daily-desole-e","languageId":"fr","category":"daily","level":"A1","sourceText":"Désolé(e).","translations":{"tr":["üzgünüm.","kusura bakma."]},"details":{"register":"neutral","context":"Özür dilerken; kadın konuşursa yazıda désolée."},"examples":[{"text":"Désolé, je suis en retard.","tr":"Kusura bakma, geç kaldım."}]},
  {"id":"fr-daily-ce-nest-pas-grave","languageId":"fr","category":"daily","level":"A1","sourceText":"Ce n'est pas grave.","translations":{"tr":["önemli değil.","sorun değil."]},"details":{"register":"neutral","context":"Özre cevap; konuşmada 'C'est pas grave'."},"examples":[{"text":"Pardon ! — Ce n'est pas grave.","tr":"Pardon! — Önemli değil."}]},
  {"id":"fr-daily-pas-de-probleme","languageId":"fr","category":"daily","level":"A1","sourceText":"Pas de problème.","translations":{"tr":["sorun yok."]},"details":{"register":"neutral","context":"Bir isteği kabul ederken."},"examples":[{"text":"On se voit à six heures ? — Pas de problème.","tr":"Saat altıda görüşelim mi? — Sorun yok."}]},
  {"id":"fr-daily-oui","languageId":"fr","category":"daily","level":"A1","sourceText":"Oui.","translations":{"tr":["evet."]},"details":{"register":"neutral","context":"Olumlu soruya evet; olumsuz soruya itiraz için 'Si'."},"examples":[{"text":"Tu es prêt ? — Oui.","tr":"Hazır mısın? — Evet."}]},
  {"id":"fr-daily-si","languageId":"fr","category":"daily","level":"A1","sourceText":"Si !","translations":{"tr":["evet! (olumsuz soruya)","hayır, öyle!"]},"details":{"register":"neutral","context":"Olumsuz bir soru veya cümleye karşı çıkarken."},"examples":[{"text":"Tu n'aimes pas le café ? — Si, j'adore !","tr":"Kahve sevmiyor musun? — Seviyorum, bayılırım!"}]},
  {"id":"fr-daily-ouais","languageId":"fr","category":"daily","level":"A1","sourceText":"Ouais.","translations":{"tr":["he.","evet."]},"details":{"register":"informal","context":"Konuşmada oui'nin gündelik hâli."},"examples":[{"text":"Tu viens ? — Ouais, j'arrive.","tr":"Geliyor musun? — He, geliyorum."}]},
  {"id":"fr-daily-non-merci","languageId":"fr","category":"daily","level":"A1","sourceText":"Non, merci.","translations":{"tr":["hayır, teşekkürler."]},"details":{"register":"neutral","context":"Bir teklifi kibarca reddederken."},"examples":[{"text":"Encore du thé ? — Non, merci.","tr":"Biraz daha çay? — Hayır, teşekkürler."}]},
