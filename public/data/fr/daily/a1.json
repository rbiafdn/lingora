  {"id":"fr-daily-je-ne-sais-pas","languageId":"fr","category":"daily","level":"A1","sourceText":"Je ne sais pas.","translations":{"tr":["bilmiyorum."]},"details":{"register":"neutral","context":"Konuşmada 'Je sais pas' veya 'Chais pas' diye söylenir."},"examples":[{"text":"Où est Paul ? — Je ne sais pas.","tr":"Paul nerede? — Bilmiyorum."}]},
  {"id":"fr-daily-je-ne-comprends-pas","languageId":"fr","category":"daily","level":"A1","sourceText":"Je ne comprends pas.","translations":{"tr":["anlamıyorum."]},"details":{"register":"neutral","context":"Anlamadığını belirtirken."},"examples":[{"text":"Désolé, je ne comprends pas.","tr":"Kusura bakmayın, anlamıyorum."}]},
