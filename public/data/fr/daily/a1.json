  {"id":"fr-daily-bonnes-vacances","languageId":"fr","category":"daily","level":"A1","sourceText":"Bonnes vacances !","translations":{"tr":["iyi tatiller!"]},"details":{"register":"neutral","context":"Tatile çıkan birine."},"examples":[{"text":"À septembre, bonnes vacances !","tr":"Eylülde görüşürüz, iyi tatiller!"}]},
  {"id":"fr-daily-entrez","languageId":"fr","category":"daily","level":"A1","sourceText":"Entrez !","translations":{"tr":["girin!","buyurun!"]},"details":{"register":"neutral","context":"Kapı çalınınca."},"examples":[{"text":"Toc toc. — Entrez !","tr":"Tak tak. — Girin!"}]},
  {"id":"fr-daily-tiens","languageId":"fr","category":"daily","level":"A1","sourceText":"Tiens !","translations":{"tr":["al!","buyur!","bak sen!"]},"details":{"register":"informal","context":"Bir şey verirken; şaşırınca 'bak sen!' anlamında da."},"examples":[{"text":"Tiens, c'est pour toi.","tr":"Al, bu senin için."}]},
  {"id":"fr-daily-voila","languageId":"fr","category":"daily","level":"A1","sourceText":"Voilà !","translations":{"tr":["işte!","buyurun!","tamam!"]},"details":{"register":"neutral","context":"Bir şeyi verirken veya bir işi bitirince."},"examples":[{"text":"Voilà votre monnaie.","tr":"Buyurun paranızın üstü."}]},
