[
  {"id":"fr-daily-bonjour","languageId":"fr","category":"daily","level":"A1","sourceText":"Bonjour !","translations":{"tr":["merhaba!","günaydın!","iyi günler!"]},"details":{"register":"neutral","context":"Gün boyunca, akşama kadar selamlaşırken; dükkâna girerken de söylenir."},"examples":[{"text":"Bonjour, madame !","tr":"Merhaba, hanımefendi!"}]},
  {"id":"fr-daily-bonsoir","languageId":"fr","category":"daily","level":"A1","sourceText":"Bonsoir !","translations":{"tr":["iyi akşamlar!"]},"details":{"register":"neutral","context":"Akşam saatlerinde selamlaşırken veya vedalaşırken."},"examples":[{"text":"Bonsoir, vous avez une table pour deux ?","tr":"İyi akşamlar, iki kişilik masanız var mı?"}]},
  {"id":"fr-daily-bonne-nuit","languageId":"fr","category":"daily","level":"A1","sourceText":"Bonne nuit !","translations":{"tr":["iyi geceler!"]},"details":{"register":"neutral","context":"Yatmadan önce söylenir; selam için kullanılmaz."},"examples":[{"text":"Bonne nuit, à demain !","tr":"İyi geceler, yarın görüşürüz!"}]},
  {"id":"fr-daily-salut","languageId":"fr","category":"daily","level":"A1","sourceText":"Salut !","translations":{"tr":["selam!","hoşça kal!"]},"details":{"register":"informal","context":"Arkadaşlar arasında hem selam hem veda."},"examples":[{"text":"Salut Marc, ça va ?","tr":"Selam Marc, nasılsın?"}]},
  {"id":"fr-daily-coucou","languageId":"fr","category":"daily","level":"A1","sourceText":"Coucou !","translations":{"tr":["selam!","cee!"]},"details":{"register":"informal","context":"Çok samimi, aile ve yakın arkadaşlar arasında; mesajlarda sık."},"examples":[{"text":"Coucou ! Tu es où ?","tr":"Selam! Neredesin?"}]},
  {"id":"fr-daily-au-revoir","languageId":"fr","category":"daily","level":"A1","sourceText":"Au revoir !","translations":{"tr":["hoşça kalın!","güle güle!"]},"details":{"register":"neutral","context":"Her ortamda vedalaşırken."},"examples":[{"text":"Au revoir, et merci !","tr":"Hoşça kalın, teşekkürler!"}]},
  {"id":"fr-daily-a-demain","languageId":"fr","category":"daily","level":"A1","sourceText":"À demain !","translations":{"tr":["yarın görüşürüz!"]},"details":{"register":"neutral","context":"Ertesi gün görüşülecek kişiyle vedalaşırken."},"examples":[{"text":"Bonne soirée, à demain !","tr":"İyi akşamlar, yarın görüşürüz!"}]},
  {"id":"fr-daily-a-plus","languageId":"fr","category":"daily","level":"A1","sourceText":"À plus !","translations":{"tr":["görüşürüz!","sonra görüşürüz!"]},"details":{"register":"informal","context":"Arkadaşlar arasında; mesajda A+ yazılır."},"examples":[{"text":"Allez, à plus !","tr":"Hadi, görüşürüz!"}]},
