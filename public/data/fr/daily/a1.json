  {"id":"fr-daily-comment-dit-on-en-francais","languageId":"fr","category":"daily","level":"A1","sourceText":"Comment dit-on … en français ?","translations":{"tr":["… Fransızcada nasıl denir?"]},"details":{"register":"neutral","context":"Kelime sorarken."},"examples":[{"text":"Comment dit-on « kitap » en français ?","tr":"'Kitap' Fransızcada nasıl denir?"}]},
  {"id":"fr-daily-quest-ce-que-ca-veut-dire","languageId":"fr","category":"daily","level":"A1","sourceText":"Qu'est-ce que ça veut dire ?","translations":{"tr":["bu ne demek?"]},"details":{"register":"neutral","context":"Bir kelimenin veya sözün anlamını sorarken."},"examples":[{"text":"« Bouquin » ? Qu'est-ce que ça veut dire ?","tr":"'Bouquin' mi? Bu ne demek?"}]},
  {"id":"fr-daily-vous-parlez-anglais","languageId":"fr","category":"daily","level":"A1","sourceText":"Vous parlez anglais ?","translations":{"tr":["İngilizce konuşuyor musunuz?"]},"details":{"register":"formal","context":"Yardım isterken ortak dil ararken."},"examples":[{"text":"Pardon, vous parlez anglais ?","tr":"Pardon, İngilizce konuşuyor musunuz?"}]},
  {"id":"fr-daily-je-parle-un-peu-francais","languageId":"fr","category":"daily","level":"A1","sourceText":"Je parle un peu français.","translations":{"tr":["biraz Fransızca konuşuyorum."]},"details":{"register":"neutral","context":"Dil seviyeni belirtirken."},"examples":[{"text":"Je suis turc, je parle un peu français.","tr":"Türk'üm, biraz Fransızca konuşuyorum."}]},
  {"id":"fr-daily-ou-sont-les-toilettes","languageId":"fr","category":"daily","level":"A1","sourceText":"Où sont les toilettes ?","translations":{"tr":["tuvalet nerede?"]},"details":{"register":"neutral","context":"Restoran, kafe vb. yerlerde."},"examples":[{"text":"Excusez-moi, où sont les toilettes ?","tr":"Affedersiniz, tuvalet nerede?"}]},
  {"id":"fr-daily-cest-combien","languageId":"fr","category":"daily","level":"A1","sourceText":"C'est combien ?","translations":{"tr":["kaç para?","ne kadar?"]},"details":{"register":"neutral","context":"Alışverişte fiyat sorarken; 'Ça coûte combien ?' de denir."},"examples":[{"text":"Ce pull, c'est combien ?","tr":"Bu kazak kaç para?"}]},
  {"id":"fr-daily-laddition-sil-vous-plait","languageId":"fr","category":"daily","level":"A1","sourceText":"L'addition, s'il vous plaît.","translations":{"tr":["hesap, lütfen."]},"details":{"register":"neutral","context":"Restoranda hesabı isterken."},"examples":[{"text":"Monsieur, l'addition, s'il vous plaît.","tr":"Beyefendi, hesap lütfen."}]},
  {"id":"fr-daily-je-voudrais","languageId":"fr","category":"daily","level":"A1","sourceText":"Je voudrais …","translations":{"tr":["… istiyorum","… rica ediyorum"]},"details":{"register":"neutral","context":"Kibarca bir şey isterken; je veux'dan daha naziktir."},"examples":[{"text":"Je voudrais une baguette, s'il vous plaît.","tr":"Bir baget rica ediyorum."}]},
  {"id":"fr-daily-cest-tout","languageId":"fr","category":"daily","level":"A1","sourceText":"C'est tout.","translations":{"tr":["bu kadar.","hepsi bu."]},"details":{"register":"neutral","context":"Alışverişte başka istemediğini söylerken."},"examples":[{"text":"Et avec ceci ? — C'est tout, merci.","tr":"Başka bir şey? — Bu kadar, teşekkürler."}]},
  {"id":"fr-daily-je-peux-payer-par-carte","languageId":"fr","category":"daily","level":"A1","sourceText":"Je peux payer par carte ?","translations":{"tr":["kartla ödeyebilir miyim?"]},"details":{"register":"neutral","context":"Ödeme yaparken."},"examples":[{"text":"Je peux payer par carte ? — Bien sûr.","tr":"Kartla ödeyebilir miyim? — Tabii."}]},
