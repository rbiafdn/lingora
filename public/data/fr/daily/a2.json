[
  {"id":"fr-daily-a-la-prochaine","languageId":"fr","category":"daily","level":"A2","sourceText":"À la prochaine !","translations":{"tr":["bir dahaki sefere!"]},"details":{"register":"neutral","context":"Ne zaman görüşüleceği belli değilken vedalaşırken."},"examples":[{"text":"Merci pour la soirée, à la prochaine !","tr":"Akşam için teşekkürler, bir dahaki sefere!"}]},
  {"id":"fr-daily-comme-ci-comme-ca","languageId":"fr","category":"daily","level":"A2","sourceText":"Comme ci, comme ça.","translations":{"tr":["şöyle böyle."]},"details":{"register":"informal","context":"Çok iyi olmadığını söylerken."},"examples":[{"text":"Ton examen ? — Comme ci, comme ça.","tr":"Sınavın? — Şöyle böyle."}]},
  {"id":"fr-daily-quoi-de-neuf","languageId":"fr","category":"daily","level":"A2","sourceText":"Quoi de neuf ?","translations":{"tr":["ne var ne yok?","ne haber?"]},"details":{"register":"informal","context":"Arkadaşlarla sohbet açarken."},"examples":[{"text":"Salut ! Quoi de neuf ?","tr":"Selam! Ne var ne yok?"}]},
  {"id":"fr-daily-rien-de-special","languageId":"fr","category":"daily","level":"A2","sourceText":"Rien de spécial.","translations":{"tr":["özel bir şey yok."]},"details":{"register":"neutral","context":"Quoi de neuf ? sorusuna cevap."},"examples":[{"text":"Quoi de neuf ? — Rien de spécial.","tr":"Ne var ne yok? — Özel bir şey yok."}]},
  {"id":"fr-daily-je-vous-en-prie","languageId":"fr","category":"daily","level":"A2","sourceText":"Je vous en prie.","translations":{"tr":["rica ederim.","buyurun."]},"details":{"register":"formal","context":"Resmî teşekküre cevap; bir şey sunarken 'buyurun' anlamında da."},"examples":[{"text":"Merci, monsieur. — Je vous en prie.","tr":"Teşekkürler, beyefendi. — Rica ederim."}]},
  {"id":"fr-daily-je-ten-prie","languageId":"fr","category":"daily","level":"A2","sourceText":"Je t'en prie.","translations":{"tr":["rica ederim.","estağfurullah."]},"details":{"register":"neutral","context":"Samimi ama kibar teşekküre cevap."},"examples":[{"text":"Merci pour ton aide. — Je t'en prie.","tr":"Yardımın için sağ ol. — Rica ederim."}]},
  {"id":"fr-daily-il-ny-a-pas-de-quoi","languageId":"fr","category":"daily","level":"A2","sourceText":"Il n'y a pas de quoi.","translations":{"tr":["bir şey değil.","lafı bile olmaz."]},"details":{"register":"neutral","context":"Teşekküre cevap; konuşmada 'Y a pas de quoi'."},"examples":[{"text":"Merci mille fois ! — Il n'y a pas de quoi.","tr":"Binlerce teşekkür! — Lafı bile olmaz."}]},
  {"id":"fr-daily-je-suis-vraiment-desole-e","languageId":"fr","category":"daily","level":"A2","sourceText":"Je suis vraiment désolé(e).","translations":{"tr":["gerçekten çok üzgünüm."]},"details":{"register":"neutral","context":"Güçlü özür veya başsağlığı."},"examples":[{"text":"Je suis vraiment désolé pour hier.","tr":"Dün için gerçekten çok üzgünüm."}]},
  {"id":"fr-daily-pas-de-souci","languageId":"fr","category":"daily","level":"A2","sourceText":"Pas de souci !","translations":{"tr":["sorun değil!","dert etme!"]},"details":{"register":"informal","context":"Teşekküre, özre veya isteğe rahat cevap."},"examples":[{"text":"Tu peux m'aider ? — Pas de souci !","tr":"Yardım eder misin? — Sorun değil!"}]},
  {"id":"fr-daily-ca-marche","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça marche !","translations":{"tr":["tamamdır!","olur!","anlaştık!"]},"details":{"register":"informal","context":"Bir öneri veya plana onay verirken."},"examples":[{"text":"Demain, huit heures ? — Ça marche !","tr":"Yarın saat sekiz? — Tamamdır!"}]},
  {"id":"fr-daily-bien-sur-que-oui","languageId":"fr","category":"daily","level":"A2","sourceText":"Bien sûr que oui !","translations":{"tr":["tabii ki evet!"]},"details":{"register":"neutral","context":"Güçlü onay; zıttı 'Bien sûr que non'."},"examples":[{"text":"Tu m'aimes ? — Bien sûr que oui !","tr":"Beni seviyor musun? — Tabii ki evet!"}]},
  {"id":"fr-daily-volontiers","languageId":"fr","category":"daily","level":"A2","sourceText":"Volontiers !","translations":{"tr":["memnuniyetle!","seve seve!"]},"details":{"register":"neutral","context":"Bir teklifi kabul ederken."},"examples":[{"text":"Un café ? — Volontiers !","tr":"Kahve? — Memnuniyetle!"}]},
  {"id":"fr-daily-et-avec-ceci","languageId":"fr","category":"daily","level":"A2","sourceText":"Et avec ceci ?","translations":{"tr":["başka bir şey?"]},"details":{"register":"neutral","context":"Satıcı müşteriye başka bir şey isteyip istemediğini sorar."},"examples":[{"text":"Deux croissants. — Et avec ceci ?","tr":"İki kruvasan. — Başka bir şey?"}]},
  {"id":"fr-daily-gardez-la-monnaie","languageId":"fr","category":"daily","level":"A2","sourceText":"Gardez la monnaie.","translations":{"tr":["üstü kalsın."]},"details":{"register":"neutral","context":"Bahşiş bırakırken."},"examples":[{"text":"Voilà vingt euros, gardez la monnaie.","tr":"Buyurun yirmi euro, üstü kalsın."}]},
  {"id":"fr-daily-a-tes-souhaits","languageId":"fr","category":"daily","level":"A2","sourceText":"À tes souhaits !","translations":{"tr":["çok yaşa!"]},"details":{"register":"informal","context":"Biri hapşırınca; resmîde 'À vos souhaits !'."},"examples":[{"text":"Atchoum ! — À tes souhaits !","tr":"Hapşu! — Çok yaşa!"}]},
  {"id":"fr-daily-felicitations","languageId":"fr","category":"daily","level":"A2","sourceText":"Félicitations !","translations":{"tr":["tebrikler!"]},"details":{"register":"neutral","context":"Başarı, nişan, doğum vb. için."},"examples":[{"text":"Tu as eu ton diplôme ? Félicitations !","tr":"Diplomanı aldın mı? Tebrikler!"}]},
  {"id":"fr-daily-bon-courage","languageId":"fr","category":"daily","level":"A2","sourceText":"Bon courage !","translations":{"tr":["kolay gelsin!","sabır dilerim!"]},"details":{"register":"neutral","context":"Zor veya yorucu bir iş yapacak birine."},"examples":[{"text":"Encore trois heures de travail ? Bon courage !","tr":"Daha üç saat iş mi var? Kolay gelsin!"}]},
  {"id":"fr-daily-bonne-route","languageId":"fr","category":"daily","level":"A2","sourceText":"Bonne route !","translations":{"tr":["iyi yolculuklar!","yolun açık olsun!"]},"details":{"register":"neutral","context":"Arabayla yola çıkan birine."},"examples":[{"text":"Soyez prudents, bonne route !","tr":"Dikkatli olun, yolunuz açık olsun!"}]},
  {"id":"fr-daily-bon-retablissement","languageId":"fr","category":"daily","level":"A2","sourceText":"Bon rétablissement !","translations":{"tr":["geçmiş olsun!","acil şifalar!"]},"details":{"register":"neutral","context":"Hasta birine iyi dileklerde bulunurken."},"examples":[{"text":"Tu es malade ? Bon rétablissement !","tr":"Hasta mısın? Geçmiş olsun!"}]},
  {"id":"fr-daily-amuse-toi-bien","languageId":"fr","category":"daily","level":"A2","sourceText":"Amuse-toi bien !","translations":{"tr":["iyi eğlenceler!"]},"details":{"register":"informal","context":"Partiye, geziye giden birine; çoğulda 'Amusez-vous bien !'."},"examples":[{"text":"Tu vas au concert ? Amuse-toi bien !","tr":"Konsere mi gidiyorsun? İyi eğlenceler!"}]},
  {"id":"fr-daily-asseyez-vous","languageId":"fr","category":"daily","level":"A2","sourceText":"Asseyez-vous.","translations":{"tr":["oturun.","buyurun oturun."]},"details":{"register":"formal","context":"Misafire yer gösterirken; samimide 'Assieds-toi'."},"examples":[{"text":"Bonjour, asseyez-vous, je vous prie.","tr":"Merhaba, buyurun oturun lütfen."}]},
  {"id":"fr-daily-fais-comme-chez-toi","languageId":"fr","category":"daily","level":"A2","sourceText":"Fais comme chez toi.","translations":{"tr":["kendi evin gibi rahat ol."]},"details":{"register":"informal","context":"Misafiri ağırlarken."},"examples":[{"text":"Entre, fais comme chez toi !","tr":"Gir, kendi evin gibi rahat ol!"}]},
  {"id":"fr-daily-un-instant-sil-vous-plait","languageId":"fr","category":"daily","level":"A2","sourceText":"Un instant, s'il vous plaît.","translations":{"tr":["bir saniye lütfen."]},"details":{"register":"formal","context":"Telefonda veya hizmet verirken beklemesini isterken."},"examples":[{"text":"Un instant, s'il vous plaît, je vérifie.","tr":"Bir saniye lütfen, kontrol ediyorum."}]},
  {"id":"fr-daily-cest-de-la-part-de-qui","languageId":"fr","category":"daily","level":"A2","sourceText":"C'est de la part de qui ?","translations":{"tr":["kim arıyor?","kimden diyeyim?"]},"details":{"register":"formal","context":"Telefonda arayanın adını sorarken."},"examples":[{"text":"Je voudrais parler à M. Durand. — C'est de la part de qui ?","tr":"Bay Durand ile görüşmek istiyorum. — Kim arıyor?"}]},
  {"id":"fr-daily-ne-quittez-pas","languageId":"fr","category":"daily","level":"A2","sourceText":"Ne quittez pas.","translations":{"tr":["hatta kalın.","ayrılmayın."]},"details":{"register":"formal","context":"Telefonda bağlarken."},"examples":[{"text":"Ne quittez pas, je vous le passe.","tr":"Hatta kalın, size bağlıyorum."}]},
  {"id":"fr-daily-ca-fait-longtemps","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça fait longtemps !","translations":{"tr":["uzun zaman oldu!","görüşmeyeli çok oldu!"]},"details":{"register":"informal","context":"Uzun süre görmediğin biriyle karşılaşınca."},"examples":[{"text":"Julie ! Ça fait longtemps !","tr":"Julie! Görüşmeyeli çok oldu!"}]},
  {"id":"fr-daily-tu-me-manques","languageId":"fr","category":"daily","level":"A2","sourceText":"Tu me manques.","translations":{"tr":["seni özledim."]},"details":{"register":"neutral","context":"Dikkat: kelimesi kelimesine 'sen bana eksiksin'; özne özlenen kişidir."},"examples":[{"text":"Reviens vite, tu me manques !","tr":"Çabuk dön, seni özledim!"}]},
  {"id":"fr-daily-je-tembrasse","languageId":"fr","category":"daily","level":"A2","sourceText":"Je t'embrasse.","translations":{"tr":["öperim.","sevgiler."]},"details":{"register":"informal","context":"Mektup, mesaj veya telefon kapanışında."},"examples":[{"text":"Bon, je te laisse. Je t'embrasse !","tr":"Neyse, seni bırakıyorum. Öperim!"}]},
  {"id":"fr-daily-ca-te-dit","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça te dit ?","translations":{"tr":["ne dersin?","canın ister mi?"]},"details":{"register":"informal","context":"Bir öneri yaparken."},"examples":[{"text":"Un ciné ce soir, ça te dit ?","tr":"Bu akşam sinema, ne dersin?"}]},
  {"id":"fr-daily-une-autre-fois-peut-etre","languageId":"fr","category":"daily","level":"A2","sourceText":"Une autre fois, peut-être.","translations":{"tr":["belki başka sefere."]},"details":{"register":"neutral","context":"Bir daveti kibarca geri çevirirken."},"examples":[{"text":"Ce soir, je ne peux pas. Une autre fois, peut-être.","tr":"Bu akşam olmaz. Belki başka sefere."}]},
  {"id":"fr-daily-cest-pas-vrai","languageId":"fr","category":"daily","level":"A2","sourceText":"C'est pas vrai !","translations":{"tr":["olamaz!","yok artık!"]},"details":{"register":"informal","context":"Şaşkınlık veya kızgınlık anında."},"examples":[{"text":"Il a gagné au loto ? C'est pas vrai !","tr":"Lotoda kazandı mı? Yok artık!"}]},
  {"id":"fr-daily-ah-bon","languageId":"fr","category":"daily","level":"A2","sourceText":"Ah bon ?","translations":{"tr":["öyle mi?","sahi mi?"]},"details":{"register":"neutral","context":"Yeni bir bilgiye şaşırarak tepki verirken."},"examples":[{"text":"Il part au Canada. — Ah bon ?","tr":"Kanada'ya gidiyor. — Öyle mi?"}]},
  {"id":"fr-daily-serieux","languageId":"fr","category":"daily","level":"A2","sourceText":"Sérieux ?","translations":{"tr":["ciddi misin?","cidden mi?"]},"details":{"register":"informal","context":"Gençler arasında şaşkınlık tepkisi."},"examples":[{"text":"Tu as démissionné ? Sérieux ?","tr":"İstifa mı ettin? Cidden mi?"}]},
  {"id":"fr-daily-je-plaisante","languageId":"fr","category":"daily","level":"A2","sourceText":"Je plaisante !","translations":{"tr":["şaka yapıyorum!"]},"details":{"register":"neutral","context":"Söylediğinin şaka olduğunu belirtirken."},"examples":[{"text":"Mais non, je plaisante !","tr":"Yok canım, şaka yapıyorum!"}]},
  {"id":"fr-daily-mon-dieu","languageId":"fr","category":"daily","level":"A2","sourceText":"Mon Dieu !","translations":{"tr":["Aman Tanrım!","Allah'ım!"]},"details":{"register":"neutral","context":"Büyük şaşkınlık veya korku anında."},"examples":[{"text":"Mon Dieu, tu es blessé ?","tr":"Aman Tanrım, yaralandın mı?"}]},
  {"id":"fr-daily-zut","languageId":"fr","category":"daily","level":"A2","sourceText":"Zut !","translations":{"tr":["hay aksi!","tüh!"]},"details":{"register":"informal","context":"Küçük bir aksilikte; kaba değil."},"examples":[{"text":"Zut, j'ai oublié mes clés !","tr":"Hay aksi, anahtarlarımı unuttum!"}]},
  {"id":"fr-daily-mince","languageId":"fr","category":"daily","level":"A2","sourceText":"Mince !","translations":{"tr":["tüh!","hay Allah!"]},"details":{"register":"informal","context":"Küçük bir aksilikte, kibar küfür yerine."},"examples":[{"text":"Mince, le bus est parti !","tr":"Tüh, otobüs kaçtı!"}]},
  {"id":"fr-daily-berk","languageId":"fr","category":"daily","level":"A2","sourceText":"Berk !","translations":{"tr":["iğrenç!","ıyy!"]},"details":{"register":"informal","context":"Tiksinti belirtirken."},"examples":[{"text":"Berk, c'est froid !","tr":"Iyy, soğumuş!"}]},
  {"id":"fr-daily-miam","languageId":"fr","category":"daily","level":"A2","sourceText":"Miam !","translations":{"tr":["nefis!","hım, enfes!"]},"details":{"register":"informal","context":"Lezzetli bir şey görünce/yiyince."},"examples":[{"text":"Miam, ça sent bon !","tr":"Hım, güzel kokuyor!"}]},
  {"id":"fr-daily-bof","languageId":"fr","category":"daily","level":"A2","sourceText":"Bof.","translations":{"tr":["eh işte.","pek değil."]},"details":{"register":"informal","context":"İlgisizlik veya hoşnutsuzluk belirtirken."},"examples":[{"text":"Tu as aimé le film ? — Bof.","tr":"Filmi beğendin mi? — Eh işte."}]},
  {"id":"fr-daily-bah","languageId":"fr","category":"daily","level":"A2","sourceText":"Bah …","translations":{"tr":["ee…","yani…"]},"details":{"register":"informal","context":"Düşünürken veya kararsızken konuşmayı doldurur."},"examples":[{"text":"Bah, je ne sais pas trop.","tr":"Ee, pek bilmiyorum."}]},
  {"id":"fr-daily-hein","languageId":"fr","category":"daily","level":"A2","sourceText":"Hein ?","translations":{"tr":["ha?","ne?"]},"details":{"register":"informal","context":"Duymadığında veya şaşırınca; kaba sayılabilir, 'Pardon ?' daha kibar."},"examples":[{"text":"Hein ? Qu'est-ce que tu dis ?","tr":"Ha? Ne diyorsun?"}]},
  {"id":"fr-daily-trop-bien","languageId":"fr","category":"daily","level":"A2","sourceText":"Trop bien !","translations":{"tr":["çok iyi!","süper!"]},"details":{"register":"informal","context":"Gençler arasında coşkulu beğeni."},"examples":[{"text":"On va à la plage ? Trop bien !","tr":"Plaja mı gidiyoruz? Çok iyi!"}]},
  {"id":"fr-daily-cest-nul","languageId":"fr","category":"daily","level":"A2","sourceText":"C'est nul !","translations":{"tr":["berbat!","çok kötü!"]},"details":{"register":"informal","context":"Bir şeyi beğenmediğini belirtirken."},"examples":[{"text":"Ce jeu est nul !","tr":"Bu oyun berbat!"}]},
  {"id":"fr-daily-cest-dommage","languageId":"fr","category":"daily","level":"A2","sourceText":"C'est dommage !","translations":{"tr":["ne yazık!","yazık!"]},"details":{"register":"neutral","context":"Hayal kırıklığı veya üzüntü belirtirken."},"examples":[{"text":"Tu ne peux pas venir ? C'est dommage !","tr":"Gelemiyor musun? Ne yazık!"}]},
  {"id":"fr-daily-quelle-chance","languageId":"fr","category":"daily","level":"A2","sourceText":"Quelle chance !","translations":{"tr":["ne şans!","ne kadar şanslısın!"]},"details":{"register":"neutral","context":"Birinin şansına sevinirken."},"examples":[{"text":"Tu pars à Bali ? Quelle chance !","tr":"Bali'ye mi gidiyorsun? Ne şans!"}]},
  {"id":"fr-daily-quelle-horreur","languageId":"fr","category":"daily","level":"A2","sourceText":"Quelle horreur !","translations":{"tr":["ne korkunç!","iğrenç!"]},"details":{"register":"neutral","context":"Dehşet veya tiksinti belirtirken."},"examples":[{"text":"Un rat dans la cuisine ? Quelle horreur !","tr":"Mutfakta fare mi? Ne korkunç!"}]},
  {"id":"fr-daily-quelle-bonne-idee","languageId":"fr","category":"daily","level":"A2","sourceText":"Quelle bonne idée !","translations":{"tr":["ne güzel fikir!"]},"details":{"register":"neutral","context":"Bir öneriyi beğenince."},"examples":[{"text":"Un pique-nique ? Quelle bonne idée !","tr":"Piknik mi? Ne güzel fikir!"}]},
  {"id":"fr-daily-ca-me-plait","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça me plaît.","translations":{"tr":["hoşuma gidiyor."]},"details":{"register":"neutral","context":"Beğeni belirtirken."},"examples":[{"text":"Cette couleur, ça me plaît beaucoup.","tr":"Bu renk çok hoşuma gidiyor."}]},
  {"id":"fr-daily-ca-mest-egal","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça m'est égal.","translations":{"tr":["benim için fark etmez."]},"details":{"register":"neutral","context":"Tercihin olmadığını söylerken."},"examples":[{"text":"Pizza ou pâtes ? — Ça m'est égal.","tr":"Pizza mı makarna mı? — Fark etmez."}]},
  {"id":"fr-daily-comme-tu-veux","languageId":"fr","category":"daily","level":"A2","sourceText":"Comme tu veux.","translations":{"tr":["nasıl istersen.","sen bilirsin."]},"details":{"register":"informal","context":"Kararı karşıdakine bırakırken; resmîde 'Comme vous voulez'."},"examples":[{"text":"On prend le métro ? — Comme tu veux.","tr":"Metroya binelim mi? — Nasıl istersen."}]},
  {"id":"fr-daily-ne-tinquiete-pas","languageId":"fr","category":"daily","level":"A2","sourceText":"Ne t'inquiète pas.","translations":{"tr":["merak etme.","endişelenme."]},"details":{"register":"neutral","context":"Birini rahatlatırken; resmîde 'Ne vous inquiétez pas'."},"examples":[{"text":"Ne t'inquiète pas, tout va bien se passer.","tr":"Merak etme, her şey yolunda gidecek."}]},
  {"id":"fr-daily-calme-toi","languageId":"fr","category":"daily","level":"A2","sourceText":"Calme-toi.","translations":{"tr":["sakin ol."]},"details":{"register":"informal","context":"Sinirli veya panik birine."},"examples":[{"text":"Calme-toi, ce n'est rien.","tr":"Sakin ol, bir şey yok."}]},
  {"id":"fr-daily-courage","languageId":"fr","category":"daily","level":"A2","sourceText":"Courage !","translations":{"tr":["dayan!","cesaret!"]},"details":{"register":"neutral","context":"Zorluk yaşayan birini desteklerken."},"examples":[{"text":"Plus que deux jours, courage !","tr":"Sadece iki gün kaldı, dayan!"}]},
  {"id":"fr-daily-ca-va-aller","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça va aller.","translations":{"tr":["geçecek.","her şey yoluna girecek."]},"details":{"register":"neutral","context":"Üzgün birini teselli ederken."},"examples":[{"text":"Ne pleure pas, ça va aller.","tr":"Ağlama, her şey yoluna girecek."}]},
  {"id":"fr-daily-je-comprends","languageId":"fr","category":"daily","level":"A2","sourceText":"Je comprends.","translations":{"tr":["anlıyorum."]},"details":{"register":"neutral","context":"Empati gösterirken."},"examples":[{"text":"Tu es fatigué, je comprends.","tr":"Yorgunsun, anlıyorum."}]},
  {"id":"fr-daily-ca-arrive","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça arrive.","translations":{"tr":["olur böyle şeyler."]},"details":{"register":"neutral","context":"Bir hatayı veya aksiliği hafifletirken."},"examples":[{"text":"J'ai raté le train. — Ça arrive.","tr":"Treni kaçırdım. — Olur böyle şeyler."}]},
  {"id":"fr-daily-cest-la-vie","languageId":"fr","category":"daily","level":"A2","sourceText":"C'est la vie.","translations":{"tr":["hayat bu.","ne yapalım, hayat."]},"details":{"register":"neutral","context":"Değiştirilemeyecek bir duruma kabullenerek."},"examples":[{"text":"On a perdu, mais c'est la vie.","tr":"Kaybettik ama hayat bu."}]},
  {"id":"fr-daily-ca-y-est","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça y est !","translations":{"tr":["tamam!","oldu!","işte!"]},"details":{"register":"neutral","context":"Bir şey nihayet gerçekleşince veya bitince."},"examples":[{"text":"Ça y est, j'ai fini !","tr":"Tamam, bitirdim!"}]},
  {"id":"fr-daily-cest-parti","languageId":"fr","category":"daily","level":"A2","sourceText":"C'est parti !","translations":{"tr":["başlıyoruz!","hadi bakalım!"]},"details":{"register":"informal","context":"Bir işe veya yolculuğa başlarken."},"examples":[{"text":"Tout le monde est là ? C'est parti !","tr":"Herkes burada mı? Başlıyoruz!"}]},
  {"id":"fr-daily-ca-suffit","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça suffit !","translations":{"tr":["yeter!"]},"details":{"register":"neutral","context":"Birini durdururken, sabır tükenince."},"examples":[{"text":"Ça suffit, les enfants !","tr":"Yeter, çocuklar!"}]},
  {"id":"fr-daily-depeche-toi","languageId":"fr","category":"daily","level":"A2","sourceText":"Dépêche-toi !","translations":{"tr":["acele et!","çabuk ol!"]},"details":{"register":"informal","context":"Samimi; resmîde 'Dépêchez-vous !'."},"examples":[{"text":"Dépêche-toi, on va être en retard !","tr":"Acele et, geç kalacağız!"}]},
  {"id":"fr-daily-prends-ton-temps","languageId":"fr","category":"daily","level":"A2","sourceText":"Prends ton temps.","translations":{"tr":["acele etme.","yavaş ol."]},"details":{"register":"informal","context":"Birine rahat olmasını söylerken."},"examples":[{"text":"Prends ton temps, on n'est pas pressés.","tr":"Acele etme, aceleci değiliz."}]},
  {"id":"fr-daily-ca-me-fait-plaisir","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça me fait plaisir.","translations":{"tr":["sevindim.","beni mutlu ediyor."]},"details":{"register":"neutral","context":"Sevincini veya memnuniyetini belirtirken."},"examples":[{"text":"Tu es venu ! Ça me fait plaisir.","tr":"Geldin! Çok sevindim."}]},
  {"id":"fr-daily-je-suis-content-e-pour-toi","languageId":"fr","category":"daily","level":"A2","sourceText":"Je suis content(e) pour toi.","translations":{"tr":["senin adına sevindim."]},"details":{"register":"neutral","context":"Birinin başarısına veya iyi haberine sevinirken."},"examples":[{"text":"Tu as le poste ? Je suis contente pour toi !","tr":"İşi aldın mı? Senin adına sevindim!"}]},
  {"id":"fr-daily-ca-ne-fait-rien","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça ne fait rien.","translations":{"tr":["önemli değil.","zararı yok."]},"details":{"register":"neutral","context":"Özre veya küçük bir soruna cevap."},"examples":[{"text":"Il n'y a plus de sucre. — Ça ne fait rien.","tr":"Şeker kalmamış. — Zararı yok."}]},
  {"id":"fr-daily-cest-sympa","languageId":"fr","category":"daily","level":"A2","sourceText":"C'est sympa !","translations":{"tr":["çok naziksin!","ne hoş!"]},"details":{"register":"informal","context":"Birinin jestine teşekkür ederken veya bir şeyi beğenirken."},"examples":[{"text":"Tu m'as gardé une part ? C'est sympa !","tr":"Bana bir dilim mi ayırdın? Çok naziksin!"}]},
  {"id":"fr-daily-cest-gentil","languageId":"fr","category":"daily","level":"A2","sourceText":"C'est gentil.","translations":{"tr":["çok naziksin.","ne incelik."]},"details":{"register":"neutral","context":"Bir iyiliğe veya iltifata teşekkür ederken."},"examples":[{"text":"Je t'ai apporté des fleurs. — Oh, c'est gentil !","tr":"Sana çiçek getirdim. — Ah, çok naziksin!"}]},
  {"id":"fr-daily-jen-suis-sur-e","languageId":"fr","category":"daily","level":"A2","sourceText":"J'en suis sûr(e).","translations":{"tr":["eminim."]},"details":{"register":"neutral","context":"Kesinlik belirtirken."},"examples":[{"text":"Il va réussir, j'en suis sûr.","tr":"Başaracak, eminim."}]},
  {"id":"fr-daily-jespere-que-oui","languageId":"fr","category":"daily","level":"A2","sourceText":"J'espère que oui.","translations":{"tr":["umarım öyledir."]},"details":{"register":"neutral","context":"Olumlu bir beklenti; zıttı 'J'espère que non'."},"examples":[{"text":"Il fera beau demain ? — J'espère que oui.","tr":"Yarın hava güzel olacak mı? — Umarım."}]},
  {"id":"fr-daily-je-crois-que-oui","languageId":"fr","category":"daily","level":"A2","sourceText":"Je crois que oui.","translations":{"tr":["sanırım evet.","galiba."]},"details":{"register":"neutral","context":"Tam emin olmadan onaylarken; zıttı 'Je crois que non'."},"examples":[{"text":"Le magasin est ouvert ? — Je crois que oui.","tr":"Mağaza açık mı? — Sanırım evet."}]},
  {"id":"fr-daily-moi-non-plus","languageId":"fr","category":"daily","level":"A2","sourceText":"Moi non plus.","translations":{"tr":["ben de (değil)."]},"details":{"register":"neutral","context":"Olumsuz bir cümleye katılırken."},"examples":[{"text":"Je n'aime pas le froid. — Moi non plus.","tr":"Soğuğu sevmiyorum. — Ben de."}]},
  {"id":"fr-daily-exactement","languageId":"fr","category":"daily","level":"A2","sourceText":"Exactement !","translations":{"tr":["aynen!","kesinlikle!"]},"details":{"register":"neutral","context":"Tam katıldığını belirtirken."},"examples":[{"text":"Il faut partir tôt. — Exactement !","tr":"Erken çıkmak lazım. — Aynen!"}]},
  {"id":"fr-daily-je-ne-suis-pas-daccord","languageId":"fr","category":"daily","level":"A2","sourceText":"Je ne suis pas d'accord.","translations":{"tr":["katılmıyorum."]},"details":{"register":"neutral","context":"Fikir ayrılığını belirtirken."},"examples":[{"text":"Je ne suis pas d'accord avec toi.","tr":"Sana katılmıyorum."}]},
  {"id":"fr-daily-cest-ca","languageId":"fr","category":"daily","level":"A2","sourceText":"C'est ça.","translations":{"tr":["evet, o.","doğru."]},"details":{"register":"neutral","context":"Doğrularken; alaycı tonla 'tabii, tabii' anlamı da."},"examples":[{"text":"Vous êtes Mme Martin ? — Oui, c'est ça.","tr":"Siz Bayan Martin misiniz? — Evet, doğru."}]},
  {"id":"fr-daily-je-vois","languageId":"fr","category":"daily","level":"A2","sourceText":"Je vois.","translations":{"tr":["anlıyorum.","anladım."]},"details":{"register":"neutral","context":"Bir açıklamayı dinlerken onaylamak için."},"examples":[{"text":"Il est malade, donc il ne vient pas. — Je vois.","tr":"Hasta, o yüzden gelmiyor. — Anlıyorum."}]},
  {"id":"fr-daily-tu-as-vu","languageId":"fr","category":"daily","level":"A2","sourceText":"Tu as vu ?","translations":{"tr":["gördün mü?"]},"details":{"register":"informal","context":"Bir şeye dikkat çekerken."},"examples":[{"text":"Tu as vu ? Il neige !","tr":"Gördün mü? Kar yağıyor!"}]},
  {"id":"fr-daily-ca-te-va","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça te va ?","translations":{"tr":["sana uyar mı?","olur mu?"]},"details":{"register":"informal","context":"Bir planı onaylatırken."},"examples":[{"text":"Demain à dix heures, ça te va ?","tr":"Yarın saat onda, sana uyar mı?"}]},
  {"id":"fr-daily-ca-me-va","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça me va.","translations":{"tr":["bana uyar."]},"details":{"register":"neutral","context":"Bir öneriyi kabul ederken."},"examples":[{"text":"Lundi ? Ça me va.","tr":"Pazartesi mi? Bana uyar."}]},
  {"id":"fr-daily-quest-ce-qui-se-passe","languageId":"fr","category":"daily","level":"A2","sourceText":"Qu'est-ce qui se passe ?","translations":{"tr":["ne oluyor?"]},"details":{"register":"neutral","context":"Bir duruma şaşırınca veya endişelenince."},"examples":[{"text":"Qu'est-ce qui se passe ? Pourquoi tu cries ?","tr":"Ne oluyor? Neden bağırıyorsun?"}]},
  {"id":"fr-daily-quest-ce-quil-y-a","languageId":"fr","category":"daily","level":"A2","sourceText":"Qu'est-ce qu'il y a ?","translations":{"tr":["ne var?","ne oldu?"]},"details":{"register":"neutral","context":"Birinin üzgün veya tedirgin olduğunu görünce."},"examples":[{"text":"Tu as l'air triste. Qu'est-ce qu'il y a ?","tr":"Üzgün görünüyorsun. Ne oldu?"}]},
  {"id":"fr-daily-quest-ce-que-tu-en-penses","languageId":"fr","category":"daily","level":"A2","sourceText":"Qu'est-ce que tu en penses ?","translations":{"tr":["sen ne düşünüyorsun?"]},"details":{"register":"neutral","context":"Birinin fikrini sorarken."},"examples":[{"text":"J'ai acheté ce sac. Qu'est-ce que tu en penses ?","tr":"Bu çantayı aldım. Ne düşünüyorsun?"}]},
  {"id":"fr-daily-ca-marche-pas","languageId":"fr","category":"daily","level":"A2","sourceText":"Ça marche pas.","translations":{"tr":["çalışmıyor.","olmuyor."]},"details":{"register":"informal","context":"Bir cihaz veya plan çalışmayınca; yazıda 'Ça ne marche pas'."},"examples":[{"text":"Le wifi, ça marche pas !","tr":"Wifi çalışmıyor!"}]},
  {"id":"fr-daily-cest-pas-possible","languageId":"fr","category":"daily","level":"A2","sourceText":"C'est pas possible !","translations":{"tr":["olamaz!","inanılır gibi değil!"]},"details":{"register":"informal","context":"Şaşkınlık veya sinir anında."},"examples":[{"text":"Encore une panne ? C'est pas possible !","tr":"Yine mi arıza? Olamaz!"}]},
  {"id":"fr-daily-je-te-dois-combien","languageId":"fr","category":"daily","level":"A2","sourceText":"Je te dois combien ?","translations":{"tr":["sana ne kadar borcum var?"]},"details":{"register":"informal","context":"Bir arkadaş senin için ödeme yapınca."},"examples":[{"text":"Merci pour le billet. Je te dois combien ?","tr":"Bilet için sağ ol. Sana borcum ne kadar?"}]},
  {"id":"fr-daily-cest-pour-moi","languageId":"fr","category":"daily","level":"A2","sourceText":"C'est pour moi.","translations":{"tr":["benden.","ben ödüyorum."]},"details":{"register":"neutral","context":"Hesabı ödemeyi teklif ederken."},"examples":[{"text":"Laisse, c'est pour moi.","tr":"Bırak, benden."}]},
  {"id":"fr-daily-on-partage","languageId":"fr","category":"daily","level":"A2","sourceText":"On partage ?","translations":{"tr":["bölüşelim mi?","yarı yarıya mı?"]},"details":{"register":"informal","context":"Hesabı veya yemeği paylaşmayı önerirken."},"examples":[{"text":"L'addition, on partage ?","tr":"Hesabı bölüşelim mi?"}]},
  {"id":"fr-daily-je-ny-crois-pas","languageId":"fr","category":"daily","level":"A2","sourceText":"Je n'y crois pas !","translations":{"tr":["inanamıyorum!"]},"details":{"register":"neutral","context":"Şaşırtıcı bir habere tepki."},"examples":[{"text":"On a gagné ! Je n'y crois pas !","tr":"Kazandık! İnanamıyorum!"}]}
]
