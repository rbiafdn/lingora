  {"id":"pt-slang-bue","languageId":"pt","category":"slang","level":"B2","sourceText":"bué","translations":{"tr":["çok"]},"details":{"usage":"Portekiz'e özgü: 'bué de gente' çok kalabalık.","register":"slang"},"examples":[{"text":"Estava bué de calor.","tr":"Çok sıcaktı."}]},
  {"id":"pt-slang-gajo","languageId":"pt","category":"slang","level":"B2","sourceText":"gajo","translations":{"tr":["adam","herif"]},"details":{"usage":"Portekiz'e özgü; kadın için 'gaja'.","register":"informal"},"examples":[{"text":"Aquele gajo é estranho.","tr":"O adam tuhaf."}]},
  {"id":"pt-slang-giro","languageId":"pt","category":"slang","level":"B2","sourceText":"giro","translations":{"tr":["sevimli","tatlı"]},"details":{"usage":"Portekiz'e özgü; Brezilya'da 'fofo' denir.","register":"informal"},"examples":[{"text":"Que cão tão giro!","tr":"Ne tatlı köpek!"}]}
