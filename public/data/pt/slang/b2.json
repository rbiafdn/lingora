  {"id":"pt-slang-sacar","languageId":"pt","category":"slang","level":"B2","sourceText":"sacar","translations":{"tr":["anlamak","çakmak"]},"details":{"usage":"Brezilya'da 'anlamak' anlamında; 'Sacou?' (anladın mı?). Portekiz'de 'para çekmek' anlamı öne çıkar.","register":"informal"},"examples":[{"text":"Sacou o que eu quis dizer?","tr":"Ne demek istediğimi çaktın mı?"}]},
  {"id":"pt-slang-ficar","languageId":"pt","category":"slang","level":"B2","sourceText":"ficar","translations":{"tr":["takılmak (romantik)","öpüşmek"]},"details":{"usage":"'Ficar com alguém' ciddi ilişki olmadan biriyle öpüşmek, takılmak demektir.","register":"informal"},"examples":[{"text":"Eles ficaram na festa ontem.","tr":"Dün partide öpüştüler."}]},
