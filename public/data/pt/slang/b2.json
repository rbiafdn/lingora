  {"id":"pt-slang-mo","languageId":"pt","category":"slang","level":"B2","sourceText":"mó","translations":{"tr":["çok","büyük"]},"details":{"usage":"'Maior'dan kısaltma; özellikle Rio'da: 'mó legal', 'mó calor'.","register":"slang"},"examples":[{"text":"Tá mó calor hoje.","tr":"Bugün çok sıcak."}]},
  {"id":"pt-slang-irado","languageId":"pt","category":"slang","level":"B2","sourceText":"irado","translations":{"tr":["müthiş","çok iyi"]},"details":{"usage":"Asıl anlamı 'öfkeli', ama argoda 'harika'.","register":"slang"},"examples":[{"text":"O filme é irado!","tr":"Film müthiş!"}]},
  {"id":"pt-slang-massa","languageId":"pt","category":"slang","level":"B2","sourceText":"massa","translations":{"tr":["harika","süper"]},"details":{"usage":"Kuzeydoğu Brezilya'da (Nordeste) çok yaygın.","register":"slang"},"examples":[{"text":"Massa demais essa festa!","tr":"Bu parti çok süper!"}]},
  {"id":"pt-slang-da-hora","languageId":"pt","category":"slang","level":"B2","sourceText":"da hora","translations":{"tr":["harika","süper"]},"details":{"usage":"São Paulo'ya özgü.","register":"slang"},"examples":[{"text":"Esse lugar é da hora!","tr":"Burası harika!"}]},
  {"id":"pt-slang-show-de-bola","languageId":"pt","category":"slang","level":"B2","sourceText":"show de bola","translations":{"tr":["mükemmel","harika"]},"details":{"usage":"Kısaca 'show' da denir.","register":"informal"},"examples":[{"text":"Sua apresentação foi show de bola.","tr":"Sunumun mükemmeldi."}]},
  {"id":"pt-slang-firmeza","languageId":"pt","category":"slang","level":"B2","sourceText":"firmeza","translations":{"tr":["tamam","her şey yolunda"]},"details":{"usage":"Selamlaşmada ve onayda; özellikle São Paulo'da.","register":"slang"},"examples":[{"text":"Firmeza, mano? — Firmeza!","tr":"İyi misin kanka? — İyiyim!"}]},
