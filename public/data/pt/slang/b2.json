  {"id":"pt-slang-na-real","languageId":"pt","category":"slang","level":"B2","sourceText":"na real","translations":{"tr":["aslında","gerçekte"]},"details":{"register":"informal"},"examples":[{"text":"Na real, eu não queria ir.","tr":"Aslında gitmek istemiyordum."}]},
