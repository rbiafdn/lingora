[
  {"id":"pt-slang-ta","languageId":"pt","category":"slang","level":"B1","sourceText":"tá","translations":{"tr":["-iyor","tamam"]},"tags":["reduced-form"],"details":{"usage":"Konuşmada neredeyse her zaman böyle söylenir; tek başına 'tamam' anlamı da var.","register":"informal","expansion":"está"},"examples":[{"text":"Tá bom, eu vou.","tr":"Tamam, giderim."}]},
  {"id":"pt-slang-to","languageId":"pt","category":"slang","level":"B1","sourceText":"tô","translations":{"tr":["-iyorum","-yım"]},"tags":["reduced-form"],"details":{"usage":"Brezilya'da konuşma dilinde standart; yazıda mesajlarda görülür.","register":"informal","expansion":"estou"},"examples":[{"text":"Tô cansado.","tr":"Yorgunum."}]},
  {"id":"pt-slang-tava","languageId":"pt","category":"slang","level":"B1","sourceText":"tava","translations":{"tr":["-iyordu","idi"]},"tags":["reduced-form"],"details":{"register":"informal","expansion":"estava"},"examples":[{"text":"Eu tava dormindo.","tr":"Uyuyordum."}]},
  {"id":"pt-slang-tamo","languageId":"pt","category":"slang","level":"B1","sourceText":"tamo","translations":{"tr":["-iyoruz","-yız"]},"tags":["reduced-form"],"details":{"usage":"'Tamo junto' (hep beraberiz) kalıbında çok yaygın.","register":"informal","expansion":"estamos"},"examples":[{"text":"Tamo chegando!","tr":"Geliyoruz!"}]},
  {"id":"pt-slang-pra","languageId":"pt","category":"slang","level":"B1","sourceText":"pra","translations":{"tr":["için","-e/-a"]},"tags":["reduced-form"],"details":{"usage":"Brezilya'da konuşmada 'para' yerine neredeyse hep 'pra' denir.","register":"informal","expansion":"para"},"examples":[{"text":"Vou pra casa.","tr":"Eve gidiyorum."}]},
  {"id":"pt-slang-pro","languageId":"pt","category":"slang","level":"B1","sourceText":"pro","translations":{"tr":["-e (eril)"]},"tags":["reduced-form"],"details":{"usage":"Dişili 'pra' (para a); çoğullar 'pros', 'pras'.","register":"informal","expansion":"para o"},"examples":[{"text":"Vamos pro shopping?","tr":"AVM'ye gidelim mi?"}]},
  {"id":"pt-slang-ce","languageId":"pt","category":"slang","level":"B1","sourceText":"cê","translations":{"tr":["sen"]},"tags":["reduced-form"],"details":{"usage":"Özellikle São Paulo ve Minas Gerais'te yaygın.","register":"informal","expansion":"você"},"examples":[{"text":"Cê vai na festa?","tr":"Partiye gidiyor musun?"}]},
  {"id":"pt-slang-ne","languageId":"pt","category":"slang","level":"B1","sourceText":"né","translations":{"tr":["değil mi","yani"]},"tags":["reduced-form"],"details":{"usage":"Cümle sonunda onay almak için çok sık kullanılır.","register":"informal","expansion":"não é"},"examples":[{"text":"Tá calor hoje, né?","tr":"Bugün sıcak, değil mi?"}]},
  {"id":"pt-slang-perai","languageId":"pt","category":"slang","level":"B1","sourceText":"peraí","translations":{"tr":["bir dakika","dur bakalım"]},"tags":["reduced-form"],"details":{"usage":"'Pera' (espera) da çok yaygın.","register":"informal","expansion":"espera aí"},"examples":[{"text":"Peraí, já volto.","tr":"Bir dakika, hemen dönüyorum."}]},
  {"id":"pt-slang-bora","languageId":"pt","category":"slang","level":"B1","sourceText":"bora","translations":{"tr":["hadi","haydi gidelim"]},"tags":["reduced-form"],"details":{"usage":"Brezilya'da çok yaygın; 'vambora' da denir.","register":"informal","expansion":"vamos embora"},"examples":[{"text":"Bora tomar um açaí?","tr":"Hadi açaí yemeye gidelim mi?"}]},
  {"id":"pt-slang-cade","languageId":"pt","category":"slang","level":"B1","sourceText":"cadê","translations":{"tr":["nerede"]},"tags":["reduced-form"],"details":{"usage":"Brezilya'da 'onde está' yerine çok kullanılır.","register":"informal","expansion":"que é de"},"examples":[{"text":"Cadê minha chave?","tr":"Anahtarım nerede?"}]},
  {"id":"pt-slang-brigado","languageId":"pt","category":"slang","level":"B1","sourceText":"brigado","translations":{"tr":["sağ ol"]},"tags":["reduced-form"],"details":{"register":"informal","expansion":"obrigado"},"examples":[{"text":"Brigado, cara!","tr":"Sağ ol, dostum!"}]},
  {"id":"pt-slang-legal","languageId":"pt","category":"slang","level":"B1","sourceText":"legal","translations":{"tr":["güzel","hoş","harika"]},"details":{"usage":"Brezilya'da en yaygın beğeni sözü; Portekiz'de 'fixe' denir.","register":"informal"},"examples":[{"text":"Que legal! Adorei.","tr":"Ne güzel! Bayıldım."}]},
  {"id":"pt-slang-cara","languageId":"pt","category":"slang","level":"B1","sourceText":"cara","translations":{"tr":["adam","dostum","kanka"]},"details":{"usage":"Hem 'adam, tip' hem de hitap olarak kullanılır; kadınlara da hitapta denebilir.","register":"informal"},"examples":[{"text":"Cara, você não vai acreditar!","tr":"Dostum, inanmayacaksın!"}]},
  {"id":"pt-slang-mano","languageId":"pt","category":"slang","level":"B1","sourceText":"mano","translations":{"tr":["kanka","birader"]},"details":{"usage":"Özellikle São Paulo'da; kadın için 'mana' ya da 'mina'.","register":"slang"},"examples":[{"text":"E aí, mano, beleza?","tr":"Naber kanka, iyi misin?"}]},
  {"id":"pt-slang-grana","languageId":"pt","category":"slang","level":"B1","sourceText":"grana","translations":{"tr":["para","mangır"]},"details":{"register":"informal"},"examples":[{"text":"Tô sem grana este mês.","tr":"Bu ay hiç param yok."}]},
  {"id":"pt-slang-role","languageId":"pt","category":"slang","level":"B1","sourceText":"rolê","translations":{"tr":["gezinti","takılma","etkinlik"]},"details":{"usage":"'Dar um rolê' dolaşmaya çıkmak; 'o rolê' gidilen etkinlik.","register":"slang"},"examples":[{"text":"Qual é o rolê de hoje?","tr":"Bugün nereye takılıyoruz?"}]},
  {"id":"pt-slang-zoar","languageId":"pt","category":"slang","level":"B1","sourceText":"zoar","translations":{"tr":["dalga geçmek","şakalaşmak"]},"details":{"register":"informal"},"examples":[{"text":"Para de me zoar!","tr":"Benimle dalga geçmeyi bırak!"}]},
  {"id":"pt-slang-top","languageId":"pt","category":"slang","level":"B1","sourceText":"top","translations":{"tr":["süper","harika"]},"details":{"usage":"İngilizceden; 'topzera' daha da abartılı hâli.","register":"informal"},"examples":[{"text":"O show foi top!","tr":"Konser süperdi!"}]},
  {"id":"pt-slang-maneiro","languageId":"pt","category":"slang","level":"B1","sourceText":"maneiro","translations":{"tr":["havalı","güzel"]},"details":{"usage":"Rio de Janeiro'da çok yaygın.","register":"informal"},"examples":[{"text":"Teu tênis é maneiro!","tr":"Spor ayakkabın çok havalı!"}]},
  {"id":"pt-slang-bacana","languageId":"pt","category":"slang","level":"B1","sourceText":"bacana","translations":{"tr":["güzel","hoş","iyi"]},"details":{"usage":"Her yaştan insan kullanır; kibar bir argo.","register":"informal"},"examples":[{"text":"Ele é um cara bacana.","tr":"İyi biri o."}]},
  {"id":"pt-slang-de-boa","languageId":"pt","category":"slang","level":"B1","sourceText":"de boa","translations":{"tr":["rahat","sakin","sorun yok"]},"details":{"usage":"'Tô de boa' keyfim yerinde ya da plansız takılıyorum anlamında.","register":"informal"},"examples":[{"text":"Hoje tô de boa em casa.","tr":"Bugün evde rahat rahat takılıyorum."}]},
  {"id":"pt-slang-beleza","languageId":"pt","category":"slang","level":"B1","sourceText":"beleza","translations":{"tr":["tamam","olur","iyi misin"]},"details":{"usage":"Selamlaşmada 'Beleza?' (iyi misin?) ve onayda 'Beleza!' (tamam!).","register":"informal"},"examples":[{"text":"Te pego às oito, beleza?","tr":"Seni sekizde alırım, tamam mı?"}]},
  {"id":"pt-slang-valeu","languageId":"pt","category":"slang","level":"B1","sourceText":"valeu","translations":{"tr":["sağ ol","eyvallah"]},"details":{"usage":"Brezilya'da teşekkür ve veda için çok yaygın.","register":"informal"},"examples":[{"text":"Valeu pela carona!","tr":"Arabayla bıraktığın için sağ ol!"}]},
  {"id":"pt-slang-falou","languageId":"pt","category":"slang","level":"B1","sourceText":"falou","translations":{"tr":["görüşürüz","tamam"]},"details":{"usage":"Veda ya da anlaşma sözü.","register":"informal"},"examples":[{"text":"Falou, até amanhã!","tr":"Tamamdır, yarın görüşürüz!"}]},
  {"id":"pt-slang-crush","languageId":"pt","category":"slang","level":"B1","sourceText":"crush","translations":{"tr":["platonik aşk","hoşlandığı kişi"]},"details":{"usage":"İngilizceden; gençler arasında çok yaygın.","register":"informal"},"examples":[{"text":"Meu crush me respondeu!","tr":"Hoşlandığım kişi bana cevap verdi!"}]},
  {"id":"pt-slang-gato","languageId":"pt","category":"slang","level":"B1","sourceText":"gato","translations":{"tr":["yakışıklı"]},"details":{"usage":"Dişilisi 'gata' (güzel kız); 'gatinho/gatinha' daha sevimli.","register":"informal"},"examples":[{"text":"O irmão dela é muito gato.","tr":"Onun abisi çok yakışıklı."}]},
  {"id":"pt-slang-galera","languageId":"pt","category":"slang","level":"B1","sourceText":"galera","translations":{"tr":["millet","arkadaşlar","ekip"]},"details":{"register":"informal"},"examples":[{"text":"Fala, galera!","tr":"Selam millet!"}]},
  {"id":"pt-slang-balada","languageId":"pt","category":"slang","level":"B1","sourceText":"balada","translations":{"tr":["gece kulübü","parti"]},"details":{"usage":"Brezilya'ya özgü, özellikle São Paulo.","register":"informal"},"examples":[{"text":"Vamos pra balada sábado?","tr":"Cumartesi kulübe gidelim mi?"}]},
  {"id":"pt-slang-troco","languageId":"pt","category":"slang","level":"B1","sourceText":"troço","translations":{"tr":["şey","zımbırtı"]},"details":{"usage":"Adı bilinmeyen nesneler için; 'treco' da denir.","register":"informal"},"examples":[{"text":"Pega aquele troço ali.","tr":"Şuradaki şeyi alsana."}]},
  {"id":"pt-slang-papo","languageId":"pt","category":"slang","level":"B1","sourceText":"papo","translations":{"tr":["sohbet","muhabbet"]},"details":{"usage":"'Bater papo' sohbet etmek; 'papo-furado' boş laf.","register":"informal"},"examples":[{"text":"Vamos bater um papo?","tr":"Biraz sohbet edelim mi?"}]},
  {"id":"pt-slang-pra-caramba","languageId":"pt","category":"slang","level":"B1","sourceText":"pra caramba","translations":{"tr":["çok","acayip"]},"details":{"usage":"Kibar bir pekiştirme; kaba eşdeğeri 'pra caralho'.","register":"informal"},"examples":[{"text":"Tá frio pra caramba!","tr":"Acayip soğuk!"}]},
  {"id":"pt-slang-boteco","languageId":"pt","category":"slang","level":"B1","sourceText":"boteco","translations":{"tr":["mahalle barı","meyhane"]},"details":{"usage":"Brezilya kültürünün simgesi; 'buteco' da yazılır.","register":"informal"},"examples":[{"text":"Vamos ao boteco da esquina?","tr":"Köşedeki bara gidelim mi?"}]},
  {"id":"pt-slang-po","languageId":"pt","category":"slang","level":"B1","sourceText":"pô","translations":{"tr":["ya","hadi ama"]},"details":{"usage":"'Porra'nın yumuşatılmış hâli; hayal kırıklığı ya da vurgu.","register":"informal"},"examples":[{"text":"Pô, você esqueceu de novo?","tr":"Ya, yine mi unuttun?"}]},
  {"id":"pt-slang-caraca","languageId":"pt","category":"slang","level":"B1","sourceText":"caraca","translations":{"tr":["vay be","oha"]},"details":{"usage":"Şaşkınlık; kibar bir ünlem.","register":"informal"},"examples":[{"text":"Caraca, que golaço!","tr":"Vay be, ne gol!"}]},
  {"id":"pt-slang-eita","languageId":"pt","category":"slang","level":"B1","sourceText":"eita","translations":{"tr":["vay","eyvah"]},"details":{"usage":"Özellikle Kuzeydoğu'da; 'eita, porra' daha kaba.","register":"informal"},"examples":[{"text":"Eita, que susto!","tr":"Vay, ne korkuttun!"}]},
  {"id":"pt-slang-mandar-bem","languageId":"pt","category":"slang","level":"B1","sourceText":"mandar bem","translations":{"tr":["iyi iş çıkarmak"]},"details":{"usage":"Zıttı 'mandar mal'.","register":"informal"},"examples":[{"text":"Você mandou bem na prova!","tr":"Sınavda iyi iş çıkardın!"}]},
  {"id":"pt-slang-zap","languageId":"pt","category":"slang","level":"B1","sourceText":"zap","translations":{"tr":["WhatsApp"]},"details":{"usage":"'Zapzap' da denir; Brezilya'ya özgü.","register":"informal"},"examples":[{"text":"Me chama no zap.","tr":"Bana WhatsApp'tan yaz."}]},
  {"id":"pt-slang-gente-boa","languageId":"pt","category":"slang","level":"B1","sourceText":"gente boa","translations":{"tr":["iyi insan","tatlı biri"]},"details":{"usage":"'Sangue bom' da aynı anlamda.","register":"informal"},"examples":[{"text":"O vizinho novo é gente boa.","tr":"Yeni komşu iyi biri."}]},
  {"id":"pt-slang-craque","languageId":"pt","category":"slang","level":"B1","sourceText":"craque","translations":{"tr":["yıldız oyuncu","usta"]},"details":{"register":"informal"},"examples":[{"text":"O menino é craque de bola.","tr":"Çocuk futbolda bir yıldız."}]},
  {"id":"pt-slang-tipo","languageId":"pt","category":"slang","level":"B1","sourceText":"tipo","translations":{"tr":["mesela","şey","gibi"]},"details":{"usage":"Gençlerin dolgu kelimesi; İngilizcedeki 'like' gibi.","register":"informal"},"examples":[{"text":"Tipo, eu não sabia o que fazer.","tr":"Yani şey, ne yapacağımı bilmiyordum."}]},
  {"id":"pt-slang-partiu","languageId":"pt","category":"slang","level":"B1","sourceText":"partiu","translations":{"tr":["hadi gidiyoruz","yola çıktık"]},"details":{"usage":"Sosyal medyada '#partiu praia' gibi kullanılır.","register":"informal"},"examples":[{"text":"Terminou a aula? Partiu praia!","tr":"Ders bitti mi? Haydi plaja!"}]},
  {"id":"pt-slang-sampa","languageId":"pt","category":"slang","level":"B1","sourceText":"Sampa","translations":{"tr":["São Paulo"]},"details":{"usage":"Şehrin sevimli takma adı.","register":"informal"},"examples":[{"text":"Sampa nunca dorme.","tr":"São Paulo hiç uyumaz."}]},
  {"id":"pt-slang-gringo","languageId":"pt","category":"slang","level":"B1","sourceText":"gringo","translations":{"tr":["yabancı"]},"details":{"usage":"Brezilya'da her yabancı için kullanılır, genelde hakaret değildir.","register":"informal"},"examples":[{"text":"Tem muito gringo no Carnaval.","tr":"Karnavalda çok yabancı var."}]},
  {"id":"pt-slang-fixe","languageId":"pt","category":"slang","level":"B1","sourceText":"fixe","translations":{"tr":["güzel","havalı"]},"details":{"usage":"Portekiz'e özgü; Brezilya'daki 'legal' karşılığı.","register":"informal"},"examples":[{"text":"O teu casaco é muito fixe.","tr":"Montun çok havalı."}]}
