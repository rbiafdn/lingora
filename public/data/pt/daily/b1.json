[
  {"id":"pt-daily-falou","languageId":"pt","category":"daily","level":"B1","sourceText":"Falou!","translations":{"tr":["görüşürüz","tamamdır"]},"details":{"register":"informal","context":"Arkadaşlar arasında veda ya da onay; özellikle gençler."},"examples":[{"text":"Te vejo amanhã, então. — Falou!","tr":"Yarın görüşürüz o zaman. — Tamamdır!"}]},
  {"id":"pt-daily-fechado","languageId":"pt","category":"daily","level":"B1","sourceText":"Fechado!","translations":{"tr":["anlaştık!","tamamdır!"]},"details":{"register":"informal","context":"Bir anlaşmayı ya da planı onaylarken."},"examples":[{"text":"Te pago cinquenta. — Fechado!","tr":"Sana elli veririm. — Anlaştık!"}]},
  {"id":"pt-daily-vou-nessa","languageId":"pt","category":"daily","level":"B1","sourceText":"Vou nessa.","translations":{"tr":["ben kaçar","ben gidiyorum"]},"details":{"register":"informal","context":"Arkadaşlar arasında ayrılırken."},"examples":[{"text":"Bom, pessoal, vou nessa. Até amanhã!","tr":"Eh millet, ben kaçar. Yarın görüşürüz!"}]},
  {"id":"pt-daily-ja-vou-indo","languageId":"pt","category":"daily","level":"B1","sourceText":"Já vou indo.","translations":{"tr":["ben artık gideyim","kalkayım ben"]},"details":{"register":"neutral","context":"Bir ziyaretten ya da toplantıdan nazikçe ayrılırken."},"examples":[{"text":"Está tarde, já vou indo.","tr":"Geç oldu, ben artık kalkayım."}]},
  {"id":"pt-daily-vai-com-deus","languageId":"pt","category":"daily","level":"B1","sourceText":"Vai com Deus.","translations":{"tr":["Allah'a emanet ol","yolun açık olsun"]},"details":{"register":"neutral","context":"Giden birine, özellikle yaşlılar ve ailede."},"examples":[{"text":"Tchau, vó! — Vai com Deus, meu filho.","tr":"Görüşürüz babaanne! — Allah'a emanet ol oğlum."}]},
  {"id":"pt-daily-fica-com-deus","languageId":"pt","category":"daily","level":"B1","sourceText":"Fica com Deus.","translations":{"tr":["Allah'a emanet ol"]},"details":{"register":"neutral","context":"Ayrılan kişi geride kalana söyler."},"examples":[{"text":"Tchau, tia, fica com Deus!","tr":"Hoşça kal teyze, Allah'a emanet ol!"}]},
  {"id":"pt-daily-manda-um-abraco-pra","languageId":"pt","category":"daily","level":"B1","sourceText":"Manda um abraço pra …","translations":{"tr":["…'e selam söyle"]},"details":{"register":"informal","context":"Vedalaşırken ortak bir tanıdığa selam gönderirken."},"examples":[{"text":"Manda um abraço pra sua mãe!","tr":"Annene selam söyle!"}]},
  {"id":"pt-daily-aparece-la-em-casa","languageId":"pt","category":"daily","level":"B1","sourceText":"Aparece lá em casa!","translations":{"tr":["bize de uğra!","bir gün gel!"]},"details":{"register":"informal","context":"Samimi davet; Brezilya'da bazen sadece nezaket."},"examples":[{"text":"Aparece lá em casa qualquer dia!","tr":"Bir gün bize de uğra!"}]},
  {"id":"pt-daily-a-gente-marca","languageId":"pt","category":"daily","level":"B1","sourceText":"A gente marca.","translations":{"tr":["ayarlarız","bir ara buluşuruz"]},"details":{"register":"informal","context":"Belirsiz bir buluşma sözü; çoğu zaman tarih verilmez."},"examples":[{"text":"Vamos sair qualquer dia! — Claro, a gente marca.","tr":"Bir gün çıkalım! — Tabii, ayarlarız."}]},
  {"id":"pt-daily-fica-pra-proxima","languageId":"pt","category":"daily","level":"B1","sourceText":"Fica pra próxima.","translations":{"tr":["bir dahakine artık","başka sefere"]},"details":{"register":"informal","context":"Bir daveti reddederken ya da plan iptal olunca."},"examples":[{"text":"Hoje não dá. Fica pra próxima!","tr":"Bugün olmuyor. Başka sefere artık!"}]},
  {"id":"pt-daily-vamos-marcar-um-cafe","languageId":"pt","category":"daily","level":"B1","sourceText":"Vamos marcar um café?","translations":{"tr":["bir kahve içelim mi?","bir kahveye ne dersin?"]},"details":{"register":"neutral","context":"Biriyle görüşme önerirken."},"examples":[{"text":"Faz tempo! Vamos marcar um café?","tr":"Ne zamandır görüşmüyoruz! Bir kahve içelim mi?"}]},
  {"id":"pt-daily-topa","languageId":"pt","category":"daily","level":"B1","sourceText":"Topa?","translations":{"tr":["var mısın?","ne dersin?"]},"details":{"register":"informal","context":"Bir plana katılmayı sorarken; topar = kabul etmek."},"examples":[{"text":"Vamos à praia amanhã, topa?","tr":"Yarın plaja gidelim, var mısın?"}]},
  {"id":"pt-daily-to-dentro","languageId":"pt","category":"daily","level":"B1","sourceText":"Tô dentro!","translations":{"tr":["ben varım!"]},"details":{"register":"informal","context":"Bir plana katıldığını söylerken."},"examples":[{"text":"Churrasco no sábado? Tô dentro!","tr":"Cumartesi mangal mı? Ben varım!"}]},
  {"id":"pt-daily-to-fora","languageId":"pt","category":"daily","level":"B1","sourceText":"Tô fora.","translations":{"tr":["ben yokum","beni sayma"]},"details":{"register":"informal","context":"Bir plana katılmayacağını söylerken."},"examples":[{"text":"Acordar às cinco? Tô fora.","tr":"Beşte kalkmak mı? Ben yokum."}]},
  {"id":"pt-daily-bora","languageId":"pt","category":"daily","level":"B1","sourceText":"Bora!","translations":{"tr":["hadi!","gidelim!"]},"details":{"register":"informal","context":"'Vamos embora'dan; gençler arasında çok yaygın."},"examples":[{"text":"Bora tomar um açaí?","tr":"Hadi bir açaí yiyelim mi?"}]},
  {"id":"pt-daily-partiu","languageId":"pt","category":"daily","level":"B1","sourceText":"Partiu!","translations":{"tr":["hadi gidelim!","yola çıktık!"]},"details":{"register":"informal","context":"Bir yere gitmeye karar verince; sosyal medyada da."},"examples":[{"text":"Todo mundo pronto? Partiu praia!","tr":"Herkes hazır mı? Hadi plaja!"}]},
  {"id":"pt-daily-pode-deixar","languageId":"pt","category":"daily","level":"B1","sourceText":"Pode deixar!","translations":{"tr":["merak etme, hallederim!","tamamdır!"]},"details":{"register":"informal","context":"Bir ricayı üstlenirken."},"examples":[{"text":"Não esquece de comprar pão! — Pode deixar!","tr":"Ekmek almayı unutma! — Merak etme!"}]},
  {"id":"pt-daily-deixa-comigo","languageId":"pt","category":"daily","level":"B1","sourceText":"Deixa comigo.","translations":{"tr":["bana bırak","ben hallederim"]},"details":{"register":"informal","context":"Bir işi üstlenirken."},"examples":[{"text":"Quem vai falar com o chefe? — Deixa comigo.","tr":"Patronla kim konuşacak? — Bana bırak."}]},
  {"id":"pt-daily-deixa-que-eu-pago","languageId":"pt","category":"daily","level":"B1","sourceText":"Deixa que eu pago.","translations":{"tr":["ben öderim","bu benden"]},"details":{"register":"informal","context":"Hesabı üstlenmek istediğinde."},"examples":[{"text":"Não, não, deixa que eu pago!","tr":"Yok yok, ben öderim!"}]},
  {"id":"pt-daily-vamos-rachar-a-conta","languageId":"pt","category":"daily","level":"B1","sourceText":"Vamos rachar a conta?","translations":{"tr":["hesabı bölüşelim mi?"]},"details":{"register":"informal","context":"Restoranda hesabı paylaşmayı önerirken."},"examples":[{"text":"Deu cem reais. Vamos rachar a conta?","tr":"Yüz real tuttu. Hesabı bölüşelim mi?"}]},
  {"id":"pt-daily-nao-precisava","languageId":"pt","category":"daily","level":"B1","sourceText":"Não precisava!","translations":{"tr":["hiç zahmet etmeseydin!","ne gerek vardı!"]},"details":{"register":"neutral","context":"Hediye ya da iyilik alınca nazik tepki."},"examples":[{"text":"Trouxe um presente pra você. — Ah, não precisava!","tr":"Sana bir hediye getirdim. — Aa, ne gerek vardı!"}]},
  {"id":"pt-daily-que-gentileza","languageId":"pt","category":"daily","level":"B1","sourceText":"Que gentileza!","translations":{"tr":["ne incelik!","çok naziksiniz!"]},"details":{"register":"neutral","context":"Birinin nazik davranışına tepki."},"examples":[{"text":"Vocês trouxeram flores? Que gentileza!","tr":"Çiçek mi getirdiniz? Ne incelik!"}]},
  {"id":"pt-daily-bom-proveito","languageId":"pt","category":"daily","level":"B1","sourceText":"Bom proveito!","translations":{"tr":["afiyet olsun","güle güle kullan"]},"details":{"register":"neutral","context":"Yemek yiyen ya da yeni bir şey alan birine."},"examples":[{"text":"Comprei um carro novo! — Bom proveito!","tr":"Yeni araba aldım! — Güle güle kullan!"}]},
  {"id":"pt-daily-sirva-se","languageId":"pt","category":"daily","level":"B1","sourceText":"Sirva-se!","translations":{"tr":["buyurun, alın!","kendinize servis yapın"]},"details":{"register":"neutral","context":"Misafire yemek ikram ederken."},"examples":[{"text":"A comida está na mesa, sirva-se!","tr":"Yemek masada, buyurun alın!"}]},
  {"id":"pt-daily-mais-um-pouquinho","languageId":"pt","category":"daily","level":"B1","sourceText":"Mais um pouquinho?","translations":{"tr":["biraz daha?","bir parça daha alır mısın?"]},"details":{"register":"informal","context":"Ev sahibi yemekte ikram ederken."},"examples":[{"text":"Mais um pouquinho de arroz? — Não, obrigado.","tr":"Biraz daha pilav? — Yok, teşekkürler."}]},
  {"id":"pt-daily-estou-satisfeito","languageId":"pt","category":"daily","level":"B1","sourceText":"Estou satisfeito.","translations":{"tr":["doydum","tokum"]},"details":{"register":"neutral","context":"Yemek ikramını kibarca reddederken; kadın 'satisfeita' der."},"examples":[{"text":"Obrigada, estou satisfeita.","tr":"Teşekkürler, doydum."}]},
  {"id":"pt-daily-ta-uma-delicia","languageId":"pt","category":"daily","level":"B1","sourceText":"Tá uma delícia!","translations":{"tr":["çok lezzetli olmuş!"]},"details":{"register":"informal","context":"Ev sahibinin yemeğini övmek için."},"examples":[{"text":"Quem fez essa moqueca? Tá uma delícia!","tr":"Bu moquecayı kim yaptı? Çok lezzetli olmuş!"}]},
  {"id":"pt-daily-foi-mal","languageId":"pt","category":"daily","level":"B1","sourceText":"Foi mal!","translations":{"tr":["kusura bakma!","pardon, benim hatam!"]},"details":{"register":"informal","context":"Küçük bir hata için arkadaşça özür."},"examples":[{"text":"Pisei no seu pé? Foi mal!","tr":"Ayağına mı bastım? Kusura bakma!"}]},
  {"id":"pt-daily-nao-foi-nada","languageId":"pt","category":"daily","level":"B1","sourceText":"Não foi nada.","translations":{"tr":["bir şey olmadı","önemli değil"]},"details":{"register":"neutral","context":"Özre ya da teşekküre cevap."},"examples":[{"text":"Desculpa! — Não foi nada.","tr":"Pardon! — Önemli değil."}]},
  {"id":"pt-daily-esquece","languageId":"pt","category":"daily","level":"B1","sourceText":"Esquece.","translations":{"tr":["boş ver","unut gitsin"]},"details":{"register":"informal","context":"Bir konuyu kapatmak isterken."},"examples":[{"text":"O que você ia dizer? — Nada, esquece.","tr":"Ne diyecektin? — Hiç, boş ver."}]},
  {"id":"pt-daily-deixa-pra-la","languageId":"pt","category":"daily","level":"B1","sourceText":"Deixa pra lá.","translations":{"tr":["boş ver","neyse, önemli değil"]},"details":{"register":"informal","context":"Bir şeyi önemsememeye karar verirken."},"examples":[{"text":"Ele não pediu desculpa? Deixa pra lá.","tr":"Özür dilemedi mi? Boş ver."}]},
  {"id":"pt-daily-fazer-o-que","languageId":"pt","category":"daily","level":"B1","sourceText":"Fazer o quê?","translations":{"tr":["ne yapalım?","elden ne gelir?"]},"details":{"register":"informal","context":"Değiştirilemeyen bir durumu kabullenirken."},"examples":[{"text":"Choveu no dia da festa. Fazer o quê?","tr":"Parti günü yağmur yağdı. Ne yapalım?"}]},
  {"id":"pt-daily-e-a-vida","languageId":"pt","category":"daily","level":"B1","sourceText":"É a vida.","translations":{"tr":["hayat bu","olur böyle şeyler"]},"details":{"register":"neutral","context":"Kötü bir şeyi kabullenirken."},"examples":[{"text":"Perdi o emprego, mas é a vida.","tr":"İşimi kaybettim ama hayat bu."}]},
  {"id":"pt-daily-paciencia","languageId":"pt","category":"daily","level":"B1","sourceText":"Paciência.","translations":{"tr":["ne yapalım","sabır"]},"details":{"register":"neutral","context":"Bir aksiliği kabullenirken."},"examples":[{"text":"O voo atrasou? Paciência.","tr":"Uçuş gecikti mi? Ne yapalım."}]},
  {"id":"pt-daily-vai-dar-tudo-certo","languageId":"pt","category":"daily","level":"B1","sourceText":"Vai dar tudo certo.","translations":{"tr":["her şey yoluna girecek"]},"details":{"register":"neutral","context":"Birini cesaretlendirirken."},"examples":[{"text":"Calma, vai dar tudo certo.","tr":"Sakin ol, her şey yoluna girecek."}]},
  {"id":"pt-daily-forca","languageId":"pt","category":"daily","level":"B1","sourceText":"Força!","translations":{"tr":["güçlü ol!","dayan!"]},"details":{"register":"neutral","context":"Zor durumdaki birine destek olurken."},"examples":[{"text":"Sei que está difícil. Força!","tr":"Zor olduğunu biliyorum. Güçlü ol!"}]},
  {"id":"pt-daily-meus-pesames","languageId":"pt","category":"daily","level":"B1","sourceText":"Meus pêsames.","translations":{"tr":["başınız sağ olsun"]},"details":{"register":"formal","context":"Biri yakınını kaybedince."},"examples":[{"text":"Soube do seu pai. Meus pêsames.","tr":"Babanızı duydum. Başınız sağ olsun."}]},
  {"id":"pt-daily-coitado","languageId":"pt","category":"daily","level":"B1","sourceText":"Coitado!","translations":{"tr":["zavallı!","vah vah!"]},"details":{"register":"informal","context":"Birine acıyınca; kadın için 'coitada'."},"examples":[{"text":"Ele quebrou a perna? Coitado!","tr":"Bacağını mı kırdı? Vah zavallı!"}]},
  {"id":"pt-daily-bem-feito","languageId":"pt","category":"daily","level":"B1","sourceText":"Bem feito!","translations":{"tr":["oh olsun!","müstahak!"]},"details":{"register":"informal","context":"Birinin hak ettiği bir şeyi yaşadığını düşündüğünde."},"examples":[{"text":"Ele colou na prova e foi pego. Bem feito!","tr":"Sınavda kopya çekip yakalandı. Oh olsun!"}]},
  {"id":"pt-daily-que-vergonha","languageId":"pt","category":"daily","level":"B1","sourceText":"Que vergonha!","translations":{"tr":["ne ayıp!","çok utandım!"]},"details":{"register":"neutral","context":"Utanç ya da ayıplama anında."},"examples":[{"text":"Esqueci o nome dele. Que vergonha!","tr":"Adını unuttum. Çok utandım!"}]},
  {"id":"pt-daily-que-absurdo","languageId":"pt","category":"daily","level":"B1","sourceText":"Que absurdo!","translations":{"tr":["bu ne saçmalık!","olacak iş değil!"]},"details":{"register":"neutral","context":"Bir şeye öfkelenince."},"examples":[{"text":"Cobraram vinte reais por um café? Que absurdo!","tr":"Bir kahveye yirmi real mi almışlar? Olacak iş değil!"}]},
  {"id":"pt-daily-que-saco","languageId":"pt","category":"daily","level":"B1","sourceText":"Que saco!","translations":{"tr":["ne sinir bozucu!","bıktım!"]},"details":{"register":"informal","context":"Sıkılınca ya da sinirlenince; kaba sayılmaz ama samimi."},"examples":[{"text":"Acabou a luz de novo. Que saco!","tr":"Elektrik yine gitti. Ne sinir bozucu!"}]},
  {"id":"pt-daily-que-nada","languageId":"pt","category":"daily","level":"B1","sourceText":"Que nada!","translations":{"tr":["ne münasebet!","yok canım!"]},"details":{"register":"informal","context":"Bir övgüyü ya da iddiayı reddederken."},"examples":[{"text":"Você fala muito bem! — Que nada!","tr":"Çok iyi konuşuyorsun! — Yok canım!"}]},
  {"id":"pt-daily-caramba","languageId":"pt","category":"daily","level":"B1","sourceText":"Caramba!","translations":{"tr":["vay be!","hay aksi!"]},"details":{"register":"informal","context":"Şaşkınlık ya da sinir; kaba değil."},"examples":[{"text":"Caramba, que trânsito!","tr":"Vay be, ne trafik!"}]},
  {"id":"pt-daily-eita","languageId":"pt","category":"daily","level":"B1","sourceText":"Eita!","translations":{"tr":["eyvah!","vay!"]},"details":{"register":"informal","context":"Ani şaşkınlık; özellikle Kuzeydoğu'da ama her yerde duyulur."},"examples":[{"text":"Eita, esqueci a carteira!","tr":"Eyvah, cüzdanı unuttum!"}]},
  {"id":"pt-daily-vixe","languageId":"pt","category":"daily","level":"B1","sourceText":"Vixe!","translations":{"tr":["eyvah!","vay anam!"]},"details":{"register":"informal","context":"Kötü bir sürprizde; 'Virgem Maria'dan, Kuzeydoğu ağzında çok yaygın."},"examples":[{"text":"Vixe, vai chover!","tr":"Eyvah, yağmur yağacak!"}]},
  {"id":"pt-daily-ue","languageId":"pt","category":"daily","level":"B1","sourceText":"Ué!","translations":{"tr":["aa!","hayırdır?","nasıl yani?"]},"details":{"register":"informal","context":"Şaşkınlık ve kafa karışıklığı bildirir."},"examples":[{"text":"Ué, cadê todo mundo?","tr":"Aa, herkes nerede?"}]},
  {"id":"pt-daily-hein","languageId":"pt","category":"daily","level":"B1","sourceText":"Hein?","translations":{"tr":["ha?","efendim?"]},"details":{"register":"informal","context":"Duymadığında ya da şaşırdığında; cümle sonunda vurgu için de."},"examples":[{"text":"Hein? Fala mais alto!","tr":"Ha? Daha yüksek sesle konuş!"}]},
  {"id":"pt-daily-credo","languageId":"pt","category":"daily","level":"B1","sourceText":"Credo!","translations":{"tr":["tövbe!","iğrenç!","aman!"]},"details":{"register":"informal","context":"Korku ya da tiksinti tepkisi."},"examples":[{"text":"Uma barata! Credo!","tr":"Hamamböceği! İğrenç!"}]},
  {"id":"pt-daily-deus-me-livre","languageId":"pt","category":"daily","level":"B1","sourceText":"Deus me livre!","translations":{"tr":["Allah korusun!","aman Allah'ım!"]},"details":{"register":"neutral","context":"İstenmeyen bir şeyden söz edilince."},"examples":[{"text":"Morar sozinho na floresta? Deus me livre!","tr":"Ormanda tek başına yaşamak mı? Allah korusun!"}]},
  {"id":"pt-daily-pelo-amor-de-deus","languageId":"pt","category":"daily","level":"B1","sourceText":"Pelo amor de Deus!","translations":{"tr":["Allah aşkına!"]},"details":{"register":"neutral","context":"Çaresiz rica ya da sinir anında."},"examples":[{"text":"Pelo amor de Deus, fala baixo!","tr":"Allah aşkına, yavaş konuş!"}]},
  {"id":"pt-daily-como-assim","languageId":"pt","category":"daily","level":"B1","sourceText":"Como assim?","translations":{"tr":["nasıl yani?","ne demek istiyorsun?"]},"details":{"register":"informal","context":"Şaşırınca ya da açıklama isterken."},"examples":[{"text":"Ele foi demitido. — Como assim?","tr":"Kovulmuş. — Nasıl yani?"}]},
  {"id":"pt-daily-fala-serio","languageId":"pt","category":"daily","level":"B1","sourceText":"Fala sério!","translations":{"tr":["ciddi ol!","hadi oradan!"]},"details":{"register":"informal","context":"İnanılmaz ya da saçma bulunan bir şeye."},"examples":[{"text":"Você comeu três pizzas? Fala sério!","tr":"Üç pizza mı yedin? Hadi oradan!"}]},
  {"id":"pt-daily-ta-brincando","languageId":"pt","category":"daily","level":"B1","sourceText":"Tá brincando!","translations":{"tr":["şaka yapıyorsun!","dalga geçiyorsun!"]},"details":{"register":"informal","context":"Şaşırtıcı bir habere tepki."},"examples":[{"text":"Ela vai morar no Japão. — Tá brincando!","tr":"Japonya'ya taşınıyor. — Şaka yapıyorsun!"}]},
  {"id":"pt-daily-mentira","languageId":"pt","category":"daily","level":"B1","sourceText":"Mentira!","translations":{"tr":["yok artık!","yalan!"]},"details":{"register":"informal","context":"Brezilya'da sık sık 'inanmıyorum' anlamında, suçlama değil."},"examples":[{"text":"Passei em primeiro lugar! — Mentira!","tr":"Birinci oldum! — Yok artık!"}]},
  {"id":"pt-daily-jura","languageId":"pt","category":"daily","level":"B1","sourceText":"Jura?","translations":{"tr":["yemin et?","cidden mi?"]},"details":{"register":"informal","context":"Şaşkınlıkla teyit isterken."},"examples":[{"text":"Ele pediu você em casamento? Jura?","tr":"Sana evlenme mi teklif etti? Cidden mi?"}]},
  {"id":"pt-daily-brincadeira","languageId":"pt","category":"daily","level":"B1","sourceText":"Brincadeira!","translations":{"tr":["şaka şaka!","şakaydı!"]},"details":{"register":"informal","context":"Az önce söylediğinin şaka olduğunu belirtirken."},"examples":[{"text":"Vou embora pra sempre! Brincadeira!","tr":"Sonsuza dek gidiyorum! Şaka şaka!"}]},
  {"id":"pt-daily-obvio","languageId":"pt","category":"daily","level":"B1","sourceText":"Óbvio!","translations":{"tr":["tabii ki!","belli değil mi!"]},"details":{"register":"informal","context":"Cevabın açık olduğunu vurgularken."},"examples":[{"text":"Você vem na minha festa? — Óbvio!","tr":"Partime geliyor musun? — Tabii ki!"}]},
  {"id":"pt-daily-pode-crer","languageId":"pt","category":"daily","level":"B1","sourceText":"Pode crer!","translations":{"tr":["aynen!","kesin!"]},"details":{"register":"informal","context":"Güçlü onay; gençler arasında."},"examples":[{"text":"Esse show vai ser incrível! — Pode crer!","tr":"Bu konser efsane olacak! — Aynen!"}]},
  {"id":"pt-daily-isso-ai","languageId":"pt","category":"daily","level":"B1","sourceText":"Isso aí!","translations":{"tr":["işte bu!","aynen öyle!"]},"details":{"register":"informal","context":"Onay ve övgü için."},"examples":[{"text":"Consegui terminar! — Isso aí!","tr":"Bitirmeyi başardım! — İşte bu!"}]},
  {"id":"pt-daily-mandou-bem","languageId":"pt","category":"daily","level":"B1","sourceText":"Mandou bem!","translations":{"tr":["helal olsun!","iyi iş çıkardın!"]},"details":{"register":"informal","context":"Birinin başarısını övmek için."},"examples":[{"text":"Que apresentação! Mandou bem!","tr":"Ne sunumdu! Helal olsun!"}]},
  {"id":"pt-daily-arrasou","languageId":"pt","category":"daily","level":"B1","sourceText":"Arrasou!","translations":{"tr":["harikaydın!","yıktın geçtin!"]},"details":{"register":"informal","context":"Çok başarılı bir performansa ya da görünüşe övgü."},"examples":[{"text":"Você cantou muito bem. Arrasou!","tr":"Çok güzel söyledin. Harikaydın!"}]},
  {"id":"pt-daily-toca-aqui","languageId":"pt","category":"daily","level":"B1","sourceText":"Toca aqui!","translations":{"tr":["çak bir beşlik!","ver elini!"]},"details":{"register":"informal","context":"El çakmaya davet ederken."},"examples":[{"text":"Ganhamos o jogo! Toca aqui!","tr":"Maçı kazandık! Çak bir beşlik!"}]},
  {"id":"pt-daily-ta-na-mao","languageId":"pt","category":"daily","level":"B1","sourceText":"Tá na mão.","translations":{"tr":["al bakalım","buyur"]},"details":{"register":"informal","context":"Bir şeyi teslim ederken."},"examples":[{"text":"Me empresta a caneta? — Tá na mão.","tr":"Kalemini verir misin? — Al bakalım."}]},
  {"id":"pt-daily-quanto-tempo","languageId":"pt","category":"daily","level":"B1","sourceText":"Quanto tempo!","translations":{"tr":["ne zamandır görüşmedik!","nerelerdesin!"]},"details":{"register":"informal","context":"Uzun süre sonra karşılaşınca."},"examples":[{"text":"Oi, Rafa! Quanto tempo!","tr":"Selam Rafa! Ne zamandır görüşmedik!"}]},
  {"id":"pt-daily-oi-sumido","languageId":"pt","category":"daily","level":"B1","sourceText":"Oi, sumido!","translations":{"tr":["nerelerdesin sen!","kayıp!"]},"details":{"register":"informal","context":"Uzun süredir ortada görünmeyen birine şakayla; kadına 'sumida'."},"examples":[{"text":"Oi, sumida! Por onde você andava?","tr":"Kayıp! Nerelerdeydin?"}]},
  {"id":"pt-daily-e-as-novidades","languageId":"pt","category":"daily","level":"B1","sourceText":"E as novidades?","translations":{"tr":["ne var ne yok?","yeni ne var?"]},"details":{"register":"informal","context":"Bir süre görüşmeyince haber sorarken."},"examples":[{"text":"E aí, quais são as novidades?","tr":"Eee, ne var ne yok?"}]},
  {"id":"pt-daily-tudo-joia","languageId":"pt","category":"daily","level":"B1","sourceText":"Tudo joia?","translations":{"tr":["her şey yolunda mı?","naber?"]},"details":{"register":"informal","context":"Biraz eski moda, samimi selam; cevap 'Tudo joia!'."},"examples":[{"text":"Oi, seu Zé, tudo joia?","tr":"Merhaba Zé Bey, her şey yolunda mı?"}]},
  {"id":"pt-daily-to-de-boa","languageId":"pt","category":"daily","level":"B1","sourceText":"Tô de boa.","translations":{"tr":["iyiyim","keyfim yerinde","gerek yok"]},"details":{"register":"informal","context":"Rahat olduğunu ya da ikramı istemediğini söylerken."},"examples":[{"text":"Quer uma cerveja? — Não, valeu, tô de boa.","tr":"Bira ister misin? — Yok, sağ ol, gerek yok."}]},
  {"id":"pt-daily-to-morrendo-de-fome","languageId":"pt","category":"daily","level":"B1","sourceText":"Tô morrendo de fome.","translations":{"tr":["açlıktan ölüyorum"]},"details":{"register":"informal","context":"Çok acıktığında abartarak."},"examples":[{"text":"Bora comer? Tô morrendo de fome.","tr":"Yemek yiyelim mi? Açlıktan ölüyorum."}]},
  {"id":"pt-daily-to-morto-de-cansaco","languageId":"pt","category":"daily","level":"B1","sourceText":"Tô morto de cansaço.","translations":{"tr":["yorgunluktan ölüyorum","çok yorgunum"]},"details":{"register":"informal","context":"Çok yorgun olduğunda; kadın 'morta' der."},"examples":[{"text":"Trabalhei o dia todo, tô morto de cansaço.","tr":"Bütün gün çalıştım, yorgunluktan ölüyorum."}]},
  {"id":"pt-daily-to-com-pressa","languageId":"pt","category":"daily","level":"B1","sourceText":"Tô com pressa.","translations":{"tr":["acelem var"]},"details":{"register":"informal","context":"Konuşmaya vaktin olmadığında."},"examples":[{"text":"Desculpa, tô com pressa. Te ligo depois.","tr":"Kusura bakma, acelem var. Sonra ararım."}]},
  {"id":"pt-daily-to-chegando","languageId":"pt","category":"daily","level":"B1","sourceText":"Tô chegando!","translations":{"tr":["geliyorum!","yoldayım!"]},"details":{"register":"informal","context":"Mesajda ya da telefonda yolda olduğunu söylerken; bazen henüz çıkmamış bile olabilir."},"examples":[{"text":"Cadê você? — Tô chegando!","tr":"Neredesin? — Geliyorum!"}]},
  {"id":"pt-daily-me-avisa","languageId":"pt","category":"daily","level":"B1","sourceText":"Me avisa.","translations":{"tr":["bana haber ver"]},"details":{"register":"informal","context":"Gelişmelerden haberdar olmak istediğinde."},"examples":[{"text":"Quando sair o resultado, me avisa.","tr":"Sonuç çıkınca bana haber ver."}]},
  {"id":"pt-daily-qualquer-coisa-me-liga","languageId":"pt","category":"daily","level":"B1","sourceText":"Qualquer coisa, me liga.","translations":{"tr":["bir şey olursa beni ara"]},"details":{"register":"informal","context":"Yardıma hazır olduğunu söylerken."},"examples":[{"text":"Tô em casa hoje. Qualquer coisa, me liga.","tr":"Bugün evdeyim. Bir şey olursa beni ara."}]},
  {"id":"pt-daily-me-passa-seu-zap","languageId":"pt","category":"daily","level":"B1","sourceText":"Me passa seu zap?","translations":{"tr":["WhatsApp'ını verir misin?"]},"details":{"register":"informal","context":"Brezilya'da numara istemenin en yaygın yolu; zap = WhatsApp."},"examples":[{"text":"Adorei te conhecer! Me passa seu zap?","tr":"Tanıştığıma çok sevindim! WhatsApp'ını verir misin?"}]},
  {"id":"pt-daily-foi-engano","languageId":"pt","category":"daily","level":"B1","sourceText":"Foi engano.","translations":{"tr":["yanlış numara","yanlışlık oldu"]},"details":{"register":"neutral","context":"Telefonda yanlış numarayı aradığında."},"examples":[{"text":"Desculpe, foi engano.","tr":"Pardon, yanlış numara."}]},
  {"id":"pt-daily-posso-te-pedir-um-favor","languageId":"pt","category":"daily","level":"B1","sourceText":"Posso te pedir um favor?","translations":{"tr":["senden bir ricam olabilir mi?"]},"details":{"register":"neutral","context":"Bir iyilik istemeden önce."},"examples":[{"text":"Posso te pedir um favor? Rega minhas plantas?","tr":"Senden bir ricam olabilir mi? Çiçeklerimi sular mısın?"}]},
  {"id":"pt-daily-tem-como","languageId":"pt","category":"daily","level":"B1","sourceText":"Tem como …?","translations":{"tr":["…mümkün mü?","…bir yolu var mı?"]},"details":{"register":"informal","context":"Brezilya'da kibar ve dolaylı rica yolu."},"examples":[{"text":"Tem como trocar esse produto?","tr":"Bu ürünü değiştirmek mümkün mü?"}]},
  {"id":"pt-daily-voce-se-importa-se","languageId":"pt","category":"daily","level":"B1","sourceText":"Você se importa se …?","translations":{"tr":["… sakıncası var mı?","…sem rahatsız olur musun?"]},"details":{"register":"neutral","context":"İzin isterken."},"examples":[{"text":"Você se importa se eu abrir a janela?","tr":"Pencereyi açsam sakıncası var mı?"}]},
  {"id":"pt-daily-pode-embrulhar-pra-presente","languageId":"pt","category":"daily","level":"B1","sourceText":"Pode embrulhar pra presente?","translations":{"tr":["hediye paketi yapabilir misiniz?"]},"details":{"register":"neutral","context":"Mağazada hediye alırken."},"examples":[{"text":"Vou levar esse. Pode embrulhar pra presente?","tr":"Bunu alıyorum. Hediye paketi yapabilir misiniz?"}]},
  {"id":"pt-daily-tem-troco","languageId":"pt","category":"daily","level":"B1","sourceText":"Tem troco?","translations":{"tr":["bozuk paranız var mı?","paranın üstünü verebilir misiniz?"]},"details":{"register":"neutral","context":"Büyük banknotla öderken."},"examples":[{"text":"Só tenho uma nota de cem. Tem troco?","tr":"Sadece yüzlük var. Üstünü verebilir misiniz?"}]},
  {"id":"pt-daily-pode-ficar-com-o-troco","languageId":"pt","category":"daily","level":"B1","sourceText":"Pode ficar com o troco.","translations":{"tr":["üstü kalsın"]},"details":{"register":"neutral","context":"Taksi ya da serviste bahşiş bırakırken."},"examples":[{"text":"Obrigado, pode ficar com o troco.","tr":"Teşekkürler, üstü kalsın."}]},
  {"id":"pt-daily-vai-descer","languageId":"pt","category":"daily","level":"B1","sourceText":"Vai descer?","translations":{"tr":["inecek misiniz?"]},"details":{"register":"neutral","context":"Kalabalık otobüs ya da metroda kapıya yol isterken."},"examples":[{"text":"Com licença, vai descer no próximo ponto?","tr":"Pardon, bir sonraki durakta inecek misiniz?"}]},
  {"id":"pt-daily-junto-ou-separado","languageId":"pt","category":"daily","level":"B1","sourceText":"Junto ou separado?","translations":{"tr":["birlikte mi ayrı mı?"]},"details":{"register":"neutral","context":"Kasada ya da restoranda hesap sorulurken."},"examples":[{"text":"Vai ser junto ou separado? — Separado, por favor.","tr":"Birlikte mi ayrı mı? — Ayrı lütfen."}]},
  {"id":"pt-daily-nem-pensar","languageId":"pt","category":"daily","level":"B1","sourceText":"Nem pensar!","translations":{"tr":["aklından bile geçirme!","asla!"]},"details":{"register":"informal","context":"Bir öneriyi kesin bir dille reddederken."},"examples":[{"text":"Me empresta seu carro? — Nem pensar!","tr":"Arabanı ödünç verir misin? — Aklından bile geçirme!"}]},
  {"id":"pt-daily-que-horas-a-gente-se-encontra","languageId":"pt","category":"daily","level":"B1","sourceText":"Que horas a gente se encontra?","translations":{"tr":["saat kaçta buluşuyoruz?"]},"details":{"register":"informal","context":"Buluşma saatini ayarlarken."},"examples":[{"text":"Que horas a gente se encontra amanhã?","tr":"Yarın saat kaçta buluşuyoruz?"}]},
  {"id":"pt-daily-da-um-oi-pra","languageId":"pt","category":"daily","level":"B1","sourceText":"Dá um oi pra …","translations":{"tr":["…'e benden selam söyle"]},"details":{"register":"informal","context":"Ortak bir tanıdığa selam gönderirken."},"examples":[{"text":"Dá um oi pro seu irmão por mim!","tr":"Kardeşine benden selam söyle!"}]}
]
