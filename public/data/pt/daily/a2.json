[
  {"id":"pt-daily-tudo-certo","languageId":"pt","category":"daily","level":"A2","sourceText":"Tudo certo?","translations":{"tr":["her şey yolunda mı?","işler nasıl?"]},"details":{"register":"informal","context":"Selamlaşırken ya da bir işin durumunu sorarken."},"examples":[{"text":"Tudo certo pra amanhã?","tr":"Yarın için her şey tamam mı?"}]},
  {"id":"pt-daily-e-ai","languageId":"pt","category":"daily","level":"A2","sourceText":"E aí?","translations":{"tr":["naber?","ne var ne yok?"]},"details":{"register":"informal","context":"Arkadaşlar arasında samimi selam."},"examples":[{"text":"E aí, cara, beleza?","tr":"Naber dostum, iyi misin?"}]},
  {"id":"pt-daily-beleza","languageId":"pt","category":"daily","level":"A2","sourceText":"Beleza!","translations":{"tr":["tamam","süper","naber?"]},"details":{"register":"informal","context":"Onay verirken; soru olarak (Beleza?) samimi bir naber."},"examples":[{"text":"A gente se vê às oito? — Beleza!","tr":"Sekizde görüşüyor muyuz? — Tamam!"}]},
  {"id":"pt-daily-o-prazer-e-meu","languageId":"pt","category":"daily","level":"A2","sourceText":"O prazer é meu.","translations":{"tr":["ben de memnun oldum","asıl ben memnun oldum"]},"details":{"register":"neutral","context":"'Muito prazer'e kibar cevap."},"examples":[{"text":"Muito prazer! — O prazer é meu.","tr":"Memnun oldum! — Ben de."}]},
  {"id":"pt-daily-ate-ja","languageId":"pt","category":"daily","level":"A2","sourceText":"Até já!","translations":{"tr":["birazdan görüşürüz","az sonra görüşürüz"]},"details":{"register":"neutral","context":"Birkaç dakika içinde tekrar görüşecekken."},"examples":[{"text":"Vou só pegar o casaco. Até já!","tr":"Montumu alıp geliyorum. Birazdan görüşürüz!"}]},
  {"id":"pt-daily-ate-a-proxima","languageId":"pt","category":"daily","level":"A2","sourceText":"Até a próxima!","translations":{"tr":["bir dahaki sefere","bir dahakine görüşürüz"]},"details":{"register":"neutral","context":"Bir sonraki buluşmaya kadar vedalaşırken."},"examples":[{"text":"Valeu pela visita, até a próxima!","tr":"Ziyaret için sağ ol, bir dahakine!"}]},
  {"id":"pt-daily-a-gente-se-ve","languageId":"pt","category":"daily","level":"A2","sourceText":"A gente se vê!","translations":{"tr":["görüşürüz"]},"details":{"register":"informal","context":"Arkadaşlar arasında rahat veda."},"examples":[{"text":"Tenho que ir. A gente se vê!","tr":"Gitmem lazım. Görüşürüz!"}]},
  {"id":"pt-daily-tenho-que-ir","languageId":"pt","category":"daily","level":"A2","sourceText":"Tenho que ir.","translations":{"tr":["gitmem lazım","gitmem gerek"]},"details":{"register":"neutral","context":"Bir sohbeti bitirip ayrılırken."},"examples":[{"text":"Nossa, já é tarde! Tenho que ir.","tr":"Vay, geç olmuş! Gitmem lazım."}]},
  {"id":"pt-daily-se-cuida","languageId":"pt","category":"daily","level":"A2","sourceText":"Se cuida!","translations":{"tr":["kendine iyi bak"]},"details":{"register":"informal","context":"Samimi vedalarda; resmîsi 'Cuide-se'."},"examples":[{"text":"Tchau, se cuida!","tr":"Hoşça kal, kendine iyi bak!"}]},
  {"id":"pt-daily-beijo","languageId":"pt","category":"daily","level":"A2","sourceText":"Beijo!","translations":{"tr":["öptüm","sevgiler"]},"details":{"register":"informal","context":"Brezilya'da yakınlarla vedalaşırken ve mesaj sonunda; 'beijos' da denir."},"examples":[{"text":"Tchau, mãe, beijo!","tr":"Görüşürüz anne, öptüm!"}]},
  {"id":"pt-daily-valeu","languageId":"pt","category":"daily","level":"A2","sourceText":"Valeu!","translations":{"tr":["sağ ol","eyvallah"]},"details":{"register":"informal","context":"Arkadaşlar arasında teşekkür; bazen veda için de."},"examples":[{"text":"Valeu pela ajuda, cara!","tr":"Yardımın için sağ ol dostum!"}]},
  {"id":"pt-daily-fica-a-vontade","languageId":"pt","category":"daily","level":"A2","sourceText":"Fica à vontade.","translations":{"tr":["rahatına bak","kendi evin gibi"]},"details":{"register":"informal","context":"Misafiri ağırlarken; resmîsi 'Fique à vontade'."},"examples":[{"text":"Entra, fica à vontade!","tr":"Gel içeri, rahatına bak!"}]},
  {"id":"pt-daily-pode-entrar","languageId":"pt","category":"daily","level":"A2","sourceText":"Pode entrar.","translations":{"tr":["girebilirsin","buyrun, girin"]},"details":{"register":"neutral","context":"Kapıyı çalan birine."},"examples":[{"text":"Posso entrar? — Pode entrar!","tr":"Girebilir miyim? — Buyrun!"}]},
  {"id":"pt-daily-senta-ai","languageId":"pt","category":"daily","level":"A2","sourceText":"Senta aí.","translations":{"tr":["otur şöyle","otursana"]},"details":{"register":"informal","context":"Misafire ya da arkadaşa yer gösterirken."},"examples":[{"text":"Senta aí, vou fazer um café.","tr":"Otur şöyle, bir kahve yapayım."}]},
  {"id":"pt-daily-tim-tim","languageId":"pt","category":"daily","level":"A2","sourceText":"Tim-tim!","translations":{"tr":["şerefe"]},"details":{"register":"informal","context":"Kadeh kaldırırken neşeli söyleyiş."},"examples":[{"text":"Ao nosso novo emprego, tim-tim!","tr":"Yeni işimize, şerefe!"}]},
  {"id":"pt-daily-muitos-anos-de-vida","languageId":"pt","category":"daily","level":"A2","sourceText":"Muitos anos de vida!","translations":{"tr":["nice yıllara","uzun ömürler"]},"details":{"register":"neutral","context":"Doğum günü dileği; 'Parabéns' ile birlikte söylenir."},"examples":[{"text":"Parabéns e muitos anos de vida!","tr":"Tebrikler, nice yıllara!"}]},
  {"id":"pt-daily-bom-trabalho","languageId":"pt","category":"daily","level":"A2","sourceText":"Bom trabalho!","translations":{"tr":["kolay gelsin","iyi çalışmalar"]},"details":{"register":"neutral","context":"İşe giden ya da çalışan birine; 'aferin' anlamı da var."},"examples":[{"text":"Tchau, amor, bom trabalho!","tr":"Görüşürüz aşkım, kolay gelsin!"}]},
  {"id":"pt-daily-boas-ferias","languageId":"pt","category":"daily","level":"A2","sourceText":"Boas férias!","translations":{"tr":["iyi tatiller"]},"details":{"register":"neutral","context":"Tatile çıkan birine."},"examples":[{"text":"Boas férias! Aproveita bastante!","tr":"İyi tatiller! Tadını çıkar!"}]},
  {"id":"pt-daily-melhoras","languageId":"pt","category":"daily","level":"A2","sourceText":"Melhoras!","translations":{"tr":["geçmiş olsun"]},"details":{"register":"neutral","context":"Hasta birine iyileşme dileği."},"examples":[{"text":"Soube que você está gripado. Melhoras!","tr":"Grip olduğunu duydum. Geçmiş olsun!"}]},
  {"id":"pt-daily-dorme-bem","languageId":"pt","category":"daily","level":"A2","sourceText":"Dorme bem!","translations":{"tr":["iyi uykular"]},"details":{"register":"informal","context":"Yakınlara iyi geceler dilerken."},"examples":[{"text":"Já vou deitar. — Dorme bem!","tr":"Ben yatıyorum. — İyi uykular!"}]},
  {"id":"pt-daily-moco-moca","languageId":"pt","category":"daily","level":"A2","sourceText":"Moço! / Moça!","translations":{"tr":["bakar mısınız","garson bey"]},"details":{"register":"informal","context":"Brezilya'da garsonu ya da tezgâhtarı çağırırken."},"examples":[{"text":"Moça, mais uma água, por favor.","tr":"Bakar mısınız, bir su daha lütfen."}]},
  {"id":"pt-daily-pode-trazer-o-cardapio","languageId":"pt","category":"daily","level":"A2","sourceText":"Pode trazer o cardápio?","translations":{"tr":["menüyü getirebilir misiniz?"]},"details":{"register":"neutral","context":"Restoranda; Brezilya'da menü = cardápio."},"examples":[{"text":"Boa noite! Pode trazer o cardápio?","tr":"İyi akşamlar! Menüyü getirebilir misiniz?"}]},
  {"id":"pt-daily-pra-viagem","languageId":"pt","category":"daily","level":"A2","sourceText":"Pra viagem.","translations":{"tr":["paket olsun","götürmek için"]},"details":{"register":"neutral","context":"Yiyeceği dışarı götürmek istediğinde."},"examples":[{"text":"Um açaí pra viagem, por favor.","tr":"Bir açaí, paket olsun lütfen."}]},
  {"id":"pt-daily-aceita-cartao","languageId":"pt","category":"daily","level":"A2","sourceText":"Aceita cartão?","translations":{"tr":["kart geçiyor mu?","kartla ödeyebilir miyim?"]},"details":{"register":"neutral","context":"Ödemeden önce."},"examples":[{"text":"Vocês aceitam cartão? — Sim, e Pix também.","tr":"Kart geçiyor mu? — Evet, Pix de olur."}]},
  {"id":"pt-daily-no-debito-ou-no-credito","languageId":"pt","category":"daily","level":"A2","sourceText":"No débito ou no crédito?","translations":{"tr":["banka kartı mı kredi kartı mı?"]},"details":{"register":"neutral","context":"Kasada kartla öderken satıcının sorusu."},"examples":[{"text":"Vai ser no débito ou no crédito? — No débito.","tr":"Banka kartı mı kredi kartı mı? — Banka kartı."}]},
  {"id":"pt-daily-mais-alguma-coisa","languageId":"pt","category":"daily","level":"A2","sourceText":"Mais alguma coisa?","translations":{"tr":["başka bir şey?","başka arzunuz?"]},"details":{"register":"neutral","context":"Satıcının ya da garsonun sorusu."},"examples":[{"text":"Mais alguma coisa? — Não, só isso.","tr":"Başka bir şey? — Hayır, bu kadar."}]},
  {"id":"pt-daily-so-isso","languageId":"pt","category":"daily","level":"A2","sourceText":"Só isso.","translations":{"tr":["bu kadar","sadece bu"]},"details":{"register":"neutral","context":"Siparişin bittiğini söylerken."},"examples":[{"text":"Mais alguma coisa? — Só isso, obrigado.","tr":"Başka? — Bu kadar, teşekkürler."}]},
  {"id":"pt-daily-em-que-posso-ajudar","languageId":"pt","category":"daily","level":"A2","sourceText":"Em que posso ajudar?","translations":{"tr":["size nasıl yardımcı olabilirim?"]},"details":{"register":"formal","context":"Mağaza, banka, telefon hattında resmî karşılama."},"examples":[{"text":"Bom dia, em que posso ajudar?","tr":"Günaydın, size nasıl yardımcı olabilirim?"}]},
  {"id":"pt-daily-estou-so-olhando","languageId":"pt","category":"daily","level":"A2","sourceText":"Estou só olhando.","translations":{"tr":["sadece bakıyorum"]},"details":{"register":"neutral","context":"Mağazada satıcı yardım teklif edince."},"examples":[{"text":"Precisa de alguma coisa? — Não, obrigada, estou só olhando.","tr":"Bir şey lazım mı? — Hayır, teşekkürler, sadece bakıyorum."}]},
  {"id":"pt-daily-posso-experimentar","languageId":"pt","category":"daily","level":"A2","sourceText":"Posso experimentar?","translations":{"tr":["deneyebilir miyim?"]},"details":{"register":"neutral","context":"Giyim mağazasında."},"examples":[{"text":"Posso experimentar essa calça?","tr":"Bu pantolonu deneyebilir miyim?"}]},
  {"id":"pt-daily-tem-outro-tamanho","languageId":"pt","category":"daily","level":"A2","sourceText":"Tem outro tamanho?","translations":{"tr":["başka bedeni var mı?"]},"details":{"register":"neutral","context":"Giyim alışverişinde."},"examples":[{"text":"Ficou apertado. Tem outro tamanho?","tr":"Dar geldi. Başka bedeni var mı?"}]},
  {"id":"pt-daily-vou-levar","languageId":"pt","category":"daily","level":"A2","sourceText":"Vou levar.","translations":{"tr":["alıyorum","bunu alacağım"]},"details":{"register":"neutral","context":"Alışverişte karar verdiğinde."},"examples":[{"text":"Gostei muito. Vou levar!","tr":"Çok beğendim. Alıyorum!"}]},
  {"id":"pt-daily-so-um-minutinho","languageId":"pt","category":"daily","level":"A2","sourceText":"Só um minutinho!","translations":{"tr":["bir dakikacık!"]},"details":{"register":"informal","context":"Samimi şekilde kısa bekleme isterken."},"examples":[{"text":"Só um minutinho, já te atendo.","tr":"Bir dakikacık, hemen ilgileniyorum."}]},
  {"id":"pt-daily-espera-ai","languageId":"pt","category":"daily","level":"A2","sourceText":"Espera aí!","translations":{"tr":["bekle!","dur bir dakika!"]},"details":{"register":"informal","context":"Birini durdururken ya da bir şey aklına gelince."},"examples":[{"text":"Espera aí, esqueci o celular!","tr":"Dur bir dakika, telefonumu unuttum!"}]},
  {"id":"pt-daily-o-que-aconteceu","languageId":"pt","category":"daily","level":"A2","sourceText":"O que aconteceu?","translations":{"tr":["ne oldu?"]},"details":{"register":"neutral","context":"Bir olayın ardından."},"examples":[{"text":"Por que você está chorando? O que aconteceu?","tr":"Neden ağlıyorsun? Ne oldu?"}]},
  {"id":"pt-daily-nao-se-preocupe","languageId":"pt","category":"daily","level":"A2","sourceText":"Não se preocupe.","translations":{"tr":["merak etme","endişelenme"]},"details":{"register":"neutral","context":"Birini rahatlatırken; samimisi 'Não se preocupa'."},"examples":[{"text":"Não se preocupe, eu resolvo isso.","tr":"Merak etme, ben hallederim."}]},
  {"id":"pt-daily-fica-tranquilo","languageId":"pt","category":"daily","level":"A2","sourceText":"Fica tranquilo.","translations":{"tr":["merak etme","rahat ol"]},"details":{"register":"informal","context":"Brezilya'da birini rahatlatmanın en yaygın yolu; kadına 'tranquila'."},"examples":[{"text":"Fica tranquila, vai dar tempo.","tr":"Merak etme, yetişeceğiz."}]},
  {"id":"pt-daily-calma","languageId":"pt","category":"daily","level":"A2","sourceText":"Calma!","translations":{"tr":["sakin ol!","yavaş!"]},"details":{"register":"neutral","context":"Heyecanlanan ya da sinirlenen birine."},"examples":[{"text":"Calma, respira fundo.","tr":"Sakin ol, derin nefes al."}]},
  {"id":"pt-daily-relaxa","languageId":"pt","category":"daily","level":"A2","sourceText":"Relaxa!","translations":{"tr":["takma kafana!","rahat ol!"]},"details":{"register":"informal","context":"Arkadaşa, bir şeyi dert etmemesini söylerken."},"examples":[{"text":"Relaxa, não foi nada.","tr":"Takma kafana, bir şey olmadı."}]},
  {"id":"pt-daily-nao-tem-problema","languageId":"pt","category":"daily","level":"A2","sourceText":"Não tem problema.","translations":{"tr":["sorun değil","dert değil"]},"details":{"register":"neutral","context":"Özre ya da ricaya cevap."},"examples":[{"text":"Desculpa o atraso. — Não tem problema!","tr":"Geç kaldığım için kusura bakma. — Sorun değil!"}]},
  {"id":"pt-daily-tanto-faz","languageId":"pt","category":"daily","level":"A2","sourceText":"Tanto faz.","translations":{"tr":["fark etmez","hangisi olsa olur"]},"details":{"register":"neutral","context":"Seçim sorulduğunda tercihin olmadığını söylerken."},"examples":[{"text":"Pizza ou hambúrguer? — Tanto faz.","tr":"Pizza mı hamburger mi? — Fark etmez."}]},
  {"id":"pt-daily-pode-ser","languageId":"pt","category":"daily","level":"A2","sourceText":"Pode ser.","translations":{"tr":["olabilir","olur","neden olmasın"]},"details":{"register":"neutral","context":"Bir öneriyi yumuşakça kabul ederken."},"examples":[{"text":"Vamos tomar um café? — Pode ser.","tr":"Kahve içelim mi? — Olur."}]},
  {"id":"pt-daily-combinado","languageId":"pt","category":"daily","level":"A2","sourceText":"Combinado!","translations":{"tr":["anlaştık!","tamamdır!"]},"details":{"register":"neutral","context":"Bir plan ya da anlaşma kesinleşince."},"examples":[{"text":"Sábado às dez na praia? — Combinado!","tr":"Cumartesi saat onda plajda? — Anlaştık!"}]},
  {"id":"pt-daily-vamos-la","languageId":"pt","category":"daily","level":"A2","sourceText":"Vamos lá!","translations":{"tr":["hadi!","haydi bakalım!"]},"details":{"register":"neutral","context":"Bir işe başlarken ya da cesaretlendirirken."},"examples":[{"text":"Vamos lá, falta pouco!","tr":"Hadi, az kaldı!"}]},
  {"id":"pt-daily-serio","languageId":"pt","category":"daily","level":"A2","sourceText":"Sério?","translations":{"tr":["cidden mi?","ciddi misin?"]},"details":{"register":"informal","context":"Şaşırınca."},"examples":[{"text":"Ganhei na rifa! — Sério?","tr":"Çekilişi kazandım! — Cidden mi?"}]},
  {"id":"pt-daily-e-mesmo","languageId":"pt","category":"daily","level":"A2","sourceText":"É mesmo?","translations":{"tr":["öyle mi?","gerçekten mi?"]},"details":{"register":"neutral","context":"İlgiyle karşılık verirken."},"examples":[{"text":"Ela vai casar. — É mesmo? Que legal!","tr":"Evleniyor. — Öyle mi? Ne güzel!"}]},
  {"id":"pt-daily-pois-e","languageId":"pt","category":"daily","level":"A2","sourceText":"Pois é.","translations":{"tr":["öyle işte","aynen","ne diyeceksin"]},"details":{"register":"informal","context":"Onaylarken ya da sohbeti sürdürürken; Brezilya'da çok yaygın."},"examples":[{"text":"Tá caro tudo, né? — Pois é.","tr":"Her şey pahalı, değil mi? — Öyle işte."}]},
  {"id":"pt-daily-nao-acredito","languageId":"pt","category":"daily","level":"A2","sourceText":"Não acredito!","translations":{"tr":["inanmıyorum!"]},"details":{"register":"neutral","context":"Büyük şaşkınlık anında."},"examples":[{"text":"Você passou? Não acredito!","tr":"Geçtin mi? İnanmıyorum!"}]},
  {"id":"pt-daily-nossa","languageId":"pt","category":"daily","level":"A2","sourceText":"Nossa!","translations":{"tr":["vay!","vay canına!"]},"details":{"register":"informal","context":"Brezilya'da şaşkınlık bildiren en yaygın ünlem (Nossa Senhora'dan)."},"examples":[{"text":"Nossa, que casa linda!","tr":"Vay, ne güzel ev!"}]},
  {"id":"pt-daily-que-pena","languageId":"pt","category":"daily","level":"A2","sourceText":"Que pena!","translations":{"tr":["ne yazık!","yazık!"]},"details":{"register":"neutral","context":"Kötü ya da üzücü bir habere tepki."},"examples":[{"text":"Não vou poder ir. — Que pena!","tr":"Gelemeyeceğim. — Ne yazık!"}]},
  {"id":"pt-daily-que-chato","languageId":"pt","category":"daily","level":"A2","sourceText":"Que chato!","translations":{"tr":["ne sıkıcı!","ne kötü!"]},"details":{"register":"informal","context":"Can sıkıcı bir duruma tepki."},"examples":[{"text":"O show foi cancelado. — Que chato!","tr":"Konser iptal oldu. — Ne kötü!"}]},
  {"id":"pt-daily-que-delicia","languageId":"pt","category":"daily","level":"A2","sourceText":"Que delícia!","translations":{"tr":["çok lezzetli!","ne güzel!"]},"details":{"register":"neutral","context":"Yemek için ya da çok hoş bir şey için."},"examples":[{"text":"Que delícia esse bolo!","tr":"Bu kek çok lezzetli!"}]},
  {"id":"pt-daily-que-saudade","languageId":"pt","category":"daily","level":"A2","sourceText":"Que saudade!","translations":{"tr":["çok özledim!","burnumda tütüyor!"]},"details":{"register":"neutral","context":"Birini ya da bir şeyi özlediğini söylerken."},"examples":[{"text":"Que saudade de você, amiga!","tr":"Seni çok özledim kızım!"}]},
  {"id":"pt-daily-que-bom-te-ver","languageId":"pt","category":"daily","level":"A2","sourceText":"Que bom te ver!","translations":{"tr":["seni görmek ne güzel!"]},"details":{"register":"neutral","context":"Uzun süre sonra karşılaşınca."},"examples":[{"text":"Oi, Paulo! Que bom te ver!","tr":"Selam Paulo! Seni görmek ne güzel!"}]},
  {"id":"pt-daily-opa","languageId":"pt","category":"daily","level":"A2","sourceText":"Opa!","translations":{"tr":["hop!","eyvah!","selam!"]},"details":{"register":"informal","context":"Küçük bir kaza anında ya da samimi selam olarak."},"examples":[{"text":"Opa, derrubei o copo!","tr":"Hop, bardağı devirdim!"}]},
  {"id":"pt-daily-ufa","languageId":"pt","category":"daily","level":"A2","sourceText":"Ufa!","translations":{"tr":["oh be!","oh!"]},"details":{"register":"informal","context":"Rahatlayınca ya da yorulunca."},"examples":[{"text":"Ufa, terminei a prova!","tr":"Oh be, sınavı bitirdim!"}]},
  {"id":"pt-daily-poxa","languageId":"pt","category":"daily","level":"A2","sourceText":"Poxa!","translations":{"tr":["hay aksi!","vay be!","yaa!"]},"details":{"register":"informal","context":"Hayal kırıklığı ya da şaşkınlık; 'Puxa!' da denir."},"examples":[{"text":"Poxa, você esqueceu de novo?","tr":"Yaa, yine mi unuttun?"}]},
  {"id":"pt-daily-meu-deus","languageId":"pt","category":"daily","level":"A2","sourceText":"Meu Deus!","translations":{"tr":["aman Tanrım!","Allah'ım!"]},"details":{"register":"neutral","context":"Şaşkınlık ya da korku anında."},"examples":[{"text":"Meu Deus, que susto!","tr":"Aman Tanrım, ne korktum!"}]},
  {"id":"pt-daily-gracas-a-deus","languageId":"pt","category":"daily","level":"A2","sourceText":"Graças a Deus!","translations":{"tr":["çok şükür!","Allah'a şükür!"]},"details":{"register":"neutral","context":"Rahatlayınca."},"examples":[{"text":"Ninguém se machucou, graças a Deus!","tr":"Çok şükür kimse yaralanmadı!"}]},
  {"id":"pt-daily-te-adoro","languageId":"pt","category":"daily","level":"A2","sourceText":"Te adoro!","translations":{"tr":["sana bayılıyorum!","seni çok seviyorum!"]},"details":{"register":"informal","context":"Arkadaşlar arasında da kullanılan sıcak sevgi ifadesi."},"examples":[{"text":"Obrigada pelo presente, te adoro!","tr":"Hediye için teşekkürler, seni çok seviyorum!"}]},
  {"id":"pt-daily-desculpa-o-atraso","languageId":"pt","category":"daily","level":"A2","sourceText":"Desculpa o atraso.","translations":{"tr":["geç kaldığım için kusura bakma"]},"details":{"register":"neutral","context":"Bir buluşmaya geç gelince."},"examples":[{"text":"Desculpa o atraso, o trânsito estava horrível.","tr":"Kusura bakma geç kaldım, trafik berbattı."}]},
  {"id":"pt-daily-desculpa-incomodar","languageId":"pt","category":"daily","level":"A2","sourceText":"Desculpa incomodar.","translations":{"tr":["rahatsız ettiğim için kusura bakma"]},"details":{"register":"neutral","context":"Birinin işini bölerken."},"examples":[{"text":"Desculpa incomodar, mas você tem um minuto?","tr":"Rahatsız ediyorum ama bir dakikan var mı?"}]},
  {"id":"pt-daily-obrigado-por-tudo","languageId":"pt","category":"daily","level":"A2","sourceText":"Obrigado por tudo.","translations":{"tr":["her şey için teşekkürler"]},"details":{"register":"neutral","context":"Ayrılırken ya da uzun bir yardımın sonunda."},"examples":[{"text":"Obrigado por tudo, vocês foram ótimos.","tr":"Her şey için teşekkürler, harikaydınız."}]},
  {"id":"pt-daily-volte-sempre","languageId":"pt","category":"daily","level":"A2","sourceText":"Volte sempre!","translations":{"tr":["yine bekleriz!","yine gelin!"]},"details":{"register":"neutral","context":"Dükkân sahibi ya da ev sahibi giden misafire."},"examples":[{"text":"Obrigado pela preferência, volte sempre!","tr":"Bizi tercih ettiğiniz için teşekkürler, yine bekleriz!"}]},
