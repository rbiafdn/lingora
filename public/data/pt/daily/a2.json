  {"id":"pt-daily-quem-fala","languageId":"pt","category":"daily","level":"A2","sourceText":"Quem fala?","translations":{"tr":["kiminle görüşüyorum?","kim arıyor?"]},"details":{"register":"neutral","context":"Telefonda arayanın kim olduğunu sorarken."},"examples":[{"text":"Alô, quem fala? — É a Bia.","tr":"Alo, kim arıyor? — Ben Bia."}]},
