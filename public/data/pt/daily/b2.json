[
  {"id":"pt-daily-juizo","languageId":"pt","category":"daily","level":"B2","sourceText":"Juízo!","translations":{"tr":["akıllı ol!","uslu dur!"]},"details":{"register":"informal","context":"Gençlere ya da çocuklara şakayla karışık uyarı."},"examples":[{"text":"Vai pra festa? Juízo, hein!","tr":"Partiye mi gidiyorsun? Akıllı ol, ha!"}]},
  {"id":"pt-daily-desculpa-qualquer-coisa","languageId":"pt","category":"daily","level":"B2","sourceText":"Desculpa qualquer coisa.","translations":{"tr":["bir kusur ettiysek affedin"]},"details":{"register":"neutral","context":"Brezilya'da misafirlik ya da ziyaret sonunda kibar veda."},"examples":[{"text":"Obrigado pela visita e desculpa qualquer coisa!","tr":"Ziyaretiniz için teşekkürler, bir kusur ettiysek affedin!"}]},
  {"id":"pt-daily-nao-liga-nao","languageId":"pt","category":"daily","level":"B2","sourceText":"Não liga, não.","translations":{"tr":["takma kafana","aldırma"]},"details":{"register":"informal","context":"Birini teselli ederken."},"examples":[{"text":"Ele é assim mesmo, não liga, não.","tr":"O hep böyledir, aldırma."}]},
  {"id":"pt-daily-que-do","languageId":"pt","category":"daily","level":"B2","sourceText":"Que dó!","translations":{"tr":["ne yazık!","çok üzüldüm!"]},"details":{"register":"informal","context":"Acıma duygusu; dar dó = acımak."},"examples":[{"text":"O cachorrinho estava sozinho na chuva, que dó!","tr":"Köpekçik yağmurda yalnızdı, çok üzüldüm!"}]},
  {"id":"pt-daily-que-mico","languageId":"pt","category":"daily","level":"B2","sourceText":"Que mico!","translations":{"tr":["ne rezillik!","rezil oldum!"]},"details":{"register":"informal","context":"Utandırıcı bir an için; pagar mico = rezil olmak."},"examples":[{"text":"Caí na frente de todo mundo. Que mico!","tr":"Herkesin önünde düştüm. Rezil oldum!"}]},
  {"id":"pt-daily-nossa-senhora","languageId":"pt","category":"daily","level":"B2","sourceText":"Nossa Senhora!","translations":{"tr":["aman Tanrım!","yok artık!"]},"details":{"register":"informal","context":"Güçlü şaşkınlık; 'Nossa!'nın tam hâli."},"examples":[{"text":"Nossa Senhora, que calor!","tr":"Aman Tanrım, ne sıcak!"}]},
  {"id":"pt-daily-bate-na-madeira","languageId":"pt","category":"daily","level":"B2","sourceText":"Bate na madeira!","translations":{"tr":["tahtaya vur!","şeytan kulağına kurşun!"]},"details":{"register":"informal","context":"Kötü bir ihtimalden söz edildiğinde."},"examples":[{"text":"Nunca fiquei doente esse ano. — Bate na madeira!","tr":"Bu yıl hiç hastalanmadım. — Şeytan kulağına kurşun!"}]},
  {"id":"pt-daily-seja-o-que-deus-quiser","languageId":"pt","category":"daily","level":"B2","sourceText":"Seja o que Deus quiser.","translations":{"tr":["ne olacaksa olsun","Allah'ın dediği olur"]},"details":{"register":"neutral","context":"Sonucu kadere bırakırken."},"examples":[{"text":"Fiz o que pude. Agora, seja o que Deus quiser.","tr":"Elimden geleni yaptım. Şimdi ne olacaksa olsun."}]},
  {"id":"pt-daily-por-onde-voce-andava","languageId":"pt","category":"daily","level":"B2","sourceText":"Por onde você andava?","translations":{"tr":["nerelerdeydin?"]},"details":{"register":"informal","context":"Uzun süre görülmeyen birine."},"examples":[{"text":"Nossa, por onde você andava?","tr":"Vay, nerelerdeydin?"}]},
  {"id":"pt-daily-to-de-saco-cheio","languageId":"pt","category":"daily","level":"B2","sourceText":"Tô de saco cheio.","translations":{"tr":["bıktım","gına geldi"]},"details":{"register":"informal","context":"Bir şeyden çok sıkıldığında; samimi ortamda."},"examples":[{"text":"Tô de saco cheio desse trânsito.","tr":"Bu trafikten gına geldi."}]},
  {"id":"pt-daily-ta-tudo-sob-controle","languageId":"pt","category":"daily","level":"B2","sourceText":"Tá tudo sob controle.","translations":{"tr":["her şey kontrol altında"]},"details":{"register":"informal","context":"Birini rahatlatırken."},"examples":[{"text":"Relaxa, tá tudo sob controle.","tr":"Rahat ol, her şey kontrol altında."}]},
  {"id":"pt-daily-ja-era","languageId":"pt","category":"daily","level":"B2","sourceText":"Já era.","translations":{"tr":["bitti","gitti","olan oldu"]},"details":{"register":"informal","context":"Bir şeyin kaybedildiğini ya da bittiğini söylerken."},"examples":[{"text":"O último ônibus já saiu? Já era.","tr":"Son otobüs gitti mi? Olan oldu."}]},
  {"id":"pt-daily-firmeza","languageId":"pt","category":"daily","level":"B2","sourceText":"Firmeza?","translations":{"tr":["naber?","her şey sağlam mı?"]},"details":{"register":"informal","context":"Özellikle São Paulo gençlerinde samimi selam; cevap 'Firmeza!'."},"examples":[{"text":"E aí, mano, firmeza?","tr":"Naber kanka, her şey yolunda mı?"}]}
