[
  {"id":"pt-daily-oi","languageId":"pt","category":"daily","level":"A1","sourceText":"Oi!","translations":{"tr":["selam","merhaba"]},"details":{"register":"informal","context":"Brezilya'da en yaygın selam; tanıdık ya da yabancı herkese."},"examples":[{"text":"Oi, tudo bem?","tr":"Selam, nasılsın?"}]},
  {"id":"pt-daily-ola","languageId":"pt","category":"daily","level":"A1","sourceText":"Olá!","translations":{"tr":["merhaba"]},"details":{"register":"neutral","context":"Oi'den biraz daha resmî; yazıda ve yabancılarla."},"examples":[{"text":"Olá, posso ajudar?","tr":"Merhaba, yardımcı olabilir miyim?"}]},
  {"id":"pt-daily-bom-dia","languageId":"pt","category":"daily","level":"A1","sourceText":"Bom dia!","translations":{"tr":["günaydın","iyi günler"]},"details":{"register":"neutral","context":"Sabahtan öğlene kadar selamlaşırken ve vedalaşırken."},"examples":[{"text":"Bom dia, dona Maria!","tr":"Günaydın Maria Hanım!"}]},
  {"id":"pt-daily-boa-tarde","languageId":"pt","category":"daily","level":"A1","sourceText":"Boa tarde!","translations":{"tr":["tünaydın","iyi günler"]},"details":{"register":"neutral","context":"Öğleden akşama kadar selam ve veda."},"examples":[{"text":"Boa tarde, um pão francês, por favor.","tr":"İyi günler, bir ekmek lütfen."}]},
  {"id":"pt-daily-boa-noite","languageId":"pt","category":"daily","level":"A1","sourceText":"Boa noite!","translations":{"tr":["iyi akşamlar","iyi geceler"]},"details":{"register":"neutral","context":"Hava karardıktan sonra hem selam hem veda için."},"examples":[{"text":"Boa noite, pessoal! Até amanhã.","tr":"İyi geceler millet! Yarın görüşürüz."}]},
  {"id":"pt-daily-tudo-bem","languageId":"pt","category":"daily","level":"A1","sourceText":"Tudo bem?","translations":{"tr":["nasılsın?","her şey yolunda mı?"]},"details":{"register":"neutral","context":"Selamlaşmanın neredeyse zorunlu parçası; cevabı da 'Tudo bem!'."},"examples":[{"text":"Oi, Ana! Tudo bem? — Tudo bem, e você?","tr":"Selam Ana! Nasılsın? — İyiyim, sen?"}]},
  {"id":"pt-daily-tudo-bom","languageId":"pt","category":"daily","level":"A1","sourceText":"Tudo bom?","translations":{"tr":["nasılsın?","iyi misin?"]},"details":{"register":"informal","context":"Tudo bem? ile aynı; cevap 'Tudo bom!' ya da 'Tudo ótimo!'."},"examples":[{"text":"E aí, tudo bom? — Tudo ótimo!","tr":"Naber, iyi misin? — Süperim!"}]},
  {"id":"pt-daily-como-vai","languageId":"pt","category":"daily","level":"A1","sourceText":"Como vai?","translations":{"tr":["nasılsınız?","nasılsın?"]},"details":{"register":"neutral","context":"Tanıdık birine nezaketle hâl hatır sorarken."},"examples":[{"text":"Olá, senhor Paulo, como vai?","tr":"Merhaba Paulo Bey, nasılsınız?"}]},
  {"id":"pt-daily-como-voce-esta","languageId":"pt","category":"daily","level":"A1","sourceText":"Como você está?","translations":{"tr":["nasılsın?"]},"details":{"register":"neutral","context":"Gerçekten durumunu merak ettiğinde, örneğin hastalık sonrası."},"examples":[{"text":"Soube que você ficou doente. Como você está?","tr":"Hastalandığını duydum. Nasılsın?"}]},
  {"id":"pt-daily-estou-bem-obrigado","languageId":"pt","category":"daily","level":"A1","sourceText":"Estou bem, obrigado.","translations":{"tr":["iyiyim, teşekkürler"]},"details":{"register":"neutral","context":"Hâl hatır sorusuna standart cevap; kadın 'obrigada' der."},"examples":[{"text":"Como vai? — Estou bem, obrigado. E você?","tr":"Nasılsınız? — İyiyim, teşekkürler. Siz?"}]},
  {"id":"pt-daily-muito-prazer","languageId":"pt","category":"daily","level":"A1","sourceText":"Muito prazer!","translations":{"tr":["memnun oldum","tanıştığımıza memnun oldum"]},"details":{"register":"neutral","context":"Biriyle ilk tanışırken; kısaca 'Prazer!' de denir."},"examples":[{"text":"Eu sou a Carla. — Muito prazer, Carla!","tr":"Ben Carla. — Memnun oldum Carla!"}]},
  {"id":"pt-daily-como-voce-se-chama","languageId":"pt","category":"daily","level":"A1","sourceText":"Como você se chama?","translations":{"tr":["adın ne?"]},"details":{"register":"neutral","context":"Tanışırken isim sormak için."},"examples":[{"text":"Como você se chama? — Eu me chamo Emre.","tr":"Adın ne? — Adım Emre."}]},
  {"id":"pt-daily-meu-nome-e","languageId":"pt","category":"daily","level":"A1","sourceText":"Meu nome é …","translations":{"tr":["benim adım …"]},"details":{"register":"neutral","context":"Kendini tanıtırken."},"examples":[{"text":"Oi, meu nome é Ayşe. Sou da Turquia.","tr":"Merhaba, benim adım Ayşe. Türkiye'denim."}]},
  {"id":"pt-daily-de-onde-voce-e","languageId":"pt","category":"daily","level":"A1","sourceText":"De onde você é?","translations":{"tr":["nerelisin?"]},"details":{"register":"neutral","context":"Tanışma sohbetinde."},"examples":[{"text":"De onde você é? — Sou de Ancara.","tr":"Nerelisin? — Ankaralıyım."}]},
  {"id":"pt-daily-sou-da-turquia","languageId":"pt","category":"daily","level":"A1","sourceText":"Sou da Turquia.","translations":{"tr":["Türkiye'denim"]},"details":{"register":"neutral","context":"Nereli olduğunu söylerken; Türk = turco/turca."},"examples":[{"text":"Sou da Turquia, mas moro em São Paulo.","tr":"Türkiye'denim ama São Paulo'da yaşıyorum."}]},
  {"id":"pt-daily-onde-voce-mora","languageId":"pt","category":"daily","level":"A1","sourceText":"Onde você mora?","translations":{"tr":["nerede oturuyorsun?","nerede yaşıyorsun?"]},"details":{"register":"neutral","context":"Tanışma sohbetinde."},"examples":[{"text":"Onde você mora? — Moro no centro.","tr":"Nerede oturuyorsun? — Merkezde oturuyorum."}]},
  {"id":"pt-daily-o-que-voce-faz","languageId":"pt","category":"daily","level":"A1","sourceText":"O que você faz?","translations":{"tr":["ne iş yapıyorsun?"]},"details":{"register":"neutral","context":"Meslek sorarken."},"examples":[{"text":"O que você faz? — Sou engenheira.","tr":"Ne iş yapıyorsun? — Mühendisim."}]},
  {"id":"pt-daily-quantos-anos-voce-tem","languageId":"pt","category":"daily","level":"A1","sourceText":"Quantos anos você tem?","translations":{"tr":["kaç yaşındasın?"]},"details":{"register":"neutral","context":"Yaş sorarken; yaş 'sahip olunur' (ter)."},"examples":[{"text":"Quantos anos você tem? — Tenho vinte e cinco.","tr":"Kaç yaşındasın? — Yirmi beş."}]},
  {"id":"pt-daily-tchau","languageId":"pt","category":"daily","level":"A1","sourceText":"Tchau!","translations":{"tr":["hoşça kal","güle güle","bay bay"]},"details":{"register":"informal","context":"En yaygın veda sözü."},"examples":[{"text":"Tchau, até amanhã!","tr":"Hoşça kal, yarın görüşürüz!"}]},
