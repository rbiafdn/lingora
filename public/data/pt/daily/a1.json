  {"id":"pt-daily-ate-amanha","languageId":"pt","category":"daily","level":"A1","sourceText":"Até amanhã!","translations":{"tr":["yarın görüşürüz"]},"details":{"register":"neutral","context":"Ertesi gün görüşecekken."},"examples":[{"text":"Boa noite, até amanhã!","tr":"İyi geceler, yarın görüşürüz!"}]},
  {"id":"pt-daily-com-licenca","languageId":"pt","category":"daily","level":"A1","sourceText":"Com licença.","translations":{"tr":["müsaadenizle","izninizle","pardon"]},"details":{"register":"neutral","context":"Birinin önünden geçerken, bir yere girerken ya da sözü bölerken."},"examples":[{"text":"Com licença, posso passar?","tr":"Pardon, geçebilir miyim?"}]},
  {"id":"pt-daily-bem-vindo","languageId":"pt","category":"daily","level":"A1","sourceText":"Bem-vindo!","translations":{"tr":["hoş geldin","hoş geldiniz"]},"details":{"register":"neutral","context":"Gelen birini karşılarken; kadına 'bem-vinda', çoğula 'bem-vindos'."},"examples":[{"text":"Seja bem-vinda ao Brasil!","tr":"Brezilya'ya hoş geldin!"}]},
  {"id":"pt-daily-bom-apetite","languageId":"pt","category":"daily","level":"A1","sourceText":"Bom apetite!","translations":{"tr":["afiyet olsun"]},"details":{"register":"neutral","context":"Yemeğe başlayanlara."},"examples":[{"text":"O almoço está na mesa. Bom apetite!","tr":"Öğle yemeği masada. Afiyet olsun!"}]},
  {"id":"pt-daily-saude","languageId":"pt","category":"daily","level":"A1","sourceText":"Saúde!","translations":{"tr":["şerefe","çok yaşa"]},"details":{"register":"neutral","context":"Kadeh tokuştururken ve biri hapşırınca."},"examples":[{"text":"Atchim! — Saúde!","tr":"Hapşu! — Çok yaşa!"}]},
  {"id":"pt-daily-parabens","languageId":"pt","category":"daily","level":"A1","sourceText":"Parabéns!","translations":{"tr":["tebrikler","doğum günün kutlu olsun"]},"details":{"register":"neutral","context":"Başarı ve doğum günlerinde."},"examples":[{"text":"Você passou na prova? Parabéns!","tr":"Sınavı geçtin mi? Tebrikler!"}]},
