  {"id":"pt-daily-eu-te-amo","languageId":"pt","category":"daily","level":"A1","sourceText":"Eu te amo.","translations":{"tr":["seni seviyorum"]},"details":{"register":"neutral","context":"Sevgiliye ve aileye."},"examples":[{"text":"Boa noite, filho. Eu te amo.","tr":"İyi geceler oğlum. Seni seviyorum."}]},
  {"id":"pt-daily-alo","languageId":"pt","category":"daily","level":"A1","sourceText":"Alô?","translations":{"tr":["alo?"]},"details":{"register":"neutral","context":"Telefonu açarken."},"examples":[{"text":"Alô? Quem fala?","tr":"Alo? Kim arıyor?"}]}
