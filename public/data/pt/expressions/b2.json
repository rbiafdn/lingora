[
  {"id":"pt-expr-isto-e","languageId":"pt","category":"expressions","level":"B2","sourceText":"isto é","translations":{"tr":["yani","diğer bir deyişle"]},"tags":["discourse-marker"],"details":{"usage":"Ou seja'nın daha resmî, yazı diline yakın hâli.","register":"formal"},"examples":[{"text":"O prazo é curto, isto é, temos só dois dias.","tr":"Süre kısa, yani sadece iki günümüz var."}]},
  {"id":"pt-expr-mesmo-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"mesmo que","translations":{"tr":["…se bile","…sa da"]},"tags":["discourse-marker"],"details":{"usage":"Ardından subjuntivo gelir: mesmo que chova.","register":"neutral"},"examples":[{"text":"Vou sair, mesmo que chova.","tr":"Yağmur yağsa bile çıkacağım."}]},
  {"id":"pt-expr-a-respeito-de","languageId":"pt","category":"expressions","level":"B2","sourceText":"a respeito de","translations":{"tr":["…hakkında","…konusunda"]},"details":{"register":"formal"},"examples":[{"text":"Precisamos conversar a respeito do seu desempenho.","tr":"Performansın hakkında konuşmamız gerekiyor."}]},
  {"id":"pt-expr-quanto-a","languageId":"pt","category":"expressions","level":"B2","sourceText":"quanto a","translations":{"tr":["…e gelince","…konusunda"]},"details":{"register":"formal"},"examples":[{"text":"Quanto ao preço, ainda vamos decidir.","tr":"Fiyata gelince, henüz karar vereceğiz."}]},
  {"id":"pt-expr-em-termos-de","languageId":"pt","category":"expressions","level":"B2","sourceText":"em termos de","translations":{"tr":["…bakımından","…açısından"]},"details":{"register":"neutral"},"examples":[{"text":"Em termos de preço, essa é a melhor opção.","tr":"Fiyat bakımından en iyi seçenek bu."}]},
  {"id":"pt-expr-caso-contrario","languageId":"pt","category":"expressions","level":"B2","sourceText":"caso contrário","translations":{"tr":["aksi takdirde","yoksa"]},"details":{"register":"neutral"},"examples":[{"text":"Saia agora; caso contrário, vai perder o trem.","tr":"Hemen çık; yoksa treni kaçıracaksın."}]},
  {"id":"pt-expr-a-nao-ser-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"a não ser que","translations":{"tr":["…medikçe","…mazsa"]},"details":{"usage":"Subjuntivo ister: a não ser que chova.","register":"neutral"},"examples":[{"text":"Vamos à praia, a não ser que chova.","tr":"Yağmur yağmazsa plaja gideriz."}]},
  {"id":"pt-expr-desde-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"desde que","translations":{"tr":["…mek şartıyla","…den beri"]},"details":{"usage":"Subjuntivo ile 'şartıyla'; indicativo ile 'den beri'.","register":"neutral"},"examples":[{"text":"Pode sair, desde que volte cedo.","tr":"Erken dönmek şartıyla çıkabilirsin."}]},
  {"id":"pt-expr-visto-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"visto que","translations":{"tr":["…dığından","…dığı için"]},"details":{"register":"formal"},"examples":[{"text":"Visto que ninguém se opôs, a proposta foi aprovada.","tr":"Kimse itiraz etmediği için öneri kabul edildi."}]},
  {"id":"pt-expr-uma-vez-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"uma vez que","translations":{"tr":["…dığından","madem ki"]},"details":{"usage":"Sebep bildirir; yazıda sık.","register":"formal"},"examples":[{"text":"Uma vez que o voo atrasou, perdemos a conexão.","tr":"Uçuş geciktiği için aktarmayı kaçırdık."}]},
  {"id":"pt-expr-a-fim-de","languageId":"pt","category":"expressions","level":"B2","sourceText":"a fim de","translations":{"tr":["…mek amacıyla","…mek için"]},"details":{"usage":"Resmî; 'estar a fim de' (canı istemek) ile karıştırma.","register":"formal"},"examples":[{"text":"Estudou muito a fim de passar no concurso.","tr":"Sınavı geçmek amacıyla çok çalıştı."}]},
  {"id":"pt-expr-de-modo-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"de modo que","translations":{"tr":["öyle ki","bu yüzden"]},"details":{"register":"neutral"},"examples":[{"text":"Choveu muito, de modo que o jogo foi adiado.","tr":"Çok yağmur yağdı, bu yüzden maç ertelendi."}]},
  {"id":"pt-expr-sendo-assim","languageId":"pt","category":"expressions","level":"B2","sourceText":"sendo assim","translations":{"tr":["bu durumda","öyleyse"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Ninguém pode ir. Sendo assim, vamos cancelar.","tr":"Kimse gidemiyor. Bu durumda iptal edelim."}]},
  {"id":"pt-expr-logo-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"logo que","translations":{"tr":["…ir …mez"]},"details":{"usage":"Assim que ile aynı, biraz daha resmî.","register":"formal"},"examples":[{"text":"Logo que soube da notícia, ele veio.","tr":"Haberi duyar duymaz geldi."}]},
  {"id":"pt-expr-de-uma-vez-por-todas","languageId":"pt","category":"expressions","level":"B2","sourceText":"de uma vez por todas","translations":{"tr":["ilk ve son kez","kesin olarak"]},"details":{"register":"neutral"},"examples":[{"text":"Vamos resolver isso de uma vez por todas.","tr":"Bu işi kesin olarak çözelim."}]},
  {"id":"pt-expr-a-toa","languageId":"pt","category":"expressions","level":"B2","sourceText":"à toa","translations":{"tr":["boşuna","boş boş","nedensiz"]},"details":{"register":"informal"},"examples":[{"text":"Fiquei à toa o dia inteiro.","tr":"Bütün gün boş boş oturdum."}]},
  {"id":"pt-expr-nao-e-a-toa-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"não é à toa que","translations":{"tr":["boşuna değil ki","…mesine şaşmamalı"]},"details":{"register":"neutral"},"examples":[{"text":"Não é à toa que ele está cansado: trabalhou 12 horas.","tr":"Yorgun olmasına şaşmamalı: 12 saat çalıştı."}]},
  {"id":"pt-expr-as-pressas","languageId":"pt","category":"expressions","level":"B2","sourceText":"às pressas","translations":{"tr":["aceleyle","telaşla"]},"details":{"register":"neutral"},"examples":[{"text":"Saímos às pressas e esqueci a chave.","tr":"Aceleyle çıktık ve anahtarı unuttum."}]},
  {"id":"pt-expr-de-cabeca","languageId":"pt","category":"expressions","level":"B2","sourceText":"de cabeça","translations":{"tr":["ezbere","akıldan"]},"details":{"usage":"Saber de cabeça = ezbere bilmek.","register":"neutral"},"examples":[{"text":"Sei o número dela de cabeça.","tr":"Onun numarasını ezbere biliyorum."}]},
  {"id":"pt-expr-na-marra","languageId":"pt","category":"expressions","level":"B2","sourceText":"na marra","translations":{"tr":["zorla","ne olursa olsun"]},"details":{"register":"informal"},"examples":[{"text":"Ele entrou na marra.","tr":"Zorla içeri girdi."}]},
  {"id":"pt-expr-ca-entre-nos","languageId":"pt","category":"expressions","level":"B2","sourceText":"cá entre nós","translations":{"tr":["aramızda kalsın","laf aramızda"]},"details":{"register":"informal"},"examples":[{"text":"Cá entre nós, o chefe não sabe de nada.","tr":"Laf aramızda, patronun hiçbir şeyden haberi yok."}]},
  {"id":"pt-expr-ao-que-parece","languageId":"pt","category":"expressions","level":"B2","sourceText":"ao que parece","translations":{"tr":["görünüşe göre","anlaşılan"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Ao que parece, a reunião foi cancelada.","tr":"Görünüşe göre toplantı iptal edilmiş."}]},
  {"id":"pt-expr-tudo-indica-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"tudo indica que","translations":{"tr":["her şey …dığını gösteriyor","büyük ihtimalle"]},"details":{"register":"neutral"},"examples":[{"text":"Tudo indica que vai chover amanhã.","tr":"Her şey yarın yağmur yağacağını gösteriyor."}]},
  {"id":"pt-expr-segundo","languageId":"pt","category":"expressions","level":"B2","sourceText":"segundo","translations":{"tr":["…e göre"]},"details":{"usage":"Kaynak bildirir: segundo o jornal = gazeteye göre.","register":"formal"},"examples":[{"text":"Segundo a polícia, ninguém se feriu.","tr":"Polise göre kimse yaralanmadı."}]},
  {"id":"pt-expr-a-meu-ver","languageId":"pt","category":"expressions","level":"B2","sourceText":"a meu ver","translations":{"tr":["bence","kanımca"]},"tags":["opinion"],"details":{"register":"formal"},"examples":[{"text":"A meu ver, precisamos de mais tempo.","tr":"Kanımca daha fazla zamana ihtiyacımız var."}]},
  {"id":"pt-expr-eu-diria-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"eu diria que","translations":{"tr":["…derdim","diyebilirim ki"]},"tags":["opinion"],"details":{"register":"neutral"},"examples":[{"text":"Eu diria que ele tem uns quarenta anos.","tr":"Kırk yaşlarında derdim."}]},
  {"id":"pt-expr-que-eu-saiba","languageId":"pt","category":"expressions","level":"B2","sourceText":"que eu saiba","translations":{"tr":["bildiğim kadarıyla","benim bildiğim"]},"details":{"usage":"Subjuntivo içeren sabit kalıp; genelde olumsuz cümlede.","register":"neutral"},"examples":[{"text":"Que eu saiba, ele não é casado.","tr":"Bildiğim kadarıyla evli değil."}]},
  {"id":"pt-expr-o-fato-e-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"o fato é que","translations":{"tr":["gerçek şu ki","işin özü"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"O fato é que não temos dinheiro.","tr":"Gerçek şu ki paramız yok."}]},
  {"id":"pt-expr-voltando-ao-assunto","languageId":"pt","category":"expressions","level":"B2","sourceText":"voltando ao assunto","translations":{"tr":["konumuza dönersek"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Voltando ao assunto, quem vai fazer o relatório?","tr":"Konumuza dönersek, raporu kim yazacak?"}]},
  {"id":"pt-expr-por-sinal","languageId":"pt","category":"expressions","level":"B2","sourceText":"por sinal","translations":{"tr":["bu arada","hatta"]},"tags":["discourse-marker"],"details":{"usage":"Aliás'a yakın; ek bir yorum katar.","register":"neutral"},"examples":[{"text":"O bolo, por sinal, estava ótimo.","tr":"Pasta da bu arada harikaydı."}]},
  {"id":"pt-expr-ainda-por-cima","languageId":"pt","category":"expressions","level":"B2","sourceText":"ainda por cima","translations":{"tr":["üstüne üstlük","bir de üstelik"]},"details":{"usage":"Genelde olumsuz bir şeye ek yaparken.","register":"informal"},"examples":[{"text":"Cheguei atrasado e ainda por cima esqueci o crachá.","tr":"Geç kaldım, üstüne üstlük kartımı unuttum."}]},
  {"id":"pt-expr-quanto-mais-mais","languageId":"pt","category":"expressions","level":"B2","sourceText":"quanto mais … mais","translations":{"tr":["ne kadar … o kadar"]},"details":{"register":"neutral"},"examples":[{"text":"Quanto mais eu estudo, mais eu aprendo.","tr":"Ne kadar çalışırsam o kadar öğreniyorum."}]},
  {"id":"pt-expr-desde-entao","languageId":"pt","category":"expressions","level":"B2","sourceText":"desde então","translations":{"tr":["o zamandan beri"]},"details":{"register":"neutral"},"examples":[{"text":"Mudei para cá em 2015 e desde então moro aqui.","tr":"2015'te buraya taşındım ve o zamandan beri burada yaşıyorum."}]},
  {"id":"pt-expr-ate-entao","languageId":"pt","category":"expressions","level":"B2","sourceText":"até então","translations":{"tr":["o zamana kadar","o güne dek"]},"details":{"register":"neutral"},"examples":[{"text":"Até então, eu nunca tinha visto o mar.","tr":"O zamana kadar denizi hiç görmemiştim."}]},
  {"id":"pt-expr-de-la-pra-ca","languageId":"pt","category":"expressions","level":"B2","sourceText":"de lá pra cá","translations":{"tr":["o zamandan bu yana","o günden beri"]},"details":{"register":"informal"},"examples":[{"text":"De lá pra cá, muita coisa mudou.","tr":"O zamandan bu yana çok şey değişti."}]},
  {"id":"pt-expr-a-curto-prazo","languageId":"pt","category":"expressions","level":"B2","sourceText":"a curto prazo","translations":{"tr":["kısa vadede"]},"details":{"register":"neutral"},"examples":[{"text":"A curto prazo, a solução funciona.","tr":"Kısa vadede çözüm işe yarıyor."}]},
  {"id":"pt-expr-a-longo-prazo","languageId":"pt","category":"expressions","level":"B2","sourceText":"a longo prazo","translations":{"tr":["uzun vadede"]},"details":{"register":"neutral"},"examples":[{"text":"A longo prazo, vale mais a pena investir.","tr":"Uzun vadede yatırım yapmak daha mantıklı."}]},
  {"id":"pt-expr-de-imediato","languageId":"pt","category":"expressions","level":"B2","sourceText":"de imediato","translations":{"tr":["hemen","derhal"]},"details":{"register":"formal"},"examples":[{"text":"O problema foi resolvido de imediato.","tr":"Sorun derhal çözüldü."}]},
  {"id":"pt-expr-de-cara","languageId":"pt","category":"expressions","level":"B2","sourceText":"de cara","translations":{"tr":["hemen","ilk bakışta","ilk anda"]},"details":{"register":"informal"},"examples":[{"text":"Gostei dela de cara.","tr":"Ondan ilk anda hoşlandım."}]},
  {"id":"pt-expr-de-uma-hora-pra-outra","languageId":"pt","category":"expressions","level":"B2","sourceText":"de uma hora pra outra","translations":{"tr":["bir anda","birdenbire"]},"details":{"register":"informal"},"examples":[{"text":"O tempo mudou de uma hora pra outra.","tr":"Hava bir anda değişti."}]},
  {"id":"pt-expr-volta-e-meia","languageId":"pt","category":"expressions","level":"B2","sourceText":"volta e meia","translations":{"tr":["sık sık","arada bir"]},"details":{"register":"informal"},"examples":[{"text":"Volta e meia ele aparece aqui.","tr":"Arada bir buraya uğruyor."}]},
  {"id":"pt-expr-de-modo-geral","languageId":"pt","category":"expressions","level":"B2","sourceText":"de modo geral","translations":{"tr":["genel olarak"]},"details":{"register":"neutral"},"examples":[{"text":"De modo geral, o evento foi um sucesso.","tr":"Genel olarak etkinlik başarılıydı."}]},
  {"id":"pt-expr-de-certa-forma","languageId":"pt","category":"expressions","level":"B2","sourceText":"de certa forma","translations":{"tr":["bir bakıma","bir şekilde"]},"details":{"register":"neutral"},"examples":[{"text":"De certa forma, você tem razão.","tr":"Bir bakıma haklısın."}]},
  {"id":"pt-expr-ate-certo-ponto","languageId":"pt","category":"expressions","level":"B2","sourceText":"até certo ponto","translations":{"tr":["bir yere kadar","belli bir ölçüde"]},"details":{"register":"neutral"},"examples":[{"text":"Concordo com você até certo ponto.","tr":"Sana bir yere kadar katılıyorum."}]},
  {"id":"pt-expr-em-grande-parte","languageId":"pt","category":"expressions","level":"B2","sourceText":"em grande parte","translations":{"tr":["büyük ölçüde","büyük oranda"]},"details":{"register":"neutral"},"examples":[{"text":"O sucesso se deve em grande parte à equipe.","tr":"Başarı büyük ölçüde ekip sayesinde."}]},
  {"id":"pt-expr-no-fundo","languageId":"pt","category":"expressions","level":"B2","sourceText":"no fundo","translations":{"tr":["aslında","içten içe","özünde"]},"details":{"register":"neutral"},"examples":[{"text":"No fundo, ele é uma pessoa boa.","tr":"Özünde iyi bir insan."}]},
  {"id":"pt-expr-a-principio","languageId":"pt","category":"expressions","level":"B2","sourceText":"a princípio","translations":{"tr":["başlangıçta","ilk başta"]},"details":{"usage":"'Em princípio' (prensipte, kural olarak) ile karıştırma.","register":"neutral"},"examples":[{"text":"A princípio, achei que era brincadeira.","tr":"İlk başta şaka sandım."}]},
  {"id":"pt-expr-em-principio","languageId":"pt","category":"expressions","level":"B2","sourceText":"em princípio","translations":{"tr":["prensipte","ilke olarak"]},"details":{"usage":"'A princípio' (başlangıçta) ile karıştırma.","register":"formal"},"examples":[{"text":"Em princípio, a ideia é boa.","tr":"Prensipte fikir iyi."}]},
  {"id":"pt-expr-para-concluir","languageId":"pt","category":"expressions","level":"B2","sourceText":"para concluir","translations":{"tr":["sonuç olarak","son olarak"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Para concluir, agradeço a atenção de todos.","tr":"Son olarak hepinize ilginiz için teşekkür ederim."}]},
  {"id":"pt-expr-antes-de-mais-nada","languageId":"pt","category":"expressions","level":"B2","sourceText":"antes de mais nada","translations":{"tr":["her şeyden önce"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Antes de mais nada, bem-vindos!","tr":"Her şeyden önce hoş geldiniz!"}]},
  {"id":"pt-expr-acima-de-tudo","languageId":"pt","category":"expressions","level":"B2","sourceText":"acima de tudo","translations":{"tr":["her şeyden önce","her şeyin üstünde"]},"details":{"register":"neutral"},"examples":[{"text":"Acima de tudo, seja honesto.","tr":"Her şeyden önce dürüst ol."}]},
  {"id":"pt-expr-vale-lembrar-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"vale lembrar que","translations":{"tr":["hatırlatmakta fayda var","unutmayalım ki"]},"details":{"register":"neutral"},"examples":[{"text":"Vale lembrar que a loja fecha cedo hoje.","tr":"Dükkânın bugün erken kapandığını hatırlatmakta fayda var."}]},
  {"id":"pt-expr-e-bem-provavel-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"é bem provável que","translations":{"tr":["büyük ihtimalle","kuvvetle muhtemel"]},"details":{"usage":"Subjuntivo ister.","register":"neutral"},"examples":[{"text":"É bem provável que chova à tarde.","tr":"Büyük ihtimalle öğleden sonra yağmur yağacak."}]},
  {"id":"pt-expr-quem-dera","languageId":"pt","category":"expressions","level":"B2","sourceText":"quem dera","translations":{"tr":["keşke","ah bir olsa"]},"details":{"usage":"Gerçekleşmesi zor dilekler için.","register":"neutral"},"examples":[{"text":"Quem dera eu tivesse férias agora!","tr":"Keşke şimdi tatilde olsaydım!"}]},
  {"id":"pt-expr-vamos-supor-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"vamos supor que","translations":{"tr":["diyelim ki","farz edelim ki"]},"details":{"register":"neutral"},"examples":[{"text":"Vamos supor que você ganhe na loteria.","tr":"Diyelim ki piyangoyu kazandın."}]},
  {"id":"pt-expr-digamos-que","languageId":"pt","category":"expressions","level":"B2","sourceText":"digamos que","translations":{"tr":["diyelim ki","şöyle diyelim"]},"details":{"register":"neutral"},"examples":[{"text":"Digamos que ele não é muito pontual.","tr":"Şöyle diyelim, pek dakik biri değil."}]},
  {"id":"pt-expr-longe-disso","languageId":"pt","category":"expressions","level":"B2","sourceText":"longe disso","translations":{"tr":["ne gezer","tam tersine","ondan çok uzak"]},"details":{"register":"neutral"},"examples":[{"text":"Ele não é rico, longe disso.","tr":"Zengin değil, ne gezer."}]},
  {"id":"pt-expr-de-forma-alguma","languageId":"pt","category":"expressions","level":"B2","sourceText":"de forma alguma","translations":{"tr":["asla","hiçbir şekilde"]},"details":{"usage":"De jeito nenhum'un daha resmî karşılığı.","register":"formal"},"examples":[{"text":"De forma alguma vamos aceitar isso.","tr":"Bunu asla kabul etmeyeceğiz."}]},
  {"id":"pt-expr-em-ultimo-caso","languageId":"pt","category":"expressions","level":"B2","sourceText":"em último caso","translations":{"tr":["son çare olarak","olmadı"]},"details":{"register":"neutral"},"examples":[{"text":"Em último caso, você pode dormir aqui.","tr":"Olmadı burada yatabilirsin."}]},
  {"id":"pt-expr-de-um-jeito-ou-de-outro","languageId":"pt","category":"expressions","level":"B2","sourceText":"de um jeito ou de outro","translations":{"tr":["öyle ya da böyle","bir şekilde"]},"details":{"register":"neutral"},"examples":[{"text":"De um jeito ou de outro, a gente resolve.","tr":"Öyle ya da böyle hallederiz."}]},
  {"id":"pt-expr-no-mais","languageId":"pt","category":"expressions","level":"B2","sourceText":"no mais","translations":{"tr":["onun dışında","geri kalanı"]},"details":{"usage":"Brezilya'da mesaj sonunda 'başka da bir şey yok' anlamında.","register":"informal"},"examples":[{"text":"O quarto é pequeno; no mais, tudo ótimo.","tr":"Oda küçük; onun dışında her şey harika."}]},
  {"id":"pt-expr-pra-variar","languageId":"pt","category":"expressions","level":"B2","sourceText":"pra variar","translations":{"tr":["her zamanki gibi (ironik)","değişiklik olsun diye"]},"details":{"usage":"Çoğu zaman alaycı: 'yine aynı şey oldu'.","register":"informal"},"examples":[{"text":"O trem atrasou, pra variar.","tr":"Tren yine gecikti, ne sürpriz."}]},
  {"id":"pt-expr-como-de-costume","languageId":"pt","category":"expressions","level":"B2","sourceText":"como de costume","translations":{"tr":["âdet olduğu üzere","her zamanki gibi"]},"details":{"register":"neutral"},"examples":[{"text":"Como de costume, almoçamos na casa da avó.","tr":"Her zamanki gibi öğle yemeğini büyükannemde yedik."}]},
  {"id":"pt-expr-devido-a","languageId":"pt","category":"expressions","level":"B2","sourceText":"devido a","translations":{"tr":["…nedeniyle","…den dolayı"]},"details":{"register":"formal"},"examples":[{"text":"O voo foi cancelado devido ao mau tempo.","tr":"Uçuş kötü hava nedeniyle iptal edildi."}]},
  {"id":"pt-expr-por-conta-de","languageId":"pt","category":"expressions","level":"B2","sourceText":"por conta de","translations":{"tr":["…yüzünden","…nedeniyle"]},"details":{"usage":"Brezilya konuşmasında 'por causa de' yerine sık.","register":"informal"},"examples":[{"text":"Cheguei tarde por conta do trânsito.","tr":"Trafik yüzünden geç kaldım."}]},
  {"id":"pt-expr-por-meio-de","languageId":"pt","category":"expressions","level":"B2","sourceText":"por meio de","translations":{"tr":["…yoluyla","…vasıtasıyla"]},"details":{"register":"formal"},"examples":[{"text":"O pagamento pode ser feito por meio de Pix.","tr":"Ödeme Pix yoluyla yapılabilir."}]},
  {"id":"pt-expr-ao-inves-de","languageId":"pt","category":"expressions","level":"B2","sourceText":"ao invés de","translations":{"tr":["…yerine","…in aksine"]},"details":{"usage":"Normatif olarak 'tersine' demek; konuşmada 'em vez de' yerine de kullanılır.","register":"neutral"},"examples":[{"text":"Ao invés de reclamar, faça alguma coisa.","tr":"Şikâyet etmek yerine bir şey yap."}]},
  {"id":"pt-expr-com-todo-o-respeito","languageId":"pt","category":"expressions","level":"B2","sourceText":"com todo o respeito","translations":{"tr":["saygısızlık etmek istemem ama","tüm saygımla"]},"tags":["politeness"],"details":{"register":"formal"},"examples":[{"text":"Com todo o respeito, o senhor está enganado.","tr":"Tüm saygımla, yanılıyorsunuz efendim."}]},
  {"id":"pt-expr-segue-em-anexo","languageId":"pt","category":"expressions","level":"B2","sourceText":"segue em anexo","translations":{"tr":["ekte sunulmuştur","ekte gönderiyorum"]},"details":{"usage":"İş e-postalarında çok yaygın kalıp.","register":"formal"},"examples":[{"text":"Segue em anexo o contrato assinado.","tr":"İmzalı sözleşme ektedir."}]},
