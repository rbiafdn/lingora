[
  {"id":"pt-expr-alias","languageId":"pt","category":"expressions","level":"B1","sourceText":"aliás","translations":{"tr":["bu arada","hatta","daha doğrusu"]},"tags":["discourse-marker"],"details":{"usage":"Ek bilgi verir ya da söyleneni düzeltir.","register":"neutral"},"examples":[{"text":"Ele é ótimo cozinheiro. Aliás, o jantar foi ele que fez.","tr":"Harika bir aşçı. Hatta akşam yemeğini o yaptı."}]},
  {"id":"pt-expr-de-fato","languageId":"pt","category":"expressions","level":"B1","sourceText":"de fato","translations":{"tr":["gerçekten","nitekim","hakikaten"]},"tags":["discourse-marker"],"details":{"usage":"Söyleneni doğrular; yazıda ve resmî konuşmada sık.","register":"neutral"},"examples":[{"text":"Ele disse que era difícil e, de fato, era.","tr":"Zor olduğunu söyledi, nitekim de zordu."}]},
  {"id":"pt-expr-pelo-jeito","languageId":"pt","category":"expressions","level":"B1","sourceText":"pelo jeito","translations":{"tr":["görünüşe bakılırsa","anlaşılan"]},"tags":["discourse-marker"],"details":{"usage":"Gözleme dayalı tahmin; konuşma dilinde.","register":"informal"},"examples":[{"text":"Pelo jeito, ninguém vem hoje.","tr":"Anlaşılan bugün kimse gelmiyor."}]},
  {"id":"pt-expr-pelo-visto","languageId":"pt","category":"expressions","level":"B1","sourceText":"pelo visto","translations":{"tr":["görünüşe göre","anlaşılan"]},"tags":["discourse-marker"],"details":{"usage":"Pelo jeito ile hemen hemen aynı, biraz daha nötr.","register":"neutral"},"examples":[{"text":"Pelo visto você não dormiu bem.","tr":"Görünüşe göre iyi uyumamışsın."}]},
  {"id":"pt-expr-enfim","languageId":"pt","category":"expressions","level":"B1","sourceText":"enfim","translations":{"tr":["neyse","kısacası","sonunda"]},"tags":["discourse-marker"],"details":{"usage":"Konuşmada çoğu zaman lafı toparlamak için 'neyse' anlamında.","register":"neutral"},"examples":[{"text":"Enfim, não deu certo e eu voltei pra casa.","tr":"Neyse, olmadı ve eve döndüm."}]},
  {"id":"pt-expr-ate-que-enfim","languageId":"pt","category":"expressions","level":"B1","sourceText":"até que enfim","translations":{"tr":["nihayet","sonunda"]},"details":{"usage":"Uzun beklemenin sonunda sabırsızlıkla söylenir.","register":"informal"},"examples":[{"text":"Até que enfim você chegou!","tr":"Nihayet geldin!"}]},
  {"id":"pt-expr-ou-seja","languageId":"pt","category":"expressions","level":"B1","sourceText":"ou seja","translations":{"tr":["yani","başka bir deyişle"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Ele não respondeu, ou seja, não quer ir.","tr":"Cevap vermedi, yani gitmek istemiyor."}]},
  {"id":"pt-expr-em-outras-palavras","languageId":"pt","category":"expressions","level":"B1","sourceText":"em outras palavras","translations":{"tr":["başka bir deyişle","kısacası"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Em outras palavras, o projeto foi cancelado.","tr":"Başka bir deyişle, proje iptal edildi."}]},
  {"id":"pt-expr-ou-melhor","languageId":"pt","category":"expressions","level":"B1","sourceText":"ou melhor","translations":{"tr":["daha doğrusu","hayır yani"]},"tags":["discourse-marker"],"details":{"usage":"Az önce söyleneni düzeltir.","register":"neutral"},"examples":[{"text":"Te vejo amanhã, ou melhor, depois de amanhã.","tr":"Yarın görüşürüz, daha doğrusu öbür gün."}]},
  {"id":"pt-expr-apesar-de","languageId":"pt","category":"expressions","level":"B1","sourceText":"apesar de","translations":{"tr":["…e rağmen"]},"tags":["discourse-marker"],"details":{"usage":"Ardından isim ya da mastar: apesar da chuva, apesar de estar cansado.","register":"neutral"},"examples":[{"text":"Apesar da chuva, o show continuou.","tr":"Yağmura rağmen konser devam etti."}]},
  {"id":"pt-expr-apesar-disso","languageId":"pt","category":"expressions","level":"B1","sourceText":"apesar disso","translations":{"tr":["buna rağmen","yine de"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"O salário é baixo. Apesar disso, gosto do trabalho.","tr":"Maaş düşük. Buna rağmen işi seviyorum."}]},
  {"id":"pt-expr-no-entanto","languageId":"pt","category":"expressions","level":"B1","sourceText":"no entanto","translations":{"tr":["ancak","bununla birlikte"]},"tags":["discourse-marker"],"details":{"usage":"Daha çok yazıda; konuşmada 'mas' ya da 'só que' tercih edilir.","register":"formal"},"examples":[{"text":"O plano é bom; no entanto, é caro.","tr":"Plan iyi; ancak pahalı."}]},
  {"id":"pt-expr-so-que","languageId":"pt","category":"expressions","level":"B1","sourceText":"só que","translations":{"tr":["ama","yalnız","şu var ki"]},"tags":["discourse-marker"],"details":{"usage":"Konuşmada 'mas' yerine çok kullanılır.","register":"informal"},"examples":[{"text":"Eu queria ir, só que não tenho dinheiro.","tr":"Gitmek isterdim, yalnız param yok."}]},
  {"id":"pt-expr-ao-mesmo-tempo","languageId":"pt","category":"expressions","level":"B1","sourceText":"ao mesmo tempo","translations":{"tr":["aynı zamanda","bir yandan da"]},"details":{"register":"neutral"},"examples":[{"text":"Ele estuda e trabalha ao mesmo tempo.","tr":"Hem okuyor hem çalışıyor."}]},
  {"id":"pt-expr-por-um-lado","languageId":"pt","category":"expressions","level":"B1","sourceText":"por um lado","translations":{"tr":["bir yandan","bir taraftan"]},"tags":["discourse-marker"],"details":{"usage":"Genelde 'por outro lado' ile birlikte.","register":"neutral"},"examples":[{"text":"Por um lado é perto, por outro é caro.","tr":"Bir yandan yakın, öte yandan pahalı."}]},
  {"id":"pt-expr-por-outro-lado","languageId":"pt","category":"expressions","level":"B1","sourceText":"por outro lado","translations":{"tr":["öte yandan","diğer taraftan"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"A cidade é linda; por outro lado, é muito cara.","tr":"Şehir çok güzel; öte yandan çok pahalı."}]},
  {"id":"pt-expr-de-qualquer-forma","languageId":"pt","category":"expressions","level":"B1","sourceText":"de qualquer forma","translations":{"tr":["her halükârda","neyse","ne olursa olsun"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"De qualquer forma, obrigado pela ajuda.","tr":"Her halükârda yardımın için teşekkürler."}]},
  {"id":"pt-expr-de-qualquer-jeito","languageId":"pt","category":"expressions","level":"B1","sourceText":"de qualquer jeito","translations":{"tr":["nasıl olursa olsun","her türlü","baştan savma"]},"details":{"usage":"Konuşmada; 'özensizce' anlamı da var.","register":"informal"},"examples":[{"text":"Ele fez o trabalho de qualquer jeito.","tr":"İşi baştan savma yaptı."}]},
  {"id":"pt-expr-em-primeiro-lugar","languageId":"pt","category":"expressions","level":"B1","sourceText":"em primeiro lugar","translations":{"tr":["ilk olarak","her şeyden önce"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Em primeiro lugar, quero agradecer a todos.","tr":"İlk olarak herkese teşekkür etmek istiyorum."}]},
  {"id":"pt-expr-para-comecar","languageId":"pt","category":"expressions","level":"B1","sourceText":"para começar","translations":{"tr":["başlangıç olarak","bir kere"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Para começar, você nem me avisou!","tr":"Bir kere bana haber bile vermedin!"}]},
  {"id":"pt-expr-em-seguida","languageId":"pt","category":"expressions","level":"B1","sourceText":"em seguida","translations":{"tr":["ardından","sonra"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Misture a farinha e, em seguida, os ovos.","tr":"Unu karıştırın, ardından yumurtaları ekleyin."}]},
  {"id":"pt-expr-por-fim","languageId":"pt","category":"expressions","level":"B1","sourceText":"por fim","translations":{"tr":["son olarak","sonunda"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Por fim, gostaria de dizer que foi um prazer.","tr":"Son olarak bunun bir zevk olduğunu söylemek isterim."}]},
  {"id":"pt-expr-por-ultimo","languageId":"pt","category":"expressions","level":"B1","sourceText":"por último","translations":{"tr":["son olarak","en son"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Por último, desligue o computador.","tr":"Son olarak bilgisayarı kapatın."}]},
  {"id":"pt-expr-afinal-de-contas","languageId":"pt","category":"expressions","level":"B1","sourceText":"afinal de contas","translations":{"tr":["sonuçta","ne de olsa","nihayetinde"]},"tags":["discourse-marker"],"details":{"usage":"Kısaca 'afinal' da denir; soruda 'peki aslında' anlamı: Afinal, você vem?","register":"neutral"},"examples":[{"text":"Afinal de contas, ele é seu irmão.","tr":"Ne de olsa o senin kardeşin."}]},
  {"id":"pt-expr-pelo-contrario","languageId":"pt","category":"expressions","level":"B1","sourceText":"pelo contrário","translations":{"tr":["aksine","tam tersine"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Não estou triste; pelo contrário, estou feliz.","tr":"Üzgün değilim; aksine mutluyum."}]},
  {"id":"pt-expr-ao-contrario-de","languageId":"pt","category":"expressions","level":"B1","sourceText":"ao contrário de","translations":{"tr":["…in aksine","…den farklı olarak"]},"details":{"register":"neutral"},"examples":[{"text":"Ao contrário do irmão, ela é muito calma.","tr":"Kardeşinin aksine o çok sakin."}]},
  {"id":"pt-expr-em-relacao-a","languageId":"pt","category":"expressions","level":"B1","sourceText":"em relação a","translations":{"tr":["…ile ilgili olarak","…e göre"]},"details":{"register":"neutral"},"examples":[{"text":"Tenho uma dúvida em relação ao contrato.","tr":"Sözleşmeyle ilgili bir sorum var."}]},
  {"id":"pt-expr-no-caso-de","languageId":"pt","category":"expressions","level":"B1","sourceText":"no caso de","translations":{"tr":["…durumunda","…olursa"]},"details":{"register":"neutral"},"examples":[{"text":"No caso de incêndio, use a escada.","tr":"Yangın durumunda merdiveni kullanın."}]},
  {"id":"pt-expr-ja-que","languageId":"pt","category":"expressions","level":"B1","sourceText":"já que","translations":{"tr":["…dığına göre","madem"]},"details":{"register":"neutral"},"examples":[{"text":"Já que você está aqui, me ajuda.","tr":"Madem buradasın, bana yardım et."}]},
  {"id":"pt-expr-para-que","languageId":"pt","category":"expressions","level":"B1","sourceText":"para que","translations":{"tr":["…sın diye","…mesi için"]},"details":{"usage":"Subjuntivo ister: para que você entenda.","register":"neutral"},"examples":[{"text":"Vou explicar de novo para que todos entendam.","tr":"Herkes anlasın diye tekrar açıklayacağım."}]},
  {"id":"pt-expr-dessa-forma","languageId":"pt","category":"expressions","level":"B1","sourceText":"dessa forma","translations":{"tr":["bu şekilde","böylece"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Dessa forma, economizamos tempo.","tr":"Böylece zamandan tasarruf ediyoruz."}]},
  {"id":"pt-expr-assim-que","languageId":"pt","category":"expressions","level":"B1","sourceText":"assim que","translations":{"tr":["…ir …mez","…dığı anda"]},"details":{"register":"neutral"},"examples":[{"text":"Me liga assim que chegar.","tr":"Varır varmaz beni ara."}]},
  {"id":"pt-expr-enquanto-isso","languageId":"pt","category":"expressions","level":"B1","sourceText":"enquanto isso","translations":{"tr":["bu arada","o sırada"]},"details":{"register":"neutral"},"examples":[{"text":"Vou fazer o arroz; enquanto isso, você corta a salada.","tr":"Ben pilavı yapayım; bu arada sen salatayı doğra."}]},
  {"id":"pt-expr-de-vez","languageId":"pt","category":"expressions","level":"B1","sourceText":"de vez","translations":{"tr":["tamamen","temelli","kesin olarak"]},"details":{"register":"neutral"},"examples":[{"text":"Ele se mudou de vez para Portugal.","tr":"Temelli Portekiz'e taşındı."}]},
  {"id":"pt-expr-aos-poucos","languageId":"pt","category":"expressions","level":"B1","sourceText":"aos poucos","translations":{"tr":["yavaş yavaş","azar azar"]},"details":{"register":"neutral"},"examples":[{"text":"Aos poucos ela foi se acostumando.","tr":"Yavaş yavaş alıştı."}]},
  {"id":"pt-expr-de-proposito","languageId":"pt","category":"expressions","level":"B1","sourceText":"de propósito","translations":{"tr":["bilerek","kasten"]},"details":{"register":"neutral"},"examples":[{"text":"Ele não fez isso de propósito.","tr":"Bunu bilerek yapmadı."}]},
  {"id":"pt-expr-de-verdade","languageId":"pt","category":"expressions","level":"B1","sourceText":"de verdade","translations":{"tr":["gerçekten","cidden"]},"details":{"register":"neutral"},"examples":[{"text":"Você gostou de verdade?","tr":"Gerçekten beğendin mi?"}]},
  {"id":"pt-expr-pra-falar-a-verdade","languageId":"pt","category":"expressions","level":"B1","sourceText":"pra falar a verdade","translations":{"tr":["doğrusunu söylemek gerekirse","açıkçası"]},"tags":["opinion"],"details":{"register":"informal"},"examples":[{"text":"Pra falar a verdade, eu não li o livro.","tr":"Doğrusu kitabı okumadım."}]},
  {"id":"pt-expr-de-acordo-com","languageId":"pt","category":"expressions","level":"B1","sourceText":"de acordo com","translations":{"tr":["…e göre","…e uygun olarak"]},"details":{"register":"neutral"},"examples":[{"text":"De acordo com a previsão, vai fazer calor.","tr":"Tahmine göre hava sıcak olacak."}]},
  {"id":"pt-expr-do-meu-ponto-de-vista","languageId":"pt","category":"expressions","level":"B1","sourceText":"do meu ponto de vista","translations":{"tr":["benim bakış açıma göre","bence"]},"tags":["opinion"],"details":{"register":"neutral"},"examples":[{"text":"Do meu ponto de vista, a ideia é boa.","tr":"Bana göre fikir iyi."}]},
  {"id":"pt-expr-eu-discordo","languageId":"pt","category":"expressions","level":"B1","sourceText":"eu discordo","translations":{"tr":["katılmıyorum"]},"tags":["opinion"],"details":{"usage":"'Discordo de você' = sana katılmıyorum.","register":"neutral"},"examples":[{"text":"Desculpa, mas eu discordo.","tr":"Kusura bakma ama katılmıyorum."}]},
  {"id":"pt-expr-pelo-que-eu-sei","languageId":"pt","category":"expressions","level":"B1","sourceText":"pelo que eu sei","translations":{"tr":["bildiğim kadarıyla"]},"details":{"register":"neutral"},"examples":[{"text":"Pelo que eu sei, a loja abre às nove.","tr":"Bildiğim kadarıyla dükkân dokuzda açılıyor."}]},
  {"id":"pt-expr-se-nao-me-engano","languageId":"pt","category":"expressions","level":"B1","sourceText":"se não me engano","translations":{"tr":["yanılmıyorsam"]},"details":{"register":"neutral"},"examples":[{"text":"Se não me engano, a festa é sábado.","tr":"Yanılmıyorsam parti cumartesi."}]},
  {"id":"pt-expr-pelo-que-entendi","languageId":"pt","category":"expressions","level":"B1","sourceText":"pelo que entendi","translations":{"tr":["anladığım kadarıyla"]},"details":{"register":"neutral"},"examples":[{"text":"Pelo que entendi, a gente tem que pagar antes.","tr":"Anladığım kadarıyla önceden ödememiz gerekiyor."}]},
  {"id":"pt-expr-acontece-que","languageId":"pt","category":"expressions","level":"B1","sourceText":"acontece que","translations":{"tr":["mesele şu ki","işin aslı"]},"tags":["discourse-marker"],"details":{"usage":"Bir açıklama ya da bahane öncesi.","register":"neutral"},"examples":[{"text":"Acontece que eu perdi o ônibus.","tr":"Mesele şu ki otobüsü kaçırdım."}]},
  {"id":"pt-expr-o-problema-e-que","languageId":"pt","category":"expressions","level":"B1","sourceText":"o problema é que","translations":{"tr":["sorun şu ki"]},"details":{"register":"neutral"},"examples":[{"text":"O problema é que ninguém sabe a senha.","tr":"Sorun şu ki kimse şifreyi bilmiyor."}]},
  {"id":"pt-expr-e-o-seguinte","languageId":"pt","category":"expressions","level":"B1","sourceText":"é o seguinte","translations":{"tr":["mesele şu","şöyle ki"]},"tags":["discourse-marker"],"details":{"usage":"Açıklamaya başlarken; 'o negócio é o seguinte' daha samimi.","register":"informal"},"examples":[{"text":"É o seguinte: amanhã não tem aula.","tr":"Mesele şu: yarın ders yok."}]},
  {"id":"pt-expr-vale-a-pena","languageId":"pt","category":"expressions","level":"B1","sourceText":"vale a pena","translations":{"tr":["değer","zahmetine değer"]},"details":{"register":"neutral"},"examples":[{"text":"Vale a pena visitar o Pelourinho.","tr":"Pelourinho'yu görmeye değer."}]},
  {"id":"pt-expr-nao-adianta","languageId":"pt","category":"expressions","level":"B1","sourceText":"não adianta","translations":{"tr":["faydası yok","boşuna"]},"details":{"register":"neutral"},"examples":[{"text":"Não adianta chorar agora.","tr":"Şimdi ağlamanın faydası yok."}]},
  {"id":"pt-expr-nao-tem-jeito","languageId":"pt","category":"expressions","level":"B1","sourceText":"não tem jeito","translations":{"tr":["çaresi yok","olmaz"]},"details":{"register":"informal"},"examples":[{"text":"Não tem jeito, vamos ter que esperar.","tr":"Çaresi yok, beklemek zorundayız."}]},
  {"id":"pt-expr-faz-sentido","languageId":"pt","category":"expressions","level":"B1","sourceText":"faz sentido","translations":{"tr":["mantıklı","anlamlı"]},"details":{"usage":"Olumsuzu: não faz sentido.","register":"neutral"},"examples":[{"text":"O que você disse faz sentido.","tr":"Söylediğin mantıklı."}]},
  {"id":"pt-expr-tem-tudo-a-ver","languageId":"pt","category":"expressions","level":"B1","sourceText":"tem tudo a ver","translations":{"tr":["çok uyuyor","tam alakalı"]},"details":{"register":"informal"},"examples":[{"text":"Esse vestido tem tudo a ver com você.","tr":"Bu elbise sana çok yakışıyor."}]},
  {"id":"pt-expr-nao-tem-nada-a-ver","languageId":"pt","category":"expressions","level":"B1","sourceText":"não tem nada a ver","translations":{"tr":["alakası yok","ilgisi yok"]},"details":{"usage":"Brezilya'da 'saçma' anlamında da kullanılır.","register":"informal"},"examples":[{"text":"Isso não tem nada a ver com o que eu disse.","tr":"Bunun benim dediğimle alakası yok."}]},
  {"id":"pt-expr-a-proposito","languageId":"pt","category":"expressions","level":"B1","sourceText":"a propósito","translations":{"tr":["bu arada","aklıma gelmişken"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"A propósito, você viu a Júlia?","tr":"Bu arada, Júlia'yı gördün mü?"}]},
  {"id":"pt-expr-por-falar-nisso","languageId":"pt","category":"expressions","level":"B1","sourceText":"por falar nisso","translations":{"tr":["söz açılmışken","laf buraya gelmişken"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Por falar nisso, quando é a sua viagem?","tr":"Söz açılmışken, seyahatin ne zaman?"}]},
  {"id":"pt-expr-mudando-de-assunto","languageId":"pt","category":"expressions","level":"B1","sourceText":"mudando de assunto","translations":{"tr":["konuyu değiştirirsek","neyse, başka bir konu"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Mudando de assunto, como está seu pai?","tr":"Konu değiştirmek gibi olmasın, baban nasıl?"}]},
  {"id":"pt-expr-inclusive","languageId":"pt","category":"expressions","level":"B1","sourceText":"inclusive","translations":{"tr":["hatta","dahil"]},"tags":["discourse-marker"],"details":{"usage":"Brezilya'da sıkça 'hatta' anlamında kullanılır.","register":"neutral"},"examples":[{"text":"Todo mundo veio, inclusive o diretor.","tr":"Herkes geldi, hatta müdür bile."}]},
  {"id":"pt-expr-nao-so-mas-tambem","languageId":"pt","category":"expressions","level":"B1","sourceText":"não só … mas também","translations":{"tr":["sadece … değil, aynı zamanda …"]},"details":{"register":"neutral"},"examples":[{"text":"Ela fala não só inglês, mas também alemão.","tr":"Sadece İngilizce değil, Almanca da konuşuyor."}]},
  {"id":"pt-expr-tanto-quanto","languageId":"pt","category":"expressions","level":"B1","sourceText":"tanto … quanto","translations":{"tr":["hem … hem de"]},"details":{"usage":"Tanto eu quanto ele = hem ben hem o.","register":"neutral"},"examples":[{"text":"Tanto o pai quanto a mãe trabalham.","tr":"Hem babası hem annesi çalışıyor."}]},
  {"id":"pt-expr-nem-nem","languageId":"pt","category":"expressions","level":"B1","sourceText":"nem … nem","translations":{"tr":["ne … ne"]},"details":{"register":"neutral"},"examples":[{"text":"Não quero nem chá nem café.","tr":"Ne çay istiyorum ne kahve."}]},
  {"id":"pt-expr-o-quanto-antes","languageId":"pt","category":"expressions","level":"B1","sourceText":"o quanto antes","translations":{"tr":["bir an önce","en kısa zamanda"]},"details":{"register":"neutral"},"examples":[{"text":"Precisamos resolver isso o quanto antes.","tr":"Bunu bir an önce çözmeliyiz."}]},
  {"id":"pt-expr-no-minimo","languageId":"pt","category":"expressions","level":"B1","sourceText":"no mínimo","translations":{"tr":["en az","en azından"]},"details":{"register":"neutral"},"examples":[{"text":"A viagem leva no mínimo três horas.","tr":"Yolculuk en az üç saat sürüyor."}]},
  {"id":"pt-expr-no-maximo","languageId":"pt","category":"expressions","level":"B1","sourceText":"no máximo","translations":{"tr":["en fazla","en çok"]},"details":{"register":"neutral"},"examples":[{"text":"Chego em vinte minutos, no máximo.","tr":"En fazla yirmi dakikaya oradayım."}]},
  {"id":"pt-expr-por-volta-de","languageId":"pt","category":"expressions","level":"B1","sourceText":"por volta de","translations":{"tr":["civarında","sularında"]},"details":{"usage":"Saat ve miktar için: por volta das oito.","register":"neutral"},"examples":[{"text":"Chegamos por volta das dez.","tr":"Saat on sularında vardık."}]},
  {"id":"pt-expr-cerca-de","languageId":"pt","category":"expressions","level":"B1","sourceText":"cerca de","translations":{"tr":["yaklaşık","aşağı yukarı"]},"details":{"usage":"'Acerca de' (hakkında) ile karıştırma.","register":"neutral"},"examples":[{"text":"Havia cerca de cem pessoas na festa.","tr":"Partide yaklaşık yüz kişi vardı."}]},
  {"id":"pt-expr-a-partir-de","languageId":"pt","category":"expressions","level":"B1","sourceText":"a partir de","translations":{"tr":["…den itibaren"]},"details":{"register":"neutral"},"examples":[{"text":"A partir de amanhã, a loja abre às oito.","tr":"Yarından itibaren dükkân sekizde açılıyor."}]},
  {"id":"pt-expr-em-breve","languageId":"pt","category":"expressions","level":"B1","sourceText":"em breve","translations":{"tr":["yakında","kısa süre içinde"]},"details":{"register":"neutral"},"examples":[{"text":"O filme estreia em breve.","tr":"Film yakında vizyona giriyor."}]},
  {"id":"pt-expr-a-qualquer-momento","languageId":"pt","category":"expressions","level":"B1","sourceText":"a qualquer momento","translations":{"tr":["her an","her an için"]},"details":{"register":"neutral"},"examples":[{"text":"Ela pode chegar a qualquer momento.","tr":"Her an gelebilir."}]},
  {"id":"pt-expr-mais-cedo-ou-mais-tarde","languageId":"pt","category":"expressions","level":"B1","sourceText":"mais cedo ou mais tarde","translations":{"tr":["er ya da geç","eninde sonunda"]},"details":{"register":"neutral"},"examples":[{"text":"Mais cedo ou mais tarde, ele vai descobrir.","tr":"Er ya da geç öğrenecek."}]},
  {"id":"pt-expr-na-maioria-das-vezes","languageId":"pt","category":"expressions","level":"B1","sourceText":"na maioria das vezes","translations":{"tr":["çoğu zaman","genellikle"]},"details":{"register":"neutral"},"examples":[{"text":"Na maioria das vezes, eu vou de ônibus.","tr":"Çoğu zaman otobüsle giderim."}]},
  {"id":"pt-expr-na-pratica","languageId":"pt","category":"expressions","level":"B1","sourceText":"na prática","translations":{"tr":["pratikte","uygulamada"]},"details":{"register":"neutral"},"examples":[{"text":"Na teoria é fácil, na prática é outra coisa.","tr":"Teoride kolay, pratikte başka bir şey."}]},
