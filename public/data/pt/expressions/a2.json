  {"id":"pt-expr-de-carro","languageId":"pt","category":"expressions","level":"A2","sourceText":"de carro","translations":{"tr":["arabayla"]},"details":{"usage":"Taşıtlarla de kullanılır: de ônibus, de trem, de avião.","register":"neutral"},"examples":[{"text":"Eles vieram de carro.","tr":"Arabayla geldiler."}]},
