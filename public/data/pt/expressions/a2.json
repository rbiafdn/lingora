  {"id":"pt-expr-a-gente-se-fala","languageId":"pt","category":"expressions","level":"A2","sourceText":"a gente se fala","translations":{"tr":["konuşuruz","görüşürüz"]},"details":{"usage":"Vedalaşırken; a gente = biz (konuşma dili).","register":"informal"},"examples":[{"text":"Tenho que desligar, a gente se fala.","tr":"Kapatmam lazım, konuşuruz."}]},
  {"id":"pt-expr-da-pra","languageId":"pt","category":"expressions","level":"A2","sourceText":"dá pra","translations":{"tr":["…mümkün mü","…olur mu","…mek mümkün"]},"details":{"usage":"'Dá para' kısaltması; Brezilya'da 'pode-se' yerine çok yaygın.","register":"informal"},"examples":[{"text":"Dá pra ir a pé até lá?","tr":"Oraya yürüyerek gidilebilir mi?"}]},
  {"id":"pt-expr-faz-tempo","languageId":"pt","category":"expressions","level":"A2","sourceText":"faz tempo","translations":{"tr":["uzun zaman oldu","epeydir"]},"details":{"usage":"'Faz tempo que…' = …dır uzun zamandır.","register":"neutral"},"examples":[{"text":"Faz tempo que eu não vejo ela.","tr":"Onu uzun zamandır görmüyorum."}]},
  {"id":"pt-expr-faz-que","languageId":"pt","category":"expressions","level":"A2","sourceText":"faz … que","translations":{"tr":["…dır","…den beri"]},"details":{"usage":"Süre bildirir: Faz dois anos que moro aqui = İki yıldır burada oturuyorum.","register":"neutral"},"examples":[{"text":"Faz três anos que estudo português.","tr":"Üç yıldır Portekizce çalışıyorum."}]}
