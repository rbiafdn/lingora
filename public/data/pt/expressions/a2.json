[
  {"id":"pt-expr-sinto-muito","languageId":"pt","category":"expressions","level":"A2","sourceText":"sinto muito","translations":{"tr":["çok üzgünüm","başınız sağ olsun"]},"tags":["politeness"],"details":{"usage":"Ciddi özürlerde ve kötü bir habere karşı üzüntü belirtirken.","register":"neutral"},"examples":[{"text":"Sinto muito pelo que aconteceu.","tr":"Olanlar için çok üzgünüm."}]},
