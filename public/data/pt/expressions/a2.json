  {"id":"pt-expr-alem-disso","languageId":"pt","category":"expressions","level":"A2","sourceText":"além disso","translations":{"tr":["ayrıca","üstelik"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"O hotel é barato e, além disso, fica perto da praia.","tr":"Otel ucuz, üstelik plaja da yakın."}]},
