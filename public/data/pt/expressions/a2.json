  {"id":"pt-expr-eu-gostaria-de","languageId":"pt","category":"expressions","level":"A2","sourceText":"eu gostaria de","translations":{"tr":["…mak isterdim","…mak istiyorum"]},"tags":["politeness"],"details":{"usage":"Eu quero'nun kibar hâli; restoran ve resmî durumlarda.","register":"formal"},"examples":[{"text":"Eu gostaria de fazer uma reserva.","tr":"Rezervasyon yaptırmak istiyorum."}]},
  {"id":"pt-expr-eu-queria","languageId":"pt","category":"expressions","level":"A2","sourceText":"eu queria","translations":{"tr":["…istiyordum","…rica edecektim"]},"tags":["politeness"],"details":{"usage":"Brezilya'da sipariş verirken çok kullanılan kibar kalıp.","register":"neutral"},"examples":[{"text":"Eu queria um pão de queijo, por favor.","tr":"Bir peynirli ekmek alabilir miyim lütfen?"}]},
