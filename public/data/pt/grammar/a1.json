[
  {"id":"pt-gr-artigos-definidos-e-indefinidos","languageId":"pt","category":"grammar","level":"A1","sourceText":"Artigos definidos e indefinidos","translations":{"tr":["Belirli ve belirsiz artikeller"]},"grammar":{"summary":"Portekizcede isimlerin önünde cinsiyet ve sayıya uyan artikel kullanılır: o/a/os/as (belirli), um/uma/uns/umas (belirsiz).","uses":["Bilinen, belirli bir şeyden söz etmek (o livro)","İlk kez söz edilen ya da herhangi bir şeyden söz etmek (um livro)","Genel kavramlardan söz etmek (O café é bom.)"],"sections":[{"kind":"other","title":"Belirli artikel: o / a / os / as","formula":[{"tr":"Artikel","en":"Artigo definido","role":"x"},{"tr":"İsim","en":"Substantivo","role":"o"}],"examples":[{"text":"[x:o] [o:livro], [x:a] [o:casa]","tr":"(o) kitap, (o) ev"},{"text":"[x:os] [o:carros], [x:as] [o:mesas]","tr":"(o) arabalar, (o) masalar"}],"notes":["o: eril tekil, a: dişil tekil, os: eril çoğul, as: dişil çoğul."]},{"kind":"other","title":"Belirsiz artikel: um / uma / uns / umas","formula":[{"tr":"Artikel","en":"Artigo indefinido","role":"x"},{"tr":"İsim","en":"Substantivo","role":"o"}],"examples":[{"text":"[s:Eu] [v:tenho] [x:um] [o:cachorro].","tr":"Bir köpeğim var."},{"text":"[s:Ela] [v:comprou] [x:umas] [o:flores].","tr":"Birkaç çiçek aldı."}],"notes":["uns / umas 'birkaç, bazı' anlamı verir."]},{"kind":"other","title":"Kişi adlarıyla artikel","formula":[{"tr":"Artikel","en":"Artigo","role":"x"},{"tr":"Kişi adı","en":"Nome próprio","role":"s"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"[x:A] [s:Ana] [v:mora] no Rio.","tr":"Ana Rio'da oturuyor."},{"text":"[x:O] [s:Pedro] [v:é] meu amigo.","tr":"Pedro benim arkadaşım."}],"notes":["Brezilya'da bölgeye göre değişir; günlük konuşmada yaygındır."]},{"kind":"other","title":"Artikelsiz kullanım: meslek ve milliyet","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ser","en":"ser","role":"v"},{"tr":"Meslek (artikelsiz)","en":"Profissão","role":"o"}],"examples":[{"text":"[s:Ele] [v:é] [o:médico].","tr":"O doktor."},{"text":"[s:Eu] [v:sou] [o:estudante].","tr":"Ben öğrenciyim."}]}],"rules":["Artikel ismin cinsiyetine ve sayısına uyar: o menino, a menina, os meninos, as meninas.","Ülke adlarının çoğu artikel alır: o Brasil, a Turquia, os Estados Unidos (ama Portugal, Angola artikelsiz).","Artikel edatlarla birleşir: em + o = no, de + a = da (ayrı konuya bak)."],"exceptions":["Bazı ülke ve şehir adları artikel almaz: Portugal, Moçambique, São Paulo, Lisboa."],"mistakes":[{"wrong":"Eu sou um professor.","right":"Eu sou professor.","note":"Meslek söylerken artikel kullanılmaz (sıfat yoksa)."},{"wrong":"o casa","right":"a casa","note":"casa dişildir; artikel cinsiyete uyar."},{"wrong":"Eu moro em Brasil.","right":"Eu moro no Brasil.","note":"Brasil artikel alır ve em + o = no olur."}]}},
  {"id":"pt-gr-genero-dos-substantivos","languageId":"pt","category":"grammar","level":"A1","sourceText":"Gênero dos substantivos","translations":{"tr":["İsimlerde cinsiyet"]},"grammar":{"summary":"Portekizcede her isim eril (masculino) ya da dişildir (feminino); artikel ve sıfatlar buna göre değişir.","uses":["Doğru artikeli seçmek (o / a)","Sıfatları isme uydurmak (carro novo, casa nova)"],"sections":[{"kind":"other","title":"-o ile biten: genellikle eril","formula":[{"tr":"o","en":"o","role":"x"},{"tr":"İsim (-o)","en":"Substantivo masculino","role":"o"}],"examples":[{"text":"[x:o] [o:carro], [x:o] [o:livro], [x:o] [o:quarto]","tr":"araba, kitap, oda"}]},{"kind":"other","title":"-a ile biten: genellikle dişil","formula":[{"tr":"a","en":"a","role":"x"},{"tr":"İsim (-a)","en":"Substantivo feminino","role":"o"}],"examples":[{"text":"[x:a] [o:casa], [x:a] [o:mesa], [x:a] [o:janela]","tr":"ev, masa, pencere"}]},{"kind":"other","title":"-ção, -dade, -gem, -ez: dişil","formula":[{"tr":"a","en":"a","role":"x"},{"tr":"İsim (-ção/-dade/-gem)","en":"Substantivo feminino","role":"o"}],"examples":[{"text":"[x:a] [o:informação], [x:a] [o:cidade], [x:a] [o:viagem]","tr":"bilgi, şehir, yolculuk"}]},{"kind":"other","title":"Kişilerde eril → dişil","formula":[{"tr":"Eril","en":"Masculino","role":"o"},{"tr":"→","en":"→","role":"x"},{"tr":"Dişil","en":"Feminino","role":"o"}],"examples":[{"text":"[o:o aluno] → [o:a aluna], [o:o professor] → [o:a professora]","tr":"erkek öğrenci → kız öğrenci, öğretmen (e/k)"},{"text":"[o:o estudante] → [o:a estudante]","tr":"öğrenci (yalnızca artikel değişir)"}]}],"rules":["-e, -l, -r, -z gibi seslerle biten isimlerin cinsiyeti tahmin edilemez; artikelle birlikte ezberlenir: o leite, a parede, o hotel, a flor.","-agem ile bitenler dişildir: a viagem, a garagem, a mensagem.","-ista ve -ante ile bitenlerde yalnızca artikel değişir: o/a dentista, o/a estudante."],"exceptions":["Yunanca kökenli -ma ile bitenler erildir: o problema, o sistema, o tema, o programa; ayrıca o dia, o mapa.","Bazı -o ile bitenler dişildir: a foto, a moto, a tribo; ayrıca a mão."],"mistakes":[{"wrong":"a problema","right":"o problema","note":"-ma ile biten Yunanca kökenli kelimeler erildir."},{"wrong":"o viagem","right":"a viagem","note":"-agem ile bitenler dişildir."},{"wrong":"a dia","right":"o dia","note":"dia -a ile bitse de erildir: Bom dia!"}]}},
  {"id":"pt-gr-plural-dos-substantivos","languageId":"pt","category":"grammar","level":"A1","sourceText":"Plural dos substantivos","translations":{"tr":["İsimlerin çoğulu"]},"grammar":{"summary":"Çoğul genellikle -s ekiyle yapılır; -m, -r, -z, -l ve -ão ile biten isimlerde özel kurallar vardır.","uses":["Birden fazla kişi veya şeyden söz etmek","Sayılarla isim kullanmak (dois livros)"],"sections":[{"kind":"other","title":"Ünlüyle biten: + -s","formula":[{"tr":"Tekil","en":"Singular","role":"o"},{"tr":"+ -s","en":"+ -s","role":"x"},{"tr":"Çoğul","en":"Plural","role":"o"}],"examples":[{"text":"[o:o livro] → [o:os livros], [o:a casa] → [o:as casas]","tr":"kitap → kitaplar, ev → evler"},{"text":"[o:o café] → [o:os cafés]","tr":"kahve → kahveler"}]},{"kind":"other","title":"-m → -ns; -r, -z → -es","formula":[{"tr":"-m / -r / -z","en":"-m / -r / -z","role":"o"},{"tr":"→","en":"→","role":"x"},{"tr":"-ns / -res / -zes","en":"-ns / -res / -zes","role":"o"}],"examples":[{"text":"[o:o homem] → [o:os homens], [o:a viagem] → [o:as viagens]","tr":"adam → adamlar, yolculuk → yolculuklar"},{"text":"[o:a flor] → [o:as flores], [o:a luz] → [o:as luzes]","tr":"çiçek → çiçekler, ışık → ışıklar"}]},{"kind":"other","title":"-l → -is","formula":[{"tr":"-al / -el / -ol / -ul","en":"-l","role":"o"},{"tr":"→","en":"→","role":"x"},{"tr":"-ais / -éis / -óis / -uis","en":"-is","role":"o"}],"examples":[{"text":"[o:o animal] → [o:os animais], [o:o papel] → [o:os papéis]","tr":"hayvan → hayvanlar, kâğıt → kâğıtlar"},{"text":"[o:o hotel] → [o:os hotéis], [o:o barril] → [o:os barris]","tr":"otel → oteller, fıçı → fıçılar"}]},{"kind":"other","title":"-ão → -ões / -ães / -ãos","formula":[{"tr":"-ão","en":"-ão","role":"o"},{"tr":"→","en":"→","role":"x"},{"tr":"-ões (en sık) / -ães / -ãos","en":"-ões / -ães / -ãos","role":"o"}],"examples":[{"text":"[o:a estação] → [o:as estações], [o:o avião] → [o:os aviões]","tr":"istasyon → istasyonlar, uçak → uçaklar"},{"text":"[o:o pão] → [o:os pães], [o:a mão] → [o:as mãos]","tr":"ekmek → ekmekler, el → eller"}]}],"rules":["Artikel ve sıfatlar da çoğul olur: os carros novos, as casas bonitas.","Vurgusuz -s ve -x ile biten isimler değişmez: o ônibus → os ônibus, o lápis → os lápis.","-ão çoğulunun çoğu -ões'tür; -ães ve -ãos ile olanlar ezberlenir (pães, cães, mãos, irmãos)."],"exceptions":["Vurgulu -s ile bitenler -es alır: o mês → os meses, o país → os países."],"mistakes":[{"wrong":"os homems","right":"os homens","note":"-m ile biten isimler -ns olur."},{"wrong":"os animals","right":"os animais","note":"-l ile biten isimler -is olur."},{"wrong":"dois livro","right":"dois livros","note":"Türkçenin aksine sayıdan sonra isim çoğul olur."}]}},
  {"id":"pt-gr-concordancia-dos-adjetivos","languageId":"pt","category":"grammar","level":"A1","sourceText":"Concordância dos adjetivos","translations":{"tr":["Sıfat uyumu"]},"grammar":{"summary":"Sıfatlar genellikle isimden sonra gelir ve ismin cinsiyetine ve sayısına uyar.","uses":["Kişi ve nesneleri betimlemek","Renk, milliyet, boyut gibi özellikleri söylemek"],"sections":[{"kind":"other","title":"-o / -a / -os / -as","formula":[{"tr":"İsim","en":"Substantivo","role":"o"},{"tr":"Sıfat (uyumlu)","en":"Adjetivo","role":"x"}],"examples":[{"text":"[o:o carro] [x:novo], [o:a casa] [x:nova]","tr":"yeni araba, yeni ev"},{"text":"[o:os carros] [x:novos], [o:as casas] [x:novas]","tr":"yeni arabalar, yeni evler"}]},{"kind":"other","title":"-e veya ünsüzle bitenler: sadece sayı","formula":[{"tr":"İsim","en":"Substantivo","role":"o"},{"tr":"Sıfat (-e / -l / -z)","en":"Adjetivo invariável em gênero","role":"x"}],"examples":[{"text":"[o:um livro] [x:interessante], [o:uma aula] [x:interessante]","tr":"ilginç bir kitap, ilginç bir ders"},{"text":"[o:os testes] [x:fáceis], [o:as pessoas] [x:felizes]","tr":"kolay sınavlar, mutlu insanlar"}]},{"kind":"other","title":"Milliyet sıfatları (-ês → -esa)","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ser","en":"ser","role":"v"},{"tr":"Milliyet","en":"Nacionalidade","role":"x"}],"examples":[{"text":"[s:Ele] [v:é] [x:português]. [s:Ela] [v:é] [x:portuguesa].","tr":"O (erkek) Portekizli. O (kadın) Portekizli."},{"text":"[s:Eles] [v:são] [x:turcos].","tr":"Onlar Türk."}]},{"kind":"other","title":"İsimden önce gelen sıfatlar","formula":[{"tr":"Sıfat","en":"Adjetivo","role":"x"},{"tr":"İsim","en":"Substantivo","role":"o"}],"examples":[{"text":"[x:Bom] [o:dia]! [x:Boa] [o:noite]!","tr":"Günaydın! İyi geceler!"},{"text":"[o:um homem] [x:grande] / [x:um grande] [o:homem]","tr":"iri bir adam / büyük (önemli) bir adam"}]}],"rules":["Karışık cinsiyetli gruplarda sıfat eril çoğul olur: o pai e a mãe são altos.","bom/boa, mau/má, primeiro, último gibi bazı sıfatlar genellikle isimden önce gelir.","Bazı sıfatlar isimden önce gelince anlam değiştirir: um velho amigo (eski dost), um amigo velho (yaşlı dost)."],"exceptions":["Renk bildiren isimler değişmez: camisas laranja, sapatos rosa."],"mistakes":[{"wrong":"a casa novo","right":"a casa nova","note":"Sıfat ismin cinsiyetine uyar."},{"wrong":"uma mulher português","right":"uma mulher portuguesa","note":"-ês ile biten milliyetler dişilde -esa olur."},{"wrong":"os livros interessante","right":"os livros interessantes","note":"Sıfat çoğulda da uyum gösterir."}]}},
  {"id":"pt-gr-pronomes-pessoais-e-o-verbo-ser","languageId":"pt","category":"grammar","level":"A1","sourceText":"Pronomes pessoais e o verbo ser","translations":{"tr":["Şahıs zamirleri ve ser fiili"]},"grammar":{"summary":"ser fiili 'olmak' anlamındadır; kimlik, milliyet, meslek ve kalıcı özellikleri anlatır.","uses":["Kendini tanıtmak (Eu sou a Ana.)","Milliyet ve meslek söylemek","Kalıcı özellikleri betimlemek","Saat ve tarih söylemek (São três horas.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ser (sou/é/somos/são)","en":"ser","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Eu] [v:sou] [o:turco].","tr":"Ben Türk'üm."},{"text":"[s:Você] [v:é] [o:muito simpático].","tr":"Sen çok sempatiksin."},{"text":"[s:Nós] [v:somos] [o:amigos].","tr":"Biz arkadaşız."}],"notes":["eu sou · você/ele/ela/a gente é · nós somos · vocês/eles/elas são","Brezilya'da 'sen' genellikle você'dir ve fiil 3. tekil şahısla çekilir; tu (tu és) bazı bölgelerde kullanılır."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não","en":"não","role":"a"},{"tr":"ser","en":"ser","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Ela] [a:não] [v:é] [o:brasileira].","tr":"O Brezilyalı değil."},{"text":"[s:Eles] [a:não] [v:são] [o:professores].","tr":"Onlar öğretmen değil."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ser","en":"ser","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[s:Você] [v:é] [o:estudante]?","tr":"Öğrenci misin?"},{"text":"[s:Ele] [v:é] [o:casado]?","tr":"O evli mi?"}],"notes":["Soru, söz dizimi değişmeden yalnızca tonlamayla yapılır."]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"ser","en":"ser","role":"v"},{"tr":"Özne?","en":"Sujeito?","role":"s"}],"examples":[{"text":"[q:De onde] [v:é] [s:você]?","tr":"Nerelisin?"},{"text":"[q:Quem] [v:é] [s:ela]?","tr":"O kim?"}]}],"rules":["Portekizcede özne zamiri sık sık düşer, çünkü fiil eki kişiyi gösterir: Sou turco.","a gente ('biz', gayriresmî) 3. tekil şahısla çekilir: A gente é amigo.","o senhor / a senhora resmî 'siz'dir ve 3. tekil şahısla çekilir."],"exceptions":[],"mistakes":[{"wrong":"Eu professor.","right":"Eu sou professor.","note":"Türkçedeki -im eki yerine ser fiili gerekir."},{"wrong":"Você és brasileiro?","right":"Você é brasileiro?","note":"você 3. tekil şahıs gibi çekilir."},{"wrong":"A gente somos amigos.","right":"A gente é amigo / Nós somos amigos.","note":"a gente tekil fiil alır."}]}},
  {"id":"pt-gr-o-verbo-estar","languageId":"pt","category":"grammar","level":"A1","sourceText":"O verbo estar","translations":{"tr":["Estar fiili (geçici durum ve yer)"]},"grammar":{"summary":"estar de 'olmak' demektir ama geçici durumları, duyguları ve bir şeyin nerede olduğunu anlatır.","uses":["Geçici durum ve duygular (Estou cansado.)","Konum (Onde está o banheiro?)","Hava durumu (Está frio.)","Hal hatır sormak (Como você está?)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"estar (estou/está/estamos/estão)","en":"estar","role":"v"},{"tr":"Durum / Yer","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Eu] [v:estou] [o:cansado].","tr":"Yorgunum."},{"text":"[s:Os meninos] [v:estão] [o:na escola].","tr":"Çocuklar okulda."}],"notes":["eu estou · você/ele/ela está · nós estamos · vocês/eles/elas estão","Konuşmada sık kısalır: tô, tá, tamos, tão."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não","en":"não","role":"a"},{"tr":"estar","en":"estar","role":"v"},{"tr":"Durum / Yer","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Ela] [a:não] [v:está] [o:em casa].","tr":"O evde değil."},{"text":"[s:Eu] [a:não] [v:estou] [o:bem] hoje.","tr":"Bugün iyi değilim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"estar","en":"estar","role":"v"},{"tr":"Durum / Yer?","en":"Complemento?","role":"o"}],"examples":[{"text":"[s:Você] [v:está] [o:com fome]?","tr":"Aç mısın?"},{"text":"[v:Está] [o:tudo bem]?","tr":"Her şey yolunda mı?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"estar","en":"estar","role":"v"},{"tr":"Özne?","en":"Sujeito?","role":"s"}],"examples":[{"text":"[q:Como] [v:está] [s:você]?","tr":"Nasılsın?"},{"text":"[q:Onde] [v:estão] [s:as chaves]?","tr":"Anahtarlar nerede?"}]}],"rules":["estar com + isim kalıbı fiziksel durumları anlatır: estar com fome / sede / frio / pressa (aç / susuz / üşümüş / acele).","Hava durumunda estar kullanılır: Está calor. Está chovendo.","Sabit yerlerin konumu için Brezilya'da genellikle ficar tercih edilir: Onde fica o museu?"],"exceptions":[],"mistakes":[{"wrong":"Eu sou cansado.","right":"Eu estou cansado.","note":"Geçici durum estar ile söylenir."},{"wrong":"Eu sou com fome.","right":"Eu estou com fome.","note":"estar com + isim kalıbı ser ile kurulmaz."}]}},
  {"id":"pt-gr-ser-vs-estar","languageId":"pt","category":"grammar","level":"A1","sourceText":"Ser vs. estar","translations":{"tr":["Ser ile estar farkı"]},"grammar":{"summary":"İkisi de 'olmak' demektir: ser kalıcı/kimlik bilgisini, estar geçici durumu ve konumu anlatır.","uses":["Kalıcı özellik ve geçici durum ayrımı","Aynı sıfatla farklı anlam vermek (é chato / está chato)","Olayların ve nesnelerin yerini doğru söylemek"],"sections":[{"kind":"other","title":"ser: kimlik ve kalıcı özellik","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ser","en":"ser","role":"v"},{"tr":"Kimlik / Özellik","en":"Característica","role":"o"}],"examples":[{"text":"[s:Ela] [v:é] [o:alta e simpática].","tr":"O uzun boylu ve cana yakın."},{"text":"[s:Eu] [v:sou] [o:engenheiro].","tr":"Ben mühendisim."}]},{"kind":"other","title":"estar: geçici durum","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"estar","en":"estar","role":"v"},{"tr":"Durum","en":"Estado","role":"o"}],"examples":[{"text":"[s:O café] [v:está] [o:frio].","tr":"Kahve soğumuş."},{"text":"[s:Nós] [v:estamos] [o:preocupados].","tr":"Endişeliyiz."}]},{"kind":"other","title":"Aynı sıfat, farklı anlam","formula":[{"tr":"ser / estar","en":"ser / estar","role":"v"},{"tr":"Sıfat","en":"Adjetivo","role":"o"}],"examples":[{"text":"[s:Ele] [v:é] [o:chato]. / [s:Ele] [v:está] [o:chato] hoje.","tr":"O sıkıcı biri. / Bugün huysuz."},{"text":"[s:Ela] [v:é] [o:bonita]. / [s:Ela] [v:está] [o:bonita].","tr":"O güzel biri. / Bugün güzel görünüyor."}]},{"kind":"other","title":"Yer: olay → ser, kişi/nesne → estar","formula":[{"tr":"Olay / Kişi","en":"Evento / Pessoa","role":"s"},{"tr":"ser / estar","en":"ser / estar","role":"v"},{"tr":"Yer","en":"Lugar","role":"o"}],"examples":[{"text":"[s:A festa] [v:é] [o:na casa do João].","tr":"Parti João'nun evinde."},{"text":"[s:O João] [v:está] [o:na festa].","tr":"João partide."}]}],"rules":["Kimlik, meslek, milliyet, karakter, malzeme, saat ve tarih → ser.","Duygu, sağlık, geçici görünüm, konum ve süren eylem (estar + gerúndio) → estar.","Medeni hâlde ikisi de kullanılır: Sou casado / Estou casado."],"exceptions":["Ölüm, kalıcı olsa da estar ile söylenir: Ele está morto."],"mistakes":[{"wrong":"Eu estou brasileiro.","right":"Eu sou brasileiro.","note":"Milliyet kalıcıdır, ser kullanılır."},{"wrong":"Eu sou cansado hoje.","right":"Eu estou cansado hoje.","note":"Geçici durum estar ile söylenir."},{"wrong":"A reunião está na sala 3.","right":"A reunião é na sala 3.","note":"Olayın gerçekleştiği yer ser ile söylenir."}]}},
  {"id":"pt-gr-ter-e-haver","languageId":"pt","category":"grammar","level":"A1","sourceText":"Ter e haver","translations":{"tr":["Ter ve haver: sahip olmak ve 'var'"]},"grammar":{"summary":"ter 'sahip olmak' demektir; Brezilya'da 'var' anlamında da tem kullanılır, haver (há) daha resmîdir.","uses":["Sahiplik (Tenho um carro.)","Yaş söylemek (Tenho 20 anos.)","Bir yerde bir şeyin var olduğunu söylemek (Tem / Há)","Zorunluluk (ter que + mastar)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle (sahiplik)","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ter (tenho/tem/temos/têm)","en":"ter","role":"v"},{"tr":"Nesne","en":"Objeto","role":"o"}],"examples":[{"text":"[s:Eu] [v:tenho] [o:dois irmãos].","tr":"İki kardeşim var."},{"text":"[s:Ela] [v:tem] [o:25 anos].","tr":"O 25 yaşında."}],"notes":["eu tenho · você/ele/ela tem · nós temos · vocês/eles/elas têm"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não","en":"não","role":"a"},{"tr":"ter","en":"ter","role":"v"},{"tr":"Nesne","en":"Objeto","role":"o"}],"examples":[{"text":"[s:Ele] [a:não] [v:tem] [o:carro].","tr":"Onun arabası yok."},{"text":"[s:Nós] [a:não] [v:temos] [o:tempo].","tr":"Vaktimiz yok."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ter","en":"ter","role":"v"},{"tr":"Nesne?","en":"Objeto?","role":"o"}],"examples":[{"text":"[s:Você] [v:tem] [o:filhos]?","tr":"Çocuğun var mı?"},{"text":"[s:Vocês] [v:têm] [o:um mapa]?","tr":"Bir haritanız var mı?"}]},{"kind":"other","title":"'Var': tem (günlük) / há (resmî)","formula":[{"tr":"tem / há (tekil)","en":"ter / haver (impessoal)","role":"v"},{"tr":"Nesne","en":"Objeto","role":"o"},{"tr":"Yer","en":"Lugar","role":"x"}],"examples":[{"text":"[v:Tem] [o:um mercado] [x:aqui perto]?","tr":"Yakında bir market var mı?"},{"text":"[v:Há] [o:muitas pessoas] [x:na praia].","tr":"Plajda çok insan var."}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"ter","en":"ter","role":"v"},{"tr":"Özne?","en":"Sujeito?","role":"s"}],"examples":[{"text":"[q:Quantos anos] [s:você] [v:tem]?","tr":"Kaç yaşındasın?"},{"text":"[q:O que] [v:tem] [o:na geladeira]?","tr":"Buzdolabında ne var?"}]}],"rules":["'Var' anlamında tem / há kişisizdir, her zaman tekil kalır: Tem muitos carros.","ter que / ter de + mastar zorunluluk bildirir: Tenho que trabalhar.","há + süre 'önce' ya da 'beri' anlamı verir: Moro aqui há dois anos."],"exceptions":[],"mistakes":[{"wrong":"Eu sou 25 anos.","right":"Eu tenho 25 anos.","note":"Yaş ter ile söylenir."},{"wrong":"Têm muitas pessoas aqui.","right":"Tem muitas pessoas aqui.","note":"'Var' anlamında fiil tekil kalır."},{"wrong":"Hão problemas.","right":"Há problemas.","note":"haver 'var' anlamında çoğul olmaz."}]}},
  {"id":"pt-gr-presente-do-indicativo-verbos-regulares","languageId":"pt","category":"grammar","level":"A1","sourceText":"Presente do indicativo: verbos regulares","translations":{"tr":["Şimdiki/geniş zaman: düzenli fiiller"]},"grammar":{"summary":"Presente; alışkanlıkları, genel gerçekleri ve şu anki durumları anlatır. Düzenli fiiller -ar, -er, -ir eklerine göre çekilir.","uses":["Alışkanlık ve rutinler","Genel gerçekler","Şu anki durumlar","Yakın gelecek (Amanhã viajo.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil kökü + ek","en":"Verbo (radical + desinência)","role":"v"},{"tr":"Nesne","en":"Objeto","role":"o"}],"examples":[{"text":"[s:Eu] [v:falo] [o:português].","tr":"Portekizce konuşurum."},{"text":"[s:Ela] [v:come] [o:muita fruta].","tr":"O çok meyve yer."},{"text":"[s:Nós] [v:abrimos] [o:a loja] às nove.","tr":"Dükkânı dokuzda açarız."}],"notes":["-ar: falo, fala, falamos, falam","-er: como, come, comemos, comem","-ir: abro, abre, abrimos, abrem"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não","en":"não","role":"a"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Nesne","en":"Objeto","role":"o"}],"examples":[{"text":"[s:Eu] [a:não] [v:bebo] [o:café].","tr":"Kahve içmem."},{"text":"[s:Eles] [a:não] [v:moram] [o:aqui].","tr":"Onlar burada oturmuyor."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Nesne?","en":"Objeto?","role":"o"}],"examples":[{"text":"[s:Você] [v:fala] [o:inglês]?","tr":"İngilizce konuşur musun?"},{"text":"[s:Vocês] [v:trabalham] [o:aos sábados]?","tr":"Cumartesileri çalışır mısınız?"}]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Fiil (tekrarlanır)","en":"Verbo","role":"v"},{"tr":"/ Não + fiil","en":"/ Não + verbo","role":"a"}],"examples":[{"text":"Você fala inglês? — [v:Falo].","tr":"İngilizce konuşur musun? — Konuşurum."},{"text":"Você mora aqui? — [a:Não], [a:não] [v:moro].","tr":"Burada mı oturuyorsun? — Hayır, oturmuyorum."}],"notes":["Portekizcede 'evet' yerine çoğu zaman fiil tekrarlanır."]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil?","en":"Verbo?","role":"v"}],"examples":[{"text":"[q:Onde] [s:você] [v:mora]?","tr":"Nerede oturuyorsun?"},{"text":"[q:A que horas] [s:vocês] [v:almoçam]?","tr":"Saat kaçta öğle yemeği yersiniz?"}]}],"rules":["Mastardan -ar/-er/-ir atılır, kişiye göre ek eklenir.","Brezilya'da şimdi süren eylem için daha çok estar + gerúndio kullanılır: Estou comendo.","Zaman ifadesiyle yakın gelecek de anlatılabilir: Amanhã eu trabalho."],"exceptions":["Yazım değişiklikleri: -cer → -ço (conhecer → conheço), -ger/-gir → -jo (proteger → protejo)."],"mistakes":[{"wrong":"Eu fala português.","right":"Eu falo português.","note":"eu ile fiil -o alır."},{"wrong":"Eles fala inglês.","right":"Eles falam inglês.","note":"Çoğul öznede fiil -am / -em alır."},{"wrong":"Eu estou falar português.","right":"Eu falo português.","note":"Geniş zamanda yardımcı fiil kullanılmaz."}]}},
  {"id":"pt-gr-presente-do-indicativo-verbos-irregulares","languageId":"pt","category":"grammar","level":"A1","sourceText":"Presente do indicativo: verbos irregulares","translations":{"tr":["Şimdiki/geniş zaman: düzensiz fiiller"]},"grammar":{"summary":"En sık kullanılan fiillerin çoğu (ir, fazer, poder, querer, ver, vir, dizer, saber) presente'de düzensizdir ve ezberlenir.","uses":["Günlük konuşmanın temel fiilleri","Hareket, istek, yetenek ve bilgi bildirmek"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Düzensiz fiil","en":"Verbo irregular","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Eu] [v:vou] [o:ao trabalho] de ônibus.","tr":"İşe otobüsle giderim."},{"text":"[s:Eu] [v:faço] [o:academia] três vezes por semana.","tr":"Haftada üç kez spor salonuna giderim."},{"text":"[s:Ela] [v:quer] [o:um café].","tr":"O bir kahve istiyor."}],"notes":["ir: vou, vai, vamos, vão · fazer: faço, faz, fazemos, fazem","poder: posso, pode · querer: quero, quer · saber: sei, sabe","ver: vejo, vê, vemos, veem · vir: venho, vem, vimos, vêm · dizer: digo, diz · dar: dou, dá"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não","en":"não","role":"a"},{"tr":"Düzensiz fiil","en":"Verbo irregular","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Eu] [a:não] [v:sei] [o:a resposta].","tr":"Cevabı bilmiyorum."},{"text":"[s:Ele] [a:não] [v:pode] [o:vir] hoje.","tr":"O bugün gelemez."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Düzensiz fiil","en":"Verbo irregular","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[s:Você] [v:vem] [o:à festa]?","tr":"Partiye geliyor musun?"},{"text":"[s:Você] [v:pode] [o:me ajudar]?","tr":"Bana yardım edebilir misin?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil?","en":"Verbo?","role":"v"}],"examples":[{"text":"[q:O que] [s:você] [v:faz]?","tr":"Ne iş yapıyorsun?"},{"text":"[q:Aonde] [s:vocês] [v:vão]?","tr":"Nereye gidiyorsunuz?"}]},{"kind":"other","title":"Yalnızca eu formu düzensiz olanlar","formula":[{"tr":"eu","en":"eu","role":"s"},{"tr":"Düzensiz eu formu","en":"1ª pessoa irregular","role":"v"}],"examples":[{"text":"[s:Eu] [v:ouço] música. [s:Ele] [v:ouve] música.","tr":"Müzik dinlerim. O müzik dinler."},{"text":"[s:Eu] [v:peço] desculpas. [s:Eu] [v:saio] cedo.","tr":"Özür dilerim. Erken çıkarım."}]}],"rules":["ir + mastar yakın gelecek bildirir: Vou estudar.","poder + mastar 'yapabilmek', querer + mastar 'yapmak istemek' anlamı verir.","vir (gelmek) ve ver (görmek) karıştırılır: eles vêm (geliyorlar), eles veem (görüyorlar)."],"exceptions":["ser, estar ve ter de düzensizdir (ayrı konularda)."],"mistakes":[{"wrong":"Eu fazo.","right":"Eu faço.","note":"fazer'in eu formu düzensizdir."},{"wrong":"Eu sabo.","right":"Eu sei.","note":"saber'in eu formu sei'dir."},{"wrong":"Eu podo ir.","right":"Eu posso ir.","note":"poder'in eu formu posso'dur."}]}},
  {"id":"pt-gr-contracoes-de-preposicoes","languageId":"pt","category":"grammar","level":"A1","sourceText":"Contrações de preposições","translations":{"tr":["Edat ve artikel birleşimleri"]},"grammar":{"summary":"em, de, a, por edatları artikel, zamir ve işaret sözcükleriyle birleşerek tek kelime olur: no, na, do, da, ao, pelo, dele, nesse.","uses":["Yer bildirmek (no Brasil, na praia)","Köken ve aitlik bildirmek (do Rio, da Ana)","Yön ve yol bildirmek (ao centro, pelo parque)"],"sections":[{"kind":"other","title":"em + artikel = no / na / nos / nas","formula":[{"tr":"em + o/a","en":"Preposição em + artigo","role":"x"},{"tr":"Yer","en":"Lugar","role":"o"}],"examples":[{"text":"[s:Eu] [v:moro] [x:no] [o:Brasil].","tr":"Brezilya'da yaşıyorum."},{"text":"[s:Ela] [v:está] [x:na] [o:praia].","tr":"O plajda."}],"notes":["em + um = num, em + uma = numa (konuşmada sık)."]},{"kind":"other","title":"de + artikel = do / da / dos / das","formula":[{"tr":"de + o/a","en":"Preposição de + artigo","role":"x"},{"tr":"İsim","en":"Substantivo","role":"o"}],"examples":[{"text":"[s:Ele] [v:é] [x:do] [o:Rio].","tr":"O Rio'lu."},{"text":"[o:O carro] [x:da] [o:Ana] [v:é] novo.","tr":"Ana'nın arabası yeni."}]},{"kind":"other","title":"a / por + artikel = ao, à / pelo, pela","formula":[{"tr":"a / por + o/a","en":"Preposição a / por + artigo","role":"x"},{"tr":"Yer","en":"Lugar","role":"o"}],"examples":[{"text":"[v:Vamos] [x:ao] [o:cinema]? [s:Ela] [v:foi] [x:à] [o:farmácia].","tr":"Sinemaya gidelim mi? O eczaneye gitti."},{"text":"[s:Eu] [v:passo] [x:pelo] [o:parque] todo dia.","tr":"Her gün parkın içinden geçerim."}],"notes":["a + a = à (crase işareti ile yazılır)."]},{"kind":"other","title":"Edat + zamir / işaret sözcüğü","formula":[{"tr":"de / em","en":"Preposição","role":"x"},{"tr":"+ ele / esse / aquele","en":"+ pronome","role":"o"}],"examples":[{"text":"[o:Esse livro] [v:é] [x:dele].","tr":"Bu kitap onun."},{"text":"[s:Eu] [v:moro] [x:nesta] [o:rua].","tr":"Bu sokakta oturuyorum."}],"notes":["de + ele = dele, em + ele = nele, de + esse = desse, em + aquele = naquele"]}],"rules":["Artikel alan bir isimden önce em, de, a, por gelirse birleşme zorunludur: em o → no.","Artikel almayan isimlerle birleşme olmaz: em Lisboa, de São Paulo, em Portugal.","Brezilya konuşma dilinde yön için ir em sık kullanılır (Vou na praia), yazıda ir a tercih edilir (Vou à praia)."],"exceptions":["Mastarlı yapıdan önce resmî yazıda birleşme yapılmaz: Antes de o filme começar."],"mistakes":[{"wrong":"Eu moro em a cidade.","right":"Eu moro na cidade.","note":"em + a birleşerek na olur."},{"wrong":"Eu sou de o Brasil.","right":"Eu sou do Brasil.","note":"de + o = do."},{"wrong":"o carro de ele","right":"o carro dele","note":"de + ele birleşir: dele."}]}},
  {"id":"pt-gr-palavras-interrogativas","languageId":"pt","category":"grammar","level":"A1","sourceText":"Palavras interrogativas","translations":{"tr":["Soru kelimeleri"]},"grammar":{"summary":"Soru kelimeleri (o que, quem, onde, quando, como, por que, quanto, qual) genellikle cümlenin başında gelir.","uses":["Bilgi istemek","Fiyat, miktar, yer ve zaman sormak","Seçim yaptırmak (qual)"],"sections":[{"kind":"wh","title":"Soru kelimesi + özne + fiil","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil?","en":"Verbo?","role":"v"}],"examples":[{"text":"[q:O que] [s:você] [v:quer]?","tr":"Ne istiyorsun?"},{"text":"[q:Quando] [s:vocês] [v:chegam]?","tr":"Ne zaman varıyorsunuz?"}]},{"kind":"wh","title":"Soru kelimesi + fiil + özne","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Özne?","en":"Sujeito?","role":"s"}],"examples":[{"text":"[q:Quanto] [v:custa] [s:isso]?","tr":"Bu ne kadar?"},{"text":"[q:Qual] [v:é] [s:o seu nome]?","tr":"Adın ne?"}]},{"kind":"other","title":"Edat + soru kelimesi","formula":[{"tr":"Edat","en":"Preposição","role":"x"},{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Fiil + özne?","en":"Verbo + sujeito?","role":"v"}],"examples":[{"text":"[x:De] [q:onde] [v:você é]?","tr":"Nerelisin?"},{"text":"[x:Com] [q:quem] [v:você mora]?","tr":"Kiminle yaşıyorsun?"}],"notes":["Edat soru kelimesinin önüne gelir, cümle sonunda kalmaz."]},{"kind":"other","title":"por que / porque / por quê","formula":[{"tr":"Por que (soru)","en":"Por que","role":"q"},{"tr":"Porque (cevap)","en":"Porque","role":"x"}],"examples":[{"text":"[q:Por que] [s:você] [v:está] triste? — [x:Porque] perdi o ônibus.","tr":"Neden üzgünsün? — Çünkü otobüsü kaçırdım."},{"text":"Você não veio. [q:Por quê]?","tr":"Gelmedin. Neden?"}],"notes":["Cümle sonunda por quê şapkalı yazılır."]}],"rules":["o que = ne, quem = kim, onde = nerede, aonde = nereye, quando = ne zaman, como = nasıl, quanto(s)/quanta(s) = ne kadar/kaç.","quanto ismin cinsiyet ve sayısına uyar: Quantas pessoas? Quantos anos?","qual / quais 'hangi(si)' demektir; ser ile 'ne' sorusunda da qual kullanılır: Qual é o seu telefone?","Konuşmada vurgu için é que eklenir: O que é que você quer?"],"exceptions":[],"mistakes":[{"wrong":"Que é o seu nome?","right":"Qual é o seu nome?","note":"İsim, numara, adres gibi bilgilerde qual kullanılır."},{"wrong":"Quanto pessoas?","right":"Quantas pessoas?","note":"quanto isme uyar."},{"wrong":"Por que? (cümle sonu)","right":"Por quê?","note":"Cümle sonunda quê şapkalı yazılır."}]}},
  {"id":"pt-gr-negacao","languageId":"pt","category":"grammar","level":"A1","sourceText":"Negação","translations":{"tr":["Olumsuzluk"]},"grammar":{"summary":"Olumsuzluk fiilden önce não ile yapılır; nada, ninguém, nunca fiilden sonra gelirse não da kullanılır (çift olumsuzluk).","uses":["Bir şeyi reddetmek","'Hiçbir şey, hiç kimse, asla' demek","Brezilya'da vurgulu olumsuz (Não sei, não.)"],"sections":[{"kind":"negative","title":"não + fiil","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não","en":"não","role":"a"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Nesne","en":"Objeto","role":"o"}],"examples":[{"text":"[s:Eu] [a:não] [v:gosto] [o:de chuva].","tr":"Yağmuru sevmem."},{"text":"[s:Ela] [a:não] [v:trabalha] [o:aqui].","tr":"O burada çalışmıyor."}]},{"kind":"other","title":"Çift olumsuzluk: não ... nada / ninguém / nunca","formula":[{"tr":"não","en":"não","role":"a"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"nada / ninguém / nunca","en":"Palavra negativa","role":"o"}],"examples":[{"text":"[s:Eu] [a:não] [v:vi] [o:ninguém].","tr":"Kimseyi görmedim."},{"text":"[s:Ele] [a:não] [v:comeu] [o:nada].","tr":"Hiçbir şey yemedi."}]},{"kind":"other","title":"Olumsuz kelime fiilden önce: não yok","formula":[{"tr":"nunca / ninguém / nada","en":"Palavra negativa","role":"a"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"[s:Eu] [a:nunca] [v:bebo] café à noite.","tr":"Akşamları asla kahve içmem."},{"text":"[a:Ninguém] [v:sabe] a resposta.","tr":"Kimse cevabı bilmiyor."}]},{"kind":"other","title":"também não / nem","formula":[{"tr":"também não / nem","en":"também não / nem","role":"a"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"Eu não gosto. — [s:Eu] [a:também não].","tr":"Ben sevmem. — Ben de."},{"text":"[s:Ele] [a:nem] [v:ligou].","tr":"Aramadı bile."}]}],"rules":["não her zaman fiilden (ve nesne zamirinden) önce gelir: Não te conheço.","nada, ninguém, nunca, nenhum fiilden sonra gelirse fiilden önce não da gerekir.","Brezilya konuşmasında cümle sonuna ikinci bir não eklenir: Não quero, não."],"exceptions":[],"mistakes":[{"wrong":"Eu vi ninguém.","right":"Eu não vi ninguém.","note":"Fiilden sonra gelen olumsuz kelimede não gerekir."},{"wrong":"Ninguém não veio.","right":"Ninguém veio.","note":"Olumsuz kelime fiilden önceyse não kullanılmaz."},{"wrong":"Eu gosto não de peixe.","right":"Eu não gosto de peixe.","note":"não fiilden önce gelir."}]}},
  {"id":"pt-gr-pronomes-demonstrativos","languageId":"pt","category":"grammar","level":"A1","sourceText":"Pronomes demonstrativos","translations":{"tr":["İşaret sıfatları ve zamirleri"]},"grammar":{"summary":"este/esse (bu) yakındakini, aquele (şu, o) uzaktakini gösterir; isto/isso/aquilo cinsiyetsizdir ve isimle kullanılmaz.","uses":["Nesneleri göstermek","Daha önce söylenen bir şeye atıf yapmak (Isso é verdade.)"],"sections":[{"kind":"other","title":"este / esse: yakın","formula":[{"tr":"este/esta, esse/essa","en":"Demonstrativo","role":"x"},{"tr":"İsim","en":"Substantivo","role":"o"}],"examples":[{"text":"[x:Este] [o:livro] [v:é] meu.","tr":"Bu kitap benim."},{"text":"[x:Essa] [o:camisa] [v:é] bonita.","tr":"Bu (o) gömlek güzel."}],"notes":["Brezilya konuşmasında este ve esse çoğunlukla aynı anlamda kullanılır; esse daha yaygındır."]},{"kind":"other","title":"aquele: uzak","formula":[{"tr":"aquele/aquela/aqueles/aquelas","en":"Demonstrativo","role":"x"},{"tr":"İsim","en":"Substantivo","role":"o"}],"examples":[{"text":"[x:Aquele] [o:prédio] [v:é] muito alto.","tr":"Şu bina çok yüksek."},{"text":"[x:Aquelas] [o:meninas] [v:são] minhas primas.","tr":"Şu kızlar kuzenlerim."}]},{"kind":"other","title":"isto / isso / aquilo: cinsiyetsiz","formula":[{"tr":"isto / isso / aquilo","en":"Demonstrativo neutro","role":"s"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"[q:O que] [v:é] [s:isso]?","tr":"Bu ne?"},{"text":"[s:Aquilo] [v:é] uma igreja.","tr":"Şu bir kilise."}]},{"kind":"other","title":"Edatla birleşme","formula":[{"tr":"em / de","en":"Preposição","role":"x"},{"tr":"+ este / esse / aquele","en":"+ demonstrativo","role":"o"}],"examples":[{"text":"[s:Eu] [v:moro] [x:nesta] [o:rua].","tr":"Bu sokakta oturuyorum."},{"text":"[s:Você] [v:gosta] [x:daquele] [o:restaurante]?","tr":"Şu restoranı seviyor musun?"}]}],"rules":["Gösterme sözcükleri isimle cinsiyet ve sayı bakımından uyuşur: este carro, esta casa, estes carros.","isto, isso, aquilo hiçbir zaman bir ismin önünde kullanılmaz.","Zaman ifadelerinde: nesta semana (bu hafta), naquele dia (o gün)."],"exceptions":[],"mistakes":[{"wrong":"isso livro","right":"esse livro","note":"İsimle birlikte isso değil esse kullanılır."},{"wrong":"aquela livro","right":"aquele livro","note":"livro eril; işaret sözcüğü uyar."},{"wrong":"em este hotel","right":"neste hotel","note":"em + este = neste."}]}}
]
