[
  {"id":"pt-gr-pronomes-possessivos","languageId":"pt","category":"grammar","level":"A2","sourceText":"Pronomes possessivos","translations":{"tr":["İyelik sıfatları ve zamirleri"]},"grammar":{"summary":"İyelik sözcükleri (meu, seu, nosso) sahip olunan şeyin cinsiyetine ve sayısına uyar; 'onun' için Brezilya'da genellikle dele/dela kullanılır.","uses":["Sahiplik bildirmek","'Benimki, seninki' demek (o meu, a sua)"],"sections":[{"kind":"other","title":"(Artikel) + iyelik + isim","formula":[{"tr":"(o/a)","en":"(Artigo)","role":"x"},{"tr":"İyelik","en":"Possessivo","role":"x"},{"tr":"İsim","en":"Substantivo","role":"o"}],"examples":[{"text":"[x:Meu] [o:irmão] mora em Recife.","tr":"Erkek kardeşim Recife'de yaşıyor."},{"text":"[x:A nossa] [o:casa] é pequena.","tr":"Bizim evimiz küçük."}],"notes":["meu/minha/meus/minhas · seu/sua/seus/suas · nosso/nossa/nossos/nossas","Brezilya'da isimden önceki artikel isteğe bağlıdır: meu carro / o meu carro."]},{"kind":"other","title":"İsim + dele / dela / deles / delas","formula":[{"tr":"Artikel + isim","en":"Artigo + substantivo","role":"o"},{"tr":"dele / dela","en":"de + pronome","role":"x"}],"examples":[{"text":"[o:O carro] [x:dele] é vermelho.","tr":"Onun (erkeğin) arabası kırmızı."},{"text":"[o:A mãe] [x:dela] é professora.","tr":"Onun (kadının) annesi öğretmen."}],"notes":["dele/dela sahibe uyar, sahip olunana değil."]},{"kind":"other","title":"Sahip olunana uyum","formula":[{"tr":"İyelik (uyumlu)","en":"Possessivo","role":"x"},{"tr":"İsim","en":"Substantivo","role":"o"}],"examples":[{"text":"[s:Ele] [v:é] [x:meu] [o:irmão]. [s:Ela] [v:é] [x:minha] [o:irmã].","tr":"O benim erkek kardeşim. O benim kız kardeşim."},{"text":"[x:Suas] [o:malas] estão aqui.","tr":"Bavullarınız burada."}]},{"kind":"other","title":"Zamir olarak: o meu, a sua","formula":[{"tr":"Artikel","en":"Artigo","role":"x"},{"tr":"İyelik (isimsiz)","en":"Possessivo","role":"o"}],"examples":[{"text":"Esse celular é [x:o] [o:meu].","tr":"Bu telefon benimki."},{"text":"Essa mala é [o:sua]?","tr":"Bu bavul seninki mi?"}]}],"rules":["Brezilya'da seu/sua genellikle 'senin' (você) anlamındadır; 3. şahıs için dele/dela tercih edilir.","İyelik sözcüğü sahibin değil, sahip olunan ismin cinsiyetine uyar: minha mãe, meu pai (konuşan kim olursa olsun).","a gente için de nosso kullanılır: A gente vendeu a nossa casa."],"exceptions":["Avrupa Portekizcesinde artikel genellikle zorunludur: o meu carro."],"mistakes":[{"wrong":"Ela é meu irmã.","right":"Ela é minha irmã.","note":"İyelik, irmã (dişil) ismine uyar."},{"wrong":"o carro de ele","right":"o carro dele","note":"de + ele = dele ve isimden sonra gelir."},{"wrong":"Maria e seu marido (onun kocası anlamında, belirsiz)","right":"Maria e o marido dela","note":"seu 'senin' diye anlaşılabilir; dela açıktır."}]}},
  {"id":"pt-gr-gostar-de-e-verbos-com-preposicao","languageId":"pt","category":"grammar","level":"A2","sourceText":"Gostar de e verbos com preposição","translations":{"tr":["Gostar de ve edatlı fiiller"]},"grammar":{"summary":"gostar (sevmek) her zaman de edatıyla kullanılır; precisar de, morar em, pensar em gibi birçok fiil sabit bir edat ister.","uses":["Sevdiğin ve sevmediğin şeyleri söylemek","İhtiyaç bildirmek (preciso de)","Yer ve düşünce bildirmek (moro em, penso em)"],"sections":[{"kind":"affirmative","title":"gostar de + isim / mastar","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"gostar","en":"gostar","role":"v"},{"tr":"de (+ artikel)","en":"de","role":"x"},{"tr":"İsim / Mastar","en":"Substantivo / Infinitivo","role":"o"}],"examples":[{"text":"[s:Eu] [v:gosto] [x:de] [o:café].","tr":"Kahveyi severim."},{"text":"[s:Ela] [v:gosta] [x:de] [o:dançar].","tr":"O dans etmeyi sever."},{"text":"[s:Nós] [v:gostamos] [x:do] [o:Brasil].","tr":"Brezilya'yı seviyoruz."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não","en":"não","role":"a"},{"tr":"gostar de","en":"gostar de","role":"v"},{"tr":"Nesne","en":"Objeto","role":"o"}],"examples":[{"text":"[s:Eu] [a:não] [v:gosto de] [o:acordar cedo].","tr":"Erken kalkmayı sevmem."}]},{"kind":"question","title":"Soru ve kısa cevap","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"gostar de","en":"gostar de","role":"v"},{"tr":"Nesne?","en":"Objeto?","role":"o"}],"examples":[{"text":"[s:Você] [v:gosta de] [o:samba]? — Gosto!","tr":"Sambayı sever misin? — Severim!"},{"text":"[q:Do que] [s:você] [v:gosta]?","tr":"Neyi seversin?"}]},{"kind":"other","title":"Diğer edatlı fiiller","formula":[{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Sabit edat","en":"Preposição fixa","role":"x"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Eu] [v:preciso] [x:de] [o:ajuda].","tr":"Yardıma ihtiyacım var."},{"text":"[s:Ela] [v:pensa] [x:em] [o:você].","tr":"O seni düşünüyor."}],"notes":["precisar de, gostar de, lembrar de, morar em, pensar em, acreditar em, sonhar com, casar com"]}],"rules":["gostar, İspanyolcadaki gustar gibi değildir; seven kişi öznedir: Eu gosto de você.","de ve em artikellerle birleşir: gosto do filme, penso na prova.","precisar + mastar ile de kullanılmaz: Preciso sair."],"exceptions":[],"mistakes":[{"wrong":"Eu gosto café.","right":"Eu gosto de café.","note":"gostar her zaman de ister."},{"wrong":"Eu gosto de o filme.","right":"Eu gosto do filme.","note":"de + o = do."},{"wrong":"Eu preciso um táxi.","right":"Eu preciso de um táxi.","note":"İsimle precisar de kullanılır."}]}},
  {"id":"pt-gr-ir-infinitivo","languageId":"pt","category":"grammar","level":"A2","sourceText":"Ir + infinitivo","translations":{"tr":["Yakın gelecek (ir + mastar)"]},"grammar":{"summary":"ir fiilinin presente hâli + mastar, gelecekteki planları anlatır; Brezilya konuşmasında en yaygın gelecek zamandır.","uses":["Planlar ve niyetler","Yakın gelecek","Kanıta dayalı tahmin (Vai chover.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ir (vou/vai/vamos/vão)","en":"ir (presente)","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"},{"tr":"Nesne","en":"Objeto","role":"o"}],"examples":[{"text":"[s:Eu] [a:vou] [v:viajar] [o:amanhã].","tr":"Yarın seyahate çıkacağım."},{"text":"[s:Nós] [a:vamos] [v:comprar] [o:um carro].","tr":"Bir araba alacağız."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não + ir","en":"não + ir","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"},{"tr":"Nesne","en":"Objeto","role":"o"}],"examples":[{"text":"[s:Ela] [a:não vai] [v:trabalhar] [o:hoje].","tr":"O bugün çalışmayacak."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ir","en":"ir","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"},{"tr":"Nesne?","en":"Objeto?","role":"o"}],"examples":[{"text":"[s:Você] [a:vai] [v:sair] [o:hoje à noite]?","tr":"Bu akşam dışarı çıkacak mısın?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ir","en":"ir","role":"a"},{"tr":"Mastar?","en":"Infinitivo?","role":"v"}],"examples":[{"text":"[q:O que] [s:vocês] [a:vão] [v:fazer] no sábado?","tr":"Cumartesi ne yapacaksınız?"},{"text":"[q:Quando] [s:você] [a:vai] [v:voltar]?","tr":"Ne zaman döneceksin?"}]}],"rules":["ir çekimlenir, ikinci fiil mastar kalır ve araya edat girmez.","Gitmek anlamında gelecek için Brezilya konuşmasında vou ir de duyulur, ama standart ve kısa hâli vou'dur: Vou à praia amanhã.","vamos + mastar 'hadi ... yapalım' önerisi de olabilir: Vamos comer!"],"exceptions":[],"mistakes":[{"wrong":"Eu vou a comer.","right":"Eu vou comer.","note":"ir ile mastar arasına edat girmez."},{"wrong":"Eu vai viajar.","right":"Eu vou viajar.","note":"ir öznesine göre çekilir."},{"wrong":"Ele vai trabalha amanhã.","right":"Ele vai trabalhar amanhã.","note":"İkinci fiil mastar hâlinde kalır."}]}},
  {"id":"pt-gr-estar-gerundio","languageId":"pt","category":"grammar","level":"A2","sourceText":"Estar + gerúndio","translations":{"tr":["Şimdiki zaman (estar + -ndo)"]},"grammar":{"summary":"estar + gerúndio (-ando/-endo/-indo) şu anda süren eylemi anlatır; Brezilya Portekizcesinin şimdiki zaman yapısıdır.","uses":["Konuşma anında süren eylemler","Bu günlerde süren geçici durumlar","Geçmişte süren eylem (estava + gerúndio)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"estar","en":"estar","role":"a"},{"tr":"Gerúndio (-ndo)","en":"Gerúndio","role":"v"},{"tr":"Nesne","en":"Objeto","role":"o"}],"examples":[{"text":"[s:Eu] [a:estou] [v:estudando] [o:português].","tr":"Portekizce çalışıyorum."},{"text":"[s:Eles] [a:estão] [v:assistindo] [o:o jogo].","tr":"Maçı izliyorlar."}],"notes":["falar → falando, comer → comendo, abrir → abrindo, pôr → pondo"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não + estar","en":"não + estar","role":"a"},{"tr":"Gerúndio","en":"Gerúndio","role":"v"},{"tr":"Nesne","en":"Objeto","role":"o"}],"examples":[{"text":"[s:Ela] [a:não está] [v:trabalhando] [o:agora].","tr":"O şu an çalışmıyor."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"estar","en":"estar","role":"a"},{"tr":"Gerúndio","en":"Gerúndio","role":"v"},{"tr":"Nesne?","en":"Objeto?","role":"o"}],"examples":[{"text":"[s:Você] [a:está] [v:ouvindo] [o:a música]?","tr":"Müziği duyuyor musun?"},{"text":"[a:Está] [v:chovendo]?","tr":"Yağmur yağıyor mu?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"estar","en":"estar","role":"a"},{"tr":"Gerúndio?","en":"Gerúndio?","role":"v"}],"examples":[{"text":"[q:O que] [s:você] [a:está] [v:fazendo]?","tr":"Ne yapıyorsun?"},{"text":"[q:Onde] [s:vocês] [a:estão] [v:morando]?","tr":"Şu sıralar nerede oturuyorsunuz?"}]}],"rules":["Gerúndio hiç değişmez; çekimlenen yalnızca estar'dır.","Avrupa Portekizcesinde aynı anlam estar a + mastar ile verilir: Estou a estudar.","Geçmişte süren eylem için estava + gerúndio: Eu estava dormindo."],"exceptions":["ter, saber, conhecer gibi durum fiilleri bu yapıda nadiren kullanılır: Tenho um carro (Estou tendo ✗)."],"mistakes":[{"wrong":"Eu estou falar.","right":"Eu estou falando.","note":"Brezilya'da estar'dan sonra gerúndio gelir."},{"wrong":"Eu falando com ele.","right":"Eu estou falando com ele.","note":"estar atlanamaz."},{"wrong":"Eu estou tendo um carro.","right":"Eu tenho um carro.","note":"Sahiplik bildiren ter bu yapıda kullanılmaz."}]}},
  {"id":"pt-gr-preterito-perfeito-verbos-regulares","languageId":"pt","category":"grammar","level":"A2","sourceText":"Pretérito perfeito: verbos regulares","translations":{"tr":["Geçmiş zaman: düzenli fiiller"]},"grammar":{"summary":"Pretérito perfeito geçmişte belirli bir zamanda başlayıp bitmiş eylemleri anlatır: falei, comi, abri.","uses":["Geçmişte tamamlanmış tek seferlik eylemler","Art arda gerçekleşen olaylar","'Daha önce yaptım' anlamı (Já comi.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil (-ei/-i, -ou/-eu/-iu)","en":"Verbo no pretérito perfeito","role":"v"},{"tr":"Nesne","en":"Objeto","role":"o"}],"examples":[{"text":"[s:Eu] [v:falei] [o:com ela] ontem.","tr":"Dün onunla konuştum."},{"text":"[s:Nós] [v:comemos] [o:pizza].","tr":"Pizza yedik."},{"text":"[s:Eles] [v:abriram] [o:a janela].","tr":"Pencereyi açtılar."}],"notes":["-ar: falei, falou, falamos, falaram","-er: comi, comeu, comemos, comeram","-ir: abri, abriu, abrimos, abriram"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não","en":"não","role":"a"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Nesne","en":"Objeto","role":"o"}],"examples":[{"text":"[s:Eu] [a:não] [v:dormi] [o:bem].","tr":"İyi uyuyamadım."},{"text":"[s:Ela] [a:ainda não] [v:chegou].","tr":"O henüz gelmedi."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Nesne?","en":"Objeto?","role":"o"}],"examples":[{"text":"[s:Você] [v:gostou] [o:do filme]?","tr":"Filmi beğendin mi?"},{"text":"[s:Você] [a:já] [v:almoçou]?","tr":"Öğle yemeğini yedin mi?"}]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Fiil (tekrar)","en":"Verbo","role":"v"},{"tr":"/ Não + fiil","en":"/ Não + verbo","role":"a"}],"examples":[{"text":"Você comprou o pão? — [v:Comprei].","tr":"Ekmeği aldın mı? — Aldım."},{"text":"Ele ligou? — [a:Não], [a:não] [v:ligou].","tr":"Aradı mı? — Hayır, aramadı."}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil?","en":"Verbo?","role":"v"}],"examples":[{"text":"[q:Quando] [s:você] [v:chegou]?","tr":"Ne zaman geldin?"},{"text":"[q:O que] [s:vocês] [v:comeram]?","tr":"Ne yediniz?"}]}],"rules":["nós formu -ar ve -ir fiillerinde presente ile aynıdır (falamos, abrimos); anlam bağlamdan çıkar.","Yazım: -car → -quei (fiquei), -gar → -guei (cheguei), -çar → -cei (comecei).","Brezilya'da 'yaptım mı / yaptın mı' sorularının çoğu bu zamanla sorulur (İngilizcedeki present perfect yerine): Você já foi ao Rio?"],"exceptions":[],"mistakes":[{"wrong":"Eu chegou ontem.","right":"Eu cheguei ontem.","note":"eu formu -ei ile biter."},{"wrong":"Eu ficei em casa.","right":"Eu fiquei em casa.","note":"-car fiillerinde c → qu olur."},{"wrong":"Eu tenho comido já.","right":"Eu já comi.","note":"'Yedim zaten' anlamı perfeito simples ile verilir."}]}},
  {"id":"pt-gr-preterito-perfeito-verbos-irregulares","languageId":"pt","category":"grammar","level":"A2","sourceText":"Pretérito perfeito: verbos irregulares","translations":{"tr":["Geçmiş zaman: düzensiz fiiller"]},"grammar":{"summary":"ser, ir, ter, estar, fazer, poder, dizer, vir gibi temel fiillerin geçmiş zamanı düzensizdir ve ezberlenmelidir.","uses":["Günlük olayları anlatmak (fui, fiz, tive)","Hikâye anlatmak"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Düzensiz fiil","en":"Verbo irregular","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Eu] [v:fui] [o:ao Rio] no verão.","tr":"Yazın Rio'ya gittim."},{"text":"[s:Ela] [v:fez] [o:um bolo].","tr":"O bir kek yaptı."},{"text":"[s:Nós] [v:tivemos] [o:um problema].","tr":"Bir sorun yaşadık."}],"notes":["ser / ir: fui, foi, fomos, foram · ter: tive, teve, tivemos, tiveram","estar: estive, esteve · fazer: fiz, fez, fizemos, fizeram · poder: pude, pôde","dizer: disse · trazer: trouxe · querer: quis · saber: soube · pôr: pus, pôs","vir: vim, veio, viemos, vieram · ver: vi, viu, vimos, viram · dar: dei, deu"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não","en":"não","role":"a"},{"tr":"Düzensiz fiil","en":"Verbo irregular","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Eu] [a:não] [v:pude] [o:ir].","tr":"Gidemedim."},{"text":"[s:Ele] [a:não] [v:disse] [o:nada].","tr":"Hiçbir şey söylemedi."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Düzensiz fiil","en":"Verbo irregular","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[s:Você] [v:viu] [o:o jogo]?","tr":"Maçı gördün mü?"},{"text":"[s:Eles] [v:vieram] [o:à festa]?","tr":"Partiye geldiler mi?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil?","en":"Verbo?","role":"v"}],"examples":[{"text":"[q:Como] [v:foi] [s:a viagem]?","tr":"Yolculuk nasıl geçti?"},{"text":"[q:O que] [s:você] [v:fez] no fim de semana?","tr":"Hafta sonu ne yaptın?"}]},{"kind":"other","title":"ser ve ir: aynı biçim","formula":[{"tr":"fui / foi / fomos / foram","en":"ser / ir","role":"v"},{"tr":"Bağlam","en":"Contexto","role":"o"}],"examples":[{"text":"[s:Eu] [v:fui] [o:ao mercado].","tr":"Markete gittim. (ir)"},{"text":"[s:A festa] [v:foi] [o:ótima].","tr":"Parti harikaydı. (ser)"}]}],"rules":["ser ve ir geçmişte aynı biçimi kullanır; ardından gelen edat (a, para) genellikle 'gitmek' anlamını gösterir.","pôde (geçmiş) şapkalı yazılır, pode (şimdi) ile karışmasın.","Bu fiillerin geçmiş kökü (tiv-, fiz-, estiv-, pud-) ileride subjuntivo biçimlerinde de kullanılır."],"exceptions":[],"mistakes":[{"wrong":"Eu fazi o trabalho.","right":"Eu fiz o trabalho.","note":"fazer'in geçmişi düzensizdir: fiz, fez."},{"wrong":"Eu teve um problema.","right":"Eu tive um problema.","note":"eu formu tive, ele formu teve'dir."},{"wrong":"Ele vino ontem.","right":"Ele veio ontem.","note":"vir: vim, veio, viemos, vieram."}]}},
  {"id":"pt-gr-preterito-imperfeito","languageId":"pt","category":"grammar","level":"A2","sourceText":"Pretérito imperfeito","translations":{"tr":["Geçmişte süreklilik / alışkanlık (-ardı, -ıyordu)"]},"grammar":{"summary":"Pretérito imperfeito geçmişteki alışkanlıkları, betimlemeleri ve süren arka plan durumlarını anlatır: falava, comia, abria.","uses":["Geçmişteki alışkanlıklar (Eu ia à praia todo domingo.)","Geçmişte betimleme: yaş, saat, hava, duygu","Başka bir olay olurken süren eylem","Kibar istek (Eu queria um café.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil (-ava / -ia)","en":"Verbo no imperfeito","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"Quando era criança, [s:eu] [v:brincava] [o:na rua].","tr":"Çocukken sokakta oynardım."},{"text":"[s:Ela] [v:morava] [o:em Salvador].","tr":"O Salvador'da yaşıyordu."}],"notes":["-ar: falava, falava, falávamos, falavam","-er/-ir: comia, comia, comíamos, comiam","Düzensiz: ser → era, ter → tinha, vir → vinha, pôr → punha"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não","en":"não","role":"a"},{"tr":"Fiil (imperfeito)","en":"Verbo no imperfeito","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"Antigamente [s:eu] [a:não] [v:gostava] [o:de peixe].","tr":"Eskiden balık sevmezdim."},{"text":"[s:Ele] [a:não] [v:tinha] [o:celular].","tr":"Onun cep telefonu yoktu."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil (imperfeito)","en":"Verbo no imperfeito","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[s:Você] [v:estudava] [o:aqui]?","tr":"Burada mı okuyordun?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil?","en":"Verbo?","role":"v"}],"examples":[{"text":"[q:Onde] [s:vocês] [v:moravam] antes?","tr":"Önceden nerede oturuyordunuz?"},{"text":"[q:Que horas] [v:eram]?","tr":"Saat kaçtı?"}]}],"rules":["Yalnızca dört düzensiz fiil vardır: ser (era), ter (tinha), vir (vinha), pôr (punha).","Geçmişte saat ve yaş imperfeito ile söylenir: Eram dez horas. Eu tinha cinco anos.","Konuşmada imperfeito, futuro do pretérito yerine de kullanılır: Eu ia adorar! (Bayılırdım!)"],"exceptions":[],"mistakes":[{"wrong":"Quando eu fui criança, morei em Recife.","right":"Quando eu era criança, morava em Recife.","note":"Geçmişteki süreğen durumlar imperfeito ile anlatılır."},{"wrong":"Eu tenía fome.","right":"Eu tinha fome.","note":"ter'in imperfeito'su tinha'dır."}]}},
  {"id":"pt-gr-preterito-perfeito-vs-imperfeito","languageId":"pt","category":"grammar","level":"A2","sourceText":"Pretérito perfeito vs. imperfeito","translations":{"tr":["Perfeito ile imperfeito farkı"]},"grammar":{"summary":"Perfeito tamamlanmış olayı, imperfeito arka planı, alışkanlığı ve betimlemeyi anlatır; bir hikâyede ikisi birlikte kullanılır.","uses":["Hikâye anlatmak: arka plan + olay","Bir kez olanla tekrarlananı ayırmak","Süren bir eylemin bir olayla kesilmesi"],"sections":[{"kind":"other","title":"Süren eylem + araya giren olay","formula":[{"tr":"Imperfeito (arka plan)","en":"Imperfeito","role":"v"},{"tr":"quando","en":"quando","role":"x"},{"tr":"Perfeito (olay)","en":"Perfeito","role":"v"}],"examples":[{"text":"[s:Eu] [v:estava dormindo] [x:quando] [s:o telefone] [v:tocou].","tr":"Telefon çaldığında uyuyordum."},{"text":"[s:Nós] [v:jantávamos] [x:quando] [s:ele] [v:chegou].","tr":"O geldiğinde akşam yemeği yiyorduk."}]},{"kind":"other","title":"Bir kez → perfeito, her zaman → imperfeito","formula":[{"tr":"Zaman ifadesi","en":"Expressão de tempo","role":"x"},{"tr":"Perfeito / Imperfeito","en":"Perfeito / Imperfeito","role":"v"}],"examples":[{"text":"[x:Ontem] [s:eu] [v:fui] à praia.","tr":"Dün plaja gittim."},{"text":"[x:Todo domingo] [s:eu] [v:ia] à praia.","tr":"Her pazar plaja giderdim."}]},{"kind":"other","title":"Betimleme → imperfeito","formula":[{"tr":"Imperfeito (sahne)","en":"Imperfeito","role":"v"},{"tr":"Perfeito (olay)","en":"Perfeito","role":"v"}],"examples":[{"text":"[v:Era] uma noite fria e [v:chovia] muito. De repente, alguém [v:bateu] na porta.","tr":"Soğuk bir geceydi ve çok yağmur yağıyordu. Birden biri kapıyı çaldı."}]},{"kind":"other","title":"Anlam değiştiren fiiller","formula":[{"tr":"Imperfeito","en":"Imperfeito","role":"v"},{"tr":"↔","en":"↔","role":"x"},{"tr":"Perfeito","en":"Perfeito","role":"v"}],"examples":[{"text":"[s:Eu] [v:conhecia] o Rio. / [s:Eu] [v:conheci] a Ana ontem.","tr":"Rio'yu biliyordum. / Ana'yla dün tanıştım."},{"text":"[s:Eu] [v:sabia]. / [s:Eu] [v:soube] da notícia hoje.","tr":"Biliyordum. / Haberi bugün öğrendim."}]}],"rules":["ontem, na semana passada, em 2010, de repente gibi belirli zaman ifadeleri genellikle perfeito ister.","sempre, todo dia, antigamente, quando era criança gibi ifadeler genellikle imperfeito ister.","Türkçede '-yordu / -rdı' imperfeito'ya, '-dı' perfeito'ya yakındır."],"exceptions":["Belirli bir süre boyunca olup biten durumlar perfeito olur: Morei dois anos em Lisboa."],"mistakes":[{"wrong":"Eu dormia quando o telefone tocava.","right":"Eu dormia quando o telefone tocou.","note":"Araya giren tek olay perfeito ile söylenir."},{"wrong":"Ontem eu ia ao cinema.","right":"Ontem eu fui ao cinema.","note":"Dün bir kez olan olay perfeito'dur (ia 'gidecektim' anlamı verir)."},{"wrong":"Quando era criança, fui à escola de bicicleta.","right":"Quando era criança, ia à escola de bicicleta.","note":"Geçmişteki alışkanlık imperfeito ile anlatılır."}]}},
  {"id":"pt-gr-pronomes-obliquos-objeto-direto","languageId":"pt","category":"grammar","level":"A2","sourceText":"Pronomes oblíquos: objeto direto","translations":{"tr":["Belirtili nesne zamirleri"]},"grammar":{"summary":"Belirtili nesne zamirleri (me, te, o/a, nos, os/as) Brezilya'da genellikle fiilden önce gelir; konuşmada o/a yerine ele/ela da kullanılır.","uses":["Tekrarı önlemek (Vi o filme → Eu o vi.)","'Beni, seni, onu' demek"],"sections":[{"kind":"other","title":"Zamir + fiil (Brezilya)","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Nesne zamiri","en":"Pronome oblíquo","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"[s:Eu] [o:te] [v:amo].","tr":"Seni seviyorum."},{"text":"[s:Ela] [o:me] [v:conhece] bem.","tr":"O beni iyi tanır."}],"notes":["me (beni), te (seni), o/a (onu, sizi), nos (bizi), os/as (onları, sizi)"]},{"kind":"other","title":"o / a / os / as (yazı dili)","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"o / a","en":"Pronome oblíquo","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"Você viu o João? — [s:Eu] [o:o] [v:vi] ontem.","tr":"João'yu gördün mü? — Dün gördüm."},{"text":"[s:Nós] [o:as] [v:convidamos].","tr":"Onları (kadınları) davet ettik."}]},{"kind":"other","title":"Mastardan sonra: -lo / -la","formula":[{"tr":"Fiil (-r düşer)","en":"Verbo","role":"v"},{"tr":"-lo / -la","en":"-lo / -la","role":"o"}],"examples":[{"text":"[a:Vou] [v:comprá]-[o:lo] amanhã.","tr":"Onu yarın alacağım."},{"text":"[a:Preciso] [v:vê]-[o:la].","tr":"Onu görmem lazım."}],"notes":["-r, -s, -z ile biten fiillerde son harf düşer ve o/a → lo/la olur."]},{"kind":"other","title":"Konuşma dili: ele / ela nesne olarak","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"ele / ela","en":"Pronome reto (informal)","role":"o"}],"examples":[{"text":"[s:Eu] [v:vi] [o:ele] no shopping.","tr":"Onu alışveriş merkezinde gördüm."},{"text":"[s:Você] [v:conhece] [o:ela]?","tr":"Onu tanıyor musun?"}],"notes":["Brezilya konuşmasında çok yaygındır ama resmî yazıda kullanılmaz."]}],"rules":["Brezilya'da zamir genellikle çekimli fiilden önce gelir (Eu te amo); Portekiz'de fiilden sonra gelir (Amo-te).","Olumsuz cümlelerde, soru kelimelerinden ve bazı zarflardan sonra zamir fiilden önce gelir: Não te vi.","Resmî yazıda cümle zamirle başlamaz (Me dá ✗ resmî), ama Brezilya konuşmasında Me dá isso! çok doğaldır."],"exceptions":["Genizden (nasal) biten fiillerden sonra o/a → no/na olur: Viram-no."],"mistakes":[{"wrong":"Ela conhece me.","right":"Ela me conhece.","note":"Brezilya'da zamir fiilden önce gelir."},{"wrong":"Vou comprar o.","right":"Vou comprá-lo. / Vou comprar ele (konuşma).","note":"Mastardan sonra o → lo olur."}]}},
  {"id":"pt-gr-pronomes-obliquos-objeto-indireto","languageId":"pt","category":"grammar","level":"A2","sourceText":"Pronomes oblíquos: objeto indireto","translations":{"tr":["Dolaylı nesne ve edatlı zamirler"]},"grammar":{"summary":"Dolaylı nesne zamirleri (me, te, lhe, nos, lhes) 'bana, sana, ona' anlamı verir; Brezilya konuşmasında çoğu zaman para + zamir kullanılır.","uses":["Bir şeyi birine vermek, söylemek, göstermek","Edattan sonra zamir kullanmak (para mim, com você)"],"sections":[{"kind":"other","title":"Dolaylı nesne zamiri + fiil","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"me / te / lhe / nos","en":"Objeto indireto","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Nesne","en":"Objeto direto","role":"x"}],"examples":[{"text":"[s:Ele] [o:me] [v:deu] [x:um presente].","tr":"Bana bir hediye verdi."},{"text":"[s:Eu] [o:lhe] [v:envio] [x:o documento].","tr":"Size belgeyi gönderiyorum. (resmî)"}],"notes":["lhe Brezilya'da daha çok resmî 'size' anlamında kullanılır."]},{"kind":"other","title":"para + zamir (Brezilya konuşması)","formula":[{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Nesne","en":"Objeto direto","role":"x"},{"tr":"para + zamir","en":"para + pronome","role":"o"}],"examples":[{"text":"[s:Eu] [v:dei] [x:o livro] [o:para ela].","tr":"Kitabı ona verdim."},{"text":"[v:Manda] [x:uma mensagem] [o:pra mim].","tr":"Bana bir mesaj at."}],"notes":["Konuşmada para → pra olur."]},{"kind":"other","title":"Edat + mim / ti / você / ele","formula":[{"tr":"Edat","en":"Preposição","role":"x"},{"tr":"mim / ti / você / ele / nós","en":"Pronome tônico","role":"o"}],"examples":[{"text":"Isso é [x:para] [o:mim]?","tr":"Bu benim için mi?"},{"text":"Ela gosta [x:de] [o:você].","tr":"O senden hoşlanıyor."}]},{"kind":"other","title":"com + zamir: comigo, conosco","formula":[{"tr":"com + zamir","en":"com + pronome","role":"o"}],"examples":[{"text":"Você vem [o:comigo]?","tr":"Benimle geliyor musun?"},{"text":"Eles jantaram [o:conosco].","tr":"Bizimle akşam yemeği yediler."}],"notes":["comigo (benimle), contigo (seninle), conosco (bizimle); com você, com ele normaldir."]}],"rules":["Edattan sonra eu değil mim kullanılır: para mim, sem mim.","Ama mastarın öznesi olduğunda eu kullanılır: Isso é para eu fazer.","com + eu/tu/nós özel biçim alır: comigo, contigo, conosco."],"exceptions":[],"mistakes":[{"wrong":"Isso é para eu.","right":"Isso é para mim.","note":"Edattan sonra mim gelir."},{"wrong":"Ela vai com mim.","right":"Ela vai comigo.","note":"com + mim = comigo."},{"wrong":"Ele vem com nós.","right":"Ele vem conosco.","note":"com + nós = conosco (Brezilya yazımı)."}]}},
  {"id":"pt-gr-verbos-reflexivos","languageId":"pt","category":"grammar","level":"A2","sourceText":"Verbos reflexivos","translations":{"tr":["Dönüşlü fiiller"]},"grammar":{"summary":"Dönüşlü fiiller eylemin özneye döndüğünü gösterir ve dönüşlü zamirle kullanılır: Eu me chamo, ele se levanta.","uses":["Günlük rutinler (levantar-se, vestir-se)","Ad söylemek (chamar-se)","Duygu ve zihinsel süreçler (lembrar-se, preocupar-se)","Karşılıklılık (Nós nos vemos amanhã.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Dönüşlü zamir","en":"Pronome reflexivo","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"x"}],"examples":[{"text":"[s:Eu] [o:me] [v:chamo] [x:Ana].","tr":"Adım Ana."},{"text":"[s:Ele] [o:se] [v:levanta] [x:às seis].","tr":"O altıda kalkar."}],"notes":["eu me · você/ele/ela se · nós nos · vocês/eles/elas se"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não","en":"não","role":"a"},{"tr":"Dönüşlü zamir","en":"Pronome reflexivo","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"[s:Eu] [a:não] [o:me] [v:lembro].","tr":"Hatırlamıyorum."},{"text":"[s:Ela] [a:não] [o:se] [v:preocupa] com nada.","tr":"Hiçbir şeyi dert etmez."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Dönüşlü zamir","en":"Pronome reflexivo","role":"o"},{"tr":"Fiil?","en":"Verbo?","role":"v"}],"examples":[{"text":"[s:Você] [o:se] [v:lembra] de mim?","tr":"Beni hatırlıyor musun?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Dönüşlü zamir + fiil?","en":"Pronome + verbo?","role":"v"}],"examples":[{"text":"[q:Como] [s:você] [v:se chama]?","tr":"Adın ne?"},{"text":"[q:A que horas] [s:vocês] [v:se levantam]?","tr":"Kaçta kalkıyorsunuz?"}]},{"kind":"other","title":"Mastarla: zamir araya ya da sona","formula":[{"tr":"Yardımcı fiil","en":"Verbo auxiliar","role":"a"},{"tr":"Zamir","en":"Pronome reflexivo","role":"o"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"[s:Eu] [a:vou] [o:me] [v:sentar] aqui.","tr":"Buraya oturacağım."},{"text":"[s:Nós] [a:precisamos] [o:nos] [v:apressar].","tr":"Acele etmemiz lazım."}]}],"rules":["Sözlükte dönüşlü fiiller -se ile yazılır: levantar-se, sentar-se, vestir-se.","Brezilya'da zamir genellikle fiilden önce gelir: Eu me levanto (Portekiz: Levanto-me).","Brezilya konuşmasında bazı fiillerde zamir düşebilir: Eu levanto cedo; a gente se vê kalıbı çok yaygındır."],"exceptions":[],"mistakes":[{"wrong":"Eu se chamo Pedro.","right":"Eu me chamo Pedro.","note":"Zamir özneye uyar: eu → me."},{"wrong":"Nós se vemos amanhã.","right":"Nós nos vemos amanhã. / A gente se vê amanhã.","note":"nós ile nos, a gente ile se kullanılır."},{"wrong":"Eu lembro-me de você. (Brezilya)","right":"Eu me lembro de você.","note":"Brezilya'da zamir fiilden önce gelir."}]}},
  {"id":"pt-gr-comparativos-e-superlativos","languageId":"pt","category":"grammar","level":"A2","sourceText":"Comparativos e superlativos","translations":{"tr":["Karşılaştırma ve üstünlük"]},"grammar":{"summary":"Karşılaştırma mais/menos ... (do) que ve tão ... quanto ile; üstünlük o mais ... de ve -íssimo ekiyle yapılır.","uses":["İki şeyi karşılaştırmak","Eşitlik bildirmek","Bir grubun en ...'ini söylemek","Çok yüksek derece bildirmek (lindíssimo)"],"sections":[{"kind":"other","title":"mais / menos ... (do) que","formula":[{"tr":"A","en":"Termo A","role":"s"},{"tr":"ser","en":"Verbo","role":"v"},{"tr":"mais / menos + sıfat","en":"mais / menos + adjetivo","role":"x"},{"tr":"(do) que B","en":"(do) que B","role":"o"}],"examples":[{"text":"[s:São Paulo] [v:é] [x:maior] [o:do que o Rio].","tr":"São Paulo Rio'dan büyüktür."},{"text":"[s:Este celular] [v:é] [x:mais barato] [o:que aquele].","tr":"Bu telefon ötekinden daha ucuz."}]},{"kind":"other","title":"Eşitlik: tão ... quanto / como","formula":[{"tr":"A","en":"Termo A","role":"s"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"tão + sıfat","en":"tão + adjetivo","role":"x"},{"tr":"quanto / como B","en":"quanto B","role":"o"}],"examples":[{"text":"[s:Ela] [v:é] [x:tão alta] [o:quanto o irmão].","tr":"O, erkek kardeşi kadar uzun."},{"text":"[s:Eu] [v:tenho] [x:tantos livros] [o:quanto você].","tr":"Senin kadar çok kitabım var."}],"notes":["İsimle tanto/tanta/tantos/tantas kullanılır."]},{"kind":"other","title":"Üstünlük: o mais ... de","formula":[{"tr":"Artikel","en":"Artigo","role":"x"},{"tr":"(İsim) + mais/menos + sıfat","en":"mais + adjetivo","role":"x"},{"tr":"de + grup","en":"de + grupo","role":"o"}],"examples":[{"text":"[s:Ele] [v:é] [x:o aluno mais alto] [o:da turma].","tr":"O sınıfın en uzun öğrencisi."},{"text":"[s:Esta] [v:é] [x:a melhor pizza] [o:da cidade].","tr":"Bu şehrin en iyi pizzası."}]},{"kind":"other","title":"Mutlak üstünlük: -íssimo","formula":[{"tr":"Sıfat + -íssimo","en":"Superlativo absoluto","role":"x"}],"examples":[{"text":"A praia é [x:lindíssima].","tr":"Plaj çok çok güzel."},{"text":"O filme foi [x:chatíssimo].","tr":"Film son derece sıkıcıydı."}]}],"rules":["Düzensiz: bom → melhor, mau/ruim → pior, grande → maior, pequeno → menor.","do que ve que ikisi de doğrudur; konuşmada do que daha yaygındır.","Üstünlükte grup de ile verilir (da turma), que ile değil."],"exceptions":["Avrupa Portekizcesinde mais pequeno de kullanılır; Brezilya'da menor tercih edilir."],"mistakes":[{"wrong":"mais bom","right":"melhor","note":"bom'un karşılaştırması düzensizdir."},{"wrong":"mais grande","right":"maior","note":"grande → maior."},{"wrong":"o mais alto que a turma","right":"o mais alto da turma","note":"Üstünlükte grup de ile söylenir."}]}},
  {"id":"pt-gr-imperativo","languageId":"pt","category":"grammar","level":"A2","sourceText":"Imperativo","translations":{"tr":["Emir kipi"]},"grammar":{"summary":"Emir kipi rica, talimat ve emir verir; você için biçimler subjuntivo'dan gelir (fale, coma), Brezilya konuşmasında tu biçimi (fala, come) de çok yaygındır.","uses":["Talimat ve yol tarifi","Rica ve öneri","Yasak ve uyarı (Não fume!)"],"sections":[{"kind":"affirmative","title":"Olumlu emir (você / vocês)","formula":[{"tr":"Fiil (emir)","en":"Verbo no imperativo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Fale] [o:mais devagar], por favor.","tr":"Lütfen daha yavaş konuşun."},{"text":"[v:Abram] [o:os livros] na página 10.","tr":"Kitaplarınızı 10. sayfada açın."}],"notes":["-ar → -e / -em (fale, falem); -er/-ir → -a / -am (coma, abra, comam)"]},{"kind":"negative","title":"Olumsuz emir","formula":[{"tr":"não","en":"não","role":"a"},{"tr":"Fiil (subjuntivo biçimi)","en":"Verbo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[a:Não] [v:fume] [o:aqui].","tr":"Burada sigara içmeyin."},{"text":"[a:Não] [v:se preocupe]!","tr":"Merak etme!"}]},{"kind":"other","title":"Günlük Brezilya: tu biçimi","formula":[{"tr":"Fiil (ele/ela biçimi)","en":"Imperativo (informal)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Fala] [o:comigo]!","tr":"Konuş benimle!"},{"text":"[v:Vem] [o:cá]! [v:Olha] [o:isso]!","tr":"Gel buraya! Şuna bak!"}],"notes":["Konuşmada sıcak ve samimi durur; resmî durumda fale, venha tercih edilir."]},{"kind":"other","title":"Düzensiz emirler","formula":[{"tr":"Düzensiz biçim","en":"Imperativo irregular","role":"v"}],"examples":[{"text":"[v:Seja] paciente. [v:Tenha] calma.","tr":"Sabırlı ol. Sakin ol."},{"text":"[v:Faça] o dever. [v:Diga] a verdade. [v:Vá] embora.","tr":"Ödevini yap. Doğruyu söyle. Git buradan."}],"notes":["ser → seja, estar → esteja, ir → vá, dar → dê, saber → saiba, fazer → faça, ter → tenha, vir → venha"]},{"kind":"other","title":"nós: vamos + mastar","formula":[{"tr":"vamos","en":"vamos","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"[a:Vamos] [v:começar]!","tr":"Başlayalım!"}]}],"rules":["Emir biçimi eu formundan türer: faço → faça, tenho → tenha, digo → diga.","Kibar rica için çoğu zaman soru kullanılır: Você pode fechar a porta?","Yazımda -car/-gar fiilleri değişir: ficar → fique, chegar → chegue."],"exceptions":[],"mistakes":[{"wrong":"Não fala isso! (resmî metinde)","right":"Não fale isso!","note":"Standart olumsuz emir subjuntivo biçimini kullanır; Não fala konuşmada duyulur."},{"wrong":"Faze o trabalho.","right":"Faça o trabalho. / Faz o trabalho (gayriresmî).","note":"fazer'in emri düzensizdir."}]}}
]
