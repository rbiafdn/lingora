[
  {"id":"pt-gr-futuro-do-presente","languageId":"pt","category":"grammar","level":"B1","sourceText":"Futuro do presente","translations":{"tr":["Gelecek zaman (-acak/-ecek)"]},"grammar":{"summary":"Futuro do presente (falarei, comerá) mastara ek getirilerek yapılır; Brezilya'da daha çok yazıda, haberlerde ve resmî dilde kullanılır.","uses":["Resmî ya da yazılı gelecek ifadeleri","Söz ve kehanetler","Tahmin ve şüphe (Será que ...?)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Mastar + -ei/-á/-emos/-ão","en":"Futuro do presente","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:O presidente] [v:viajará] [o:para Lisboa] amanhã.","tr":"Cumhurbaşkanı yarın Lizbon'a gidecek."},{"text":"[s:Eu] [v:farei] [o:o possível].","tr":"Elimden geleni yapacağım."}],"notes":["falar: falarei, falará, falaremos, falarão","Düzensiz: fazer → farei, dizer → direi, trazer → trarei"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não","en":"não","role":"a"},{"tr":"Fiil (futuro)","en":"Verbo no futuro","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:A loja] [a:não] [v:abrirá] [o:no feriado].","tr":"Mağaza bayramda açılmayacak."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil (futuro)","en":"Verbo no futuro","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[s:Os resultados] [v:sairão] [o:hoje]?","tr":"Sonuçlar bugün açıklanacak mı?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Fiil (futuro)","en":"Verbo no futuro","role":"v"},{"tr":"Özne?","en":"Sujeito?","role":"s"}],"examples":[{"text":"[q:Quando] [v:será] [s:a reunião]?","tr":"Toplantı ne zaman olacak?"}]},{"kind":"other","title":"Será que ...? (acaba)","formula":[{"tr":"Será que","en":"Será que","role":"q"},{"tr":"Cümle","en":"Oração","role":"o"}],"examples":[{"text":"[q:Será que] [o:vai chover]?","tr":"Acaba yağmur yağacak mı?"},{"text":"[q:Será que] [o:ele esqueceu]?","tr":"Acaba unuttu mu?"}]}],"rules":["Ekler bütün fiillerde aynıdır ve mastarın sonuna eklenir: -ei, -á, -emos, -ão.","Günlük konuşmada bunun yerine ir + mastar kullanılır: Vou falar (falarei yerine).","Zamirle resmî yazıda zamir araya girer (mesóclise): Dir-lhe-ei; Brezilya konuşmasında Vou te dizer denir."],"exceptions":["Yalnızca üç düzensiz fiil vardır: fazer (far-), dizer (dir-), trazer (trar-)."],"mistakes":[{"wrong":"Eu fazerei isso.","right":"Eu farei isso.","note":"fazer'in gelecek kökü far- olur."},{"wrong":"Eu dizerei a verdade.","right":"Eu direi a verdade.","note":"dizer'in gelecek kökü dir- olur."}]}},
  {"id":"pt-gr-futuro-do-preterito","languageId":"pt","category":"grammar","level":"B1","sourceText":"Futuro do pretérito","translations":{"tr":["Şart kipi (-ardı / -ecekti)"]},"grammar":{"summary":"Futuro do pretérito (falaria, faria) kibar istekleri, varsayımları ve geçmişe göre geleceği anlatır.","uses":["Kibar istek (Você poderia me ajudar?)","Varsayım ve hayal (Eu moraria na praia.)","Öneri (Eu falaria com ele.)","Geçmişten bakınca gelecek (Ele disse que viria.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Mastar + -ia/-íamos/-iam","en":"Futuro do pretérito","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Eu] [v:moraria] [o:perto do mar].","tr":"Deniz kenarında yaşardım."},{"text":"[s:Ele] [v:disse] que [v:viria] [o:mais tarde].","tr":"Daha sonra geleceğini söyledi."}],"notes":["falar: falaria, falaria, falaríamos, falariam","Düzensiz: fazer → faria, dizer → diria, trazer → traria"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não","en":"não","role":"a"},{"tr":"Fiil (-ia)","en":"Verbo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Eu] [a:não] [v:faria] [o:isso] no seu lugar.","tr":"Senin yerinde olsam bunu yapmazdım."}]},{"kind":"question","title":"Soru cümlesi (kibar rica)","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil (-ia)","en":"Verbo","role":"v"},{"tr":"Mastar?","en":"Infinitivo?","role":"o"}],"examples":[{"text":"[s:Você] [v:poderia] [o:fechar a janela]?","tr":"Pencereyi kapatabilir misiniz?"},{"text":"[s:Você] [v:gostaria] [o:de um café]?","tr":"Bir kahve ister miydiniz?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Fiil (-ia)?","en":"Verbo?","role":"v"}],"examples":[{"text":"[q:O que] [s:você] [v:faria] com um milhão?","tr":"Bir milyonla ne yapardın?"},{"text":"[q:Onde] [s:você] [v:gostaria] de morar?","tr":"Nerede yaşamak isterdin?"}]}],"rules":["Ekler mastarın sonuna eklenir ve tüm fiillerde aynıdır: -ia, -ia, -íamos, -iam.","Gerçek dışı şart cümlesinde se + imperfeito do subjuntivo ile kullanılır: Se eu tivesse tempo, viajaria.","Brezilya konuşmasında sık sık imperfeito ile değiştirilir: Eu ia adorar (Eu adoraria)."],"exceptions":[],"mistakes":[{"wrong":"Eu fazeria isso.","right":"Eu faria isso.","note":"fazer'in kökü far- olur."},{"wrong":"Se eu teria dinheiro, viajaria.","right":"Se eu tivesse dinheiro, viajaria.","note":"se'den sonra futuro do pretérito değil, imperfeito do subjuntivo gelir."}]}},
  {"id":"pt-gr-preterito-perfeito-composto","languageId":"pt","category":"grammar","level":"B1","sourceText":"Pretérito perfeito composto","translations":{"tr":["Yakın geçmişten süregelen eylem (tenho feito)"]},"grammar":{"summary":"ter (presente) + particípio, son zamanlarda tekrar eden ya da süregelen eylemleri anlatır; İngilizcedeki present perfect ile aynı değildir.","uses":["Son zamanlarda tekrarlanan eylemler (Tenho dormido mal.)","Geçmişte başlayıp hâlâ süren durumlar","ultimamente, nos últimos dias gibi ifadelerle"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ter (tenho/tem/temos/têm)","en":"ter (presente)","role":"a"},{"tr":"Particípio","en":"Particípio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Eu] [a:tenho] [v:estudado] [o:muito] ultimamente.","tr":"Son zamanlarda çok çalışıyorum."},{"text":"[a:Tem] [v:chovido] [o:todos os dias].","tr":"Her gün yağmur yağıp duruyor."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não + ter","en":"não + ter","role":"a"},{"tr":"Particípio","en":"Particípio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Ela] [a:não tem] [v:dormido] [o:bem].","tr":"Son zamanlarda iyi uyuyamıyor."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ter","en":"ter","role":"a"},{"tr":"Particípio","en":"Particípio","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[s:Você] [a:tem] [v:visto] [o:o Paulo]?","tr":"Son zamanlarda Paulo'yu görüyor musun?"}]},{"kind":"other","title":"Composto ↔ perfeito simples","formula":[{"tr":"tenho + particípio (tekrar/süreç)","en":"Perfeito composto","role":"v"},{"tr":"↔","en":"↔","role":"x"},{"tr":"Perfeito simples (tek olay)","en":"Perfeito simples","role":"v"}],"examples":[{"text":"[s:Eu] [v:tenho lido] muito. / [s:Eu] [v:li] esse livro.","tr":"Son zamanlarda çok okuyorum. / O kitabı okudum."},{"text":"[s:Você] [a:já] [v:foi] a Portugal?","tr":"Hiç Portekiz'e gittin mi?"}]}],"rules":["Tek seferlik ya da bitmiş bir eylem için kullanılmaz; o durumda perfeito simples gelir: Já comi.","Particípio bu yapıda değişmez (cinsiyet/sayı almaz).","'Hiç ... yaptın mı?' soruları Portekizcede perfeito simples ile sorulur: Você já viu?"],"exceptions":[],"mistakes":[{"wrong":"Eu tenho visto esse filme. (bir kez gördüm anlamında)","right":"Eu já vi esse filme.","note":"Bir kez olmuş deneyim perfeito simples ile söylenir."},{"wrong":"Ultimamente eu estudei muito.","right":"Ultimamente eu tenho estudado muito.","note":"Son zamanlarda süregelen eylem için composto daha doğaldır."}]}},
  {"id":"pt-gr-participio-passado","languageId":"pt","category":"grammar","level":"B1","sourceText":"Particípio passado","translations":{"tr":["Geçmiş zaman ortacı (particípio)"]},"grammar":{"summary":"Particípio -ado / -ido ile yapılır; ter ile birleşik zamanlarda değişmez, ser/estar ile sıfat gibi isme uyar.","uses":["Birleşik zamanlar (tenho feito, tinha feito)","Edilgen çatı (foi feito)","Sonuç durumu (A porta está aberta.)"],"sections":[{"kind":"other","title":"Düzenli: -ar → -ado, -er/-ir → -ido","formula":[{"tr":"Fiil kökü","en":"Radical","role":"v"},{"tr":"+ -ado / -ido","en":"+ -ado / -ido","role":"x"}],"examples":[{"text":"falar → [v:falado], comer → [v:comido], partir → [v:partido]","tr":"konuşulmuş, yenmiş, ayrılmış"}]},{"kind":"other","title":"Düzensiz particípio'lar","formula":[{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"→","en":"→","role":"x"},{"tr":"Düzensiz particípio","en":"Particípio irregular","role":"v"}],"examples":[{"text":"fazer → [v:feito], dizer → [v:dito], escrever → [v:escrito], ver → [v:visto]","tr":"yapılmış, söylenmiş, yazılmış, görülmüş"},{"text":"abrir → [v:aberto], pôr → [v:posto], vir → [v:vindo], pagar → [v:pago]","tr":"açılmış, konmuş, gelmiş, ödenmiş"}]},{"kind":"other","title":"ter + particípio: değişmez","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ter","en":"ter","role":"a"},{"tr":"Particípio (değişmez)","en":"Particípio invariável","role":"v"}],"examples":[{"text":"[s:Ela] [a:tinha] [v:escrito] duas cartas.","tr":"O iki mektup yazmıştı."}]},{"kind":"other","title":"ser / estar + particípio: uyumlu","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"ser / estar","en":"ser / estar","role":"a"},{"tr":"Particípio (uyumlu)","en":"Particípio variável","role":"v"}],"examples":[{"text":"[s:A porta] [a:está] [v:aberta].","tr":"Kapı açık."},{"text":"[s:As cartas] [a:foram] [v:escritas] ontem.","tr":"Mektuplar dün yazıldı."}]}],"rules":["Bazı fiillerin iki particípio'su vardır: ter ile düzenli, ser/estar ile kısa biçim tercih edilir (ter aceitado / ser aceito).","Çift particípio örnekleri: aceitar (aceitado / aceito), entregar (entregado / entregue), imprimir (imprimido / impresso), matar (matado / morto).","Brezilya'da ganhar, gastar, pagar ile çoğunlukla kısa biçim kullanılır: tenho ganho, tinha pago."],"exceptions":[],"mistakes":[{"wrong":"Eu tenho escrevido.","right":"Eu tenho escrito.","note":"escrever'in particípio'su düzensizdir: escrito."},{"wrong":"A janela está aberto.","right":"A janela está aberta.","note":"estar ile particípio isme uyar."},{"wrong":"Eu tinha abrido a porta.","right":"Eu tinha aberto a porta.","note":"abrir → aberto."}]}},
  {"id":"pt-gr-preterito-mais-que-perfeito-composto","languageId":"pt","category":"grammar","level":"B1","sourceText":"Pretérito mais-que-perfeito composto","translations":{"tr":["Miş'li geçmiş (geçmişten önceki geçmiş)"]},"grammar":{"summary":"tinha + particípio, geçmişteki bir olaydan daha önce olmuş eylemi anlatır: Quando cheguei, ele já tinha saído.","uses":["Geçmişteki iki olaydan öncekini belirtmek","Dolaylı anlatımda perfeito'nun geçmişe kayması","'Daha önce hiç ... yapmamıştım' demek"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"tinha / tínhamos / tinham","en":"ter (imperfeito)","role":"a"},{"tr":"Particípio","en":"Particípio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"Quando cheguei, [s:o filme] [a:já tinha] [v:começado].","tr":"Vardığımda film çoktan başlamıştı."},{"text":"[s:Ela] [a:tinha] [v:perdido] [o:a chave].","tr":"O anahtarı kaybetmişti."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"não + tinha","en":"não + ter","role":"a"},{"tr":"Particípio","en":"Particípio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Eu] [a:nunca tinha] [v:visto] [o:a neve] antes.","tr":"Daha önce hiç kar görmemiştim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"tinha","en":"ter","role":"a"},{"tr":"Particípio","en":"Particípio","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[s:Você] [a:já tinha] [v:estado] [o:no Brasil]?","tr":"Daha önce Brezilya'da bulunmuş muydun?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Pronome interrogativo","role":"q"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"tinha + particípio?","en":"ter + particípio?","role":"v"}],"examples":[{"text":"[q:O que] [s:ele] [v:tinha dito] antes?","tr":"Daha önce ne söylemişti?"}]}],"rules":["Yardımcı fiil ter'in imperfeito'su (tinha) kullanılır, particípio değişmez.","Yazı dilinde haver de kullanılabilir: havia saído.","Basit biçim (falara, fizera) edebi dildedir; konuşmada tinha + particípio kullanılır."],"exceptions":[],"mistakes":[{"wrong":"Quando cheguei, ele já saiu.","right":"Quando cheguei, ele já tinha saído.","note":"Daha önce olan olay mais-que-perfeito ile verilir."},{"wrong":"Eu tinha fazido tudo.","right":"Eu tinha feito tudo.","note":"fazer → feito."}]}},
  {"id":"pt-gr-presente-do-subjuntivo-formacao","languageId":"pt","category":"grammar","level":"B1","sourceText":"Presente do subjuntivo: formação","translations":{"tr":["Dilek kipi (subjuntivo): yapılışı"]},"grammar":{"summary":"Presente do subjuntivo, presente'deki eu formundan -o atılıp 'ters' ek getirilerek yapılır: falar → fale, comer → coma, fazer (faço) → faça.","uses":["que ile kurulan dilek, istek, şüphe, duygu cümleleri","Olumsuz emir ve você emirleri","talvez ile olasılık"],"sections":[{"kind":"other","title":"-ar fiilleri → -e","formula":[{"tr":"que","en":"que","role":"x"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Kök + -e / -emos / -em","en":"Subjuntivo (-ar)","role":"v"}],"examples":[{"text":"Espero [x:que] [s:você] [v:goste].","tr":"Umarım beğenirsin."},{"text":"É importante [x:que] [s:nós] [v:falemos] com ele.","tr":"Onunla konuşmamız önemli."}]},{"kind":"other","title":"-er / -ir fiilleri → -a","formula":[{"tr":"que","en":"que","role":"x"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Kök + -a / -amos / -am","en":"Subjuntivo (-er/-ir)","role":"v"}],"examples":[{"text":"Quero [x:que] [s:vocês] [v:comam] bem.","tr":"İyi yemenizi istiyorum."},{"text":"Talvez [s:ele] [v:abra] a loja mais tarde.","tr":"Belki dükkânı daha geç açar."}]},{"kind":"other","title":"eu formundan türeyenler","formula":[{"tr":"eu formu (presente)","en":"1ª pessoa do presente","role":"v"},{"tr":"→","en":"→","role":"x"},{"tr":"Subjuntivo","en":"Subjuntivo","role":"v"}],"examples":[{"text":"faço → [v:faça], tenho → [v:tenha], digo → [v:diga], posso → [v:possa]","tr":"yapayım, sahip olayım, söyleyeyim, yapabileyim"},{"text":"É melhor que você [v:venha] cedo.","tr":"Erken gelmen daha iyi olur."}]},{"kind":"other","title":"Tamamen düzensizler","formula":[{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"→","en":"→","role":"x"},{"tr":"Düzensiz subjuntivo","en":"Subjuntivo irregular","role":"v"}],"examples":[{"text":"ser → [v:seja], estar → [v:esteja], ir → [v:vá], dar → [v:dê]","tr":"ser, estar, ir, dar"},{"text":"saber → [v:saiba], querer → [v:queira], haver → [v:haja]","tr":"saber, querer, haver"}]}],"rules":["Kural: eu formundan -o düşer, -ar fiilleri -e, -er/-ir fiilleri -a eki alır.","Yazım: -car → -que (ficar → fique), -gar → -gue (pagar → pague), -çar → -ce (começar → comece).","Tekil 1. ve 3. şahıs aynıdır: que eu fale, que ele fale."],"exceptions":["Yedi düzensiz fiil ezberlenir: ser, estar, ir, dar, saber, querer, haver."],"mistakes":[{"wrong":"Ele quer que eu faço isso.","right":"Ele quer que eu faça isso.","note":"İstek bildiren cümleden sonra subjuntivo gelir."},{"wrong":"Espero que ele sabe.","right":"Espero que ele saiba.","note":"saber'in subjuntivo'su düzensizdir: saiba."},{"wrong":"Talvez ele vai.","right":"Talvez ele vá.","note":"Fiilden önce gelen talvez subjuntivo ister."}]}},
  {"id":"pt-gr-presente-do-subjuntivo-usos","languageId":"pt","category":"grammar","level":"B1","sourceText":"Presente do subjuntivo: usos","translations":{"tr":["Dilek kipi (subjuntivo): kullanımı"]},"grammar":{"summary":"Subjuntivo, ana cümlede istek, duygu, şüphe veya gereklilik varsa que'den sonra; ayrıca para que, embora gibi bağlaçlardan sonra kullanılır.","uses":["İstek ve rica (Quero que ...)","Duygu (Fico feliz que ...)","Şüphe ve olasılık (Duvido que ..., Talvez ...)","Kişisiz yargılar (É importante que ...)"],"sections":[{"kind":"other","title":"İstek / umut + que","formula":[{"tr":"Ana cümle (istek)","en":"Oração principal","role":"s"},{"tr":"que","en":"que","role":"x"},{"tr":"Yeni özne + subjuntivo","en":"Sujeito + subjuntivo","role":"v"}],"examples":[{"text":"[s:Eu quero] [x:que] [v:você venha] comigo.","tr":"Benimle gelmeni istiyorum."},{"text":"[s:Espero] [x:que] [v:dê] tudo certo.","tr":"Umarım her şey yolunda gider."}]},{"kind":"other","title":"Duygu ve şüphe + que","formula":[{"tr":"Duygu / Şüphe","en":"Emoção / Dúvida","role":"s"},{"tr":"que","en":"que","role":"x"},{"tr":"Subjuntivo","en":"Subjuntivo","role":"v"}],"examples":[{"text":"[s:Fico feliz] [x:que] [v:você esteja] aqui.","tr":"Burada olmana sevindim."},{"text":"[s:Duvido] [x:que] [v:ele saiba] a verdade.","tr":"Onun gerçeği bildiğinden şüpheliyim."}]},{"kind":"other","title":"Kişisiz ifadeler: É ... que","formula":[{"tr":"É importante / preciso / bom","en":"Expressão impessoal","role":"s"},{"tr":"que","en":"que","role":"x"},{"tr":"Subjuntivo","en":"Subjuntivo","role":"v"}],"examples":[{"text":"[s:É preciso] [x:que] [v:vocês cheguem] cedo.","tr":"Erken gelmeniz gerekiyor."},{"text":"[s:É possível] [x:que] [v:chova] amanhã.","tr":"Yarın yağmur yağması mümkün."}]},{"kind":"other","title":"Bağlaçlar: para que, embora, antes que, caso","formula":[{"tr":"Bağlaç","en":"Conjunção","role":"x"},{"tr":"Özne + subjuntivo","en":"Sujeito + subjuntivo","role":"v"}],"examples":[{"text":"[x:Embora] [v:esteja] cansado, vou à festa.","tr":"Yorgun olsam da partiye gideceğim."},{"text":"Vou explicar de novo [x:para que] [v:todos entendam].","tr":"Herkes anlasın diye tekrar açıklayacağım."}]}],"rules":["Özne aynıysa subjuntivo yerine mastar kullanılır: Quero sair (Quero que eu saia ✗).","achar que / acreditar que olumluyken indicativo, olumsuzken subjuntivo ister: Acho que ele está / Não acho que ele esteja.","talvez fiilden önceyse subjuntivo gelir: Talvez eu vá."],"exceptions":[],"mistakes":[{"wrong":"Espero que você vem.","right":"Espero que você venha.","note":"esperar que subjuntivo ister."},{"wrong":"Eu quero que eu viaje.","right":"Eu quero viajar.","note":"Özne aynıysa mastar kullanılır."},{"wrong":"Acho que ele esteja em casa.","right":"Acho que ele está em casa.","note":"Olumlu achar que indicativo ister."}]}},
  {"id":"pt-gr-futuro-do-subjuntivo","languageId":"pt","category":"grammar","level":"B1","sourceText":"Futuro do subjuntivo","translations":{"tr":["Gelecek dilek kipi (se / quando + fiil)"]},"grammar":{"summary":"Portekizceye özgü futuro do subjuntivo, se, quando, assim que gibi bağlaçlardan sonra gelecekteki olası durumları anlatır: Se eu puder, vou.","uses":["Gelecekte gerçekleşebilecek şart (se + futuro do subjuntivo)","Gelecek zaman bağlaçları (quando, assim que, enquanto, logo que)","Belirsiz kişi/şey (Quem quiser, pode vir.)"],"sections":[{"kind":"other","title":"Yapılışı: perfeito 3. çoğul -ram → -r","formula":[{"tr":"eles + perfeito (-ram)","en":"3ª pessoa do plural do perfeito","role":"v"},{"tr":"→","en":"→","role":"x"},{"tr":"-r / -rmos / -rem","en":"Futuro do subjuntivo","role":"v"}],"examples":[{"text":"fizeram → [v:fizer], tiveram → [v:tiver], puderam → [v:puder]","tr":"yaparsam, sahip olursam, yapabilirsem"},{"text":"foram → [v:for], estiveram → [v:estiver], quiseram → [v:quiser], vieram → [v:vier]","tr":"olursam/gidersem, olursam, istersem, gelirsem"}],"notes":["Düzenli fiillerde mastarla aynı görünür: falar → se eu falar, se nós falarmos, se eles falarem."]},{"kind":"other","title":"se + futuro do subjuntivo","formula":[{"tr":"se","en":"se","role":"x"},{"tr":"Özne + futuro do subjuntivo","en":"Futuro do subjuntivo","role":"v"},{"tr":"Ana cümle (gelecek/emir)","en":"Oração principal","role":"o"}],"examples":[{"text":"[x:Se] [v:você puder], [o:me liga].","tr":"Yapabilirsen beni ara."},{"text":"[x:Se] [v:fizer] sol, [o:vamos à praia].","tr":"Güneşli olursa plaja gideriz."}]},{"kind":"other","title":"quando / assim que + futuro do subjuntivo","formula":[{"tr":"quando / assim que","en":"Conjunção temporal","role":"x"},{"tr":"Futuro do subjuntivo","en":"Futuro do subjuntivo","role":"v"},{"tr":"Ana cümle","en":"Oração principal","role":"o"}],"examples":[{"text":"[x:Quando] [v:eu chegar], [o:te aviso].","tr":"Vardığımda sana haber veririm."},{"text":"[x:Assim que] [v:tiver] tempo, [o:vou te visitar].","tr":"Vaktim olur olmaz seni ziyaret edeceğim."}]},{"kind":"other","title":"quem / o que / onde + futuro do subjuntivo","formula":[{"tr":"quem / o que / onde","en":"Pronome relativo","role":"x"},{"tr":"Futuro do subjuntivo","en":"Futuro do subjuntivo","role":"v"}],"examples":[{"text":"[x:Quem] [v:quiser], pode participar.","tr":"İsteyen katılabilir."},{"text":"Faça [x:o que] [v:achar] melhor.","tr":"En iyi bulduğun neyse onu yap."}]}],"rules":["Türkçedeki '-ırsa / -dığında' (gelecekte) çoğunlukla futuro do subjuntivo ile karşılanır.","Ana cümle presente, futuro, ir + mastar veya emir olur: Se chover, fico em casa.","ver → vir (se eu vir), vir → vier (se ele vier); karıştırılmamalı."],"exceptions":[],"mistakes":[{"wrong":"Se eu posso, vou.","right":"Se eu puder, vou.","note":"Gelecekteki olası şartta futuro do subjuntivo kullanılır."},{"wrong":"Quando eu chego em casa, vou te ligar.","right":"Quando eu chegar em casa, vou te ligar.","note":"Gelecekteki bir an için quando + futuro do subjuntivo gelir."},{"wrong":"Se ele vem, me avisa.","right":"Se ele vier, me avisa.","note":"vir'in futuro do subjuntivo'su vier'dir."}]}},
  {"id":"pt-gr-pronomes-relativos","languageId":"pt","category":"grammar","level":"B1","sourceText":"Pronomes relativos","translations":{"tr":["İlgi zamirleri"]},"grammar":{"summary":"İlgi zamirleri (que, quem, onde, o qual, cujo) iki cümleyi bağlayıp bir ismi tanımlar: o livro que comprei.","uses":["Kişi veya şeyi tanımlamak","Yer bildirmek (a cidade onde moro)","Sahiplik bildirmek (cujo)"],"sections":[{"kind":"other","title":"que: kişi ve şey","formula":[{"tr":"İsim","en":"Antecedente","role":"o"},{"tr":"que","en":"que","role":"x"},{"tr":"İlgi cümlesi","en":"Oração relativa","role":"v"}],"examples":[{"text":"[o:O livro] [x:que] [v:comprei] é ótimo.","tr":"Aldığım kitap harika."},{"text":"[o:A mulher] [x:que] [v:mora aqui] é médica.","tr":"Burada oturan kadın doktor."}]},{"kind":"other","title":"Edat + quem (kişi) / que (şey)","formula":[{"tr":"İsim","en":"Antecedente","role":"o"},{"tr":"Edat + quem / que","en":"Preposição + quem / que","role":"x"},{"tr":"İlgi cümlesi","en":"Oração relativa","role":"v"}],"examples":[{"text":"[o:A pessoa] [x:com quem] [v:falei] é o diretor.","tr":"Konuştuğum kişi müdür."},{"text":"[o:O filme] [x:de que] [v:te falei] estreou.","tr":"Sana bahsettiğim film vizyona girdi."}]},{"kind":"other","title":"onde: yer","formula":[{"tr":"Yer","en":"Lugar","role":"o"},{"tr":"onde","en":"onde","role":"x"},{"tr":"İlgi cümlesi","en":"Oração relativa","role":"v"}],"examples":[{"text":"[o:A cidade] [x:onde] [v:nasci] é pequena.","tr":"Doğduğum şehir küçük."}]},{"kind":"other","title":"cujo / cuja: sahiplik","formula":[{"tr":"Sahip","en":"Antecedente","role":"o"},{"tr":"cujo / cuja (+ isim)","en":"cujo","role":"x"},{"tr":"İlgi cümlesi","en":"Oração relativa","role":"v"}],"examples":[{"text":"[o:O autor] [x:cujo livro] [v:li] vem ao Brasil.","tr":"Kitabını okuduğum yazar Brezilya'ya geliyor."}],"notes":["cujo sahip olunan isme uyar: cuja casa, cujos filhos; ardından artikel gelmez."]}],"rules":["que en yaygın ilgi zamiridir; kişi ve şey için kullanılır.","quem yalnızca kişiler için ve genellikle edattan sonra kullanılır: a pessoa de quem gosto.","o qual / a qual daha resmîdir ve uzun edatlardan sonra tercih edilir: a empresa para a qual trabalho."],"exceptions":["Brezilya konuşmasında edat sık düşer (a cidade que eu moro); yazıda edat korunur: a cidade em que / onde moro."],"mistakes":[{"wrong":"O homem quem eu vi.","right":"O homem que eu vi.","note":"Edat yoksa kişi için de que kullanılır."},{"wrong":"A casa cuja a porta é azul.","right":"A casa cuja porta é azul.","note":"cujo'dan sonra artikel gelmez."},{"wrong":"A pessoa que eu gosto. (yazıda)","right":"A pessoa de quem eu gosto.","note":"gostar de edatı ilgi zamirinin önüne geçer."}]}},
  {"id":"pt-gr-voz-passiva","languageId":"pt","category":"grammar","level":"B1","sourceText":"Voz passiva","translations":{"tr":["Edilgen çatı"]},"grammar":{"summary":"Edilgen çatı ser + particípio (+ por) ile ya da se ile kurulur; particípio özneye uyar: A casa foi construída em 1990.","uses":["Eylemi yapanın önemsiz ya da bilinmediği durumlar","Haber ve resmî dil","İlan ve tabelalar (Vende-se, Aluga-se)"],"sections":[{"kind":"other","title":"Etken → Edilgen","formula":[{"tr":"Nesne → Özne","en":"Sujeito paciente","role":"s"},{"tr":"ser (zamana göre)","en":"ser","role":"a"},{"tr":"Particípio (uyumlu)","en":"Particípio","role":"v"},{"tr":"por / pelo + yapan","en":"Agente da passiva","role":"o"}],"examples":[{"text":"[s:O livro] [a:foi] [v:escrito] [o:por Machado de Assis].","tr":"Kitap Machado de Assis tarafından yazıldı."},{"text":"[s:As casas] [a:foram] [v:vendidas] [o:pela empresa].","tr":"Evler şirket tarafından satıldı."}]},{"kind":"other","title":"Farklı zamanlarda edilgen","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"é / foi / será / está sendo","en":"ser (tempos)","role":"a"},{"tr":"Particípio","en":"Particípio","role":"v"}],"examples":[{"text":"[s:A ponte] [a:será] [v:inaugurada] em maio.","tr":"Köprü mayısta açılacak."},{"text":"[s:O caso] [a:está sendo] [v:investigado].","tr":"Olay soruşturuluyor."}]},{"kind":"other","title":"se ile edilgen (passiva sintética)","formula":[{"tr":"Fiil (nesneye uyar)","en":"Verbo","role":"v"},{"tr":"-se","en":"-se","role":"x"},{"tr":"Özne","en":"Sujeito","role":"s"}],"examples":[{"text":"[v:Vende]-[x:se] [s:esta casa].","tr":"Bu ev satılıktır."},{"text":"[v:Alugam]-[x:se] [s:apartamentos].","tr":"Daire kiralanır."}]}],"rules":["Particípio edilgen özneye cinsiyet ve sayı bakımından uyar: foi construído / foi construída.","Yapan kişi por ile verilir ve artikelle birleşir: pelo, pela, pelos, pelas.","Brezilya konuşmasında edilgen yerine çoğu zaman 3. çoğul etken kullanılır: Roubaram meu celular."],"exceptions":["Konuşmada Vende-se casas sık görülür; standart dilde fiil çoğul olur: Vendem-se casas."],"mistakes":[{"wrong":"A casa foi construído em 1990.","right":"A casa foi construída em 1990.","note":"Particípio özneye (casa, dişil) uyar."},{"wrong":"por o governo","right":"pelo governo","note":"por + o = pelo."},{"wrong":"Aluga-se apartamentos.","right":"Alugam-se apartamentos.","note":"Standart dilde fiil çoğul özneye uyar."}]}},
  {"id":"pt-gr-por-vs-para","languageId":"pt","category":"grammar","level":"B1","sourceText":"Por vs. para","translations":{"tr":["Por ile para farkı"]},"grammar":{"summary":"para amaç, hedef, yön ve alıcıyı; por sebep, yol, süre, değiş tokuş ve edilgen faili bildirir.","uses":["Amaç ve sebep ayrımı","Yön (para) ve geçiş yeri (por)","Fiyat ve değiş tokuş (por)"],"sections":[{"kind":"other","title":"para: amaç, hedef, alıcı","formula":[{"tr":"para","en":"para","role":"x"},{"tr":"Amaç / Hedef / Alıcı","en":"Finalidade / Destino","role":"o"}],"examples":[{"text":"Estudo [x:para] [o:passar na prova].","tr":"Sınavı geçmek için çalışıyorum."},{"text":"Esse presente é [x:para] [o:você]. Vou [x:para] [o:casa].","tr":"Bu hediye senin için. Eve gidiyorum."}]},{"kind":"other","title":"por: sebep","formula":[{"tr":"por","en":"por","role":"x"},{"tr":"Sebep","en":"Causa","role":"o"}],"examples":[{"text":"Obrigado [x:por] [o:tudo].","tr":"Her şey için teşekkürler."},{"text":"O voo foi cancelado [x:pela] [o:chuva].","tr":"Uçuş yağmur yüzünden iptal edildi."}]},{"kind":"other","title":"por: yol, süre, fiyat","formula":[{"tr":"por / pelo / pela","en":"por","role":"x"},{"tr":"Yol / Süre / Karşılık","en":"Meio / Duração / Troca","role":"o"}],"examples":[{"text":"Passamos [x:pelo] [o:centro].","tr":"Merkezden geçtik."},{"text":"Comprei o livro [x:por] [o:50 reais].","tr":"Kitabı 50 reale aldım."}]},{"kind":"other","title":"para + mastar / por + mastar","formula":[{"tr":"para / por","en":"para / por","role":"x"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"Liguei [x:para] [v:saber] se você estava bem.","tr":"İyi olup olmadığını öğrenmek için aradım."},{"text":"Ele foi demitido [x:por] [v:chegar] atrasado.","tr":"Geç geldiği için kovuldu."}]}],"rules":["para + zamir görüş de bildirir: Para mim, está ótimo.","Son tarih para ile: O trabalho é para sexta-feira.","Sıklık ve oran por ile: duas vezes por semana, 100 km por hora."],"exceptions":[],"mistakes":[{"wrong":"Obrigado para tudo.","right":"Obrigado por tudo.","note":"Teşekkürün sebebi por ile söylenir."},{"wrong":"Estudo por passar.","right":"Estudo para passar.","note":"Amaç para ile söylenir."},{"wrong":"Paguei 50 reais para o livro.","right":"Paguei 50 reais pelo livro.","note":"Değiş tokuş / fiyat por ile söylenir."}]}},
  {"id":"pt-gr-infinitivo-pessoal","languageId":"pt","category":"grammar","level":"B1","sourceText":"Infinitivo pessoal","translations":{"tr":["Çekimli mastar"]},"grammar":{"summary":"Portekizceye özgü çekimli mastar, mastarın kendi öznesi olduğunda kişi eki alır: para nós sairmos, antes de eles chegarem.","uses":["Edatlardan sonra farklı özne (para, sem, antes de, depois de, até)","Kişisiz ifadelerden sonra (É melhor vocês irem.)","Subjuntivo'ya daha kısa bir alternatif"],"sections":[{"kind":"other","title":"Ekler","formula":[{"tr":"Mastar","en":"Infinitivo","role":"v"},{"tr":"+ Ø / -mos / -em","en":"Desinências pessoais","role":"x"}],"examples":[{"text":"eu [v:falar], você [v:falar], nós [v:falarmos], eles [v:falarem]","tr":"benim / senin / bizim / onların konuşması"}]},{"kind":"other","title":"Edat + özne + çekimli mastar","formula":[{"tr":"para / sem / antes de / depois de","en":"Preposição","role":"x"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Çekimli mastar","en":"Infinitivo pessoal","role":"v"}],"examples":[{"text":"Ela trouxe o mapa [x:para] [s:nós] [v:não nos perdermos].","tr":"Kaybolmayalım diye haritayı getirdi."},{"text":"Liguei [x:antes de] [s:eles] [v:saírem].","tr":"Onlar çıkmadan önce aradım."}]},{"kind":"other","title":"Kişisiz ifade + çekimli mastar","formula":[{"tr":"É melhor / É importante","en":"Expressão impessoal","role":"x"},{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"Çekimli mastar","en":"Infinitivo pessoal","role":"v"}],"examples":[{"text":"[x:É melhor] [s:vocês] [v:irem] agora.","tr":"Şimdi gitmeniz daha iyi."},{"text":"[x:É importante] [s:nós] [v:sabermos] a verdade.","tr":"Gerçeği bilmemiz önemli."}]}],"rules":["Tekil biçimler (eu, você, ele) mastarla aynıdır; fark nós (-mos) ve eles/vocês (-em) biçimlerinde görülür.","Mastarın öznesi ana cümleninkiyle aynıysa genellikle çekimsiz mastar yeterlidir: Vim para ajudar.","para que + subjuntivo ile aynı anlamı verir: para nós sairmos = para que nós saiamos."],"exceptions":[],"mistakes":[{"wrong":"Para nós fazer o trabalho...","right":"Para nós fazermos o trabalho...","note":"nós öznesiyle mastar -mos alır."},{"wrong":"É melhor vocês ir agora.","right":"É melhor vocês irem agora.","note":"vocês öznesiyle mastar -em alır."}]}},
  {"id":"pt-gr-perifrases-verbais","languageId":"pt","category":"grammar","level":"B1","sourceText":"Perífrases verbais","translations":{"tr":["Fiil kalıpları (acabar de, voltar a, costumar...)"]},"grammar":{"summary":"Çekimli bir yardımcı fiil + mastar/gerúndio kalıpları; eylemin başlangıç, tekrar, alışkanlık ya da yeni bitmiş olma gibi yönlerini anlatır.","uses":["Az önce olan eylem (acabar de)","Tekrar ve süreklilik (voltar a, continuar)","Alışkanlık (costumar)","Bırakma ve başlama (deixar de, começar a)"],"sections":[{"kind":"other","title":"acabar de + mastar: az önce","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"acabar de","en":"acabar de","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"[s:Eu] [a:acabei de] [v:chegar].","tr":"Az önce geldim."},{"text":"[s:O ônibus] [a:acabou de] [v:sair].","tr":"Otobüs az önce kalktı."}]},{"kind":"other","title":"costumar + mastar: genellikle","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"costumar","en":"costumar","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"[s:Eu] [a:costumo] [v:acordar] cedo.","tr":"Genelde erken kalkarım."},{"text":"[s:Ela] [a:costumava] [v:correr] na praia.","tr":"Eskiden plajda koşardı."}]},{"kind":"other","title":"voltar a / começar a / deixar de + mastar","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"voltar a / começar a / deixar de","en":"Verbo auxiliar + preposição","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"[s:Ele] [a:voltou a] [v:fumar].","tr":"Yeniden sigaraya başladı."},{"text":"[s:Eu] [a:deixei de] [v:tomar] refrigerante.","tr":"Gazlı içecek içmeyi bıraktım."}]},{"kind":"other","title":"continuar / andar + gerúndio","formula":[{"tr":"Özne","en":"Sujeito","role":"s"},{"tr":"continuar / andar","en":"continuar / andar","role":"a"},{"tr":"Gerúndio","en":"Gerúndio","role":"v"}],"examples":[{"text":"[s:Ela] [a:continua] [v:morando] em Recife.","tr":"Hâlâ Recife'de oturuyor."},{"text":"[s:Eu] [a:ando] [v:pensando] em mudar de emprego.","tr":"Son zamanlarda iş değiştirmeyi düşünüyorum."}]}],"rules":["Kalıplardaki edat sabittir: acabar de, começar a, voltar a, deixar de; costumar edat almaz.","ter que / ter de + mastar zorunluluk bildirir: Tenho que sair.","Brezilya'da continuar + gerúndio, Portekiz'de continuar a + mastar tercih edilir."],"exceptions":[],"mistakes":[{"wrong":"Eu costumo de acordar cedo.","right":"Eu costumo acordar cedo.","note":"costumar edat almaz."},{"wrong":"Ele voltou de fumar.","right":"Ele voltou a fumar.","note":"'Yeniden yapmak' voltar a ile kurulur."},{"wrong":"Eu acabo chegar.","right":"Eu acabei de chegar.","note":"acabar de + mastar kalıbında de zorunludur."}]}}
]
