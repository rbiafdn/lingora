[
  {"id":"it-gr-articoli-determinativi","languageId":"it","category":"grammar","level":"A1","sourceText":"Articoli determinativi","translations":{"tr":["Belirli tanımlıklar (il, lo, la)"]},"grammar":{"summary":"Belirli tanımlık ismin cinsiyetine, sayısına ve ilk harfine göre il, lo, la, l', i, gli, le olur.","uses":["Bilinen, belirli bir şeyden söz etmek","Genel kavramlardan söz etmek (Il caffè è buono.)","İyelik sıfatlarından önce (la mia casa)"],"sections":[{"kind":"other","title":"Eril tekil: il / lo / l'","formula":[{"tr":"Tanımlık","en":"Articolo","role":"x"},{"tr":"Eril isim","en":"Nome maschile","role":"o"}],"examples":[{"text":"[x:il] [o:libro], [x:lo] [o:studente], [x:l'] [o:amico]","tr":"kitap, öğrenci, arkadaş"},{"text":"[x:lo] [o:zaino], [x:il] [o:treno]","tr":"sırt çantası, tren"}],"notes":["lo: s+ünsüz, z, gn, ps, x, y ile başlayan eril isimlerden önce; l': ünlüden önce."]},{"kind":"other","title":"Dişil tekil: la / l'","formula":[{"tr":"Tanımlık","en":"Articolo","role":"x"},{"tr":"Dişil isim","en":"Nome femminile","role":"o"}],"examples":[{"text":"[x:la] [o:casa], [x:la] [o:scuola], [x:l'] [o:amica]","tr":"ev, okul, kız arkadaş"}]},{"kind":"other","title":"Çoğul: i / gli / le","formula":[{"tr":"Çoğul tanımlık","en":"Articolo plurale","role":"x"},{"tr":"Çoğul isim","en":"Nome plurale","role":"o"}],"examples":[{"text":"[x:i] [o:libri], [x:gli] [o:studenti], [x:gli] [o:amici]","tr":"kitaplar, öğrenciler, arkadaşlar"},{"text":"[x:le] [o:case], [x:le] [o:amiche]","tr":"evler, kız arkadaşlar"}],"notes":["il → i; lo ve l' (eril) → gli; la ve l' (dişil) → le."]}],"rules":["Tanımlığı ismin ilk harfi belirler, sıfat önde ise sıfatın ilk harfi: lo studente → il bravo studente.","Dişil çoğulda apostrof kullanılmaz: le amiche.","Türkçede tanımlık yoktur; İtalyancada isimler neredeyse her zaman tanımlıkla kullanılır."],"exceptions":["Gli dei (tanrılar) tarihsel bir istisnadır."],"mistakes":[{"wrong":"il studente","right":"lo studente","note":"s + ünsüzle başlayan eril isimler lo alır."},{"wrong":"i amici","right":"gli amici","note":"Ünlüyle başlayan eril çoğul isimler gli alır."},{"wrong":"Mi piace caffè.","right":"Mi piace il caffè.","note":"Genel kavramlarda da tanımlık gerekir."}]}},
  {"id":"it-gr-articoli-indeterminativi","languageId":"it","category":"grammar","level":"A1","sourceText":"Articoli indeterminativi","translations":{"tr":["Belirsiz tanımlıklar (un, uno, una)"]},"grammar":{"summary":"Belirsiz tanımlık 'bir' anlamı verir ve cinsiyete ve ilk harfe göre un, uno, una, un' olur.","uses":["İlk kez söz edilen bir şey","Meslek ve tür belirtmek için sıfatla (È un bravo medico.)","Sayıca bir tane anlamında"],"sections":[{"kind":"other","title":"Eril: un / uno","formula":[{"tr":"Tanımlık","en":"Articolo","role":"x"},{"tr":"Eril isim","en":"Nome maschile","role":"o"}],"examples":[{"text":"[x:un] [o:libro], [x:un] [o:amico]","tr":"bir kitap, bir arkadaş"},{"text":"[x:uno] [o:studente], [x:uno] [o:zaino]","tr":"bir öğrenci, bir sırt çantası"}],"notes":["Eril isimlerde ünlüden önce apostrof yoktur: un amico."]},{"kind":"other","title":"Dişil: una / un'","formula":[{"tr":"Tanımlık","en":"Articolo","role":"x"},{"tr":"Dişil isim","en":"Nome femminile","role":"o"}],"examples":[{"text":"[x:una] [o:casa], [x:una] [o:pizza]","tr":"bir ev, bir pizza"},{"text":"[x:un'] [o:amica], [x:un'] [o:arancia]","tr":"bir kız arkadaş, bir portakal"}]},{"kind":"other","title":"Cümlede kullanım","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Tanımlık + isim","en":"Articolo + nome","role":"o"}],"examples":[{"text":"[s:Io] [v:ho] [o:un fratello].","tr":"Bir erkek kardeşim var."},{"text":"[s:Marco] [v:mangia] [o:una mela].","tr":"Marco bir elma yiyor."}]}],"rules":["uno: lo alan isimlerin önünde kullanılır (s+ünsüz, z, gn, ps).","un' sadece dişil isimlerde kullanılır.","Çoğulda belirsiz tanımlık yerine dei, degli, delle (bazı) kullanılır."],"exceptions":[],"mistakes":[{"wrong":"un' amico","right":"un amico","note":"Eril isimde apostrof yoktur."},{"wrong":"un studente","right":"uno studente","note":"s + ünsüz uno ister."},{"wrong":"una amica","right":"un'amica","note":"Dişil isim ünlüyle başlıyorsa un' kullanılır."}]}},
  {"id":"it-gr-il-plurale-dei-nomi","languageId":"it","category":"grammar","level":"A1","sourceText":"Il plurale dei nomi","translations":{"tr":["İsimlerin çoğulu"]},"grammar":{"summary":"İtalyancada isimler son ünlüyü değiştirerek çoğul olur: -o → -i, -a → -e, -e → -i.","uses":["Birden fazla kişi veya şeyden söz etmek","Sayılarla isim kullanmak (due libri)"],"sections":[{"kind":"other","title":"-o → -i (eril)","formula":[{"tr":"Tekil (-o)","en":"Singolare (-o)","role":"o"},{"tr":"→","en":"→","role":"x"},{"tr":"Çoğul (-i)","en":"Plurale (-i)","role":"o"}],"examples":[{"text":"[o:il libro] → [o:i libri]","tr":"kitap → kitaplar"},{"text":"[o:il ragazzo] → [o:i ragazzi]","tr":"oğlan → oğlanlar"}]},{"kind":"other","title":"-a → -e (dişil)","formula":[{"tr":"Tekil (-a)","en":"Singolare (-a)","role":"o"},{"tr":"→","en":"→","role":"x"},{"tr":"Çoğul (-e)","en":"Plurale (-e)","role":"o"}],"examples":[{"text":"[o:la casa] → [o:le case]","tr":"ev → evler"},{"text":"[o:la ragazza] → [o:le ragazze]","tr":"kız → kızlar"}]},{"kind":"other","title":"-e → -i (eril ve dişil)","formula":[{"tr":"Tekil (-e)","en":"Singolare (-e)","role":"o"},{"tr":"→","en":"→","role":"x"},{"tr":"Çoğul (-i)","en":"Plurale (-i)","role":"o"}],"examples":[{"text":"[o:il padre] → [o:i padri], [o:la madre] → [o:le madri]","tr":"baba → babalar, anne → anneler"},{"text":"[o:lo studente] → [o:gli studenti]","tr":"öğrenci → öğrenciler"}]},{"kind":"other","title":"Değişmeyen isimler","formula":[{"tr":"Tekil","en":"Singolare","role":"o"},{"tr":"=","en":"=","role":"x"},{"tr":"Çoğul","en":"Plurale","role":"o"}],"examples":[{"text":"[o:il caffè] → [o:i caffè], [o:la città] → [o:le città]","tr":"kahve → kahveler, şehir → şehirler"},{"text":"[o:il bar] → [o:i bar], [o:la foto] → [o:le foto]","tr":"bar → barlar, fotoğraf → fotoğraflar"}]}],"rules":["Vurgulu son heceyle biten, yabancı kökenli ve kısaltılmış isimler değişmez.","-ca/-ga ile biten isimler h alır: amica → amiche.","-co/-go genelde -chi/-ghi olur (gioco → giochi) ama amico → amici."],"exceptions":["Düzensiz: l'uomo → gli uomini, l'uovo → le uova, la mano → le mani.","Bazı eril isimler çoğulda dişil olur: il braccio → le braccia."],"mistakes":[{"wrong":"due caffès","right":"due caffè","note":"Vurgulu ünlüyle biten isimler değişmez."},{"wrong":"le amice","right":"le amiche","note":"-ca → -che olur, sert ses korunur."},{"wrong":"due libro","right":"due libri","note":"Türkçenin aksine sayıdan sonra isim çoğul olur."}]}},
  {"id":"it-gr-accordo-degli-aggettivi","languageId":"it","category":"grammar","level":"A1","sourceText":"Accordo degli aggettivi","translations":{"tr":["Sıfat uyumu"]},"grammar":{"summary":"Sıfat nitelediği ismin cinsiyetine ve sayısına uyar ve çoğunlukla isimden sonra gelir.","uses":["Kişi ve nesneleri tanımlamak","essere ile özellik bildirmek (La casa è grande.)","Milliyet ve renk bildirmek"],"sections":[{"kind":"other","title":"-o sıfatlar: 4 biçim","formula":[{"tr":"İsim","en":"Nome","role":"o"},{"tr":"Sıfat (-o/-a/-i/-e)","en":"Aggettivo (-o/-a/-i/-e)","role":"x"}],"examples":[{"text":"[o:un ragazzo] [x:alto], [o:una ragazza] [x:alta]","tr":"uzun boylu bir oğlan, uzun boylu bir kız"},{"text":"[o:i ragazzi] [x:alti], [o:le ragazze] [x:alte]","tr":"uzun boylu oğlanlar, uzun boylu kızlar"}]},{"kind":"other","title":"-e sıfatlar: 2 biçim","formula":[{"tr":"İsim","en":"Nome","role":"o"},{"tr":"Sıfat (-e/-i)","en":"Aggettivo (-e/-i)","role":"x"}],"examples":[{"text":"[o:un libro] [x:interessante], [o:una storia] [x:interessante]","tr":"ilginç bir kitap, ilginç bir hikâye"},{"text":"[o:i libri] [x:interessanti], [o:le storie] [x:interessanti]","tr":"ilginç kitaplar, ilginç hikâyeler"}]},{"kind":"other","title":"essere + sıfat","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"essere","en":"essere","role":"a"},{"tr":"Sıfat","en":"Aggettivo","role":"x"}],"examples":[{"text":"[s:Le case] [a:sono] [x:nuove].","tr":"Evler yeni."},{"text":"[s:Giulia] [a:è] [x:simpatica].","tr":"Giulia cana yakın."}]}],"rules":["Sıfat genellikle isimden sonra gelir: una macchina rossa.","Kısa ve sık sıfatlar (bello, buono, grande, piccolo) önce gelebilir.","Eril ve dişil karışık grupta sıfat eril çoğul olur: Marco e Anna sono stanchi."],"exceptions":["blu, rosa, viola gibi bazı renkler değişmez: le scarpe blu.","bello ve buono isimden önce tanımlık gibi değişir: un bel ragazzo, un buon caffè."],"mistakes":[{"wrong":"la casa bianco","right":"la casa bianca","note":"Sıfat ismin cinsiyetine uyar."},{"wrong":"le macchine rosse blu","right":"le macchine blu","note":"blu değişmez."},{"wrong":"Marco e Anna sono stanche.","right":"Marco e Anna sono stanchi.","note":"Karışık grupta eril çoğul kullanılır."}]}},
  {"id":"it-gr-pronomi-soggetto-e-il-verbo-essere","languageId":"it","category":"grammar","level":"A1","sourceText":"Pronomi soggetto e il verbo essere","translations":{"tr":["Kişi zamirleri ve essere (olmak)"]},"grammar":{"summary":"essere 'olmak' fiilidir; düzensizdir ve özne zamiri çoğu zaman söylenmez.","uses":["Kimlik, milliyet ve meslek bildirmek","Özellik ve durum bildirmek","Yer bildirmek (Sono a casa.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne (isteğe bağlı)","en":"Soggetto","role":"s"},{"tr":"essere","en":"essere","role":"a"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Io] [a:sono] [o:turco].","tr":"Ben Türküm."},{"text":"[a:Siamo] [o:studenti].","tr":"Öğrenciyiz."}],"notes":["io sono, tu sei, lui/lei è, noi siamo, voi siete, loro sono."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"non","en":"non","role":"x"},{"tr":"essere","en":"essere","role":"a"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Lei] [x:non] [a:è] [o:italiana].","tr":"O İtalyan değil."},{"text":"[x:Non] [a:sono] [o:stanco].","tr":"Yorgun değilim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"essere","en":"essere","role":"a"},{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[a:Sei] [o:italiano]?","tr":"İtalyan mısın?"},{"text":"[a:È] [o:libero] [s:il bagno]?","tr":"Tuvalet boş mu?"}],"notes":["Soru çoğu zaman sadece tonlamayla yapılır; kelime sırası değişmeyebilir."]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"essere","en":"essere","role":"a"},{"tr":"Özne?","en":"Soggetto?","role":"s"}],"examples":[{"text":"[q:Di dove] [a:sei] [s:tu]?","tr":"Nerelisin?"},{"text":"[q:Dov'] [a:è] [s:la stazione]?","tr":"İstasyon nerede?"}]}],"rules":["Fiil çekimi kişiyi gösterdiği için özne zamiri vurgu dışında söylenmez.","Lei (büyük L) resmî 'siz' anlamındadır ve 3. tekil şahıs gibi çekilir: Lei è.","Olumsuzlukta non her zaman fiilden hemen önce gelir."],"exceptions":["Saatlerde: Sono le tre (Saat üç), ama È l'una (Saat bir)."],"mistakes":[{"wrong":"Io è studente.","right":"Io sono studente.","note":"io ile sono kullanılır."},{"wrong":"Sono non stanco.","right":"Non sono stanco.","note":"non fiilden önce gelir."},{"wrong":"Tu sei di dove?","right":"Di dove sei?","note":"Soru kelimesi başa gelir."}]}},
  {"id":"it-gr-il-verbo-avere","languageId":"it","category":"grammar","level":"A1","sourceText":"Il verbo avere","translations":{"tr":["avere (sahip olmak) fiili"]},"grammar":{"summary":"avere 'sahip olmak' demektir; yaş, açlık, soğuk gibi durumlarda da kullanılır.","uses":["Sahiplik (Ho una macchina.)","Yaş bildirmek (Ho vent'anni.)","Kalıplar: avere fame, sete, freddo, caldo, sonno, paura, ragione"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"avere","en":"avere","role":"v"},{"tr":"Nesne","en":"Oggetto","role":"o"}],"examples":[{"text":"[s:Io] [v:ho] [o:due sorelle].","tr":"İki kız kardeşim var."},{"text":"[s:Luca] [v:ha] [o:trent'anni].","tr":"Luca otuz yaşında."}],"notes":["io ho, tu hai, lui/lei ha, noi abbiamo, voi avete, loro hanno — h okunmaz."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"non","en":"non","role":"x"},{"tr":"avere","en":"avere","role":"v"},{"tr":"Nesne","en":"Oggetto","role":"o"}],"examples":[{"text":"[x:Non] [v:ho] [o:tempo].","tr":"Vaktim yok."},{"text":"[s:Loro] [x:non] [v:hanno] [o:figli].","tr":"Onların çocukları yok."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"avere","en":"avere","role":"v"},{"tr":"Nesne?","en":"Oggetto?","role":"o"}],"examples":[{"text":"[v:Hai] [o:fame]?","tr":"Aç mısın?"},{"text":"[v:Avete] [o:una camera libera]?","tr":"Boş odanız var mı?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"avere","en":"avere","role":"v"},{"tr":"Özne?","en":"Soggetto?","role":"s"}],"examples":[{"text":"[q:Quanti anni] [v:hai]?","tr":"Kaç yaşındasın?"},{"text":"[q:Che cosa] [v:ha] [s:Maria]?","tr":"Maria'nın nesi var?"}]}],"rules":["Yaş essere ile değil avere ile söylenir: Ho 20 anni.","Açlık, susuzluk, üşüme gibi durumlar avere + isim ile söylenir: Ho freddo.","avere'nin h harfi hiç okunmaz: ho = 'o'."],"exceptions":[],"mistakes":[{"wrong":"Sono 20 anni.","right":"Ho 20 anni.","note":"Yaş avere ile söylenir."},{"wrong":"Sono fame.","right":"Ho fame.","note":"Açlık avere + isim ile söylenir."},{"wrong":"Io a una macchina.","right":"Io ho una macchina.","note":"ho yazılışında h vardır; a edattır."}]}},
  {"id":"it-gr-ce-ci-sono","languageId":"it","category":"grammar","level":"A1","sourceText":"C'è / Ci sono","translations":{"tr":["Var (tekil / çoğul)"]},"grammar":{"summary":"c'è (tekil) ve ci sono (çoğul) bir yerde bir şeyin var olduğunu söyler.","uses":["Bir yerde ne olduğunu söylemek","Yer tarif etmek","Olumsuzda 'yok' demek"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"(Yer)","en":"(Luogo)","role":"o"},{"tr":"c'è / ci sono","en":"c'è / ci sono","role":"v"},{"tr":"İsim","en":"Nome","role":"s"}],"examples":[{"text":"[o:In centro] [v:c'è] [s:un museo].","tr":"Merkezde bir müze var."},{"text":"[v:Ci sono] [s:molti turisti] [o:a Roma].","tr":"Roma'da çok turist var."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"non","en":"non","role":"x"},{"tr":"c'è / ci sono","en":"c'è / ci sono","role":"v"},{"tr":"İsim","en":"Nome","role":"s"}],"examples":[{"text":"[x:Non] [v:c'è] [s:latte] in frigo.","tr":"Buzdolabında süt yok."},{"text":"[x:Non] [v:ci sono] [s:problemi].","tr":"Sorun yok."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"c'è / ci sono","en":"c'è / ci sono","role":"v"},{"tr":"İsim?","en":"Nome?","role":"s"}],"examples":[{"text":"[v:C'è] [s:una farmacia] qui vicino?","tr":"Yakında bir eczane var mı?"},{"text":"[v:Ci sono] [s:posti liberi]?","tr":"Boş yer var mı?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"c'è / ci sono?","en":"c'è / ci sono?","role":"v"}],"examples":[{"text":"[q:Che cosa] [v:c'è] in TV stasera?","tr":"Bu akşam televizyonda ne var?"},{"text":"[q:Quante persone] [v:ci sono]?","tr":"Kaç kişi var?"}]}],"rules":["Tekil isimle c'è, çoğul isimle ci sono kullanılır.","Belirli bir şeyin yerini sormak için dov'è kullanılır: Dov'è il museo? (✗ C'è il museo?).","Olumsuzda non başa gelir: Non c'è."],"exceptions":["Geçmişte: c'era / c'erano; gelecekte: ci sarà / ci saranno."],"mistakes":[{"wrong":"C'è molti turisti.","right":"Ci sono molti turisti.","note":"Çoğul isimle ci sono kullanılır."},{"wrong":"Ha un museo in centro.","right":"C'è un museo in centro.","note":"'Var' anlamında avere değil c'è kullanılır."}]}},
  {"id":"it-gr-presente-indicativo-verbi-regolari","languageId":"it","category":"grammar","level":"A1","sourceText":"Presente indicativo: verbi regolari","translations":{"tr":["Şimdiki zaman: düzenli fiiller"]},"grammar":{"summary":"Presente hem şimdiki zamanı hem geniş zamanı karşılar; fiiller -are, -ere, -ire gruplarına göre çekilir.","uses":["Alışkanlıklar ve rutinler","Şu anda olanlar","Yakın gelecekteki planlar (Domani parto.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"Fiil kökü + ek","en":"Radice + desinenza","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Io] [v:parlo] [o:italiano].","tr":"İtalyanca konuşuyorum."},{"text":"[s:Loro] [v:dormono] [o:fino alle nove].","tr":"Dokuza kadar uyurlar."}],"notes":["-are: -o, -i, -a, -iamo, -ate, -ano · -ere: -o, -i, -e, -iamo, -ete, -ono · -ire: -o, -i, -e, -iamo, -ite, -ono."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"non","en":"non","role":"x"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Marco] [x:non] [v:mangia] [o:carne].","tr":"Marco et yemez."},{"text":"[x:Non] [v:capisco] [o:la domanda].","tr":"Soruyu anlamıyorum."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[v:Parli] [o:inglese]?","tr":"İngilizce konuşur musun?"},{"text":"[v:Prendete] [o:un caffè]?","tr":"Kahve alır mısınız?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Özne?","en":"Soggetto?","role":"s"}],"examples":[{"text":"[q:Dove] [v:abiti]?","tr":"Nerede oturuyorsun?"},{"text":"[q:A che ora] [v:apre] [s:il negozio]?","tr":"Dükkân saat kaçta açılıyor?"}]},{"kind":"other","title":"-isc- alan -ire fiilleri","formula":[{"tr":"Kök","en":"Radice","role":"v"},{"tr":"+ isc +","en":"+ isc +","role":"x"},{"tr":"Ek","en":"Desinenza","role":"v"}],"examples":[{"text":"[s:Io] [v:finisco] alle sei.","tr":"Altıda bitiririm."},{"text":"[s:Lei] [v:preferisce] il tè.","tr":"O çayı tercih eder."}],"notes":["finire, capire, preferire, pulire: noi ve voi dışında -isc- alır (finiamo, finite)."]}],"rules":["Fiil eki kişiyi gösterir, bu yüzden özne zamiri genelde düşer.","-care/-gare fiilleri sert sesi korumak için h alır: cercare → cerchi, paghiamo.","-iare fiillerinde tek i kalır: mangiare → mangi, mangiamo."],"exceptions":["-ire fiillerinin bir kısmı -isc- alır, bir kısmı (dormire, partire, aprire) almaz; ezberlemek gerekir."],"mistakes":[{"wrong":"Io sto mangio.","right":"Io mangio.","note":"Presente tek başına 'yiyorum' anlamını verir."},{"wrong":"Tu cerci.","right":"Tu cerchi.","note":"-care fiilleri i ve e'den önce h alır."},{"wrong":"Io capo.","right":"Io capisco.","note":"capire -isc- alır."}]}},
  {"id":"it-gr-presente-indicativo-verbi-irregolari","languageId":"it","category":"grammar","level":"A1","sourceText":"Presente indicativo: verbi irregolari","translations":{"tr":["Şimdiki zaman: düzensiz fiiller"]},"grammar":{"summary":"andare, fare, venire, stare, dire, uscire, bere, dare gibi sık fiiller düzensiz çekilir.","uses":["Günlük eylemler (Vado al lavoro.)","fare ile kalıplar (fare colazione, fare la spesa)","stare ile hâl hatır (Come stai?)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"Düzensiz fiil","en":"Verbo irregolare","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Io] [v:vado] [o:a scuola] in autobus.","tr":"Okula otobüsle giderim."},{"text":"[s:Noi] [v:facciamo] [o:colazione] al bar.","tr":"Kahvaltıyı barda yaparız."}],"notes":["andare: vado, vai, va, andiamo, andate, vanno · fare: faccio, fai, fa, facciamo, fate, fanno."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"non","en":"non","role":"x"},{"tr":"Düzensiz fiil","en":"Verbo irregolare","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[x:Non] [v:esco] [o:stasera].","tr":"Bu akşam dışarı çıkmıyorum."},{"text":"[s:Lui] [x:non] [v:dice] [o:la verità].","tr":"O doğruyu söylemiyor."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Düzensiz fiil","en":"Verbo irregolare","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[v:Vieni] [o:con noi]?","tr":"Bizimle geliyor musun?"},{"text":"[v:Bevi] [o:un bicchiere di vino]?","tr":"Bir kadeh şarap içer misin?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"Düzensiz fiil","en":"Verbo irregolare","role":"v"},{"tr":"Özne?","en":"Soggetto?","role":"s"}],"examples":[{"text":"[q:Come] [v:stai]?","tr":"Nasılsın?"},{"text":"[q:Che cosa] [v:fai] [s:tu] nel fine settimana?","tr":"Hafta sonu ne yaparsın?"}]}],"rules":["venire: vengo, vieni, viene, veniamo, venite, vengono.","uscire: esco, esci, esce, usciamo, uscite, escono.","stare: sto, stai, sta, stiamo, state, stanno · dire: dico, dici, dice, diciamo, dite, dicono."],"exceptions":["bere 'bevere' kökünden çekilir: bevo, bevi, beve, beviamo, bevete, bevono."],"mistakes":[{"wrong":"Io ando al cinema.","right":"Io vado al cinema.","note":"andare düzensizdir."},{"wrong":"Io fo colazione.","right":"Io faccio colazione.","note":"fare: faccio."},{"wrong":"Loro venono.","right":"Loro vengono.","note":"venire: vengono."}]}},
  {"id":"it-gr-le-parole-interrogative","languageId":"it","category":"grammar","level":"A1","sourceText":"Le parole interrogative","translations":{"tr":["Soru kelimeleri"]},"grammar":{"summary":"chi, che cosa, dove, quando, come, perché, quanto, quale gibi soru kelimeleri cümlenin başına gelir.","uses":["Bilgi istemek","Fiyat, miktar ve sayı sormak","Seçim sormak (quale)"],"sections":[{"kind":"wh","title":"Soru kelimesi + fiil","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Özne?","en":"Soggetto?","role":"s"}],"examples":[{"text":"[q:Chi] [v:è] [s:quella ragazza]?","tr":"O kız kim?"},{"text":"[q:Quando] [v:parte] [s:il treno]?","tr":"Tren ne zaman kalkıyor?"}],"notes":["Özne genellikle fiilden sonra gelir."]},{"kind":"other","title":"quanto / quanta / quanti / quante","formula":[{"tr":"quanto (uyumlu)","en":"quanto","role":"q"},{"tr":"İsim","en":"Nome","role":"o"},{"tr":"Fiil?","en":"Verbo?","role":"v"}],"examples":[{"text":"[q:Quanti] [o:fratelli] [v:hai]?","tr":"Kaç kardeşin var?"},{"text":"[q:Quanto] [v:costa]?","tr":"Ne kadar?"}]},{"kind":"other","title":"Edat + soru kelimesi","formula":[{"tr":"Edat","en":"Preposizione","role":"x"},{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"Fiil?","en":"Verbo?","role":"v"}],"examples":[{"text":"[x:Con] [q:chi] [v:esci]?","tr":"Kiminle çıkıyorsun?"},{"text":"[x:Di] [q:dove] [v:sei]?","tr":"Nerelisin?"}],"notes":["Edat soru kelimesinden önce gelir, cümle sonunda kalamaz."]}],"rules":["perché hem 'neden' hem 'çünkü' anlamındadır.","quale ünlüden önce qual olur ve apostrof almaz: Qual è?","che cosa, cosa ve che üçü de 'ne' anlamındadır."],"exceptions":["dove + è → dov'è; come + è → com'è."],"mistakes":[{"wrong":"Qual'è il tuo nome?","right":"Qual è il tuo nome?","note":"qual è apostrofsuz yazılır."},{"wrong":"Chi esci con?","right":"Con chi esci?","note":"Edat soru kelimesinin önüne gelir."},{"wrong":"Quanto fratelli hai?","right":"Quanti fratelli hai?","note":"quanto isme uyar."}]}},
  {"id":"it-gr-aggettivi-possessivi","languageId":"it","category":"grammar","level":"A1","sourceText":"Aggettivi possessivi","translations":{"tr":["İyelik sıfatları"]},"grammar":{"summary":"İyelik sıfatı sahip olunan şeyin cinsiyet ve sayısına uyar ve genellikle tanımlıkla kullanılır: il mio libro.","uses":["Sahiplik bildirmek","Aile üyelerinden söz etmek (mia madre)"],"sections":[{"kind":"other","title":"Tanımlık + iyelik + isim","formula":[{"tr":"Tanımlık","en":"Articolo","role":"x"},{"tr":"İyelik sıfatı","en":"Aggettivo possessivo","role":"s"},{"tr":"İsim","en":"Nome","role":"o"}],"examples":[{"text":"[x:la] [s:mia] [o:macchina]","tr":"benim arabam"},{"text":"[x:i] [s:tuoi] [o:amici]","tr":"senin arkadaşların"}],"notes":["mio/mia/miei/mie · tuo/tua/tuoi/tue · suo/sua/suoi/sue · nostro · vostro · loro (değişmez)."]},{"kind":"other","title":"Tekil aile üyeleri: tanımlıksız","formula":[{"tr":"İyelik sıfatı","en":"Aggettivo possessivo","role":"s"},{"tr":"Aile üyesi (tekil)","en":"Nome di parentela","role":"o"}],"examples":[{"text":"[s:Mia] [o:sorella] vive a Milano.","tr":"Kız kardeşim Milano'da yaşıyor."},{"text":"[s:Suo] [o:padre] è medico.","tr":"Babası doktor."}]},{"kind":"other","title":"Çoğul veya sıfatlı aile üyeleri: tanımlıklı","formula":[{"tr":"Tanımlık","en":"Articolo","role":"x"},{"tr":"İyelik sıfatı","en":"Aggettivo possessivo","role":"s"},{"tr":"Aile üyesi","en":"Nome di parentela","role":"o"}],"examples":[{"text":"[x:I] [s:miei] [o:genitori] sono in vacanza.","tr":"Annemle babam tatilde."},{"text":"[x:la] [s:loro] [o:madre]","tr":"onların annesi"}],"notes":["loro her zaman tanımlık ister."]}],"rules":["İyelik sıfatı sahibe değil, sahip olunan şeye uyar: Marco e la sua casa.","suo hem 'onun' hem resmî 'sizin' (Suo) anlamındadır.","mamma, papà ve küçültmeli aile isimleri tanımlık alır: la mia mamma."],"exceptions":["Kalıplarda tanımlık düşer: a casa mia, è colpa tua."],"mistakes":[{"wrong":"Il mio padre","right":"Mio padre","note":"Tekil aile üyelerinde tanımlık kullanılmaz."},{"wrong":"Mia libro","right":"Il mio libro","note":"İyelik ismin cinsiyetine uyar ve tanımlık alır."},{"wrong":"Marco e il sua casa","right":"Marco e la sua casa","note":"Sahibin değil, casa'nın cinsiyeti esas alınır."}]}},
  {"id":"it-gr-preposizioni-semplici","languageId":"it","category":"grammar","level":"A1","sourceText":"Preposizioni semplici","translations":{"tr":["Basit edatlar"]},"grammar":{"summary":"di, a, da, in, con, su, per, tra/fra edatları isimden önce gelir ve Türkçedeki hâl eklerini karşılar.","uses":["Yer ve yön bildirmek","Sahiplik ve köken (di)","Araç ve birliktelik (con, in)"],"sections":[{"kind":"other","title":"a + şehir / in + ülke","formula":[{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"a / in","en":"a / in","role":"x"},{"tr":"Yer","en":"Luogo","role":"o"}],"examples":[{"text":"[v:Abito] [x:a] [o:Roma].","tr":"Roma'da oturuyorum."},{"text":"[v:Vado] [x:in] [o:Italia].","tr":"İtalya'ya gidiyorum."}],"notes":["a: şehir ve casa/scuola; in: ülke, bölge, banca/farmacia/ufficio."]},{"kind":"other","title":"da: -den / -e (kişiye) / -den beri","formula":[{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"da","en":"da","role":"x"},{"tr":"İsim","en":"Nome","role":"o"}],"examples":[{"text":"[v:Vengo] [x:da] [o:Istanbul].","tr":"İstanbul'dan geliyorum."},{"text":"[v:Vado] [x:da] [o:Marco].","tr":"Marco'ya (Marco'nun evine) gidiyorum."}]},{"kind":"other","title":"di, con, per","formula":[{"tr":"İsim / Fiil","en":"Nome / Verbo","role":"v"},{"tr":"di / con / per","en":"di / con / per","role":"x"},{"tr":"İsim","en":"Nome","role":"o"}],"examples":[{"text":"[v:Il libro] [x:di] [o:Paolo].","tr":"Paolo'nun kitabı."},{"text":"[v:Esco] [x:con] [o:gli amici].","tr":"Arkadaşlarla çıkıyorum."}]}],"rules":["Ulaşım araçlarında in kullanılır: in treno, in macchina; ama a piedi.","di + ünlü → d': d'Italia değil dell'Italia, ama d'estate.","tra ve fra aynı anlamdadır; ses uyumuna göre seçilir."],"exceptions":["essere di + şehir köken bildirir: Sono di Napoli."],"mistakes":[{"wrong":"Vado a Italia.","right":"Vado in Italia.","note":"Ülkelerde in kullanılır."},{"wrong":"Abito in Milano.","right":"Abito a Milano.","note":"Şehirlerde a kullanılır."},{"wrong":"Vado al dottore.","right":"Vado dal dottore.","note":"Bir kişinin yanına giderken da kullanılır."}]}},
  {"id":"it-gr-preposizioni-articolate","languageId":"it","category":"grammar","level":"A1","sourceText":"Preposizioni articolate","translations":{"tr":["Tanımlıklı edatlar"]},"grammar":{"summary":"di, a, da, in, su edatları belirli tanımlıkla birleşir: a + il = al, in + la = nella.","uses":["Belirli bir yerden söz ederken (al bar, nella borsa)","Saat söylerken (alle tre)","Sahiplik (il libro del professore)"],"sections":[{"kind":"other","title":"Edat + tanımlık = tek kelime","formula":[{"tr":"Edat","en":"Preposizione","role":"x"},{"tr":"+ tanımlık","en":"+ articolo","role":"x"},{"tr":"İsim","en":"Nome","role":"o"}],"examples":[{"text":"Vado [x:al] [o:mare].","tr":"Denize gidiyorum."},{"text":"Le chiavi sono [x:nella] [o:borsa].","tr":"Anahtarlar çantada."}],"notes":["a: al, allo, alla, all', ai, agli, alle · in: nel, nello, nella, nell', nei, negli, nelle."]},{"kind":"other","title":"di / da / su + tanımlık","formula":[{"tr":"di / da / su","en":"di / da / su","role":"x"},{"tr":"+ tanımlık","en":"+ articolo","role":"x"},{"tr":"İsim","en":"Nome","role":"o"}],"examples":[{"text":"La casa [x:dei] [o:miei nonni].","tr":"Dedemle ninemin evi."},{"text":"Il gatto è [x:sul] [o:divano].","tr":"Kedi kanepenin üstünde."}],"notes":["di: del, dello, della, dell', dei, degli, delle · da: dal... · su: sul..."]},{"kind":"other","title":"Saat ile","formula":[{"tr":"a + tanımlık","en":"a + articolo","role":"x"},{"tr":"Saat","en":"Ora","role":"o"}],"examples":[{"text":"Il film comincia [x:alle] [o:otto].","tr":"Film sekizde başlıyor."},{"text":"Pranzo [x:all'] [o:una].","tr":"Saat birde öğle yemeği yerim."}]}],"rules":["con ve per genellikle birleşmez: con il, per la.","Şehir isimleri tanımlık almadığı için edat birleşmez: a Roma.","Ülke isimlerinde in tanımlıksızdır (in Italia) ama sıfatla birleşir: nell'Italia del Sud."],"exceptions":["in + aile/ev odası kalıpları tanımlıksızdır: in cucina, in camera."],"mistakes":[{"wrong":"a il cinema","right":"al cinema","note":"a + il her zaman al olur."},{"wrong":"Il libro di il professore","right":"Il libro del professore","note":"di + il = del."},{"wrong":"alle Roma","right":"a Roma","note":"Şehirler tanımlık almaz."}]}},
  {"id":"it-gr-verbi-modali-dovere-potere-volere","languageId":"it","category":"grammar","level":"A1","sourceText":"Verbi modali: dovere, potere, volere","translations":{"tr":["Kip fiilleri: zorunda olmak, -ebilmek, istemek"]},"grammar":{"summary":"dovere, potere ve volere düzensizdir ve arkalarından mastar gelir: Devo andare.","uses":["Zorunluluk (dovere)","Olasılık ve izin (potere)","İstek (volere); kibar istek için vorrei"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"Kip fiili","en":"Verbo modale","role":"a"},{"tr":"Mastar","en":"Infinito","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Io] [a:devo] [v:lavorare] [o:domani].","tr":"Yarın çalışmak zorundayım."},{"text":"[s:Lei] [a:vuole] [v:imparare] [o:il cinese].","tr":"Çince öğrenmek istiyor."}],"notes":["dovere: devo, devi, deve, dobbiamo, dovete, devono · potere: posso, puoi, può, possiamo, potete, possono · volere: voglio, vuoi, vuole, vogliamo, volete, vogliono."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"non","en":"non","role":"x"},{"tr":"Kip fiili","en":"Verbo modale","role":"a"},{"tr":"Mastar","en":"Infinito","role":"v"}],"examples":[{"text":"[x:Non] [a:posso] [v:venire].","tr":"Gelemem."},{"text":"[x:Non] [a:devi] [v:fumare] qui.","tr":"Burada sigara içmemelisin."}],"notes":["non dovere 'yasak' anlamı verir, 'gerek yok' değil."]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Kip fiili","en":"Verbo modale","role":"a"},{"tr":"Mastar","en":"Infinito","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[a:Posso] [v:entrare]?","tr":"Girebilir miyim?"},{"text":"[a:Vuoi] [v:bere] [o:qualcosa]?","tr":"Bir şey içmek ister misin?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"Kip fiili","en":"Verbo modale","role":"a"},{"tr":"Mastar?","en":"Infinito?","role":"v"}],"examples":[{"text":"[q:Che cosa] [a:vuoi] [v:fare] stasera?","tr":"Bu akşam ne yapmak istiyorsun?"},{"text":"[q:Dove] [a:posso] [v:comprare] i biglietti?","tr":"Biletleri nereden alabilirim?"}]}],"rules":["Kip fiilinden sonra mastar edatsız gelir: Voglio partire (✗ voglio di partire).","Kibar istek için voglio yerine vorrei kullanılır: Vorrei un caffè.","volere bir isimle de kullanılabilir: Voglio un gelato."],"exceptions":["sapere + mastar 'bir beceriyi bilmek' anlamındadır: So nuotare (Yüzmeyi bilirim)."],"mistakes":[{"wrong":"Voglio di andare.","right":"Voglio andare.","note":"Kip fiilinden sonra edat gelmez."},{"wrong":"Posso nuotare. (beceri)","right":"So nuotare.","note":"Öğrenilmiş beceri için sapere kullanılır."},{"wrong":"Io devo vado.","right":"Io devo andare.","note":"İkinci fiil mastar olur."}]}}
]
