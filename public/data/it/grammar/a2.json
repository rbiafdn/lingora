[
  {"id":"it-gr-verbi-riflessivi","languageId":"it","category":"grammar","level":"A2","sourceText":"Verbi riflessivi","translations":{"tr":["Dönüşlü fiiller"]},"grammar":{"summary":"Dönüşlü fiiller mi, ti, si, ci, vi, si zamirleriyle çekilir: alzarsi → mi alzo.","uses":["Günlük rutin (svegliarsi, lavarsi, vestirsi)","Duygular (arrabbiarsi, divertirsi)","Karşılıklı eylem (Ci vediamo domani.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"Dönüşlü zamir","en":"Pronome riflessivo","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"[s:Io] [o:mi] [v:sveglio] alle sette.","tr":"Yedide uyanırım."},{"text":"[s:Loro] [o:si] [v:divertono] molto.","tr":"Çok eğleniyorlar."}],"notes":["io mi, tu ti, lui/lei si, noi ci, voi vi, loro si."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"non","en":"non","role":"x"},{"tr":"Dönüşlü zamir","en":"Pronome riflessivo","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"[x:Non] [o:mi] [v:ricordo] il suo nome.","tr":"Adını hatırlamıyorum."},{"text":"[x:Non] [o:ti] [v:preoccupare]!","tr":"Merak etme!"}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Dönüşlü zamir","en":"Pronome riflessivo","role":"o"},{"tr":"Fiil?","en":"Verbo?","role":"v"}],"examples":[{"text":"[o:Ti] [v:senti] bene?","tr":"İyi hissediyor musun?"},{"text":"[o:Vi] [v:sposate] a giugno?","tr":"Haziranda mı evleniyorsunuz?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"Dönüşlü zamir","en":"Pronome riflessivo","role":"o"},{"tr":"Fiil?","en":"Verbo?","role":"v"}],"examples":[{"text":"[q:Come] [o:ti] [v:chiami]?","tr":"Adın ne?"},{"text":"[q:A che ora] [o:vi] [v:alzate]?","tr":"Saat kaçta kalkıyorsunuz?"}]},{"kind":"other","title":"Kip fiili + dönüşlü","formula":[{"tr":"Kip fiili","en":"Verbo modale","role":"a"},{"tr":"Mastar + zamir","en":"Infinito + pronome","role":"v"}],"examples":[{"text":"[a:Devo] [v:alzarmi] presto.","tr":"Erken kalkmam gerek."},{"text":"[o:Mi] [a:devo] [v:alzare] presto.","tr":"Erken kalkmam gerek."}],"notes":["Zamir ya mastarın sonuna eklenir ya da kip fiilinin önüne gelir."]}],"rules":["Mastarda -si eki vardır: lavarsi, chiamarsi.","Dönüşlü fiiller birleşik zamanlarda essere alır: Mi sono alzato.","Vücut parçalarında iyelik yerine tanımlık kullanılır: Mi lavo le mani."],"exceptions":[],"mistakes":[{"wrong":"Io chiamo Ahmet.","right":"Mi chiamo Ahmet.","note":"chiamarsi dönüşlüdür; zamirsiz 'Ahmet'i çağırıyorum' olur."},{"wrong":"Mi lavo le mie mani.","right":"Mi lavo le mani.","note":"Vücut parçalarında iyelik gerekmez."},{"wrong":"Mi ho alzato.","right":"Mi sono alzato.","note":"Dönüşlü fiiller essere ile çekilir."}]}},
  {"id":"it-gr-passato-prossimo-con-avere","languageId":"it","category":"grammar","level":"A2","sourceText":"Passato prossimo con avere","translations":{"tr":["Geçmiş zaman (avere ile)"]},"grammar":{"summary":"Passato prossimo tamamlanmış geçmiş eylemleri anlatır; geçişli fiillerde avere + geçmiş ortaç ile kurulur.","uses":["Geçmişte tamamlanmış olaylar","Bugünle bağlantılı geçmiş (Ho perso le chiavi.)","Belirli zamanlı olaylar (ieri, la settimana scorsa)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"avere","en":"avere","role":"a"},{"tr":"Geçmiş ortaç","en":"Participio passato","role":"v"},{"tr":"Nesne","en":"Oggetto","role":"o"}],"examples":[{"text":"[s:Io] [a:ho] [v:mangiato] [o:la pizza].","tr":"Pizza yedim."},{"text":"[s:Noi] [a:abbiamo] [v:visto] [o:un bel film].","tr":"Güzel bir film izledik."}],"notes":["-are → -ato, -ere → -uto, -ire → -ito: parlato, venduto, dormito."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"non","en":"non","role":"x"},{"tr":"avere","en":"avere","role":"a"},{"tr":"Geçmiş ortaç","en":"Participio passato","role":"v"}],"examples":[{"text":"[x:Non] [a:ho] [v:capito].","tr":"Anlamadım."},{"text":"[s:Lui] [x:non] [a:ha] [v:fatto] [o:i compiti].","tr":"Ödevlerini yapmadı."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"avere","en":"avere","role":"a"},{"tr":"Geçmiş ortaç","en":"Participio passato","role":"v"},{"tr":"Nesne?","en":"Oggetto?","role":"o"}],"examples":[{"text":"[a:Hai] [v:letto] [o:questo libro]?","tr":"Bu kitabı okudun mu?"},{"text":"[a:Avete] [v:prenotato] [o:il tavolo]?","tr":"Masayı ayırttınız mı?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"avere","en":"avere","role":"a"},{"tr":"Geçmiş ortaç?","en":"Participio passato?","role":"v"}],"examples":[{"text":"[q:Che cosa] [a:hai] [v:fatto] ieri?","tr":"Dün ne yaptın?"},{"text":"[q:Dove] [a:avete] [v:mangiato]?","tr":"Nerede yemek yediniz?"}]}],"rules":["avere ile ortaç özneye uymaz: Maria ha mangiato.","Sık düzensiz ortaçlar: fare → fatto, dire → detto, vedere → visto, prendere → preso, leggere → letto, scrivere → scritto, aprire → aperto.","già, mai, ancora gibi zarflar avere ile ortaç arasına girer: Ho già mangiato."],"exceptions":["Önde lo/la/li/le zamiri varsa ortaç ona uyar: La pizza? L'ho mangiata."],"mistakes":[{"wrong":"Ho prenduto il treno.","right":"Ho preso il treno.","note":"prendere'nin ortacı düzensizdir: preso."},{"wrong":"Maria ha mangiata.","right":"Maria ha mangiato.","note":"avere ile ortaç özneye uymaz."},{"wrong":"Ho fatto già.","right":"Ho già fatto.","note":"già yardımcı fiil ile ortaç arasına girer."}]}},
  {"id":"it-gr-passato-prossimo-con-essere","languageId":"it","category":"grammar","level":"A2","sourceText":"Passato prossimo con essere","translations":{"tr":["Geçmiş zaman (essere ile)"]},"grammar":{"summary":"Hareket, durum değişikliği bildiren fiiller ve dönüşlü fiiller passato prossimo'yu essere ile kurar; ortaç özneye uyar.","uses":["Gitmek, gelmek, çıkmak gibi hareket fiilleri","Doğmak, ölmek, olmak gibi durum değişiklikleri","Dönüşlü fiiller (Mi sono svegliato.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"essere","en":"essere","role":"a"},{"tr":"Ortaç (-o/-a/-i/-e)","en":"Participio (-o/-a/-i/-e)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Anna] [a:è] [v:andata] [o:a Firenze].","tr":"Anna Floransa'ya gitti."},{"text":"[s:I ragazzi] [a:sono] [v:arrivati] [o:tardi].","tr":"Çocuklar geç geldi."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"non","en":"non","role":"x"},{"tr":"essere","en":"essere","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"}],"examples":[{"text":"[s:Noi] [x:non] [a:siamo] [v:usciti] ieri sera.","tr":"Dün akşam dışarı çıkmadık."},{"text":"[x:Non] [a:è] [v:venuta] [o:alla festa].","tr":"Partiye gelmedi."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"essere","en":"essere","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[a:Sei] [v:stato] [o:in Italia]?","tr":"İtalya'da bulundun mu?"},{"text":"[a:Siete] [v:tornati] [o:ieri]?","tr":"Dün mü döndünüz?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"essere","en":"essere","role":"a"},{"tr":"Ortaç?","en":"Participio?","role":"v"}],"examples":[{"text":"[q:Quando] [a:sei] [v:nato]?","tr":"Ne zaman doğdun?"},{"text":"[q:A che ora] [a:è] [v:partito] [s:il treno]?","tr":"Tren saat kaçta kalktı?"}]}],"rules":["essere ile ortaç öznenin cinsiyet ve sayısına uyar: Lei è partita, Loro sono partiti.","essere alan sık fiiller: andare, venire, arrivare, partire, uscire, entrare, tornare, restare, nascere, morire, diventare, essere, stare.","Dönüşlü fiiller her zaman essere alır: Ci siamo divertiti."],"exceptions":["piacere da essere alır: Mi è piaciuto il film.","cominciare, finire, salire, scendere nesne alırsa avere ile çekilir: Ho finito il lavoro / Il film è finito."],"mistakes":[{"wrong":"Ho andato al cinema.","right":"Sono andato al cinema.","note":"andare essere ile çekilir."},{"wrong":"Maria è andato.","right":"Maria è andata.","note":"essere ile ortaç özneye uyar."},{"wrong":"Sono nascito a Izmir.","right":"Sono nato a Smirne.","note":"nascere'nin ortacı nato'dur."}]}},
  {"id":"it-gr-imperfetto","languageId":"it","category":"grammar","level":"A2","sourceText":"Imperfetto","translations":{"tr":["Hikâye geçmiş zamanı / süregelen geçmiş"]},"grammar":{"summary":"Imperfetto geçmişteki alışkanlıkları, süren durumları ve tasvirleri anlatır: 'yapardım, yapıyordum'.","uses":["Geçmişteki alışkanlıklar (Da bambino giocavo a calcio.)","Geçmişte süren eylemler","Tasvir: yaş, hava, duygu, saat"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"Kök + -avo/-evo/-ivo","en":"Radice + -avo/-evo/-ivo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Da piccolo] [v:abitavo] [o:a Napoli].","tr":"Küçükken Napoli'de otururdum."},{"text":"[s:Mia nonna] [v:faceva] [o:una torta ogni domenica].","tr":"Ninem her pazar pasta yapardı."}],"notes":["parlare: parlavo, parlavi, parlava, parlavamo, parlavate, parlavano."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"non","en":"non","role":"x"},{"tr":"Imperfetto fiil","en":"Verbo all'imperfetto","role":"v"}],"examples":[{"text":"[x:Non] [v:sapevo] la risposta.","tr":"Cevabı bilmiyordum."},{"text":"[s:Prima] [x:non] [v:c'era] [o:la metro].","tr":"Eskiden metro yoktu."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Imperfetto fiil","en":"Verbo all'imperfetto","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[v:Dormivi] [o:quando ho chiamato]?","tr":"Aradığımda uyuyor muydun?"},{"text":"[v:Avevate] [o:un cane]?","tr":"Bir köpeğiniz var mıydı?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"Imperfetto fiil","en":"Verbo all'imperfetto","role":"v"},{"tr":"Özne?","en":"Soggetto?","role":"s"}],"examples":[{"text":"[q:Che cosa] [v:facevi] da bambino?","tr":"Çocukken ne yapardın?"},{"text":"[q:Dove] [v:lavorava] [s:tuo padre]?","tr":"Baban nerede çalışıyordu?"}]}],"rules":["Ekler üç grupta aynıdır, sadece ünlü değişir: -avo, -evo, -ivo.","Sık düzensizler: essere → ero, eri, era, eravamo, eravate, erano; fare → facevo; dire → dicevo; bere → bevevo.","Yaş, saat ve hava geçmişte imperfetto ile anlatılır: Erano le otto, pioveva."],"exceptions":[],"mistakes":[{"wrong":"Da bambino sono giocato a calcio.","right":"Da bambino giocavo a calcio.","note":"Geçmiş alışkanlık imperfetto ister."},{"wrong":"Ho avuto dieci anni.","right":"Avevo dieci anni.","note":"Geçmişte yaş imperfetto ile söylenir."},{"wrong":"Facevo → io fevo","right":"io facevo","note":"fare imperfetto'da facev- kökünü kullanır."}]}},
  {"id":"it-gr-passato-prossimo-e-imperfetto","languageId":"it","category":"grammar","level":"A2","sourceText":"Passato prossimo e imperfetto","translations":{"tr":["Passato prossimo ve imperfetto karşılaştırması"]},"grammar":{"summary":"Passato prossimo tamamlanmış olayı, imperfetto arka planı, süren durumu ve alışkanlığı anlatır.","uses":["Olay örgüsü (passato prossimo) ile arka planı (imperfetto) ayırmak","Süren bir eylemi kesen olay","Bir kez olan ile her zaman olanı ayırmak"],"sections":[{"kind":"other","title":"Süren eylem + kesen olay","formula":[{"tr":"Imperfetto","en":"Imperfetto","role":"v"},{"tr":"quando","en":"quando","role":"x"},{"tr":"Passato prossimo","en":"Passato prossimo","role":"a"}],"examples":[{"text":"[v:Dormivo] [x:quando] [a:è suonato] il telefono.","tr":"Telefon çaldığında uyuyordum."},{"text":"[v:Camminavo] per strada [x:quando] [a:ho incontrato] Luca.","tr":"Luca'yla karşılaştığımda sokakta yürüyordum."}]},{"kind":"other","title":"Tasvir + olay","formula":[{"tr":"Imperfetto (arka plan)","en":"Imperfetto (sfondo)","role":"v"},{"tr":"Passato prossimo (olay)","en":"Passato prossimo (evento)","role":"a"}],"examples":[{"text":"[v:Era] una bella giornata e [a:siamo andati] al mare.","tr":"Güzel bir gündü ve denize gittik."},{"text":"[v:Ero] stanco, quindi [a:sono andato] a letto presto.","tr":"Yorgundum, bu yüzden erken yattım."}]},{"kind":"other","title":"Alışkanlık / tek seferlik","formula":[{"tr":"sempre / ogni giorno + imperfetto","en":"sempre + imperfetto","role":"v"},{"tr":"ieri / una volta + passato prossimo","en":"ieri + passato prossimo","role":"a"}],"examples":[{"text":"Ogni estate [v:andavamo] in montagna.","tr":"Her yaz dağa giderdik."},{"text":"L'estate scorsa [a:siamo andati] in montagna.","tr":"Geçen yaz dağa gittik."}]}],"rules":["Belirli süre (per due ore, tre volte) passato prossimo ister: Ho dormito per due ore.","Aynı anda süren iki eylem imperfetto ile: Mentre io cucinavo, lui leggeva.","mentre genelde imperfetto ile, all'improvviso passato prossimo ile kullanılır."],"exceptions":["sapere ve conoscere zamana göre anlam değiştirir: sapevo (biliyordum) / ho saputo (öğrendim)."],"mistakes":[{"wrong":"Quando ho dormito, è suonato il telefono.","right":"Mentre dormivo, è suonato il telefono.","note":"Kesilen süren eylem imperfetto olur."},{"wrong":"Ieri pioveva tre ore.","right":"Ieri è piovuto per tre ore.","note":"Belirli süre passato prossimo ister."},{"wrong":"Da bambino ho abitato a Roma ogni anno.","right":"Da bambino abitavo a Roma.","note":"Geçmişteki durum imperfetto ile anlatılır."}]}},
  {"id":"it-gr-dimostrativi-questo-e-quello","languageId":"it","category":"grammar","level":"A2","sourceText":"Dimostrativi: questo e quello","translations":{"tr":["İşaret sıfatları: bu ve şu/o"]},"grammar":{"summary":"questo yakındaki, quello uzaktaki şeyi gösterir; quello isimden önce belirli tanımlık gibi değişir.","uses":["Yakın ve uzak nesneleri göstermek","Seçim yapmak (Prendo questo.)","Zamir olarak kullanmak (Quello è mio.)"],"sections":[{"kind":"other","title":"questo / questa / questi / queste","formula":[{"tr":"questo (uyumlu)","en":"questo","role":"x"},{"tr":"İsim","en":"Nome","role":"o"}],"examples":[{"text":"[x:Questo] [o:libro] è interessante.","tr":"Bu kitap ilginç."},{"text":"[x:Queste] [o:scarpe] sono nuove.","tr":"Bu ayakkabılar yeni."}],"notes":["Ünlüden önce quest' olabilir: quest'anno."]},{"kind":"other","title":"quello: tanımlık gibi değişir","formula":[{"tr":"quel / quello / quella / quell'","en":"quel / quello / quella / quell'","role":"x"},{"tr":"İsim","en":"Nome","role":"o"}],"examples":[{"text":"[x:Quel] [o:ragazzo], [x:quello] [o:studente], [x:quell'] [o:albero]","tr":"şu oğlan, şu öğrenci, şu ağaç"},{"text":"[x:Quei] [o:libri], [x:quegli] [o:amici], [x:quelle] [o:case]","tr":"şu kitaplar, şu arkadaşlar, şu evler"}],"notes":["il → quel, lo → quello, l' → quell', i → quei, gli → quegli, la → quella, le → quelle."]},{"kind":"other","title":"Zamir olarak","formula":[{"tr":"questo / quello","en":"Pronome dimostrativo","role":"s"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"[s:Quello] [v:è] il mio ufficio.","tr":"Şu benim ofisim."},{"text":"Non voglio questa giacca, [v:preferisco] [s:quella].","tr":"Bu ceketi istemiyorum, şunu tercih ederim."}],"notes":["Zamir olarak quello'nun tam biçimleri kullanılır: quello, quella, quelli, quelle."]}],"rules":["İsimden önce quello'nun biçimini ismin ilk harfi belirler (tanımlık kuralı gibi).","Zamir olarak çoğulda quelli kullanılır: Quali scarpe? Quelli neri değil, quelle nere.","Türkçedeki 'şu' ve 'o' ayrımı İtalyancada tek kelimeyle (quello) yapılır."],"exceptions":[],"mistakes":[{"wrong":"quello libro","right":"quel libro","note":"il alan isimler quel alır."},{"wrong":"quelli amici","right":"quegli amici","note":"İsimden önce gli → quegli."},{"wrong":"Preferisco quel.","right":"Preferisco quello.","note":"Zamir olarak tam biçim kullanılır."}]}},
  {"id":"it-gr-pronomi-diretti","languageId":"it","category":"grammar","level":"A2","sourceText":"Pronomi diretti","translations":{"tr":["Belirtili nesne zamirleri"]},"grammar":{"summary":"mi, ti, lo, la, ci, vi, li, le zamirleri belirtili nesnenin yerini tutar ve çekimli fiilden önce gelir.","uses":["Tekrarı önlemek (Il libro? Lo leggo.)","Kişiyi nesne yapmak (Ti chiamo domani.)"],"sections":[{"kind":"affirmative","title":"Zamir + çekimli fiil","formula":[{"tr":"Nesne zamiri","en":"Pronome diretto","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"Il caffè? [o:Lo] [v:prendo] senza zucchero.","tr":"Kahve mi? Şekersiz içiyorum."},{"text":"[o:Ti] [v:aspetto] alla stazione.","tr":"Seni istasyonda bekliyorum."}],"notes":["mi, ti, lo/la, ci, vi, li/le; resmî 'sizi': La."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"non","en":"non","role":"x"},{"tr":"Nesne zamiri","en":"Pronome diretto","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"[x:Non] [o:la] [v:conosco].","tr":"Onu (kadını) tanımıyorum."},{"text":"[x:Non] [o:li] [v:trovo] più.","tr":"Onları artık bulamıyorum."}]},{"kind":"other","title":"Mastar ile: sona bitişik","formula":[{"tr":"Kip fiili","en":"Verbo modale","role":"a"},{"tr":"Mastar + zamir","en":"Infinito + pronome","role":"v"}],"examples":[{"text":"[a:Devo] [v:chiamarlo] stasera.","tr":"Onu bu akşam aramalıyım."},{"text":"[a:Voglio] [v:vederti].","tr":"Seni görmek istiyorum."}],"notes":["Kip fiillerinde iki sıra da doğru: Lo devo chiamare = Devo chiamarlo."]},{"kind":"other","title":"Passato prossimo ile ortaç uyumu","formula":[{"tr":"lo/la/li/le","en":"Pronome diretto","role":"o"},{"tr":"avere","en":"avere","role":"a"},{"tr":"Uyumlu ortaç","en":"Participio concordato","role":"v"}],"examples":[{"text":"Le chiavi? [o:Le] [a:ho] [v:perse].","tr":"Anahtarlar mı? Onları kaybettim."},{"text":"La torta? [o:L'] [a:ho] [v:fatta] io.","tr":"Pasta mı? Onu ben yaptım."}]}],"rules":["Zamir çekimli fiilin önüne, mastarın ise sonuna gelir.","lo ve la ünlüden önce l' olur: L'ho vista.","lo/la/li/le ile passato prossimo'da ortaç zamire uyar."],"exceptions":["ecco ile zamir bitişir: Eccolo! Eccomi!"],"mistakes":[{"wrong":"Io vedo lo.","right":"Io lo vedo.","note":"Zamir çekimli fiilden önce gelir."},{"wrong":"Le ho perso.","right":"Le ho perse.","note":"Önde le varsa ortaç dişil çoğul olur."},{"wrong":"Lo conosco Maria.","right":"La conosco.","note":"Dişil nesne için la kullanılır."}]}},
  {"id":"it-gr-pronomi-indiretti","languageId":"it","category":"grammar","level":"A2","sourceText":"Pronomi indiretti","translations":{"tr":["Yönelme (dolaylı nesne) zamirleri"]},"grammar":{"summary":"mi, ti, gli, le, ci, vi, gli zamirleri 'bana, sana, ona…' anlamındadır ve a + kişi yapısının yerini tutar.","uses":["Birine bir şey vermek, söylemek (Gli scrivo.)","piacere ve benzeri fiiller (Mi piace.)"],"sections":[{"kind":"affirmative","title":"Zamir + fiil","formula":[{"tr":"Yönelme zamiri","en":"Pronome indiretto","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Nesne","en":"Oggetto","role":"x"}],"examples":[{"text":"[o:Gli] [v:regalo] [x:un libro].","tr":"Ona (erkeğe) bir kitap hediye ediyorum."},{"text":"[o:Le] [v:telefono] domani.","tr":"Ona (kadına) yarın telefon ediyorum."}],"notes":["mi, ti, gli (ona-erkek), le (ona-kadın), Le (size-resmî), ci, vi, gli (onlara)."]},{"kind":"other","title":"piacere: beğenilen özne olur","formula":[{"tr":"Yönelme zamiri","en":"Pronome indiretto","role":"o"},{"tr":"piace / piacciono","en":"piacere","role":"v"},{"tr":"Beğenilen şey","en":"Soggetto","role":"s"}],"examples":[{"text":"[o:Mi] [v:piace] [s:la musica].","tr":"Müziği severim."},{"text":"[o:Ti] [v:piacciono] [s:i gatti]?","tr":"Kedileri sever misin?"}],"notes":["Aynı yapı: mancare, sembrare, servire (Mi serve aiuto.)."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"non","en":"non","role":"x"},{"tr":"Yönelme zamiri","en":"Pronome indiretto","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"[x:Non] [o:mi] [v:piace] il pesce.","tr":"Balık sevmem."},{"text":"[x:Non] [o:gli] [v:ho detto] niente.","tr":"Ona hiçbir şey söylemedim."}]}],"rules":["Yönelme zamiriyle passato prossimo'da ortaç uyum yapmaz: Le ho scritto.","Konuşma dilinde 'onlara' için gli kullanılır; a loro vurgulu biçimdir.","Vurgu için uzun biçim: A me piace, a te no."],"exceptions":[],"mistakes":[{"wrong":"Io piace la pizza.","right":"Mi piace la pizza.","note":"piacere'de beğenen kişi yönelme zamiri olur."},{"wrong":"Mi piace i film.","right":"Mi piacciono i film.","note":"Beğenilen çoğulsa fiil de çoğul olur."},{"wrong":"Lo telefono.","right":"Gli telefono.","note":"telefonare a birini ister: yönelme zamiri gerekir."}]}},
  {"id":"it-gr-futuro-semplice","languageId":"it","category":"grammar","level":"A2","sourceText":"Futuro semplice","translations":{"tr":["Gelecek zaman"]},"grammar":{"summary":"Futuro semplice gelecekteki eylemleri ve şimdiki zamanla ilgili tahminleri anlatır: parlerò, sarà.","uses":["Gelecek planlar ve tahminler","Şimdiye dair olasılık (Saranno le tre.)","Konuşmada yakın gelecek için çoğunlukla presente yeterlidir"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"Kök + -erò/-irò","en":"Futuro semplice","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Domani] [v:partirò] [o:per Roma].","tr":"Yarın Roma'ya hareket edeceğim."},{"text":"[s:Noi] [v:compreremo] [o:una casa].","tr":"Bir ev alacağız."}],"notes":["-are fiillerinde a → e olur: parlare → parlerò, parlerai, parlerà, parleremo, parlerete, parleranno."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"non","en":"non","role":"x"},{"tr":"Gelecek zaman fiil","en":"Futuro semplice","role":"v"}],"examples":[{"text":"[s:Io] [x:non] [v:verrò] alla festa.","tr":"Partiye gelmeyeceğim."},{"text":"[x:Non] [v:pioverà] domani.","tr":"Yarın yağmur yağmayacak."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Gelecek zaman fiil","en":"Futuro semplice","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[v:Verrai] [o:con noi]?","tr":"Bizimle gelecek misin?"},{"text":"[v:Sarà] [o:vero]?","tr":"Acaba doğru mu?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"Gelecek zaman fiil?","en":"Futuro semplice?","role":"v"}],"examples":[{"text":"[q:Quando] [v:tornerete]?","tr":"Ne zaman döneceksiniz?"},{"text":"[q:Dove] [v:andrai] in vacanza?","tr":"Tatile nereye gideceksin?"}]}],"rules":["Düzensiz kökler: essere → sarò, avere → avrò, andare → andrò, fare → farò, venire → verrò, volere → vorrò.","-care/-gare fiilleri h alır: cercherò, pagherò.","Tahmin anlamı: Dov'è Luca? Sarà a casa. (Evdedir herhalde.)"],"exceptions":["-ciare/-giare fiillerinde i düşer: mangerò, comincerò."],"mistakes":[{"wrong":"Parlarò","right":"Parlerò","note":"-are fiillerinde gelecek zamanda a, e'ye döner."},{"wrong":"Cercerò","right":"Cercherò","note":"Sert k sesini korumak için h eklenir."},{"wrong":"Venirò","right":"Verrò","note":"venire'nin gelecek kökü düzensizdir."}]}},
  {"id":"it-gr-comparativi","languageId":"it","category":"grammar","level":"A2","sourceText":"Comparativi","translations":{"tr":["Karşılaştırma (daha … -den)"]},"grammar":{"summary":"Karşılaştırma più / meno + sıfat + di / che ile, eşitlik ise (così) … come / (tanto) … quanto ile yapılır.","uses":["İki kişi/şeyi karşılaştırmak","Eşitliği belirtmek (alto come te)"],"sections":[{"kind":"other","title":"Üstünlük: più … di","formula":[{"tr":"İsim 1","en":"Primo termine","role":"s"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"più / meno + sıfat","en":"più / meno + aggettivo","role":"x"},{"tr":"di + İsim 2","en":"di + secondo termine","role":"o"}],"examples":[{"text":"[s:Roma] [v:è] [x:più grande] [o:di Firenze].","tr":"Roma Floransa'dan daha büyük."},{"text":"[s:Il treno] [v:è] [x:meno caro] [o:dell'aereo].","tr":"Tren uçaktan daha ucuz."}],"notes":["di + tanımlık birleşir: dell'aereo, della mamma."]},{"kind":"other","title":"che: aynı öğeye ait iki özellik","formula":[{"tr":"più + A","en":"più + primo termine","role":"x"},{"tr":"che","en":"che","role":"a"},{"tr":"B","en":"secondo termine","role":"o"}],"examples":[{"text":"È [x:più bello] [a:che] [o:utile].","tr":"Kullanışlı olmaktan çok güzel."},{"text":"Mi piace [x:più leggere] [a:che] [o:guardare la TV].","tr":"Okumayı TV izlemekten daha çok severim."}],"notes":["İki sıfat, iki fiil, iki zarf ya da edatlı iki öğe karşılaştırılırken che kullanılır."]},{"kind":"other","title":"Eşitlik: come / quanto","formula":[{"tr":"İsim 1","en":"Primo termine","role":"s"},{"tr":"Fiil + sıfat","en":"Verbo + aggettivo","role":"v"},{"tr":"come / quanto + İsim 2","en":"come / quanto","role":"o"}],"examples":[{"text":"[s:Marco] [v:è alto] [o:come suo padre].","tr":"Marco babası kadar uzun."},{"text":"[s:Questo vino] [v:costa] [o:quanto quello].","tr":"Bu şarap onun kadar tutuyor."}]}],"rules":["Kişi/isim karşılaştırmasında di, iki sıfat/fiil karşılaştırmasında che kullanılır.","Düzensiz: buono → migliore, cattivo → peggiore; bene → meglio, male → peggio.","Zamirlerde vurgulu biçim: più alto di me."],"exceptions":["più buono ve più cattivo de kullanılır, özellikle yemek ve karakter için."],"mistakes":[{"wrong":"Più grande che Firenze","right":"Più grande di Firenze","note":"İki isim karşılaştırılırken di gelir."},{"wrong":"Più buono di questo è più migliore.","right":"È migliore.","note":"migliore zaten karşılaştırma bildirir; più eklenmez."},{"wrong":"Più alto di io","right":"Più alto di me","note":"Edattan sonra vurgulu zamir gelir."}]}},
  {"id":"it-gr-superlativi","languageId":"it","category":"grammar","level":"A2","sourceText":"Superlativi","translations":{"tr":["Üstünlük derecesi (en …)"]},"grammar":{"summary":"Göreli üstünlük 'il più … di' ile (en …), mutlak üstünlük -issimo ekiyle (çok …) yapılır.","uses":["Bir grubun en …'sini belirtmek","Çok yüksek derece bildirmek (bellissimo)"],"sections":[{"kind":"other","title":"Göreli: il più … di","formula":[{"tr":"Tanımlık + (isim)","en":"Articolo + nome","role":"s"},{"tr":"più / meno + sıfat","en":"più / meno + aggettivo","role":"x"},{"tr":"di / tra + grup","en":"di / tra + gruppo","role":"o"}],"examples":[{"text":"È [s:la città] [x:più bella] [o:d'Italia].","tr":"İtalya'nın en güzel şehri."},{"text":"Luca è [s:il] [x:più giovane] [o:della classe].","tr":"Luca sınıfın en genci."}],"notes":["İsim varsa tanımlık bir kez kullanılır: la città più bella (✗ la città la più bella)."]},{"kind":"other","title":"Mutlak: -issimo","formula":[{"tr":"Sıfat kökü","en":"Radice","role":"v"},{"tr":"-issimo/-a/-i/-e","en":"-issimo","role":"x"}],"examples":[{"text":"Il film è [v:bell][x:issimo].","tr":"Film çok çok güzel."},{"text":"Sono [v:stanch][x:issima].","tr":"Çok yorgunum."}],"notes":["Aynı anlam: molto bello, davvero bello."]},{"kind":"other","title":"Düzensiz biçimler","formula":[{"tr":"Sıfat","en":"Aggettivo","role":"v"},{"tr":"Göreli","en":"Superlativo relativo","role":"x"},{"tr":"Mutlak","en":"Superlativo assoluto","role":"o"}],"examples":[{"text":"[v:buono] → [x:il migliore] → [o:ottimo]","tr":"iyi → en iyi → mükemmel"},{"text":"[v:cattivo] → [x:il peggiore] → [o:pessimo]","tr":"kötü → en kötü → berbat"}]}],"rules":["Gruptan önce di (tanımlıkla birleşerek) veya tra gelir.","-co/-go ile biten sıfatlar h alır: ricco → ricchissimo, lungo → lunghissimo.","Zarflarda da kullanılır: benissimo, malissimo, prestissimo."],"exceptions":["Bazı sıfatlar -issimo almaz: perfetto, enorme, eterno."],"mistakes":[{"wrong":"La città la più bella","right":"La città più bella","note":"İsimden sonra tanımlık tekrarlanmaz."},{"wrong":"Molto bellissimo","right":"Bellissimo","note":"-issimo zaten 'çok' anlamı taşır."},{"wrong":"Il più buono amico","right":"Il migliore amico","note":"'En iyi arkadaş' için migliore yaygındır."}]}},
  {"id":"it-gr-stare-gerundio","languageId":"it","category":"grammar","level":"A2","sourceText":"Stare + gerundio","translations":{"tr":["Şu anda yapıyor olmak (-iyor)"]},"grammar":{"summary":"stare + gerundio tam şu anda süren eylemi anlatır; stare per + mastar ise 'üzere olmak' anlamındadır.","uses":["Konuşma anında süren eylem (Sto mangiando.)","Geçmişte süren eylem (Stavo dormendo.)","Bir şeyin olmak üzere olması (Sto per uscire.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"stare","en":"stare","role":"a"},{"tr":"Gerundio (-ando/-endo)","en":"Gerundio","role":"v"}],"examples":[{"text":"[s:Io] [a:sto] [v:lavorando].","tr":"Şu an çalışıyorum."},{"text":"[s:I bambini] [a:stanno] [v:dormendo].","tr":"Çocuklar uyuyor."}],"notes":["-are → -ando; -ere/-ire → -endo: parlando, leggendo, dormendo."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"non","en":"non","role":"x"},{"tr":"stare","en":"stare","role":"a"},{"tr":"Gerundio","en":"Gerundio","role":"v"}],"examples":[{"text":"[x:Non] [a:sto] [v:scherzando].","tr":"Şaka yapmıyorum."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"stare","en":"stare","role":"a"},{"tr":"Gerundio?","en":"Gerundio?","role":"v"}],"examples":[{"text":"[q:Che cosa] [a:stai] [v:facendo]?","tr":"Ne yapıyorsun?"},{"text":"[q:Chi] [a:sta] [v:parlando]?","tr":"Kim konuşuyor?"}]},{"kind":"other","title":"stare per + mastar","formula":[{"tr":"stare","en":"stare","role":"a"},{"tr":"per","en":"per","role":"x"},{"tr":"Mastar","en":"Infinito","role":"v"}],"examples":[{"text":"Il treno [a:sta] [x:per] [v:partire].","tr":"Tren kalkmak üzere."},{"text":"[a:Stavo] [x:per] [v:chiamarti]!","tr":"Tam seni arayacaktım!"}]}],"rules":["Sadece gerçekten süren eylem için kullanılır; alışkanlıklarda düz presente gelir.","Düzensiz gerundio: fare → facendo, dire → dicendo, bere → bevendo.","Geçmişte: stavo/stavi + gerundio (Stavo uscendo quando…)."],"exceptions":["Zamirler stare'den önce ya da gerundio'ya bitişik gelir: Lo sto facendo / Sto facendolo."],"mistakes":[{"wrong":"Sono mangiando.","right":"Sto mangiando.","note":"Süreklilik essere ile değil stare ile kurulur."},{"wrong":"Ogni giorno sto andando a scuola.","right":"Ogni giorno vado a scuola.","note":"Alışkanlıklarda düz presente kullanılır."},{"wrong":"Sto faciendo.","right":"Sto facendo.","note":"fare'nin gerundio'su facendo'dur."}]}},
  {"id":"it-gr-imperativo-informale","languageId":"it","category":"grammar","level":"A2","sourceText":"Imperativo informale","translations":{"tr":["Emir kipi (tu, noi, voi)"]},"grammar":{"summary":"Emir kipi tu, noi, voi için talimat ve öneri verir; tu'nun olumsuzu non + mastar ile yapılır.","uses":["Talimat ve tarif vermek (Gira a destra.)","Öneri (Andiamo!)","Yasak bildirmek (Non toccare!)"],"sections":[{"kind":"affirmative","title":"Olumlu emir","formula":[{"tr":"Emir fiili","en":"Imperativo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Parla] [o:più piano]!","tr":"Daha yavaş konuş!"},{"text":"[v:Prendete] [o:l'autobus].","tr":"Otobüse binin."}],"notes":["tu: parla, prendi, dormi · noi: parliamo · voi: parlate, prendete, dormite."]},{"kind":"negative","title":"Olumsuz emir","formula":[{"tr":"non","en":"non","role":"x"},{"tr":"Mastar (tu) / Emir (noi, voi)","en":"Infinito / Imperativo","role":"v"}],"examples":[{"text":"[x:Non] [v:preoccuparti]!","tr":"Endişelenme!"},{"text":"[x:Non] [v:fate] rumore.","tr":"Gürültü yapmayın."}],"notes":["Sadece tu için mastar kullanılır: Non mangiare!"]},{"kind":"other","title":"Emir + zamir (bitişik)","formula":[{"tr":"Emir fiili","en":"Imperativo","role":"v"},{"tr":"+ zamir","en":"+ pronome","role":"o"}],"examples":[{"text":"[v:Chiama][o:mi] stasera!","tr":"Bu akşam beni ara!"},{"text":"[v:Di'][o:mmi] la verità.","tr":"Bana gerçeği söyle."}],"notes":["Tek heceli emirlerde ünsüz ikizleşir: dimmi, fallo, dammi, vacci."]}],"rules":["Kısa düzensiz tu emirleri: va'/vai, fa'/fai, da'/dai, sta'/stai, di'.","essere → sii, siate; avere → abbi, abbiate.","Zamir olumlu emirde sona bitişir: Aspettami!"],"exceptions":["Olumsuzda zamir iki yerde olabilir: Non dirlo / Non lo dire."],"mistakes":[{"wrong":"Non parla!","right":"Non parlare!","note":"tu için olumsuz emir non + mastar ile yapılır."},{"wrong":"Mi chiama!","right":"Chiamami!","note":"Olumlu emirde zamir fiile bitişir."},{"wrong":"Dimi","right":"Dimmi","note":"Tek heceli emre zamir eklenince ünsüz ikizleşir."}]}}
]
