[
  {"id":"it-gr-pronomi-combinati","languageId":"it","category":"grammar","level":"B1","sourceText":"Pronomi combinati","translations":{"tr":["Birleşik zamirler (me lo, glielo)"]},"grammar":{"summary":"Yönelme ve belirtili nesne zamiri birlikte gelince birleşir: mi + lo → me lo, gli/le + lo → glielo.","uses":["'Onu bana/sana/ona …' demek (Te lo do.)","Tekrardan kaçınmak"],"sections":[{"kind":"other","title":"Yönelme + nesne zamiri","formula":[{"tr":"me/te/ce/ve","en":"Pronome indiretto","role":"o"},{"tr":"lo/la/li/le/ne","en":"Pronome diretto","role":"x"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"Il libro? [o:Te] [x:lo] [v:presto].","tr":"Kitap mı? Onu sana ödünç veririm."},{"text":"[o:Me] [x:ne] [v:dai] due?","tr":"Bana ondan iki tane verir misin?"}],"notes":["mi → me, ti → te, ci → ce, vi → ve."]},{"kind":"other","title":"gli / le → glie-","formula":[{"tr":"glie-","en":"glie-","role":"o"},{"tr":"lo/la/li/le/ne","en":"Pronome diretto","role":"x"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"La lettera? [o:Glie][x:l'][v:ho spedita] ieri.","tr":"Mektup mu? Ona dün gönderdim."},{"text":"[o:Glie][x:lo] [v:dico] io.","tr":"Ona ben söylerim."}],"notes":["glie- tek kelime olarak yazılır: glielo, gliela, glieli, gliele, gliene."]},{"kind":"other","title":"Mastar ve emirde bitişik","formula":[{"tr":"Fiil","en":"Infinito / Imperativo","role":"v"},{"tr":"+ birleşik zamir","en":"+ pronome combinato","role":"o"}],"examples":[{"text":"[v:Dammelo]!","tr":"Onu bana ver!"},{"text":"Posso [v:spiegartelo] domani.","tr":"Onu sana yarın açıklayabilirim."}]}],"rules":["Sıra her zaman: yönelme zamiri + nesne zamiri.","Passato prossimo'da ortaç nesne zamirine uyar: Te l'ho detta, la notizia?","Dönüşlü fiillerde de olur: Mi lavo le mani → Me le lavo."],"exceptions":["Resmî 'size' de glielo ile söylenir: Glielo porto subito, signora."],"mistakes":[{"wrong":"Mi lo dai?","right":"Me lo dai?","note":"Birleşince mi, me olur."},{"wrong":"Gli lo dico.","right":"Glielo dico.","note":"gli + lo tek kelime glielo olur."},{"wrong":"Lo ti do.","right":"Te lo do.","note":"Önce yönelme, sonra nesne zamiri gelir."}]}},
  {"id":"it-gr-le-particelle-ci-e-ne","languageId":"it","category":"grammar","level":"B1","sourceText":"Le particelle ci e ne","translations":{"tr":["ci ve ne edatları"]},"grammar":{"summary":"ci çoğunlukla 'oraya/orada' ya da a + şey yerine, ne ise miktar veya di + şey yerine kullanılır.","uses":["Yeri tekrar etmemek (Ci vado domani.)","Miktar belirtmek (Ne voglio due.)","Bazı fiil kalıpları (pensarci, parlarne)"],"sections":[{"kind":"other","title":"ci = oraya / orada","formula":[{"tr":"ci","en":"ci","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"Vai a Roma? Sì, [o:ci] [v:vado] sabato.","tr":"Roma'ya gidiyor musun? Evet, cumartesi oraya gidiyorum."},{"text":"Sei stato in Sicilia? No, non [o:ci] [v:sono] mai [v:stato].","tr":"Sicilya'da bulundun mu? Hayır, hiç bulunmadım."}]},{"kind":"other","title":"ci = a + şey","formula":[{"tr":"ci","en":"ci","role":"o"},{"tr":"Fiil (pensare a, credere a…)","en":"Verbo + a","role":"v"}],"examples":[{"text":"Pensi all'esame? Sì, [o:ci] [v:penso] sempre.","tr":"Sınavı düşünüyor musun? Evet, hep düşünüyorum."},{"text":"Non [o:ci] [v:credo].","tr":"Buna inanmıyorum."}]},{"kind":"other","title":"ne = ondan (miktar)","formula":[{"tr":"ne","en":"ne","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Miktar","en":"Quantità","role":"x"}],"examples":[{"text":"Quante mele vuoi? [o:Ne] [v:voglio] [x:tre].","tr":"Kaç elma istiyorsun? Üç tane istiyorum."},{"text":"Hai fratelli? Sì, [o:ne] [v:ho] [x:uno].","tr":"Kardeşin var mı? Evet, bir tane var."}]},{"kind":"other","title":"ne = di + şey","formula":[{"tr":"ne","en":"ne","role":"o"},{"tr":"Fiil (parlare di…)","en":"Verbo + di","role":"v"}],"examples":[{"text":"Che [o:ne] [v:pensi]?","tr":"Bu konuda ne düşünüyorsun?"},{"text":"Non [o:ne] [v:parliamo] più.","tr":"Artık bundan bahsetmeyelim."}]}],"rules":["ne ile passato prossimo'da ortaç miktara uyar: Ne ho mangiate tre (mele).","ci ünlüden önce c' olur: C'è, c'ho (konuşma).","Kalıplar: volerci (Ci vuole un'ora), andarsene (Me ne vado), farcela (Ce la faccio)."],"exceptions":["Tüm miktar belirtilince ne değil lo/la kullanılır: Le mele? Le ho mangiate tutte."],"mistakes":[{"wrong":"Ho tre di loro.","right":"Ne ho tre.","note":"Miktar için ne kullanılır."},{"wrong":"Ne penso spesso. (pensare a)","right":"Ci penso spesso.","note":"pensare a ile ci, parlare di ile ne kullanılır."},{"wrong":"Quanti caffè? Ho bevuto due.","right":"Ne ho bevuti due.","note":"Miktar sayıldığında ne zorunludur."}]}},
  {"id":"it-gr-condizionale-presente","languageId":"it","category":"grammar","level":"B1","sourceText":"Condizionale presente","translations":{"tr":["Şart kipi (-ardı, -erdi)"]},"grammar":{"summary":"Condizionale presente kibar istek, dilek, tavsiye ve varsayımsal durumları anlatır: vorrei, potresti.","uses":["Kibar istek (Vorrei un caffè.)","Tavsiye (Dovresti riposare.)","Dilek ve varsayım (Mi piacerebbe viaggiare.)","Doğrulanmamış haber (Secondo i giornali, sarebbe…)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"Kök + -erei/-irei","en":"Condizionale","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Io] [v:vorrei] [o:un bicchiere d'acqua].","tr":"Bir bardak su rica ediyorum."},{"text":"[s:Tu] [v:dovresti] [o:dormire di più].","tr":"Daha çok uyumalısın."}],"notes":["parlare → parlerei, parleresti, parlerebbe, parleremmo, parlereste, parlerebbero."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"non","en":"non","role":"x"},{"tr":"Şart kipi fiil","en":"Condizionale","role":"v"}],"examples":[{"text":"[x:Non] [v:direi] così.","tr":"Ben öyle demezdim."},{"text":"Al tuo posto [x:non] [v:andrei].","tr":"Yerinde olsam gitmezdim."}]},{"kind":"question","title":"Kibar soru","formula":[{"tr":"Şart kipi fiil","en":"Condizionale","role":"v"},{"tr":"Mastar / Tümleç?","en":"Infinito?","role":"o"}],"examples":[{"text":"[v:Potrebbe] [o:ripetere], per favore?","tr":"Tekrar edebilir misiniz, lütfen?"},{"text":"[v:Ti dispiacerebbe] [o:aprire la finestra]?","tr":"Pencereyi açar mısın, rica etsem?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"Şart kipi fiil?","en":"Condizionale?","role":"v"}],"examples":[{"text":"[q:Che cosa] [v:faresti] al mio posto?","tr":"Benim yerimde olsan ne yapardın?"},{"text":"[q:Dove] [v:vorresti] vivere?","tr":"Nerede yaşamak isterdin?"}]}],"rules":["Kökler futuro ile aynıdır: sarei, avrei, andrei, verrei, vorrei, potrei, dovrei.","-are fiillerinde a → e olur: parlerei, mangerei.","Gerçek dışı koşulda se + congiuntivo imperfetto ile gelir: Se potessi, verrei."],"exceptions":[],"mistakes":[{"wrong":"Voglio un caffè. (barda)","right":"Vorrei un caffè.","note":"Kibar istekte condizionale tercih edilir."},{"wrong":"Se avrei tempo, verrei.","right":"Se avessi tempo, verrei.","note":"se'den sonra condizionale değil congiuntivo gelir."},{"wrong":"Parlarei","right":"Parlerei","note":"-are fiillerinde a, e'ye döner."}]}},
  {"id":"it-gr-trapassato-prossimo","languageId":"it","category":"grammar","level":"B1","sourceText":"Trapassato prossimo","translations":{"tr":["Geçmişin geçmişi (-mıştı)"]},"grammar":{"summary":"Trapassato prossimo, geçmişteki bir olaydan daha önce olmuş eylemi anlatır: avevo / ero + geçmiş ortaç.","uses":["Geçmişteki bir andan önce tamamlanmış eylem","Hikâye anlatımında arka plan (Quando sono arrivato, il film era già cominciato.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"avevo / ero","en":"Imperfetto di avere / essere","role":"a"},{"tr":"Geçmiş ortaç","en":"Participio passato","role":"v"}],"examples":[{"text":"[s:Io] [a:avevo] già [v:mangiato] quando sei arrivato.","tr":"Sen geldiğinde ben çoktan yemiştim."},{"text":"[s:Lei] [a:era] [v:uscita] prima delle otto.","tr":"O, saat sekizden önce çıkmıştı."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"non","en":"non","role":"x"},{"tr":"avevo / ero","en":"Ausiliare","role":"a"},{"tr":"Geçmiş ortaç","en":"Participio passato","role":"v"}],"examples":[{"text":"[x:Non] [a:avevo] mai [v:visto] il mare.","tr":"Daha önce hiç deniz görmemiştim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"avevi / eri","en":"Ausiliare","role":"a"},{"tr":"Geçmiş ortaç","en":"Participio passato","role":"v"},{"tr":"Tümleç?","en":"Complemento?","role":"o"}],"examples":[{"text":"[a:Avevi] già [v:finito] [o:il lavoro]?","tr":"İşi çoktan bitirmiş miydin?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Parola interrogativa","role":"q"},{"tr":"Yardımcı fiil","en":"Ausiliare","role":"a"},{"tr":"Geçmiş ortaç?","en":"Participio passato?","role":"v"}],"examples":[{"text":"[q:Dove] [a:eravate] [v:stati] prima?","tr":"Daha önce nerede bulunmuştunuz?"}]}],"rules":["Yardımcı fiil seçimi passato prossimo ile aynıdır.","essere ile ortaç özneye uyar: Le ragazze erano partite.","Sık zarflar: già, mai, appena, prima."],"exceptions":[],"mistakes":[{"wrong":"Quando sono arrivato, il film è già cominciato.","right":"Quando sono arrivato, il film era già cominciato.","note":"Daha önceki eylem trapassato ile anlatılır."},{"wrong":"Avevo andato","right":"Ero andato","note":"andare essere ile çekimlenir."}]}},
  {"id":"it-gr-futuro-anteriore","languageId":"it","category":"grammar","level":"B1","sourceText":"Futuro anteriore","translations":{"tr":["Gelecekte bitmiş zaman (-mış olacak)"]},"grammar":{"summary":"Futuro anteriore gelecekte başka bir eylemden önce tamamlanacak eylemi ve geçmişe dair tahmini anlatır.","uses":["Gelecekte önce bitecek eylem (Quando avrò finito, uscirò.)","Geçmişe dair tahmin (Avrà perso il treno.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"avrò / sarò","en":"Futuro di avere / essere","role":"a"},{"tr":"Geçmiş ortaç","en":"Participio passato","role":"v"}],"examples":[{"text":"Quando [a:avrò] [v:finito], ti chiamo.","tr":"Bitirince seni ararım."},{"text":"[s:Marco] [a:sarà] [v:partito] alle sei.","tr":"Marco saat altıda yola çıkmış olacak."}]},{"kind":"other","title":"Geçmişe dair tahmin","formula":[{"tr":"avrà / sarà","en":"Futuro di avere / essere","role":"a"},{"tr":"Geçmiş ortaç","en":"Participio passato","role":"v"}],"examples":[{"text":"Non risponde. [a:Sarà] [v:uscito].","tr":"Cevap vermiyor. Çıkmıştır herhalde."},{"text":"[a:Avrà] [v:dimenticato] l'appuntamento.","tr":"Randevuyu unutmuş olmalı."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"non","en":"non","role":"x"},{"tr":"avrò / sarò","en":"Ausiliare","role":"a"},{"tr":"Geçmiş ortaç","en":"Participio passato","role":"v"}],"examples":[{"text":"Se [x:non] [a:avrà] [v:capito], glielo rispiego.","tr":"Anlamamış olursa ona yeniden açıklarım."}]}],"rules":["Genellikle quando, dopo che, appena ile kullanılır.","Ana cümle futuro semplice veya presente olur.","Konuşmada sık olarak tahmin anlamıyla kullanılır."],"exceptions":["Günlük dilde zaman cümlesinde passato prossimo da duyulur: Appena ho finito, esco."],"mistakes":[{"wrong":"Quando finirò, uscirò. (önce bitecekse)","right":"Quando avrò finito, uscirò.","note":"Önce tamamlanacak eylem futuro anteriore ile daha doğru anlatılır."},{"wrong":"Avrà andato","right":"Sarà andato","note":"andare essere ile çekimlenir."}]}},
  {"id":"it-gr-imperativo-formale","languageId":"it","category":"grammar","level":"B1","sourceText":"Imperativo formale","translations":{"tr":["Resmî emir kipi (Lei)"]},"grammar":{"summary":"Resmî hitapta (Lei) emir congiuntivo biçimiyle yapılır ve zamirler fiilden önce gelir: Si accomodi!","uses":["Müşteriye, yabancıya talimat (Prenda la prima a destra.)","Resmî rica ve davet (Si sieda, prego.)"],"sections":[{"kind":"affirmative","title":"Olumlu emir (Lei)","formula":[{"tr":"(Zamir)","en":"Pronome","role":"o"},{"tr":"Congiuntivo biçimi","en":"Imperativo di cortesia","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"x"}],"examples":[{"text":"[v:Prenda] [x:la seconda a sinistra].","tr":"İkinci soldan dönün."},{"text":"[o:Si] [v:accomodi], prego.","tr":"Buyurun, oturun."}],"notes":["-are → -i (parli, giri); -ere/-ire → -a (prenda, senta, apra)."]},{"kind":"negative","title":"Olumsuz emir","formula":[{"tr":"non","en":"non","role":"x"},{"tr":"(Zamir)","en":"Pronome","role":"o"},{"tr":"Congiuntivo biçimi","en":"Imperativo di cortesia","role":"v"}],"examples":[{"text":"[x:Non] [o:si] [v:preoccupi].","tr":"Endişelenmeyin."},{"text":"[x:Non] [v:fumi] qui, per favore.","tr":"Lütfen burada sigara içmeyin."}]},{"kind":"other","title":"Düzensiz biçimler","formula":[{"tr":"Mastar","en":"Infinito","role":"v"},{"tr":"Lei emri","en":"Imperativo (Lei)","role":"o"}],"examples":[{"text":"[v:venire] → [o:venga] · [v:andare] → [o:vada] · [v:fare] → [o:faccia]","tr":"gelin · gidin · yapın"},{"text":"[v:dire] → [o:dica] · [v:essere] → [o:sia] · [v:avere] → [o:abbia]","tr":"söyleyin · olun · sahip olun"}],"notes":["Dükkânda sık: Mi dica! (Buyurun, sizi dinliyorum.)"]}],"rules":["Lei emrinde zamir her zaman fiilin önündedir: Mi scusi, La prego.","Çoğul resmî hitapta günümüzde genellikle voi emri kullanılır: Entrate pure.","Biçim congiuntivo presente'nin 3. tekil şahsıyla aynıdır."],"exceptions":[],"mistakes":[{"wrong":"Scusimi, signora.","right":"Mi scusi, signora.","note":"Lei emrinde zamir fiile bitişmez, önüne gelir."},{"wrong":"Prende la prima a destra. (talimat)","right":"Prenda la prima a destra.","note":"Resmî emirde -ere fiili -a ile biter."}]}},
  {"id":"it-gr-pronomi-relativi","languageId":"it","category":"grammar","level":"B1","sourceText":"Pronomi relativi","translations":{"tr":["İlgi zamirleri (che, cui, il quale)"]},"grammar":{"summary":"che özne ve nesne için, cui edattan sonra, il quale ise resmî dilde ve belirsizliği gidermek için kullanılır.","uses":["İki cümleyi birleştirmek","Bir ismi tanımlamak (Türkçe -en, -dığı)"],"sections":[{"kind":"other","title":"che: özne / nesne","formula":[{"tr":"İsim","en":"Antecedente","role":"s"},{"tr":"che","en":"che","role":"x"},{"tr":"Yan cümle","en":"Proposizione relativa","role":"v"}],"examples":[{"text":"[s:Il ragazzo] [x:che] [v:parla] è mio fratello.","tr":"Konuşan çocuk benim kardeşim."},{"text":"[s:Il libro] [x:che] [v:leggo] è bello.","tr":"Okuduğum kitap güzel."}],"notes":["che değişmez ve edatla kullanılmaz."]},{"kind":"other","title":"Edat + cui","formula":[{"tr":"İsim","en":"Antecedente","role":"s"},{"tr":"Edat + cui","en":"Preposizione + cui","role":"x"},{"tr":"Yan cümle","en":"Proposizione relativa","role":"v"}],"examples":[{"text":"[s:La città] [x:in cui] [v:vivo] è piccola.","tr":"Yaşadığım şehir küçük."},{"text":"[s:L'amico] [x:a cui] [v:ho scritto] non risponde.","tr":"Yazdığım arkadaş cevap vermiyor."}]},{"kind":"other","title":"il cui: kimin / hangisinin","formula":[{"tr":"İsim","en":"Antecedente","role":"s"},{"tr":"Tanımlık + cui + isim","en":"il cui + nome","role":"x"},{"tr":"Yan cümle","en":"Proposizione relativa","role":"v"}],"examples":[{"text":"[s:La donna] [x:il cui figlio] [v:studia qui]…","tr":"Oğlu burada okuyan kadın…"}]},{"kind":"other","title":"il quale / la quale","formula":[{"tr":"İsim","en":"Antecedente","role":"s"},{"tr":"(Edat +) il quale","en":"il quale","role":"x"},{"tr":"Yan cümle","en":"Proposizione relativa","role":"v"}],"examples":[{"text":"[s:La collega] [x:con la quale] [v:lavoro]…","tr":"Birlikte çalıştığım meslektaş…"}],"notes":["Resmî ve yazı diline özgüdür; cinsiyet ve sayıya uyar."]}],"rules":["Edat varsa che değil cui kullanılır: la persona con cui parlo.","dove yer için cui yerine geçer: la casa dove abito.","chi 'kim ki, … olan kişi' anlamındadır: Chi cerca trova."],"exceptions":["'Ne ki, şey ki' için ciò che / quello che: Fai quello che vuoi."],"mistakes":[{"wrong":"La città in che vivo","right":"La città in cui vivo","note":"Edattan sonra cui gelir."},{"wrong":"Il ragazzo cui parla","right":"Il ragazzo che parla","note":"Özne olan ilgi zamiri che'dir."},{"wrong":"La donna che il suo figlio…","right":"La donna il cui figlio…","note":"Sahiplik il cui ile anlatılır."}]}},
  {"id":"it-gr-congiuntivo-presente","languageId":"it","category":"grammar","level":"B1","sourceText":"Congiuntivo presente","translations":{"tr":["Dilek-şart kipi: şimdiki zaman"]},"grammar":{"summary":"Congiuntivo presente görüş, şüphe, istek, duygu bildiren ifadelerden sonra che'li yan cümlede kullanılır.","uses":["Görüş (Penso che sia vero.)","İstek ve emir (Voglio che tu venga.)","Duygu ve şüphe (Ho paura che piova.)","Bazı bağlaçlar (benché, prima che, affinché)"],"sections":[{"kind":"affirmative","title":"Ana cümle + che + congiuntivo","formula":[{"tr":"Görüş/istek fiili","en":"Verbo reggente","role":"v"},{"tr":"che","en":"che","role":"x"},{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"Congiuntivo","en":"Congiuntivo presente","role":"a"}],"examples":[{"text":"[v:Penso] [x:che] [s:Marco] [a:abbia] ragione.","tr":"Bence Marco haklı."},{"text":"[v:Voglio] [x:che] [s:tu] [a:venga] con me.","tr":"Benimle gelmeni istiyorum."}],"notes":["parlare → parli, parli, parli, parliamo, parliate, parlino; prendere → prenda…; dormire → dorma…"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Ana fiil","en":"Verbo reggente","role":"v"},{"tr":"che","en":"che","role":"x"},{"tr":"non + Congiuntivo","en":"non + congiuntivo","role":"a"}],"examples":[{"text":"[v:Spero] [x:che] [a:non piova].","tr":"Umarım yağmur yağmaz."},{"text":"[v:Non credo] [x:che] [a:sia] facile.","tr":"Kolay olduğunu sanmıyorum."}]},{"kind":"other","title":"Bağlaç + congiuntivo","formula":[{"tr":"Bağlaç","en":"Congiunzione","role":"x"},{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"Congiuntivo","en":"Congiuntivo presente","role":"a"}],"examples":[{"text":"[x:Benché] [a:sia] tardi, resto.","tr":"Geç olmasına rağmen kalıyorum."},{"text":"Ti chiamo [x:prima che] [s:tu] [a:parta].","tr":"Sen yola çıkmadan önce seni ararım."}]},{"kind":"other","title":"Düzensiz biçimler","formula":[{"tr":"Mastar","en":"Infinito","role":"v"},{"tr":"Congiuntivo (io/tu/lui)","en":"Congiuntivo presente","role":"a"}],"examples":[{"text":"[v:essere] → [a:sia] · [v:avere] → [a:abbia] · [v:fare] → [a:faccia]","tr":"olmak · sahip olmak · yapmak"},{"text":"[v:andare] → [a:vada] · [v:venire] → [a:venga] · [v:potere] → [a:possa]","tr":"gitmek · gelmek · -ebilmek"}]}],"rules":["İki cümlenin öznesi aynıysa di + mastar kullanılır: Penso di partire (✗ Penso che io parta).","Tekil üç şahıs aynı olduğundan özne zamiri sık kullanılır: che tu venga.","Kesinlik bildiren ifadeler (so che, è vero che) indicativo alır."],"exceptions":["Günlük konuşmada bazen indicativo duyulur, ama yazıda congiuntivo beklenir."],"mistakes":[{"wrong":"Penso che è vero.","right":"Penso che sia vero.","note":"Görüş bildiren fiillerden sonra congiuntivo gelir."},{"wrong":"Voglio che vieni.","right":"Voglio che tu venga.","note":"İstek fiilinden sonra congiuntivo gerekir."},{"wrong":"Spero che io vinca.","right":"Spero di vincere.","note":"Özneler aynıysa di + mastar kullanılır."}]}},
  {"id":"it-gr-congiuntivo-passato","languageId":"it","category":"grammar","level":"B1","sourceText":"Congiuntivo passato","translations":{"tr":["Dilek-şart kipi: geçmiş zaman"]},"grammar":{"summary":"Congiuntivo passato, congiuntivo gerektiren ifadeden sonra daha önce olmuş eylemi anlatır: abbia fatto, sia andato.","uses":["Geçmişe dair görüş (Credo che sia partito.)","Geçmişe dair duygu ve şüphe (Mi dispiace che tu abbia perso.)"],"sections":[{"kind":"affirmative","title":"che + abbia/sia + ortaç","formula":[{"tr":"Ana fiil (şimdiki)","en":"Verbo reggente","role":"v"},{"tr":"che","en":"che","role":"x"},{"tr":"abbia / sia","en":"Congiuntivo di avere / essere","role":"a"},{"tr":"Geçmiş ortaç","en":"Participio passato","role":"o"}],"examples":[{"text":"[v:Credo] [x:che] [a:abbia] [o:capito].","tr":"Sanırım anladı."},{"text":"[v:Sono contento] [x:che] [a:siate] [o:venuti].","tr":"Gelmenize sevindim."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Ana fiil","en":"Verbo reggente","role":"v"},{"tr":"che","en":"che","role":"x"},{"tr":"non + abbia / sia","en":"non + ausiliare","role":"a"},{"tr":"Geçmiş ortaç","en":"Participio passato","role":"o"}],"examples":[{"text":"[v:Mi sembra] [x:che] [a:non abbia] [o:mangiato].","tr":"Yemek yememiş gibi görünüyor."},{"text":"[v:Peccato] [x:che] [a:non sia] [o:venuta].","tr":"Gelmemesi yazık oldu."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Ana fiil?","en":"Verbo reggente","role":"v"},{"tr":"che","en":"che","role":"x"},{"tr":"abbia / sia + ortaç","en":"Congiuntivo passato","role":"a"}],"examples":[{"text":"[v:Pensi] [x:che] [a:abbiano] già [o:deciso]?","tr":"Sence çoktan karar verdiler mi?"}]}],"rules":["Ana fiil şimdiki/gelecek zamanda, yan cümledeki eylem daha önce olmuşsa kullanılır.","Yardımcı fiil seçimi passato prossimo ile aynıdır; essere ile ortaç uyar.","Aynı özne: di + aver/esser + ortaç (Penso di aver sbagliato)."],"exceptions":[],"mistakes":[{"wrong":"Credo che è partito.","right":"Credo che sia partito.","note":"credere'den sonra congiuntivo gelir."},{"wrong":"Penso che io abbia sbagliato.","right":"Penso di aver sbagliato.","note":"Özneler aynıysa di + geçmiş mastar."}]}},
  {"id":"it-gr-congiuntivo-imperfetto","languageId":"it","category":"grammar","level":"B1","sourceText":"Congiuntivo imperfetto","translations":{"tr":["Dilek-şart kipi: hikâye geçmişi"]},"grammar":{"summary":"Congiuntivo imperfetto, ana fiil geçmişte veya condizionale'de olduğunda ve gerçek dışı se cümlelerinde kullanılır.","uses":["Geçmişteki görüş/istek (Pensavo che fosse vero.)","Dilek (Vorrei che tu restassi.)","Gerçek dışı koşul (Se avessi tempo…)","Magari ile özlem (Magari fosse vero!)"],"sections":[{"kind":"affirmative","title":"Geçmiş ana fiil + che","formula":[{"tr":"Ana fiil (geçmiş)","en":"Verbo reggente al passato","role":"v"},{"tr":"che","en":"che","role":"x"},{"tr":"Congiuntivo imperfetto","en":"Congiuntivo imperfetto","role":"a"}],"examples":[{"text":"[v:Pensavo] [x:che] [a:fossi] a casa.","tr":"Evde olduğunu sanıyordum."},{"text":"[v:Volevano] [x:che] [a:restassimo].","tr":"Kalmamızı istiyorlardı."}],"notes":["parlare → parlassi, parlassi, parlasse, parlassimo, parlaste, parlassero; prendere → prendessi; dormire → dormissi."]},{"kind":"other","title":"Vorrei che + congiuntivo imperfetto","formula":[{"tr":"vorrei / preferirei","en":"Condizionale","role":"v"},{"tr":"che","en":"che","role":"x"},{"tr":"Congiuntivo imperfetto","en":"Congiuntivo imperfetto","role":"a"}],"examples":[{"text":"[v:Vorrei] [x:che] tu [a:venissi] con me.","tr":"Benimle gelmeni isterdim."},{"text":"[v:Sarebbe meglio] [x:che] [a:partisse] subito.","tr":"Hemen yola çıkması daha iyi olurdu."}]},{"kind":"other","title":"Düzensiz biçimler","formula":[{"tr":"Mastar","en":"Infinito","role":"v"},{"tr":"Congiuntivo imperfetto (io)","en":"Congiuntivo imperfetto","role":"a"}],"examples":[{"text":"[v:essere] → [a:fossi] · [v:fare] → [a:facessi] · [v:dire] → [a:dicessi]","tr":"olmak · yapmak · söylemek"},{"text":"[v:dare] → [a:dessi] · [v:stare] → [a:stessi] · [v:bere] → [a:bevessi]","tr":"vermek · durmak · içmek"}]}],"rules":["Ana fiil geçmişte ise yan cümlede congiuntivo imperfetto gelir: Credevo che fosse…","avere düzenlidir: avessi, avessi, avesse…","Magari + congiuntivo imperfetto: 'keşke' (Magari potessi!)."],"exceptions":[],"mistakes":[{"wrong":"Pensavo che sei a casa.","right":"Pensavo che fossi a casa.","note":"Geçmiş görüş fiilinden sonra congiuntivo imperfetto gelir."},{"wrong":"Vorrei che vieni.","right":"Vorrei che venissi.","note":"vorrei che yapısı congiuntivo imperfetto ister."},{"wrong":"Se sarei ricco…","right":"Se fossi ricco…","note":"se'den sonra condizionale değil congiuntivo gelir."}]}},
  {"id":"it-gr-periodo-ipotetico","languageId":"it","category":"grammar","level":"B1","sourceText":"Periodo ipotetico","translations":{"tr":["Koşul cümleleri (se)"]},"grammar":{"summary":"Gerçek koşul se + indicativo, olası/gerçek dışı koşul se + congiuntivo imperfetto + condizionale ile kurulur.","uses":["Gerçekleşmesi muhtemel koşul (Se piove, resto a casa.)","Şimdiye dair hayal ve varsayım (Se fossi ricco, viaggerei.)"],"sections":[{"kind":"other","title":"1. tip: gerçek koşul","formula":[{"tr":"se","en":"se","role":"x"},{"tr":"Presente / Futuro","en":"Indicativo","role":"a"},{"tr":"Presente / Futuro / Emir","en":"Indicativo / Imperativo","role":"v"}],"examples":[{"text":"[x:Se] [a:hai] tempo, [v:chiamami].","tr":"Vaktin olursa beni ara."},{"text":"[x:Se] [a:studierai], [v:passerai] l'esame.","tr":"Çalışırsan sınavı geçersin."}]},{"kind":"other","title":"2. tip: olası / gerçek dışı (şimdi)","formula":[{"tr":"se","en":"se","role":"x"},{"tr":"Congiuntivo imperfetto","en":"Congiuntivo imperfetto","role":"a"},{"tr":"Condizionale presente","en":"Condizionale presente","role":"v"}],"examples":[{"text":"[x:Se] [a:avessi] più soldi, [v:comprerei] una casa.","tr":"Daha çok param olsa bir ev alırdım."},{"text":"[x:Se] [a:fossi] in te, [v:accetterei].","tr":"Senin yerinde olsam kabul ederdim."}]},{"kind":"other","title":"Ana cümle başta","formula":[{"tr":"Condizionale","en":"Condizionale presente","role":"v"},{"tr":"se","en":"se","role":"x"},{"tr":"Congiuntivo imperfetto","en":"Congiuntivo imperfetto","role":"a"}],"examples":[{"text":"[v:Verrei] volentieri [x:se] [a:potessi].","tr":"Elimden gelse seve seve gelirdim."}]}],"rules":["se'den sonra asla condizionale gelmez.","Cümleler yer değiştirebilir; anlam değişmez.","3. tip (geçmişte gerçek dışı) B2 konusudur: Se avessi saputo, sarei venuto."],"exceptions":["Konuşmada 1. tipte se'li kısımda da futuro kullanılabilir: Se verrai, ti divertirai."],"mistakes":[{"wrong":"Se avrei tempo, verrei.","right":"Se avessi tempo, verrei.","note":"se'den sonra congiuntivo imperfetto gelir."},{"wrong":"Se fossi in te, accetto.","right":"Se fossi in te, accetterei.","note":"2. tipte ana cümle condizionale olur."},{"wrong":"Se ero ricco, viaggiavo.","right":"Se fossi ricco, viaggerei.","note":"İmperfetto'lu yapı konuşma dilidir; standart biçim congiuntivo + condizionale."}]}},
  {"id":"it-gr-la-forma-passiva","languageId":"it","category":"grammar","level":"B1","sourceText":"La forma passiva","translations":{"tr":["Edilgen çatı"]},"grammar":{"summary":"Edilgen çatı essere (veya venire) + geçmiş ortaç ile kurulur; eylemi yapan da ile belirtilir.","uses":["Eylemden etkileneni öne çıkarmak","Haber ve resmî dil (Il ponte è stato costruito nel 1900.)"],"sections":[{"kind":"affirmative","title":"Etken → edilgen","formula":[{"tr":"Etkilenen (özne)","en":"Soggetto","role":"s"},{"tr":"essere / venire","en":"Ausiliare","role":"a"},{"tr":"Uyumlu ortaç","en":"Participio passato","role":"v"},{"tr":"da + yapan","en":"Complemento d'agente","role":"o"}],"examples":[{"text":"[s:La lettera] [a:è] [v:scritta] [o:da Anna].","tr":"Mektup Anna tarafından yazılıyor."},{"text":"[s:I biglietti] [a:vengono] [v:venduti] [o:online].","tr":"Biletler internetten satılıyor."}],"notes":["Ortaç özneye uyar: la porta è chiusa, le porte sono chiuse."]},{"kind":"other","title":"Bileşik zamanlarda edilgen","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"essere (bileşik) + stato","en":"è stato / sarà stato","role":"a"},{"tr":"Ortaç","en":"Participio passato","role":"v"}],"examples":[{"text":"[s:Il museo] [a:è stato] [v:chiuso] ieri.","tr":"Müze dün kapatıldı."},{"text":"[s:La casa] [a:è stata] [v:venduta].","tr":"Ev satıldı."}],"notes":["venire bileşik zamanlarda kullanılmaz."]},{"kind":"other","title":"andare + ortaç: zorunluluk","formula":[{"tr":"Özne","en":"Soggetto","role":"s"},{"tr":"andare","en":"andare","role":"a"},{"tr":"Ortaç","en":"Participio passato","role":"v"}],"examples":[{"text":"[s:Il modulo] [a:va] [v:compilato] in stampatello.","tr":"Form büyük harflerle doldurulmalı."}]}],"rules":["Sadece geçişli fiiller edilgen yapılabilir.","venire sadece basit zamanlarda, süreç vurgusu için kullanılır.","Yapan belirtilmezse da kısmı atlanır."],"exceptions":[],"mistakes":[{"wrong":"La casa è stato venduto.","right":"La casa è stata venduta.","note":"Edilgende ortaç özneye uyar."},{"wrong":"Il libro è scritto di Eco.","right":"Il libro è scritto da Eco.","note":"Eylemi yapan da ile verilir."},{"wrong":"La porta è venuta chiusa.","right":"La porta è stata chiusa.","note":"Bileşik zamanlarda venire değil essere kullanılır."}]}},
  {"id":"it-gr-si-impersonale-e-si-passivante","languageId":"it","category":"grammar","level":"B1","sourceText":"Si impersonale e si passivante","translations":{"tr":["Genel özne si (-ılır, -ınır)"]},"grammar":{"summary":"si + 3. şahıs fiil genel bir özneyi anlatır: Qui si mangia bene (Burada iyi yemek yenir).","uses":["Genel doğrular ve kurallar (In Italia si cena tardi.)","Tabela ve ilanlar (Si affitta appartamento.)","Tarifler ve talimatlar (Si aggiunge il sale.)"],"sections":[{"kind":"other","title":"si impersonale (nesnesiz)","formula":[{"tr":"si","en":"si","role":"x"},{"tr":"Fiil (3. tekil)","en":"Verbo alla terza persona","role":"v"}],"examples":[{"text":"In questo ristorante [x:si] [v:mangia] bene.","tr":"Bu restoranda iyi yemek yenir."},{"text":"Qui non [x:si] [v:fuma].","tr":"Burada sigara içilmez."}]},{"kind":"other","title":"si passivante (nesneyle uyum)","formula":[{"tr":"si","en":"si","role":"x"},{"tr":"Fiil (tekil/çoğul)","en":"Verbo concordato","role":"v"},{"tr":"Nesne → özne","en":"Soggetto","role":"s"}],"examples":[{"text":"[x:Si] [v:vende] [s:casa].","tr":"Satılık ev."},{"text":"In Italia [x:si] [v:bevono] [s:molti caffè].","tr":"İtalya'da çok kahve içilir."}],"notes":["Nesne çoğulsa fiil de çoğul olur."]},{"kind":"other","title":"Sıfat ve dönüşlü fiillerle","formula":[{"tr":"si / ci si","en":"si / ci si","role":"x"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Çoğul sıfat","en":"Aggettivo plurale","role":"o"}],"examples":[{"text":"Quando [x:si] [v:è] [o:stanchi], si dorme male.","tr":"Yorgun olunca kötü uyunur."},{"text":"La domenica [x:ci si] [v:alza] tardi.","tr":"Pazarları geç kalkılır."}]}],"rules":["Bileşik zamanlarda essere kullanılır: Si è mangiato bene.","si + sıfat yapısında sıfat çoğul olur: Si è felici.","Dönüşlü fiilde si si yerine ci si denir: ci si lava."],"exceptions":[],"mistakes":[{"wrong":"Si vende appartamenti.","right":"Si vendono appartamenti.","note":"Nesne çoğulsa fiil çoğul olur."},{"wrong":"Si si alza presto.","right":"Ci si alza presto.","note":"Dönüşlü fiilde ci si kullanılır."},{"wrong":"Si è stanco.","right":"Si è stanchi.","note":"Genel öznede sıfat çoğul olur."}]}}
]
