  {"id":"it-expr-il-fatto-e-che","languageId":"it","category":"expressions","level":"B1","sourceText":"il fatto è che","translations":{"tr":["mesele şu ki","işin aslı"]},"tags":["discourse-marker"],"details":{"usage":"Asıl sorunu açıklamaya girişir.","register":"neutral"},"examples":[{"text":"Il fatto è che non ho soldi.","tr":"Mesele şu ki param yok."}]},
  {"id":"it-expr-non-e-che","languageId":"it","category":"expressions","level":"B1","sourceText":"non è che","translations":{"tr":["... değil ki","yoksa ... mı?"]},"details":{"usage":"Bir şeyi yumuşatarak reddeder ya da kibarca sorar.","register":"informal"},"examples":[{"text":"Non è che non voglio, è che non posso.","tr":"İstemediğimden değil, yapamıyorum."}]},
  {"id":"it-expr-vale-la-pena","languageId":"it","category":"expressions","level":"B1","sourceText":"vale la pena","translations":{"tr":["değer","zahmetine değer"]},"details":{"usage":"'Di' + mastarla: vale la pena di provare.","register":"neutral"},"examples":[{"text":"Vale la pena vedere questo film.","tr":"Bu film görmeye değer."}]},
  {"id":"it-expr-fare-a-meno-di","languageId":"it","category":"expressions","level":"B1","sourceText":"fare a meno di","translations":{"tr":["-den vazgeçmek","-sız yapmak"]},"details":{"usage":"Non posso fare a meno di = -meden edemem.","register":"neutral"},"examples":[{"text":"Non posso fare a meno del caffè.","tr":"Kahvesiz yapamam."}]},
  {"id":"it-expr-mettersi-a","languageId":"it","category":"expressions","level":"B1","sourceText":"mettersi a","translations":{"tr":["-meye başlamak","-meye koyulmak"]},"details":{"usage":"Ani başlangıç: si è messo a piangere.","register":"neutral"},"examples":[{"text":"All'improvviso si è messa a ridere.","tr":"Birdenbire gülmeye başladı."}]},
  {"id":"it-expr-in-pratica","languageId":"it","category":"expressions","level":"B1","sourceText":"in pratica","translations":{"tr":["kısacası","pratikte"]},"tags":["discourse-marker"],"details":{"usage":"Konuşmada özet yaparken çok sık.","register":"neutral"},"examples":[{"text":"In pratica abbiamo finito.","tr":"Kısacası bitirdik."}]},
  {"id":"it-expr-in-generale","languageId":"it","category":"expressions","level":"B1","sourceText":"in generale","translations":{"tr":["genel olarak"]},"details":{"usage":"Genelleme yaparken.","register":"neutral"},"examples":[{"text":"In generale sono contento.","tr":"Genel olarak memnunum."}]},
  {"id":"it-expr-in-particolare","languageId":"it","category":"expressions","level":"B1","sourceText":"in particolare","translations":{"tr":["özellikle"]},"details":{"usage":"Bir öğeyi öne çıkarır.","register":"neutral"},"examples":[{"text":"Mi piace l'arte, in particolare la pittura.","tr":"Sanatı severim, özellikle resmi."}]},
  {"id":"it-expr-soprattutto","languageId":"it","category":"expressions","level":"B1","sourceText":"soprattutto","translations":{"tr":["özellikle","hele"]},"details":{"usage":"En önemli öğeyi vurgular.","register":"neutral"},"examples":[{"text":"Mi piace viaggiare, soprattutto in Italia.","tr":"Seyahat etmeyi severim, özellikle İtalya'da."}]},
  {"id":"it-expr-a-mio-parere","languageId":"it","category":"expressions","level":"B1","sourceText":"a mio parere","translations":{"tr":["bence","kanımca"]},"tags":["opinion"],"details":{"usage":"'Secondo me'den biraz daha resmî.","register":"neutral"},"examples":[{"text":"A mio parere, è la scelta giusta.","tr":"Bence doğru seçim bu."}]},
  {"id":"it-expr-dal-mio-punto-di-vista","languageId":"it","category":"expressions","level":"B1","sourceText":"dal mio punto di vista","translations":{"tr":["benim açımdan","bakış açıma göre"]},"tags":["opinion"],"details":{"usage":"Görüş bildirirken.","register":"neutral"},"examples":[{"text":"Dal mio punto di vista, è un errore.","tr":"Benim açımdan bu bir hata."}]},
  {"id":"it-expr-sinceramente","languageId":"it","category":"expressions","level":"B1","sourceText":"sinceramente","translations":{"tr":["açıkçası","dürüst olmak gerekirse"]},"tags":["opinion"],"details":{"usage":"Samimi görüş bildirmeden önce.","register":"neutral"},"examples":[{"text":"Sinceramente, non mi è piaciuto.","tr":"Açıkçası beğenmedim."}]},
  {"id":"it-expr-come-mai","languageId":"it","category":"expressions","level":"B1","sourceText":"come mai?","translations":{"tr":["nasıl oldu da?","neden?"]},"details":{"usage":"Şaşkınlıkla neden sorar; 'perché'den yumuşak.","register":"neutral"},"examples":[{"text":"Come mai sei qui così presto?","tr":"Nasıl oldu da bu kadar erken geldin?"}]},
  {"id":"it-expr-non-centra","languageId":"it","category":"expressions","level":"B1","sourceText":"non c'entra","translations":{"tr":["alakası yok","konuyla ilgisi yok"]},"details":{"usage":"'Entrarci' fiilinden; 'che c'entra?' = ne alakası var?","register":"neutral"},"examples":[{"text":"Questo non c'entra niente!","tr":"Bunun hiç alakası yok!"}]},
  {"id":"it-expr-per-colpa-di","languageId":"it","category":"expressions","level":"B1","sourceText":"per colpa di","translations":{"tr":["... yüzünden","... suçundan"]},"details":{"usage":"Suçlu kişiyi ya da şeyi gösterir.","register":"neutral"},"examples":[{"text":"Abbiamo perso il treno per colpa tua.","tr":"Senin yüzünden treni kaçırdık."}]},
  {"id":"it-expr-in-modo-da","languageId":"it","category":"expressions","level":"B1","sourceText":"in modo da","translations":{"tr":["-mek için","-ecek şekilde"]},"details":{"usage":"Amaç bildirir; arkasından mastar gelir.","register":"neutral"},"examples":[{"text":"Parto presto in modo da evitare il traffico.","tr":"Trafikten kaçmak için erken çıkıyorum."}]},
  {"id":"it-expr-il-piu-possibile","languageId":"it","category":"expressions","level":"B1","sourceText":"il più possibile","translations":{"tr":["olabildiğince","mümkün olduğunca"]},"details":{"usage":"Fiilden sonra gelir: dormi il più possibile.","register":"neutral"},"examples":[{"text":"Cerca di riposare il più possibile.","tr":"Olabildiğince dinlenmeye çalış."}]},
  {"id":"it-expr-a-lungo","languageId":"it","category":"expressions","level":"B1","sourceText":"a lungo","translations":{"tr":["uzun süre"]},"details":{"usage":"Süre bildirir.","register":"neutral"},"examples":[{"text":"Abbiamo parlato a lungo.","tr":"Uzun süre konuştuk."}]},
  {"id":"it-expr-a-un-certo-punto","languageId":"it","category":"expressions","level":"B1","sourceText":"a un certo punto","translations":{"tr":["bir noktada","bir ara"]},"details":{"usage":"Anlatıda ani değişikliği başlatır.","register":"neutral"},"examples":[{"text":"A un certo punto è arrivata la polizia.","tr":"Bir ara polis geldi."}]},
  {"id":"it-expr-nel-senso-che","languageId":"it","category":"expressions","level":"B1","sourceText":"nel senso che","translations":{"tr":["yani","şu anlamda ki"]},"tags":["discourse-marker"],"details":{"usage":"Söyleneni açıklar.","register":"informal"},"examples":[{"text":"È strano, nel senso che non parla mai.","tr":"Tuhaf, yani hiç konuşmuyor."}]},
  {"id":"it-expr-tanto","languageId":"it","category":"expressions","level":"B1","sourceText":"tanto","translations":{"tr":["nasılsa","zaten"]},"tags":["discourse-marker"],"details":{"usage":"Konuşmada 'nasılsa' anlamında: tanto non cambia niente.","register":"informal"},"examples":[{"text":"Non preoccuparti, tanto abbiamo tempo.","tr":"Merak etme, nasılsa vaktimiz var."}]},
  {"id":"it-expr-pure","languageId":"it","category":"expressions","level":"B1","sourceText":"pure","translations":{"tr":["de","bile","buyur"]},"details":{"usage":"'Anche' anlamında ya da izin verirken: entra pure.","register":"informal"},"examples":[{"text":"Vieni pure tu, se vuoi.","tr":"İstersen sen de gel."}]}
