  {"id":"it-expr-infatti","languageId":"it","category":"expressions","level":"B1","sourceText":"infatti","translations":{"tr":["nitekim","gerçekten de","zaten"]},"tags":["discourse-marker"],"details":{"usage":"Önceki sözü doğrular; 'aslında' anlamında değildir.","register":"neutral"},"examples":[{"text":"Ha detto che pioveva, e infatti piove.","tr":"Yağmur yağacak dedi, nitekim yağıyor."}]},
  {"id":"it-expr-insomma","languageId":"it","category":"expressions","level":"B1","sourceText":"insomma","translations":{"tr":["kısacası","yani","eh işte"]},"tags":["discourse-marker"],"details":{"usage":"Özetler; tek başına 'şöyle böyle' ya da sabırsızlık bildirir.","register":"neutral"},"examples":[{"text":"Insomma, non ci siamo divertiti molto.","tr":"Kısacası pek eğlenmedik."}]},
  {"id":"it-expr-a-proposito","languageId":"it","category":"expressions","level":"B1","sourceText":"a proposito","translations":{"tr":["aklıma gelmişken","bu arada"]},"tags":["discourse-marker"],"details":{"usage":"Konuyla bağlantılı bir şeye geçerken; 'a proposito di' = ... hakkında.","register":"neutral"},"examples":[{"text":"A proposito, hai sentito Paolo?","tr":"Aklıma gelmişken, Paolo'dan haber aldın mı?"}]},
  {"id":"it-expr-in-realta","languageId":"it","category":"expressions","level":"B1","sourceText":"in realtà","translations":{"tr":["aslında","gerçekte"]},"tags":["discourse-marker"],"details":{"usage":"Görünenin aksini belirtir.","register":"neutral"},"examples":[{"text":"Sembra facile, ma in realtà è difficile.","tr":"Kolay görünüyor ama aslında zor."}]},
  {"id":"it-expr-in-effetti","languageId":"it","category":"expressions","level":"B1","sourceText":"in effetti","translations":{"tr":["gerçekten","hakikaten de"]},"tags":["discourse-marker"],"details":{"usage":"Karşı tarafın sözünü onaylarken.","register":"neutral"},"examples":[{"text":"Fa freddo qui. — In effetti sì.","tr":"Burası soğuk. — Hakikaten öyle."}]},
  {"id":"it-expr-anzi","languageId":"it","category":"expressions","level":"B1","sourceText":"anzi","translations":{"tr":["aksine","hatta"]},"tags":["discourse-marker"],"details":{"usage":"Önceki sözü düzeltir ya da güçlendirir.","register":"neutral"},"examples":[{"text":"Non sono stanco, anzi, ho voglia di ballare.","tr":"Yorgun değilim, aksine dans etmek istiyorum."}]},
  {"id":"it-expr-a-dire-il-vero","languageId":"it","category":"expressions","level":"B1","sourceText":"a dire il vero","translations":{"tr":["doğrusu","açıkçası"]},"tags":["discourse-marker"],"details":{"usage":"Samimi bir itiraf öncesi kullanılır.","register":"neutral"},"examples":[{"text":"A dire il vero, non mi ricordo.","tr":"Doğrusu hatırlamıyorum."}]},
  {"id":"it-expr-nel-frattempo","languageId":"it","category":"expressions","level":"B1","sourceText":"nel frattempo","translations":{"tr":["bu arada","o sırada"]},"tags":["discourse-marker"],"details":{"usage":"Aynı zaman diliminde olan başka bir şeyi anlatır.","register":"neutral"},"examples":[{"text":"Io cucino, nel frattempo tu apparecchi.","tr":"Ben yemek yapıyorum, sen bu arada sofrayı kur."}]},
  {"id":"it-expr-daltra-parte","languageId":"it","category":"expressions","level":"B1","sourceText":"d'altra parte","translations":{"tr":["öte yandan","zaten"]},"tags":["discourse-marker"],"details":{"usage":"Karşıt bir görüş ya da gerekçe sunar.","register":"neutral"},"examples":[{"text":"È caro; d'altra parte è di ottima qualità.","tr":"Pahalı; öte yandan çok kaliteli."}]},
  {"id":"it-expr-da-un-lato-dallaltro","languageId":"it","category":"expressions","level":"B1","sourceText":"da un lato... dall'altro","translations":{"tr":["bir yandan ... öte yandan"]},"tags":["discourse-marker"],"details":{"usage":"İki yönü karşılaştırırken.","register":"neutral"},"examples":[{"text":"Da un lato voglio partire, dall'altro ho paura.","tr":"Bir yandan gitmek istiyorum, öte yandan korkuyorum."}]},
  {"id":"it-expr-inoltre","languageId":"it","category":"expressions","level":"B1","sourceText":"inoltre","translations":{"tr":["ayrıca","üstelik"]},"tags":["discourse-marker"],"details":{"usage":"Yazıda ve resmî konuşmada sık.","register":"neutral"},"examples":[{"text":"L'appartamento è grande; inoltre è vicino al centro.","tr":"Daire büyük; ayrıca merkeze yakın."}]},
  {"id":"it-expr-tuttavia","languageId":"it","category":"expressions","level":"B1","sourceText":"tuttavia","translations":{"tr":["yine de","ancak"]},"tags":["discourse-marker"],"details":{"usage":"'Però'nun daha resmî karşılığı.","register":"formal"},"examples":[{"text":"Il piano è buono; tuttavia costa troppo.","tr":"Plan iyi; ancak çok pahalı."}]},
  {"id":"it-expr-eppure","languageId":"it","category":"expressions","level":"B1","sourceText":"eppure","translations":{"tr":["yine de","buna rağmen"]},"tags":["discourse-marker"],"details":{"usage":"Şaşırtıcı bir karşıtlığı vurgular.","register":"neutral"},"examples":[{"text":"Ha studiato poco, eppure ha passato l'esame.","tr":"Az çalıştı, yine de sınavı geçti."}]},
  {"id":"it-expr-dunque","languageId":"it","category":"expressions","level":"B1","sourceText":"dunque","translations":{"tr":["demek ki","öyleyse"]},"tags":["discourse-marker"],"details":{"usage":"'Quindi' ile yakın; biraz daha resmî.","register":"neutral"},"examples":[{"text":"Dunque, dove eravamo rimasti?","tr":"Eee, nerede kalmıştık?"}]},
  {"id":"it-expr-percio","languageId":"it","category":"expressions","level":"B1","sourceText":"perciò","translations":{"tr":["bu yüzden","bundan dolayı"]},"tags":["discourse-marker"],"details":{"usage":"Sonuç bildirir; 'quindi' ile aynı.","register":"neutral"},"examples":[{"text":"Ero malato, perciò non sono venuto.","tr":"Hastaydım, bu yüzden gelmedim."}]},
  {"id":"it-expr-mi-sa-che","languageId":"it","category":"expressions","level":"B1","sourceText":"mi sa che","translations":{"tr":["galiba","bana öyle geliyor ki"]},"details":{"usage":"Konuşma dilinde tahmin bildirir.","register":"informal"},"examples":[{"text":"Mi sa che domani piove.","tr":"Galiba yarın yağmur yağacak."}]},
  {"id":"it-expr-fare-finta-di","languageId":"it","category":"expressions","level":"B1","sourceText":"fare finta di","translations":{"tr":["-miş gibi yapmak"]},"details":{"usage":"Arkasından mastar gelir.","register":"neutral"},"examples":[{"text":"Ha fatto finta di non vedermi.","tr":"Beni görmemiş gibi yaptı."}]},
  {"id":"it-expr-a-parte","languageId":"it","category":"expressions","level":"B1","sourceText":"a parte","translations":{"tr":["... dışında","... bir yana"]},"details":{"usage":"A parte questo = bunun dışında.","register":"neutral"},"examples":[{"text":"A parte il prezzo, l'albergo era perfetto.","tr":"Fiyat dışında otel mükemmeldi."}]},
  {"id":"it-expr-tra-laltro","languageId":"it","category":"expressions","level":"B1","sourceText":"tra l'altro","translations":{"tr":["bu arada","üstelik"]},"tags":["discourse-marker"],"details":{"usage":"Ek bir bilgi eklerken; 'fra l'altro' da denir.","register":"neutral"},"examples":[{"text":"Tra l'altro, domani è festa.","tr":"Bu arada yarın tatil."}]},
  {"id":"it-expr-per-quanto-riguarda","languageId":"it","category":"expressions","level":"B1","sourceText":"per quanto riguarda","translations":{"tr":["... konusuna gelince","... açısından"]},"details":{"usage":"Konu başlığını belirtir.","register":"neutral"},"examples":[{"text":"Per quanto riguarda il viaggio, partiamo lunedì.","tr":"Yolculuğa gelince, pazartesi yola çıkıyoruz."}]},
  {"id":"it-expr-in-ogni-caso","languageId":"it","category":"expressions","level":"B1","sourceText":"in ogni caso","translations":{"tr":["her halükârda","ne olursa olsun"]},"tags":["discourse-marker"],"details":{"usage":"Durum ne olursa olsun sonucu değiştirmez.","register":"neutral"},"examples":[{"text":"In ogni caso ti chiamo domani.","tr":"Her halükârda yarın seni ararım."}]},
  {"id":"it-expr-a-meno-che","languageId":"it","category":"expressions","level":"B1","sourceText":"a meno che","translations":{"tr":["-medikçe","... olmadıkça"]},"details":{"usage":"Arkasından congiuntivo gelir: a meno che non piova.","register":"neutral"},"examples":[{"text":"Vengo, a meno che non succeda qualcosa.","tr":"Bir şey olmazsa gelirim."}]},
  {"id":"it-expr-anche-se","languageId":"it","category":"expressions","level":"B1","sourceText":"anche se","translations":{"tr":["-se bile","-mesine rağmen"]},"details":{"usage":"Bildirme kipiyle kullanılır.","register":"neutral"},"examples":[{"text":"Esco anche se piove.","tr":"Yağmur yağsa bile çıkıyorum."}]},
  {"id":"it-expr-siccome","languageId":"it","category":"expressions","level":"B1","sourceText":"siccome","translations":{"tr":["-diği için","madem"]},"details":{"usage":"Neden bildirir, genelde cümlenin başında gelir.","register":"neutral"},"examples":[{"text":"Siccome era tardi, ho preso un taxi.","tr":"Geç olduğu için taksiye bindim."}]},
  {"id":"it-expr-dato-che","languageId":"it","category":"expressions","level":"B1","sourceText":"dato che","translations":{"tr":["-diğine göre","madem ki"]},"details":{"usage":"'Visto che' ile aynı anlam.","register":"neutral"},"examples":[{"text":"Dato che sei qui, aiutami.","tr":"Madem buradasın, bana yardım et."}]},
  {"id":"it-expr-visto-che","languageId":"it","category":"expressions","level":"B1","sourceText":"visto che","translations":{"tr":["-diğine göre","madem"]},"details":{"usage":"Bilinen bir gerekçeyi bildirir.","register":"neutral"},"examples":[{"text":"Visto che piove, restiamo a casa.","tr":"Madem yağmur yağıyor, evde kalalım."}]},
  {"id":"it-expr-a-seconda-di","languageId":"it","category":"expressions","level":"B1","sourceText":"a seconda di","translations":{"tr":["-e göre","-e bağlı olarak"]},"details":{"usage":"Değişkenliği bildirir.","register":"neutral"},"examples":[{"text":"Il prezzo cambia a seconda della stagione.","tr":"Fiyat mevsime göre değişir."}]},
  {"id":"it-expr-rispetto-a","languageId":"it","category":"expressions","level":"B1","sourceText":"rispetto a","translations":{"tr":["-e göre","-e kıyasla"]},"details":{"usage":"Karşılaştırma yapar.","register":"neutral"},"examples":[{"text":"Rispetto all'anno scorso, va meglio.","tr":"Geçen yıla göre daha iyi gidiyor."}]},
  {"id":"it-expr-invece-di","languageId":"it","category":"expressions","level":"B1","sourceText":"invece di","translations":{"tr":["... yerine"]},"details":{"usage":"İsim ya da mastarla: invece di lavorare.","register":"neutral"},"examples":[{"text":"Invece di guardare la TV, leggi un libro.","tr":"Televizyon izlemek yerine bir kitap oku."}]},
  {"id":"it-expr-oltre-a","languageId":"it","category":"expressions","level":"B1","sourceText":"oltre a","translations":{"tr":["-in yanı sıra","-den başka"]},"details":{"usage":"Ekleme yapar.","register":"neutral"},"examples":[{"text":"Oltre all'inglese, parla anche il cinese.","tr":"İngilizcenin yanı sıra Çince de konuşuyor."}]},
  {"id":"it-expr-man-mano","languageId":"it","category":"expressions","level":"B1","sourceText":"man mano","translations":{"tr":["yavaş yavaş","giderek"]},"details":{"usage":"'Man mano che' = -dikçe.","register":"neutral"},"examples":[{"text":"Man mano che leggevo, capivo di più.","tr":"Okudukça daha çok anlıyordum."}]},
  {"id":"it-expr-ormai","languageId":"it","category":"expressions","level":"B1","sourceText":"ormai","translations":{"tr":["artık","nasılsa"]},"details":{"usage":"Değiştirilemeyecek bir durumu anlatır.","register":"neutral"},"examples":[{"text":"Ormai è troppo tardi.","tr":"Artık çok geç."}]},
  {"id":"it-expr-appunto","languageId":"it","category":"expressions","level":"B1","sourceText":"appunto","translations":{"tr":["tam olarak","işte o yüzden"]},"tags":["discourse-marker"],"details":{"usage":"Karşı tarafın sözünü onaylar: 'aynen öyle'.","register":"neutral"},"examples":[{"text":"È caro. — Appunto, non lo compro.","tr":"Pahalı. — İşte o yüzden almıyorum."}]},
  {"id":"it-expr-mica","languageId":"it","category":"expressions","level":"B1","sourceText":"mica","translations":{"tr":["hiç de","yoksa"]},"details":{"usage":"Konuşma dilinde olumsuzu güçlendirir: non è mica facile.","register":"informal"},"examples":[{"text":"Non sono mica scemo!","tr":"Ben aptal değilim ya!"}]},
  {"id":"it-expr-proprio","languageId":"it","category":"expressions","level":"B1","sourceText":"proprio","translations":{"tr":["tam","gerçekten","hiç"]},"details":{"usage":"Vurgu katar: proprio qui = tam burada.","register":"neutral"},"examples":[{"text":"Non ho proprio tempo oggi.","tr":"Bugün gerçekten hiç vaktim yok."}]},
  {"id":"it-expr-prima-o-poi","languageId":"it","category":"expressions","level":"B1","sourceText":"prima o poi","translations":{"tr":["er geç","eninde sonunda"]},"details":{"usage":"Sonunda olacak bir şey için.","register":"neutral"},"examples":[{"text":"Prima o poi capirà.","tr":"Er geç anlayacak."}]},
