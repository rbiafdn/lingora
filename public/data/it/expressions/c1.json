  {"id":"it-expr-stando-a","languageId":"it","category":"expressions","level":"C1","sourceText":"stando a","translations":{"tr":["... -e göre","... -e bakılırsa"]},"details":{"usage":"Bilginin kaynağını belirtir.","register":"neutral"},"examples":[{"text":"Stando ai giornali, il ministro si dimetterà.","tr":"Gazetelere bakılırsa bakan istifa edecek."}]},
  {"id":"it-expr-per-lappunto","languageId":"it","category":"expressions","level":"C1","sourceText":"per l'appunto","translations":{"tr":["tam da","işte tam"]},"details":{"usage":"'Appunto'nun vurgulu hâli.","register":"neutral"},"examples":[{"text":"Stavo per l'appunto pensando a te.","tr":"Tam da seni düşünüyordum."}]},
  {"id":"it-expr-come-dire","languageId":"it","category":"expressions","level":"C1","sourceText":"come dire","translations":{"tr":["nasıl desem"]},"tags":["discourse-marker"],"details":{"usage":"Uygun kelimeyi ararken ya da bir şeyi yumuşatırken.","register":"neutral"},"examples":[{"text":"È una persona, come dire, un po' particolare.","tr":"O, nasıl desem, biraz tuhaf biri."}]},
  {"id":"it-expr-beninteso","languageId":"it","category":"expressions","level":"C1","sourceText":"beninteso","translations":{"tr":["elbette","tabii ki ... şartıyla"]},"details":{"usage":"Açıkça anlaşılması gereken bir koşulu ekler.","register":"formal"},"examples":[{"text":"Puoi venire, beninteso se finisci i compiti.","tr":"Gelebilirsin, tabii ödevlerini bitirirsen."}]},
  {"id":"it-expr-a-dir-poco","languageId":"it","category":"expressions","level":"C1","sourceText":"a dir poco","translations":{"tr":["en hafif deyimiyle","az bile"]},"details":{"usage":"Söylenenin aslında daha da güçlü olduğunu belirtir.","register":"neutral"},"examples":[{"text":"Il viaggio è stato faticoso, a dir poco.","tr":"Yolculuk, en hafif deyimiyle yorucuydu."}]},
  {"id":"it-expr-in-un-certo-senso","languageId":"it","category":"expressions","level":"C1","sourceText":"in un certo senso","translations":{"tr":["bir bakıma","bir anlamda"]},"details":{"usage":"Kısmi onay ya da yorum bildirir.","register":"neutral"},"examples":[{"text":"In un certo senso hai ragione.","tr":"Bir bakıma haklısın."}]},
  {"id":"it-expr-a-ben-vedere","languageId":"it","category":"expressions","level":"C1","sourceText":"a ben vedere","translations":{"tr":["iyice bakınca","dikkatle düşününce"]},"details":{"usage":"Daha dikkatli bir değerlendirmeyi başlatır.","register":"formal"},"examples":[{"text":"A ben vedere, la sua idea non è male.","tr":"İyice düşününce fikri fena değil."}]},
  {"id":"it-expr-tante-vero-che","languageId":"it","category":"expressions","level":"C1","sourceText":"tant'è vero che","translations":{"tr":["öyle ki","nitekim"]},"details":{"usage":"Söylenenin doğruluğuna kanıt getirir.","register":"neutral"},"examples":[{"text":"Era malato, tant'è vero che non è venuto.","tr":"Hastaydı, nitekim gelmedi."}]},
  {"id":"it-expr-giacche","languageId":"it","category":"expressions","level":"C1","sourceText":"giacché","translations":{"tr":["madem","-diği için"]},"details":{"usage":"Edebi ve resmî bir neden bağlacı.","register":"formal"},"examples":[{"text":"Giacché sei qui, parliamone.","tr":"Madem buradasın, konuşalım."}]},
  {"id":"it-expr-dopodiche","languageId":"it","category":"expressions","level":"C1","sourceText":"dopodiché","translations":{"tr":["bundan sonra","ardından"]},"details":{"usage":"Anlatıda bir sonraki adımı bildirir.","register":"neutral"},"examples":[{"text":"Ha firmato, dopodiché se n'è andato.","tr":"İmzaladı, ardından çekip gitti."}]},
  {"id":"it-expr-per-giunta","languageId":"it","category":"expressions","level":"C1","sourceText":"per giunta","translations":{"tr":["üstelik","bir de üstüne"]},"details":{"usage":"Olumsuz bir durumu ağırlaştıran ekleme yapar.","register":"neutral"},"examples":[{"text":"È arrivato tardi e, per giunta, senza regalo.","tr":"Geç geldi, bir de üstüne hediyesiz."}]},
  {"id":"it-expr-di-per-se","languageId":"it","category":"expressions","level":"C1","sourceText":"di per sé","translations":{"tr":["kendi başına","aslında"]},"details":{"usage":"Bir şeyin kendi özünü belirtir.","register":"neutral"},"examples":[{"text":"L'idea di per sé non è sbagliata.","tr":"Fikir kendi başına yanlış değil."}]},
  {"id":"it-expr-va-da-se-che","languageId":"it","category":"expressions","level":"C1","sourceText":"va da sé che","translations":{"tr":["söylemeye gerek yok ki","besbelli ki"]},"details":{"usage":"Açık olan bir şeyi belirtir.","register":"neutral"},"examples":[{"text":"Va da sé che sei invitato anche tu.","tr":"Söylemeye gerek yok, sen de davetlisin."}]},
  {"id":"it-expr-a-onor-del-vero","languageId":"it","category":"expressions","level":"C1","sourceText":"a onor del vero","translations":{"tr":["hakkını vermek gerekirse","doğrusu"]},"details":{"usage":"Adil olmak için bir gerçeği kabul eder.","register":"formal"},"examples":[{"text":"A onor del vero, lui ci aveva avvertiti.","tr":"Hakkını vermek gerekirse bizi uyarmıştı."}]},
  {"id":"it-expr-per-farla-breve","languageId":"it","category":"expressions","level":"C1","sourceText":"per farla breve","translations":{"tr":["uzun lafın kısası","sözü uzatmayayım"]},"tags":["discourse-marker"],"details":{"usage":"Anlatıyı kısaltıp sonuca geçer.","register":"informal"},"examples":[{"text":"Per farla breve, abbiamo perso l'aereo.","tr":"Uzun lafın kısası, uçağı kaçırdık."}]}
