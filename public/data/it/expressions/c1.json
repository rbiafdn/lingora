[
  {"id":"it-expr-qualora","languageId":"it","category":"expressions","level":"C1","sourceText":"qualora","translations":{"tr":["eğer","... olması durumunda"]},"details":{"usage":"Resmî 'se'; arkasından congiuntivo gelir.","register":"formal"},"examples":[{"text":"Qualora ci fossero problemi, contattateci.","tr":"Sorun olması durumunda bize ulaşın."}]},
  {"id":"it-expr-fermo-restando","languageId":"it","category":"expressions","level":"C1","sourceText":"fermo restando","translations":{"tr":["... saklı kalmak kaydıyla"]},"details":{"usage":"Hukuki ve resmî metinlerde sık.","register":"formal"},"examples":[{"text":"Fermo restando il diritto di recesso, il contratto è valido.","tr":"Cayma hakkı saklı kalmak kaydıyla sözleşme geçerlidir."}]},
  {"id":"it-expr-a-maggior-ragione","languageId":"it","category":"expressions","level":"C1","sourceText":"a maggior ragione","translations":{"tr":["haydi haydi","hele hele"]},"details":{"usage":"Bir gerekçeyi daha da güçlü kılar.","register":"neutral"},"examples":[{"text":"Se è pericoloso per gli adulti, a maggior ragione per i bambini.","tr":"Yetişkinler için tehlikeliyse çocuklar için haydi haydi."}]},
  {"id":"it-expr-in-virtu-di","languageId":"it","category":"expressions","level":"C1","sourceText":"in virtù di","translations":{"tr":["... gereğince","... sayesinde"]},"details":{"usage":"Resmî dilde dayanak bildirir.","register":"formal"},"examples":[{"text":"In virtù dell'accordo, i prezzi restano invariati.","tr":"Anlaşma gereğince fiyatlar değişmiyor."}]},
  {"id":"it-expr-alla-luce-di","languageId":"it","category":"expressions","level":"C1","sourceText":"alla luce di","translations":{"tr":["... ışığında"]},"details":{"usage":"Yeni bilgiye göre değerlendirme yapar.","register":"formal"},"examples":[{"text":"Alla luce dei fatti, dobbiamo cambiare piano.","tr":"Olguların ışığında planı değiştirmeliyiz."}]},
  {"id":"it-expr-per-quanto","languageId":"it","category":"expressions","level":"C1","sourceText":"per quanto","translations":{"tr":["ne kadar ... -se de"]},"details":{"usage":"Ödünleme bildirir; arkasından congiuntivo gelir.","register":"neutral"},"examples":[{"text":"Per quanto ci provi, non ci riesce.","tr":"Ne kadar denese de başaramıyor."}]},
  {"id":"it-expr-laddove","languageId":"it","category":"expressions","level":"C1","sourceText":"laddove","translations":{"tr":["... olduğu durumda","oysa"]},"details":{"usage":"Resmî yazı dilinde koşul ya da karşıtlık bildirir.","register":"formal"},"examples":[{"text":"Laddove necessario, si procederà a verifiche.","tr":"Gerekli olduğu durumda denetim yapılacaktır."}]},
  {"id":"it-expr-nella-misura-in-cui","languageId":"it","category":"expressions","level":"C1","sourceText":"nella misura in cui","translations":{"tr":["... ölçüde","-diği sürece"]},"details":{"usage":"Bir şeyin sınırını ya da derecesini belirtir.","register":"formal"},"examples":[{"text":"Ti aiuterò nella misura in cui potrò.","tr":"Yapabildiğim ölçüde sana yardım edeceğim."}]},
  {"id":"it-expr-a-fronte-di","languageId":"it","category":"expressions","level":"C1","sourceText":"a fronte di","translations":{"tr":["... karşılığında","... karşısında"]},"details":{"usage":"İş ve ekonomi dilinde sık.","register":"formal"},"examples":[{"text":"A fronte di un aumento dei costi, i ricavi calano.","tr":"Maliyet artışı karşısında gelirler düşüyor."}]},
  {"id":"it-expr-in-merito-a","languageId":"it","category":"expressions","level":"C1","sourceText":"in merito a","translations":{"tr":["... hakkında","... ile ilgili olarak"]},"details":{"usage":"Resmî yazışmalarda konu belirtir.","register":"formal"},"examples":[{"text":"Le scrivo in merito alla sua richiesta.","tr":"Talebinizle ilgili olarak size yazıyorum."}]},
  {"id":"it-expr-a-scapito-di","languageId":"it","category":"expressions","level":"C1","sourceText":"a scapito di","translations":{"tr":["... pahasına","... zararına"]},"details":{"usage":"Bir şeyin başka bir şeye zarar verdiğini anlatır.","register":"formal"},"examples":[{"text":"Hanno puntato sulla quantità a scapito della qualità.","tr":"Kalite pahasına miktara yöneldiler."}]},
  {"id":"it-expr-al-fine-di","languageId":"it","category":"expressions","level":"C1","sourceText":"al fine di","translations":{"tr":["... amacıyla","-mek için"]},"details":{"usage":"Resmî amaç bildirir; mastar ya da isimle.","register":"formal"},"examples":[{"text":"Al fine di ridurre i costi, chiudiamo una sede.","tr":"Maliyetleri düşürmek amacıyla bir şubeyi kapatıyoruz."}]},
