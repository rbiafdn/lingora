  {"id":"it-slang-porca-miseria","languageId":"it","category":"slang","level":"B1","sourceText":"porca miseria!","translations":{"tr":["hay Allah!","kahretsin!"]},"details":{"usage":"Kaba olmayan yaygın öfke ünlemi; \"porca vacca\" da denir.","register":"informal"},"examples":[{"text":"Porca miseria, ho perso il treno!","tr":"Hay Allah, treni kaçırdım!"}]},
