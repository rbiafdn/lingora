  {"id":"it-slang-chissenefrega","languageId":"it","category":"slang","level":"B1","sourceText":"chissenefrega","translations":{"tr":["kimin umurunda"]},"details":{"register":"informal"},"examples":[{"text":"Ha perso la Juve? Chissenefrega!","tr":"Juve kaybetmiş mi? Kimin umurunda!"}]},
  {"id":"it-slang-secchione","languageId":"it","category":"slang","level":"B1","sourceText":"secchione","translations":{"tr":["inek (öğrenci)"]},"details":{"register":"informal"},"examples":[{"text":"Chiedi a Luca, è il secchione della classe.","tr":"Luca'ya sor, sınıfın ineği o."}]},
  {"id":"it-slang-scemo","languageId":"it","category":"slang","level":"B1","sourceText":"scemo","translations":{"tr":["salak","aptal"]},"details":{"usage":"Arkadaşlar arasında şakayla da söylenir.","register":"informal"},"examples":[{"text":"Dai, non fare lo scemo!","tr":"Hadi, salaklık yapma!"}]},
