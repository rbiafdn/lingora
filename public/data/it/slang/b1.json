  {"id":"it-slang-una-cifra","languageId":"it","category":"slang","level":"B1","sourceText":"una cifra","translations":{"tr":["çok","bir sürü"]},"details":{"usage":"Asıl anlamı \"rakam\"; argo olarak \"çok\" demektir.","register":"slang"},"examples":[{"text":"Mi piace una cifra questa canzone.","tr":"Bu şarkıyı çok seviyorum."}]},
