  {"id":"it-slang-tipo","languageId":"it","category":"slang","level":"B1","sourceText":"tipo","translations":{"tr":["mesela","yani","şey gibi"]},"details":{"usage":"Gençlerin cümle arası dolgu kelimesi, İngilizcedeki \"like\" gibi.","register":"slang"},"examples":[{"text":"Era, tipo, bellissimo!","tr":"Şey gibi, çok güzeldi!"}]},
