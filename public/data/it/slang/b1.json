[
  {"id":"it-slang-figo","languageId":"it","category":"slang","level":"B1","sourceText":"figo","translations":{"tr":["havalı","süper","yakışıklı"]},"details":{"usage":"Şeyler ve kişiler için; dişili \"figa\" kaba bir anlam taşıdığı için kadınlara \"fica/figa\" deme, \"bella\" de.","register":"slang"},"examples":[{"text":"Che figo il tuo nuovo telefono!","tr":"Yeni telefonun ne havalı!"}]},
  {"id":"it-slang-che-figata","languageId":"it","category":"slang","level":"B1","sourceText":"che figata!","translations":{"tr":["süper!","harika!"]},"details":{"usage":"Gençler arasında çok yaygın coşku ifadesi.","register":"slang"},"examples":[{"text":"Andiamo al concerto? Che figata!","tr":"Konsere mi gidiyoruz? Süper!"}]},
  {"id":"it-slang-sfigato","languageId":"it","category":"slang","level":"B1","sourceText":"sfigato","translations":{"tr":["ezik","şanssız","zavallı"]},"details":{"usage":"Hem şanssız hem de sosyal olarak ezik kişi için; kırıcı olabilir.","register":"slang"},"examples":[{"text":"Non fare lo sfigato, vieni alla festa!","tr":"Ezik ezik durma, partiye gel!"}]},
  {"id":"it-slang-boh","languageId":"it","category":"slang","level":"B1","sourceText":"boh","translations":{"tr":["bilmem","ne bileyim"]},"details":{"usage":"Omuz silkerek söylenir; çok yaygın ama kibar ortamda \"non lo so\" de.","register":"informal"},"examples":[{"text":"Dov'è Marco? — Boh.","tr":"Marco nerede? — Bilmem."}]},
  {"id":"it-slang-mah","languageId":"it","category":"slang","level":"B1","sourceText":"mah","translations":{"tr":["hmm","bilemiyorum","bilmem ki"]},"details":{"usage":"Şüphe veya kararsızlık bildirir.","register":"informal"},"examples":[{"text":"Ti piace il film? — Mah, così così.","tr":"Filmi beğendin mi? — Hmm, şöyle böyle."}]},
  {"id":"it-slang-vabbe","languageId":"it","category":"slang","level":"B1","sourceText":"vabbè","translations":{"tr":["neyse","peki","tamam ya"]},"tags":["reduced-form"],"details":{"usage":"Teslimiyet ya da konuyu kapatma tonu taşır.","register":"informal","expansion":"va bene"},"examples":[{"text":"Vabbè, ne parliamo domani.","tr":"Neyse, yarın konuşuruz."}]},
  {"id":"it-slang-sto-sta","languageId":"it","category":"slang","level":"B1","sourceText":"'sto / 'sta","translations":{"tr":["bu"]},"tags":["reduced-form"],"details":{"usage":"Konuşmada \"que-\" düşer; çoğulu 'sti / 'ste. Yazıda kullanma.","register":"informal","expansion":"questo / questa"},"examples":[{"text":"Ma chi è 'sto tizio?","tr":"Bu adam da kim ya?"}]},
  {"id":"it-slang-raga","languageId":"it","category":"slang","level":"B1","sourceText":"raga","translations":{"tr":["millet","çocuklar"]},"tags":["reduced-form"],"details":{"usage":"Arkadaş grubuna seslenirken çok yaygın.","register":"slang","expansion":"ragazzi"},"examples":[{"text":"Raga, chi viene al mare?","tr":"Millet, denize kim geliyor?"}]},
  {"id":"it-slang-prof","languageId":"it","category":"slang","level":"B1","sourceText":"prof","translations":{"tr":["hoca","öğretmen"]},"tags":["reduced-form"],"details":{"usage":"Öğrenciler öğretmenlerine doğrudan \"prof!\" diye seslenir.","register":"informal","expansion":"professore / professoressa"},"examples":[{"text":"Prof, posso andare in bagno?","tr":"Hocam, tuvalete gidebilir miyim?"}]},
  {"id":"it-slang-bici","languageId":"it","category":"slang","level":"B1","sourceText":"bici","translations":{"tr":["bisiklet"]},"tags":["reduced-form"],"details":{"usage":"Günlük dilde neredeyse her zaman kısa biçim kullanılır.","register":"informal","expansion":"bicicletta"},"examples":[{"text":"Vado al lavoro in bici.","tr":"İşe bisikletle gidiyorum."}]},
