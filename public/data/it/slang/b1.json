  {"id":"it-slang-rompiscatole","languageId":"it","category":"slang","level":"B1","sourceText":"rompiscatole","translations":{"tr":["baş belası","sinir bozucu kişi"]},"details":{"register":"informal"},"examples":[{"text":"Il mio vicino è un rompiscatole.","tr":"Komşum tam bir baş belası."}]},
