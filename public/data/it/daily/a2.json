[
  {"id":"it-daily-molto-lieto-molto-lieta","languageId":"it","category":"daily","level":"A2","sourceText":"Molto lieto / Molto lieta","translations":{"tr":["çok memnun oldum"]},"details":{"register":"formal","context":"Resmî tanışmalarda; erkek 'lieto', kadın 'lieta' der."},"examples":[{"text":"Le presento l'ingegner Bianchi. — Molto lieta.","tr":"Size mühendis Bianchi'yi tanıştırayım. — Çok memnun oldum."}]},
  {"id":"it-daily-il-piacere-e-mio","languageId":"it","category":"daily","level":"A2","sourceText":"Il piacere è mio","translations":{"tr":["ben de memnun oldum","zevk bana ait"]},"details":{"register":"neutral","context":"'Piacere' ya da teşekküre kibar karşılık."},"examples":[{"text":"Piacere di conoscerla. — Il piacere è mio.","tr":"Tanıştığımıza memnun oldum. — Ben de memnun oldum."}]},
  {"id":"it-daily-ti-presento","languageId":"it","category":"daily","level":"A2","sourceText":"Ti presento...","translations":{"tr":["seni ... ile tanıştırayım","bu ..."]},"details":{"register":"neutral","context":"Birini tanıştırırken; resmîde 'Le presento...'."},"examples":[{"text":"Ti presento mia sorella Anna.","tr":"Seni kız kardeşim Anna'yla tanıştırayım."}]},
  {"id":"it-daily-bentornato-bentornata","languageId":"it","category":"daily","level":"A2","sourceText":"Bentornato! / Bentornata!","translations":{"tr":["tekrar hoş geldin","hoş geldin"]},"details":{"register":"neutral","context":"Biri bir yerden dönünce karşılarken."},"examples":[{"text":"Bentornata! Com'è andato il viaggio?","tr":"Hoş geldin! Yolculuk nasıl geçti?"}]},
  {"id":"it-daily-buona-pasqua","languageId":"it","category":"daily","level":"A2","sourceText":"Buona Pasqua!","translations":{"tr":["iyi Paskalyalar"]},"details":{"register":"neutral","context":"Paskalya döneminde."},"examples":[{"text":"Buona Pasqua a te e alla tua famiglia!","tr":"Sana ve ailene iyi Paskalyalar!"}]},
  {"id":"it-daily-buone-vacanze","languageId":"it","category":"daily","level":"A2","sourceText":"Buone vacanze!","translations":{"tr":["iyi tatiller"]},"details":{"register":"neutral","context":"Tatile çıkan birine."},"examples":[{"text":"Partite per il mare? Buone vacanze!","tr":"Denize mi gidiyorsunuz? İyi tatiller!"}]},
  {"id":"it-daily-buon-divertimento","languageId":"it","category":"daily","level":"A2","sourceText":"Buon divertimento!","translations":{"tr":["iyi eğlenceler"]},"details":{"register":"neutral","context":"Partiye, konsere giden birine."},"examples":[{"text":"Andate al concerto? Buon divertimento!","tr":"Konsere mi gidiyorsunuz? İyi eğlenceler!"}]},
  {"id":"it-daily-buon-lavoro","languageId":"it","category":"daily","level":"A2","sourceText":"Buon lavoro!","translations":{"tr":["kolay gelsin","iyi çalışmalar"]},"details":{"register":"neutral","context":"İşe giden ya da çalışan birine."},"examples":[{"text":"Io vado in ufficio. — Buon lavoro!","tr":"Ben ofise gidiyorum. — Kolay gelsin!"}]},
  {"id":"it-daily-chi-parla","languageId":"it","category":"daily","level":"A2","sourceText":"Chi parla?","translations":{"tr":["kim konuşuyor?","kiminle görüşüyorum?"]},"details":{"register":"neutral","context":"Telefonda arayanı sorarken."},"examples":[{"text":"Pronto, chi parla? — Sono Marta.","tr":"Alo, kim konuşuyor? — Ben Marta."}]},
  {"id":"it-daily-ha-sbagliato-numero","languageId":"it","category":"daily","level":"A2","sourceText":"Ha sbagliato numero","translations":{"tr":["yanlış numara","yanlış aradınız"]},"details":{"register":"neutral","context":"Telefonda yanlış arayan birine."},"examples":[{"text":"Cerco Paolo. — Mi dispiace, ha sbagliato numero.","tr":"Paolo'yu arıyorum. — Üzgünüm, yanlış aradınız."}]},
  {"id":"it-daily-ti-richiamo","languageId":"it","category":"daily","level":"A2","sourceText":"Ti richiamo","translations":{"tr":["seni sonra ararım","geri ararım"]},"details":{"register":"neutral","context":"Telefonu kısa kesmek zorunda kaldığında."},"examples":[{"text":"Adesso sono in riunione, ti richiamo dopo.","tr":"Şu an toplantıdayım, seni sonra ararım."}]},
  {"id":"it-daily-ci-sentiamo","languageId":"it","category":"daily","level":"A2","sourceText":"Ci sentiamo!","translations":{"tr":["konuşuruz","haberleşiriz"]},"details":{"register":"informal","context":"Telefonda ya da mesajda vedalaşırken."},"examples":[{"text":"Ok, allora ci sentiamo domani!","tr":"Tamam, o zaman yarın konuşuruz!"}]},
  {"id":"it-daily-fammi-sapere","languageId":"it","category":"daily","level":"A2","sourceText":"Fammi sapere","translations":{"tr":["haber ver","bana bildir"]},"details":{"register":"informal","context":"Birinden sonucu bildirmesini isterken."},"examples":[{"text":"Se vieni alla festa, fammi sapere.","tr":"Partiye gelirsen bana haber ver."}]},
  {"id":"it-daily-fantastico","languageId":"it","category":"daily","level":"A2","sourceText":"Fantastico!","translations":{"tr":["harika!","süper!"]},"details":{"register":"neutral","context":"Güçlü bir sevinç ve beğeni anlatırken."},"examples":[{"text":"Abbiamo vinto la partita? Fantastico!","tr":"Maçı kazandık mı? Harika!"}]},
  {"id":"it-daily-tutto-a-posto","languageId":"it","category":"daily","level":"A2","sourceText":"Tutto a posto","translations":{"tr":["her şey yolunda","her şey tamam"]},"details":{"register":"neutral","context":"Sorun olmadığını söylerken; soru olarak da kullanılır."},"examples":[{"text":"Tutto a posto? — Sì, tutto a posto, grazie.","tr":"Her şey yolunda mı? — Evet, her şey yolunda, teşekkürler."}]},
  {"id":"it-daily-posso-aiutarla","languageId":"it","category":"daily","level":"A2","sourceText":"Posso aiutarla?","translations":{"tr":["yardımcı olabilir miyim?"]},"details":{"register":"formal","context":"Dükkânda ya da sokakta yardım teklif ederken."},"examples":[{"text":"Buongiorno, posso aiutarla?","tr":"Günaydın, yardımcı olabilir miyim?"}]},
  {"id":"it-daily-mi-sono-perso-mi-sono-persa","languageId":"it","category":"daily","level":"A2","sourceText":"Mi sono perso / Mi sono persa","translations":{"tr":["kayboldum"]},"details":{"register":"neutral","context":"Yolu bulamadığında; kadın 'persa' der."},"examples":[{"text":"Scusi, mi sono perso. Dov'è il Duomo?","tr":"Affedersiniz, kayboldum. Katedral nerede?"}]},
  {"id":"it-daily-capito","languageId":"it","category":"daily","level":"A2","sourceText":"Capito?","translations":{"tr":["anladın mı?","tamam mı?"]},"details":{"register":"informal","context":"Söylediğinin anlaşıldığından emin olmak için."},"examples":[{"text":"Torna prima di mezzanotte, capito?","tr":"Gece yarısından önce dön, anladın mı?"}]},
  {"id":"it-daily-sul-serio","languageId":"it","category":"daily","level":"A2","sourceText":"Sul serio?","translations":{"tr":["ciddi misin?","cidden mi?"]},"details":{"register":"informal","context":"Bir habere şaşırınca."},"examples":[{"text":"Si sono lasciati. — Sul serio?","tr":"Ayrılmışlar. — Cidden mi?"}]},
  {"id":"it-daily-avanti","languageId":"it","category":"daily","level":"A2","sourceText":"Avanti!","translations":{"tr":["girin!","buyrun!","ileri!"]},"details":{"register":"neutral","context":"Kapı çalınınca içeri davet ederken."},"examples":[{"text":"Toc toc. — Avanti!","tr":"Tak tak. — Girin!"}]},
  {"id":"it-daily-arrivo","languageId":"it","category":"daily","level":"A2","sourceText":"Arrivo!","translations":{"tr":["geliyorum!"]},"details":{"register":"informal","context":"Çağrılınca; garsonlar da sık söyler. 'Sto arrivando' = yoldayım."},"examples":[{"text":"Marco, la cena è pronta! — Arrivo!","tr":"Marco, yemek hazır! — Geliyorum!"}]},
  {"id":"it-daily-eccomi","languageId":"it","category":"daily","level":"A2","sourceText":"Eccomi!","translations":{"tr":["işte buradayım!","geldim!"]},"details":{"register":"neutral","context":"Bir yere varınca ya da çağrıya cevap verirken; çoğulu 'Eccoci!'."},"examples":[{"text":"Eccomi! Scusate il ritardo.","tr":"Geldim! Geciktiğim için kusura bakmayın."}]},
  {"id":"it-daily-tocca-a-te","languageId":"it","category":"daily","level":"A2","sourceText":"Tocca a te","translations":{"tr":["sıra sende"]},"details":{"register":"informal","context":"Oyunda, kuyrukta ya da bir görevde."},"examples":[{"text":"Ho finito io, adesso tocca a te.","tr":"Ben bitirdim, şimdi sıra sende."}]},
  {"id":"it-daily-mi-dica","languageId":"it","category":"daily","level":"A2","sourceText":"Mi dica","translations":{"tr":["buyurun","sizi dinliyorum"]},"details":{"register":"formal","context":"Dükkânda, gişede müşteriye; samimisi 'Dimmi'."},"examples":[{"text":"Buongiorno, mi dica.","tr":"Günaydın, buyurun."}]},
  {"id":"it-daily-dimmi","languageId":"it","category":"daily","level":"A2","sourceText":"Dimmi","translations":{"tr":["söyle","efendim"]},"details":{"register":"informal","context":"Biri sana seslenince ya da telefonda."},"examples":[{"text":"Mamma? — Dimmi, tesoro.","tr":"Anne? — Söyle, canım."}]},
  {"id":"it-daily-desidera","languageId":"it","category":"daily","level":"A2","sourceText":"Desidera?","translations":{"tr":["ne arzu edersiniz?","ne alırsınız?"]},"details":{"register":"formal","context":"Garson ya da satıcının müşteriye sorusu."},"examples":[{"text":"Buonasera, desidera? — Un bicchiere di vino rosso.","tr":"İyi akşamlar, ne alırsınız? — Bir kadeh kırmızı şarap."}]},
  {"id":"it-daily-altro","languageId":"it","category":"daily","level":"A2","sourceText":"Altro?","translations":{"tr":["başka?","başka bir şey?"]},"details":{"register":"neutral","context":"Satıcı başka bir şey isteyip istemediğini sorarken."},"examples":[{"text":"Due etti di prosciutto. — Altro?","tr":"İki yüz gram jambon. — Başka?"}]},
  {"id":"it-daily-basta-cosi-grazie","languageId":"it","category":"daily","level":"A2","sourceText":"Basta così, grazie","translations":{"tr":["bu kadar, teşekkürler","yeter, sağ olun"]},"details":{"register":"neutral","context":"Alışverişte ya da servis yapılırken yeterli olduğunu söylerken."},"examples":[{"text":"Altro? — No, basta così, grazie.","tr":"Başka? — Hayır, bu kadar, teşekkürler."}]},
  {"id":"it-daily-quanto-le-devo","languageId":"it","category":"daily","level":"A2","sourceText":"Quanto le devo?","translations":{"tr":["borcum ne kadar?","ne kadar ödeyeceğim?"]},"details":{"register":"formal","context":"Kasada ya da barda ödeme yaparken."},"examples":[{"text":"Quanto le devo? — Sono dieci euro.","tr":"Borcum ne kadar? — On avro."}]},
  {"id":"it-daily-posso-pagare-con-la-carta","languageId":"it","category":"daily","level":"A2","sourceText":"Posso pagare con la carta?","translations":{"tr":["kartla ödeyebilir miyim?"]},"details":{"register":"neutral","context":"Kasada ödeme şeklini sorarken."},"examples":[{"text":"Posso pagare con la carta? — Certo, prego.","tr":"Kartla ödeyebilir miyim? — Tabii, buyurun."}]},
  {"id":"it-daily-tenga-il-resto","languageId":"it","category":"daily","level":"A2","sourceText":"Tenga il resto","translations":{"tr":["üstü kalsın"]},"details":{"register":"formal","context":"Taksi ya da restoranda bahşiş bırakırken."},"examples":[{"text":"Ecco venti euro, tenga il resto.","tr":"Buyurun yirmi avro, üstü kalsın."}]},
  {"id":"it-daily-lo-prendo","languageId":"it","category":"daily","level":"A2","sourceText":"Lo prendo","translations":{"tr":["alıyorum","bunu alayım"]},"details":{"register":"neutral","context":"Alışverişte karar verince."},"examples":[{"text":"Questo maglione mi piace. Lo prendo.","tr":"Bu kazağı beğendim. Alıyorum."}]},
  {"id":"it-daily-quanti-siete","languageId":"it","category":"daily","level":"A2","sourceText":"Quanti siete?","translations":{"tr":["kaç kişisiniz?"]},"details":{"register":"neutral","context":"Restoranda garsonun sorusu."},"examples":[{"text":"Buonasera, quanti siete? — Siamo in quattro.","tr":"İyi akşamlar, kaç kişisiniz? — Dört kişiyiz."}]},
  {"id":"it-daily-avete-un-tavolo-per-due","languageId":"it","category":"daily","level":"A2","sourceText":"Avete un tavolo per due?","translations":{"tr":["iki kişilik masanız var mı?"]},"details":{"register":"neutral","context":"Restorana girince yer sorarken."},"examples":[{"text":"Buonasera, avete un tavolo per due?","tr":"İyi akşamlar, iki kişilik masanız var mı?"}]},
  {"id":"it-daily-che-cosa-mi-consiglia","languageId":"it","category":"daily","level":"A2","sourceText":"Che cosa mi consiglia?","translations":{"tr":["ne tavsiye edersiniz?"]},"details":{"register":"formal","context":"Restoranda ya da dükkânda öneri isterken."},"examples":[{"text":"È la prima volta qui. Che cosa mi consiglia?","tr":"Buraya ilk gelişim. Ne tavsiye edersiniz?"}]},
  {"id":"it-daily-il-solito","languageId":"it","category":"daily","level":"A2","sourceText":"Il solito","translations":{"tr":["her zamanki"]},"details":{"register":"informal","context":"Bildiğin barda her zamanki siparişini verirken."},"examples":[{"text":"Cosa prendi? — Il solito, grazie.","tr":"Ne alırsın? — Her zamankinden, teşekkürler."}]},
  {"id":"it-daily-a-tavola","languageId":"it","category":"daily","level":"A2","sourceText":"A tavola!","translations":{"tr":["sofraya!","yemek hazır!"]},"details":{"register":"informal","context":"Evde herkesi yemeğe çağırırken."},"examples":[{"text":"Ragazzi, a tavola! La pasta si fredda.","tr":"Çocuklar, sofraya! Makarna soğuyor."}]},
  {"id":"it-daily-sono-pieno-sono-piena","languageId":"it","category":"daily","level":"A2","sourceText":"Sono pieno / Sono piena","translations":{"tr":["doydum"]},"details":{"register":"informal","context":"Daha fazla yiyemeyeceğini söylerken; kadın 'piena'."},"examples":[{"text":"Ancora un po' di torta? — No, grazie, sono piena.","tr":"Biraz daha pasta? — Hayır teşekkürler, doydum."}]},
  {"id":"it-daily-offro-io","languageId":"it","category":"daily","level":"A2","sourceText":"Offro io","translations":{"tr":["benden","ben ısmarlıyorum"]},"details":{"register":"informal","context":"Hesabı ödemeyi teklif ederken."},"examples":[{"text":"Lascia, il caffè lo offro io.","tr":"Bırak, kahveler benden."}]},
  {"id":"it-daily-accomodati-si-accomodi","languageId":"it","category":"daily","level":"A2","sourceText":"Accomodati / Si accomodi","translations":{"tr":["buyur otur","buyurun","içeri buyurun"]},"details":{"register":"neutral","context":"Misafiri içeri ya da oturmaya davet ederken; 'Si accomodi' resmî."},"examples":[{"text":"Prego, si accomodi. Il dottore arriva subito.","tr":"Buyurun oturun. Doktor hemen geliyor."}]},
  {"id":"it-daily-scusi-il-disturbo","languageId":"it","category":"daily","level":"A2","sourceText":"Scusi il disturbo","translations":{"tr":["rahatsız ettiğim için kusura bakmayın"]},"details":{"register":"formal","context":"Birini rahatsız etmeden önce ya da sonra; samimisi 'Scusa il disturbo'."},"examples":[{"text":"Scusi il disturbo, sa che ore sono?","tr":"Rahatsız ettiğim için kusura bakmayın, saatin kaç olduğunu biliyor musunuz?"}]},
  {"id":"it-daily-scusa-il-ritardo","languageId":"it","category":"daily","level":"A2","sourceText":"Scusa il ritardo","translations":{"tr":["geciktiğim için kusura bakma"]},"details":{"register":"informal","context":"Bir buluşmaya geç kalınca."},"examples":[{"text":"Scusa il ritardo, c'era traffico.","tr":"Geciktiğim için kusura bakma, trafik vardı."}]},
  {"id":"it-daily-ti-disturbo","languageId":"it","category":"daily","level":"A2","sourceText":"Ti disturbo?","translations":{"tr":["rahatsız ediyor muyum?"]},"details":{"register":"informal","context":"Birini arayınca ya da yanına gidince."},"examples":[{"text":"Ciao, ti disturbo? Hai due minuti?","tr":"Selam, rahatsız ediyor muyum? İki dakikan var mı?"}]},
  {"id":"it-daily-hai-un-minuto","languageId":"it","category":"daily","level":"A2","sourceText":"Hai un minuto?","translations":{"tr":["bir dakikan var mı?"]},"details":{"register":"informal","context":"Konuşmak için birinin zamanını isterken."},"examples":[{"text":"Hai un minuto? Ti devo parlare.","tr":"Bir dakikan var mı? Seninle konuşmam lazım."}]},
  {"id":"it-daily-ciao-bella-ciao-bello","languageId":"it","category":"daily","level":"A2","sourceText":"Ciao, bella! / Ciao, bello!","translations":{"tr":["selam canım!","selam güzelim!"]},"details":{"register":"informal","context":"Yakın arkadaşlar arasında sevecen selam; flört anlamı taşımaz."},"examples":[{"text":"Ciao, bella! Quanto tempo!","tr":"Selam canım! Ne zamandır görüşmedik!"}]},
  {"id":"it-daily-promesso","languageId":"it","category":"daily","level":"A2","sourceText":"Promesso!","translations":{"tr":["söz!","söz veriyorum!"]},"details":{"register":"informal","context":"Bir sözü onaylarken."},"examples":[{"text":"Mi chiami appena arrivi? — Promesso!","tr":"Varır varmaz beni arar mısın? — Söz!"}]},
  {"id":"it-daily-ottima-idea","languageId":"it","category":"daily","level":"A2","sourceText":"Ottima idea!","translations":{"tr":["harika fikir!"]},"details":{"register":"neutral","context":"Bir öneriyi beğenince."},"examples":[{"text":"Facciamo un picnic? — Ottima idea!","tr":"Piknik yapalım mı? — Harika fikir!"}]},
  {"id":"it-daily-che-carino","languageId":"it","category":"daily","level":"A2","sourceText":"Che carino!","translations":{"tr":["ne şirin!","ne tatlı!"]},"details":{"register":"informal","context":"Sevimli bir şey ya da nazik bir davranış için; kadın/dişil 'carina'."},"examples":[{"text":"Che carino il tuo cagnolino!","tr":"Köpeğin ne şirin!"}]},
  {"id":"it-daily-ti-voglio-bene","languageId":"it","category":"daily","level":"A2","sourceText":"Ti voglio bene","translations":{"tr":["seni seviyorum"]},"details":{"register":"informal","context":"Aile ve arkadaşlara sevgi; romantik sevgi için 'Ti amo'."},"examples":[{"text":"Ciao mamma, ti voglio bene!","tr":"Hoşça kal anne, seni seviyorum!"}]},
  {"id":"it-daily-mi-manchi","languageId":"it","category":"daily","level":"A2","sourceText":"Mi manchi","translations":{"tr":["seni özledim","seni özlüyorum"]},"details":{"register":"informal","context":"Uzaktaki sevdiğin birine."},"examples":[{"text":"Quando torni? Mi manchi tanto.","tr":"Ne zaman dönüyorsun? Seni çok özledim."}]},
  {"id":"it-daily-un-bacio","languageId":"it","category":"daily","level":"A2","sourceText":"Un bacio!","translations":{"tr":["öpüyorum!","öptüm!"]},"details":{"register":"informal","context":"Yakınlara mesaj ya da telefon vedası; 'Un abbraccio' = sarılıyorum."},"examples":[{"text":"Ci sentiamo domani. Un bacio!","tr":"Yarın konuşuruz. Öptüm!"}]},
  {"id":"it-daily-salutami","languageId":"it","category":"daily","level":"A2","sourceText":"Salutami...","translations":{"tr":["...e selam söyle"]},"details":{"register":"informal","context":"Ortak bir tanıdığa selam gönderirken."},"examples":[{"text":"Salutami tua madre!","tr":"Annene selam söyle!"}]},
  {"id":"it-daily-sogni-doro","languageId":"it","category":"daily","level":"A2","sourceText":"Sogni d'oro!","translations":{"tr":["tatlı rüyalar!"]},"details":{"register":"informal","context":"Yatmadan önce, özellikle çocuklara ya da sevgiliye."},"examples":[{"text":"Buonanotte, tesoro. Sogni d'oro!","tr":"İyi geceler, canım. Tatlı rüyalar!"}]},
  {"id":"it-daily-buona-continuazione","languageId":"it","category":"daily","level":"A2","sourceText":"Buona continuazione!","translations":{"tr":["devamı iyi geçsin!","kolay gelsin!"]},"details":{"register":"neutral","context":"Günün, tatilin ya da işin geri kalanı için iyi dilek."},"examples":[{"text":"Grazie per l'informazione. Buona continuazione!","tr":"Bilgi için teşekkürler. Gerisi iyi geçsin!"}]},
  {"id":"it-daily-come-andata","languageId":"it","category":"daily","level":"A2","sourceText":"Com'è andata?","translations":{"tr":["nasıl geçti?"]},"details":{"register":"neutral","context":"Bir sınav, toplantı ya da yolculuktan sonra."},"examples":[{"text":"Allora, com'è andata l'intervista?","tr":"Eee, mülakat nasıl geçti?"}]},
  {"id":"it-daily-che-ce","languageId":"it","category":"daily","level":"A2","sourceText":"Che c'è?","translations":{"tr":["ne var?","ne oldu?"]},"details":{"register":"informal","context":"Birinin tavrında bir terslik sezince ya da seslenince."},"examples":[{"text":"Che c'è? Perché mi guardi così?","tr":"Ne var? Neden bana öyle bakıyorsun?"}]},
  {"id":"it-daily-che-succede","languageId":"it","category":"daily","level":"A2","sourceText":"Che succede?","translations":{"tr":["ne oluyor?"]},"details":{"register":"neutral","context":"Anlamadığın bir durumda; olmuş için 'Cos'è successo?'."},"examples":[{"text":"Che succede? Perché tutti gridano?","tr":"Ne oluyor? Neden herkes bağırıyor?"}]},
  {"id":"it-daily-figurati","languageId":"it","category":"daily","level":"A2","sourceText":"Figurati!","translations":{"tr":["rica ederim","ne demek!","lafı mı olur"]},"details":{"register":"informal","context":"Teşekküre ya da özre samimi cevap; resmîsi 'Si figuri!'."},"examples":[{"text":"Grazie per il passaggio! — Figurati!","tr":"Bıraktığın için sağ ol! — Ne demek!"}]},
  {"id":"it-daily-non-ce-di-che","languageId":"it","category":"daily","level":"A2","sourceText":"Non c'è di che","translations":{"tr":["rica ederim","bir şey değil"]},"details":{"register":"neutral","context":"Teşekküre kibar cevap."},"examples":[{"text":"Grazie mille per l'aiuto. — Non c'è di che.","tr":"Yardımın için çok teşekkürler. — Bir şey değil."}]},
  {"id":"it-daily-altrettanto","languageId":"it","category":"daily","level":"A2","sourceText":"Altrettanto!","translations":{"tr":["size de!","sana da!"]},"details":{"register":"neutral","context":"Bir iyi dileğe aynısıyla karşılık verirken."},"examples":[{"text":"Buon appetito! — Grazie, altrettanto!","tr":"Afiyet olsun! — Teşekkürler, size de!"}]},
  {"id":"it-daily-grazie-di-tutto","languageId":"it","category":"daily","level":"A2","sourceText":"Grazie di tutto","translations":{"tr":["her şey için teşekkürler"]},"details":{"register":"neutral","context":"Ayrılırken ya da bir yardımın sonunda."},"examples":[{"text":"È stata una vacanza bellissima. Grazie di tutto!","tr":"Harika bir tatildi. Her şey için teşekkürler!"}]},
  {"id":"it-daily-grazie-lo-stesso","languageId":"it","category":"daily","level":"A2","sourceText":"Grazie lo stesso","translations":{"tr":["yine de teşekkürler"]},"details":{"register":"neutral","context":"Yardım edemeyen birine kibarca teşekkür ederken."},"examples":[{"text":"Mi dispiace, non lo so. — Va bene, grazie lo stesso.","tr":"Üzgünüm, bilmiyorum. — Olsun, yine de teşekkürler."}]},
  {"id":"it-daily-molto-gentile","languageId":"it","category":"daily","level":"A2","sourceText":"Molto gentile!","translations":{"tr":["çok naziksiniz!","çok incesiniz!"]},"details":{"register":"neutral","context":"Bir nezakete teşekkür ederken."},"examples":[{"text":"Le ho tenuto il posto. — Molto gentile, grazie!","tr":"Yerinizi tuttum. — Çok naziksiniz, teşekkürler!"}]},
  {"id":"it-daily-e-stato-un-piacere","languageId":"it","category":"daily","level":"A2","sourceText":"È stato un piacere","translations":{"tr":["benim için zevkti","memnun oldum"]},"details":{"register":"neutral","context":"Bir buluşma ya da yardımın sonunda."},"examples":[{"text":"Grazie per la cena! — È stato un piacere.","tr":"Yemek için teşekkürler! — Benim için zevkti."}]},
  {"id":"it-daily-non-fa-niente","languageId":"it","category":"daily","level":"A2","sourceText":"Non fa niente","translations":{"tr":["önemli değil","boş ver"]},"details":{"register":"neutral","context":"Bir özre cevap verirken."},"examples":[{"text":"Scusa, ho rotto il bicchiere. — Non fa niente.","tr":"Pardon, bardağı kırdım. — Önemli değil."}]},
  {"id":"it-daily-non-importa","languageId":"it","category":"daily","level":"A2","sourceText":"Non importa","translations":{"tr":["fark etmez","önemli değil"]},"details":{"register":"neutral","context":"Bir şeyin önemsiz olduğunu söylerken."},"examples":[{"text":"Non c'è più il dolce. — Non importa, prendo un caffè.","tr":"Tatlı kalmadı. — Fark etmez, bir kahve alırım."}]},
  {"id":"it-daily-fa-lo-stesso","languageId":"it","category":"daily","level":"A2","sourceText":"Fa lo stesso","translations":{"tr":["fark etmez","hepsi bir"]},"details":{"register":"neutral","context":"Seçenekler arasında tercihin olmadığını söylerken."},"examples":[{"text":"Vuoi il rosso o il bianco? — Fa lo stesso.","tr":"Kırmızı mı istersin beyaz mı? — Fark etmez."}]},
  {"id":"it-daily-non-ti-preoccupare","languageId":"it","category":"daily","level":"A2","sourceText":"Non ti preoccupare!","translations":{"tr":["merak etme!","dert etme!"]},"details":{"register":"neutral","context":"Birini rahatlatırken; resmîde 'Non si preoccupi!'."},"examples":[{"text":"Ho perso il tuo libro! — Non ti preoccupare, ne compro un altro.","tr":"Kitabını kaybettim! — Dert etme, başka bir tane alırım."}]},
  {"id":"it-daily-stai-tranquillo-stai-tranquilla","languageId":"it","category":"daily","level":"A2","sourceText":"Stai tranquillo / Stai tranquilla","translations":{"tr":["rahat ol","merak etme","sakin ol"]},"details":{"register":"informal","context":"Endişeli birine güvence verirken; kısaca 'Tranquillo!'."},"examples":[{"text":"Stai tranquilla, andrà tutto bene.","tr":"Merak etme, her şey yoluna girecek."}]},
  {"id":"it-daily-calma","languageId":"it","category":"daily","level":"A2","sourceText":"Calma!","translations":{"tr":["sakin ol!","sakin olun!"]},"details":{"register":"neutral","context":"Gergin ya da telaşlı birine."},"examples":[{"text":"Calma! Non è successo niente di grave.","tr":"Sakin ol! Ciddi bir şey olmadı."}]},
  {"id":"it-daily-non-ce-fretta","languageId":"it","category":"daily","level":"A2","sourceText":"Non c'è fretta","translations":{"tr":["acele yok","acelesi yok"]},"details":{"register":"neutral","context":"Birine rahatça zaman tanırken."},"examples":[{"text":"Ti restituisco i soldi la settimana prossima. — Non c'è fretta.","tr":"Parayı gelecek hafta geri veririm. — Acelesi yok."}]},
  {"id":"it-daily-con-calma","languageId":"it","category":"daily","level":"A2","sourceText":"Con calma","translations":{"tr":["acele etme","yavaş yavaş","rahatına bak"]},"details":{"register":"neutral","context":"Birine acele etmemesini söylerken."},"examples":[{"text":"Finisci pure il caffè, con calma.","tr":"Kahveni bitir, acele etme."}]},
  {"id":"it-daily-sbrigati","languageId":"it","category":"daily","level":"A2","sourceText":"Sbrigati!","translations":{"tr":["acele et!","çabuk ol!"]},"details":{"register":"informal","context":"Birini hızlandırmak için; çoğulu 'Sbrigatevi!'."},"examples":[{"text":"Sbrigati, il treno parte tra cinque minuti!","tr":"Acele et, tren beş dakikaya kalkıyor!"}]},
  {"id":"it-daily-dai","languageId":"it","category":"daily","level":"A2","sourceText":"Dai!","translations":{"tr":["hadi!","haydi!","yapma ya!"]},"details":{"register":"informal","context":"Cesaret verirken, ikna ederken ya da hafif itiraz ederken."},"examples":[{"text":"Dai, vieni anche tu alla festa!","tr":"Hadi, sen de partiye gel!"}]},
  {"id":"it-daily-forza","languageId":"it","category":"daily","level":"A2","sourceText":"Forza!","translations":{"tr":["haydi!","hadi bakalım!"]},"details":{"register":"informal","context":"Destek verirken ya da takımı tezahürat ederken."},"examples":[{"text":"Forza, manca solo un chilometro!","tr":"Haydi, sadece bir kilometre kaldı!"}]},
  {"id":"it-daily-ben-fatto","languageId":"it","category":"daily","level":"A2","sourceText":"Ben fatto!","translations":{"tr":["aferin!","iyi iş!"]},"details":{"register":"neutral","context":"Birinin işini övmek için."},"examples":[{"text":"Hai sistemato tutto da solo? Ben fatto!","tr":"Her şeyi tek başına mı hallettin? Aferin!"}]},
  {"id":"it-daily-complimenti","languageId":"it","category":"daily","level":"A2","sourceText":"Complimenti!","translations":{"tr":["tebrikler!","helal olsun!"]},"details":{"register":"neutral","context":"Bir başarıyı kutlarken ya da bir şeyi övmek için; daha resmîsi 'Congratulazioni!'."},"examples":[{"text":"Ti sei laureato? Complimenti!","tr":"Mezun mu oldun? Tebrikler!"}]},
  {"id":"it-daily-evviva","languageId":"it","category":"daily","level":"A2","sourceText":"Evviva!","translations":{"tr":["yaşasın!"]},"details":{"register":"neutral","context":"Coşkuyla sevinç bildirirken."},"examples":[{"text":"Domani non c'è scuola! Evviva!","tr":"Yarın okul yok! Yaşasın!"}]},
  {"id":"it-daily-magari","languageId":"it","category":"daily","level":"A2","sourceText":"Magari!","translations":{"tr":["keşke!","inşallah!","belki"]},"details":{"register":"neutral","context":"Gerçekleşmesini çok istediğin bir şey için; cümle başında 'belki' de olur."},"examples":[{"text":"Hai vinto alla lotteria? — Magari!","tr":"Piyangoyu mu kazandın? — Keşke!"}]},
  {"id":"it-daily-speriamo-bene","languageId":"it","category":"daily","level":"A2","sourceText":"Speriamo bene!","translations":{"tr":["umarım iyi olur","hayırlısı"]},"details":{"register":"neutral","context":"Belirsiz bir sonucu iyi dileklerle beklerken."},"examples":[{"text":"Domani ho il colloquio. — Speriamo bene!","tr":"Yarın mülakatım var. — Umarım iyi geçer!"}]},
  {"id":"it-daily-chissa","languageId":"it","category":"daily","level":"A2","sourceText":"Chissà!","translations":{"tr":["kim bilir!","belki"]},"details":{"register":"neutral","context":"Bir şeyin cevabının belirsiz olduğunu söylerken."},"examples":[{"text":"Ci rivedremo un giorno? — Chissà!","tr":"Bir gün yine görüşür müyüz? — Kim bilir!"}]},
  {"id":"it-daily-boh","languageId":"it","category":"daily","level":"A2","sourceText":"Boh!","translations":{"tr":["bilmem!","ne bileyim!"]},"details":{"register":"informal","context":"Bilmediğini omuz silkerek söylerken."},"examples":[{"text":"Dov'è Luca? — Boh!","tr":"Luca nerede? — Bilmem!"}]},
  {"id":"it-daily-beh","languageId":"it","category":"daily","level":"A2","sourceText":"Beh","translations":{"tr":["şey","eh","yani"]},"details":{"register":"informal","context":"Cevap vermeden önce düşünürken ya da sözü yumuşatırken."},"examples":[{"text":"Ti è piaciuto il film? — Beh, non molto.","tr":"Filmi beğendin mi? — Şey, pek değil."}]},
  {"id":"it-daily-non-ne-ho-idea","languageId":"it","category":"daily","level":"A2","sourceText":"Non ne ho idea","translations":{"tr":["hiçbir fikrim yok"]},"details":{"register":"neutral","context":"Bir şeyi kesinlikle bilmediğini söylerken."},"examples":[{"text":"Quando torna Marco? — Non ne ho idea.","tr":"Marco ne zaman dönüyor? — Hiçbir fikrim yok."}]},
  {"id":"it-daily-dipende","languageId":"it","category":"daily","level":"A2","sourceText":"Dipende","translations":{"tr":["duruma bağlı","değişir"]},"details":{"register":"neutral","context":"Kesin cevap veremediğinde."},"examples":[{"text":"Vieni domani? — Dipende dal tempo.","tr":"Yarın geliyor musun? — Havaya bağlı."}]},
  {"id":"it-daily-perche-no","languageId":"it","category":"daily","level":"A2","sourceText":"Perché no?","translations":{"tr":["neden olmasın?"]},"details":{"register":"neutral","context":"Bir öneriyi rahatça kabul ederken."},"examples":[{"text":"Andiamo a mangiare giapponese? — Perché no?","tr":"Japon yemeği yemeye gidelim mi? — Neden olmasın?"}]},
  {"id":"it-daily-che-ne-dici","languageId":"it","category":"daily","level":"A2","sourceText":"Che ne dici?","translations":{"tr":["ne dersin?"]},"details":{"register":"informal","context":"Bir öneri sunup karşı tarafın fikrini sorarken."},"examples":[{"text":"Andiamo al cinema stasera, che ne dici?","tr":"Bu akşam sinemaya gidelim, ne dersin?"}]},
  {"id":"it-daily-ti-va-bene","languageId":"it","category":"daily","level":"A2","sourceText":"Ti va bene?","translations":{"tr":["sana uyar mı?","olur mu?"]},"details":{"register":"informal","context":"Bir saati ya da planı onaylatırken; cevap 'Mi va bene'."},"examples":[{"text":"Ci vediamo alle otto, ti va bene?","tr":"Sekizde görüşelim, sana uyar mı?"}]},
  {"id":"it-daily-come-vuoi","languageId":"it","category":"daily","level":"A2","sourceText":"Come vuoi","translations":{"tr":["nasıl istersen","sen bilirsin"]},"details":{"register":"informal","context":"Seçimi karşı tarafa bırakırken; bazen küskün bir tonla."},"examples":[{"text":"Preferisco restare a casa. — Come vuoi.","tr":"Evde kalmayı tercih ederim. — Nasıl istersen."}]},
  {"id":"it-daily-decidi-tu","languageId":"it","category":"daily","level":"A2","sourceText":"Decidi tu","translations":{"tr":["sen karar ver","sen bilirsin"]},"details":{"register":"informal","context":"Kararı karşı tarafa bırakırken."},"examples":[{"text":"Pizza o sushi? — Decidi tu.","tr":"Pizza mı suşi mi? — Sen karar ver."}]},
  {"id":"it-daily-stai-attento-stai-attenta","languageId":"it","category":"daily","level":"A2","sourceText":"Stai attento! / Stai attenta!","translations":{"tr":["dikkat et!","kendine dikkat et!"]},"details":{"register":"informal","context":"Birini bir tehlikeye karşı uyarırken."},"examples":[{"text":"Stai attento, la strada è ghiacciata.","tr":"Dikkat et, yol buz tutmuş."}]},
  {"id":"it-daily-senti","languageId":"it","category":"daily","level":"A2","sourceText":"Senti","translations":{"tr":["baksana","dinle","bak"]},"details":{"register":"informal","context":"Söze başlarken dikkat çekmek için; resmîde 'Senta'."},"examples":[{"text":"Senti, stasera ti va di uscire?","tr":"Baksana, bu akşam çıkmak ister misin?"}]},
  {"id":"it-daily-indovina","languageId":"it","category":"daily","level":"A2","sourceText":"Indovina!","translations":{"tr":["tahmin et!","bil bakalım!"]},"details":{"register":"informal","context":"Bir haberi heyecanla vermeden önce; 'Indovina un po'!' da denir."},"examples":[{"text":"Indovina chi ho incontrato oggi!","tr":"Bil bakalım bugün kime rastladım!"}]},
  {"id":"it-daily-esatto","languageId":"it","category":"daily","level":"A2","sourceText":"Esatto!","translations":{"tr":["aynen!","kesinlikle!","tam olarak!"]},"details":{"register":"neutral","context":"Karşı tarafın söylediğini tamamen onaylarken."},"examples":[{"text":"Quindi il treno parte alle nove? — Esatto!","tr":"Yani tren dokuzda mı kalkıyor? — Aynen!"}]},
  {"id":"it-daily-giusto","languageId":"it","category":"daily","level":"A2","sourceText":"Giusto!","translations":{"tr":["doğru!","haklısın!"]},"details":{"register":"neutral","context":"Bir fikre ya da hatırlatmaya katılırken."},"examples":[{"text":"Non dimenticare il passaporto! — Giusto!","tr":"Pasaportu unutma! — Doğru!"}]},
  {"id":"it-daily-assolutamente","languageId":"it","category":"daily","level":"A2","sourceText":"Assolutamente!","translations":{"tr":["kesinlikle!","mutlaka!"]},"details":{"register":"neutral","context":"Güçlü onay; 'Assolutamente no!' = kesinlikle hayır."},"examples":[{"text":"Dovremmo tornarci? — Assolutamente!","tr":"Oraya yine gitmeli miyiz? — Kesinlikle!"}]},
  {"id":"it-daily-scherzo","languageId":"it","category":"daily","level":"A2","sourceText":"Scherzo!","translations":{"tr":["şaka yapıyorum!","şaka şaka!"]},"details":{"register":"informal","context":"Söylediğinin şaka olduğunu belirtirken."},"examples":[{"text":"Non vengo più. Scherzo, arrivo tra dieci minuti!","tr":"Artık gelmiyorum. Şaka şaka, on dakikaya oradayım!"}]},
  {"id":"it-daily-ma-dai","languageId":"it","category":"daily","level":"A2","sourceText":"Ma dai!","translations":{"tr":["yok artık!","hadi canım!","deme!"]},"details":{"register":"informal","context":"Şaşkınlık ya da inanmazlık bildirirken."},"examples":[{"text":"Si sposano a giugno. — Ma dai!","tr":"Haziranda evleniyorlar. — Yok artık!"}]},
  {"id":"it-daily-non-ci-credo","languageId":"it","category":"daily","level":"A2","sourceText":"Non ci credo!","translations":{"tr":["inanmıyorum!","inanamıyorum!"]},"details":{"register":"neutral","context":"Çok şaşırtıcı bir habere tepki."},"examples":[{"text":"Abbiamo vinto il viaggio! — Non ci credo!","tr":"Geziyi kazandık! — İnanamıyorum!"}]},
  {"id":"it-daily-che-sorpresa","languageId":"it","category":"daily","level":"A2","sourceText":"Che sorpresa!","translations":{"tr":["ne sürpriz!"]},"details":{"register":"neutral","context":"Beklenmedik bir karşılaşma ya da olayda."},"examples":[{"text":"Che sorpresa vederti qui!","tr":"Seni burada görmek ne sürpriz!"}]},
  {"id":"it-daily-incredibile","languageId":"it","category":"daily","level":"A2","sourceText":"Incredibile!","translations":{"tr":["inanılmaz!"]},"details":{"register":"neutral","context":"Şaşkınlık ya da hayranlık bildirirken."},"examples":[{"text":"Incredibile! Hai fatto tutto in un giorno?","tr":"İnanılmaz! Hepsini bir günde mi yaptın?"}]},
  {"id":"it-daily-finalmente","languageId":"it","category":"daily","level":"A2","sourceText":"Finalmente!","translations":{"tr":["nihayet!","sonunda!"]},"details":{"register":"neutral","context":"Uzun beklenen bir şey olunca."},"examples":[{"text":"Finalmente sei arrivato!","tr":"Sonunda geldin!"}]},
  {"id":"it-daily-meno-male","languageId":"it","category":"daily","level":"A2","sourceText":"Meno male!","translations":{"tr":["neyse ki!","oh be!","iyi ki!"]},"details":{"register":"neutral","context":"Kötü bir ihtimal gerçekleşmeyince rahatlayarak."},"examples":[{"text":"Il treno è in ritardo, ma noi siamo in tempo. Meno male!","tr":"Tren rötarlı, ama biz zamanındayız. Neyse ki!"}]},
  {"id":"it-daily-che-fortuna","languageId":"it","category":"daily","level":"A2","sourceText":"Che fortuna!","translations":{"tr":["ne şans!","ne şanslısın!"]},"details":{"register":"neutral","context":"Şanslı bir duruma tepki; tersi 'Che sfortuna!'."},"examples":[{"text":"Hai trovato parcheggio subito? Che fortuna!","tr":"Hemen park yeri mi buldun? Ne şans!"}]},
  {"id":"it-daily-che-peccato","languageId":"it","category":"daily","level":"A2","sourceText":"Che peccato!","translations":{"tr":["ne yazık!","çok yazık!"]},"details":{"register":"neutral","context":"Üzüntü ya da hayal kırıklığı bildirirken; kısaca 'Peccato!'."},"examples":[{"text":"Non puoi venire? Che peccato!","tr":"Gelemiyor musun? Ne yazık!"}]},
  {"id":"it-daily-pazienza","languageId":"it","category":"daily","level":"A2","sourceText":"Pazienza!","translations":{"tr":["ne yapalım!","olsun!","kısmet"]},"details":{"register":"neutral","context":"Değiştirilemeyecek bir durumu kabullenirken."},"examples":[{"text":"Il museo è chiuso. — Pazienza, torniamo domani.","tr":"Müze kapalı. — Ne yapalım, yarın geliriz."}]},
  {"id":"it-daily-che-noia","languageId":"it","category":"daily","level":"A2","sourceText":"Che noia!","translations":{"tr":["ne sıkıcı!","sıkıldım!"]},"details":{"register":"neutral","context":"Bir şeyden sıkılınca."},"examples":[{"text":"Che noia questa conferenza!","tr":"Bu konferans ne sıkıcı!"}]},
  {"id":"it-daily-che-schifo","languageId":"it","category":"daily","level":"A2","sourceText":"Che schifo!","translations":{"tr":["iğrenç!","ne kötü!"]},"details":{"register":"informal","context":"Tiksinti ya da çok beğenmeme bildirirken."},"examples":[{"text":"Il latte è scaduto. Che schifo!","tr":"Sütün tarihi geçmiş. İğrenç!"}]},
  {"id":"it-daily-uffa","languageId":"it","category":"daily","level":"A2","sourceText":"Uffa!","translations":{"tr":["of ya!","off!"]},"details":{"register":"informal","context":"Sıkıntı ya da sabırsızlık bildirirken."},"examples":[{"text":"Uffa, devo rifare tutto da capo!","tr":"Of ya, her şeyi baştan yapmam lazım!"}]},
  {"id":"it-daily-oddio","languageId":"it","category":"daily","level":"A2","sourceText":"Oddio!","translations":{"tr":["aman Tanrım!","eyvah!"]},"details":{"register":"informal","context":"Ani şaşkınlık ya da korku anında."},"examples":[{"text":"Oddio, ho lasciato il gas acceso!","tr":"Eyvah, ocağı açık bıraktım!"}]},
  {"id":"it-daily-vediamo","languageId":"it","category":"daily","level":"A2","sourceText":"Vediamo","translations":{"tr":["bakalım","göreceğiz"]},"details":{"register":"neutral","context":"Karar vermeden önce ya da düşünürken."},"examples":[{"text":"Vieni sabato? — Vediamo, ti faccio sapere.","tr":"Cumartesi geliyor musun? — Bakalım, sana haber veririm."}]},
  {"id":"it-daily-alla-prossima","languageId":"it","category":"daily","level":"A2","sourceText":"Alla prossima!","translations":{"tr":["bir dahaki sefere!","görüşmek üzere!"]},"details":{"register":"informal","context":"Bir sonraki buluşmaya atıfla vedalaşırken."},"examples":[{"text":"È stata una bella serata. Alla prossima!","tr":"Güzel bir akşamdı. Bir dahaki sefere!"}]},
  {"id":"it-daily-manca-poco","languageId":"it","category":"daily","level":"A2","sourceText":"Manca poco","translations":{"tr":["az kaldı"]},"details":{"register":"neutral","context":"Bir yere ya da bir ana yaklaşınca."},"examples":[{"text":"Siamo quasi arrivati? — Sì, manca poco.","tr":"Neredeyse geldik mi? — Evet, az kaldı."}]},
  {"id":"it-daily-ecco-fatto","languageId":"it","category":"daily","level":"A2","sourceText":"Ecco fatto!","translations":{"tr":["tamamdır!","oldu işte!"]},"details":{"register":"neutral","context":"Bir işi bitirdiğinde."},"examples":[{"text":"Ecco fatto! Il computer funziona di nuovo.","tr":"Tamamdır! Bilgisayar yine çalışıyor."}]},
  {"id":"it-daily-ti-capisco","languageId":"it","category":"daily","level":"A2","sourceText":"Ti capisco","translations":{"tr":["seni anlıyorum"]},"details":{"register":"informal","context":"Empati gösterirken."},"examples":[{"text":"Sono stanchissimo di questo lavoro. — Ti capisco.","tr":"Bu işten çok yoruldum. — Seni anlıyorum."}]},
  {"id":"it-daily-giuro","languageId":"it","category":"daily","level":"A2","sourceText":"Giuro!","translations":{"tr":["yemin ederim!"]},"details":{"register":"informal","context":"Doğruyu söylediğini vurgularken; 'Ti giuro' da denir."},"examples":[{"text":"Non sono stato io, giuro!","tr":"Ben yapmadım, yemin ederim!"}]}
]
