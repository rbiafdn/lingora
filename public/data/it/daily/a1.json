[
  {"id":"it-daily-ciao","languageId":"it","category":"daily","level":"A1","sourceText":"Ciao!","translations":{"tr":["merhaba","selam","hoşça kal"]},"details":{"register":"informal","context":"Tanıdıklarla hem selamlaşırken hem vedalaşırken."},"examples":[{"text":"Ciao Marco, come va?","tr":"Selam Marco, nasıl gidiyor?"}]},
  {"id":"it-daily-buongiorno","languageId":"it","category":"daily","level":"A1","sourceText":"Buongiorno!","translations":{"tr":["günaydın","iyi günler"]},"details":{"register":"neutral","context":"Sabahtan öğleden sonraya kadar selamlaşırken."},"examples":[{"text":"Buongiorno, signora Rossi!","tr":"Günaydın, Bayan Rossi!"}]},
  {"id":"it-daily-buon-pomeriggio","languageId":"it","category":"daily","level":"A1","sourceText":"Buon pomeriggio!","translations":{"tr":["tünaydın","iyi öğleden sonralar"]},"details":{"register":"neutral","context":"Öğleden sonra, daha çok vedalaşırken."},"examples":[{"text":"Grazie e buon pomeriggio!","tr":"Teşekkürler, iyi öğleden sonralar!"}]},
  {"id":"it-daily-buonasera","languageId":"it","category":"daily","level":"A1","sourceText":"Buonasera!","translations":{"tr":["iyi akşamlar"]},"details":{"register":"neutral","context":"Öğleden sonra geç saatlerden itibaren selamlaşırken."},"examples":[{"text":"Buonasera, avete un tavolo libero?","tr":"İyi akşamlar, boş masanız var mı?"}]},
  {"id":"it-daily-buonanotte","languageId":"it","category":"daily","level":"A1","sourceText":"Buonanotte!","translations":{"tr":["iyi geceler"]},"details":{"register":"neutral","context":"Yatmadan önce ya da gece geç saatte ayrılırken."},"examples":[{"text":"Vado a letto. Buonanotte a tutti!","tr":"Yatmaya gidiyorum. Herkese iyi geceler!"}]},
  {"id":"it-daily-salve","languageId":"it","category":"daily","level":"A1","sourceText":"Salve!","translations":{"tr":["merhaba","iyi günler"]},"details":{"register":"neutral","context":"Sen mi siz mi diyeceğinden emin olmadığında güvenli selam."},"examples":[{"text":"Salve, vorrei un'informazione.","tr":"Merhaba, bir bilgi almak istiyordum."}]},
  {"id":"it-daily-arrivederci","languageId":"it","category":"daily","level":"A1","sourceText":"Arrivederci!","translations":{"tr":["hoşça kalın","güle güle"]},"details":{"register":"neutral","context":"Vedalaşırken; herkesle kullanılabilir."},"examples":[{"text":"Grazie di tutto, arrivederci!","tr":"Her şey için teşekkürler, hoşça kalın!"}]},
  {"id":"it-daily-arrivederla","languageId":"it","category":"daily","level":"A1","sourceText":"ArrivederLa!","translations":{"tr":["hoşça kalın"]},"details":{"register":"formal","context":"Çok resmî veda; tek bir kişiye 'Lei' ile hitap ederken."},"examples":[{"text":"ArrivederLa, dottore.","tr":"Hoşça kalın, doktor bey."}]},
  {"id":"it-daily-a-presto","languageId":"it","category":"daily","level":"A1","sourceText":"A presto!","translations":{"tr":["yakında görüşürüz","görüşmek üzere"]},"details":{"register":"neutral","context":"Yakında tekrar görüşmeyi umarak vedalaşırken."},"examples":[{"text":"È stato bello vederti. A presto!","tr":"Seni görmek güzeldi. Yakında görüşürüz!"}]},
  {"id":"it-daily-a-dopo","languageId":"it","category":"daily","level":"A1","sourceText":"A dopo!","translations":{"tr":["sonra görüşürüz"]},"details":{"register":"informal","context":"Aynı gün içinde tekrar görüşecekseniz."},"examples":[{"text":"Vado a fare la spesa, a dopo!","tr":"Alışverişe gidiyorum, sonra görüşürüz!"}]},
  {"id":"it-daily-a-domani","languageId":"it","category":"daily","level":"A1","sourceText":"A domani!","translations":{"tr":["yarın görüşürüz"]},"details":{"register":"neutral","context":"Ertesi gün görüşecekseniz vedalaşırken."},"examples":[{"text":"Ciao ragazzi, a domani!","tr":"Hoşça kalın çocuklar, yarın görüşürüz!"}]},
  {"id":"it-daily-ci-vediamo","languageId":"it","category":"daily","level":"A1","sourceText":"Ci vediamo!","translations":{"tr":["görüşürüz"]},"details":{"register":"informal","context":"Genel veda; 'Ci vediamo domani/dopo' diye de uzatılır."},"examples":[{"text":"Ci vediamo stasera al bar!","tr":"Akşam barda görüşürüz!"}]},
  {"id":"it-daily-come-stai","languageId":"it","category":"daily","level":"A1","sourceText":"Come stai?","translations":{"tr":["nasılsın?"]},"details":{"register":"informal","context":"Tanıdık birine hâlini sorarken."},"examples":[{"text":"Ciao Giulia, come stai?","tr":"Selam Giulia, nasılsın?"}]},
  {"id":"it-daily-come-sta","languageId":"it","category":"daily","level":"A1","sourceText":"Come sta?","translations":{"tr":["nasılsınız?"]},"details":{"register":"formal","context":"'Lei' ile resmî hitapta hâl sorarken."},"examples":[{"text":"Buongiorno, professore. Come sta?","tr":"Günaydın hocam. Nasılsınız?"}]},
  {"id":"it-daily-come-va","languageId":"it","category":"daily","level":"A1","sourceText":"Come va?","translations":{"tr":["nasıl gidiyor?","ne var ne yok?"]},"details":{"register":"neutral","context":"Gündelik hâl hatır sorma; hem sen hem siz için olur."},"examples":[{"text":"Come va il nuovo lavoro?","tr":"Yeni iş nasıl gidiyor?"}]},
  {"id":"it-daily-bene-grazie-e-tu","languageId":"it","category":"daily","level":"A1","sourceText":"Bene, grazie. E tu?","translations":{"tr":["iyiyim, teşekkürler. Ya sen?"]},"details":{"register":"neutral","context":"'Come stai?' sorusuna klasik cevap; resmîde 'E Lei?'."},"examples":[{"text":"Come stai? — Bene, grazie. E tu?","tr":"Nasılsın? — İyiyim, teşekkürler. Ya sen?"}]},
  {"id":"it-daily-non-ce-male","languageId":"it","category":"daily","level":"A1","sourceText":"Non c'è male","translations":{"tr":["fena değil"]},"details":{"register":"neutral","context":"Hâl sorulunca ılımlı cevap."},"examples":[{"text":"Come va? — Non c'è male, grazie.","tr":"Nasıl gidiyor? — Fena değil, teşekkürler."}]},
  {"id":"it-daily-cosi-cosi","languageId":"it","category":"daily","level":"A1","sourceText":"Così così","translations":{"tr":["şöyle böyle","idare eder"]},"details":{"register":"neutral","context":"Pek iyi olmadığını belirtirken."},"examples":[{"text":"Come stai oggi? — Così così, sono un po' stanco.","tr":"Bugün nasılsın? — Şöyle böyle, biraz yorgunum."}]},
  {"id":"it-daily-piacere","languageId":"it","category":"daily","level":"A1","sourceText":"Piacere!","translations":{"tr":["memnun oldum","tanıştığımıza memnun oldum"]},"details":{"register":"neutral","context":"Tanışırken el sıkışırken söylenir."},"examples":[{"text":"Io sono Luca. — Piacere, Ayşe.","tr":"Ben Luca. — Memnun oldum, ben Ayşe."}]},
  {"id":"it-daily-grazie","languageId":"it","category":"daily","level":"A1","sourceText":"Grazie!","translations":{"tr":["teşekkürler","sağ ol"]},"details":{"register":"neutral","context":"Her durumda temel teşekkür."},"examples":[{"text":"Ecco il suo caffè. — Grazie!","tr":"Kahveniz. — Teşekkürler!"}]},
  {"id":"it-daily-prego","languageId":"it","category":"daily","level":"A1","sourceText":"Prego!","translations":{"tr":["rica ederim","buyurun"]},"details":{"register":"neutral","context":"Teşekküre cevap; ayrıca bir şey sunarken ya da 'buyurun girin' derken."},"examples":[{"text":"Grazie! — Prego!","tr":"Teşekkürler! — Rica ederim!"}]},
  {"id":"it-daily-scusa","languageId":"it","category":"daily","level":"A1","sourceText":"Scusa!","translations":{"tr":["pardon","özür dilerim","bakar mısın"]},"details":{"register":"informal","context":"Tanıdığa özür dilerken ya da dikkatini çekerken."},"examples":[{"text":"Scusa, ti ho pestato il piede.","tr":"Pardon, ayağına bastım."}]},
  {"id":"it-daily-permesso","languageId":"it","category":"daily","level":"A1","sourceText":"Permesso?","translations":{"tr":["izninizle","girebilir miyim?","müsaadenizle"]},"details":{"register":"neutral","context":"Kalabalıkta geçerken ya da birinin evine girerken."},"examples":[{"text":"Permesso, devo scendere alla prossima.","tr":"İzninizle, bir sonrakinde inmem lazım."}]},
  {"id":"it-daily-certo","languageId":"it","category":"daily","level":"A1","sourceText":"Certo!","translations":{"tr":["tabii","elbette"]},"details":{"register":"neutral","context":"Bir isteği ya da soruyu güçlü biçimde onaylarken."},"examples":[{"text":"Posso sedermi qui? — Certo!","tr":"Buraya oturabilir miyim? — Tabii!"}]},
  {"id":"it-daily-va-bene","languageId":"it","category":"daily","level":"A1","sourceText":"Va bene","translations":{"tr":["tamam","olur","peki"]},"details":{"register":"neutral","context":"Kabul ederken ya da onaylarken en sık kalıp."},"examples":[{"text":"Ci vediamo alle otto? — Va bene.","tr":"Saat sekizde görüşelim mi? — Tamam."}]},
  {"id":"it-daily-daccordo","languageId":"it","category":"daily","level":"A1","sourceText":"D'accordo!","translations":{"tr":["tamam","anlaştık","peki"]},"details":{"register":"neutral","context":"Bir öneriyi kabul ederken tek başına söylenir."},"examples":[{"text":"Domani ti chiamo io. — D'accordo!","tr":"Yarın ben seni ararım. — Tamam!"}]},
  {"id":"it-daily-no-grazie","languageId":"it","category":"daily","level":"A1","sourceText":"No, grazie","translations":{"tr":["hayır, teşekkürler"]},"details":{"register":"neutral","context":"Bir teklifi kibarca reddederken."},"examples":[{"text":"Vuole un altro caffè? — No, grazie.","tr":"Bir kahve daha ister misiniz? — Hayır, teşekkürler."}]},
  {"id":"it-daily-benvenuto-benvenuta","languageId":"it","category":"daily","level":"A1","sourceText":"Benvenuto! / Benvenuta!","translations":{"tr":["hoş geldin","hoş geldiniz"]},"details":{"register":"neutral","context":"Birini karşılarken; kadına 'benvenuta', topluluğa 'benvenuti'."},"examples":[{"text":"Benvenuti a Roma!","tr":"Roma'ya hoş geldiniz!"}]},
  {"id":"it-daily-buon-appetito","languageId":"it","category":"daily","level":"A1","sourceText":"Buon appetito!","translations":{"tr":["afiyet olsun"]},"details":{"register":"neutral","context":"Yemeğe başlarken; cevap 'Grazie, altrettanto!'."},"examples":[{"text":"La cena è pronta. Buon appetito!","tr":"Akşam yemeği hazır. Afiyet olsun!"}]},
  {"id":"it-daily-salute","languageId":"it","category":"daily","level":"A1","sourceText":"Salute!","translations":{"tr":["çok yaşa","şerefe"]},"details":{"register":"neutral","context":"Biri hapşırınca ya da kadeh kaldırırken."},"examples":[{"text":"Etciù! — Salute!","tr":"Hapşu! — Çok yaşa!"}]},
  {"id":"it-daily-cin-cin","languageId":"it","category":"daily","level":"A1","sourceText":"Cin cin!","translations":{"tr":["şerefe"]},"details":{"register":"informal","context":"Kadeh tokuştururken."},"examples":[{"text":"Alla nostra amicizia, cin cin!","tr":"Dostluğumuza, şerefe!"}]},
  {"id":"it-daily-auguri","languageId":"it","category":"daily","level":"A1","sourceText":"Auguri!","translations":{"tr":["tebrikler","iyi dilekler","nice yıllara"]},"details":{"register":"neutral","context":"Doğum günü, bayram, düğün gibi her kutlamada."},"examples":[{"text":"Oggi compi trent'anni? Tanti auguri!","tr":"Bugün otuz yaşına mı giriyorsun? Nice yıllara!"}]},
  {"id":"it-daily-buon-compleanno","languageId":"it","category":"daily","level":"A1","sourceText":"Buon compleanno!","translations":{"tr":["doğum günün kutlu olsun"]},"details":{"register":"neutral","context":"Doğum gününde."},"examples":[{"text":"Buon compleanno, nonna!","tr":"Doğum günün kutlu olsun, babaanne!"}]},
  {"id":"it-daily-buon-natale","languageId":"it","category":"daily","level":"A1","sourceText":"Buon Natale!","translations":{"tr":["mutlu Noeller"]},"details":{"register":"neutral","context":"Noel döneminde."},"examples":[{"text":"Buon Natale e felice anno nuovo!","tr":"Mutlu Noeller ve mutlu yıllar!"}]},
  {"id":"it-daily-buon-anno","languageId":"it","category":"daily","level":"A1","sourceText":"Buon anno!","translations":{"tr":["mutlu yıllar","iyi seneler"]},"details":{"register":"neutral","context":"Yılbaşında ve yeni yılın ilk günlerinde."},"examples":[{"text":"Mezzanotte! Buon anno a tutti!","tr":"Gece yarısı! Herkese mutlu yıllar!"}]},
  {"id":"it-daily-buon-viaggio","languageId":"it","category":"daily","level":"A1","sourceText":"Buon viaggio!","translations":{"tr":["iyi yolculuklar"]},"details":{"register":"neutral","context":"Yola çıkan birine."},"examples":[{"text":"Partite domani? Buon viaggio!","tr":"Yarın mı yola çıkıyorsunuz? İyi yolculuklar!"}]},
  {"id":"it-daily-buona-giornata","languageId":"it","category":"daily","level":"A1","sourceText":"Buona giornata!","translations":{"tr":["iyi günler"]},"details":{"register":"neutral","context":"Gün içinde vedalaşırken; dükkânlarda çok yaygın."},"examples":[{"text":"Ecco lo scontrino. Buona giornata!","tr":"Fişiniz. İyi günler!"}]},
  {"id":"it-daily-buona-serata","languageId":"it","category":"daily","level":"A1","sourceText":"Buona serata!","translations":{"tr":["iyi akşamlar"]},"details":{"register":"neutral","context":"Akşam vedalaşırken; 'akşamın iyi geçsin' anlamında."},"examples":[{"text":"Divertitevi alla festa. Buona serata!","tr":"Partide iyi eğlenin. İyi akşamlar!"}]},
  {"id":"it-daily-buon-fine-settimana","languageId":"it","category":"daily","level":"A1","sourceText":"Buon fine settimana!","translations":{"tr":["iyi hafta sonları"]},"details":{"register":"neutral","context":"Cuma günü vedalaşırken; kısaca 'Buon weekend!'."},"examples":[{"text":"Ci vediamo lunedì. Buon fine settimana!","tr":"Pazartesi görüşürüz. İyi hafta sonları!"}]},
  {"id":"it-daily-buona-fortuna","languageId":"it","category":"daily","level":"A1","sourceText":"Buona fortuna!","translations":{"tr":["bol şans","iyi şanslar"]},"details":{"register":"neutral","context":"Sınav, mülakat gibi durumlardan önce."},"examples":[{"text":"Domani hai l'esame? Buona fortuna!","tr":"Yarın sınavın mı var? Bol şans!"}]},
  {"id":"it-daily-pronto","languageId":"it","category":"daily","level":"A1","sourceText":"Pronto?","translations":{"tr":["alo?"]},"details":{"register":"neutral","context":"Telefonu açarken."},"examples":[{"text":"Pronto? Chi parla?","tr":"Alo? Kim konuşuyor?"}]},
  {"id":"it-daily-ecco-a-lei-ecco-a-te","languageId":"it","category":"daily","level":"A1","sourceText":"Ecco a Lei / Ecco a te","translations":{"tr":["buyurun","buyur"]},"details":{"register":"neutral","context":"Bir şeyi uzatırken; dükkânda, barda çok sık."},"examples":[{"text":"Un cappuccino? Ecco a Lei.","tr":"Bir kapuçino mu? Buyurun."}]},
  {"id":"it-daily-che-bello","languageId":"it","category":"daily","level":"A1","sourceText":"Che bello!","translations":{"tr":["ne güzel!","harika!"]},"details":{"register":"neutral","context":"Sevinç ya da beğeni bildirirken."},"examples":[{"text":"Andiamo al mare domenica? Che bello!","tr":"Pazar denize mi gidiyoruz? Ne güzel!"}]},
  {"id":"it-daily-che-buono","languageId":"it","category":"daily","level":"A1","sourceText":"Che buono!","translations":{"tr":["ne lezzetli!","çok güzel olmuş!"]},"details":{"register":"neutral","context":"Yemeğin tadını beğenince."},"examples":[{"text":"Che buono questo tiramisù!","tr":"Bu tiramisu ne lezzetli!"}]},
  {"id":"it-daily-che-caldo-che-freddo","languageId":"it","category":"daily","level":"A1","sourceText":"Che caldo! / Che freddo!","translations":{"tr":["ne sıcak!","ne soğuk!"]},"details":{"register":"neutral","context":"Hava ya da ortam hakkında yakınırken."},"examples":[{"text":"Che caldo oggi! Apriamo la finestra.","tr":"Bugün ne sıcak! Pencereyi açalım."}]},
  {"id":"it-daily-mi-dispiace","languageId":"it","category":"daily","level":"A1","sourceText":"Mi dispiace","translations":{"tr":["üzgünüm","kusura bakma"]},"details":{"register":"neutral","context":"Özür dilerken ya da üzüntü paylaşırken."},"examples":[{"text":"Mi dispiace, non posso venire.","tr":"Üzgünüm, gelemem."}]},
  {"id":"it-daily-nessun-problema","languageId":"it","category":"daily","level":"A1","sourceText":"Nessun problema","translations":{"tr":["sorun değil","problem yok"]},"details":{"register":"neutral","context":"Özre ya da ricaya rahat bir cevap."},"examples":[{"text":"Scusa il ritardo. — Nessun problema!","tr":"Geciktiğim için kusura bakma. — Sorun değil!"}]},
  {"id":"it-daily-aiuto","languageId":"it","category":"daily","level":"A1","sourceText":"Aiuto!","translations":{"tr":["imdat!","yardım edin!"]},"details":{"register":"neutral","context":"Acil durumda bağırarak."},"examples":[{"text":"Aiuto! Qualcuno chiami un'ambulanza!","tr":"İmdat! Biri ambulans çağırsın!"}]},
  {"id":"it-daily-attenzione","languageId":"it","category":"daily","level":"A1","sourceText":"Attenzione!","translations":{"tr":["dikkat!"]},"details":{"register":"neutral","context":"Tehlike uyarısı; anonslarda da sık."},"examples":[{"text":"Attenzione! Il pavimento è bagnato.","tr":"Dikkat! Zemin ıslak."}]},
  {"id":"it-daily-andiamo","languageId":"it","category":"daily","level":"A1","sourceText":"Andiamo!","translations":{"tr":["hadi gidelim!","haydi!"]},"details":{"register":"neutral","context":"Birlikte yola çıkarken ya da harekete geçerken."},"examples":[{"text":"Sono già le nove, andiamo!","tr":"Saat dokuz olmuş bile, hadi gidelim!"}]},
  {"id":"it-daily-basta","languageId":"it","category":"daily","level":"A1","sourceText":"Basta!","translations":{"tr":["yeter!","kes!"]},"details":{"register":"neutral","context":"Bir şeyin durmasını isterken; sert olabilir."},"examples":[{"text":"Basta! Smettetela di litigare!","tr":"Yeter! Kavga etmeyi kesin!"}]},
  {"id":"it-daily-perfetto","languageId":"it","category":"daily","level":"A1","sourceText":"Perfetto!","translations":{"tr":["mükemmel!","süper!","tamamdır"]},"details":{"register":"neutral","context":"Bir şeyin tam istendiği gibi olduğunu söylerken."},"examples":[{"text":"Ci vediamo alle sette? — Perfetto!","tr":"Yedide görüşelim mi? — Süper!"}]},
  {"id":"it-daily-bellissimo","languageId":"it","category":"daily","level":"A1","sourceText":"Bellissimo!","translations":{"tr":["çok güzel!","harika!"]},"details":{"register":"neutral","context":"Bir şeyi çok beğendiğinde."},"examples":[{"text":"Guarda che panorama! Bellissimo!","tr":"Şu manzaraya bak! Çok güzel!"}]},
  {"id":"it-daily-bravo-brava","languageId":"it","category":"daily","level":"A1","sourceText":"Bravo! / Brava!","translations":{"tr":["aferin!","bravo!"]},"details":{"register":"neutral","context":"Övgü; kadına 'brava', topluluğa 'bravi'."},"examples":[{"text":"Hai preso dieci? Brava!","tr":"On mu aldın? Aferin!"}]},
  {"id":"it-daily-tutto-bene","languageId":"it","category":"daily","level":"A1","sourceText":"Tutto bene?","translations":{"tr":["her şey yolunda mı?","iyi misin?"]},"details":{"register":"neutral","context":"Birinin durumunu ya da bir işi sorarken."},"examples":[{"text":"Sei pallido. Tutto bene?","tr":"Solgunsun. İyi misin?"}]},
  {"id":"it-daily-volentieri","languageId":"it","category":"daily","level":"A1","sourceText":"Volentieri!","translations":{"tr":["memnuniyetle!","seve seve!"]},"details":{"register":"neutral","context":"Bir daveti ya da teklifi isteyerek kabul ederken."},"examples":[{"text":"Vieni a cena da noi? — Volentieri!","tr":"Akşam yemeğine bize gelir misin? — Seve seve!"}]},
  {"id":"it-daily-un-attimo","languageId":"it","category":"daily","level":"A1","sourceText":"Un attimo!","translations":{"tr":["bir saniye!","bir dakika!"]},"details":{"register":"neutral","context":"Birinden kısa süre beklemesini isterken; 'Un momento' da denir."},"examples":[{"text":"Un attimo, arrivo subito!","tr":"Bir saniye, hemen geliyorum!"}]},
  {"id":"it-daily-aspetta","languageId":"it","category":"daily","level":"A1","sourceText":"Aspetta!","translations":{"tr":["bekle!","dur!"]},"details":{"register":"informal","context":"Birini durdururken; resmîde 'Aspetti!'."},"examples":[{"text":"Aspetta! Hai dimenticato le chiavi.","tr":"Bekle! Anahtarlarını unuttun."}]},
  {"id":"it-daily-scusi-dove-il-bagno","languageId":"it","category":"daily","level":"A1","sourceText":"Scusi, dov'è il bagno?","translations":{"tr":["affedersiniz, tuvalet nerede?"]},"details":{"register":"neutral","context":"Restoranda, barda tuvaleti sorarken."},"examples":[{"text":"Scusi, dov'è il bagno? — In fondo a destra.","tr":"Affedersiniz, tuvalet nerede? — En sonda, sağda."}]},
  {"id":"it-daily-mi-puo-aiutare","languageId":"it","category":"daily","level":"A1","sourceText":"Mi può aiutare?","translations":{"tr":["bana yardım edebilir misiniz?"]},"details":{"register":"formal","context":"Yabancı birinden kibarca yardım isterken."},"examples":[{"text":"Scusi, mi può aiutare? Non trovo la stazione.","tr":"Affedersiniz, bana yardım edebilir misiniz? İstasyonu bulamıyorum."}]},
  {"id":"it-daily-ho-capito","languageId":"it","category":"daily","level":"A1","sourceText":"Ho capito","translations":{"tr":["anladım","tamam"]},"details":{"register":"neutral","context":"Anladığını belirtirken; sohbette 'tamam' gibi de."},"examples":[{"text":"Gira a destra al semaforo. — Ho capito, grazie.","tr":"Işıktan sağa dön. — Anladım, teşekkürler."}]},
  {"id":"it-daily-come","languageId":"it","category":"daily","level":"A1","sourceText":"Come?","translations":{"tr":["efendim?","ne dedin?","nasıl?"]},"details":{"register":"neutral","context":"Duymadığında ya da şaşırdığında."},"examples":[{"text":"Come? Non ho sentito.","tr":"Efendim? Duymadım."}]},
  {"id":"it-daily-cosa","languageId":"it","category":"daily","level":"A1","sourceText":"Cosa?","translations":{"tr":["ne?"]},"details":{"register":"informal","context":"Duymadığında ya da şaşırdığında; 'Che cosa?' da denir."},"examples":[{"text":"Cosa? Ti sposi?!","tr":"Ne? Evleniyor musun?!"}]},
  {"id":"it-daily-davvero","languageId":"it","category":"daily","level":"A1","sourceText":"Davvero?","translations":{"tr":["gerçekten mi?","sahi mi?"]},"details":{"register":"neutral","context":"Şaşkınlık ya da ilgi bildirirken."},"examples":[{"text":"Ho trovato lavoro! — Davvero? Complimenti!","tr":"İş buldum! — Gerçekten mi? Tebrikler!"}]},
  {"id":"it-daily-mamma-mia","languageId":"it","category":"daily","level":"A1","sourceText":"Mamma mia!","translations":{"tr":["aman Allahım!","vay be!"]},"details":{"register":"informal","context":"Şaşkınlık, hayranlık ya da bıkkınlık anında."},"examples":[{"text":"Mamma mia, che traffico!","tr":"Aman Allahım, ne trafik!"}]},
