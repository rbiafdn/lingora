[
  {"id":"es-gr-ir-a-infinitivo","languageId":"es","category":"grammar","level":"A2","sourceText":"Ir a + infinitivo","translations":{"tr":["Ir a + Mastar (Yakın Gelecek)"]},"grammar":{"summary":"Ir a + mastar, planları, niyetleri ve belirtilere dayanan yakın gelecek tahminlerini anlatır.","uses":["Planlar ve niyetler (Voy a estudiar)","Kanıta dayalı tahmin (Va a llover)","Yakın gelecek"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"voy / vas / va / vamos / vais / van","en":"Ir (presente)","role":"a"},{"tr":"a","en":"a","role":"x"},{"tr":"Mastar","en":"Infinitivo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[x:Mañana] [a:voy] [x:a] [v:visitar] [o:a mis abuelos].","tr":"Yarın büyükannemle büyükbabamı ziyaret edeceğim."},{"text":"Mira esas nubes: [a:va] [x:a] [v:llover].","tr":"Şu bulutlara bak, yağmur yağacak."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no","en":"No","role":"x"},{"tr":"ir","en":"Ir","role":"a"},{"tr":"a","en":"a","role":"x"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"[s:Nosotros] [x:no] [a:vamos] [x:a] [v:salir] esta noche.","tr":"Bu akşam dışarı çıkmayacağız."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"ir","en":"Ir","role":"a"},{"tr":"a","en":"a","role":"x"},{"tr":"Mastar","en":"Infinitivo","role":"v"},{"tr":"Tümleç?","en":"Complemento","role":"o"}],"examples":[{"text":"¿[a:Vas] [x:a] [v:venir] [o:a la fiesta]?","tr":"Partiye gelecek misin?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"ir","en":"Ir","role":"a"},{"tr":"a","en":"a","role":"x"},{"tr":"Mastar?","en":"Infinitivo","role":"v"}],"examples":[{"text":"¿[q:Qué] [a:vas] [x:a] [v:hacer] el fin de semana?","tr":"Hafta sonu ne yapacaksın?"},{"text":"¿[q:Dónde] [a:vais] [x:a] [v:comer]?","tr":"Nerede yemek yiyeceksiniz?"}]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Sí / No","en":"Sí / No","role":"x"},{"tr":"(no) ir a + mastar","en":"Ir a + infinitivo","role":"a"}],"examples":[{"text":"—¿Vas a comprarlo? —Sí, [a:voy] [x:a] [v:comprarlo].","tr":"—Onu alacak mısın? —Evet, alacağım."}]}],"rules":["Sadece ir çekimlenir; ana fiil mastar hâlinde kalır.","a edatı unutulmamalıdır.","Nesne zamiri mastara bitişebilir ya da ir’den önce gelebilir: Lo voy a comprar / Voy a comprarlo."],"exceptions":["Konuşmada gelecek zaman yerine çok sık kullanılır."],"mistakes":[{"wrong":"Voy estudiar.","right":"Voy a estudiar.","note":"ir ile mastar arasında a gerekir."},{"wrong":"Va a lloviendo.","right":"Va a llover.","note":"a’dan sonra mastar gelir."},{"wrong":"Yo va a trabajar.","right":"Yo voy a trabajar.","note":"ir özneye göre çekilir."}]}},
  {"id":"es-gr-estar-gerundio","languageId":"es","category":"grammar","level":"A2","sourceText":"Estar + gerundio","translations":{"tr":["Estar + Gerundio (Şu An Süren Eylem)"]},"grammar":{"summary":"Estar + gerundio, konuşma anında süren ya da geçici olarak devam eden eylemleri anlatır.","uses":["Şu anda olan eylem (Estoy comiendo)","Bu günlerde süren geçici durum","Eylemin süregelen yönünü vurgulamak"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"estar","en":"Estar","role":"a"},{"tr":"Fiil -ando / -iendo","en":"Gerundio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Los niños] [a:están] [v:jugando] [o:en el parque].","tr":"Çocuklar parkta oynuyor."},{"text":"[a:Estoy] [v:escribiendo] [o:un correo].","tr":"Bir e-posta yazıyorum."}],"notes":["-ar → -ando (hablando); -er/-ir → -iendo (comiendo, viviendo)."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no","en":"No","role":"x"},{"tr":"estar","en":"Estar","role":"a"},{"tr":"Gerundio","en":"Gerundio","role":"v"}],"examples":[{"text":"[s:Ella] [x:no] [a:está] [v:trabajando] ahora.","tr":"O şu an çalışmıyor."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"estar","en":"Estar","role":"a"},{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"Gerundio?","en":"Gerundio","role":"v"}],"examples":[{"text":"¿[a:Estás] [v:durmiendo]?","tr":"Uyuyor musun?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"estar","en":"Estar","role":"a"},{"tr":"Gerundio?","en":"Gerundio","role":"v"}],"examples":[{"text":"¿[q:Qué] [a:estás] [v:haciendo]?","tr":"Ne yapıyorsun?"},{"text":"¿[q:Con quién] [a:está] [v:hablando]?","tr":"Kiminle konuşuyor?"}]}],"rules":["Gelecek planları için kullanılmaz; onun için presente veya ir a kullanılır.","Zamir gerundio’ya bitişebilir (estoy duchándome) ya da estar’dan önce gelir (me estoy duchando).","Alışkanlıklar için değil, presente için: Trabajo en un banco."],"exceptions":["Düzensiz gerundio: leer → leyendo, ir → yendo, dormir → durmiendo, pedir → pidiendo, decir → diciendo."],"mistakes":[{"wrong":"Estoy ir al cine mañana.","right":"Voy al cine mañana.","note":"Gelecek plan estar + gerundio ile söylenmez."},{"wrong":"Estoy comendo.","right":"Estoy comiendo.","note":"-er fiilleri -iendo alır."},{"wrong":"Estoy leiendo.","right":"Estoy leyendo.","note":"Ünlüden sonra -iendo → -yendo olur."}]}},
  {"id":"es-gr-preterito-perfecto-compuesto","languageId":"es","category":"grammar","level":"A2","sourceText":"Pretérito perfecto compuesto","translations":{"tr":["Yakın Geçmiş Zaman (Pretérito Perfecto)"]},"grammar":{"summary":"Pretérito perfecto, haber + geçmiş zaman ortacı ile kurulur ve şimdiye bağlı geçmiş deneyimleri anlatır.","uses":["Bugün, bu hafta, bu yıl gibi bitmemiş zaman dilimleri","Hayat deneyimleri (¿Has estado en México?)","ya, todavía no, nunca ile","Etkisi şimdi süren yakın olaylar"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"he / has / ha / hemos / habéis / han","en":"Haber","role":"a"},{"tr":"Fiil -ado / -ido","en":"Participio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[x:Hoy] [a:he] [v:trabajado] [o:mucho].","tr":"Bugün çok çalıştım."},{"text":"[s:Ana] [a:ha] [v:comido] [o:paella] muchas veces.","tr":"Ana birçok kez paella yedi."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no","en":"No","role":"x"},{"tr":"haber","en":"Haber","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"}],"examples":[{"text":"[x:Todavía no] [a:hemos] [v:terminado].","tr":"Henüz bitirmedik."},{"text":"[x:Nunca] [a:he] [v:estado] [o:en Perú].","tr":"Peru’da hiç bulunmadım."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"haber","en":"Haber","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç?","en":"Complemento","role":"o"}],"examples":[{"text":"¿[a:Has] [v:visto] [o:esta película]?","tr":"Bu filmi gördün mü?"},{"text":"¿[a:Habéis] [v:comido] [o:ya]?","tr":"Yemek yediniz mi?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"haber","en":"Haber","role":"a"},{"tr":"Ortaç?","en":"Participio","role":"v"}],"examples":[{"text":"¿[q:Qué] [a:has] [v:hecho] hoy?","tr":"Bugün ne yaptın?"},{"text":"¿[q:Dónde] [a:han] [v:puesto] las llaves?","tr":"Anahtarları nereye koydular?"}]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Sí / No","en":"Sí / No","role":"x"},{"tr":"(no) haber + ortaç","en":"Haber + participio","role":"a"}],"examples":[{"text":"—¿Has llamado a Luis? —Sí, ya lo [a:he] [v:llamado].","tr":"—Luis’i aradın mı? —Evet, aradım."},{"text":"—¿Has terminado? —[x:Todavía no].","tr":"—Bitirdin mi? —Henüz değil."}]}],"rules":["haber ile ortaç ayrılmaz; zamir ve no haber’den önce gelir: No lo he visto.","Ortaç bu yapıda değişmez (cinsiyet/sayı almaz): Ellas han llegado.","Latin Amerika’da bu zaman yerine çoğunlukla indefinido kullanılır."],"exceptions":["Düzensiz ortaçlar: hecho, dicho, visto, escrito, puesto, vuelto, abierto, roto, muerto."],"mistakes":[{"wrong":"He hacido los deberes.","right":"He hecho los deberes.","note":"hacer’in ortacı düzensizdir: hecho."},{"wrong":"Ella ha llegada.","right":"Ella ha llegado.","note":"haber ile ortaç değişmez."},{"wrong":"He lo visto.","right":"Lo he visto.","note":"Zamir haber’den önce gelir."}]}},
  {"id":"es-gr-preterito-indefinido-verbos-regulares","languageId":"es","category":"grammar","level":"A2","sourceText":"Pretérito indefinido: verbos regulares","translations":{"tr":["Belirli Geçmiş Zaman: Düzenli Fiiller"]},"grammar":{"summary":"Pretérito indefinido, geçmişte belirli bir zamanda başlayıp bitmiş eylemleri anlatır.","uses":["Belirli geçmiş zaman (ayer, el año pasado, en 2010)","Sırayla olan bitmiş olaylar","Biyografi ve hikâye anlatımı"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"-é / -aste / -ó / -amos / -asteis / -aron","en":"Indefinido (-ar)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[x:Ayer] [v:hablé] [o:con mi jefe].","tr":"Dün patronumla konuştum."},{"text":"[s:Ellos] [v:vivieron] [o:en Chile] dos años.","tr":"Şili’de iki yıl yaşadılar."}],"notes":["-er / -ir: -í, -iste, -ió, -imos, -isteis, -ieron."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no","en":"No","role":"x"},{"tr":"Fiil (indefinido)","en":"Verbo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Marta] [x:no] [v:llamó] [o:anoche].","tr":"Marta dün gece aramadı."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Fiil (indefinido)","en":"Verbo","role":"v"},{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"Tümleç?","en":"Complemento","role":"o"}],"examples":[{"text":"¿[v:Compraste] [o:el pan]?","tr":"Ekmeği aldın mı?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"Fiil (indefinido)","en":"Verbo","role":"v"},{"tr":"Özne?","en":"Sujeto","role":"s"}],"examples":[{"text":"¿[q:Cuándo] [v:llegaste]?","tr":"Ne zaman geldin?"},{"text":"¿[q:Dónde] [v:nacieron] [s:tus padres]?","tr":"Annenle baban nerede doğdu?"}]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Sí / No","en":"Sí / No","role":"x"},{"tr":"(no) + fiil","en":"Verbo","role":"v"}],"examples":[{"text":"—¿Viste a Luis? —Sí, lo [v:vi].","tr":"—Luis’i gördün mü? —Evet, gördüm."}]}],"rules":["1. ve 3. tekil şahısta vurgu işareti zorunludur: hablé, habló.","-ar fiillerinde nosotros biçimi presente ile aynıdır: hablamos (bağlamdan anlaşılır).","Zaman ifadeleri: ayer, anoche, el lunes pasado, hace dos años, en 2015."],"exceptions":["Yazım değişimi (yo): buscar → busqué, llegar → llegué, empezar → empecé.","leer, creer, oír: leyó, leyeron; creyó, creyeron."],"mistakes":[{"wrong":"Ayer he ido al cine.","right":"Ayer fui al cine.","note":"ayer gibi bitmiş zamanlarla indefinido kullanılır."},{"wrong":"Yo hable con él.","right":"Yo hablé con él.","note":"Vurgu işareti olmadan farklı bir biçim olur."},{"wrong":"Ella comío.","right":"Ella comió.","note":"-er / -ir fiillerinde 3. tekil eki -ió’dur."}]}},
  {"id":"es-gr-preterito-indefinido-verbos-irregulares","languageId":"es","category":"grammar","level":"A2","sourceText":"Pretérito indefinido: verbos irregulares","translations":{"tr":["Belirli Geçmiş Zaman: Düzensiz Fiiller"]},"grammar":{"summary":"Sık kullanılan birçok fiil indefinido’da düzensiz köke sahiptir ve vurgu işareti almaz.","uses":["Günlük geçmiş anlatımında en sık fiiller (fui, tuve, hice)","Hikâye ve biyografi","Belirli zamanda bitmiş eylemler"],"sections":[{"kind":"other","title":"ser / ir (aynı biçim)","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"fui / fuiste / fue / fuimos / fuisteis / fueron","en":"Ser / Ir","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Fui] [o:a Sevilla] en verano.","tr":"Yazın Sevilla’ya gittim."},{"text":"[s:La fiesta] [v:fue] [o:estupenda].","tr":"Parti harikaydı."}],"notes":["Anlam bağlamdan anlaşılır."]},{"kind":"other","title":"Düzensiz kök + -e, -iste, -o, -imos, -isteis, -ieron","formula":[{"tr":"tuv- / estuv- / pud- / pus- / hic- / quis- / vin- / sup-","en":"Raíz irregular","role":"v"},{"tr":"+ -e / -iste / -o…","en":"Terminación","role":"x"}],"examples":[{"text":"[x:Ayer] [v:tuve] [o:un examen].","tr":"Dün bir sınavım vardı."},{"text":"¿[q:Qué] [v:hiciste] ayer?","tr":"Ne yaptın?"}],"notes":["hacer 3. tekilde hizo olur."]},{"kind":"other","title":"j kökü: -eron","formula":[{"tr":"dij- / traj- / conduj-","en":"Raíz en j","role":"v"},{"tr":"+ -e / -iste / -o / -imos / -isteis / -eron","en":"Terminación","role":"x"}],"examples":[{"text":"[s:Ella] [v:dijo] [o:la verdad].","tr":"O doğruyu söyledi."},{"text":"[s:Ellos] [v:trajeron] [o:vino].","tr":"Onlar şarap getirdi."}],"notes":["j kökünden sonra 3. çoğul -eron olur, -ieron değil."]},{"kind":"other","title":"Kök değişimli -ir fiilleri (3. şahıs)","formula":[{"tr":"e → i / o → u","en":"Cambio vocálico","role":"v"},{"tr":"sadece él / ellos","en":"3.ª persona","role":"x"}],"examples":[{"text":"[s:Él] [v:pidió] [o:una pizza].","tr":"Bir pizza istedi."},{"text":"[s:Los niños] [v:durmieron] bien.","tr":"Çocuklar iyi uyudu."}]}],"rules":["Düzensiz kökler vurgu işareti almaz: tuve, hizo, vino.","ser ve ir indefinido’da aynı çekilir.","dar -er/-ir ekleri alır: di, diste, dio, dimos, disteis, dieron."],"exceptions":["haber’in indefinido biçimi hubo’dur: Hubo un accidente."],"mistakes":[{"wrong":"Yo hací la cena.","right":"Yo hice la cena.","note":"hacer düzensizdir: hice, hiciste, hizo."},{"wrong":"Ellos dijieron.","right":"Ellos dijeron.","note":"j kökünden sonra -eron gelir."},{"wrong":"Él tuvó suerte.","right":"Él tuvo suerte.","note":"Düzensiz kökler vurgu almaz."}]}},
  {"id":"es-gr-preterito-imperfecto","languageId":"es","category":"grammar","level":"A2","sourceText":"Pretérito imperfecto","translations":{"tr":["Hikâye Geçmiş Zaman (Pretérito Imperfecto)"]},"grammar":{"summary":"Imperfecto, geçmişteki alışkanlıkları, tasvirleri ve süren arka plan durumlarını anlatır.","uses":["Geçmişteki alışkanlıklar (-erdim)","Kişi, yer, durum tasviri","Geçmişte saat ve yaş","Bir olay olduğunda süren arka plan"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"-aba / -abas / -aba / -ábamos / -abais / -aban","en":"Imperfecto (-ar)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[x:De niño] [v:jugaba] [o:en la calle].","tr":"Çocukken sokakta oynardım."},{"text":"[s:Mi abuela] [v:vivía] [o:en un pueblo].","tr":"Büyükannem bir köyde yaşardı."}],"notes":["-er / -ir: -ía, -ías, -ía, -íamos, -íais, -ían."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no","en":"No","role":"x"},{"tr":"Fiil (imperfecto)","en":"Verbo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[x:Antes] [x:no] [v:comía] [o:pescado].","tr":"Eskiden balık yemezdim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Fiil (imperfecto)","en":"Verbo","role":"v"},{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"Tümleç?","en":"Complemento","role":"o"}],"examples":[{"text":"¿[v:Tenías] [o:perro] de pequeño?","tr":"Küçükken köpeğin var mıydı?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"Fiil (imperfecto)","en":"Verbo","role":"v"},{"tr":"Özne?","en":"Sujeto","role":"s"}],"examples":[{"text":"¿[q:Dónde] [v:trabajabas] antes?","tr":"Eskiden nerede çalışıyordun?"},{"text":"¿[q:Qué hora] [v:era]?","tr":"Saat kaçtı?"}]},{"kind":"other","title":"Sadece üç düzensiz fiil","formula":[{"tr":"ser: era… / ir: iba… / ver: veía…","en":"Imperfectos irregulares","role":"v"}],"examples":[{"text":"[x:Cuando] [v:era] joven, [v:iba] mucho al cine.","tr":"Gençken sinemaya çok giderdim."}]}],"rules":["Sadece ser, ir ve ver düzensizdir.","1. ve 3. tekil şahıs aynıdır: yo hablaba, él hablaba.","Zaman ifadeleri: antes, de niño, siempre, todos los días, a menudo."],"exceptions":["había (vardı) hay’in imperfecto biçimidir: Había mucha gente."],"mistakes":[{"wrong":"Cuando era niño, fui a la playa todos los veranos.","right":"Cuando era niño, iba a la playa todos los veranos.","note":"Tekrarlanan geçmiş alışkanlık imperfecto ile anlatılır."},{"wrong":"Yo eraba feliz.","right":"Yo era feliz.","note":"ser imperfecto’da düzensizdir."},{"wrong":"Nosotros hablabamos.","right":"Nosotros hablábamos.","note":"nosotros biçiminde vurgu işareti vardır."}]}},
  {"id":"es-gr-pronombres-de-objeto-directo","languageId":"es","category":"grammar","level":"A2","sourceText":"Pronombres de objeto directo","translations":{"tr":["Belirtili Nesne Zamirleri"]},"grammar":{"summary":"Lo, la, los, las gibi zamirler daha önce anılan nesnenin yerini alır ve çekimli fiilden önce gelir.","uses":["İsmi tekrar etmemek (¿El libro? Lo tengo.)","Kişiyi nesne olarak göstermek (Te quiero.)","Mastar, gerundio ve emirle birleşik kullanım"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"me / te / lo, la / nos / os / los, las","en":"Pronombre de objeto directo","role":"o"},{"tr":"Çekimli fiil","en":"Verbo conjugado","role":"v"}],"examples":[{"text":"—¿Dónde está el pan? —[o:Lo] [v:tengo] yo.","tr":"—Ekmek nerede? —Bende."},{"text":"[s:Ana] [o:me] [v:llama] cada día.","tr":"Ana beni her gün arar."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"no","en":"No","role":"x"},{"tr":"Nesne zamiri","en":"Pronombre OD","role":"o"},{"tr":"Çekimli fiil","en":"Verbo conjugado","role":"v"}],"examples":[{"text":"[x:No] [o:la] [v:conozco].","tr":"Onu (kadını) tanımıyorum."},{"text":"[x:No] [o:los] [v:he visto].","tr":"Onları görmedim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Nesne zamiri","en":"Pronombre OD","role":"o"},{"tr":"Çekimli fiil","en":"Verbo conjugado","role":"v"},{"tr":"Özne?","en":"Sujeto","role":"s"}],"examples":[{"text":"¿[o:Me] [v:oyes]?","tr":"Beni duyuyor musun?"},{"text":"¿[o:Lo] [v:compraste] [s:tú]?","tr":"Onu sen mi aldın?"}]},{"kind":"other","title":"Mastar / gerundio + zamir","formula":[{"tr":"Çekimli fiil","en":"Verbo conjugado","role":"a"},{"tr":"Mastar / gerundio + zamir (bitişik)","en":"Infinitivo / gerundio + pronombre","role":"v"}],"examples":[{"text":"[a:Quiero] [v:verla].","tr":"Onu görmek istiyorum."},{"text":"[a:Estoy] [v:leyéndolo].","tr":"Onu okuyorum."}],"notes":["Ya da zamir başa gelir: La quiero ver. / Lo estoy leyendo."]}],"rules":["Zamir çekimli fiilden önce, mastar/gerundio/olumlu emirde ise sonuna bitişik gelir.","lo eril, la dişil nesnenin yerini alır; nötr lo bir fikrin yerini de alabilir: No lo sé.","Kişi nesneleri önünde a gelir: Veo a María → La veo."],"exceptions":["İspanya’nın bazı bölgelerinde erkek kişi için lo yerine le kullanılır (leísmo): Le veo."],"mistakes":[{"wrong":"Yo veo lo.","right":"Yo lo veo.","note":"Zamir çekimli fiilden önce gelir."},{"wrong":"La compré (el libro).","right":"Lo compré.","note":"Zamir ismin cinsiyetine uyar."},{"wrong":"Quiero lo comprar.","right":"Quiero comprarlo. / Lo quiero comprar.","note":"Zamir mastara bitişir ya da en başa gelir."}]}},
  {"id":"es-gr-pronombres-de-objeto-indirecto","languageId":"es","category":"grammar","level":"A2","sourceText":"Pronombres de objeto indirecto","translations":{"tr":["Yönelme Nesne Zamirleri ve Birleşik Zamirler"]},"grammar":{"summary":"Me, te, le, nos, os, les eylemin kime yapıldığını gösterir; iki zamir yan yana gelince le/les → se olur.","uses":["Birine bir şey vermek, söylemek, göndermek","gustar tipi fiiller","Doğrudan ve dolaylı nesneyi birlikte kullanmak (se lo doy)"],"sections":[{"kind":"other","title":"Dolaylı zamir + fiil","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"me / te / le / nos / os / les","en":"Pronombre de objeto indirecto","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Doğrudan nesne","en":"Objeto directo","role":"x"}],"examples":[{"text":"[s:Mi madre] [o:me] [v:regaló] [x:un reloj].","tr":"Annem bana bir saat hediye etti."},{"text":"[o:Les] [v:escribo] [x:un mensaje] a mis amigos.","tr":"Arkadaşlarıma bir mesaj yazıyorum."}],"notes":["le / les ile sık sık a + kişi de eklenir."]},{"kind":"other","title":"Dolaylı + doğrudan zamir","formula":[{"tr":"Dolaylı zamir","en":"Pronombre OI","role":"o"},{"tr":"Doğrudan zamir","en":"Pronombre OD","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"—¿Me dejas el libro? —Sí, [o:te] [o:lo] [v:dejo].","tr":"—Kitabı bana ödünç verir misin? —Evet, veririm."}],"notes":["Sıra her zaman: dolaylı + doğrudan."]},{"kind":"other","title":"le / les + lo → se lo","formula":[{"tr":"se (le / les yerine)","en":"Se","role":"o"},{"tr":"lo / la / los / las","en":"Pronombre OD","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"—¿Le diste las llaves a Juan? —Sí, [o:se] [o:las] [v:di].","tr":"—Anahtarları Juan’a verdin mi? —Evet, verdim."}]},{"kind":"other","title":"Mastarla birleşik yazım","formula":[{"tr":"Çekimli fiil","en":"Verbo conjugado","role":"a"},{"tr":"Mastar + se + lo","en":"Infinitivo + pronombres","role":"v"}],"examples":[{"text":"[a:Voy a] [v:dárselo] mañana.","tr":"Onu ona yarın vereceğim."}],"notes":["İki zamir eklenince vurgu işareti gerekir: dárselo, explícamelo."]}],"rules":["Dolaylı zamir doğrudan zamirden önce gelir: me lo, te la, nos los.","le lo / les la denmez; se lo / se la olur.","se birden çok kişiyi gösterebileceği için gerekirse a él, a ella, a usted eklenir."],"exceptions":["Tekrarlanan dolaylı zamir normaldir: Le di el regalo a Ana (hem le hem a Ana)."],"mistakes":[{"wrong":"Le lo doy.","right":"Se lo doy.","note":"le + lo birleşimi se lo olur."},{"wrong":"Lo te digo.","right":"Te lo digo.","note":"Dolaylı zamir önce gelir."},{"wrong":"Dí el libro a ella.","right":"Le di el libro (a ella).","note":"Dolaylı nesne zamiri genelde kullanılır; di vurgu almaz."}]}},
  {"id":"es-gr-comparativos-y-superlativos","languageId":"es","category":"grammar","level":"A2","sourceText":"Comparativos y superlativos","translations":{"tr":["Karşılaştırma ve Üstünlük"]},"grammar":{"summary":"Más / menos … que ile üstünlük, tan … como ile eşitlik, el más … ile en üstünlük anlatılır.","uses":["İki şeyi karşılaştırmak","Eşitlik bildirmek","Bir grubun en … olanını söylemek","Mutlak üstünlük (-ísimo)"],"sections":[{"kind":"other","title":"Üstünlük / eksiklik","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"más / menos","en":"Más / menos","role":"x"},{"tr":"Sıfat / isim / zarf","en":"Adjetivo","role":"o"},{"tr":"que","en":"Que","role":"x"},{"tr":"İkinci terim","en":"Segundo término","role":"s"}],"examples":[{"text":"[s:Madrid] [v:es] [x:más] [o:grande] [x:que] [s:Sevilla].","tr":"Madrid Sevilla’dan daha büyük."},{"text":"[s:Este móvil] [v:es] [x:menos] [o:caro] [x:que] [s:ese].","tr":"Bu telefon şundan daha ucuz."}]},{"kind":"other","title":"Eşitlik","formula":[{"tr":"tan + sıfat / zarf","en":"Tan","role":"x"},{"tr":"tanto/a/os/as + isim","en":"Tanto","role":"x"},{"tr":"como","en":"Como","role":"x"}],"examples":[{"text":"[s:Luis] [v:es] [x:tan] [o:alto] [x:como] [s:su padre].","tr":"Luis babası kadar uzun."},{"text":"[v:Tengo] [x:tantos] [o:libros] [x:como] [s:tú].","tr":"Senin kadar kitabım var."}],"notes":["Fiille: Trabajo tanto como tú."]},{"kind":"other","title":"Üstünlük derecesi (en …)","formula":[{"tr":"el / la / los / las","en":"Artículo","role":"x"},{"tr":"(isim)","en":"Sustantivo","role":"o"},{"tr":"más / menos + sıfat","en":"Más + adjetivo","role":"x"},{"tr":"de + grup","en":"de","role":"x"}],"examples":[{"text":"Es [x:el] [o:edificio] [x:más alto] [x:de] la ciudad.","tr":"Şehrin en yüksek binası."},{"text":"Ana es [x:la más] simpática [x:de] la clase.","tr":"Ana sınıfın en sempatiği."}],"notes":["Grup belirtirken de kullanılır, en değil."]},{"kind":"other","title":"Düzensiz biçimler ve -ísimo","formula":[{"tr":"mejor / peor / mayor / menor","en":"Comparativos irregulares","role":"x"},{"tr":"Sıfat + -ísimo","en":"Superlativo absoluto","role":"o"}],"examples":[{"text":"Este café es [x:mejor] que el otro.","tr":"Bu kahve diğerinden daha iyi."},{"text":"La película es [o:buenísima].","tr":"Film çok çok iyi."}]}],"rules":["más bueno / más malo yerine mejor / peor kullanılır.","mayor / menor yaş için kullanılır: mi hermano mayor.","Sayılarla más de kullanılır: Tengo más de cien libros."],"exceptions":["-ísimo eklerken yazım değişir: rico → riquísimo, largo → larguísimo."],"mistakes":[{"wrong":"Es más bueno que el otro.","right":"Es mejor que el otro.","note":"bueno’nun karşılaştırması mejor’dur."},{"wrong":"Es tan alto que su padre.","right":"Es tan alto como su padre.","note":"Eşitlikte como kullanılır."},{"wrong":"el más alto en la clase","right":"el más alto de la clase","note":"Üstünlükte grup de ile verilir."}]}},
  {"id":"es-gr-imperativo-afirmativo","languageId":"es","category":"grammar","level":"A2","sourceText":"Imperativo afirmativo","translations":{"tr":["Olumlu Emir Kipi"]},"grammar":{"summary":"Olumlu imperativo emir, talimat, öneri ve rica için kullanılır; tú biçimi çoğunlukla presente’nin él biçimidir.","uses":["Talimat ve tarif (Corta la cebolla)","Rica ve öneri (Pasa, por favor)","Yol tarifi (Gira a la derecha)","Resmî hitap (usted, ustedes)"],"sections":[{"kind":"affirmative","title":"tú / vosotros","formula":[{"tr":"tú: presente él biçimi","en":"Imperativo (tú)","role":"v"},{"tr":"vosotros: mastar -r → -d","en":"Imperativo (vosotros)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Habla] [o:más despacio], por favor.","tr":"Lütfen daha yavaş konuş."},{"text":"[v:Abrid] [o:los libros].","tr":"Kitaplarınızı açın."}]},{"kind":"affirmative","title":"usted / ustedes","formula":[{"tr":"usted: -ar → -e, -er/-ir → -a","en":"Imperativo (usted)","role":"v"},{"tr":"ustedes: -en / -an","en":"Imperativo (ustedes)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Pase] [o:por aquí], señora.","tr":"Buradan buyurun, hanımefendi."},{"text":"[v:Escriban] [o:su nombre].","tr":"Adınızı yazın."}],"notes":["usted biçimi presente de subjuntivo ile aynıdır."]},{"kind":"other","title":"Düzensiz tú biçimleri","formula":[{"tr":"di / haz / ve / pon / sal / sé / ten / ven","en":"Imperativos irregulares","role":"v"}],"examples":[{"text":"[v:Ven] [o:aquí].","tr":"Buraya gel."},{"text":"[v:Haz] [o:los deberes].","tr":"Ödevini yap."},{"text":"[v:Ten] cuidado.","tr":"Dikkat et."}]},{"kind":"other","title":"Emir + zamir (bitişik)","formula":[{"tr":"Emir","en":"Imperativo","role":"v"},{"tr":"+ me / te / lo / se…","en":"Pronombres enclíticos","role":"o"}],"examples":[{"text":"[v:Dímelo].","tr":"Bana onu söyle."},{"text":"[v:Siéntese], por favor.","tr":"Oturun lütfen."}],"notes":["Zamir eklenince vurgu işareti gerekebilir: compra → cómpralo."]}],"rules":["Olumlu emirde zamirler fiilin sonuna bitişik yazılır.","vosotros dönüşlü fiillerde -d düşer: sentad + os → sentaos.","nosotros için \"hadi …\" anlamında: Vamos / Hablemos."],"exceptions":["ir’in vosotros biçimi id, dönüşlü hâli idos (konuşmada iros da duyulur)."],"mistakes":[{"wrong":"Me dime.","right":"Dime.","note":"Olumlu emirde zamir fiile bitişir."},{"wrong":"Hace los deberes.","right":"Haz los deberes.","note":"hacer’in tú emri haz’dır."},{"wrong":"Venga aquí, Juan (arkadaşa).","right":"Ven aquí, Juan.","note":"Samimi hitapta tú biçimi kullanılır."}]}},
  {"id":"es-gr-expresar-obligacion-tener-que-hay-que-deber","languageId":"es","category":"grammar","level":"A2","sourceText":"Expresar obligación: tener que, hay que, deber","translations":{"tr":["Zorunluluk: Tener que, Hay que, Deber"]},"grammar":{"summary":"Tener que kişisel zorunluluğu, hay que genel zorunluluğu, deber ise görev ve tavsiyeyi anlatır.","uses":["Kişisel zorunluluk (Tengo que irme)","Genel kural (Hay que reciclar)","Ahlaki görev ve tavsiye (Debes descansar)"],"sections":[{"kind":"affirmative","title":"Tener que + mastar","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"tener (çekimli)","en":"Tener","role":"a"},{"tr":"que","en":"Que","role":"x"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"[x:Mañana] [a:tengo] [x:que] [v:trabajar].","tr":"Yarın çalışmam gerekiyor."},{"text":"[s:Ellos] [a:tienen] [x:que] [v:estudiar] más.","tr":"Daha çok çalışmaları lazım."}]},{"kind":"other","title":"Hay que + mastar (kişisiz)","formula":[{"tr":"hay que","en":"Hay que","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[a:Hay que] [v:llevar] [o:pasaporte].","tr":"Pasaport taşımak gerekir."}],"notes":["Özne yoktur; herkes için genel bir gereklilik anlatır."]},{"kind":"other","title":"Deber + mastar","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"deber (çekimli)","en":"Deber","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"[s:Tú] [a:debes] [v:dormir] más.","tr":"Daha çok uyumalısın."},{"text":"[a:Deberías] [v:llamarla].","tr":"Onu aramalısın (bence)."}],"notes":["deberías (condicional) daha kibar bir tavsiyedir."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"no","en":"No","role":"x"},{"tr":"tener que / hay que / deber","en":"Obligación","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"[x:No] [a:tienes que] [v:venir].","tr":"Gelmek zorunda değilsin."},{"text":"[x:No] [a:debes] [v:fumar] aquí.","tr":"Burada sigara içmemelisin."}],"notes":["no tener que = gerek yok; no deber = yasak / yapmamalısın."]}],"rules":["tener que ve hay que’den sonra que unutulmaz.","hay que çekimlenmez ve özne almaz.","deber’den sonra que gelmez: Debes estudiar."],"exceptions":["deber de + mastar tahmin anlatır: Debe de ser tarde. (Geç olmalı.)"],"mistakes":[{"wrong":"Tengo estudiar.","right":"Tengo que estudiar.","note":"tener ile mastar arasında que gerekir."},{"wrong":"Debes que ir.","right":"Debes ir.","note":"deber’den sonra que kullanılmaz."},{"wrong":"Hay que tú estudies.","right":"Tienes que estudiar.","note":"hay que kişiye yönelik kullanılmaz."}]}},
  {"id":"es-gr-por-y-para","languageId":"es","category":"grammar","level":"A2","sourceText":"Por y para","translations":{"tr":["Por ve Para"]},"grammar":{"summary":"Para amaç, hedef ve alıcıyı; por ise sebep, yol, değiş-tokuş ve zaman aralığını anlatır.","uses":["para: amaç, yön, alıcı, son tarih","por: sebep, yer içinden geçme, araç, değiş-tokuş, fiyat","Kalıplar: por favor, por eso, para siempre"],"sections":[{"kind":"other","title":"para + amaç / alıcı","formula":[{"tr":"para","en":"Para","role":"x"},{"tr":"Mastar / kişi / yer / tarih","en":"Finalidad / destinatario","role":"o"}],"examples":[{"text":"Estudio español [x:para] [o:trabajar en Madrid].","tr":"Madrid’de çalışmak için İspanyolca öğreniyorum."},{"text":"Este regalo es [x:para] [o:ti].","tr":"Bu hediye senin için."},{"text":"Salgo [x:para] [o:Valencia].","tr":"Valensiya’ya doğru yola çıkıyorum."}]},{"kind":"other","title":"por + sebep","formula":[{"tr":"por","en":"Por","role":"x"},{"tr":"Sebep","en":"Causa","role":"o"}],"examples":[{"text":"Gracias [x:por] [o:tu ayuda].","tr":"Yardımın için teşekkürler."},{"text":"No salimos [x:por] [o:la lluvia].","tr":"Yağmur yüzünden çıkmadık."}]},{"kind":"other","title":"por + yer / zaman / araç","formula":[{"tr":"por","en":"Por","role":"x"},{"tr":"Yer / zaman dilimi / araç","en":"Lugar / tiempo / medio","role":"o"}],"examples":[{"text":"Paseamos [x:por] [o:el parque].","tr":"Parkta dolaştık."},{"text":"Trabajo [x:por] [o:la mañana].","tr":"Sabahları çalışırım."},{"text":"Te llamo [x:por] [o:teléfono].","tr":"Seni telefonla ararım."}]},{"kind":"other","title":"por + değiş-tokuş / fiyat","formula":[{"tr":"por","en":"Por","role":"x"},{"tr":"Karşılık / fiyat","en":"Intercambio / precio","role":"o"}],"examples":[{"text":"Lo compré [x:por] [o:diez euros].","tr":"Onu on avroya aldım."},{"text":"¿Cambias tu libro [x:por] [o:el mío]?","tr":"Kitabını benimkiyle değişir misin?"}]}],"rules":["Amaç (-mek için) → para + mastar.","Sebep (yüzünden, -dığı için) → por.","Son tarih → para: para el lunes; yaklaşık zaman → por: por la tarde."],"exceptions":["Edilgen yapıda yapan kişi por ile verilir: escrito por Cervantes."],"mistakes":[{"wrong":"Gracias para todo.","right":"Gracias por todo.","note":"Teşekkürün sebebi por ile verilir."},{"wrong":"Estudio por aprender.","right":"Estudio para aprender.","note":"Amaç para ile verilir."},{"wrong":"Trabajo en la mañana.","right":"Trabajo por la mañana.","note":"Günün bölümleri por la mañana / tarde / noche ile söylenir."}]}},
  {"id":"es-gr-indefinidos-y-negacion","languageId":"es","category":"grammar","level":"A2","sourceText":"Indefinidos y negación","translations":{"tr":["Belgisiz Sözcükler ve Olumsuzluk"]},"grammar":{"summary":"Algo, alguien, algún gibi sözcüklerin olumsuz karşılıkları nada, nadie, ningún’dür; İspanyolcada çift olumsuzluk doğrudur.","uses":["Belirsiz şey ve kişi (algo, alguien)","Hiçbir şey / kimse (nada, nadie)","Asla, hiç (nunca, jamás)","Ne … ne de (ni … ni)"],"sections":[{"kind":"other","title":"Olumlu belgisizler","formula":[{"tr":"algo / alguien / algún, alguna / siempre / también","en":"Indefinidos","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"¿[v:Quieres] [o:algo]?","tr":"Bir şey ister misin?"},{"text":"[o:Alguien] [v:llama] a la puerta.","tr":"Kapıyı biri çalıyor."}]},{"kind":"negative","title":"no + fiil + olumsuz sözcük","formula":[{"tr":"no","en":"No","role":"x"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"nada / nadie / ningún / nunca / tampoco","en":"Palabra negativa","role":"o"}],"examples":[{"text":"[x:No] [v:veo] [o:a nadie].","tr":"Kimseyi görmüyorum."},{"text":"[x:No] [v:tengo] [o:ningún problema].","tr":"Hiçbir sorunum yok."}],"notes":["Türkçedeki gibi çift olumsuzluk doğrudur."]},{"kind":"other","title":"Olumsuz sözcük fiilden önce (no’suz)","formula":[{"tr":"nada / nadie / nunca / tampoco","en":"Palabra negativa","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"[o:Nadie] [v:sabe] la respuesta.","tr":"Cevabı kimse bilmiyor."},{"text":"[o:Nunca] [v:bebo] alcohol.","tr":"Asla alkol içmem."}],"notes":["Olumsuz sözcük fiilden önceyse no kullanılmaz."]},{"kind":"other","title":"ni … ni","formula":[{"tr":"no + fiil","en":"No + verbo","role":"v"},{"tr":"ni … ni …","en":"Ni … ni","role":"x"}],"examples":[{"text":"[v:No como] [x:ni] carne [x:ni] pescado.","tr":"Ne et ne de balık yerim."}]}],"rules":["alguno → algún, ninguno → ningún eril tekil isimden önce kısalır.","ninguno genelde tekil kullanılır: No tengo ningún amigo aquí.","Kişi nesnesinde a eklenir: ¿Conoces a alguien?"],"exceptions":["nada \"hiç\" anlamında zarf olarak da kullanılır: No es nada fácil."],"mistakes":[{"wrong":"Nadie no viene.","right":"Nadie viene. / No viene nadie.","note":"Olumsuz sözcük fiilden önceyse no eklenmez."},{"wrong":"No tengo ningunos libros.","right":"No tengo ningún libro.","note":"ninguno genelde tekildir."},{"wrong":"Veo nada.","right":"No veo nada.","note":"Olumsuz sözcük fiilden sonraysa no gerekir."}]}}
]
