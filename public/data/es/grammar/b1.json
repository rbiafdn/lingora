[
  {"id":"es-gr-preterito-indefinido-y-preterito-imperfecto","languageId":"es","category":"grammar","level":"B1","sourceText":"Pretérito indefinido y pretérito imperfecto","translations":{"tr":["Indefinido ve Imperfecto Farkı"]},"grammar":{"summary":"Indefinido olayı tamamlanmış bir an olarak, imperfecto ise arka plan, tasvir ve süreç olarak anlatır.","uses":["Hikâyede olaylar → indefinido","Hikâyede sahne ve tasvir → imperfecto","Süren eylemi kesen olay","Alışkanlık (imperfecto) ↔ tek seferlik olay (indefinido)"],"sections":[{"kind":"other","title":"Arka plan + kesen olay","formula":[{"tr":"Imperfecto (süren durum)","en":"Pretérito imperfecto","role":"v"},{"tr":"cuando","en":"Cuando","role":"x"},{"tr":"Indefinido (olay)","en":"Pretérito indefinido","role":"v"}],"examples":[{"text":"[v:Dormía] [x:cuando] [v:sonó] el teléfono.","tr":"Telefon çaldığında uyuyordum."},{"text":"[v:Llovía] y no [v:salimos].","tr":"Yağmur yağıyordu ve çıkmadık."}]},{"kind":"other","title":"Tasvir ↔ olay","formula":[{"tr":"Imperfecto: era, había, hacía…","en":"Descripción","role":"v"},{"tr":"Indefinido: llegó, abrió, vio…","en":"Acción","role":"v"}],"examples":[{"text":"[v:Era] de noche y [v:hacía] frío. De repente [v:apareció] un perro.","tr":"Geceydi ve hava soğuktu. Birden bir köpek çıktı."}]},{"kind":"other","title":"Alışkanlık ↔ tek sefer","formula":[{"tr":"Imperfecto: siempre, todos los días","en":"Hábito","role":"v"},{"tr":"Indefinido: un día, aquella vez","en":"Hecho puntual","role":"v"}],"examples":[{"text":"Siempre [v:íbamos] a la playa, pero ese verano [v:fuimos] a la montaña.","tr":"Hep plaja giderdik ama o yaz dağa gittik."}]},{"kind":"other","title":"Anlamı değişen fiiller","formula":[{"tr":"conocía / conocí, sabía / supe, quería / quise","en":"Cambio de significado","role":"v"}],"examples":[{"text":"[v:Conocí] a Ana en 2019. / Ya [v:conocía] a Ana.","tr":"Ana ile 2019’da tanıştım. / Ana’yı zaten tanıyordum."},{"text":"No [v:quiso] venir.","tr":"Gelmek istemedi (reddetti)."}]}],"rules":["Bitiş noktası belli, sayılabilir olaylar → indefinido: Estuve allí tres días.","Saat, yaş, hava ve duygu tasviri → imperfecto: Tenía diez años.","Bir hikâyede sahne imperfecto, olay örgüsü indefinido ile ilerler."],"exceptions":["Süre belirtilince durum fiilleri de indefinido olur: Fue un día precioso. / Estuvo enfermo una semana."],"mistakes":[{"wrong":"Cuando llegué, ella se duchó.","right":"Cuando llegué, ella se duchaba.","note":"Geldiğim anda süren eylem imperfecto ile anlatılır."},{"wrong":"Ayer hacía los deberes durante dos horas.","right":"Ayer hice los deberes durante dos horas.","note":"Süresi belli bitmiş eylem indefinido ile anlatılır."},{"wrong":"Cuando fui niño…","right":"Cuando era niño…","note":"Yaş ve dönem tasviri imperfecto ile yapılır."}]}},
  {"id":"es-gr-preterito-pluscuamperfecto","languageId":"es","category":"grammar","level":"B1","sourceText":"Pretérito pluscuamperfecto","translations":{"tr":["Miş’li Geçmiş Zaman (Pluscuamperfecto)"]},"grammar":{"summary":"Pluscuamperfecto, geçmişteki bir andan daha önce olmuş eylemi anlatır: había + geçmiş ortaç.","uses":["Geçmişteki bir olaydan daha önce olanı anlatmak","Sebep açıklamak (Estaba cansado porque había trabajado)","ya ve todavía no ile geçmiş deneyim"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"había / habías / había / habíamos / habíais / habían","en":"Haber (imperfecto)","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"Cuando llegué, [s:la película] ya [a:había] [v:empezado].","tr":"Vardığımda film çoktan başlamıştı."},{"text":"[s:Nosotros] [a:habíamos] [v:cenado] [o:antes].","tr":"Daha önce akşam yemeği yemiştik."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no","en":"No","role":"x"},{"tr":"había…","en":"Haber","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"}],"examples":[{"text":"[s:Yo] [x:nunca] [a:había] [v:visto] [o:el mar].","tr":"Daha önce hiç deniz görmemiştim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"había…","en":"Haber","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç?","en":"Complemento","role":"o"}],"examples":[{"text":"¿[a:Habías] [v:estado] [o:en Roma] antes?","tr":"Daha önce Roma’da bulunmuş muydun?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"había…","en":"Haber","role":"a"},{"tr":"Ortaç?","en":"Participio","role":"v"}],"examples":[{"text":"¿[q:Qué] [a:había] [v:pasado]?","tr":"Ne olmuştu?"}]}],"rules":["haber ile ortaç ayrılmaz; ortaç değişmez.","Daha sonraki olay genelde indefinido ile verilir: Cuando llegó, ya se habían ido.","Düzensiz ortaçlar aynıdır: hecho, dicho, visto, puesto."],"exceptions":[],"mistakes":[{"wrong":"Cuando llegué, la película ya empezó.","right":"Cuando llegué, la película ya había empezado.","note":"Daha önceki eylem pluscuamperfecto ile verilir."},{"wrong":"Había dicha la verdad.","right":"Había dicho la verdad.","note":"Ortaç değişmez."},{"wrong":"Ya lo habían hacido.","right":"Ya lo habían hecho.","note":"hacer’in ortacı hecho’dur."}]}},
  {"id":"es-gr-futuro-simple","languageId":"es","category":"grammar","level":"B1","sourceText":"Futuro simple","translations":{"tr":["Gelecek Zaman (Futuro Simple)"]},"grammar":{"summary":"Futuro simple, gelecek eylemleri, tahminleri, sözleri ve şimdiki zamanla ilgili olasılıkları anlatır.","uses":["Gelecek tahminleri (Mañana lloverá)","Söz ve kararlar (Te llamaré)","Şimdiki zaman hakkında tahmin (Serán las diez)","Si + presente ile koşul sonucu"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"Mastar + -é / -ás / -á / -emos / -éis / -án","en":"Futuro simple","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[x:El año que viene] [v:viajaré] [o:a México].","tr":"Gelecek yıl Meksika’ya seyahat edeceğim."},{"text":"[x:Mañana] [v:hará] [o:sol].","tr":"Yarın güneşli olacak."}],"notes":["Ekler tüm fiillerde aynıdır ve mastarın sonuna eklenir."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no","en":"No","role":"x"},{"tr":"Fiil (futuro)","en":"Verbo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[x:No] [v:llegaremos] [o:a tiempo].","tr":"Zamanında yetişemeyeceğiz."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Fiil (futuro)","en":"Verbo","role":"v"},{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"Tümleç?","en":"Complemento","role":"o"}],"examples":[{"text":"¿[v:Vendrás] [o:a mi boda]?","tr":"Düğünüme gelecek misin?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"Fiil (futuro)","en":"Verbo","role":"v"},{"tr":"Özne?","en":"Sujeto","role":"s"}],"examples":[{"text":"¿[q:Dónde] [v:estará] [s:mi móvil]?","tr":"Telefonum nerede acaba?"},{"text":"¿[q:Cuándo] [v:terminarás]?","tr":"Ne zaman bitireceksin?"}],"notes":["Şimdiki zamanla ilgili merak ve tahmin için de kullanılır."]},{"kind":"other","title":"Düzensiz kökler","formula":[{"tr":"tendr- / pondr- / saldr- / vendr- / podr- / sabr- / habr- / querr- / dir- / har-","en":"Raíces irregulares","role":"v"},{"tr":"+ -é / -ás / -á…","en":"Terminación","role":"x"}],"examples":[{"text":"[v:Tendré] tiempo el lunes.","tr":"Pazartesi vaktim olacak."},{"text":"Te lo [v:diré] mañana.","tr":"Sana yarın söyleyeceğim."}]}],"rules":["Ekler vurguludur: hablaré, hablarás (nosotros hariç: hablaremos).","Konuşmada planlar için genelde ir a + mastar tercih edilir.","Olasılık: Tendrá unos treinta años. (Otuz yaşlarında olmalı.)"],"exceptions":["hay → habrá: Mañana habrá mucha gente."],"mistakes":[{"wrong":"Yo teneré tiempo.","right":"Yo tendré tiempo.","note":"tener’in gelecek kökü tendr- dir."},{"wrong":"Mañana va a lloverá.","right":"Mañana lloverá. / Mañana va a llover.","note":"İki gelecek yapısı birbirine karıştırılmaz."},{"wrong":"Cuando llegarás, te llamo.","right":"Cuando llegues, te llamo.","note":"cuando + gelecek anlamında subjuntivo kullanılır."}]}},
  {"id":"es-gr-condicional-simple","languageId":"es","category":"grammar","level":"B1","sourceText":"Condicional simple","translations":{"tr":["Şart Kipi (Condicional Simple)"]},"grammar":{"summary":"Condicional simple, kibar ricaları, tavsiyeleri, hayalî durumları ve geçmişe göre geleceği anlatır.","uses":["Kibar rica (¿Podrías ayudarme?)","Tavsiye (Yo que tú, iría)","Hayalî durum ve istek (Me gustaría viajar)","Geçmişteki tahmin"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"Mastar + -ía / -ías / -ía / -íamos / -íais / -ían","en":"Condicional simple","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Yo] [v:viviría] [o:cerca del mar].","tr":"Deniz kenarında yaşardım."},{"text":"[o:Me] [v:gustaría] [o:un café].","tr":"Bir kahve rica ederim."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no","en":"No","role":"x"},{"tr":"Fiil (condicional)","en":"Verbo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Yo] [x:no] [v:diría] [o:eso].","tr":"Ben bunu söylemezdim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Fiil (condicional)","en":"Verbo","role":"v"},{"tr":"Mastar / tümleç?","en":"Complemento","role":"o"}],"examples":[{"text":"¿[v:Podrías] [o:cerrar la ventana]?","tr":"Pencereyi kapatabilir misin?"},{"text":"¿[v:Te importaría] [o:esperar un momento]?","tr":"Bir dakika beklemenin sakıncası var mı?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"Fiil (condicional)","en":"Verbo","role":"v"},{"tr":"Özne?","en":"Sujeto","role":"s"}],"examples":[{"text":"¿[q:Qué] [v:harías] [s:tú] en mi lugar?","tr":"Benim yerimde olsan ne yapardın?"}]},{"kind":"other","title":"Tavsiye kalıpları","formula":[{"tr":"Yo que tú / Yo en tu lugar","en":"Yo que tú","role":"x"},{"tr":"Fiil (condicional)","en":"Verbo","role":"v"}],"examples":[{"text":"[x:Yo que tú], [v:hablaría] con él.","tr":"Senin yerinde olsam onunla konuşurdum."},{"text":"[v:Deberías] [o:descansar].","tr":"Dinlenmelisin."}]}],"rules":["Ekler bütün fiillerde aynıdır; mastara eklenir.","Düzensiz kökler futuro ile aynıdır: tendría, podría, haría, diría, saldría.","Geçmişe göre gelecek: Dijo que vendría. (Geleceğini söyledi.)"],"exceptions":["hay → habría: Habría más gente si fuera gratis."],"mistakes":[{"wrong":"Me gustaba un café, por favor.","right":"Me gustaría un café, por favor.","note":"Kibar istek condicional ile yapılır."},{"wrong":"Yo poderia ayudarte.","right":"Yo podría ayudarte.","note":"poder’in kökü podr- dir."},{"wrong":"Si tengo dinero, compraría una casa.","right":"Si tuviera dinero, compraría una casa.","note":"Hayalî koşulda si’den sonra imperfecto de subjuntivo gelir (B2)."}]}},
  {"id":"es-gr-imperativo-negativo","languageId":"es","category":"grammar","level":"B1","sourceText":"Imperativo negativo","translations":{"tr":["Olumsuz Emir Kipi"]},"grammar":{"summary":"Olumsuz emir no + presente de subjuntivo ile kurulur; zamirler fiilden önce gelir.","uses":["Yasak ve uyarı (No toques eso)","Tavsiye (No te preocupes)","Resmî talimat (No fume aquí)"],"sections":[{"kind":"negative","title":"no + subjuntivo","formula":[{"tr":"no","en":"No","role":"x"},{"tr":"Presente de subjuntivo","en":"Presente de subjuntivo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[x:No] [v:hables] [o:tan alto].","tr":"Bu kadar yüksek sesle konuşma."},{"text":"[x:No] [v:comáis] [o:en clase].","tr":"Sınıfta yemek yemeyin."}]},{"kind":"negative","title":"no + zamir + fiil","formula":[{"tr":"no","en":"No","role":"x"},{"tr":"Zamir","en":"Pronombre","role":"o"},{"tr":"Subjuntivo","en":"Presente de subjuntivo","role":"v"}],"examples":[{"text":"[x:No] [o:te] [v:preocupes].","tr":"Merak etme."},{"text":"[x:No] [o:se lo] [v:digas] a nadie.","tr":"Bunu kimseye söyleme."}],"notes":["Olumlu emrin aksine zamir fiile bitişmez."]},{"kind":"other","title":"Olumlu ↔ olumsuz","formula":[{"tr":"Olumlu: Hazlo / Siéntate","en":"Imperativo afirmativo","role":"v"},{"tr":"Olumsuz: No lo hagas / No te sientes","en":"Imperativo negativo","role":"v"}],"examples":[{"text":"[v:Cómpralo]. / [x:No] [o:lo] [v:compres].","tr":"Onu al. / Onu alma."},{"text":"[v:Venid]. / [x:No] [v:vengáis].","tr":"Gelin. / Gelmeyin."}]},{"kind":"other","title":"Resmî: usted / ustedes","formula":[{"tr":"no","en":"No","role":"x"},{"tr":"usted / ustedes biçimi","en":"Imperativo (usted)","role":"v"}],"examples":[{"text":"[x:No] [v:fume] aquí, por favor.","tr":"Lütfen burada sigara içmeyin."},{"text":"[x:No] [v:olviden] sus maletas.","tr":"Valizlerinizi unutmayın."}]}],"rules":["Bütün kişilerde olumsuz emir subjuntivo ile kurulur: no hables, no hable, no habléis, no hablen.","Zamirler no ile fiil arasına girer.","Düzensiz subjuntivo kökleri aynen geçerlidir: no hagas, no vayas, no seas, no pongas."],"exceptions":[],"mistakes":[{"wrong":"No habla tan alto.","right":"No hables tan alto.","note":"Olumsuz emirde subjuntivo kullanılır."},{"wrong":"No dímelo.","right":"No me lo digas.","note":"Olumsuz emirde zamir fiilden önce gelir."},{"wrong":"No ve allí.","right":"No vayas allí.","note":"ir’in olumsuz emri no vayas’tır."}]}},
  {"id":"es-gr-presente-de-subjuntivo-formas","languageId":"es","category":"grammar","level":"B1","sourceText":"Presente de subjuntivo: formas","translations":{"tr":["Dilek-Şart Kipi Şimdiki Zaman: Çekim"]},"grammar":{"summary":"Presente de subjuntivo, ünlü değişimiyle kurulur: -ar fiilleri -e, -er/-ir fiilleri -a alır.","uses":["İstek, duygu, şüphe ve amaç yan cümleleri","Olumsuz emir ve usted emirleri","ojalá, cuando, para que gibi kalıplar"],"sections":[{"kind":"other","title":"Düzenli çekim","formula":[{"tr":"yo biçiminin kökü (habl-o → habl-)","en":"Raíz de la 1.ª persona","role":"v"},{"tr":"-ar → -e, -es, -e, -emos, -éis, -en","en":"Terminación -ar","role":"x"},{"tr":"-er/-ir → -a, -as, -a, -amos, -áis, -an","en":"Terminación -er/-ir","role":"x"}],"examples":[{"text":"Quiero que [v:hables] con él.","tr":"Onunla konuşmanı istiyorum."},{"text":"Espero que [v:comáis] bien.","tr":"Umarım iyi yersiniz."}],"notes":["\"Zıt ünlü\" kuralı: -ar fiilleri e alır, -er / -ir fiilleri a alır."]},{"kind":"other","title":"yo biçimi düzensiz olanlar","formula":[{"tr":"teng- / hag- / pong- / salg- / veng- / dig- / conozc-","en":"Raíz irregular de yo","role":"v"},{"tr":"+ -a, -as, -a…","en":"Terminación","role":"x"}],"examples":[{"text":"Es necesario que [v:tengas] paciencia.","tr":"Sabırlı olman gerekiyor."},{"text":"Ojalá [v:venga] pronto.","tr":"Umarım yakında gelir."}]},{"kind":"other","title":"Kök değişimli fiiller","formula":[{"tr":"quiera / pueda / pida / duerma (nosotros: durmamos)","en":"Diptongo","role":"v"}],"examples":[{"text":"No creo que [v:pueda] venir.","tr":"Gelebileceğini sanmıyorum."},{"text":"Ojalá [v:durmamos] bien.","tr":"Umarım iyi uyuruz."}]},{"kind":"other","title":"Tamamen düzensiz","formula":[{"tr":"ser: sea / estar: esté / ir: vaya / haber: haya / saber: sepa / dar: dé","en":"Subjuntivos irregulares","role":"v"}],"examples":[{"text":"Espero que [v:sea] verdad.","tr":"Umarım doğrudur."},{"text":"Quiero que [v:vayas] conmigo.","tr":"Benimle gelmeni istiyorum."}]}],"rules":["Kök, presente’nin yo biçiminden alınır: hago → haga, conozco → conozca.","Yazım değişir: buscar → busque, llegar → llegue, empezar → empiece.","Kalıp: ana cümle + que + farklı özneli yan cümle (subjuntivo)."],"exceptions":["hay’in subjuntivo biçimi haya’dır: Ojalá haya entradas."],"mistakes":[{"wrong":"Quiero que tú vienes.","right":"Quiero que tú vengas.","note":"querer que’den sonra subjuntivo gelir."},{"wrong":"Espero que está bien.","right":"Espero que esté bien.","note":"estar’ın subjuntivo’su vurgulu esté’dir."},{"wrong":"Ojalá que hace sol.","right":"Ojalá que haga sol.","note":"hacer → hago → haga."}]}},
  {"id":"es-gr-subjuntivo-deseos-emociones-y-finalidad","languageId":"es","category":"grammar","level":"B1","sourceText":"Subjuntivo: deseos, emociones y finalidad","translations":{"tr":["Subjuntivo: İstek, Duygu ve Amaç"]},"grammar":{"summary":"İstek, duygu ve amaç bildiren yapılardan sonra, özneler farklıysa yan cümlede subjuntivo kullanılır.","uses":["İstek ve rica (Quiero que vengas)","Duygu ve tepki (Me alegra que estés aquí)","Dilek (Ojalá…)","Amaç (para que)"],"sections":[{"kind":"other","title":"İstek + que + subjuntivo","formula":[{"tr":"Ana cümle (querer, esperar, pedir, preferir)","en":"Verbo de deseo","role":"a"},{"tr":"que","en":"Que","role":"x"},{"tr":"Farklı özne","en":"Sujeto","role":"s"},{"tr":"Subjuntivo","en":"Presente de subjuntivo","role":"v"}],"examples":[{"text":"[a:Quiero] [x:que] [s:tú] [v:vengas] a la fiesta.","tr":"Partiye gelmeni istiyorum."},{"text":"[a:Te pido] [x:que] [v:me escuches].","tr":"Beni dinlemeni rica ediyorum."}]},{"kind":"other","title":"Aynı özne → mastar","formula":[{"tr":"Ana cümle","en":"Verbo de deseo","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"[a:Quiero] [v:venir] a la fiesta.","tr":"Partiye gelmek istiyorum."}],"notes":["Özne aynıysa que + subjuntivo kullanılmaz."]},{"kind":"other","title":"Duygu + que + subjuntivo","formula":[{"tr":"me alegra / me molesta / me da pena / siento","en":"Verbo de emoción","role":"a"},{"tr":"que","en":"Que","role":"x"},{"tr":"Subjuntivo","en":"Presente de subjuntivo","role":"v"}],"examples":[{"text":"[a:Me alegra] [x:que] [v:estés] mejor.","tr":"Daha iyi olmana sevindim."},{"text":"[a:Me molesta] [x:que] [s:la gente] [v:llegue] tarde.","tr":"İnsanların geç kalması beni rahatsız ediyor."}]},{"kind":"other","title":"Ojalá / para que","formula":[{"tr":"ojalá (que) / para que","en":"Ojalá / para que","role":"x"},{"tr":"Subjuntivo","en":"Presente de subjuntivo","role":"v"}],"examples":[{"text":"[x:Ojalá] [v:apruebes] el examen.","tr":"İnşallah sınavı geçersin."},{"text":"Te lo explico [x:para que] lo [v:entiendas].","tr":"Anlaman için sana açıklıyorum."}]}],"rules":["Ana cümle istek/duygu bildiriyor ve özneler farklıysa → que + subjuntivo.","Özneler aynıysa → mastar: Espero aprobar.","ojalá her zaman subjuntivo ile kullanılır."],"exceptions":["esperar que \"ummak\" anlamında subjuntivo alır; ama \"beklemek\" anlamında da çoğunlukla subjuntivo kullanılır: Espero que llegue."],"mistakes":[{"wrong":"Quiero que me ayudas.","right":"Quiero que me ayudes.","note":"İstekten sonra subjuntivo gelir."},{"wrong":"Quiero que yo vaya.","right":"Quiero ir.","note":"Özne aynıysa mastar kullanılır."},{"wrong":"Ojalá tienes razón.","right":"Ojalá tengas razón.","note":"ojalá subjuntivo ister."}]}},
  {"id":"es-gr-indicativo-y-subjuntivo-con-opinion","languageId":"es","category":"grammar","level":"B1","sourceText":"Indicativo y subjuntivo con opinión","translations":{"tr":["Görüş Bildirmede Indicativo ve Subjuntivo"]},"grammar":{"summary":"Olumlu görüş fiilleri (creo que, pienso que) indicativo, olumsuzları (no creo que) subjuntivo alır.","uses":["Kendi fikrini söylemek (Creo que…)","Bir fikri reddetmek (No creo que…)","Değerlendirme (Es importante que…)","Kesinlik (Es verdad que…)"],"sections":[{"kind":"affirmative","title":"Olumlu görüş → indicativo","formula":[{"tr":"creo / pienso / me parece","en":"Verbo de opinión","role":"a"},{"tr":"que","en":"Que","role":"x"},{"tr":"Indicativo","en":"Indicativo","role":"v"}],"examples":[{"text":"[a:Creo] [x:que] [v:tienes] razón.","tr":"Bence haklısın."},{"text":"[a:Me parece] [x:que] [v:va] a llover.","tr":"Bana öyle geliyor ki yağmur yağacak."}]},{"kind":"negative","title":"Olumsuz görüş → subjuntivo","formula":[{"tr":"no creo / no pienso / no me parece","en":"Opinión negativa","role":"a"},{"tr":"que","en":"Que","role":"x"},{"tr":"Subjuntivo","en":"Subjuntivo","role":"v"}],"examples":[{"text":"[a:No creo] [x:que] [v:tengas] razón.","tr":"Haklı olduğunu sanmıyorum."},{"text":"[a:No pienso] [x:que] [v:sea] fácil.","tr":"Kolay olduğunu düşünmüyorum."}]},{"kind":"other","title":"Değerlendirme → subjuntivo","formula":[{"tr":"es importante / es necesario / es mejor","en":"Valoración","role":"a"},{"tr":"que","en":"Que","role":"x"},{"tr":"Subjuntivo","en":"Subjuntivo","role":"v"}],"examples":[{"text":"[a:Es importante] [x:que] [v:durmáis] bien.","tr":"İyi uyumanız önemli."},{"text":"[a:Es mejor] [x:que] [v:vengas] temprano.","tr":"Erken gelmen daha iyi."}]},{"kind":"other","title":"Kesinlik → indicativo","formula":[{"tr":"es verdad / es cierto / está claro","en":"Certeza","role":"a"},{"tr":"que","en":"Que","role":"x"},{"tr":"Indicativo","en":"Indicativo","role":"v"}],"examples":[{"text":"[a:Es verdad] [x:que] [v:es] caro.","tr":"Pahalı olduğu doğru."},{"text":"[a:No es verdad] [x:que] [v:sea] caro.","tr":"Pahalı olduğu doğru değil."}]}],"rules":["creer / pensar / parecer olumluysa indicativo, olumsuzsa subjuntivo.","Değerlendirme kalıpları (es bueno, es raro, es lógico) subjuntivo alır.","Kesinlik bildirenler olumluyken indicativo, olumsuzken subjuntivo alır."],"exceptions":["Olumsuz soru cümlesinde indicativo da kullanılabilir: ¿No crees que es tarde?"],"mistakes":[{"wrong":"Creo que sea verdad.","right":"Creo que es verdad.","note":"Olumlu görüşten sonra indicativo gelir."},{"wrong":"No creo que es fácil.","right":"No creo que sea fácil.","note":"Olumsuz görüşten sonra subjuntivo gelir."},{"wrong":"Es importante que estudias.","right":"Es importante que estudies.","note":"Değerlendirme kalıpları subjuntivo ister."}]}},
  {"id":"es-gr-oraciones-de-relativo","languageId":"es","category":"grammar","level":"B1","sourceText":"Oraciones de relativo","translations":{"tr":["İlgi Cümleleri (Que, Quien, Donde)"]},"grammar":{"summary":"İlgi zamirleri (que, quien, donde, lo que) bir ismi yan cümleyle tanımlar; Türkçedeki -an / -dığı yapılarına karşılık gelir.","uses":["Bir kişiyi veya şeyi tanımlamak (el chico que vive aquí)","Yer belirtmek (la ciudad donde nací)","\"…dığı şey\" demek (lo que)"],"sections":[{"kind":"other","title":"İsim + que + fiil","formula":[{"tr":"İsim","en":"Antecedente","role":"o"},{"tr":"que","en":"Que","role":"x"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"El [o:chico] [x:que] [v:vive] aquí es mi primo.","tr":"Burada yaşayan çocuk kuzenim."},{"text":"La [o:película] [x:que] [v:vimos] era genial.","tr":"İzlediğimiz film harikaydı."}],"notes":["que hem kişi hem şey için kullanılır; en yaygın ilgi zamiridir."]},{"kind":"other","title":"Edat + artikel + que / quien","formula":[{"tr":"Edat","en":"Preposición","role":"x"},{"tr":"el que / la que / quien","en":"Relativo","role":"x"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"La amiga [x:con la que] [v:viajé] es italiana.","tr":"Birlikte seyahat ettiğim arkadaş İtalyan."},{"text":"El profesor [x:con quien] [v:hablé] es muy amable.","tr":"Konuştuğum öğretmen çok nazik."}]},{"kind":"other","title":"donde (yer)","formula":[{"tr":"Yer ismi","en":"Lugar","role":"o"},{"tr":"donde","en":"Donde","role":"x"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"Esta es la [o:casa] [x:donde] [v:nací].","tr":"Bu doğduğum ev."}]},{"kind":"other","title":"lo que (… şey)","formula":[{"tr":"lo que","en":"Lo que","role":"x"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"No entiendo [x:lo que] [v:dices].","tr":"Söylediğini anlamıyorum."},{"text":"[x:Lo que] [v:necesito] es descansar.","tr":"İhtiyacım olan şey dinlenmek."}]}],"rules":["İlgi zamiri İspanyolcada atlanamaz: el libro que leo.","Edattan sonra que tek başına değil, el que / la que veya quien ile gelir.","Belirsiz veya var olmayan bir ismi tanımlarken subjuntivo kullanılır: Busco un piso que tenga terraza."],"exceptions":["quien sadece kişiler için kullanılır ve çoğulu quienes’tir."],"mistakes":[{"wrong":"El libro leo es bueno.","right":"El libro que leo es bueno.","note":"que atlanamaz."},{"wrong":"La chica con que hablé.","right":"La chica con la que hablé.","note":"Edattan sonra artikel + que kullanılır."},{"wrong":"No entiendo que dices.","right":"No entiendo lo que dices.","note":"\"…dığı şey\" lo que ile verilir."}]}},
  {"id":"es-gr-oraciones-temporales-cuando-subjuntivo","languageId":"es","category":"grammar","level":"B1","sourceText":"Oraciones temporales: cuando + subjuntivo","translations":{"tr":["Zaman Cümleleri: Cuando + Subjuntivo"]},"grammar":{"summary":"Cuando gelecekteki bir olayı anlatıyorsa subjuntivo, alışkanlık veya geçmişi anlatıyorsa indicativo alır.","uses":["Gelecekte olacak bir zamanı anlatmak (Cuando llegues…)","Genel alışkanlık (Cuando llego, ceno)","Geçmişteki olay (Cuando llegué…)","hasta que, antes de que, en cuanto ile"],"sections":[{"kind":"other","title":"Gelecek: cuando + subjuntivo","formula":[{"tr":"cuando","en":"Cuando","role":"x"},{"tr":"Subjuntivo","en":"Presente de subjuntivo","role":"v"},{"tr":"Ana cümle (futuro / imperativo / presente)","en":"Oración principal","role":"a"}],"examples":[{"text":"[x:Cuando] [v:llegues] a casa, [a:llámame].","tr":"Eve varınca beni ara."},{"text":"[x:Cuando] [v:tenga] dinero, [a:compraré] un coche.","tr":"Param olunca bir araba alacağım."}]},{"kind":"other","title":"Alışkanlık: cuando + indicativo","formula":[{"tr":"cuando","en":"Cuando","role":"x"},{"tr":"Presente","en":"Presente de indicativo","role":"v"},{"tr":"Ana cümle (presente)","en":"Oración principal","role":"a"}],"examples":[{"text":"[x:Cuando] [v:llego] a casa, [a:ceno].","tr":"Eve varınca yemek yerim."}]},{"kind":"other","title":"Geçmiş: cuando + indicativo","formula":[{"tr":"cuando","en":"Cuando","role":"x"},{"tr":"Indefinido / imperfecto","en":"Pasado","role":"v"},{"tr":"Ana cümle (geçmiş)","en":"Oración principal","role":"a"}],"examples":[{"text":"[x:Cuando] [v:llegué], [a:estaban] cenando.","tr":"Vardığımda yemek yiyorlardı."}]},{"kind":"other","title":"Diğer zaman bağlaçları","formula":[{"tr":"hasta que / en cuanto / antes de que","en":"Conectores temporales","role":"x"},{"tr":"Subjuntivo","en":"Subjuntivo","role":"v"}],"examples":[{"text":"Espera aquí [x:hasta que] [v:vuelva].","tr":"Ben dönene kadar burada bekle."},{"text":"Te llamo [x:en cuanto] [v:sepa] algo.","tr":"Bir şey öğrenir öğrenmez seni ararım."}],"notes":["antes de que her zaman subjuntivo alır."]}],"rules":["Gelecekten söz ederken cuando’dan sonra futuro kullanılmaz; subjuntivo kullanılır.","Soru kelimesi ¿Cuándo…? ise gelecek zaman normaldir: ¿Cuándo vendrás?","Özne aynıysa antes de / después de + mastar tercih edilir: Antes de salir, cierra la puerta."],"exceptions":[],"mistakes":[{"wrong":"Cuando llegarás, te llamo.","right":"Cuando llegues, te llamo.","note":"Gelecek anlamlı cuando subjuntivo alır."},{"wrong":"Cuando llegue a casa, siempre ceno.","right":"Cuando llego a casa, siempre ceno.","note":"Alışkanlıkta indicativo kullanılır."},{"wrong":"Antes de que salgo, desayuno.","right":"Antes de salir, desayuno.","note":"Özne aynıysa mastar kullanılır."}]}},
  {"id":"es-gr-oraciones-condicionales-reales","languageId":"es","category":"grammar","level":"B1","sourceText":"Oraciones condicionales reales","translations":{"tr":["Gerçek Koşul Cümleleri (Si + Presente)"]},"grammar":{"summary":"Si + presente yapısı, gerçekleşmesi olası koşulları ve sonuçlarını anlatır.","uses":["Olası gelecek koşul (Si llueve, me quedo)","Genel gerçek (Si calientas hielo, se derrite)","Koşullu emir ve tavsiye (Si tienes frío, ponte el abrigo)"],"sections":[{"kind":"other","title":"Si + presente, futuro / presente","formula":[{"tr":"si","en":"Si","role":"x"},{"tr":"Presente (koşul)","en":"Presente de indicativo","role":"v"},{"tr":"Futuro / presente (sonuç)","en":"Futuro / presente","role":"a"}],"examples":[{"text":"[x:Si] [v:llueve], [a:nos quedaremos] en casa.","tr":"Yağmur yağarsa evde kalacağız."},{"text":"[x:Si] [v:tienes] tiempo, [a:vamos] al cine.","tr":"Vaktin varsa sinemaya gidelim."}]},{"kind":"other","title":"Si + presente, imperativo","formula":[{"tr":"si","en":"Si","role":"x"},{"tr":"Presente","en":"Presente de indicativo","role":"v"},{"tr":"Emir","en":"Imperativo","role":"a"}],"examples":[{"text":"[x:Si] [v:ves] a Ana, [a:dile] que la llamo luego.","tr":"Ana’yı görürsen ona sonra arayacağımı söyle."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"si no","en":"Si no","role":"x"},{"tr":"Presente","en":"Presente de indicativo","role":"v"},{"tr":"Sonuç","en":"Consecuencia","role":"a"}],"examples":[{"text":"[x:Si no] [v:estudias], [a:no aprobarás].","tr":"Çalışmazsan geçemezsin."}]},{"kind":"other","title":"Sonuç önde","formula":[{"tr":"Sonuç","en":"Consecuencia","role":"a"},{"tr":"si","en":"Si","role":"x"},{"tr":"Presente","en":"Presente de indicativo","role":"v"}],"examples":[{"text":"[a:Te ayudo] [x:si] [v:quieres].","tr":"İstersen sana yardım ederim."}],"notes":["Sonuç önde gelirse virgül kullanılmaz."]}],"rules":["si’den sonra asla futuro veya presente de subjuntivo kullanılmaz.","si (eğer) vurgusuz; sí (evet) vurgulu yazılır.","Koşul başta ise virgülle ayrılır."],"exceptions":["Hayalî koşul (si tuviera…) ve geçmişteki koşul (si hubiera…) B2 konusudur."],"mistakes":[{"wrong":"Si lloverá, no salgo.","right":"Si llueve, no salgo.","note":"si’den sonra futuro kullanılmaz."},{"wrong":"Si tengas tiempo, llámame.","right":"Si tienes tiempo, llámame.","note":"Gerçek koşulda si + presente de indicativo kullanılır."},{"wrong":"Sí quieres, vamos.","right":"Si quieres, vamos.","note":"\"Eğer\" anlamındaki si vurgusuzdur."}]}},
  {"id":"es-gr-estilo-indirecto","languageId":"es","category":"grammar","level":"B1","sourceText":"Estilo indirecto","translations":{"tr":["Dolaylı Anlatım"]},"grammar":{"summary":"Estilo indirecto, başkasının sözlerini aktarır; aktarma fiili geçmişteyse zamanlar bir adım geçmişe kayar.","uses":["Söylenen bir şeyi aktarmak (Dice que…)","Soruları aktarmak (Me preguntó si…)","Emir ve ricaları aktarmak (Me pidió que…)"],"sections":[{"kind":"other","title":"Şimdiki aktarma: dice que","formula":[{"tr":"dice / ha dicho","en":"Verbo introductor","role":"a"},{"tr":"que","en":"Que","role":"x"},{"tr":"Zaman değişmez","en":"Mismo tiempo","role":"v"}],"examples":[{"text":"«Estoy cansada.» → [a:Dice] [x:que] [v:está] cansada.","tr":"«Yorgunum.» → Yorgun olduğunu söylüyor."}],"notes":["Sadece kişi ve zamirler değişir."]},{"kind":"other","title":"Geçmiş aktarma: dijo que","formula":[{"tr":"dijo / explicó","en":"Verbo en pasado","role":"a"},{"tr":"que","en":"Que","role":"x"},{"tr":"presente → imperfecto, indefinido → pluscuamperfecto, futuro → condicional","en":"Cambio de tiempo","role":"v"}],"examples":[{"text":"«Vivo en Lima.» → [a:Dijo] [x:que] [v:vivía] en Lima.","tr":"«Lima’da yaşıyorum.» → Lima’da yaşadığını söyledi."},{"text":"«Iré mañana.» → [a:Dijo] [x:que] [v:iría] al día siguiente.","tr":"«Yarın gideceğim.» → Ertesi gün gideceğini söyledi."}]},{"kind":"other","title":"Soru aktarma","formula":[{"tr":"preguntar","en":"Preguntar","role":"a"},{"tr":"si / soru kelimesi","en":"Si / interrogativo","role":"q"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"«¿Tienes hambre?» → Me [a:preguntó] [q:si] [v:tenía] hambre.","tr":"«Aç mısın?» → Aç olup olmadığımı sordu."},{"text":"«¿Dónde vives?» → Me [a:preguntó] [q:dónde] [v:vivía].","tr":"«Nerede yaşıyorsun?» → Nerede yaşadığımı sordu."}]},{"kind":"other","title":"Emir aktarma","formula":[{"tr":"pedir / decir","en":"Pedir / decir","role":"a"},{"tr":"que","en":"Que","role":"x"},{"tr":"Subjuntivo","en":"Subjuntivo","role":"v"}],"examples":[{"text":"«Ven.» → Me [a:dice] [x:que] [v:venga].","tr":"«Gel.» → Gelmemi söylüyor."}],"notes":["Aktarma fiili geçmişteyse imperfecto de subjuntivo gelir: Me dijo que viniera (B2)."]}],"rules":["Zaman ve yer ifadeleri değişir: hoy → ese día, mañana → al día siguiente, aquí → allí.","Evet/hayır soruları si ile, diğerleri soru kelimesiyle aktarılır (vurgusunu korur).","Aktarılan cümlede soru işareti kullanılmaz."],"exceptions":["Söylenen hâlâ geçerliyse geçmiş aktarmada da zaman korunabilir: Dijo que es médico."],"mistakes":[{"wrong":"Me preguntó que si tenía hambre (yazıda).","right":"Me preguntó si tenía hambre.","note":"Yazı dilinde que si yerine sadece si kullanılır."},{"wrong":"Dijo que vendrá mañana (geçmiş durum).","right":"Dijo que vendría al día siguiente.","note":"Geçmiş aktarmada futuro → condicional olur."},{"wrong":"Me preguntó dónde vivo yo?","right":"Me preguntó dónde vivía.","note":"Dolaylı soruda soru işareti ve devrik yapı yoktur."}]}},
  {"id":"es-gr-perifrasis-verbales","languageId":"es","category":"grammar","level":"B1","sourceText":"Perífrasis verbales","translations":{"tr":["Fiil Kalıpları (Perífrasis)"]},"grammar":{"summary":"Perífrasis, çekimli bir yardımcı fiil ile mastar, gerundio veya ortaçtan oluşan, eylemin evresini anlatan kalıplardır.","uses":["Yeni bitmiş eylem (acabar de)","Tekrar (volver a)","Süreklilik (seguir + gerundio, llevar + süre + gerundio)","Bırakma ve başlama (dejar de, empezar a)"],"sections":[{"kind":"other","title":"Mastarlı kalıplar","formula":[{"tr":"acabar de / volver a / dejar de / empezar a","en":"Perífrasis de infinitivo","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"[a:Acabo de] [v:llegar].","tr":"Az önce geldim."},{"text":"[a:He dejado de] [v:fumar].","tr":"Sigarayı bıraktım."},{"text":"[a:Volvió a] [v:llamar].","tr":"Tekrar aradı."}]},{"kind":"other","title":"Gerundiolu kalıplar","formula":[{"tr":"seguir / llevar + süre","en":"Perífrasis de gerundio","role":"a"},{"tr":"Gerundio","en":"Gerundio","role":"v"}],"examples":[{"text":"[a:Sigo] [v:viviendo] en Madrid.","tr":"Hâlâ Madrid’de yaşıyorum."},{"text":"[a:Llevo] dos años [v:estudiando] español.","tr":"İki yıldır İspanyolca öğreniyorum."}]},{"kind":"other","title":"soler + mastar","formula":[{"tr":"soler (presente / imperfecto)","en":"Soler","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"[a:Suelo] [v:desayunar] en casa.","tr":"Genelde evde kahvaltı ederim."},{"text":"De joven [a:solía] [v:correr].","tr":"Gençken koşmayı âdet edinmiştim."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"no","en":"No","role":"x"},{"tr":"Yardımcı fiil","en":"Verbo auxiliar","role":"a"},{"tr":"Mastar / gerundio","en":"Forma no personal","role":"v"}],"examples":[{"text":"[x:No] [a:vuelvas a] [v:hacerlo].","tr":"Bunu bir daha yapma."},{"text":"Todavía [x:no] [a:he empezado a] [v:trabajar].","tr":"Henüz çalışmaya başlamadım."}]}],"rules":["Sadece yardımcı fiil çekimlenir; ikinci fiil mastar ya da gerundio kalır.","Edat (de, a) kalıbın parçasıdır; atlanmaz.","seguir’den sonra gerundio gelir: Sigo trabajando (✗ sigo a trabajar)."],"exceptions":["Olumsuz süreklilik: seguir sin + mastar = hâlâ yapmamak: Sigo sin entenderlo."],"mistakes":[{"wrong":"Acabo llegar.","right":"Acabo de llegar.","note":"acabar de kalıbında de gerekir."},{"wrong":"Sigo a estudiar.","right":"Sigo estudiando.","note":"seguir gerundio ile kullanılır."},{"wrong":"Estudio español desde dos años.","right":"Llevo dos años estudiando español.","note":"\"…dır\" süresi llevar + gerundio ile doğal anlatılır."}]}}
]
