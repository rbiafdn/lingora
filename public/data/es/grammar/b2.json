[
  {"id":"es-gr-subjuntivo-deseo-e-influencia","languageId":"es","category":"grammar","level":"B2","sourceText":"Subjuntivo: deseo e influencia","translations":{"tr":["İstek ve Etki Bildiren Subjuntivo"]},"grammar":{"summary":"İstek, rica, emir veya tavsiye bildiren fiillerden sonra, özne değişiyorsa yan cümlede subjuntivo kullanılır.","uses":["Birinin bir şey yapmasını istemek (querer que)","Rica, tavsiye, yasak (pedir, aconsejar, prohibir que)","Dilek bildirmek (ojalá, espero que)"],"sections":[{"kind":"other","title":"İstek fiili + que + subjuntivo","formula":[{"tr":"Özne 1 + istek fiili","en":"Sujeto 1 + verbo de deseo","role":"v"},{"tr":"que","en":"que","role":"x"},{"tr":"Özne 2","en":"Sujeto 2","role":"s"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Quiero] [x:que] [s:tú] [v:vengas] [o:a la fiesta].","tr":"Partiye gelmeni istiyorum."},{"text":"[s:Mis padres] [v:esperan] [x:que] [v:encuentre] [o:un buen trabajo].","tr":"Ailem iyi bir iş bulmamı umuyor."}],"notes":["Başlıca fiiller: querer, desear, esperar, preferir, necesitar."]},{"kind":"other","title":"Etki fiilleri: pedir, recomendar, prohibir","formula":[{"tr":"Özne + (zamir) + etki fiili","en":"Sujeto + verbo de influencia","role":"v"},{"tr":"que","en":"que","role":"x"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:El médico] [v:me recomienda] [x:que] [v:descanse] [o:más].","tr":"Doktor daha çok dinlenmemi tavsiye ediyor."},{"text":"[v:Te pido] [x:que] [v:no digas] [o:nada].","tr":"Hiçbir şey söylememeni rica ediyorum."}]},{"kind":"other","title":"Ojalá (que) + subjuntivo","formula":[{"tr":"Ojalá (que)","en":"Ojalá (que)","role":"x"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[x:Ojalá] [v:haga] [o:buen tiempo] mañana.","tr":"Umarım yarın hava güzel olur."},{"text":"[x:Ojalá que] [v:apruebes] [o:el examen].","tr":"İnşallah sınavı geçersin."}],"notes":["Ojalá her zaman subjuntivo ister; özne değişmesi gerekmez."]},{"kind":"other","title":"Aynı özne → mastar","formula":[{"tr":"Özne + istek fiili","en":"Sujeto + verbo de deseo","role":"v"},{"tr":"Mastar","en":"Infinitivo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Quiero] [v:viajar] [o:a Perú].","tr":"Peru’ya gitmek istiyorum."},{"text":"[v:Prefiero] [v:quedarme] [o:en casa].","tr":"Evde kalmayı tercih ederim."}]}],"rules":["İki cümlenin öznesi farklıysa que + subjuntivo, aynıysa mastar kullanılır.","Ana cümle şimdiki/gelecek zamandaysa yan cümle presente de subjuntivo olur.","Decir “söylemek” anlamında indicativo, “emretmek” anlamında subjuntivo alır: Dice que viene / Dice que vengas."],"exceptions":["Permitir, prohibir, mandar gibi fiillerde mastar da olur: Te prohíbo salir = Te prohíbo que salgas."],"mistakes":[{"wrong":"Quiero que tú vienes.","right":"Quiero que tú vengas.","note":"İstek bildiren fiilden sonra indicativo değil subjuntivo gelir."},{"wrong":"Quiero que yo vaya.","right":"Quiero ir.","note":"Özne aynıysa que kullanılmaz, mastar gelir."},{"wrong":"Ojalá llueve.","right":"Ojalá llueva.","note":"Ojalá’dan sonra her zaman subjuntivo gelir."}]}},
  {"id":"es-gr-subjuntivo-sentimientos-y-valoracion","languageId":"es","category":"grammar","level":"B2","sourceText":"Subjuntivo: sentimientos y valoración","translations":{"tr":["Duygu ve Değerlendirme Bildiren Subjuntivo"]},"grammar":{"summary":"Duygu (sevinç, üzüntü, rahatsızlık) ve değerlendirme bildiren ifadelerden sonra yan cümle subjuntivo olur.","uses":["Bir duruma karşı duyguyu anlatmak (me alegra que)","Kişisel olmayan değerlendirme (es importante que)","Gerçeği vurgulayan ifadelerle karşılaştırma (es verdad que + indicativo)"],"sections":[{"kind":"other","title":"Duygu fiili + que + subjuntivo","formula":[{"tr":"(Zamir) + duygu fiili","en":"Verbo de sentimiento","role":"v"},{"tr":"que","en":"que","role":"x"},{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"}],"examples":[{"text":"[v:Me alegra] [x:que] [v:estés] [o:aquí].","tr":"Burada olmana sevindim."},{"text":"[v:Me molesta] [x:que] [s:la gente] [v:hable] [o:en el cine].","tr":"İnsanların sinemada konuşması beni rahatsız ediyor."}],"notes":["Sık kullanılanlar: me gusta, me encanta, me preocupa, me da pena, siento que, temo que."]},{"kind":"other","title":"Es + sıfat + que + subjuntivo","formula":[{"tr":"Es + sıfat/isim","en":"Es + adjetivo/sustantivo","role":"a"},{"tr":"que","en":"que","role":"x"},{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"}],"examples":[{"text":"[a:Es importante] [x:que] [s:todos] [v:lleguen] [o:a tiempo].","tr":"Herkesin zamanında gelmesi önemli."},{"text":"[a:Es una pena] [x:que] [v:no puedas] [o:venir].","tr":"Gelememen çok yazık."}]},{"kind":"other","title":"Gerçeklik: es verdad que + indicativo","formula":[{"tr":"Es verdad / cierto / evidente","en":"Es verdad / cierto / evidente","role":"a"},{"tr":"que","en":"que","role":"x"},{"tr":"Fiil (indicativo)","en":"Verbo (indicativo)","role":"v"}],"examples":[{"text":"[a:Es verdad] [x:que] [v:es] [o:caro].","tr":"Pahalı olduğu doğru."},{"text":"[a:No es verdad] [x:que] [v:sea] [o:caro].","tr":"Pahalı olduğu doğru değil."}],"notes":["Olumsuz yapılınca (no es verdad que) subjuntivo gelir."]},{"kind":"other","title":"Özne aynı / genel → mastar","formula":[{"tr":"Duygu fiili / es + sıfat","en":"Verbo de sentimiento / es + adjetivo","role":"a"},{"tr":"Mastar","en":"Infinitivo","role":"v"}],"examples":[{"text":"[a:Me encanta] [v:bailar].","tr":"Dans etmeye bayılırım."},{"text":"[a:Es necesario] [v:reservar] [o:mesa].","tr":"Masa ayırtmak gerekiyor."}]}],"rules":["Duygu ve değerlendirme ifadeleri subjuntivo ister; gerçeklik ifadeleri (es verdad, es obvio, está claro) indicativo ister.","Genel bir yargıda belirli bir özne yoksa mastar kullanılır: Es bueno dormir bien.","Geçmişteki bir olaya şimdiki duygu için pretérito perfecto de subjuntivo kullanılır: Me alegra que hayas venido."],"exceptions":[],"mistakes":[{"wrong":"Me alegra que estás aquí.","right":"Me alegra que estés aquí.","note":"Duygu fiilinden sonra subjuntivo gelir."},{"wrong":"Es importante que lo haces.","right":"Es importante que lo hagas.","note":"Değerlendirme ifadelerinden sonra subjuntivo gelir."},{"wrong":"Es cierto que sea difícil.","right":"Es cierto que es difícil.","note":"Gerçeklik bildiren olumlu ifadeden sonra indicativo gelir."}]}},
  {"id":"es-gr-subjuntivo-duda-y-opinion-negada","languageId":"es","category":"grammar","level":"B2","sourceText":"Subjuntivo: duda y opinión negada","translations":{"tr":["Şüphe ve Olumsuz Görüş Bildiren Subjuntivo"]},"grammar":{"summary":"Şüphe, olasılık ve olumsuz görüş bildiren ifadelerden sonra subjuntivo; olumlu görüşten sonra indicativo kullanılır.","uses":["Şüphe bildirmek (dudo que)","Bir görüşü reddetmek (no creo que)","Olasılık bildirmek (quizás, tal vez, es posible que)"],"sections":[{"kind":"other","title":"Olumlu görüş + indicativo","formula":[{"tr":"Creo / pienso / me parece","en":"Creo / pienso / me parece","role":"v"},{"tr":"que","en":"que","role":"x"},{"tr":"Fiil (indicativo)","en":"Verbo (indicativo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Creo] [x:que] [v:tienes] [o:razón].","tr":"Bence haklısın."},{"text":"[v:Me parece] [x:que] [v:va] [o:a llover].","tr":"Bana kalırsa yağmur yağacak."}]},{"kind":"other","title":"Olumsuz görüş + subjuntivo","formula":[{"tr":"No creo / no pienso","en":"No creo / no pienso","role":"v"},{"tr":"que","en":"que","role":"x"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:No creo] [x:que] [v:tengas] [o:razón].","tr":"Haklı olduğunu sanmıyorum."},{"text":"[v:No pienso] [x:que] [s:Luis] [v:venga] [o:hoy].","tr":"Luis’in bugün geleceğini düşünmüyorum."}]},{"kind":"other","title":"Şüphe ve olasılık + subjuntivo","formula":[{"tr":"Dudo / es posible / es probable","en":"Dudo / es posible / es probable","role":"a"},{"tr":"que","en":"que","role":"x"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"}],"examples":[{"text":"[a:Dudo] [x:que] [v:lleguen] [o:a tiempo].","tr":"Zamanında yetişeceklerinden şüpheliyim."},{"text":"[a:Es posible] [x:que] [v:nieve] [o:esta noche].","tr":"Bu gece kar yağabilir."}]},{"kind":"other","title":"Quizás / tal vez / a lo mejor","formula":[{"tr":"Quizás / tal vez","en":"Quizás / tal vez","role":"x"},{"tr":"Fiil (subjuntivo / indicativo)","en":"Verbo (subjuntivo / indicativo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[x:Quizás] [v:venga] [o:mañana].","tr":"Belki yarın gelir."},{"text":"[x:A lo mejor] [v:viene] [o:mañana].","tr":"Belki yarın gelir."}],"notes":["A lo mejor her zaman indicativo alır."]}],"rules":["creer, pensar, parecer, estar seguro olumluysa indicativo, olumsuzsa subjuntivo alır.","dudar, es posible, es probable, puede que her zaman subjuntivo alır.","quizás / tal vez ile subjuntivo daha fazla şüphe, indicativo daha fazla kesinlik anlatır."],"exceptions":["Olumsuz soruda indicativo da olur: ¿No crees que es tarde? (aslında geç olduğunu düşünüyorum)."],"mistakes":[{"wrong":"Creo que sea verdad.","right":"Creo que es verdad.","note":"Olumlu görüş indicativo ister."},{"wrong":"No creo que es verdad.","right":"No creo que sea verdad.","note":"Olumsuz görüş subjuntivo ister."},{"wrong":"A lo mejor venga.","right":"A lo mejor viene.","note":"A lo mejor’dan sonra indicativo gelir."}]}},
  {"id":"es-gr-preterito-pluscuamperfecto-de-indicativo","languageId":"es","category":"grammar","level":"B2","sourceText":"Pretérito pluscuamperfecto de indicativo","translations":{"tr":["Geçmişin Geçmişi (-mıştı)"]},"grammar":{"summary":"Geçmişteki bir olaydan daha önce tamamlanmış başka bir olayı anlatır; Türkçedeki -mıştı karşılığıdır.","uses":["Geçmişteki bir andan önce olmuş eylemler","İki geçmiş olaydan önce olanı belirtmek","Dolaylı anlatımda geri kayma (indefinido → pluscuamperfecto)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"haber (imperfecto)","en":"haber (imperfecto)","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"Cuando llegamos, [s:la película] ya [a:había] [v:empezado].","tr":"Vardığımızda film çoktan başlamıştı."},{"text":"[s:Ella] [a:había] [v:salido] [o:antes de mi llamada].","tr":"Ben aramadan önce o çıkmıştı."}],"notes":["haber: había, habías, había, habíamos, habíais, habían."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no + haber (imperfecto)","en":"no + haber (imperfecto)","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Yo] [a:no había] [v:visto] [o:nunca el mar].","tr":"Daha önce hiç deniz görmemiştim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"¿ + haber (imperfecto)","en":"¿ + haber (imperfecto)","role":"a"},{"tr":"(Özne)","en":"(Sujeto)","role":"s"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç + ?","en":"Complemento + ?","role":"o"}],"examples":[{"text":"¿[a:Habías] [v:estado] [o:en México] antes?","tr":"Daha önce Meksika’da bulunmuş muydun?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"¿ + Soru kelimesi","en":"¿ + Interrogativo","role":"q"},{"tr":"haber (imperfecto)","en":"haber (imperfecto)","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"(Özne) + ?","en":"(Sujeto) + ?","role":"s"}],"examples":[{"text":"¿[q:Qué] [a:había] [v:pasado] [o:allí]?","tr":"Orada ne olmuştu?"}]}],"rules":["Önce olan olay pluscuamperfecto, sonra olan olay indefinido ile anlatılır.","Ortaç (participio) değişmez; dişil/çoğul eki almaz.","Nesne zamirleri haber’in önüne gelir: Ya lo había hecho.","Düzensiz ortaçlar: hecho, dicho, visto, escrito, puesto, vuelto, roto, abierto."],"exceptions":["Olaylar sırasıyla anlatılıyorsa pluscuamperfecto gerekmez: Me levanté, desayuné y salí."],"mistakes":[{"wrong":"Cuando llegué, el tren ya salió.","right":"Cuando llegué, el tren ya había salido.","note":"Daha önce olan olay için había + participio gerekir."},{"wrong":"Había lo visto.","right":"Lo había visto.","note":"Zamir haber’in önüne gelir."},{"wrong":"Las cartas que había escritas…","right":"Las cartas que había escrito…","note":"haber ile ortaç cinsiyet ve sayıya göre değişmez."}]}},
  {"id":"es-gr-futuro-perfecto","languageId":"es","category":"grammar","level":"B2","sourceText":"Futuro perfecto","translations":{"tr":["Gelecekte Bitmiş Zaman (-mış olacak)"]},"grammar":{"summary":"Gelecekteki bir andan önce tamamlanmış olacak eylemi veya yakın geçmişe dair tahmini anlatır.","uses":["Gelecekteki bir ana kadar bitmiş olacak işler","Yakın geçmişe dair tahmin (-mıştır, -mış olmalı)","para + zaman ifadesiyle son tarih belirtmek"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"haber (futuro)","en":"haber (futuro)","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"Para el lunes [s:yo] [a:habré] [v:terminado] [o:el informe].","tr":"Pazartesiye kadar raporu bitirmiş olacağım."},{"text":"[s:Ana] no contesta; [a:habrá] [v:salido].","tr":"Ana cevap vermiyor; çıkmıştır."}],"notes":["haber: habré, habrás, habrá, habremos, habréis, habrán."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no + haber (futuro)","en":"no + haber (futuro)","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Nosotros] [a:no habremos] [v:acabado] [o:antes de las ocho].","tr":"Saat sekizden önce bitirmiş olmayacağız."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"¿ + haber (futuro)","en":"¿ + haber (futuro)","role":"a"},{"tr":"(Özne)","en":"(Sujeto)","role":"s"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç + ?","en":"Complemento + ?","role":"o"}],"examples":[{"text":"¿[a:Habrás] [v:vuelto] [o:para la cena]?","tr":"Akşam yemeğine kadar dönmüş olacak mısın?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"¿ + Soru kelimesi","en":"¿ + Interrogativo","role":"q"},{"tr":"haber (futuro)","en":"haber (futuro)","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç + ?","en":"Complemento + ?","role":"o"}],"examples":[{"text":"¿[q:Dónde] [a:habré] [v:dejado] [o:las llaves]?","tr":"Anahtarları nereye koydum acaba?"}],"notes":["Bu tür sorular kendi kendine merak/tahmin bildirir."]}],"rules":["Gelecekteki son tarih para, dentro de, antes de ile verilir.","Tahmin anlamında pretérito perfecto’nun yerini tutar: Ha salido (kesin) → Habrá salido (tahmin).","Nesne zamirleri haber’in önüne gelir: Ya lo habrán visto."],"exceptions":[],"mistakes":[{"wrong":"Para mañana habré terminar.","right":"Para mañana habré terminado.","note":"haber’den sonra mastar değil ortaç gelir."},{"wrong":"Cuando habrás terminado, llámame.","right":"Cuando hayas terminado, llámame.","note":"cuando’dan sonra futuro değil subjuntivo gelir."}]}},
  {"id":"es-gr-condicional-compuesto","languageId":"es","category":"grammar","level":"B2","sourceText":"Condicional compuesto","translations":{"tr":["Geçmişe Dair Koşul Kipi (-ardı / -mış olurdu)"]},"grammar":{"summary":"Geçmişte gerçekleşmemiş hayali bir eylemi veya geçmişteki bir ana dair tahmini anlatır.","uses":["Geçmişte olmamış hayali sonuçlar (3. tip koşul)","Geçmişe dair pişmanlık veya eleştiri","Geçmişteki bir an için tahmin"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"haber (condicional)","en":"haber (condicional)","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Yo] [a:habría] [v:ido] [o:a la fiesta], pero estaba enfermo.","tr":"Partiye giderdim ama hastaydım."},{"text":"[s:Tú] [a:habrías] [v:hecho] [o:lo mismo].","tr":"Sen de aynısını yapardın."}],"notes":["haber: habría, habrías, habría, habríamos, habríais, habrían."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no + haber (condicional)","en":"no + haber (condicional)","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"Sin tu ayuda [s:yo] [a:no habría] [v:aprobado] [o:el examen].","tr":"Senin yardımın olmasa sınavı geçemezdim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"¿ + haber (condicional)","en":"¿ + haber (condicional)","role":"a"},{"tr":"(Özne)","en":"(Sujeto)","role":"s"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç + ?","en":"Complemento + ?","role":"o"}],"examples":[{"text":"¿[a:Habrías] [v:aceptado] [o:ese trabajo]?","tr":"O işi kabul eder miydin?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"¿ + Soru kelimesi","en":"¿ + Interrogativo","role":"q"},{"tr":"haber (condicional)","en":"haber (condicional)","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Özne + ?","en":"Sujeto + ?","role":"s"}],"examples":[{"text":"¿[q:Qué] [a:habrías] [v:hecho] [s:tú] en mi lugar?","tr":"Benim yerimde sen ne yapardın?"}]}],"rules":["Koşul cümlesinin si tarafında değil, sonuç tarafında kullanılır.","Konuşmada sonuç tarafında hubiera + participio da kullanılır: Yo hubiera ido.","Geçmişteki tahmin: Cuando llegó, habrían sido las diez (saat ondu herhalde)."],"exceptions":[],"mistakes":[{"wrong":"Si habría sabido, habría venido.","right":"Si hubiera sabido, habría venido.","note":"si’den sonra condicional gelmez, pluscuamperfecto de subjuntivo gelir."},{"wrong":"Yo habría ir.","right":"Yo habría ido.","note":"haber’den sonra ortaç gelir."}]}},
  {"id":"es-gr-preterito-perfecto-de-subjuntivo","languageId":"es","category":"grammar","level":"B2","sourceText":"Pretérito perfecto de subjuntivo","translations":{"tr":["Subjuntivo’nun Yakın Geçmiş Zamanı"]},"grammar":{"summary":"Subjuntivo gerektiren yapılarda tamamlanmış bir eylemi (yakın geçmişte ya da gelecekte) anlatır.","uses":["Yakın geçmişteki bir olaya duygu/şüphe bildirmek","Gelecekte tamamlanmış olacak eylem (cuando haya terminado)","Olumsuz görüşü geçmişe uygulamak (no creo que haya…)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Duygu/şüphe + que","en":"Expresión + que","role":"x"},{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"haber (pres. subj.)","en":"haber (presente de subjuntivo)","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"Me alegra que [s:tú] [a:hayas] [v:venido].","tr":"Gelmene sevindim."},{"text":"Espero que [s:Pedro] [a:haya] [v:llegado] [o:bien].","tr":"Umarım Pedro iyi varmıştır."}],"notes":["haber: haya, hayas, haya, hayamos, hayáis, hayan."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"No creo / dudo + que","en":"No creo / dudo + que","role":"x"},{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"(no) + haber (pres. subj.)","en":"(no) + haber (presente de subjuntivo)","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"}],"examples":[{"text":"No creo que [s:ellos] [a:hayan] [v:terminado] [o:ya].","tr":"Bitirdiklerini sanmıyorum."},{"text":"Me extraña que [s:Ana] [a:no haya] [v:llamado].","tr":"Ana’nın aramamış olması bana tuhaf geliyor."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"¿ + Duygu fiili + que","en":"¿ + Verbo de sentimiento + que","role":"x"},{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"haber (pres. subj.)","en":"haber (presente de subjuntivo)","role":"a"},{"tr":"Ortaç + ?","en":"Participio + ?","role":"v"}],"examples":[{"text":"¿Te sorprende que [s:Juan] [a:haya] [v:aprobado]?","tr":"Juan’ın geçmiş olması seni şaşırttı mı?"}]},{"kind":"other","title":"Gelecek: cuando + haya + ortaç","formula":[{"tr":"Cuando / en cuanto","en":"Cuando / en cuanto","role":"x"},{"tr":"haber (pres. subj.)","en":"haber (presente de subjuntivo)","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":", Ana cümle","en":", Oración principal","role":"o"}],"examples":[{"text":"[x:Cuando] [a:hayas] [v:terminado], [o:avísame].","tr":"Bitirdiğinde bana haber ver."}]}],"rules":["Ana cümle şimdiki/gelecek zamandayken, yan cümledeki tamamlanmış eylem için kullanılır.","Ana cümle geçmişteyse pluscuamperfecto de subjuntivo kullanılır: Me alegró que hubieras venido."],"exceptions":[],"mistakes":[{"wrong":"Me alegra que has venido.","right":"Me alegra que hayas venido.","note":"Duygu ifadesinden sonra subjuntivo gerekir."},{"wrong":"Cuando habrás terminado, llámame.","right":"Cuando hayas terminado, llámame.","note":"cuando’dan sonra futuro değil subjuntivo gelir."}]}},
  {"id":"es-gr-preterito-imperfecto-de-subjuntivo","languageId":"es","category":"grammar","level":"B2","sourceText":"Pretérito imperfecto de subjuntivo","translations":{"tr":["Subjuntivo’nun Geçmiş Zamanı (-ra / -se)"]},"grammar":{"summary":"Geçmişteki istek, duygu ve şüpheyi, ayrıca gerçek dışı koşul ve dilekleri anlatır; -ra veya -se ile kurulur.","uses":["Ana cümle geçmişteyken subjuntivo gereken yan cümleler","Gerçek dışı koşul ve dilek (si tuviera, ojalá fuera)","Kibar rica (quisiera)","como si yapısı"],"sections":[{"kind":"other","title":"Oluşum: indefinido ellos kökü + -ra / -se","formula":[{"tr":"Indefinido ellos kökü","en":"Raíz de 3.ª pl. del indefinido","role":"v"},{"tr":"-ra / -se + kişi eki","en":"-ra / -se + desinencia","role":"x"}],"examples":[{"text":"[v:hablaron] → [v:hablara] / [v:hablase]","tr":"konuştular → konuşsa"},{"text":"[v:tuvieron] → [v:tuviera] / [v:tuviese]","tr":"sahip oldular → sahip olsa"}],"notes":["-ra: -ra, -ras, -ra, -ramos, -rais, -ran. Nosotros vurgu alır: habláramos."]},{"kind":"other","title":"Geçmişte istek: quería que + imp. subj.","formula":[{"tr":"Özne + geçmiş fiil","en":"Sujeto + verbo en pasado","role":"v"},{"tr":"que","en":"que","role":"x"},{"tr":"Fiil (imp. subj.)","en":"Verbo (imperfecto de subjuntivo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Mis padres] [v:querían] [x:que] [v:estudiara] [o:medicina].","tr":"Ailem tıp okumamı istiyordu."},{"text":"[v:Me pidió] [x:que] [v:fuera] [o:con él].","tr":"Onunla gitmemi istedi."}]},{"kind":"other","title":"Ojalá + imp. subj. (zayıf dilek)","formula":[{"tr":"Ojalá","en":"Ojalá","role":"x"},{"tr":"Fiil (imp. subj.)","en":"Verbo (imperfecto de subjuntivo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[x:Ojalá] [v:tuviera] [o:más tiempo].","tr":"Keşke daha çok vaktim olsa."}]},{"kind":"other","title":"Como si + imp. subj.","formula":[{"tr":"Ana cümle","en":"Oración principal","role":"v"},{"tr":"como si","en":"como si","role":"x"},{"tr":"Fiil (imp. subj.)","en":"Verbo (imperfecto de subjuntivo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Él] [v:habla] [x:como si] [v:fuera] [o:el jefe].","tr":"Sanki patronmuş gibi konuşuyor."}]}],"rules":["Kök, indefinido’nun ellos biçiminden gelir; düzensizlik korunur: dijeron → dijera, pudieron → pudiera.","-ra ve -se biçimleri çoğu durumda eş anlamlıdır; konuşmada -ra daha yaygındır.","Ana cümle geçmiş veya condicional ise yan cümle imperfecto de subjuntivo olur."],"exceptions":["quisiera, debiera, pudiera ana cümlede kibarlık için kullanılabilir: Quisiera un café."],"mistakes":[{"wrong":"Quería que vienes.","right":"Quería que vinieras.","note":"Ana cümle geçmişteyse imperfecto de subjuntivo gerekir."},{"wrong":"Si tendría tiempo, iría.","right":"Si tuviera tiempo, iría.","note":"si’den sonra condicional değil imperfecto de subjuntivo gelir."},{"wrong":"Ojalá estuvieramos aquí.","right":"Ojalá estuviéramos aquí.","note":"nosotros biçimi vurgu işareti alır."}]}},
  {"id":"es-gr-oraciones-condicionales-tipos-1-y-2","languageId":"es","category":"grammar","level":"B2","sourceText":"Oraciones condicionales (tipos 1 y 2)","translations":{"tr":["Koşul Cümleleri (1. ve 2. tip)"]},"grammar":{"summary":"Olası koşullar si + presente, hayali veya düşük olasılıklı koşullar si + imperfecto de subjuntivo ile kurulur.","uses":["Tipo 1: gerçekleşmesi olası koşullar","Tipo 2: şimdiye dair hayali veya düşük olasılıklı koşullar","Tavsiye: Si yo fuera tú…"],"sections":[{"kind":"other","title":"Tipo 1: si + presente, futuro / imperativo","formula":[{"tr":"Si","en":"Si","role":"x"},{"tr":"Fiil (presente)","en":"Verbo (presente)","role":"v"},{"tr":", Ana cümle","en":", Oración principal","role":"s"},{"tr":"Fiil (futuro / imperativo)","en":"Verbo (futuro / imperativo)","role":"v"}],"examples":[{"text":"[x:Si] [v:llueve], [s:nosotros] [v:nos quedaremos] [o:en casa].","tr":"Yağmur yağarsa evde kalırız."},{"text":"[x:Si] [v:ves] [o:a Marta], [v:dile] [o:que la llamo luego].","tr":"Marta’yı görürsen onu sonra arayacağımı söyle."}]},{"kind":"other","title":"Tipo 2: si + imp. subj., condicional","formula":[{"tr":"Si","en":"Si","role":"x"},{"tr":"Fiil (imp. subj.)","en":"Verbo (imperfecto de subjuntivo)","role":"v"},{"tr":", Ana cümle","en":", Oración principal","role":"s"},{"tr":"Fiil (condicional)","en":"Verbo (condicional)","role":"v"}],"examples":[{"text":"[x:Si] [v:tuviera] [o:dinero], [v:viajaría] [o:por todo el mundo].","tr":"Param olsa bütün dünyayı gezerdim."},{"text":"[x:Si] [s:yo] [v:fuera] [o:tú], [v:hablaría] [o:con ella].","tr":"Senin yerinde olsam onunla konuşurdum."}]},{"kind":"other","title":"Soru","formula":[{"tr":"¿Qué + condicional","en":"¿Qué + condicional","role":"q"},{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"si + imp. subj. + ?","en":"si + imperfecto de subjuntivo + ?","role":"x"}],"examples":[{"text":"¿[q:Qué harías] [s:tú] [x:si te tocara la lotería]?","tr":"Piyango sana çıksa ne yapardın?"}]}],"rules":["si’den sonra asla presente de subjuntivo, futuro veya condicional gelmez.","si cümlesi sona da gelebilir; o zaman virgül konmaz: Viajaría si tuviera dinero.","Tipo 1’de ana cümle presente de olabilir: Si estudias, apruebas."],"exceptions":[],"mistakes":[{"wrong":"Si tendría dinero, viajaría.","right":"Si tuviera dinero, viajaría.","note":"si’den sonra condicional gelmez."},{"wrong":"Si llueva, no saldré.","right":"Si llueve, no saldré.","note":"si’den sonra presente de subjuntivo kullanılmaz."},{"wrong":"Si lloverá, me quedo.","right":"Si llueve, me quedo.","note":"si’den sonra futuro gelmez."}]}},
  {"id":"es-gr-subjuntivo-en-oraciones-temporales","languageId":"es","category":"grammar","level":"B2","sourceText":"Subjuntivo en oraciones temporales","translations":{"tr":["Zaman Yan Cümlelerinde Subjuntivo"]},"grammar":{"summary":"Zaman bağlaçlarından sonra gelecekteki eylem subjuntivo, alışkanlık veya geçmiş indicativo ile anlatılır.","uses":["Gelecekteki bir zamanı bildirmek (cuando llegues)","Alışkanlık ve geçmiş olaylar (cuando llego, cuando llegué)","antes de que ile her zaman subjuntivo"],"sections":[{"kind":"other","title":"Gelecek: cuando + subjuntivo","formula":[{"tr":"Cuando / en cuanto / hasta que","en":"Cuando / en cuanto / hasta que","role":"x"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"},{"tr":", Ana cümle","en":", Oración principal","role":"o"}],"examples":[{"text":"[x:Cuando] [v:llegues] [o:a casa], [v:llámame].","tr":"Eve vardığında beni ara."},{"text":"[v:Espera] [x:hasta que] [v:vuelva] [s:tu padre].","tr":"Baban dönene kadar bekle."}]},{"kind":"other","title":"Alışkanlık / geçmiş: cuando + indicativo","formula":[{"tr":"Cuando","en":"Cuando","role":"x"},{"tr":"Fiil (indicativo)","en":"Verbo (indicativo)","role":"v"},{"tr":", Ana cümle","en":", Oración principal","role":"o"}],"examples":[{"text":"[x:Cuando] [v:llego] [o:a casa], [v:ceno].","tr":"Eve geldiğimde akşam yemeği yerim."},{"text":"[x:Cuando] [v:era] [o:niño], [v:vivía] [o:en Sevilla].","tr":"Çocukken Sevilla’da yaşıyordum."}]},{"kind":"other","title":"Antes de que + subjuntivo","formula":[{"tr":"Ana cümle","en":"Oración principal","role":"v"},{"tr":"antes de que","en":"antes de que","role":"x"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Vámonos] [x:antes de que] [v:empiece] [o:a llover].","tr":"Yağmur başlamadan gidelim."}]},{"kind":"other","title":"Aynı özne → mastar","formula":[{"tr":"Antes de / después de / hasta","en":"Antes de / después de / hasta","role":"x"},{"tr":"Mastar","en":"Infinitivo","role":"v"},{"tr":", Ana cümle","en":", Oración principal","role":"o"}],"examples":[{"text":"[x:Antes de] [v:salir], [v:cierro] [o:las ventanas].","tr":"Çıkmadan önce pencereleri kapatırım."}]}],"rules":["Bağlaçlar: cuando, en cuanto, tan pronto como, hasta que, mientras, después de que, siempre que.","Gelecekten söz ediliyorsa subjuntivo, alışkanlık ya da geçmişse indicativo kullanılır.","antes de que her durumda subjuntivo alır.","Soru kelimesi ¿cuándo? subjuntivo almaz: ¿Cuándo vendrás?"],"exceptions":[],"mistakes":[{"wrong":"Cuando llegarás, llámame.","right":"Cuando llegues, llámame.","note":"cuando’dan sonra futuro gelmez."},{"wrong":"Antes de que llega, limpio.","right":"Antes de que llegue, limpio.","note":"antes de que her zaman subjuntivo alır."},{"wrong":"Antes de que yo salga, cierro la puerta.","right":"Antes de salir, cierro la puerta.","note":"Özne aynıysa mastar kullanılır."}]}},
  {"id":"es-gr-oraciones-finales-para-que","languageId":"es","category":"grammar","level":"B2","sourceText":"Oraciones finales (para que)","translations":{"tr":["Amaç Yan Cümleleri (para que)"]},"grammar":{"summary":"Amaç bildiren yan cümlelerde özne farklıysa para que + subjuntivo, aynıysa para + mastar kullanılır.","uses":["Bir eylemin amacını bildirmek (-sın diye, -mesi için)","Resmî dilde a fin de que, con el fin de que","Soru: ¿Para qué…?"],"sections":[{"kind":"other","title":"Para que + subjuntivo (farklı özne)","formula":[{"tr":"Ana cümle","en":"Oración principal","role":"v"},{"tr":"para que","en":"para que","role":"x"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Te lo explico] [x:para que] [v:lo entiendas] [o:bien].","tr":"İyi anlaman için sana açıklıyorum."},{"text":"[v:Hablé] [o:despacio] [x:para que] [s:todos] [v:me entendieran].","tr":"Herkes beni anlasın diye yavaş konuştum."}],"notes":["Ana cümle geçmişteyse imperfecto de subjuntivo gelir."]},{"kind":"other","title":"Para + mastar (aynı özne)","formula":[{"tr":"Ana cümle","en":"Oración principal","role":"v"},{"tr":"para","en":"para","role":"x"},{"tr":"Mastar","en":"Infinitivo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Estudio] [x:para] [v:aprobar] [o:el examen].","tr":"Sınavı geçmek için çalışıyorum."}]},{"kind":"other","title":"Resmî: a fin de que / con el fin de que","formula":[{"tr":"Ana cümle","en":"Oración principal","role":"v"},{"tr":"a fin de que","en":"a fin de que","role":"x"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Enviamos] [o:el documento] [x:a fin de que] [v:lo revisen] [o:antes del lunes].","tr":"Pazartesiden önce incelemeniz amacıyla belgeyi gönderiyoruz."}]},{"kind":"other","title":"¿Para qué…? sorusu","formula":[{"tr":"¿Para qué","en":"¿Para qué","role":"q"},{"tr":"Fiil (indicativo)","en":"Verbo (indicativo)","role":"v"},{"tr":"Tümleç + ?","en":"Complemento + ?","role":"o"}],"examples":[{"text":"¿[q:Para qué] [v:sirve] [o:este botón]?","tr":"Bu düğme ne işe yarar?"}]}],"rules":["Amaç bildiren que’li yan cümle her zaman subjuntivo alır.","Hareket fiillerinden sonra a que da kullanılır: Vengo a que me ayudes."],"exceptions":[],"mistakes":[{"wrong":"Te llamo para que me ayudas.","right":"Te llamo para que me ayudes.","note":"para que her zaman subjuntivo alır."},{"wrong":"Trabajo para que yo gane dinero.","right":"Trabajo para ganar dinero.","note":"Özne aynıysa para + mastar kullanılır."}]}},
  {"id":"es-gr-pronombres-relativos-que-quien-donde-el-que","languageId":"es","category":"grammar","level":"B2","sourceText":"Pronombres relativos: que, quien, donde, el que","translations":{"tr":["İlgi Zamirleri: que, quien, donde, el que"]},"grammar":{"summary":"İlgi zamirleri iki cümleyi birleştirip bir ismi tanımlar; Türkçedeki -an, -dığı yapılarına karşılık gelir.","uses":["Bir kişiyi veya şeyi tanımlamak (el libro que leo)","Edattan sonra kişi ve şey (con quien, en el que)","Yer bildirmek (donde)"],"sections":[{"kind":"other","title":"que (kişi ve şey)","formula":[{"tr":"İsim","en":"Antecedente","role":"s"},{"tr":"que","en":"que","role":"x"},{"tr":"Yan cümle","en":"Oración de relativo","role":"v"}],"examples":[{"text":"[s:El libro] [x:que] [v:estoy leyendo] es muy bueno.","tr":"Okuduğum kitap çok iyi."},{"text":"[s:La chica] [x:que] [v:vive arriba] es médica.","tr":"Üst katta oturan kız doktor."}]},{"kind":"other","title":"Edat + el que / la que / los que","formula":[{"tr":"İsim","en":"Antecedente","role":"s"},{"tr":"Edat + el/la/los/las que","en":"Preposición + artículo + que","role":"x"},{"tr":"Yan cümle","en":"Oración de relativo","role":"v"}],"examples":[{"text":"Esa es [s:la empresa] [x:en la que] [v:trabajo].","tr":"Çalıştığım şirket bu."},{"text":"[s:Los amigos] [x:con los que] [v:viajé] son de Cádiz.","tr":"Birlikte seyahat ettiğim arkadaşlar Cádizli."}]},{"kind":"other","title":"Edat + quien (sadece kişi)","formula":[{"tr":"Kişi","en":"Antecedente (persona)","role":"s"},{"tr":"Edat + quien(es)","en":"Preposición + quien(es)","role":"x"},{"tr":"Yan cümle","en":"Oración de relativo","role":"v"}],"examples":[{"text":"[s:La persona] [x:con quien] [v:hablé] era muy amable.","tr":"Konuştuğum kişi çok kibardı."}]},{"kind":"other","title":"donde (yer)","formula":[{"tr":"Yer ismi","en":"Antecedente (lugar)","role":"s"},{"tr":"donde","en":"donde","role":"x"},{"tr":"Yan cümle","en":"Oración de relativo","role":"v"}],"examples":[{"text":"[s:Este es el pueblo] [x:donde] [v:nací].","tr":"Bu doğduğum köy."}]}],"rules":["Edatsız durumda kişi için de genellikle que kullanılır: el chico que conocí.","Edat ilgi zamirinin önüne gelir; İngilizcedeki gibi cümle sonunda kalmaz.","Belirli bir öncül yoksa lo que kullanılır: Lo que dices es verdad."],"exceptions":["Virgüllü (açıklayıcı) cümlede kişi için quien da olur: Mi hermana, quien vive en Lima, viene mañana."],"mistakes":[{"wrong":"La empresa que trabajo en…","right":"La empresa en la que trabajo…","note":"Edat ilgi zamirinin önüne gelir."},{"wrong":"El chico quien conocí es simpático.","right":"El chico que conocí es simpático.","note":"Edatsız tanımlayıcı cümlede quien kullanılmaz."},{"wrong":"Que dices es verdad.","right":"Lo que dices es verdad.","note":"Öncül yoksa lo que gerekir."}]}},
  {"id":"es-gr-subjuntivo-en-oraciones-de-relativo","languageId":"es","category":"grammar","level":"B2","sourceText":"Subjuntivo en oraciones de relativo","translations":{"tr":["İlgi Cümlelerinde Subjuntivo"]},"grammar":{"summary":"İlgi cümlesindeki varlık bilinmiyor, aranıyor veya yoksa subjuntivo; bilinen gerçek bir varlıksa indicativo kullanılır.","uses":["Aranan ama bilinmeyen kişi/şey (busco a alguien que sepa)","Var olmadığı söylenen şeyler (no hay nadie que…)","Bilinen varlıkla karşılaştırma (conozco a alguien que sabe)"],"sections":[{"kind":"other","title":"Bilinmeyen öncül + subjuntivo","formula":[{"tr":"Busco / necesito + isim","en":"Busco / necesito + antecedente","role":"s"},{"tr":"que","en":"que","role":"x"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Busco un piso] [x:que] [v:tenga] [o:terraza].","tr":"Terası olan bir daire arıyorum."},{"text":"[s:Necesitamos a alguien] [x:que] [v:hable] [o:alemán].","tr":"Almanca bilen birine ihtiyacımız var."}]},{"kind":"other","title":"Bilinen öncül + indicativo","formula":[{"tr":"Tengo / conozco + isim","en":"Tengo / conozco + antecedente","role":"s"},{"tr":"que","en":"que","role":"x"},{"tr":"Fiil (indicativo)","en":"Verbo (indicativo)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Tengo un piso] [x:que] [v:tiene] [o:terraza].","tr":"Teraslı bir dairem var."}]},{"kind":"other","title":"Olumsuz öncül + subjuntivo","formula":[{"tr":"No hay nadie / nada / ningún","en":"No hay nadie / nada / ningún","role":"s"},{"tr":"que","en":"que","role":"x"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"}],"examples":[{"text":"[s:No hay nadie] [x:que] [v:lo sepa].","tr":"Bunu bilen kimse yok."},{"text":"¿[s:Hay algún restaurante] [x:que] [v:abra] [o:los lunes]?","tr":"Pazartesi açık olan bir restoran var mı?"}]},{"kind":"other","title":"Lo que + subjuntivo (belirsizlik)","formula":[{"tr":"Ana cümle","en":"Oración principal","role":"v"},{"tr":"lo que / donde / como","en":"lo que / donde / como","role":"x"},{"tr":"Fiil (subjuntivo)","en":"Verbo (subjuntivo)","role":"v"}],"examples":[{"text":"[v:Haz] [x:lo que] [v:quieras].","tr":"Ne istersen yap."},{"text":"[v:Iremos] [x:donde] [v:digas].","tr":"Nereyi söylersen oraya gideriz."}]}],"rules":["Bilinmeyen/aranan öncülde a düşer: Busco un médico que… (belirli kişi için a: Busco al médico que…).","Ana cümle geçmişteyse imperfecto de subjuntivo gelir: Buscaba a alguien que supiera inglés."],"exceptions":[],"mistakes":[{"wrong":"Busco a alguien que habla chino.","right":"Busco a alguien que hable chino.","note":"Aranan, belirsiz kişi için subjuntivo gerekir."},{"wrong":"No hay nadie que puede ayudarme.","right":"No hay nadie que pueda ayudarme.","note":"Var olmayan öncül subjuntivo ister."}]}},
  {"id":"es-gr-voz-pasiva-con-ser","languageId":"es","category":"grammar","level":"B2","sourceText":"Voz pasiva con ser","translations":{"tr":["Edilgen Çatı (ser + participio)"]},"grammar":{"summary":"Ser + ortaç ile kurulan edilgen yapı, eylemi yapan yerine eylemden etkilenene odaklanır; daha çok yazı dilindedir.","uses":["Haber ve resmî metinler","Eylemi yapanı por ile belirtmek","Sonuç durumu için estar + participio"],"sections":[{"kind":"other","title":"Ser + ortaç (+ por)","formula":[{"tr":"Özne","en":"Sujeto paciente","role":"s"},{"tr":"ser (çekimli)","en":"ser (conjugado)","role":"a"},{"tr":"Ortaç (uyumlu)","en":"Participio (concordado)","role":"v"},{"tr":"por + eden","en":"por + agente","role":"o"}],"examples":[{"text":"[s:El museo] [a:fue] [v:inaugurado] [o:por el rey].","tr":"Müze kral tarafından açıldı."},{"text":"[s:Las casas] [a:serán] [v:construidas] [o:en 2027].","tr":"Evler 2027’de inşa edilecek."}],"notes":["Ortaç öznenin cinsiyet ve sayısına uyar."]},{"kind":"other","title":"Etken → edilgen","formula":[{"tr":"Etken: Özne + fiil + nesne","en":"Activa: Sujeto + verbo + OD","role":"x"},{"tr":"Edilgen: Nesne + ser + ortaç + por + özne","en":"Pasiva: OD + ser + participio + por + agente","role":"x"}],"examples":[{"text":"[s:Cervantes] [v:escribió] [o:el Quijote]. → [s:El Quijote] [a:fue] [v:escrito] [o:por Cervantes].","tr":"Quijote’yi Cervantes yazdı. → Quijote Cervantes tarafından yazıldı."}]},{"kind":"other","title":"Estar + ortaç (sonuç durumu)","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"estar (çekimli)","en":"estar (conjugado)","role":"a"},{"tr":"Ortaç (uyumlu)","en":"Participio (concordado)","role":"v"}],"examples":[{"text":"[s:La tienda] [a:está] [v:cerrada].","tr":"Dükkân kapalı."},{"text":"[s:Las entradas] [a:ya están] [v:vendidas].","tr":"Biletler zaten satılmış."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto paciente","role":"s"},{"tr":"no + ser","en":"no + ser","role":"a"},{"tr":"Ortaç","en":"Participio","role":"v"},{"tr":"por + eden","en":"por + agente","role":"o"}],"examples":[{"text":"[s:La propuesta] [a:no fue] [v:aceptada] [o:por la junta].","tr":"Öneri yönetim kurulunca kabul edilmedi."}]}],"rules":["ser edilgeni eylemi, estar + participio sonuç durumunu anlatır.","Günlük konuşmada ser edilgeni yerine çoğunlukla se’li edilgen veya etken çatı tercih edilir.","Sadece geçişli fiiller edilgen yapılabilir."],"exceptions":["Duygu ve algı fiillerinde ser edilgeni nadirdir: ✗ La película fue vista por mí."],"mistakes":[{"wrong":"La carta fue escrito por Ana.","right":"La carta fue escrita por Ana.","note":"Ortaç özneyle uyumlu olmalı."},{"wrong":"La puerta es abierta.","right":"La puerta está abierta.","note":"Durum bildirirken estar kullanılır."}]}},
  {"id":"es-gr-se-pasiva-y-se-impersonal","languageId":"es","category":"grammar","level":"B2","sourceText":"Se pasiva y se impersonal","translations":{"tr":["Se’li Edilgen ve Kişisiz Se"]},"grammar":{"summary":"Se + 3. kişi fiil, eylemi yapan önemli olmadığında edilgen veya genel/kişisiz anlam verir (-ılır, -ınır).","uses":["İlan ve tabelalar (Se vende piso)","Genel kurallar ve alışkanlıklar (Aquí se come bien)","Kişi belirtmeden talimat (Se necesita…)"],"sections":[{"kind":"other","title":"Se pasiva: fiil isimle uyumlu","formula":[{"tr":"se","en":"se","role":"x"},{"tr":"Fiil (3. tekil/çoğul)","en":"Verbo (3.ª persona sg./pl.)","role":"v"},{"tr":"İsim","en":"Sujeto paciente","role":"s"}],"examples":[{"text":"[x:Se] [v:vende] [s:piso].","tr":"Satılık daire."},{"text":"[x:Se] [v:alquilan] [s:habitaciones].","tr":"Kiralık odalar."}],"notes":["İsim çoğulsa fiil de çoğul olur."]},{"kind":"other","title":"Se impersonal: fiil hep tekil","formula":[{"tr":"se","en":"se","role":"x"},{"tr":"Fiil (3. tekil)","en":"Verbo (3.ª persona sg.)","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"Aquí [x:se] [v:vive] [o:muy bien].","tr":"Burada çok iyi yaşanır."},{"text":"[x:Se] [v:busca] [o:a dos camareros].","tr":"İki garson aranıyor."}],"notes":["Kişi nesnesi a ile gelirse fiil tekil kalır."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"No + se","en":"No + se","role":"x"},{"tr":"Fiil (3. kişi)","en":"Verbo (3.ª persona)","role":"v"},{"tr":"İsim / tümleç","en":"Sujeto / complemento","role":"o"}],"examples":[{"text":"[x:No se] [v:puede] [o:fumar aquí].","tr":"Burada sigara içilmez."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"¿ + (soru kelimesi) + se","en":"¿ + (interrogativo) + se","role":"q"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Tümleç + ?","en":"Complemento + ?","role":"o"}],"examples":[{"text":"¿[q:Cómo se] [v:dice] [o:“gracias” en turco]?","tr":"“Gracias” Türkçede nasıl denir?"}]}],"rules":["Se’li edilgende fiil, isimle tekil/çoğul uyumu yapar: se vende / se venden.","Dönüşlü fiillerle kişisiz yapı için uno/la gente kullanılır: Uno se acostumbra.","Bu yapıda por + eden kullanılmaz."],"exceptions":[],"mistakes":[{"wrong":"Se venden coche.","right":"Se vende coche.","note":"Tekil isimle fiil tekil olur."},{"wrong":"Se vende pisos.","right":"Se venden pisos.","note":"Çoğul isimle fiil çoğul olur."},{"wrong":"Se buscan a dos camareros.","right":"Se busca a dos camareros.","note":"a + kişi nesnesiyle fiil tekil kalır."}]}}
]
