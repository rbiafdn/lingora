[
  {"id":"es-gr-articulos-y-genero-del-sustantivo","languageId":"es","category":"grammar","level":"A1","sourceText":"Artículos y género del sustantivo","translations":{"tr":["Artikeller ve İsmin Cinsiyeti"]},"grammar":{"summary":"İspanyolcada her isim eril ya da dişildir; artikel ismin cinsiyetine ve sayısına uyar.","uses":["Belirli bir varlıktan söz etmek (el libro)","İlk kez ya da belirsiz biçimde söz etmek (un libro)","İsmin cinsiyetini öğrenmek için artikelle ezberlemek"],"sections":[{"kind":"other","title":"Belirli artikel + isim","formula":[{"tr":"Belirli artikel (el / la / los / las)","en":"Artículo definido","role":"x"},{"tr":"İsim","en":"Sustantivo","role":"o"}],"examples":[{"text":"[x:El] [o:libro] está en la mesa.","tr":"Kitap masanın üstünde."},{"text":"[x:La] [o:casa] es grande.","tr":"Ev büyük."}],"notes":["el eril tekil, la dişil tekil, los eril çoğul, las dişil çoğul."]},{"kind":"other","title":"Belirsiz artikel + isim","formula":[{"tr":"Belirsiz artikel (un / una / unos / unas)","en":"Artículo indefinido","role":"x"},{"tr":"İsim","en":"Sustantivo","role":"o"}],"examples":[{"text":"Tengo [x:un] [o:perro].","tr":"Bir köpeğim var."},{"text":"Quiero [x:una] [o:manzana].","tr":"Bir elma istiyorum."}],"notes":["unos / unas çoğulda \"birkaç, bazı\" anlamı verir."]},{"kind":"other","title":"Cinsiyeti gösteren sonlar","formula":[{"tr":"-o ile biten → genelde eril","en":"Masculino (-o)","role":"o"},{"tr":"-a ile biten → genelde dişil","en":"Femenino (-a)","role":"o"}],"examples":[{"text":"[o:el chico] / [o:la chica]","tr":"oğlan / kız"},{"text":"[o:la canción], [o:la ciudad]","tr":"şarkı, şehir"}],"notes":["-ción, -sión, -dad, -tad ile bitenler dişildir."]},{"kind":"other","title":"a + el / de + el kaynaşması","formula":[{"tr":"a / de","en":"Preposición","role":"x"},{"tr":"el","en":"Artículo","role":"x"},{"tr":"→ al / del","en":"Contracción","role":"x"}],"examples":[{"text":"Voy [x:al] cine.","tr":"Sinemaya gidiyorum."},{"text":"Es el coche [x:del] profesor.","tr":"Bu öğretmenin arabası."}]}],"rules":["Her ismi artikeliyle birlikte öğren: el libro, la mesa.","Artikel ismin hem cinsiyetine hem sayısına uyar.","a + el → al, de + el → del olur; la, los, las ile birleşme olmaz."],"exceptions":["Bazı -a ile biten isimler erildir: el día, el mapa, el problema, el idioma.","Bazı -o ile biten isimler dişildir: la mano, la foto, la moto."],"mistakes":[{"wrong":"la problema","right":"el problema","note":"-ma ile biten Yunanca kökenli isimler çoğunlukla erildir."},{"wrong":"Voy a el parque.","right":"Voy al parque.","note":"a + el her zaman al olur."},{"wrong":"Soy un profesor.","right":"Soy profesor.","note":"Meslek söylerken ser fiilinden sonra genelde artikel kullanılmaz."}]}},
  {"id":"es-gr-plural-y-concordancia","languageId":"es","category":"grammar","level":"A1","sourceText":"Plural y concordancia","translations":{"tr":["Çoğul ve Sıfat Uyumu"]},"grammar":{"summary":"İsimler -s / -es ile çoğul olur; sıfat ve artikel ismin cinsiyet ve sayısına uyar.","uses":["Birden fazla varlıktan söz etmek","İsmi bir sıfatla nitelemek","Artikel, isim ve sıfatı birbirine uydurmak"],"sections":[{"kind":"other","title":"Ünlüyle biten isim + -s","formula":[{"tr":"İsim (ünlüyle biten)","en":"Sustantivo","role":"o"},{"tr":"+ -s","en":"Plural -s","role":"x"}],"examples":[{"text":"[o:el libro] → [o:los libros]","tr":"kitap → kitaplar"},{"text":"[o:la casa] → [o:las casas]","tr":"ev → evler"}]},{"kind":"other","title":"Ünsüzle biten isim + -es","formula":[{"tr":"İsim (ünsüzle biten)","en":"Sustantivo","role":"o"},{"tr":"+ -es","en":"Plural -es","role":"x"}],"examples":[{"text":"[o:el señor] → [o:los señores]","tr":"bey → beyler"},{"text":"[o:la ciudad] → [o:las ciudades]","tr":"şehir → şehirler"}],"notes":["-z ile bitenlerde z → c olur: el lápiz → los lápices."]},{"kind":"other","title":"Artikel + isim + sıfat","formula":[{"tr":"Artikel","en":"Artículo","role":"x"},{"tr":"İsim","en":"Sustantivo","role":"o"},{"tr":"Sıfat (uyumlu)","en":"Adjetivo","role":"x"}],"examples":[{"text":"[x:las] [o:casas] [x:blancas]","tr":"beyaz evler"},{"text":"[x:un] [o:chico] [x:alto]","tr":"uzun boylu bir oğlan"}],"notes":["Sıfat genellikle isimden sonra gelir."]},{"kind":"other","title":"Cinsiyeti değişmeyen sıfatlar","formula":[{"tr":"İsim","en":"Sustantivo","role":"o"},{"tr":"-e / ünsüzle biten sıfat","en":"Adjetivo invariable","role":"x"}],"examples":[{"text":"[o:un libro] [x:interesante] / [o:una película] [x:interesante]","tr":"ilginç bir kitap / ilginç bir film"},{"text":"[o:los coches] [x:azules]","tr":"mavi arabalar"}]}],"rules":["-o ile biten sıfatlar dört biçim alır: alto, alta, altos, altas.","-e veya ünsüzle biten sıfatlar sadece sayıya göre değişir: grande, grandes; fácil, fáciles.","Eril ve dişil karışık bir grup için eril çoğul kullanılır: los padres (anne ve baba)."],"exceptions":["Vurgulu son heceli bazı isimler çoğulda vurgu işaretini kaybeder: la canción → las canciones.","-s ile biten ve son hecesi vurgusuz isimler değişmez: el lunes → los lunes."],"mistakes":[{"wrong":"las casa blancas","right":"las casas blancas","note":"Çoğulluk isme de eklenir; Türkçedeki gibi sadece bir yerde gösterilmez."},{"wrong":"unas chicas altos","right":"unas chicas altas","note":"Sıfat ismin cinsiyetine uyar."},{"wrong":"los lápizes","right":"los lápices","note":"-z çoğulda -ces olur."}]}},
  {"id":"es-gr-pronombres-personales-de-sujeto","languageId":"es","category":"grammar","level":"A1","sourceText":"Pronombres personales de sujeto","translations":{"tr":["Özne Zamirleri"]},"grammar":{"summary":"Özne zamirleri kişiyi gösterir; fiil çekimi kişiyi zaten belirttiği için çoğu zaman düşürülür.","uses":["Kişiyi vurgulamak veya karşılaştırmak","Belirsizliği gidermek (él / ella / usted)","Resmî hitap (usted / ustedes)"],"sections":[{"kind":"other","title":"Zamir tablosu","formula":[{"tr":"yo / tú / él, ella, usted","en":"Singular","role":"s"},{"tr":"nosotros/as / vosotros/as / ellos, ellas, ustedes","en":"Plural","role":"s"}],"examples":[{"text":"[s:Yo] [v:soy] turco.","tr":"Ben Türküm."},{"text":"[s:Ustedes] [v:hablan] muy bien.","tr":"Siz çok iyi konuşuyorsunuz."}],"notes":["vosotros sadece İspanya’da kullanılır; Latin Amerika’da ustedes hem samimi hem resmîdir."]},{"kind":"other","title":"Zamirsiz kullanım","formula":[{"tr":"Çekimli fiil (kişiyi gösterir)","en":"Verbo conjugado","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[v:Hablo] [o:español].","tr":"İspanyolca konuşurum."},{"text":"[v:Vivimos] [o:en Madrid].","tr":"Madrid’de yaşıyoruz."}],"notes":["Türkçedeki gibi kişi eki yeterlidir; zamir vurgu için kullanılır."]},{"kind":"other","title":"Vurgu / karşıtlık","formula":[{"tr":"Zamir","en":"Pronombre sujeto","role":"s"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Yo] [v:trabajo] y [s:tú] [v:estudias].","tr":"Ben çalışıyorum, sen ise okuyorsun."}]},{"kind":"other","title":"Resmî hitap: usted","formula":[{"tr":"Usted / Ustedes","en":"Usted","role":"s"},{"tr":"3. tekil / çoğul fiil","en":"Verbo (3.ª persona)","role":"v"}],"examples":[{"text":"¿[s:Usted] [v:es] el señor García?","tr":"Siz Bay García mısınız?"}]}],"rules":["Fiil çekimi kişiyi gösterdiği için zamir genelde kullanılmaz.","usted ve ustedes 3. şahıs gibi çekilir.","nosotros, vosotros, ellos grupta en az bir erkek varsa kullanılır; tamamen kadınsa nosotras, vosotras, ellas."],"exceptions":["“It” için özne zamiri yoktur: Llueve. (Yağmur yağıyor.)"],"mistakes":[{"wrong":"Usted eres muy amable.","right":"Usted es muy amable.","note":"usted 3. tekil şahıs çekimi alır."},{"wrong":"Ello es grande.","right":"Es grande.","note":"Nesneler için özne zamiri kullanılmaz."},{"wrong":"Yo soy estudiante y yo vivo aquí.","right":"Soy estudiante y vivo aquí.","note":"Gereksiz tekrar doğal değildir."}]}},
  {"id":"es-gr-el-verbo-ser","languageId":"es","category":"grammar","level":"A1","sourceText":"El verbo ser","translations":{"tr":["Ser Fiili"]},"grammar":{"summary":"Ser, kimlik, köken, meslek ve kalıcı özellikleri anlatan \"olmak\" fiilidir.","uses":["Kimlik ve isim (Soy Ana)","Milliyet ve köken (Soy de Turquía)","Meslek (Es médico)","Kalıcı özellikler, saat ve tarih"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"soy / eres / es / somos / sois / son","en":"Ser","role":"a"},{"tr":"Tümleç","en":"Atributo","role":"o"}],"examples":[{"text":"[s:Yo] [a:soy] [o:de Estambul].","tr":"Ben İstanbulluyum."},{"text":"[s:Ella] [a:es] [o:médica].","tr":"O doktor."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no","en":"No","role":"x"},{"tr":"ser","en":"Ser","role":"a"},{"tr":"Tümleç","en":"Atributo","role":"o"}],"examples":[{"text":"[s:Nosotros] [x:no] [a:somos] [o:españoles].","tr":"Biz İspanyol değiliz."},{"text":"[x:No] [a:es] [o:caro].","tr":"Pahalı değil."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"ser","en":"Ser","role":"a"},{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"Tümleç?","en":"Atributo","role":"o"}],"examples":[{"text":"¿[a:Eres] [s:tú] [o:estudiante]?","tr":"Sen öğrenci misin?"},{"text":"¿[a:Es] [o:nuevo]?","tr":"Yeni mi?"}],"notes":["Soru, tonlama ile ya da özne fiilden sonraya alınarak kurulur; başta ¿ yazılır."]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"ser","en":"Ser","role":"a"},{"tr":"Özne?","en":"Sujeto","role":"s"}],"examples":[{"text":"¿[q:De dónde] [a:eres] [s:tú]?","tr":"Nerelisin?"},{"text":"¿[q:Qué hora] [a:es]?","tr":"Saat kaç?"}]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Sí / No","en":"Sí / No","role":"x"},{"tr":"(no) ser","en":"Ser","role":"a"}],"examples":[{"text":"—¿Es usted el doctor? —Sí, [a:soy] yo.","tr":"—Doktor siz misiniz? —Evet, benim."},{"text":"—¿Eres francés? —[x:No], [x:no] [a:soy] francés.","tr":"—Fransız mısın? —Hayır, değilim."}]}],"rules":["Çekim: soy, eres, es, somos, sois, son.","Olumsuzda no fiilden hemen önce gelir.","Saat ve tarih ser ile söylenir: Son las tres. Hoy es lunes."],"exceptions":["Saat 1 için tekil kullanılır: Es la una."],"mistakes":[{"wrong":"Estoy profesor.","right":"Soy profesor.","note":"Meslek ser ile söylenir."},{"wrong":"Yo es turco.","right":"Yo soy turco.","note":"Fiil özneye göre çekilir."},{"wrong":"Soy no casado.","right":"No soy casado.","note":"no fiilden önce gelir."}]}},
  {"id":"es-gr-el-verbo-estar","languageId":"es","category":"grammar","level":"A1","sourceText":"El verbo estar","translations":{"tr":["Estar Fiili"]},"grammar":{"summary":"Estar, yer ve geçici durumları (ruh hâli, sağlık, durum) anlatan \"olmak / bulunmak\" fiilidir.","uses":["Yer bildirmek (Estoy en casa)","Geçici durum ve duygular (Estoy cansado)","Selamlaşma (¿Cómo estás?)","estar + gerundio yapısında"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"estoy / estás / está / estamos / estáis / están","en":"Estar","role":"a"},{"tr":"Yer / durum","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Mis padres] [a:están] [o:en Ankara].","tr":"Annemle babam Ankara’da."},{"text":"[a:Estoy] [o:muy cansada].","tr":"Çok yorgunum."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no","en":"No","role":"x"},{"tr":"estar","en":"Estar","role":"a"},{"tr":"Yer / durum","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Juan] [x:no] [a:está] [o:aquí].","tr":"Juan burada değil."},{"text":"[x:No] [a:estamos] [o:listos].","tr":"Hazır değiliz."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"estar","en":"Estar","role":"a"},{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"Yer / durum?","en":"Complemento","role":"o"}],"examples":[{"text":"¿[a:Está] [s:Ana] [o:en casa]?","tr":"Ana evde mi?"},{"text":"¿[a:Estás] [o:bien]?","tr":"İyi misin?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"estar","en":"Estar","role":"a"},{"tr":"Özne?","en":"Sujeto","role":"s"}],"examples":[{"text":"¿[q:Dónde] [a:está] [s:el baño]?","tr":"Tuvalet nerede?"},{"text":"¿[q:Cómo] [a:estás]?","tr":"Nasılsın?"}]}],"rules":["Çekim: estoy, estás, está, estamos, estáis, están (vurgu işaretlerine dikkat).","Bir şeyin/kişinin nerede olduğu her zaman estar ile söylenir.","Geçici durum bildiren sıfatlar estar ile kullanılır: estar enfermo, estar contento."],"exceptions":["Olay yeri (parti, toplantı) ser ile söylenir: La fiesta es en mi casa."],"mistakes":[{"wrong":"Madrid es en España.","right":"Madrid está en España.","note":"Konum estar ile anlatılır."},{"wrong":"Soy cansado.","right":"Estoy cansado.","note":"Yorgunluk geçici bir durumdur."},{"wrong":"Esta bien.","right":"Está bien.","note":"Vurgu işareti olmadan esta \"bu\" anlamına gelir."}]}},
  {"id":"es-gr-ser-y-estar","languageId":"es","category":"grammar","level":"A1","sourceText":"Ser y estar","translations":{"tr":["Ser ve Estar Farkı"]},"grammar":{"summary":"Ser bir şeyin ne olduğunu, estar ise nasıl ya da nerede olduğunu anlatır.","uses":["Kalıcı/tanımlayıcı özellik → ser","Geçici durum veya sonuç → estar","Konum → estar, olayın yeri → ser","Anlamı değişen sıfatlar (listo, aburrido)"],"sections":[{"kind":"other","title":"Ser + tanım","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"ser","en":"Ser","role":"a"},{"tr":"Kimlik / özellik","en":"Atributo","role":"o"}],"examples":[{"text":"[s:Mi hermano] [a:es] [o:alto y simpático].","tr":"Kardeşim uzun boylu ve sempatik."},{"text":"[s:Esta mesa] [a:es] [o:de madera].","tr":"Bu masa ahşaptan."}]},{"kind":"other","title":"Estar + durum","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"estar","en":"Estar","role":"a"},{"tr":"Geçici durum","en":"Estado","role":"o"}],"examples":[{"text":"[s:La sopa] [a:está] [o:fría].","tr":"Çorba soğumuş."},{"text":"[x:Hoy] [a:estoy] [o:nervioso].","tr":"Bugün gerginim."}]},{"kind":"other","title":"Anlamı değişen sıfatlar","formula":[{"tr":"ser + sıfat","en":"Ser + adjetivo","role":"a"},{"tr":"↔","en":"↔","role":"x"},{"tr":"estar + sıfat","en":"Estar + adjetivo","role":"a"}],"examples":[{"text":"[a:Es] [o:aburrido]. / [a:Está] [o:aburrido].","tr":"O sıkıcı biri. / O sıkılmış."},{"text":"[a:Es] [o:listo]. / [a:Está] [o:listo].","tr":"O zeki. / O hazır."}],"notes":["Diğerleri: ser/estar malo (kötü / hasta), ser/estar rico (zengin / lezzetli)."]},{"kind":"other","title":"Konum ve olay","formula":[{"tr":"Varlık + estar + yer","en":"Estar + lugar","role":"a"},{"tr":"Olay + ser + yer","en":"Ser + lugar","role":"a"}],"examples":[{"text":"El concierto [a:es] en el estadio, que [a:está] en el centro.","tr":"Konser stadyumda; stadyum da merkezde."}]}],"rules":["Meslek, milliyet, malzeme, sahiplik, saat → ser.","Konum, duygu, sağlık, bir değişimin sonucu → estar.","estar muerto, estar casado gibi kalıplar \"kalıcı\" görünse de estar ile söylenir."],"exceptions":["\"Casado\" ser ile de duyulur (Es casado), ama estar casado daha yaygındır."],"mistakes":[{"wrong":"Soy en el trabajo.","right":"Estoy en el trabajo.","note":"Bulunulan yer estar ile söylenir."},{"wrong":"Está médico.","right":"Es médico.","note":"Meslek ser ile söylenir."},{"wrong":"La comida es muy rica hoy.","right":"La comida está muy rica hoy.","note":"Tadı yorumlarken estar kullanılır."}]}},
  {"id":"es-gr-hay-y-esta-estan","languageId":"es","category":"grammar","level":"A1","sourceText":"Hay y está / están","translations":{"tr":["Hay (Var) ve Está / Están"]},"grammar":{"summary":"Hay bir şeyin var olduğunu söyler; está/están ise bilinen bir şeyin nerede olduğunu söyler.","uses":["Bir yerde bir şeyin varlığını söylemek (Hay un banco)","Miktar bildirmek (Hay muchos turistas)","Bilinen bir şeyin yerini söylemek (El banco está aquí)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"hay","en":"Hay","role":"v"},{"tr":"un / una / sayı / isim","en":"Sustantivo","role":"o"},{"tr":"Yer","en":"Lugar","role":"x"}],"examples":[{"text":"[v:Hay] [o:un supermercado] [x:cerca].","tr":"Yakında bir süpermarket var."},{"text":"[v:Hay] [o:tres sillas] [x:en la cocina].","tr":"Mutfakta üç sandalye var."}],"notes":["hay tekil ve çoğulda aynı kalır."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"no hay","en":"No hay","role":"v"},{"tr":"İsim (artikelsiz)","en":"Sustantivo","role":"o"}],"examples":[{"text":"[v:No hay] [o:leche].","tr":"Süt yok."},{"text":"[v:No hay] [o:problema].","tr":"Sorun yok."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"¿hay","en":"Hay","role":"v"},{"tr":"İsim","en":"Sustantivo","role":"o"},{"tr":"Yer?","en":"Lugar","role":"x"}],"examples":[{"text":"¿[v:Hay] [o:un cajero] [x:por aquí]?","tr":"Buralarda bir ATM var mı?"},{"text":"¿[q:Cuántos] [o:alumnos] [v:hay]?","tr":"Kaç öğrenci var?"}]},{"kind":"other","title":"Belirli şey + está / están","formula":[{"tr":"el / la / los / las + isim","en":"Sustantivo definido","role":"s"},{"tr":"está / están","en":"Estar","role":"a"},{"tr":"Yer","en":"Lugar","role":"x"}],"examples":[{"text":"[s:La farmacia] [a:está] [x:al lado del banco].","tr":"Eczane bankanın yanında."},{"text":"[s:Mis llaves] [a:están] [x:en la mesa].","tr":"Anahtarlarım masada."}]}],"rules":["hay ile belirsiz ifadeler kullanılır: un, una, sayılar, mucho, artikelsiz isim.","Belirli artikel (el, la), iyelik ve özel isimlerle está/están kullanılır.","hay haber fiilinden gelir; geçmişte había / hubo olur."],"exceptions":["hay que + mastar \"-mak gerekir\" anlamındadır (A2’de ayrıca işlenir)."],"mistakes":[{"wrong":"Hay el banco cerca.","right":"El banco está cerca.","note":"Belirli bir şeyden söz ederken hay kullanılmaz."},{"wrong":"Hayn muchas personas.","right":"Hay muchas personas.","note":"hay çoğula göre değişmez."},{"wrong":"Está un restaurante aquí.","right":"Hay un restaurante aquí.","note":"Belirsiz bir şeyin varlığı hay ile söylenir."}]}},
  {"id":"es-gr-presente-de-indicativo-verbos-regulares","languageId":"es","category":"grammar","level":"A1","sourceText":"Presente de indicativo: verbos regulares","translations":{"tr":["Şimdiki / Geniş Zaman: Düzenli Fiiller"]},"grammar":{"summary":"Presente, alışkanlıkları, genel gerçekleri ve şu anki eylemleri anlatır; -ar, -er, -ir fiillerinin düzenli çekimi vardır.","uses":["Alışkanlık ve rutin (Trabajo de lunes a viernes)","Genel gerçekler","Şu an olan durumlar","Yakın gelecek planları (Mañana viajo)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne (isteğe bağlı)","en":"Sujeto","role":"s"},{"tr":"Kök + -o / -as / -a / -amos / -áis / -an","en":"Verbo en presente","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Yo] [v:hablo] [o:inglés].","tr":"İngilizce konuşurum."},{"text":"[s:Ellos] [v:comen] [o:a las dos].","tr":"Onlar saat ikide yemek yer."},{"text":"[v:Vivimos] [o:en Turquía].","tr":"Türkiye’de yaşıyoruz."}],"notes":["-er: -o, -es, -e, -emos, -éis, -en · -ir: -o, -es, -e, -imos, -ís, -en."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no","en":"No","role":"x"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Ana] [x:no] [v:bebe] [o:café].","tr":"Ana kahve içmez."},{"text":"[x:No] [v:trabajo] [o:los sábados].","tr":"Cumartesileri çalışmam."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"Tümleç?","en":"Complemento","role":"o"}],"examples":[{"text":"¿[v:Hablas] [o:español]?","tr":"İspanyolca konuşuyor musun?"},{"text":"¿[v:Vive] [s:tu hermana] [o:aquí]?","tr":"Kız kardeşin burada mı yaşıyor?"}],"notes":["Yardımcı fiil yoktur; soru tonlamayla kurulur."]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Özne?","en":"Sujeto","role":"s"}],"examples":[{"text":"¿[q:Dónde] [v:trabajas]?","tr":"Nerede çalışıyorsun?"},{"text":"¿[q:Qué] [v:estudia] [s:Pedro]?","tr":"Pedro ne okuyor?"}]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Sí / No","en":"Sí / No","role":"x"},{"tr":"(no) + fiil","en":"Verbo","role":"v"}],"examples":[{"text":"—¿Fumas? —No, [x:no] [v:fumo].","tr":"—Sigara içer misin? —Hayır, içmem."},{"text":"—¿Comes carne? —Sí, [v:como].","tr":"—Et yer misin? —Evet, yerim."}],"notes":["İngilizcedeki do/does gibi bir yardımcı yoktur; fiil tekrarlanır."]}],"rules":["Mastardan -ar/-er/-ir atılır, kişi eki eklenir: hablar → habl- → hablo.","Olumsuzda no fiilden önce gelir.","Presente hem \"yaparım\" hem \"yapıyorum\" anlamını verir."],"exceptions":[],"mistakes":[{"wrong":"Yo hablar español.","right":"Yo hablo español.","note":"Fiil özneye göre çekilmelidir."},{"wrong":"Estoy hablo español.","right":"Hablo español.","note":"Presente’de yardımcı fiil eklenmez; Türkçedeki -yorum için estar kullanılmaz."},{"wrong":"Ellos comin.","right":"Ellos comen.","note":"-er ve -ir fiillerinde 3. çoğul eki -en’dir."}]}},
  {"id":"es-gr-presente-de-indicativo-verbos-irregulares","languageId":"es","category":"grammar","level":"A1","sourceText":"Presente de indicativo: verbos irregulares","translations":{"tr":["Şimdiki / Geniş Zaman: Düzensiz Fiiller"]},"grammar":{"summary":"Birçok sık fiil presente’de kök ünlüsünü değiştirir ya da 1. tekil şahısta düzensizdir.","uses":["Günlük en sık fiilleri çekmek (tener, ir, hacer, querer, poder)","Kök değişimli fiilleri tanımak","yo biçimi düzensiz fiilleri öğrenmek"],"sections":[{"kind":"other","title":"Kök değişimi e → ie","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"quiero / quieres / quiere / queremos / queréis / quieren","en":"Diptongo e → ie","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Yo] [v:quiero] [o:un café].","tr":"Bir kahve istiyorum."},{"text":"[v:Empezamos] [o:a las nueve].","tr":"Saat dokuzda başlıyoruz."}],"notes":["nosotros ve vosotros kökü değişmez: queremos, queréis. Benzerleri: pensar, cerrar, empezar, preferir."]},{"kind":"other","title":"Kök değişimi o → ue / u → ue","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"puedo / puedes / puede / podemos / podéis / pueden","en":"Diptongo o → ue","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"¿[v:Puedes] [o:ayudarme]?","tr":"Bana yardım edebilir misin?"},{"text":"[s:Ella] [v:duerme] [o:ocho horas].","tr":"O sekiz saat uyur."},{"text":"[v:Juego] [o:al fútbol].","tr":"Futbol oynarım."}],"notes":["Benzerleri: volver, dormir, encontrar, costar; jugar u → ue olur."]},{"kind":"other","title":"Kök değişimi e → i","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"pido / pides / pide / pedimos / pedís / piden","en":"Cambio e → i","role":"v"}],"examples":[{"text":"[x:Siempre] [v:pido] [o:paella].","tr":"Hep paella sipariş ederim."},{"text":"[s:El restaurante] [v:sirve] [o:comida casera].","tr":"Restoran ev yemeği servis ediyor."}],"notes":["Sadece -ir fiillerinde: pedir, servir, repetir, vestir."]},{"kind":"other","title":"yo biçimi düzensiz fiiller","formula":[{"tr":"yo","en":"Yo","role":"s"},{"tr":"tengo / hago / pongo / salgo / vengo / digo / conozco / sé","en":"1.ª persona irregular","role":"v"}],"examples":[{"text":"[v:Tengo] [o:dos hermanos].","tr":"İki kardeşim var."},{"text":"[v:Salgo] [o:de casa] a las ocho.","tr":"Evden sekizde çıkarım."},{"text":"No [v:sé].","tr":"Bilmiyorum."}],"notes":["tener ve venir ayrıca e → ie değişir: tienes, viene."]},{"kind":"other","title":"Tamamen düzensiz: ir","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"voy / vas / va / vamos / vais / van","en":"Ir","role":"v"},{"tr":"a + yer","en":"a + lugar","role":"o"}],"examples":[{"text":"[v:Voy] [o:al trabajo] en metro.","tr":"İşe metroyla giderim."},{"text":"¿[q:Adónde] [v:vais]?","tr":"Nereye gidiyorsunuz?"}]}],"rules":["Kök değişimi vurgulu hecede olur; bu yüzden nosotros ve vosotros biçimleri düzenlidir.","-cer / -cir ile bitenlerde yo biçimi -zco olur: conocer → conozco, traducir → traduzco.","ser, estar, ir ve haber tamamen düzensizdir; ayrı ezberlenmelidir."],"exceptions":["oír: oigo, oyes, oye, oímos, oís, oyen.","decir hem yo düzensiz hem e → i: digo, dices, dice."],"mistakes":[{"wrong":"Yo quero agua.","right":"Yo quiero agua.","note":"querer kökü e → ie değişir."},{"wrong":"Nosotros puedemos.","right":"Nosotros podemos.","note":"nosotros biçiminde kök değişmez."},{"wrong":"Yo teno un coche.","right":"Yo tengo un coche.","note":"tener’in yo biçimi tengo’dur."}]}},
  {"id":"es-gr-verbos-reflexivos","languageId":"es","category":"grammar","level":"A1","sourceText":"Verbos reflexivos","translations":{"tr":["Dönüşlü Fiiller"]},"grammar":{"summary":"Dönüşlü fiiller eylemin özneye döndüğünü gösterir ve me, te, se, nos, os, se zamirleriyle çekilir.","uses":["Günlük rutinler (levantarse, ducharse, vestirse)","Kendi üzerine yapılan eylemler","İsim söylemek (Me llamo…)","Durum değişimi (enfadarse, casarse)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"me / te / se / nos / os / se","en":"Pronombre reflexivo","role":"x"},{"tr":"Çekimli fiil","en":"Verbo","role":"v"},{"tr":"Tümleç","en":"Complemento","role":"o"}],"examples":[{"text":"[s:Yo] [x:me] [v:levanto] [o:a las siete].","tr":"Saat yedide kalkarım."},{"text":"[x:Nos] [v:llamamos] [o:Ana y Luis].","tr":"Adımız Ana ve Luis."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"no","en":"No","role":"x"},{"tr":"Dönüşlü zamir","en":"Pronombre reflexivo","role":"x"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"[s:Pablo] [x:no] [x:se] [v:afeita] [o:todos los días].","tr":"Pablo her gün tıraş olmaz."},{"text":"[x:No] [x:me] [v:acuerdo].","tr":"Hatırlamıyorum."}],"notes":["no her zaman zamirden önce gelir."]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Dönüşlü zamir","en":"Pronombre reflexivo","role":"x"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Tümleç?","en":"Complemento","role":"o"}],"examples":[{"text":"¿[x:Te] [v:duchas] [o:por la mañana]?","tr":"Sabah mı duş alırsın?"}]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"Dönüşlü zamir","en":"Pronombre reflexivo","role":"x"},{"tr":"Fiil?","en":"Verbo","role":"v"}],"examples":[{"text":"¿[q:Cómo] [x:te] [v:llamas]?","tr":"Adın ne?"},{"text":"¿[q:A qué hora] [x:se] [v:acuestan] los niños?","tr":"Çocuklar saat kaçta yatar?"}]},{"kind":"other","title":"Mastar ile zamirin yeri","formula":[{"tr":"Çekimli fiil","en":"Verbo conjugado","role":"v"},{"tr":"Mastar + zamir","en":"Infinitivo + pronombre","role":"v"}],"examples":[{"text":"[a:Tengo que] [v:levantarme] temprano.","tr":"Erken kalkmam gerekiyor."},{"text":"[x:Me] [a:tengo que] [v:levantar] temprano.","tr":"Erken kalkmam gerekiyor."}],"notes":["Zamir mastara bitişir ya da çekimli fiilden önce gelir; ikisi de doğrudur."]}],"rules":["Sözlükte mastar -se ile yazılır: levantarse, llamarse.","Zamir özneye uyar: yo me, tú te, él se…","Vücut parçalarıyla iyelik değil artikel kullanılır: Me lavo las manos."],"exceptions":["Bazı fiiller dönüşlü olunca anlam değiştirir: ir (gitmek) → irse (ayrılmak), dormir (uyumak) → dormirse (uyuyakalmak)."],"mistakes":[{"wrong":"Yo levanto a las siete.","right":"Yo me levanto a las siete.","note":"Dönüşlü zamir unutulmamalı; yoksa \"bir şeyi kaldırırım\" anlamına gelir."},{"wrong":"Me lavo mis manos.","right":"Me lavo las manos.","note":"Vücut parçalarında artikel kullanılır."},{"wrong":"Tú se llamas Ana.","right":"Tú te llamas Ana.","note":"Zamir özneye uyar."}]}},
  {"id":"es-gr-gustar-y-verbos-similares","languageId":"es","category":"grammar","level":"A1","sourceText":"Gustar y verbos similares","translations":{"tr":["Gustar ve Benzeri Fiiller"]},"grammar":{"summary":"Gustar’da sevilen şey öznedir; seven kişi me, te, le… dolaylı nesne zamiriyle gösterilir.","uses":["Sevdiğin / sevmediğin şeyleri söylemek","İlgi ve ağrı bildirmek (interesar, doler)","Fikir paylaşmak (encantar, molestar)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"(A + kişi)","en":"A + persona","role":"x"},{"tr":"me / te / le / nos / os / les","en":"Pronombre de objeto indirecto","role":"o"},{"tr":"gusta / gustan","en":"Gustar","role":"v"},{"tr":"Sevilen şey (özne)","en":"Sujeto","role":"s"}],"examples":[{"text":"[o:Me] [v:gusta] [s:el chocolate].","tr":"Çikolatayı severim."},{"text":"[x:A mi madre] [o:le] [v:gustan] [s:las flores].","tr":"Annem çiçekleri sever."},{"text":"[o:Nos] [v:gusta] [s:bailar].","tr":"Dans etmeyi severiz."}],"notes":["Sevilen şey tekil ya da mastarsa gusta, çoğulsa gustan."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"no","en":"No","role":"x"},{"tr":"Dolaylı nesne zamiri","en":"Pronombre OI","role":"o"},{"tr":"gusta / gustan","en":"Gustar","role":"v"},{"tr":"Özne","en":"Sujeto","role":"s"}],"examples":[{"text":"[x:No] [o:me] [v:gustan] [s:los lunes].","tr":"Pazartesileri sevmem."},{"text":"[x:A Juan] [x:no] [o:le] [v:gusta] [s:el café].","tr":"Juan kahveyi sevmez."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"¿(A + kişi)","en":"A + persona","role":"x"},{"tr":"Zamir","en":"Pronombre OI","role":"o"},{"tr":"gusta / gustan","en":"Gustar","role":"v"},{"tr":"Özne?","en":"Sujeto","role":"s"}],"examples":[{"text":"¿[o:Te] [v:gusta] [s:el cine]?","tr":"Sinemayı sever misin?"},{"text":"¿[q:Qué] [o:te] [v:gusta] [s:hacer]?","tr":"Ne yapmayı seversin?"}]},{"kind":"other","title":"Fikir birliği: también / tampoco","formula":[{"tr":"A mí también / A mí tampoco","en":"También / Tampoco","role":"x"},{"tr":"A mí sí / A mí no","en":"Sí / No","role":"x"}],"examples":[{"text":"—Me gusta el té. —[x:A mí también].","tr":"—Çayı severim. —Ben de."},{"text":"—No me gusta correr. —[x:A mí tampoco].","tr":"—Koşmayı sevmem. —Ben de sevmem."}]},{"kind":"other","title":"Benzer fiiller","formula":[{"tr":"Zamir","en":"Pronombre OI","role":"o"},{"tr":"encantar / interesar / doler / molestar","en":"Verbos como gustar","role":"v"},{"tr":"Özne","en":"Sujeto","role":"s"}],"examples":[{"text":"[o:Me] [v:duele] [s:la cabeza].","tr":"Başım ağrıyor."},{"text":"[o:Nos] [v:encantan] [s:los perros].","tr":"Köpeklere bayılırız."}],"notes":["encantar zaten \"çok sevmek\"tir; mucho ile kullanılmaz."]}],"rules":["Fiil seven kişiye değil, sevilen şeye uyar.","a mí, a ti, a él… vurgu ya da açıklık için eklenir; zamir yine de kullanılır.","le / les belirsiz olduğu için sık sık a + kişi eklenir: A Ana le gusta."],"exceptions":["Birden fazla mastar olsa da gusta tekil kalır: Me gusta leer y escribir."],"mistakes":[{"wrong":"Yo gusto el café.","right":"Me gusta el café.","note":"Seven kişi özne değil, dolaylı nesnedir."},{"wrong":"Me gusta los gatos.","right":"Me gustan los gatos.","note":"Sevilen şey çoğulsa fiil de çoğuldur."},{"wrong":"A Ana gusta bailar.","right":"A Ana le gusta bailar.","note":"a + kişi kullanılsa da le zamiri gereklidir."}]}},
  {"id":"es-gr-posesivos","languageId":"es","category":"grammar","level":"A1","sourceText":"Posesivos","translations":{"tr":["İyelik Sıfatları ve Zamirleri"]},"grammar":{"summary":"İyelik sözcükleri sahibini gösterir ve sahip olunan şeyin sayısına (nuestro/vuestro’da cinsiyetine de) uyar.","uses":["Sahiplik bildirmek (mi casa)","Vurgu veya karşıtlık (la casa es mía)","İsmi tekrarlamamak (el mío)"],"sections":[{"kind":"other","title":"Kısa biçim + isim","formula":[{"tr":"mi / tu / su / nuestro / vuestro / su (+s)","en":"Posesivo átono","role":"x"},{"tr":"İsim","en":"Sustantivo","role":"o"}],"examples":[{"text":"[x:Mi] [o:hermano] vive en Londres.","tr":"Erkek kardeşim Londra’da yaşıyor."},{"text":"[x:Nuestras] [o:vacaciones] empiezan mañana.","tr":"Tatilimiz yarın başlıyor."}],"notes":["Kısa biçim isimden önce gelir ve artikel almaz."]},{"kind":"other","title":"ser + uzun biçim","formula":[{"tr":"Özne","en":"Sujeto","role":"s"},{"tr":"ser","en":"Ser","role":"a"},{"tr":"mío / tuyo / suyo / nuestro / vuestro / suyo","en":"Posesivo tónico","role":"o"}],"examples":[{"text":"[s:Este bolso] [a:es] [o:mío].","tr":"Bu çanta benim."},{"text":"[s:Las llaves] [a:son] [o:tuyas].","tr":"Anahtarlar senin."}]},{"kind":"other","title":"Artikel + uzun biçim (zamir)","formula":[{"tr":"el / la / los / las","en":"Artículo","role":"x"},{"tr":"Uzun iyelik","en":"Pronombre posesivo","role":"o"}],"examples":[{"text":"Tu coche es rojo; [x:el] [o:mío] es azul.","tr":"Senin araban kırmızı; benimki mavi."}]},{"kind":"other","title":"su belirsizliğini gidermek","formula":[{"tr":"el / la + isim","en":"Sustantivo","role":"o"},{"tr":"de + él / ella / usted / ellos","en":"de + pronombre","role":"x"}],"examples":[{"text":"Es [o:la casa] [x:de ella].","tr":"Bu onun (kadının) evi."}]}],"rules":["İyelik, sahibine göre değil sahip olunan şeye göre çoğul olur: mis libros.","su / sus hem \"onun\", hem \"onların\", hem de \"sizin (usted)\" anlamına gelir.","nuestro ve vuestro dört biçimlidir: nuestro, nuestra, nuestros, nuestras."],"exceptions":["Vücut parçaları ve giysilerle genelde iyelik değil artikel kullanılır: Me duele la pierna."],"mistakes":[{"wrong":"Mis hermano","right":"Mi hermano","note":"Tek bir şey için tekil iyelik kullanılır."},{"wrong":"el mi libro","right":"mi libro","note":"Kısa biçimden önce artikel gelmez."},{"wrong":"Nuestro casa","right":"Nuestra casa","note":"nuestro sahip olunan ismin cinsiyetine uyar."}]}},
  {"id":"es-gr-demostrativos","languageId":"es","category":"grammar","level":"A1","sourceText":"Demostrativos","translations":{"tr":["İşaret Sıfatları ve Zamirleri"]},"grammar":{"summary":"Este, ese ve aquel, konuşana göre yakın, orta ve uzak mesafeyi gösterir.","uses":["Yakındaki şeyi göstermek (este)","Dinleyenin yanındaki şeyi göstermek (ese)","Uzaktaki şeyi göstermek (aquel)","Belirsiz şey veya fikir için esto / eso / aquello"],"sections":[{"kind":"other","title":"İşaret sıfatı + isim","formula":[{"tr":"este / ese / aquel (esta, estos…)","en":"Demostrativo","role":"x"},{"tr":"İsim","en":"Sustantivo","role":"o"}],"examples":[{"text":"[x:Este] [o:libro] es muy bueno.","tr":"Bu kitap çok iyi."},{"text":"¿Te gusta [x:esa] [o:camisa]?","tr":"Şu gömleği beğendin mi?"},{"text":"[x:Aquellas] [o:montañas] son altas.","tr":"Oradaki dağlar yüksek."}]},{"kind":"other","title":"İşaret zamiri","formula":[{"tr":"este / ese / aquel…","en":"Pronombre demostrativo","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"Quiero [o:este], no [o:ese].","tr":"Bunu istiyorum, şunu değil."}]},{"kind":"other","title":"Nötr biçimler","formula":[{"tr":"esto / eso / aquello","en":"Demostrativo neutro","role":"o"},{"tr":"Fiil","en":"Verbo","role":"v"}],"examples":[{"text":"¿Qué es [o:esto]?","tr":"Bu ne?"},{"text":"[o:Eso] [v:es] verdad.","tr":"Bu doğru."}],"notes":["Nötr biçimler isimle kullanılmaz ve hiç çoğul olmaz."]}],"rules":["Dört biçim vardır: este, esta, estos, estas (ese ve aquel için de aynı).","Eril tekilde -o değil -e vardır: este, ese.","Zamanla: este año (bu yıl), aquel año (o yıl, çok önce)."],"exceptions":["Eski yazımda zamirler vurgulu yazılırdı (éste); bugün vurgu işareti gerekmez."],"mistakes":[{"wrong":"esto libro","right":"este libro","note":"İsimden önce esto değil este gelir."},{"wrong":"estes coches","right":"estos coches","note":"Eril çoğul estos’tur."},{"wrong":"¿Qué es este?","right":"¿Qué es esto?","note":"Ne olduğu bilinmeyen şey için nötr esto kullanılır."}]}},
  {"id":"es-gr-interrogativos","languageId":"es","category":"grammar","level":"A1","sourceText":"Interrogativos","translations":{"tr":["Soru Kelimeleri"]},"grammar":{"summary":"Soru kelimeleri vurgu işaretiyle yazılır ve genelde cümlenin başında fiilden önce gelir.","uses":["Bilgi sormak (qué, quién, dónde, cuándo, cómo)","Miktar sormak (cuánto)","Seçim sormak (cuál)","Sebep sormak (por qué)"],"sections":[{"kind":"wh","title":"Soru kelimesi + fiil","formula":[{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"Fiil","en":"Verbo","role":"v"},{"tr":"Özne?","en":"Sujeto","role":"s"}],"examples":[{"text":"¿[q:Dónde] [v:vive] [s:tu hermano]?","tr":"Kardeşin nerede yaşıyor?"},{"text":"¿[q:Cuándo] [v:empieza] [s:la clase]?","tr":"Ders ne zaman başlıyor?"},{"text":"¿[q:Quién] [v:es] [s:ese chico]?","tr":"Şu çocuk kim?"}]},{"kind":"other","title":"Edat + soru kelimesi","formula":[{"tr":"Edat (de / a / con / para)","en":"Preposición","role":"x"},{"tr":"Soru kelimesi","en":"Interrogativo","role":"q"},{"tr":"Fiil?","en":"Verbo","role":"v"}],"examples":[{"text":"¿[x:De] [q:dónde] [v:eres]?","tr":"Nerelisin?"},{"text":"¿[x:Con] [q:quién] [v:vives]?","tr":"Kiminle yaşıyorsun?"}],"notes":["Edat soru kelimesinin önünde kalır, sona gitmez."]},{"kind":"other","title":"Cuánto uyumu","formula":[{"tr":"cuánto / cuánta / cuántos / cuántas","en":"Cuánto","role":"q"},{"tr":"İsim","en":"Sustantivo","role":"o"},{"tr":"Fiil?","en":"Verbo","role":"v"}],"examples":[{"text":"¿[q:Cuántos] [o:años] [v:tienes]?","tr":"Kaç yaşındasın?"},{"text":"¿[q:Cuánto] [v:cuesta]?","tr":"Ne kadar?"}]},{"kind":"other","title":"Qué ve cuál","formula":[{"tr":"qué + isim / tanım","en":"Qué","role":"q"},{"tr":"cuál + ser / seçim","en":"Cuál","role":"q"}],"examples":[{"text":"¿[q:Qué] libro lees?","tr":"Hangi kitabı okuyorsun?"},{"text":"¿[q:Cuál] es tu número?","tr":"Numaran ne?"}],"notes":["\"Numaran ne?\" ¿Qué es tu número? değil, ¿Cuál es tu número? olur."]}],"rules":["Soru kelimeleri her zaman vurgulu yazılır: qué, cómo, dónde.","Soru cümlesi ¿ ile başlar, ? ile biter.","por qué \"neden\" (ayrı, vurgulu); porque \"çünkü\" (bitişik, vurgusuz)."],"exceptions":["adónde hareket bildiren fiillerle kullanılır: ¿Adónde vas?"],"mistakes":[{"wrong":"¿Que quieres?","right":"¿Qué quieres?","note":"Soru kelimesi vurgu işareti alır."},{"wrong":"¿Dónde eres de?","right":"¿De dónde eres?","note":"Edat soru kelimesinin önüne gelir."},{"wrong":"¿Porque estudias español?","right":"¿Por qué estudias español?","note":"Soruda por qué ayrı ve vurgulu yazılır."}]}}
]
