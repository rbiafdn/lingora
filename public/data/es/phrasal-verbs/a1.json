  {"id":"es-pv-acostarse","languageId":"es","category":"phrasal-verbs","level":"A1","sourceText":"acostarse","translations":{"tr":["yatmak","yatağa girmek"]},"partOfSpeech":"verb","details":{"usage":"Düzensiz: me acuesto (o → ue)."},"examples":[{"text":"Los niños se acuestan temprano.","tr":"Çocuklar erken yatar."}]},
