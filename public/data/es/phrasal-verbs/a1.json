[
  {"id":"es-pv-tener-que-inf","languageId":"es","category":"phrasal-verbs","level":"A1","sourceText":"tener que + inf.","translations":{"tr":["-mek zorunda olmak","-meli"]},"partOfSpeech":"verb","details":{"usage":"Kişisel zorunluluk; tener çekimlenir, ardından mastar gelir."},"examples":[{"text":"Tengo que estudiar esta noche.","tr":"Bu akşam ders çalışmam lazım."}]},
  {"id":"es-pv-ir-a-inf","languageId":"es","category":"phrasal-verbs","level":"A1","sourceText":"ir a + inf.","translations":{"tr":["-ecek","-meye niyetli olmak"]},"partOfSpeech":"verb","details":{"usage":"Yakın gelecek; ir çekimlenir + a + mastar."},"examples":[{"text":"Vamos a cenar fuera.","tr":"Dışarıda yemek yiyeceğiz."}]},
  {"id":"es-pv-hay-que-inf","languageId":"es","category":"phrasal-verbs","level":"A1","sourceText":"hay que + inf.","translations":{"tr":["-mek gerek","-mek lazım"]},"partOfSpeech":"verb","details":{"usage":"Kişisiz zorunluluk; hay hiç değişmez."},"examples":[{"text":"Hay que comprar pan.","tr":"Ekmek almak lazım."}]},
  {"id":"es-pv-querer-decir","languageId":"es","category":"phrasal-verbs","level":"A1","sourceText":"querer decir","translations":{"tr":["anlamına gelmek","demek istemek"]},"partOfSpeech":"verb","details":{"usage":"Bir kelimenin anlamını sormak için çok sık kullanılır."},"examples":[{"text":"¿Qué quiere decir esta palabra?","tr":"Bu kelime ne anlama geliyor?"}]},
  {"id":"es-pv-llamarse","languageId":"es","category":"phrasal-verbs","level":"A1","sourceText":"llamarse","translations":{"tr":["adı … olmak"]},"partOfSpeech":"verb","details":{"usage":"Dönüşlü: me llamo, te llamas, se llama."},"examples":[{"text":"Me llamo Ana.","tr":"Benim adım Ana."}]},
