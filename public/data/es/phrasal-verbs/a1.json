  {"id":"es-pv-sentarse","languageId":"es","category":"phrasal-verbs","level":"A1","sourceText":"sentarse","translations":{"tr":["oturmak"]},"partOfSpeech":"verb","details":{"usage":"Düzensiz: me siento; 'oturur durumda olmak' için estar sentado."},"examples":[{"text":"Siéntate aquí, por favor.","tr":"Lütfen buraya otur."}]},
  {"id":"es-pv-irse","languageId":"es","category":"phrasal-verbs","level":"A1","sourceText":"irse","translations":{"tr":["gitmek","ayrılmak"]},"partOfSpeech":"verb","details":{"usage":"Bir yerden ayrılmayı vurgular; ir'den farklı."},"examples":[{"text":"Me voy, ¡hasta mañana!","tr":"Ben gidiyorum, yarın görüşürüz!"}]},
