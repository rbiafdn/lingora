  {"id":"es-pv-llegar-a","languageId":"es","category":"phrasal-verbs","level":"A1","sourceText":"llegar a","translations":{"tr":["varmak","ulaşmak"]},"partOfSpeech":"verb","details":{"usage":"Yönde a kullanılır: llegar a Madrid, llegar a casa."},"examples":[{"text":"Llegamos a casa muy tarde.","tr":"Eve çok geç vardık."}]},
  {"id":"es-pv-salir-de","languageId":"es","category":"phrasal-verbs","level":"A1","sourceText":"salir de","translations":{"tr":["-den çıkmak"]},"partOfSpeech":"verb","details":{"usage":"Çıkılan yer de ile gelir."},"examples":[{"text":"Salgo de clase a las dos.","tr":"Dersten saat ikide çıkarım."}]},
  {"id":"es-pv-pensar-en","languageId":"es","category":"phrasal-verbs","level":"A1","sourceText":"pensar en","translations":{"tr":["düşünmek (birini/bir şeyi)"]},"partOfSpeech":"verb","details":{"usage":"Aklında tutmak anlamında en kullanılır; görüş için pensar de."},"examples":[{"text":"Siempre pienso en ti.","tr":"Hep seni düşünüyorum."}]},
