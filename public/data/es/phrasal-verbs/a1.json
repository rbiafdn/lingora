  {"id":"es-pv-vestirse","languageId":"es","category":"phrasal-verbs","level":"A1","sourceText":"vestirse","translations":{"tr":["giyinmek"]},"partOfSpeech":"verb","details":{"usage":"Düzensiz: me visto (e → i)."},"examples":[{"text":"Me visto rápido y salgo.","tr":"Çabucak giyinip çıkıyorum."}]},
