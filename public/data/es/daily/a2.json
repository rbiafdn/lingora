[
  {"id":"es-daily-que-haces","languageId":"es","category":"daily","level":"A2","sourceText":"¿Qué haces?","translations":{"tr":["ne yapıyorsun?","ne iş yapıyorsun?"]},"details":{"register":"informal","context":"O anki uğraşı sormak için; bağlama göre meslek de sorulabilir."},"examples":[{"text":"¡Hola! ¿Qué haces esta tarde?","tr":"Selam! Bu öğleden sonra ne yapıyorsun?"}]},
  {"id":"es-daily-que-pasa","languageId":"es","category":"daily","level":"A2","sourceText":"¿Qué pasa?","translations":{"tr":["ne oluyor?","naber?"]},"details":{"register":"informal","context":"Bir sorun olduğunu sezince; gençler arasında selam olarak da."},"examples":[{"text":"¿Qué pasa? ¿Por qué gritáis?","tr":"Ne oluyor? Neden bağırıyorsunuz?"}]},
  {"id":"es-daily-que-te-pasa","languageId":"es","category":"daily","level":"A2","sourceText":"¿Qué te pasa?","translations":{"tr":["neyin var?","ne oldu sana?"]},"details":{"register":"informal","context":"Birinin üzgün ya da hasta göründüğünü fark edince."},"examples":[{"text":"Estás muy seria. ¿Qué te pasa?","tr":"Çok ciddisin. Neyin var?"}]},
  {"id":"es-daily-no-pasa-nada","languageId":"es","category":"daily","level":"A2","sourceText":"No pasa nada","translations":{"tr":["önemli değil","bir şey olmaz"]},"details":{"register":"neutral","context":"Bir özre cevap verirken ya da birini rahatlatırken."},"examples":[{"text":"—Perdona, te he manchado. —No pasa nada.","tr":"—Pardon, üstünü kirlettim. —Önemli değil."}]},
  {"id":"es-daily-no-te-preocupes","languageId":"es","category":"daily","level":"A2","sourceText":"No te preocupes","translations":{"tr":["merak etme","dert etme"]},"details":{"register":"neutral","context":"Birini rahatlatırken; resmîsi No se preocupe."},"examples":[{"text":"No te preocupes, yo lo arreglo.","tr":"Merak etme, ben hallederim."}]},
  {"id":"es-daily-no-importa","languageId":"es","category":"daily","level":"A2","sourceText":"No importa","translations":{"tr":["önemli değil","fark etmez"]},"details":{"register":"neutral","context":"Bir aksilik ya da özür karşısında."},"examples":[{"text":"—No tengo cambio. —No importa.","tr":"—Bozuk param yok. —Önemli değil."}]},
  {"id":"es-daily-no-hay-problema","languageId":"es","category":"daily","level":"A2","sourceText":"No hay problema","translations":{"tr":["sorun yok"]},"details":{"register":"neutral","context":"Bir ricayı kabul ederken; kısaca Sin problema."},"examples":[{"text":"—¿Puedo llegar un poco tarde? —No hay problema.","tr":"—Biraz geç gelebilir miyim? —Sorun yok."}]},
  {"id":"es-daily-que-bien","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué bien!","translations":{"tr":["ne güzel!","harika!"]},"details":{"register":"neutral","context":"İyi bir habere sevinçle tepki verirken."},"examples":[{"text":"—Me han dado el trabajo. —¡Qué bien!","tr":"—İşi bana verdiler. —Ne güzel!"}]},
  {"id":"es-daily-que-pena","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué pena!","translations":{"tr":["ne yazık!","çok yazık!"]},"details":{"register":"neutral","context":"Kötü ya da hayal kırıklığı yaratan bir habere tepki."},"examples":[{"text":"—No puedo ir a tu fiesta. —¡Qué pena!","tr":"—Partine gelemiyorum. —Ne yazık!"}]},
  {"id":"es-daily-que-lastima","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué lástima!","translations":{"tr":["ne yazık!","yazık oldu!"]},"details":{"register":"neutral","context":"¡Qué pena! ile aynı; biraz daha nazik."},"examples":[{"text":"Se ha cancelado el concierto. ¡Qué lástima!","tr":"Konser iptal olmuş. Ne yazık!"}]},
  {"id":"es-daily-que-suerte","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué suerte!","translations":{"tr":["ne şans!","şanslısın!"]},"details":{"register":"neutral","context":"Birinin şanslı olduğunu duyunca."},"examples":[{"text":"—Me voy a Cuba de vacaciones. —¡Qué suerte!","tr":"—Tatile Küba'ya gidiyorum. —Ne şanslısın!"}]},
  {"id":"es-daily-que-rico","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué rico!","translations":{"tr":["çok lezzetli!","nefis!"]},"details":{"register":"neutral","context":"Yemeği beğendiğinde."},"examples":[{"text":"¡Qué rico está este gazpacho!","tr":"Bu gazpacho ne kadar lezzetli!"}]},
  {"id":"es-daily-que-bonito","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué bonito!","translations":{"tr":["ne güzel!","çok hoş!"]},"details":{"register":"neutral","context":"Bir şeyin görünüşünü beğenince."},"examples":[{"text":"¡Qué bonito es tu piso!","tr":"Dairen ne kadar güzel!"}]},
  {"id":"es-daily-que-calor","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué calor!","translations":{"tr":["ne sıcak!"]},"details":{"register":"neutral","context":"Havanın çok sıcak olduğunu söylerken; soğuk için ¡Qué frío!"},"examples":[{"text":"¡Qué calor hace hoy!","tr":"Bugün ne sıcak!"}]},
  {"id":"es-daily-que-tiempo-hace","languageId":"es","category":"daily","level":"A2","sourceText":"¿Qué tiempo hace?","translations":{"tr":["hava nasıl?"]},"details":{"register":"neutral","context":"Havayı sorarken."},"examples":[{"text":"—¿Qué tiempo hace en Madrid? —Hace sol.","tr":"—Madrid'de hava nasıl? —Güneşli."}]},
  {"id":"es-daily-en-serio","languageId":"es","category":"daily","level":"A2","sourceText":"¿En serio?","translations":{"tr":["cidden mi?","gerçekten mi?"]},"details":{"register":"informal","context":"Şaşırtıcı bir habere tepki verirken."},"examples":[{"text":"—Me caso en mayo. —¿En serio? ¡Felicidades!","tr":"—Mayısta evleniyorum. —Cidden mi? Tebrikler!"}]},
  {"id":"es-daily-no-me-digas","languageId":"es","category":"daily","level":"A2","sourceText":"¡No me digas!","translations":{"tr":["deme ya!","yok artık!"]},"details":{"register":"informal","context":"Şaşırtıcı bir haber duyunca."},"examples":[{"text":"—Ana está embarazada. —¡No me digas!","tr":"—Ana hamile. —Deme ya!"}]},
  {"id":"es-daily-claro-que-si","languageId":"es","category":"daily","level":"A2","sourceText":"¡Claro que sí!","translations":{"tr":["tabii ki!","elbette!"]},"details":{"register":"neutral","context":"Bir isteği coşkuyla kabul ederken; olumsuzu ¡Claro que no!"},"examples":[{"text":"—¿Vienes a la fiesta? —¡Claro que sí!","tr":"—Partiye geliyor musun? —Tabii ki!"}]},
  {"id":"es-daily-me-da-igual","languageId":"es","category":"daily","level":"A2","sourceText":"Me da igual","translations":{"tr":["bana fark etmez","umurumda değil"]},"details":{"register":"neutral","context":"Seçenekler arasında tercihin olmadığında; tonla kayıtsızlık da bildirir."},"examples":[{"text":"—¿Pizza o pasta? —Me da igual.","tr":"—Pizza mı makarna mı? —Bana fark etmez."}]},
  {"id":"es-daily-ni-idea","languageId":"es","category":"daily","level":"A2","sourceText":"Ni idea","translations":{"tr":["hiçbir fikrim yok","bilmem"]},"details":{"register":"informal","context":"Bir sorunun cevabını hiç bilmediğinde."},"examples":[{"text":"—¿Dónde está Juan? —Ni idea.","tr":"—Juan nerede? —Hiçbir fikrim yok."}]},
  {"id":"es-daily-ya-esta","languageId":"es","category":"daily","level":"A2","sourceText":"Ya está","translations":{"tr":["tamam, bitti","oldu"]},"details":{"register":"informal","context":"Bir işi bitirdiğinde."},"examples":[{"text":"Ya está, ya he terminado el informe.","tr":"Tamam, raporu bitirdim."}]},
  {"id":"es-daily-ya-voy","languageId":"es","category":"daily","level":"A2","sourceText":"¡Ya voy!","translations":{"tr":["geliyorum!"]},"details":{"register":"informal","context":"Biri seni çağırdığında."},"examples":[{"text":"—¡La cena está lista! —¡Ya voy!","tr":"—Yemek hazır! —Geliyorum!"}]},
  {"id":"es-daily-ahora-vuelvo","languageId":"es","category":"daily","level":"A2","sourceText":"Ahora vuelvo","translations":{"tr":["hemen dönüyorum"]},"details":{"register":"neutral","context":"Kısa süreliğine ayrılırken."},"examples":[{"text":"Voy al baño, ahora vuelvo.","tr":"Tuvalete gidiyorum, hemen dönüyorum."}]},
  {"id":"es-daily-diga-digame","languageId":"es","category":"daily","level":"A2","sourceText":"¿Diga? / ¿Dígame?","translations":{"tr":["alo?","buyurun?"]},"details":{"register":"neutral","context":"İspanya'da telefonu açarken; Latin Amerika'da ¿Aló? ya da ¿Bueno? (Meksika)."},"examples":[{"text":"¿Dígame? Sí, soy yo.","tr":"Alo? Evet, benim."}]},
  {"id":"es-daily-de-parte-de-quien","languageId":"es","category":"daily","level":"A2","sourceText":"¿De parte de quién?","translations":{"tr":["kim arıyor?","kimin adına?"]},"details":{"register":"neutral","context":"Telefonda arayanın kim olduğunu sorarken."},"examples":[{"text":"—¿Está Laura? —Sí, ¿de parte de quién?","tr":"—Laura orada mı? —Evet, kim arıyor?"}]},
  {"id":"es-daily-te-llamo-luego","languageId":"es","category":"daily","level":"A2","sourceText":"Te llamo luego","translations":{"tr":["sonra seni ararım"]},"details":{"register":"informal","context":"Telefonu kapatırken ya da o an konuşamadığında."},"examples":[{"text":"Ahora estoy ocupado, te llamo luego.","tr":"Şu an meşgulüm, sonra seni ararım."}]},
  {"id":"es-daily-quedamos","languageId":"es","category":"daily","level":"A2","sourceText":"¿Quedamos?","translations":{"tr":["buluşalım mı?"]},"details":{"register":"informal","context":"Arkadaşa buluşma teklif ederken."},"examples":[{"text":"¿Quedamos mañana para tomar algo?","tr":"Yarın bir şeyler içmek için buluşalım mı?"}]},
  {"id":"es-daily-a-que-hora-quedamos","languageId":"es","category":"daily","level":"A2","sourceText":"¿A qué hora quedamos?","translations":{"tr":["kaçta buluşuyoruz?"]},"details":{"register":"informal","context":"Buluşma saatini belirlerken."},"examples":[{"text":"Vale, ¿a qué hora quedamos?","tr":"Tamam, kaçta buluşuyoruz?"}]},
  {"id":"es-daily-te-apetece","languageId":"es","category":"daily","level":"A2","sourceText":"¿Te apetece...?","translations":{"tr":["… ister misin?","canın … istiyor mu?"]},"details":{"register":"informal","context":"İspanya'da samimi teklif yaparken."},"examples":[{"text":"¿Te apetece ir al cine?","tr":"Sinemaya gitmek ister misin?"}]},
  {"id":"es-daily-me-encanta","languageId":"es","category":"daily","level":"A2","sourceText":"¡Me encanta!","translations":{"tr":["bayılıyorum!","çok seviyorum!"]},"details":{"register":"neutral","context":"Bir şeyi çok beğendiğinde."},"examples":[{"text":"¿Es para mí? ¡Me encanta!","tr":"Bana mı? Bayıldım!"}]},
  {"id":"es-daily-tengo-prisa","languageId":"es","category":"daily","level":"A2","sourceText":"Tengo prisa","translations":{"tr":["acelem var"]},"details":{"register":"neutral","context":"Acelen olduğunu söylerken."},"examples":[{"text":"Perdona, no puedo hablar, tengo prisa.","tr":"Kusura bakma, konuşamam, acelem var."}]},
  {"id":"es-daily-llego-tarde","languageId":"es","category":"daily","level":"A2","sourceText":"Llego tarde","translations":{"tr":["geç kalıyorum","geç kalacağım"]},"details":{"register":"neutral","context":"Geç kaldığını haber verirken."},"examples":[{"text":"Lo siento, llego tarde. Hay mucho tráfico.","tr":"Özür dilerim, geç kalıyorum. Trafik çok yoğun."}]},
  {"id":"es-daily-esta-libre","languageId":"es","category":"daily","level":"A2","sourceText":"¿Está libre?","translations":{"tr":["boş mu?"]},"details":{"register":"neutral","context":"Bir sandalye, masa ya da taksinin boş olup olmadığını sorarken."},"examples":[{"text":"Perdone, ¿está libre esta silla?","tr":"Affedersiniz, bu sandalye boş mu?"}]},
  {"id":"es-daily-para-tomar-aqui-o-para-llevar","languageId":"es","category":"daily","level":"A2","sourceText":"¿Para tomar aquí o para llevar?","translations":{"tr":["burada mı, paket mi?"]},"details":{"register":"neutral","context":"Kafede garsonun sorusu; Latin Amerika'da ¿para aquí o para llevar?"},"examples":[{"text":"—Un café. —¿Para tomar aquí o para llevar?","tr":"—Bir kahve. —Burada mı, paket mi?"}]},
  {"id":"es-daily-para-llevar","languageId":"es","category":"daily","level":"A2","sourceText":"Para llevar","translations":{"tr":["paket olsun","götürmek için"]},"details":{"register":"neutral","context":"Siparişini dışarı götüreceğini söylerken."},"examples":[{"text":"Un bocadillo de jamón para llevar, por favor.","tr":"Bir jambonlu sandviç, paket lütfen."}]},
  {"id":"es-daily-me-trae-la-carta-por-favor","languageId":"es","category":"daily","level":"A2","sourceText":"¿Me trae la carta, por favor?","translations":{"tr":["menüyü getirir misiniz?"]},"details":{"register":"neutral","context":"Restoranda menüyü isterken."},"examples":[{"text":"Perdone, ¿me trae la carta, por favor?","tr":"Affedersiniz, menüyü getirir misiniz?"}]},
  {"id":"es-daily-que-me-recomienda","languageId":"es","category":"daily","level":"A2","sourceText":"¿Qué me recomienda?","translations":{"tr":["ne önerirsiniz?"]},"details":{"register":"neutral","context":"Restoranda garsondan öneri isterken."},"examples":[{"text":"Es la primera vez que vengo. ¿Qué me recomienda?","tr":"İlk kez geliyorum. Ne önerirsiniz?"}]},
  {"id":"es-daily-una-mesa-para-dos-por-favor","languageId":"es","category":"daily","level":"A2","sourceText":"Una mesa para dos, por favor","translations":{"tr":["iki kişilik bir masa, lütfen"]},"details":{"register":"neutral","context":"Restorana girince."},"examples":[{"text":"Buenas noches. Una mesa para dos, por favor.","tr":"İyi akşamlar. İki kişilik bir masa lütfen."}]},
  {"id":"es-daily-estoy-lleno-llena","languageId":"es","category":"daily","level":"A2","sourceText":"Estoy lleno / llena","translations":{"tr":["doydum"]},"details":{"register":"neutral","context":"Daha fazla yiyemeyeceğini söylerken."},"examples":[{"text":"No, gracias, estoy llena.","tr":"Hayır, teşekkürler, doydum."}]},
  {"id":"es-daily-que-aproveche","languageId":"es","category":"daily","level":"A2","sourceText":"¡Que aproveche!","translations":{"tr":["afiyet olsun!"]},"details":{"register":"neutral","context":"İspanya'da yemek yiyen birinin yanından geçerken ya da masadan kalkarken."},"examples":[{"text":"Me voy. ¡Que aproveche!","tr":"Ben gidiyorum. Afiyet olsun!"}]},
  {"id":"es-daily-tienen-wifi","languageId":"es","category":"daily","level":"A2","sourceText":"¿Tienen wifi?","translations":{"tr":["wifi'niz var mı?"]},"details":{"register":"neutral","context":"Kafe ya da otelde; şifre için ¿Cuál es la contraseña?"},"examples":[{"text":"¿Tienen wifi? ¿Cuál es la contraseña?","tr":"Wifi'niz var mı? Şifresi ne?"}]},
  {"id":"es-daily-solo-estoy-mirando","languageId":"es","category":"daily","level":"A2","sourceText":"Solo estoy mirando","translations":{"tr":["sadece bakıyorum"]},"details":{"register":"neutral","context":"Mağazada satıcı yardım teklif edince."},"examples":[{"text":"—¿Le puedo ayudar? —No, gracias, solo estoy mirando.","tr":"—Yardımcı olabilir miyim? —Hayır teşekkürler, sadece bakıyorum."}]},
