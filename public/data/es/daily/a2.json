  {"id":"es-daily-tiene-otra-talla","languageId":"es","category":"daily","level":"A2","sourceText":"¿Tiene otra talla?","translations":{"tr":["başka bedeni var mı?"]},"details":{"register":"neutral","context":"Giysi uymadığında."},"examples":[{"text":"Me queda pequeño. ¿Tiene otra talla?","tr":"Bana küçük geldi. Başka bedeni var mı?"}]},
  {"id":"es-daily-a-que-hora-abre","languageId":"es","category":"daily","level":"A2","sourceText":"¿A qué hora abre?","translations":{"tr":["kaçta açılıyor?"]},"details":{"register":"neutral","context":"Bir dükkânın açılış saatini sorarken; kapanış için ¿A qué hora cierra?"},"examples":[{"text":"¿A qué hora abre el museo?","tr":"Müze kaçta açılıyor?"}]},
  {"id":"es-daily-como-llego-a","languageId":"es","category":"daily","level":"A2","sourceText":"¿Cómo llego a...?","translations":{"tr":["…e nasıl giderim?"]},"details":{"register":"neutral","context":"Yol tarifi isterken."},"examples":[{"text":"Perdone, ¿cómo llego a la plaza Mayor?","tr":"Affedersiniz, Plaza Mayor'a nasıl giderim?"}]},
  {"id":"es-daily-siga-todo-recto","languageId":"es","category":"daily","level":"A2","sourceText":"Siga todo recto","translations":{"tr":["dümdüz devam edin"]},"details":{"register":"neutral","context":"Yol tarif ederken; samimisi Sigue todo recto."},"examples":[{"text":"Siga todo recto y gire a la derecha.","tr":"Dümdüz devam edin ve sağa dönün."}]},
  {"id":"es-daily-esta-lejos","languageId":"es","category":"daily","level":"A2","sourceText":"¿Está lejos?","translations":{"tr":["uzak mı?"]},"details":{"register":"neutral","context":"Bir yerin mesafesini sorarken."},"examples":[{"text":"—¿Está lejos la playa? —No, está a cinco minutos.","tr":"—Plaj uzak mı? —Hayır, beş dakika uzaklıkta."}]},
  {"id":"es-daily-un-billete-para-por-favor","languageId":"es","category":"daily","level":"A2","sourceText":"Un billete para..., por favor","translations":{"tr":["…e bir bilet, lütfen"]},"details":{"register":"neutral","context":"Gişede bilet alırken; Latin Amerika'da boleto denir."},"examples":[{"text":"Un billete para Toledo, por favor.","tr":"Toledo'ya bir bilet lütfen."}]},
  {"id":"es-daily-tengo-una-reserva","languageId":"es","category":"daily","level":"A2","sourceText":"Tengo una reserva","translations":{"tr":["rezervasyonum var"]},"details":{"register":"neutral","context":"Otel ya da restoranda."},"examples":[{"text":"Buenas tardes, tengo una reserva a nombre de Yılmaz.","tr":"İyi günler, Yılmaz adına rezervasyonum var."}]},
  {"id":"es-daily-no-me-encuentro-bien","languageId":"es","category":"daily","level":"A2","sourceText":"No me encuentro bien","translations":{"tr":["kendimi iyi hissetmiyorum"]},"details":{"register":"neutral","context":"Hasta ya da halsiz olduğunda."},"examples":[{"text":"Me voy a casa, no me encuentro bien.","tr":"Eve gidiyorum, kendimi iyi hissetmiyorum."}]},
  {"id":"es-daily-me-duele-la-cabeza","languageId":"es","category":"daily","level":"A2","sourceText":"Me duele la cabeza","translations":{"tr":["başım ağrıyor"]},"details":{"register":"neutral","context":"Bir yerinin ağrıdığını söylerken; çoğulda Me duelen los pies."},"examples":[{"text":"¿Tienes una aspirina? Me duele la cabeza.","tr":"Aspirinin var mı? Başım ağrıyor."}]},
  {"id":"es-daily-estas-bien","languageId":"es","category":"daily","level":"A2","sourceText":"¿Estás bien?","translations":{"tr":["iyi misin?"]},"details":{"register":"neutral","context":"Birinin iyi olup olmadığını merak edince."},"examples":[{"text":"Te has caído. ¿Estás bien?","tr":"Düştün. İyi misin?"}]},
  {"id":"es-daily-como-te-va","languageId":"es","category":"daily","level":"A2","sourceText":"¿Cómo te va?","translations":{"tr":["nasıl gidiyor?","işler nasıl?"]},"details":{"register":"informal","context":"Bir süredir görmediğin birine genel durumunu sorarken."},"examples":[{"text":"¡Cuánto tiempo! ¿Cómo te va?","tr":"Ne zamandır görüşmüyoruz! Nasıl gidiyor?"}]},
  {"id":"es-daily-todo-bien","languageId":"es","category":"daily","level":"A2","sourceText":"¿Todo bien?","translations":{"tr":["her şey yolunda mı?"]},"details":{"register":"informal","context":"Kısa bir hâl hatır sorusu; cevap çoğunlukla Todo bien."},"examples":[{"text":"Hola, ¿todo bien?","tr":"Selam, her şey yolunda mı?"}]},
  {"id":"es-daily-que-tal-el-fin-de-semana","languageId":"es","category":"daily","level":"A2","sourceText":"¿Qué tal el fin de semana?","translations":{"tr":["hafta sonun nasıldı?"]},"details":{"register":"neutral","context":"Pazartesi iş ya da okulda sohbet açarken."},"examples":[{"text":"¡Buenos días! ¿Qué tal el fin de semana?","tr":"Günaydın! Hafta sonun nasıldı?"}]},
  {"id":"es-daily-que-hay-de-nuevo","languageId":"es","category":"daily","level":"A2","sourceText":"¿Qué hay de nuevo?","translations":{"tr":["ne var ne yok?","yeni ne var?"]},"details":{"register":"informal","context":"Arkadaşla sohbet başlatırken."},"examples":[{"text":"¡Hola, Rosa! ¿Qué hay de nuevo?","tr":"Selam Rosa! Ne var ne yok?"}]},
  {"id":"es-daily-nada-especial","languageId":"es","category":"daily","level":"A2","sourceText":"Nada especial","translations":{"tr":["özel bir şey yok"]},"details":{"register":"neutral","context":"Ne yaptığın ya da yeni ne olduğu sorulunca."},"examples":[{"text":"—¿Qué hiciste ayer? —Nada especial.","tr":"—Dün ne yaptın? —Özel bir şey yok."}]},
  {"id":"es-daily-regular","languageId":"es","category":"daily","level":"A2","sourceText":"Regular","translations":{"tr":["şöyle böyle","idare eder"]},"details":{"register":"informal","context":"Hâlin sorulunca pek iyi olmadığını söylerken."},"examples":[{"text":"—¿Qué tal estás? —Regular, un poco resfriado.","tr":"—Nasılsın? —Şöyle böyle, biraz nezleyim."}]},
  {"id":"es-daily-vamos-tirando","languageId":"es","category":"daily","level":"A2","sourceText":"Vamos tirando","translations":{"tr":["idare ediyoruz","yuvarlanıp gidiyoruz"]},"details":{"register":"informal","context":"Hâl hatır sorulunca, işler ne iyi ne kötüyken."},"examples":[{"text":"—¿Cómo va todo? —Bueno, vamos tirando.","tr":"—İşler nasıl? —Eh, idare ediyoruz."}]},
  {"id":"es-daily-cuanto-tiempo","languageId":"es","category":"daily","level":"A2","sourceText":"¡Cuánto tiempo!","translations":{"tr":["ne zamandır görüşmüyoruz!","nerelerdesin!"]},"details":{"register":"informal","context":"Uzun süredir görmediğin birine rastlayınca."},"examples":[{"text":"¡Pepe! ¡Cuánto tiempo sin verte!","tr":"Pepe! Ne zamandır görüşmüyoruz!"}]},
  {"id":"es-daily-que-alegria-verte","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué alegría verte!","translations":{"tr":["seni görmek ne güzel!"]},"details":{"register":"neutral","context":"Sevdiğin biriyle karşılaşınca."},"examples":[{"text":"¡Hola, tía! ¡Qué alegría verte!","tr":"Merhaba teyze! Seni görmek ne güzel!"}]},
  {"id":"es-daily-que-sorpresa","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué sorpresa!","translations":{"tr":["ne sürpriz!"]},"details":{"register":"neutral","context":"Beklemediğin birini görünce ya da bir sürprizle karşılaşınca."},"examples":[{"text":"¿Tú aquí? ¡Qué sorpresa!","tr":"Sen burada mısın? Ne sürpriz!"}]},
  {"id":"es-daily-encantado-de-conocerte","languageId":"es","category":"daily","level":"A2","sourceText":"Encantado de conocerte","translations":{"tr":["tanıştığıma memnun oldum"]},"details":{"register":"neutral","context":"Tanışma sonunda ya da tanışırken; konuşan kadınsa encantada."},"examples":[{"text":"Ha sido un placer. Encantado de conocerte.","tr":"Çok keyifliydi. Tanıştığıma memnun oldum."}]},
  {"id":"es-daily-a-que-te-dedicas","languageId":"es","category":"daily","level":"A2","sourceText":"¿A qué te dedicas?","translations":{"tr":["ne iş yapıyorsun?"]},"details":{"register":"neutral","context":"Tanışma sohbetinde meslek sorarken."},"examples":[{"text":"—¿A qué te dedicas? —Soy enfermera.","tr":"—Ne iş yapıyorsun? —Hemşireyim."}]},
  {"id":"es-daily-estudias-o-trabajas","languageId":"es","category":"daily","level":"A2","sourceText":"¿Estudias o trabajas?","translations":{"tr":["okuyor musun, çalışıyor musun?"]},"details":{"register":"informal","context":"İspanya'da genç biriyle tanışırken klasik soru."},"examples":[{"text":"Y tú, ¿estudias o trabajas?","tr":"Ya sen, okuyor musun çalışıyor musun?"}]},
  {"id":"es-daily-me-das-tu-numero","languageId":"es","category":"daily","level":"A2","sourceText":"¿Me das tu número?","translations":{"tr":["numaranı verir misin?"]},"details":{"register":"informal","context":"Birinden telefon numarası isterken."},"examples":[{"text":"¿Me das tu número y te escribo?","tr":"Numaranı verir misin, sana yazayım?"}]},
  {"id":"es-daily-me-voy","languageId":"es","category":"daily","level":"A2","sourceText":"¡Me voy!","translations":{"tr":["ben kaçtım!","gidiyorum!"]},"details":{"register":"informal","context":"Bir yerden ayrılırken."},"examples":[{"text":"¡Me voy! ¡Hasta mañana a todos!","tr":"Ben kaçtım! Herkese yarın görüşmek üzere!"}]},
  {"id":"es-daily-me-tengo-que-ir","languageId":"es","category":"daily","level":"A2","sourceText":"Me tengo que ir","translations":{"tr":["gitmem lazım"]},"details":{"register":"neutral","context":"Kibarca ayrılmak istediğini belirtirken."},"examples":[{"text":"Perdona, me tengo que ir. Te llamo.","tr":"Kusura bakma, gitmem lazım. Seni ararım."}]},
  {"id":"es-daily-cuidate","languageId":"es","category":"daily","level":"A2","sourceText":"¡Cuídate!","translations":{"tr":["kendine iyi bak!"]},"details":{"register":"informal","context":"Vedalaşırken; resmîsi ¡Cuídese!"},"examples":[{"text":"Adiós, mamá. ¡Cuídate!","tr":"Hoşça kal anne. Kendine iyi bak!"}]},
  {"id":"es-daily-hasta-la-proxima","languageId":"es","category":"daily","level":"A2","sourceText":"¡Hasta la próxima!","translations":{"tr":["bir dahaki sefere!"]},"details":{"register":"neutral","context":"Bir sonraki buluşmaya kadar vedalaşırken."},"examples":[{"text":"Gracias por venir. ¡Hasta la próxima!","tr":"Geldiğin için teşekkürler. Bir dahaki sefere!"}]},
  {"id":"es-daily-un-beso","languageId":"es","category":"daily","level":"A2","sourceText":"Un beso","translations":{"tr":["öpüyorum","öptüm"]},"details":{"register":"informal","context":"Telefon ya da mesaj sonunda yakınlarla vedalaşırken."},"examples":[{"text":"Vale, hablamos mañana. Un beso.","tr":"Tamam, yarın konuşuruz. Öptüm."}]},
  {"id":"es-daily-dale-recuerdos-a","languageId":"es","category":"daily","level":"A2","sourceText":"Dale recuerdos a...","translations":{"tr":["…e selam söyle"]},"details":{"register":"neutral","context":"Ortak bir tanıdığa selam iletmek isterken."},"examples":[{"text":"Dale recuerdos a tu madre de mi parte.","tr":"Annene benden selam söyle."}]},
  {"id":"es-daily-que-te-mejores","languageId":"es","category":"daily","level":"A2","sourceText":"¡Que te mejores!","translations":{"tr":["geçmiş olsun!"]},"details":{"register":"neutral","context":"Hasta birine iyileşme dileği; resmîsi ¡Que se mejore!"},"examples":[{"text":"Siento que estés malo. ¡Que te mejores!","tr":"Hasta olmana üzüldüm. Geçmiş olsun!"}]},
  {"id":"es-daily-que-lo-pases-bien","languageId":"es","category":"daily","level":"A2","sourceText":"¡Que lo pases bien!","translations":{"tr":["iyi eğlenceler!","iyi vakit geçir!"]},"details":{"register":"neutral","context":"Partiye, tatile ya da bir etkinliğe giden birine."},"examples":[{"text":"¿Te vas de vacaciones? ¡Que lo pases bien!","tr":"Tatile mi gidiyorsun? İyi eğlenceler!"}]},
  {"id":"es-daily-que-te-diviertas","languageId":"es","category":"daily","level":"A2","sourceText":"¡Que te diviertas!","translations":{"tr":["iyi eğlenceler!"]},"details":{"register":"neutral","context":"Eğlenmeye giden birine."},"examples":[{"text":"¡Que te diviertas en el concierto!","tr":"Konserde iyi eğlenceler!"}]},
  {"id":"es-daily-que-tengas-un-buen-dia","languageId":"es","category":"daily","level":"A2","sourceText":"¡Que tengas un buen día!","translations":{"tr":["iyi günler dilerim!"]},"details":{"register":"neutral","context":"Sabah ya da gün içinde vedalaşırken."},"examples":[{"text":"Gracias por todo. ¡Que tengas un buen día!","tr":"Her şey için teşekkürler. İyi günler!"}]},
  {"id":"es-daily-que-descanses","languageId":"es","category":"daily","level":"A2","sourceText":"¡Que descanses!","translations":{"tr":["iyi dinlen!","iyi uykular!"]},"details":{"register":"neutral","context":"Gece vedalaşırken ya da yorgun birine."},"examples":[{"text":"Buenas noches, ¡que descanses!","tr":"İyi geceler, iyi dinlen!"}]},
  {"id":"es-daily-que-duermas-bien","languageId":"es","category":"daily","level":"A2","sourceText":"¡Que duermas bien!","translations":{"tr":["iyi uykular!"]},"details":{"register":"neutral","context":"Yatmaya giden birine."},"examples":[{"text":"Hasta mañana, cariño. ¡Que duermas bien!","tr":"Yarın görüşürüz canım. İyi uykular!"}]},
  {"id":"es-daily-felicidades","languageId":"es","category":"daily","level":"A2","sourceText":"¡Felicidades!","translations":{"tr":["tebrikler!","kutlarım!"]},"details":{"register":"neutral","context":"Doğum günü, düğün, başarı gibi her türlü kutlamada."},"examples":[{"text":"¡Felicidades! ¿Cuántos cumples?","tr":"Kutlarım! Kaç yaşına giriyorsun?"}]},
  {"id":"es-daily-suerte","languageId":"es","category":"daily","level":"A2","sourceText":"¡Suerte!","translations":{"tr":["bol şans!"]},"details":{"register":"neutral","context":"Sınava, mülakata giren birine; güçlüsü ¡Mucha suerte!"},"examples":[{"text":"Mañana es tu examen, ¿no? ¡Mucha suerte!","tr":"Yarın sınavın, değil mi? Bol şans!"}]},
  {"id":"es-daily-animo","languageId":"es","category":"daily","level":"A2","sourceText":"¡Ánimo!","translations":{"tr":["moralini bozma!","hadi, yapabilirsin!"]},"details":{"register":"neutral","context":"Zor durumdaki birine cesaret verirken."},"examples":[{"text":"¡Ánimo! Ya queda poco.","tr":"Hadi! Az kaldı."}]},
  {"id":"es-daily-venga","languageId":"es","category":"daily","level":"A2","sourceText":"¡Venga!","translations":{"tr":["hadi!","haydi!","tamam"]},"details":{"register":"informal","context":"İspanya'da birini teşvik ederken, acele ettirirken ya da 'tamam' demek için."},"examples":[{"text":"¡Venga, que llegamos tarde!","tr":"Hadi, geç kalıyoruz!"}]},
  {"id":"es-daily-vamos","languageId":"es","category":"daily","level":"A2","sourceText":"¡Vamos!","translations":{"tr":["hadi!","haydi gidelim!"]},"details":{"register":"neutral","context":"Birini harekete geçirirken ya da takımı desteklerken."},"examples":[{"text":"¡Vamos, equipo!","tr":"Haydi takım!"}]},
  {"id":"es-daily-nos-vamos","languageId":"es","category":"daily","level":"A2","sourceText":"¿Nos vamos?","translations":{"tr":["gidelim mi?"]},"details":{"register":"informal","context":"Bir yerden ayrılmayı önerirken."},"examples":[{"text":"Ya es tarde. ¿Nos vamos?","tr":"Geç oldu. Gidelim mi?"}]},
  {"id":"es-daily-date-prisa","languageId":"es","category":"daily","level":"A2","sourceText":"¡Date prisa!","translations":{"tr":["acele et!"]},"details":{"register":"informal","context":"Birini acele ettirirken."},"examples":[{"text":"¡Date prisa, que sale el tren!","tr":"Acele et, tren kalkıyor!"}]},
  {"id":"es-daily-voy-de-camino","languageId":"es","category":"daily","level":"A2","sourceText":"Voy de camino","translations":{"tr":["yoldayım","geliyorum"]},"details":{"register":"neutral","context":"Buluşmaya doğru yolda olduğunu haber verirken; Estoy en camino da denir."},"examples":[{"text":"Voy de camino, llego en cinco minutos.","tr":"Yoldayım, beş dakikaya oradayım."}]},
  {"id":"es-daily-perdona-el-retraso","languageId":"es","category":"daily","level":"A2","sourceText":"Perdona el retraso","translations":{"tr":["geciktiğim için kusura bakma"]},"details":{"register":"neutral","context":"Geç geldiğinde özür dilerken; resmîsi Perdone el retraso."},"examples":[{"text":"Perdona el retraso, había mucho tráfico.","tr":"Geciktiğim için kusura bakma, trafik çoktu."}]},
  {"id":"es-daily-perdona","languageId":"es","category":"daily","level":"A2","sourceText":"¿Perdona?","translations":{"tr":["efendim?","pardon?"]},"details":{"register":"neutral","context":"Söyleneni duymadığında; resmîsi ¿Perdone?"},"examples":[{"text":"¿Perdona? No te he oído.","tr":"Efendim? Seni duymadım."}]},
  {"id":"es-daily-como","languageId":"es","category":"daily","level":"A2","sourceText":"¿Cómo?","translations":{"tr":["ne?","efendim?"]},"details":{"register":"neutral","context":"Duymadığında ya da şaşırdığında; ¿Qué? demekten daha kibar."},"examples":[{"text":"¿Cómo? ¿Puedes repetirlo?","tr":"Efendim? Tekrar eder misin?"}]},
  {"id":"es-daily-me-oyes","languageId":"es","category":"daily","level":"A2","sourceText":"¿Me oyes?","translations":{"tr":["beni duyuyor musun?"]},"details":{"register":"informal","context":"Telefonda ya da görüntülü aramada ses kesilince."},"examples":[{"text":"¿Me oyes? Se corta un poco.","tr":"Beni duyuyor musun? Biraz kesiliyor."}]},
  {"id":"es-daily-pasa-pasa","languageId":"es","category":"daily","level":"A2","sourceText":"¡Pasa, pasa!","translations":{"tr":["gir, gir!","buyur gel!"]},"details":{"register":"informal","context":"Misafiri içeri davet ederken; resmîsi ¡Pase!"},"examples":[{"text":"¡Hola! ¡Pasa, pasa, no te quedes en la puerta!","tr":"Merhaba! Gir gir, kapıda kalma!"}]},
  {"id":"es-daily-adelante","languageId":"es","category":"daily","level":"A2","sourceText":"¡Adelante!","translations":{"tr":["girin!","buyurun!","devam et!"]},"details":{"register":"neutral","context":"Kapı çalınca içeri çağırırken ya da birine devam etmesini söylerken."},"examples":[{"text":"—¿Se puede? —¡Adelante!","tr":"—Girebilir miyim? —Buyurun!"}]},
  {"id":"es-daily-se-puede","languageId":"es","category":"daily","level":"A2","sourceText":"¿Se puede?","translations":{"tr":["girebilir miyim?","müsait misiniz?"]},"details":{"register":"neutral","context":"Bir odaya girmeden önce kapıyı tıklatınca."},"examples":[{"text":"Toc, toc. ¿Se puede?","tr":"Tak tak. Girebilir miyim?"}]},
  {"id":"es-daily-estas-en-tu-casa","languageId":"es","category":"daily","level":"A2","sourceText":"Estás en tu casa","translations":{"tr":["kendi evin gibi rahat ol"]},"details":{"register":"neutral","context":"Misafiri rahatlatırken."},"examples":[{"text":"Siéntate donde quieras, estás en tu casa.","tr":"İstediğin yere otur, kendi evin gibi rahat ol."}]},
  {"id":"es-daily-quieres-algo-de-beber","languageId":"es","category":"daily","level":"A2","sourceText":"¿Quieres algo de beber?","translations":{"tr":["bir şey içer misin?"]},"details":{"register":"neutral","context":"Misafire ikram ederken."},"examples":[{"text":"¿Quieres algo de beber? ¿Agua, un refresco?","tr":"Bir şey içer misin? Su, gazoz?"}]},
  {"id":"es-daily-invito-yo","languageId":"es","category":"daily","level":"A2","sourceText":"Invito yo","translations":{"tr":["benden","ben ısmarlıyorum"]},"details":{"register":"informal","context":"Hesabı ödemeyi teklif ederken."},"examples":[{"text":"Guarda la cartera, hoy invito yo.","tr":"Cüzdanını kaldır, bugün benden."}]},
  {"id":"es-daily-pagamos-a-medias","languageId":"es","category":"daily","level":"A2","sourceText":"¿Pagamos a medias?","translations":{"tr":["yarı yarıya ödeyelim mi?"]},"details":{"register":"informal","context":"Hesabı bölüşmeyi önerirken."},"examples":[{"text":"La cena ha sido cara. ¿Pagamos a medias?","tr":"Yemek pahalı oldu. Yarı yarıya ödeyelim mi?"}]},
  {"id":"es-daily-a-comer","languageId":"es","category":"daily","level":"A2","sourceText":"¡A comer!","translations":{"tr":["yemek hazır!","sofraya!"]},"details":{"register":"informal","context":"Evde herkesi yemeğe çağırırken; ¡A la mesa! da denir."},"examples":[{"text":"¡Niños, a comer!","tr":"Çocuklar, yemek hazır!"}]},
  {"id":"es-daily-me-muero-de-hambre","languageId":"es","category":"daily","level":"A2","sourceText":"¡Me muero de hambre!","translations":{"tr":["açlıktan ölüyorum!"]},"details":{"register":"informal","context":"Çok acıktığını abartarak söylerken."},"examples":[{"text":"¿Cuándo comemos? ¡Me muero de hambre!","tr":"Ne zaman yiyoruz? Açlıktan ölüyorum!"}]},
  {"id":"es-daily-que-sueno","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué sueño!","translations":{"tr":["ne kadar uykum var!"]},"details":{"register":"informal","context":"Çok uykulu olduğunda."},"examples":[{"text":"¡Qué sueño! Anoche dormí fatal.","tr":"Uykum çok fena! Dün gece berbat uyudum."}]},
  {"id":"es-daily-estoy-fatal","languageId":"es","category":"daily","level":"A2","sourceText":"Estoy fatal","translations":{"tr":["berbat durumdayım","çok kötüyüm"]},"details":{"register":"informal","context":"Kendini çok kötü hissettiğinde."},"examples":[{"text":"No voy a clase, estoy fatal.","tr":"Derse gitmiyorum, çok kötüyüm."}]},
  {"id":"es-daily-me-parece-bien","languageId":"es","category":"daily","level":"A2","sourceText":"Me parece bien","translations":{"tr":["bence uygun","olur"]},"details":{"register":"neutral","context":"Bir öneriyi onaylarken."},"examples":[{"text":"—¿Cenamos a las nueve? —Me parece bien.","tr":"—Dokuzda yemek yiyelim mi? —Olur."}]},
  {"id":"es-daily-que-te-parece","languageId":"es","category":"daily","level":"A2","sourceText":"¿Qué te parece?","translations":{"tr":["ne dersin?","nasıl buldun?"]},"details":{"register":"neutral","context":"Birinin fikrini sorarken."},"examples":[{"text":"He pintado el salón. ¿Qué te parece?","tr":"Salonu boyadım. Nasıl buldun?"}]},
  {"id":"es-daily-buena-idea","languageId":"es","category":"daily","level":"A2","sourceText":"¡Buena idea!","translations":{"tr":["iyi fikir!"]},"details":{"register":"neutral","context":"Bir öneriyi beğendiğinde."},"examples":[{"text":"—¿Y si pedimos pizza? —¡Buena idea!","tr":"—Pizza söylesek? —İyi fikir!"}]},
  {"id":"es-daily-perfecto","languageId":"es","category":"daily","level":"A2","sourceText":"¡Perfecto!","translations":{"tr":["mükemmel!","süper!"]},"details":{"register":"neutral","context":"Bir plana ya da duruma tam onay verirken."},"examples":[{"text":"—Te espero en la puerta. —¡Perfecto!","tr":"—Seni kapıda bekliyorum. —Süper!"}]},
  {"id":"es-daily-genial","languageId":"es","category":"daily","level":"A2","sourceText":"¡Genial!","translations":{"tr":["harika!","süper!"]},"details":{"register":"informal","context":"Bir habere ya da plana coşkuyla tepki verirken."},"examples":[{"text":"¿Vienes con nosotros? ¡Genial!","tr":"Bizimle geliyor musun? Harika!"}]},
  {"id":"es-daily-lo-pase-genial","languageId":"es","category":"daily","level":"A2","sourceText":"Lo pasé genial","translations":{"tr":["çok eğlendim","harika vakit geçirdim"]},"details":{"register":"informal","context":"Bir etkinliğin ardından ne kadar eğlendiğini anlatırken."},"examples":[{"text":"Gracias por la fiesta, lo pasé genial.","tr":"Parti için teşekkürler, çok eğlendim."}]},
  {"id":"es-daily-te-gusta","languageId":"es","category":"daily","level":"A2","sourceText":"¿Te gusta?","translations":{"tr":["beğendin mi?","hoşuna gidiyor mu?"]},"details":{"register":"neutral","context":"Birinin bir şeyi beğenip beğenmediğini sorarken."},"examples":[{"text":"Es mi vestido nuevo. ¿Te gusta?","tr":"Yeni elbisem. Beğendin mi?"}]},
  {"id":"es-daily-me-haces-una-foto","languageId":"es","category":"daily","level":"A2","sourceText":"¿Me haces una foto?","translations":{"tr":["fotoğrafımı çeker misin?"]},"details":{"register":"informal","context":"Turist olarak birinden fotoğraf çekmesini isterken; Latin Amerika'da ¿Me tomas una foto?"},"examples":[{"text":"Perdona, ¿me haces una foto con la catedral?","tr":"Pardon, katedralle fotoğrafımı çeker misin?"}]},
  {"id":"es-daily-creo-que-si","languageId":"es","category":"daily","level":"A2","sourceText":"Creo que sí","translations":{"tr":["sanırım evet","galiba"]},"details":{"register":"neutral","context":"Emin olmadan olumlu cevap verirken; olumsuzu Creo que no."},"examples":[{"text":"—¿Está abierto el banco? —Creo que sí.","tr":"—Banka açık mı? —Sanırım evet."}]},
  {"id":"es-daily-depende","languageId":"es","category":"daily","level":"A2","sourceText":"Depende","translations":{"tr":["duruma göre","değişir"]},"details":{"register":"neutral","context":"Kesin cevap veremediğinde; ardından de ile neye bağlı olduğu söylenir."},"examples":[{"text":"—¿Vienes mañana? —Depende del tiempo.","tr":"—Yarın geliyor musun? —Havaya bağlı."}]},
  {"id":"es-daily-por-que-no","languageId":"es","category":"daily","level":"A2","sourceText":"¿Por qué no?","translations":{"tr":["neden olmasın?"]},"details":{"register":"neutral","context":"Bir öneriyi kabul ederken."},"examples":[{"text":"—¿Probamos ese restaurante? —¿Por qué no?","tr":"—O restoranı deneyelim mi? —Neden olmasın?"}]},
  {"id":"es-daily-como-no","languageId":"es","category":"daily","level":"A2","sourceText":"¡Cómo no!","translations":{"tr":["tabii ki!","ne demek!"]},"details":{"register":"neutral","context":"Bir ricayı memnuniyetle kabul ederken; Latin Amerika'da çok yaygın."},"examples":[{"text":"—¿Me pasa la sal? —¡Cómo no!","tr":"—Tuzu uzatır mısınız? —Tabii ki!"}]},
  {"id":"es-daily-me-alegro","languageId":"es","category":"daily","level":"A2","sourceText":"Me alegro","translations":{"tr":["sevindim"]},"details":{"register":"neutral","context":"Birinin iyi haberine karşılık; güçlüsü Me alegro mucho."},"examples":[{"text":"—Ya estoy mejor. —Me alegro mucho.","tr":"—Artık daha iyiyim. —Çok sevindim."}]},
  {"id":"es-daily-menos-mal","languageId":"es","category":"daily","level":"A2","sourceText":"¡Menos mal!","translations":{"tr":["neyse ki!","oh be!"]},"details":{"register":"neutral","context":"Kötü bir ihtimal gerçekleşmeyince rahatlarken."},"examples":[{"text":"—He encontrado tus llaves. —¡Menos mal!","tr":"—Anahtarlarını buldum. —Oh be, neyse ki!"}]},
  {"id":"es-daily-que-raro","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué raro!","translations":{"tr":["ne tuhaf!"]},"details":{"register":"neutral","context":"Beklenmedik ya da garip bir şey olunca."},"examples":[{"text":"No contesta al teléfono. ¡Qué raro!","tr":"Telefona cevap vermiyor. Ne tuhaf!"}]},
  {"id":"es-daily-que-casualidad","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué casualidad!","translations":{"tr":["ne tesadüf!"]},"details":{"register":"neutral","context":"Beklenmedik bir rastlantı olunca."},"examples":[{"text":"¿Tú también eres de Izmir? ¡Qué casualidad!","tr":"Sen de mi İzmirlisin? Ne tesadüf!"}]},
  {"id":"es-daily-que-verguenza","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué vergüenza!","translations":{"tr":["ne ayıp!","ne utanç verici!"]},"details":{"register":"neutral","context":"Utanç verici bir durumda ya da bir davranışı kınarken."},"examples":[{"text":"Me caí delante de todos. ¡Qué vergüenza!","tr":"Herkesin önünde düştüm. Çok utandım!"}]},
  {"id":"es-daily-que-asco","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué asco!","translations":{"tr":["iğrenç!","ne iğrenç!"]},"details":{"register":"informal","context":"Tiksindirici bir şey görünce ya da tadınca."},"examples":[{"text":"¡Qué asco! Hay un pelo en la sopa.","tr":"İğrenç! Çorbada saç var."}]},
  {"id":"es-daily-que-susto","languageId":"es","category":"daily","level":"A2","sourceText":"¡Qué susto!","translations":{"tr":["ödüm koptu!","ne korkuttun!"]},"details":{"register":"neutral","context":"Ani bir korku yaşayınca."},"examples":[{"text":"¡Ay, qué susto! No te había visto.","tr":"Ay, ödüm koptu! Seni görmemiştim."}]},
  {"id":"es-daily-madre-mia","languageId":"es","category":"daily","level":"A2","sourceText":"¡Madre mía!","translations":{"tr":["aman Allahım!","vay anam!"]},"details":{"register":"informal","context":"Şaşkınlık, hayranlık ya da endişe bildirirken."},"examples":[{"text":"¡Madre mía, qué cola!","tr":"Vay anam, ne kuyruk!"}]},
  {"id":"es-daily-dios-mio","languageId":"es","category":"daily","level":"A2","sourceText":"¡Dios mío!","translations":{"tr":["Allahım!","aman Tanrım!"]},"details":{"register":"neutral","context":"Büyük şaşkınlık ya da korku anında."},"examples":[{"text":"¡Dios mío! ¿Qué ha pasado aquí?","tr":"Allahım! Burada ne oldu?"}]},
  {"id":"es-daily-vaya","languageId":"es","category":"daily","level":"A2","sourceText":"¡Vaya!","translations":{"tr":["vay!","hay aksi!"]},"details":{"register":"neutral","context":"Şaşkınlık ya da hafif hayal kırıklığı bildirirken."},"examples":[{"text":"¡Vaya! Se me ha olvidado el móvil.","tr":"Hay aksi! Telefonu unuttum."}]},
  {"id":"es-daily-oye","languageId":"es","category":"daily","level":"A2","sourceText":"¡Oye!","translations":{"tr":["baksana!","hey!"]},"details":{"register":"informal","context":"Samimi biçimde birinin dikkatini çekerken; resmîsi ¡Oiga!"},"examples":[{"text":"Oye, ¿tienes un boli?","tr":"Baksana, kalemin var mı?"}]},
  {"id":"es-daily-ojo","languageId":"es","category":"daily","level":"A2","sourceText":"¡Ojo!","translations":{"tr":["dikkat!","gözünü dört aç!"]},"details":{"register":"informal","context":"Samimi bir uyarı yaparken."},"examples":[{"text":"¡Ojo con el escalón!","tr":"Basamağa dikkat!"}]},
  {"id":"es-daily-tranquilo-tranquila","languageId":"es","category":"daily","level":"A2","sourceText":"Tranquilo / Tranquila","translations":{"tr":["sakin ol","merak etme"]},"details":{"register":"informal","context":"Endişeli birini rahatlatırken; kadına tranquila."},"examples":[{"text":"Tranquila, todo va a salir bien.","tr":"Sakin ol, her şey yolunda gidecek."}]},
