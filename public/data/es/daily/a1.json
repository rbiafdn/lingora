  {"id":"es-daily-un-momento","languageId":"es","category":"daily","level":"A1","sourceText":"Un momento","translations":{"tr":["bir dakika","bir saniye"]},"details":{"register":"neutral","context":"Birinden kısa süre beklemesini isterken."},"examples":[{"text":"Un momento, por favor. Ahora le atiendo.","tr":"Bir dakika lütfen. Hemen ilgileniyorum."}]}
