  {"id":"es-daily-no-se","languageId":"es","category":"daily","level":"A1","sourceText":"No sé","translations":{"tr":["bilmiyorum"]},"details":{"register":"neutral","context":"Bir sorunun cevabını bilmediğinde."},"examples":[{"text":"—¿A qué hora empieza? —No sé.","tr":"—Kaçta başlıyor? —Bilmiyorum."}]},
