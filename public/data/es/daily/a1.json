  {"id":"es-daily-como-se-dice-en-espanol","languageId":"es","category":"daily","level":"A1","sourceText":"¿Cómo se dice... en español?","translations":{"tr":["İspanyolcada … nasıl denir?"]},"details":{"register":"neutral","context":"Bir kelimenin karşılığını sorarken."},"examples":[{"text":"¿Cómo se dice «kitap» en español?","tr":"İspanyolcada «kitap» nasıl denir?"}]},
