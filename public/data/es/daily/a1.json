[
  {"id":"es-daily-hola","languageId":"es","category":"daily","level":"A1","sourceText":"¡Hola!","translations":{"tr":["merhaba","selam"]},"details":{"register":"neutral","context":"Her ortamda selamlaşırken; ardından çoğunlukla ¿qué tal? gelir."},"examples":[{"text":"¡Hola, Marta! ¿Qué tal?","tr":"Selam Marta! Nasılsın?"}]},
  {"id":"es-daily-buenos-dias","languageId":"es","category":"daily","level":"A1","sourceText":"¡Buenos días!","translations":{"tr":["günaydın"]},"details":{"register":"neutral","context":"Sabahtan öğle yemeğine kadar selamlaşırken."},"examples":[{"text":"¡Buenos días! ¿Qué desea?","tr":"Günaydın! Ne arzu edersiniz?"}]},
  {"id":"es-daily-buenas-tardes","languageId":"es","category":"daily","level":"A1","sourceText":"¡Buenas tardes!","translations":{"tr":["tünaydın","iyi günler"]},"details":{"register":"neutral","context":"Öğle yemeğinden hava kararana kadar selamlaşırken."},"examples":[{"text":"Buenas tardes, tengo una cita a las cinco.","tr":"İyi günler, saat beşte randevum var."}]},
  {"id":"es-daily-buenas-noches","languageId":"es","category":"daily","level":"A1","sourceText":"¡Buenas noches!","translations":{"tr":["iyi akşamlar","iyi geceler"]},"details":{"register":"neutral","context":"Hava karardıktan sonra hem selamlaşırken hem vedalaşırken."},"examples":[{"text":"Buenas noches, una mesa para dos.","tr":"İyi akşamlar, iki kişilik bir masa."}]},
  {"id":"es-daily-buenas","languageId":"es","category":"daily","level":"A1","sourceText":"¡Buenas!","translations":{"tr":["selam","merhaba"]},"details":{"register":"informal","context":"Günün her saatinde kısa ve samimi selam; dükkâna girerken de söylenir."},"examples":[{"text":"¡Buenas! ¿Tienen pan integral?","tr":"Merhaba! Tam buğday ekmeğiniz var mı?"}]},
  {"id":"es-daily-que-tal","languageId":"es","category":"daily","level":"A1","sourceText":"¿Qué tal?","translations":{"tr":["nasılsın?","naber?"]},"details":{"register":"informal","context":"Selamlaşırken; çoğu zaman gerçek bir cevap beklenmez."},"examples":[{"text":"¡Hola, Pedro! ¿Qué tal?","tr":"Selam Pedro! Naber?"}]},
  {"id":"es-daily-como-estas","languageId":"es","category":"daily","level":"A1","sourceText":"¿Cómo estás?","translations":{"tr":["nasılsın?"]},"details":{"register":"neutral","context":"Tanıdık birine hâlini sorarken."},"examples":[{"text":"Hola, Ana, ¿cómo estás?","tr":"Merhaba Ana, nasılsın?"}]},
  {"id":"es-daily-como-esta-usted","languageId":"es","category":"daily","level":"A1","sourceText":"¿Cómo está usted?","translations":{"tr":["nasılsınız?"]},"details":{"register":"formal","context":"Yaşça büyük ya da resmî ilişkide olduğun birine."},"examples":[{"text":"Buenos días, señora. ¿Cómo está usted?","tr":"Günaydın hanımefendi. Nasılsınız?"}]},
  {"id":"es-daily-bien-gracias-y-tu","languageId":"es","category":"daily","level":"A1","sourceText":"Bien, gracias, ¿y tú?","translations":{"tr":["iyiyim, teşekkürler, ya sen?"]},"details":{"register":"neutral","context":"¿Qué tal? ya da ¿Cómo estás? sorusuna standart cevap."},"examples":[{"text":"—¿Qué tal? —Bien, gracias, ¿y tú?","tr":"—Nasılsın? —İyiyim, teşekkürler, ya sen?"}]},
  {"id":"es-daily-adios","languageId":"es","category":"daily","level":"A1","sourceText":"¡Adiós!","translations":{"tr":["hoşça kal","güle güle"]},"details":{"register":"neutral","context":"Vedalaşırken; İspanya'da yolda karşılaşınca kısa selam olarak da kullanılır."},"examples":[{"text":"¡Adiós! ¡Hasta mañana!","tr":"Hoşça kal! Yarın görüşürüz!"}]},
  {"id":"es-daily-hasta-luego","languageId":"es","category":"daily","level":"A1","sourceText":"¡Hasta luego!","translations":{"tr":["görüşürüz","sonra görüşürüz"]},"details":{"register":"neutral","context":"En yaygın veda; tekrar görüşülmeyecek olsa da söylenir."},"examples":[{"text":"Gracias por todo. ¡Hasta luego!","tr":"Her şey için teşekkürler. Görüşürüz!"}]},
  {"id":"es-daily-hasta-manana","languageId":"es","category":"daily","level":"A1","sourceText":"¡Hasta mañana!","translations":{"tr":["yarın görüşürüz"]},"details":{"register":"neutral","context":"Ertesi gün görüşülecek birine veda ederken."},"examples":[{"text":"Me voy a casa. ¡Hasta mañana!","tr":"Eve gidiyorum. Yarın görüşürüz!"}]},
  {"id":"es-daily-hasta-pronto","languageId":"es","category":"daily","level":"A1","sourceText":"¡Hasta pronto!","translations":{"tr":["yakında görüşmek üzere"]},"details":{"register":"neutral","context":"Yakında tekrar görüşmeyi umduğun birine veda ederken."},"examples":[{"text":"Ha sido un placer. ¡Hasta pronto!","tr":"Çok memnun oldum. Yakında görüşmek üzere!"}]},
  {"id":"es-daily-nos-vemos","languageId":"es","category":"daily","level":"A1","sourceText":"Nos vemos","translations":{"tr":["görüşürüz"]},"details":{"register":"informal","context":"Arkadaşlar arasında vedalaşırken."},"examples":[{"text":"Bueno, nos vemos el lunes.","tr":"Peki, pazartesi görüşürüz."}]},
  {"id":"es-daily-como-te-llamas","languageId":"es","category":"daily","level":"A1","sourceText":"¿Cómo te llamas?","translations":{"tr":["adın ne?"]},"details":{"register":"neutral","context":"Tanışırken isim sormak için; resmîsi ¿Cómo se llama usted?"},"examples":[{"text":"Hola, ¿cómo te llamas?","tr":"Merhaba, adın ne?"}]},
  {"id":"es-daily-me-llamo","languageId":"es","category":"daily","level":"A1","sourceText":"Me llamo...","translations":{"tr":["adım …"]},"details":{"register":"neutral","context":"Kendini tanıtırken; Soy... da denir."},"examples":[{"text":"Me llamo Elif. Soy de Turquía.","tr":"Adım Elif. Türkiye'denim."}]},
  {"id":"es-daily-mucho-gusto","languageId":"es","category":"daily","level":"A1","sourceText":"Mucho gusto","translations":{"tr":["memnun oldum","tanıştığıma memnun oldum"]},"details":{"register":"neutral","context":"Biriyle ilk kez tanışınca."},"examples":[{"text":"—Soy Carlos. —Mucho gusto, Carlos.","tr":"—Ben Carlos. —Memnun oldum Carlos."}]},
  {"id":"es-daily-encantado-encantada","languageId":"es","category":"daily","level":"A1","sourceText":"Encantado / Encantada","translations":{"tr":["memnun oldum"]},"details":{"register":"neutral","context":"Tanışırken; konuşan erkekse encantado, kadınsa encantada."},"examples":[{"text":"—Te presento a mi hermana. —Encantada.","tr":"—Seni kız kardeşimle tanıştırayım. —Memnun oldum."}]},
  {"id":"es-daily-igualmente","languageId":"es","category":"daily","level":"A1","sourceText":"¡Igualmente!","translations":{"tr":["ben de","size de","sana da"]},"details":{"register":"neutral","context":"Bir iyi dileğe ya da 'memnun oldum'a aynı şekilde karşılık verirken."},"examples":[{"text":"—¡Buen fin de semana! —¡Igualmente!","tr":"—İyi hafta sonları! —Sana da!"}]},
  {"id":"es-daily-de-donde-eres","languageId":"es","category":"daily","level":"A1","sourceText":"¿De dónde eres?","translations":{"tr":["nerelisin?"]},"details":{"register":"neutral","context":"Tanışırken memleket sormak için; resmîsi ¿De dónde es usted?"},"examples":[{"text":"—¿De dónde eres? —Soy de Estambul.","tr":"—Nerelisin? —İstanbulluyum."}]},
