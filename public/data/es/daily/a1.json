  {"id":"es-daily-donde-vives","languageId":"es","category":"daily","level":"A1","sourceText":"¿Dónde vives?","translations":{"tr":["nerede oturuyorsun?"]},"details":{"register":"neutral","context":"Tanışma sohbetinde."},"examples":[{"text":"—¿Dónde vives? —Vivo en el centro.","tr":"—Nerede oturuyorsun? —Merkezde oturuyorum."}]},
  {"id":"es-daily-hablas-ingles","languageId":"es","category":"daily","level":"A1","sourceText":"¿Hablas inglés?","translations":{"tr":["İngilizce konuşuyor musun?"]},"details":{"register":"neutral","context":"Anlaşmakta zorlanınca; resmîsi ¿Habla usted inglés?"},"examples":[{"text":"Perdona, ¿hablas inglés?","tr":"Pardon, İngilizce konuşuyor musun?"}]},
  {"id":"es-daily-no-entiendo","languageId":"es","category":"daily","level":"A1","sourceText":"No entiendo","translations":{"tr":["anlamıyorum","anlamadım"]},"details":{"register":"neutral","context":"Söyleneni anlamadığında."},"examples":[{"text":"Lo siento, no entiendo.","tr":"Kusura bakma, anlamıyorum."}]},
