  {"id":"es-daily-estoy-cansado-cansada","languageId":"es","category":"daily","level":"A1","sourceText":"Estoy cansado / cansada","translations":{"tr":["yorgunum"]},"details":{"register":"neutral","context":"Yorgunluğunu söylerken; konuşan kadınsa cansada."},"examples":[{"text":"Hoy no salgo, estoy cansada.","tr":"Bugün çıkmıyorum, yorgunum."}]},
