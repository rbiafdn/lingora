[
  {"id":"es-expr-de-hecho","languageId":"es","category":"expressions","level":"B1","sourceText":"de hecho","translations":{"tr":["aslında","hatta","nitekim"]},"tags":["discourse-marker"],"details":{"usage":"Önceki sözü güçlendirir ya da düzeltir.","register":"neutral"},"examples":[{"text":"No es caro; de hecho, es bastante barato.","tr":"Pahalı değil; hatta oldukça ucuz."}]},
  {"id":"es-expr-o-sea","languageId":"es","category":"expressions","level":"B1","sourceText":"o sea","translations":{"tr":["yani","demek ki"]},"tags":["discourse-marker"],"details":{"usage":"Açıklama ya da sonuç için; konuşmada çok sık.","register":"informal"},"examples":[{"text":"Llega a las diez, o sea, dentro de una hora.","tr":"Saat onda geliyor, yani bir saat sonra."}]},
  {"id":"es-expr-es-decir","languageId":"es","category":"expressions","level":"B1","sourceText":"es decir","translations":{"tr":["yani","başka bir deyişle"]},"tags":["discourse-marker"],"details":{"usage":"O sea'nın daha nötr/yazılı karşılığı.","register":"neutral"},"examples":[{"text":"Vuelvo el lunes, es decir, dentro de tres días.","tr":"Pazartesi dönüyorum, yani üç gün sonra."}]},
  {"id":"es-expr-por-cierto","languageId":"es","category":"expressions","level":"B1","sourceText":"por cierto","translations":{"tr":["bu arada","aklıma gelmişken"]},"tags":["discourse-marker"],"details":{"usage":"Konuya ek bilgi ya da yeni konu eklerken.","register":"neutral"},"examples":[{"text":"Por cierto, ¿has visto a Pablo?","tr":"Bu arada, Pablo'yu gördün mü?"}]},
  {"id":"es-expr-sin-embargo","languageId":"es","category":"expressions","level":"B1","sourceText":"sin embargo","translations":{"tr":["ancak","buna rağmen","yine de"]},"tags":["discourse-marker"],"details":{"usage":"Pero'dan daha güçlü ve yazıda yaygın.","register":"neutral"},"examples":[{"text":"Estudió mucho; sin embargo, suspendió.","tr":"Çok çalıştı; buna rağmen kaldı."}]},
  {"id":"es-expr-aun-asi","languageId":"es","category":"expressions","level":"B1","sourceText":"aun así","translations":{"tr":["yine de","buna rağmen"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Estaba enfermo y, aun así, fue a trabajar.","tr":"Hastaydı, yine de işe gitti."}]},
  {"id":"es-expr-en-cambio","languageId":"es","category":"expressions","level":"B1","sourceText":"en cambio","translations":{"tr":["buna karşılık","oysa"]},"tags":["discourse-marker"],"details":{"usage":"İki şeyi karşılaştırırken.","register":"neutral"},"examples":[{"text":"Yo soy tímido; mi hermano, en cambio, habla con todos.","tr":"Ben çekingenim; kardeşim ise herkesle konuşur."}]},
  {"id":"es-expr-mientras-que","languageId":"es","category":"expressions","level":"B1","sourceText":"mientras que","translations":{"tr":["oysa","…iken"]},"details":{"usage":"Karşıtlık bildirir.","register":"neutral"},"examples":[{"text":"A mí me gusta el mar, mientras que a ella le gusta la montaña.","tr":"Ben denizi severim, oysa o dağı sever."}]},
  {"id":"es-expr-a-pesar-de","languageId":"es","category":"expressions","level":"B1","sourceText":"a pesar de","translations":{"tr":["…e rağmen"]},"details":{"usage":"Ardından isim ya da mastar gelir.","register":"neutral"},"examples":[{"text":"A pesar del frío, salimos a pasear.","tr":"Soğuğa rağmen yürüyüşe çıktık."}]},
  {"id":"es-expr-por-lo-tanto","languageId":"es","category":"expressions","level":"B1","sourceText":"por lo tanto","translations":{"tr":["bu nedenle","dolayısıyla"]},"tags":["discourse-marker"],"details":{"usage":"Yazıda ve resmî konuşmada sonuç bildirir.","register":"neutral"},"examples":[{"text":"No hay tren; por lo tanto, iremos en autobús.","tr":"Tren yok; dolayısıyla otobüsle gideceğiz."}]},
  {"id":"es-expr-ya-que","languageId":"es","category":"expressions","level":"B1","sourceText":"ya que","translations":{"tr":["madem","çünkü","…dığı için"]},"details":{"usage":"Bilinen bir sebebi bildirir.","register":"neutral"},"examples":[{"text":"Ya que estás aquí, ayúdame.","tr":"Madem buradasın, bana yardım et."}]},
  {"id":"es-expr-debido-a","languageId":"es","category":"expressions","level":"B1","sourceText":"debido a","translations":{"tr":["…den dolayı","…nedeniyle"]},"details":{"usage":"Resmî; haberlerde sık.","register":"formal"},"examples":[{"text":"El vuelo se canceló debido a la niebla.","tr":"Uçuş sis nedeniyle iptal edildi."}]},
  {"id":"es-expr-a-causa-de","languageId":"es","category":"expressions","level":"B1","sourceText":"a causa de","translations":{"tr":["…yüzünden","…nedeniyle"]},"details":{"register":"neutral"},"examples":[{"text":"No dormí a causa del ruido.","tr":"Gürültü yüzünden uyuyamadım."}]},
  {"id":"es-expr-por-culpa-de","languageId":"es","category":"expressions","level":"B1","sourceText":"por culpa de","translations":{"tr":["…yüzünden","…in suçu yüzünden"]},"details":{"usage":"Olumsuz sonuçlarda; gracias a'nın tersi.","register":"neutral"},"examples":[{"text":"Perdimos el tren por culpa del tráfico.","tr":"Trafik yüzünden treni kaçırdık."}]},
  {"id":"es-expr-en-realidad","languageId":"es","category":"expressions","level":"B1","sourceText":"en realidad","translations":{"tr":["aslında","gerçekte"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Parece serio, pero en realidad es muy divertido.","tr":"Ciddi görünüyor ama aslında çok eğlenceli."}]},
  {"id":"es-expr-en-general","languageId":"es","category":"expressions","level":"B1","sourceText":"en general","translations":{"tr":["genel olarak","genelde"]},"details":{"register":"neutral"},"examples":[{"text":"En general, estoy contento con el trabajo.","tr":"Genel olarak işimden memnunum."}]},
  {"id":"es-expr-por-lo-general","languageId":"es","category":"expressions","level":"B1","sourceText":"por lo general","translations":{"tr":["genellikle","çoğunlukla"]},"details":{"register":"neutral"},"examples":[{"text":"Por lo general, ceno a las nueve.","tr":"Genellikle saat dokuzda akşam yemeği yerim."}]},
  {"id":"es-expr-desde-mi-punto-de-vista","languageId":"es","category":"expressions","level":"B1","sourceText":"desde mi punto de vista","translations":{"tr":["benim açımdan","bana göre"]},"details":{"register":"neutral"},"examples":[{"text":"Desde mi punto de vista, es una buena idea.","tr":"Benim açımdan bu iyi bir fikir."}]},
  {"id":"es-expr-en-primer-lugar","languageId":"es","category":"expressions","level":"B1","sourceText":"en primer lugar","translations":{"tr":["ilk olarak","öncelikle"]},"tags":["discourse-marker"],"details":{"usage":"Devamı: en segundo lugar, por último.","register":"neutral"},"examples":[{"text":"En primer lugar, quiero daros las gracias.","tr":"Öncelikle size teşekkür etmek istiyorum."}]},
  {"id":"es-expr-por-ultimo","languageId":"es","category":"expressions","level":"B1","sourceText":"por último","translations":{"tr":["son olarak"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Por último, apaga el ordenador.","tr":"Son olarak bilgisayarı kapat."}]},
  {"id":"es-expr-para-empezar","languageId":"es","category":"expressions","level":"B1","sourceText":"para empezar","translations":{"tr":["başlangıç olarak","bir kere"]},"tags":["discourse-marker"],"details":{"usage":"Restoranda 'başlangıç olarak' anlamında da kullanılır.","register":"neutral"},"examples":[{"text":"Para empezar, no tengo tiempo.","tr":"Bir kere, vaktim yok."}]},
  {"id":"es-expr-por-un-lado-por-otro-lado","languageId":"es","category":"expressions","level":"B1","sourceText":"por un lado... por otro (lado)...","translations":{"tr":["bir yandan... öte yandan..."]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Por un lado quiero viajar; por otro, no tengo dinero.","tr":"Bir yandan seyahat etmek istiyorum; öte yandan param yok."}]},
  {"id":"es-expr-por-otra-parte","languageId":"es","category":"expressions","level":"B1","sourceText":"por otra parte","translations":{"tr":["öte yandan","diğer taraftan"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Por otra parte, el hotel está lejos de la playa.","tr":"Öte yandan otel plaja uzak."}]},
  {"id":"es-expr-en-resumen","languageId":"es","category":"expressions","level":"B1","sourceText":"en resumen","translations":{"tr":["özetle","kısacası"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"En resumen, fue un viaje fantástico.","tr":"Kısacası harika bir yolculuktu."}]},
  {"id":"es-expr-en-conclusion","languageId":"es","category":"expressions","level":"B1","sourceText":"en conclusión","translations":{"tr":["sonuç olarak"]},"tags":["discourse-marker"],"details":{"usage":"Yazılı metinlerin sonunda.","register":"formal"},"examples":[{"text":"En conclusión, necesitamos más tiempo.","tr":"Sonuç olarak daha fazla zamana ihtiyacımız var."}]},
  {"id":"es-expr-en-otras-palabras","languageId":"es","category":"expressions","level":"B1","sourceText":"en otras palabras","translations":{"tr":["başka bir deyişle"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"En otras palabras, no hay dinero.","tr":"Başka bir deyişle, para yok."}]},
  {"id":"es-expr-desde-luego","languageId":"es","category":"expressions","level":"B1","sourceText":"desde luego","translations":{"tr":["kesinlikle","elbette"]},"details":{"usage":"Güçlü onay; olumsuzla 'asla': desde luego que no.","register":"neutral"},"examples":[{"text":"Desde luego, es la mejor paella que he probado.","tr":"Kesinlikle tattığım en iyi paella bu."}]},
  {"id":"es-expr-sin-duda","languageId":"es","category":"expressions","level":"B1","sourceText":"sin duda","translations":{"tr":["şüphesiz","kuşkusuz"]},"details":{"register":"neutral"},"examples":[{"text":"Es, sin duda, el mejor jugador del equipo.","tr":"Şüphesiz takımın en iyi oyuncusu."}]},
  {"id":"es-expr-de-todos-modos","languageId":"es","category":"expressions","level":"B1","sourceText":"de todos modos","translations":{"tr":["yine de","her neyse","nasılsa"]},"tags":["discourse-marker"],"details":{"usage":"de todas formas / de todas maneras ile aynı.","register":"neutral"},"examples":[{"text":"No sé si podré ir; de todos modos, te aviso.","tr":"Gelebilir miyim bilmiyorum; her hâlükârda sana haber veririm."}]},
  {"id":"es-expr-de-todas-formas","languageId":"es","category":"expressions","level":"B1","sourceText":"de todas formas","translations":{"tr":["neyse","her hâlükârda"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"De todas formas, gracias por intentarlo.","tr":"Neyse, denediğin için teşekkürler."}]},
  {"id":"es-expr-por-si-acaso","languageId":"es","category":"expressions","level":"B1","sourceText":"por si acaso","translations":{"tr":["ne olur ne olmaz","her ihtimale karşı"]},"details":{"register":"neutral"},"examples":[{"text":"Lleva el paraguas, por si acaso.","tr":"Şemsiyeyi al, ne olur ne olmaz."}]},
  {"id":"es-expr-incluso","languageId":"es","category":"expressions","level":"B1","sourceText":"incluso","translations":{"tr":["hatta","bile"]},"details":{"register":"neutral"},"examples":[{"text":"Incluso mi abuela usa WhatsApp.","tr":"Büyükannem bile WhatsApp kullanıyor."}]},
  {"id":"es-expr-ni-siquiera","languageId":"es","category":"expressions","level":"B1","sourceText":"ni siquiera","translations":{"tr":["…bile değil","hiç bile"]},"details":{"usage":"Fiilden sonra gelirse no gerekir: No me ha llamado ni siquiera.","register":"neutral"},"examples":[{"text":"Ni siquiera me dijo hola.","tr":"Bana merhaba bile demedi."}]},
  {"id":"es-expr-a-proposito","languageId":"es","category":"expressions","level":"B1","sourceText":"a propósito","translations":{"tr":["bu arada","kasten"]},"tags":["discourse-marker"],"details":{"usage":"İki anlamı var: konu değiştirme ve 'bile bile'.","register":"neutral"},"examples":[{"text":"No lo hice a propósito, te lo juro.","tr":"Bilerek yapmadım, yemin ederim."}]},
  {"id":"es-expr-en-vez-de","languageId":"es","category":"expressions","level":"B1","sourceText":"en vez de","translations":{"tr":["…yerine"]},"details":{"register":"neutral"},"examples":[{"text":"En vez de quejarte, haz algo.","tr":"Şikâyet etmek yerine bir şey yap."}]},
  {"id":"es-expr-en-lugar-de","languageId":"es","category":"expressions","level":"B1","sourceText":"en lugar de","translations":{"tr":["…yerine"]},"details":{"usage":"En vez de ile aynı; biraz daha resmî.","register":"neutral"},"examples":[{"text":"Tomé té en lugar de café.","tr":"Kahve yerine çay içtim."}]},
  {"id":"es-expr-aparte-de","languageId":"es","category":"expressions","level":"B1","sourceText":"aparte de","translations":{"tr":["…dışında","…dan başka"]},"details":{"register":"neutral"},"examples":[{"text":"Aparte de eso, todo está bien.","tr":"Onun dışında her şey yolunda."}]},
  {"id":"es-expr-a-traves-de","languageId":"es","category":"expressions","level":"B1","sourceText":"a través de","translations":{"tr":["aracılığıyla","…içinden"]},"details":{"register":"neutral"},"examples":[{"text":"Nos conocimos a través de un amigo.","tr":"Bir arkadaş aracılığıyla tanıştık."}]},
  {"id":"es-expr-a-partir-de","languageId":"es","category":"expressions","level":"B1","sourceText":"a partir de","translations":{"tr":["…den itibaren"]},"details":{"register":"neutral"},"examples":[{"text":"A partir del lunes, trabajo por las mañanas.","tr":"Pazartesiden itibaren sabahları çalışıyorum."}]},
  {"id":"es-expr-de-ahora-en-adelante","languageId":"es","category":"expressions","level":"B1","sourceText":"de ahora en adelante","translations":{"tr":["bundan sonra","şu andan itibaren"]},"details":{"register":"neutral"},"examples":[{"text":"De ahora en adelante, llegaré puntual.","tr":"Bundan sonra dakik geleceğim."}]},
  {"id":"es-expr-hoy-en-dia","languageId":"es","category":"expressions","level":"B1","sourceText":"hoy en día","translations":{"tr":["günümüzde","bugünlerde"]},"details":{"register":"neutral"},"examples":[{"text":"Hoy en día todo el mundo tiene móvil.","tr":"Günümüzde herkesin cep telefonu var."}]},
  {"id":"es-expr-de-momento","languageId":"es","category":"expressions","level":"B1","sourceText":"de momento","translations":{"tr":["şimdilik","şu an için"]},"details":{"register":"neutral"},"examples":[{"text":"De momento no hay noticias.","tr":"Şimdilik haber yok."}]},
  {"id":"es-expr-dentro-de-poco","languageId":"es","category":"expressions","level":"B1","sourceText":"dentro de poco","translations":{"tr":["yakında","birazdan"]},"details":{"register":"neutral"},"examples":[{"text":"Dentro de poco empiezan las vacaciones.","tr":"Yakında tatil başlıyor."}]},
  {"id":"es-expr-tarde-o-temprano","languageId":"es","category":"expressions","level":"B1","sourceText":"tarde o temprano","translations":{"tr":["er ya da geç"]},"details":{"register":"neutral"},"examples":[{"text":"Tarde o temprano lo sabrá.","tr":"Er ya da geç öğrenecek."}]},
  {"id":"es-expr-cuanto-antes","languageId":"es","category":"expressions","level":"B1","sourceText":"cuanto antes","translations":{"tr":["bir an önce","en kısa sürede"]},"details":{"register":"neutral"},"examples":[{"text":"Llámame cuanto antes.","tr":"Beni bir an önce ara."}]},
  {"id":"es-expr-lo-antes-posible","languageId":"es","category":"expressions","level":"B1","sourceText":"lo antes posible","translations":{"tr":["mümkün olduğunca çabuk"]},"details":{"register":"neutral"},"examples":[{"text":"Responde lo antes posible, por favor.","tr":"Lütfen mümkün olduğunca çabuk cevap ver."}]},
  {"id":"es-expr-a-menudo","languageId":"es","category":"expressions","level":"B1","sourceText":"a menudo","translations":{"tr":["sık sık"]},"details":{"register":"neutral"},"examples":[{"text":"Vamos al cine a menudo.","tr":"Sık sık sinemaya gideriz."}]},
  {"id":"es-expr-al-mismo-tiempo","languageId":"es","category":"expressions","level":"B1","sourceText":"al mismo tiempo","translations":{"tr":["aynı anda","aynı zamanda"]},"details":{"register":"neutral"},"examples":[{"text":"No puedo hablar y conducir al mismo tiempo.","tr":"Aynı anda hem konuşup hem araba süremem."}]},
  {"id":"es-expr-a-la-vez","languageId":"es","category":"expressions","level":"B1","sourceText":"a la vez","translations":{"tr":["aynı anda","hem de"]},"details":{"register":"neutral"},"examples":[{"text":"Es divertido y útil a la vez.","tr":"Hem eğlenceli hem de faydalı."}]},
  {"id":"es-expr-mientras-tanto","languageId":"es","category":"expressions","level":"B1","sourceText":"mientras tanto","translations":{"tr":["bu arada","o sırada"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Yo cocino; mientras tanto, tú pon la mesa.","tr":"Ben yemek yapıyorum; sen de bu arada sofrayı kur."}]},
  {"id":"es-expr-en-aquel-momento","languageId":"es","category":"expressions","level":"B1","sourceText":"en aquel momento","translations":{"tr":["o anda","o sırada"]},"details":{"register":"neutral"},"examples":[{"text":"En aquel momento no sabía qué decir.","tr":"O anda ne diyeceğimi bilmiyordum."}]},
  {"id":"es-expr-desde-entonces","languageId":"es","category":"expressions","level":"B1","sourceText":"desde entonces","translations":{"tr":["o zamandan beri"]},"details":{"register":"neutral"},"examples":[{"text":"Nos conocimos en 2015 y desde entonces somos amigos.","tr":"2015'te tanıştık ve o zamandan beri arkadaşız."}]},
  {"id":"es-expr-a-ultima-hora","languageId":"es","category":"expressions","level":"B1","sourceText":"a última hora","translations":{"tr":["son dakikada"]},"details":{"register":"neutral"},"examples":[{"text":"Cancelaron el concierto a última hora.","tr":"Konseri son dakikada iptal ettiler."}]},
  {"id":"es-expr-por-casualidad","languageId":"es","category":"expressions","level":"B1","sourceText":"por casualidad","translations":{"tr":["tesadüfen","acaba"]},"details":{"usage":"Soruda kibarca 'acaba' anlamı katar: ¿Tienes un boli, por casualidad?","register":"neutral"},"examples":[{"text":"Nos encontramos por casualidad en el metro.","tr":"Metroda tesadüfen karşılaştık."}]},
  {"id":"es-expr-lo-que-pasa-es-que","languageId":"es","category":"expressions","level":"B1","sourceText":"lo que pasa es que","translations":{"tr":["mesele şu ki","işin aslı"]},"tags":["discourse-marker"],"details":{"usage":"Bir durumu açıklarken ya da bahane sunarken.","register":"informal"},"examples":[{"text":"Me gustaría ir; lo que pasa es que no tengo coche.","tr":"Gelmek isterdim; mesele şu ki arabam yok."}]},
  {"id":"es-expr-resulta-que","languageId":"es","category":"expressions","level":"B1","sourceText":"resulta que","translations":{"tr":["meğer","anlaşılan o ki"]},"tags":["discourse-marker"],"details":{"usage":"Beklenmedik bir bilgiyi aktarırken.","register":"informal"},"examples":[{"text":"Resulta que Ana y Luis son hermanos.","tr":"Meğer Ana ile Luis kardeşmiş."}]},
  {"id":"es-expr-puede-que","languageId":"es","category":"expressions","level":"B1","sourceText":"puede que","translations":{"tr":["olabilir ki","belki"]},"details":{"usage":"Ardından subjuntivo gelir.","register":"neutral"},"examples":[{"text":"Puede que llueva esta tarde.","tr":"Bu öğleden sonra yağmur yağabilir."}]},
  {"id":"es-expr-es-posible-que","languageId":"es","category":"expressions","level":"B1","sourceText":"es posible que","translations":{"tr":["mümkündür ki","olabilir"]},"details":{"usage":"Ardından subjuntivo gelir.","register":"neutral"},"examples":[{"text":"Es posible que llegue tarde.","tr":"Geç kalabilirim."}]},
  {"id":"es-expr-igual","languageId":"es","category":"expressions","level":"B1","sourceText":"igual","translations":{"tr":["belki","olabilir"]},"details":{"usage":"Konuşmada 'belki' anlamında; indicativo alır: Igual viene mañana.","register":"informal"},"examples":[{"text":"Igual nos vemos el sábado.","tr":"Belki cumartesi görüşürüz."}]},
  {"id":"es-expr-quien-sabe","languageId":"es","category":"expressions","level":"B1","sourceText":"quién sabe","translations":{"tr":["kim bilir"]},"details":{"register":"neutral"},"examples":[{"text":"¿Volverá algún día? Quién sabe.","tr":"Bir gün geri döner mi? Kim bilir."}]},
  {"id":"es-expr-que-va","languageId":"es","category":"expressions","level":"B1","sourceText":"¡qué va!","translations":{"tr":["ne gezer!","yok canım!","hiç de değil"]},"details":{"usage":"Bir iddiayı güçlü ve samimi biçimde reddeder.","register":"informal"},"examples":[{"text":"—¿Estás cansado? —¡Qué va! Estoy genial.","tr":"—Yorgun musun? —Yok canım! Harikayım."}]},
  {"id":"es-expr-ni-hablar","languageId":"es","category":"expressions","level":"B1","sourceText":"¡ni hablar!","translations":{"tr":["asla!","lafı bile olmaz!"]},"details":{"usage":"Bir öneriyi kesin biçimde reddeder.","register":"informal"},"examples":[{"text":"—¿Me prestas el coche? —¡Ni hablar!","tr":"—Arabanı ödünç verir misin? —Lafı bile olmaz!"}]},
  {"id":"es-expr-para-nada","languageId":"es","category":"expressions","level":"B1","sourceText":"para nada","translations":{"tr":["hiç de değil","hiç"]},"details":{"usage":"Olumsuzu güçlendirir: No me gusta para nada.","register":"informal"},"examples":[{"text":"—¿Te molesta? —Para nada.","tr":"—Rahatsız ediyor mu? —Hiç de değil."}]},
  {"id":"es-expr-de-ninguna-manera","languageId":"es","category":"expressions","level":"B1","sourceText":"de ninguna manera","translations":{"tr":["asla","hiçbir şekilde"]},"details":{"register":"neutral"},"examples":[{"text":"De ninguna manera voy a pagar eso.","tr":"Bunu asla ödemem."}]},
  {"id":"es-expr-lo-que-sea","languageId":"es","category":"expressions","level":"B1","sourceText":"lo que sea","translations":{"tr":["her neyse","ne olursa"]},"details":{"register":"informal"},"examples":[{"text":"Pide lo que sea, invito yo.","tr":"Ne istersen söyle, ben ısmarlıyorum."}]},
  {"id":"es-expr-tanto-como","languageId":"es","category":"expressions","level":"B1","sourceText":"tanto... como...","translations":{"tr":["hem... hem de..."]},"details":{"register":"neutral"},"examples":[{"text":"Tanto mi padre como mi madre son profesores.","tr":"Hem babam hem annem öğretmen."}]},
  {"id":"es-expr-no-solo-sino-tambien","languageId":"es","category":"expressions","level":"B1","sourceText":"no solo... sino también...","translations":{"tr":["sadece... değil, aynı zamanda..."]},"details":{"register":"neutral"},"examples":[{"text":"Habla no solo inglés, sino también chino.","tr":"Sadece İngilizce değil, Çince de konuşuyor."}]},
  {"id":"es-expr-cada-vez-menos","languageId":"es","category":"expressions","level":"B1","sourceText":"cada vez menos","translations":{"tr":["gittikçe daha az"]},"details":{"register":"neutral"},"examples":[{"text":"Cada vez menos gente lee periódicos de papel.","tr":"Gittikçe daha az insan kâğıt gazete okuyor."}]},
  {"id":"es-expr-como-mucho","languageId":"es","category":"expressions","level":"B1","sourceText":"como mucho","translations":{"tr":["en fazla","olsa olsa"]},"details":{"register":"neutral"},"examples":[{"text":"Tardaré como mucho media hora.","tr":"En fazla yarım saat sürer."}]},
  {"id":"es-expr-como-minimo","languageId":"es","category":"expressions","level":"B1","sourceText":"como mínimo","translations":{"tr":["en az","asgari"]},"details":{"register":"neutral"},"examples":[{"text":"Necesitas como mínimo dos horas.","tr":"En az iki saate ihtiyacın var."}]},
  {"id":"es-expr-tal-como","languageId":"es","category":"expressions","level":"B1","sourceText":"tal como","translations":{"tr":["…dığı gibi","tıpkı"]},"details":{"register":"neutral"},"examples":[{"text":"Hazlo tal como te expliqué.","tr":"Sana anlattığım gibi yap."}]},
  {"id":"es-expr-asi-es","languageId":"es","category":"expressions","level":"B1","sourceText":"así es","translations":{"tr":["öyle","evet, öyle"]},"details":{"usage":"Bir bilgiyi onaylar.","register":"neutral"},"examples":[{"text":"—¿Usted es el nuevo director? —Así es.","tr":"—Yeni müdür siz misiniz? —Evet, öyle."}]},
  {"id":"es-expr-en-teoria","languageId":"es","category":"expressions","level":"B1","sourceText":"en teoría","translations":{"tr":["teoride","kâğıt üstünde"]},"details":{"usage":"Genelde gerçekte farklı olduğunu ima eder.","register":"neutral"},"examples":[{"text":"En teoría, el tren llega a las ocho.","tr":"Kâğıt üstünde tren sekizde geliyor."}]},
  {"id":"es-expr-a-gusto","languageId":"es","category":"expressions","level":"B1","sourceText":"a gusto","translations":{"tr":["rahat","keyifli"]},"details":{"usage":"Estar a gusto: kendini rahat hissetmek.","register":"neutral"},"examples":[{"text":"Aquí estoy muy a gusto.","tr":"Burada çok rahatım."}]},
  {"id":"es-expr-pues-nada","languageId":"es","category":"expressions","level":"B1","sourceText":"pues nada","translations":{"tr":["neyse","peki o zaman"]},"tags":["discourse-marker"],"details":{"usage":"Konuşmayı kapatırken ya da kabullenirken.","register":"informal"},"examples":[{"text":"Pues nada, nos vemos mañana.","tr":"Peki o zaman, yarın görüşürüz."}]},
  {"id":"es-expr-hombre","languageId":"es","category":"expressions","level":"B1","sourceText":"hombre","translations":{"tr":["yahu","canım","ya"]},"tags":["discourse-marker"],"details":{"usage":"Ünlem olarak kadın erkek herkese söylenir; şaşkınlık ya da vurgu katar.","register":"informal"},"examples":[{"text":"¡Hombre, claro que voy!","tr":"Yahu, tabii ki geliyorum!"}]},
  {"id":"es-expr-fijate","languageId":"es","category":"expressions","level":"B1","sourceText":"fíjate","translations":{"tr":["düşünsene","bak hele"]},"tags":["discourse-marker"],"details":{"usage":"Şaşırtıcı bir bilgiye dikkat çeker; resmîsi fíjese.","register":"informal"},"examples":[{"text":"Fíjate, ya tiene tres hijos.","tr":"Düşünsene, şimdiden üç çocuğu var."}]},
  {"id":"es-expr-digamos","languageId":"es","category":"expressions","level":"B1","sourceText":"digamos","translations":{"tr":["diyelim","şöyle diyelim"]},"tags":["discourse-marker"],"details":{"usage":"Yaklaşık bir ifade ya da örnek verirken.","register":"neutral"},"examples":[{"text":"Quedamos, digamos, a las siete.","tr":"Diyelim saat yedide buluşalım."}]},
  {"id":"es-expr-en-fin","languageId":"es","category":"expressions","level":"B1","sourceText":"en fin","translations":{"tr":["neyse","kısacası"]},"tags":["discourse-marker"],"details":{"usage":"Konuyu toparlar ya da hafif bir hayal kırıklığı bildirir.","register":"neutral"},"examples":[{"text":"En fin, así es la vida.","tr":"Neyse, hayat böyle."}]},
  {"id":"es-expr-te-importa-si","languageId":"es","category":"expressions","level":"B1","sourceText":"¿te importa si...?","translations":{"tr":["…sem sorun olur mu?","…mamın sakıncası var mı?"]},"tags":["politeness"],"details":{"usage":"Kibar izin isteme; resmîsi ¿le importa si...?","register":"neutral"},"examples":[{"text":"¿Te importa si abro la ventana?","tr":"Pencereyi açsam sorun olur mu?"}]},
  {"id":"es-expr-quisiera","languageId":"es","category":"expressions","level":"B1","sourceText":"quisiera","translations":{"tr":["…mak isterdim","rica edecektim"]},"tags":["politeness"],"details":{"usage":"Çok kibar istek; dükkânda ve resmî ortamda.","register":"formal"},"examples":[{"text":"Quisiera hablar con el responsable.","tr":"Sorumluyla görüşmek isterdim."}]},
  {"id":"es-expr-lo-lamento","languageId":"es","category":"expressions","level":"B1","sourceText":"lo lamento","translations":{"tr":["üzgünüm","çok üzüldüm"]},"tags":["politeness"],"details":{"usage":"Lo siento'dan daha resmî.","register":"formal"},"examples":[{"text":"Lo lamento, pero no es posible.","tr":"Üzgünüm ama bu mümkün değil."}]},
  {"id":"es-expr-enhorabuena","languageId":"es","category":"expressions","level":"B1","sourceText":"¡enhorabuena!","translations":{"tr":["tebrikler!","tebrik ederim!"]},"tags":["politeness"],"details":{"usage":"Bir başarı için; doğum günü için ¡felicidades! denir.","register":"neutral"},"examples":[{"text":"¡Enhorabuena por el nuevo trabajo!","tr":"Yeni işin için tebrikler!"}]},
  {"id":"es-expr-un-saludo","languageId":"es","category":"expressions","level":"B1","sourceText":"un saludo","translations":{"tr":["selamlar","saygılar"]},"tags":["writing"],"details":{"usage":"E-posta kapanışı; daha resmîsi saludos cordiales.","register":"neutral"},"examples":[{"text":"Quedo pendiente. Un saludo, Juan.","tr":"Haberinizi bekliyorum. Selamlar, Juan."}]},
  {"id":"es-expr-estimado-a","languageId":"es","category":"expressions","level":"B1","sourceText":"estimado/a","translations":{"tr":["sayın","değerli"]},"tags":["writing"],"details":{"usage":"Resmî mektup ve e-posta hitabı: Estimado señor García:","register":"formal"},"examples":[{"text":"Estimada Sra. López:","tr":"Sayın Bayan López,"}]}
