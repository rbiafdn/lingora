  {"id":"es-expr-ahora-mismo","languageId":"es","category":"expressions","level":"A2","sourceText":"ahora mismo","translations":{"tr":["hemen şimdi","şu anda"]},"details":{"register":"neutral"},"examples":[{"text":"Ahora mismo no puedo hablar.","tr":"Şu anda konuşamam."}]},
