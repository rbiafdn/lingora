  {"id":"es-expr-por-supuesto","languageId":"es","category":"expressions","level":"A2","sourceText":"por supuesto","translations":{"tr":["elbette","tabii ki"]},"details":{"usage":"Claro'dan biraz daha vurgulu ve kibar.","register":"neutral"},"examples":[{"text":"—¿Puedo sentarme aquí? —Por supuesto.","tr":"—Buraya oturabilir miyim? —Elbette."}]},
  {"id":"es-expr-no-hay-de-que","languageId":"es","category":"expressions","level":"A2","sourceText":"no hay de qué","translations":{"tr":["rica ederim","ne demek"]},"tags":["politeness"],"details":{"usage":"De nada'nın biraz daha kibar karşılığı.","register":"neutral"},"examples":[{"text":"—Gracias por todo. —No hay de qué.","tr":"—Her şey için teşekkürler. —Ne demek."}]},
  {"id":"es-expr-con-mucho-gusto","languageId":"es","category":"expressions","level":"A2","sourceText":"con mucho gusto","translations":{"tr":["memnuniyetle","seve seve"]},"tags":["politeness"],"details":{"usage":"Bir isteği kabul ederken ya da teşekküre cevap olarak.","register":"neutral"},"examples":[{"text":"—¿Me ayudas con la maleta? —Con mucho gusto.","tr":"—Bavulu taşımama yardım eder misin? —Seve seve."}]},
  {"id":"es-expr-muy-amable","languageId":"es","category":"expressions","level":"A2","sourceText":"muy amable","translations":{"tr":["çok naziksiniz","çok incelik"]},"tags":["politeness"],"details":{"usage":"Genelde teşekkürle birlikte: Gracias, muy amable.","register":"neutral"},"examples":[{"text":"Gracias, es usted muy amable.","tr":"Teşekkürler, çok naziksiniz."}]},
