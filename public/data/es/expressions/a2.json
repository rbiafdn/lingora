[
  {"id":"es-expr-a-mi-tampoco","languageId":"es","category":"expressions","level":"A2","sourceText":"a mí tampoco","translations":{"tr":["bana da (olumsuz)"]},"details":{"usage":"Gustar türü fiillerin olumsuzuna katılırken kullanılır.","register":"neutral"},"examples":[{"text":"—No me gusta el frío. —A mí tampoco.","tr":"—Soğuğu sevmem. —Ben de sevmem."}]},
