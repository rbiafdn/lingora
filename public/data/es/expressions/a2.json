  {"id":"es-expr-la-verdad","languageId":"es","category":"expressions","level":"A2","sourceText":"la verdad","translations":{"tr":["açıkçası","doğrusu"]},"tags":["discourse-marker"],"details":{"usage":"Cümle başında samimi bir itiraf öncesi.","register":"informal"},"examples":[{"text":"La verdad, no me apetece salir.","tr":"Açıkçası dışarı çıkmak istemiyorum."}]},
