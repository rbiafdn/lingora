  {"id":"es-expr-al-principio","languageId":"es","category":"expressions","level":"A2","sourceText":"al principio","translations":{"tr":["başta","ilk başta"]},"tags":["discourse-marker"],"details":{"usage":"Al principio de + isim: al principio del libro.","register":"neutral"},"examples":[{"text":"Al principio no entendía nada.","tr":"İlk başta hiçbir şey anlamıyordum."}]},
