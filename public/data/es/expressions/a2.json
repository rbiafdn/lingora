  {"id":"es-expr-por-eso","languageId":"es","category":"expressions","level":"A2","sourceText":"por eso","translations":{"tr":["bu yüzden","o yüzden"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Estaba cansado, por eso me fui a dormir.","tr":"Yorgundum, o yüzden yatmaya gittim."}]},
