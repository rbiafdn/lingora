[
  {"id":"es-expr-a-mi-modo-de-ver","languageId":"es","category":"expressions","level":"B2","sourceText":"a mi modo de ver","translations":{"tr":["bana kalırsa","benim gözümde"]},"details":{"register":"neutral"},"examples":[{"text":"A mi modo de ver, el problema es otro.","tr":"Bana kalırsa sorun başka."}]},
  {"id":"es-expr-a-decir-verdad","languageId":"es","category":"expressions","level":"B2","sourceText":"a decir verdad","translations":{"tr":["doğrusunu söylemek gerekirse"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"A decir verdad, no me lo esperaba.","tr":"Doğrusunu söylemek gerekirse bunu beklemiyordum."}]},
  {"id":"es-expr-que-yo-sepa","languageId":"es","category":"expressions","level":"B2","sourceText":"que yo sepa","translations":{"tr":["bildiğim kadarıyla"]},"details":{"register":"neutral"},"examples":[{"text":"Que yo sepa, la tienda abre a las diez.","tr":"Bildiğim kadarıyla dükkân onda açılıyor."}]},
  {"id":"es-expr-si-no-me-equivoco","languageId":"es","category":"expressions","level":"B2","sourceText":"si no me equivoco","translations":{"tr":["yanılmıyorsam"]},"details":{"register":"neutral"},"examples":[{"text":"Si no me equivoco, nos conocimos en Valencia.","tr":"Yanılmıyorsam Valencia'da tanışmıştık."}]},
  {"id":"es-expr-por-lo-visto","languageId":"es","category":"expressions","level":"B2","sourceText":"por lo visto","translations":{"tr":["anlaşılan","görünüşe göre"]},"details":{"usage":"Duyulan bir bilgiyi aktarırken.","register":"neutral"},"examples":[{"text":"Por lo visto, van a cerrar el bar.","tr":"Anlaşılan barı kapatacaklar."}]},
  {"id":"es-expr-al-parecer","languageId":"es","category":"expressions","level":"B2","sourceText":"al parecer","translations":{"tr":["görünüşe göre","söylenene göre"]},"details":{"register":"neutral"},"examples":[{"text":"Al parecer, el accidente no fue grave.","tr":"Görünüşe göre kaza ciddi değilmiş."}]},
  {"id":"es-expr-por-lo-que-veo","languageId":"es","category":"expressions","level":"B2","sourceText":"por lo que veo","translations":{"tr":["gördüğüm kadarıyla"]},"details":{"register":"neutral"},"examples":[{"text":"Por lo que veo, ya habéis terminado.","tr":"Gördüğüm kadarıyla bitirmişsiniz bile."}]},
  {"id":"es-expr-puesto-que","languageId":"es","category":"expressions","level":"B2","sourceText":"puesto que","translations":{"tr":["…dığı için","madem ki"]},"details":{"usage":"Ya que'nin daha resmî karşılığı.","register":"formal"},"examples":[{"text":"Puesto que no hay quórum, se aplaza la reunión.","tr":"Yeter sayı olmadığı için toplantı erteleniyor."}]},
  {"id":"es-expr-dado-que","languageId":"es","category":"expressions","level":"B2","sourceText":"dado que","translations":{"tr":["…dığından","…dığı göz önüne alınırsa"]},"details":{"register":"formal"},"examples":[{"text":"Dado que es tarde, terminaremos mañana.","tr":"Geç olduğundan yarın bitireceğiz."}]},
  {"id":"es-expr-asi-pues","languageId":"es","category":"expressions","level":"B2","sourceText":"así pues","translations":{"tr":["böylece","dolayısıyla"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Así pues, la decisión está tomada.","tr":"Dolayısıyla karar verilmiş oldu."}]},
  {"id":"es-expr-de-modo-que","languageId":"es","category":"expressions","level":"B2","sourceText":"de modo que","translations":{"tr":["öyle ki","bu yüzden"]},"details":{"usage":"Sonuç bildirirken indicativo, amaç bildirirken subjuntivo.","register":"neutral"},"examples":[{"text":"Habla despacio, de modo que todos le entiendan.","tr":"Herkes anlasın diye yavaş konuşuyor."}]},
  {"id":"es-expr-de-manera-que","languageId":"es","category":"expressions","level":"B2","sourceText":"de manera que","translations":{"tr":["öyle ki","böylece"]},"details":{"usage":"De modo que ile aynı kullanılır.","register":"neutral"},"examples":[{"text":"Llovía, de manera que nos quedamos en casa.","tr":"Yağmur yağıyordu, bu yüzden evde kaldık."}]},
  {"id":"es-expr-en-consecuencia","languageId":"es","category":"expressions","level":"B2","sourceText":"en consecuencia","translations":{"tr":["sonuç olarak","bunun sonucunda"]},"tags":["discourse-marker"],"details":{"register":"formal"},"examples":[{"text":"Subieron los precios y, en consecuencia, bajaron las ventas.","tr":"Fiyatlar arttı ve bunun sonucunda satışlar düştü."}]},
  {"id":"es-expr-como-consecuencia-de","languageId":"es","category":"expressions","level":"B2","sourceText":"como consecuencia de","translations":{"tr":["…in sonucu olarak"]},"details":{"register":"formal"},"examples":[{"text":"Cerraron la carretera como consecuencia de la nieve.","tr":"Kar sonucu yolu kapattılar."}]},
  {"id":"es-expr-a-pesar-de-que","languageId":"es","category":"expressions","level":"B2","sourceText":"a pesar de que","translations":{"tr":["…masına rağmen"]},"details":{"usage":"Ardından çekimli fiil gelir.","register":"neutral"},"examples":[{"text":"A pesar de que estaba cansada, siguió trabajando.","tr":"Yorgun olmasına rağmen çalışmaya devam etti."}]},
  {"id":"es-expr-no-obstante","languageId":"es","category":"expressions","level":"B2","sourceText":"no obstante","translations":{"tr":["bununla birlikte","ancak"]},"tags":["discourse-marker"],"details":{"usage":"Sin embargo'nun resmî/yazılı karşılığı.","register":"formal"},"examples":[{"text":"El plan es bueno; no obstante, es caro.","tr":"Plan iyi; bununla birlikte pahalı."}]},
  {"id":"es-expr-por-el-contrario","languageId":"es","category":"expressions","level":"B2","sourceText":"por el contrario","translations":{"tr":["tam tersine","aksine"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"No está enfadado; por el contrario, está encantado.","tr":"Kızgın değil; aksine çok memnun."}]},
  {"id":"es-expr-con-tal-de-que","languageId":"es","category":"expressions","level":"B2","sourceText":"con tal de que","translations":{"tr":["yeter ki","…mak şartıyla"]},"details":{"usage":"Ardından subjuntivo gelir.","register":"neutral"},"examples":[{"text":"Te lo presto con tal de que me lo devuelvas.","tr":"Geri vermen şartıyla sana ödünç veririm."}]},
  {"id":"es-expr-a-menos-que","languageId":"es","category":"expressions","level":"B2","sourceText":"a menos que","translations":{"tr":["…medikçe","…mazsa"]},"details":{"usage":"Ardından subjuntivo gelir.","register":"neutral"},"examples":[{"text":"Iremos a la playa, a menos que llueva.","tr":"Yağmur yağmazsa plaja gideceğiz."}]},
  {"id":"es-expr-siempre-que","languageId":"es","category":"expressions","level":"B2","sourceText":"siempre que","translations":{"tr":["yeter ki","…dığı sürece","her …dığında"]},"details":{"usage":"Şart anlamında subjuntivo, 'her zaman' anlamında indicativo.","register":"neutral"},"examples":[{"text":"Puedes salir siempre que vuelvas antes de las doce.","tr":"On ikiden önce dönmen şartıyla çıkabilirsin."}]},
  {"id":"es-expr-en-caso-de-que","languageId":"es","category":"expressions","level":"B2","sourceText":"en caso de que","translations":{"tr":["…ması durumunda","eğer"]},"details":{"usage":"Ardından subjuntivo gelir.","register":"neutral"},"examples":[{"text":"En caso de que no puedas venir, avísame.","tr":"Gelemezsen bana haber ver."}]},
  {"id":"es-expr-en-cuanto-a","languageId":"es","category":"expressions","level":"B2","sourceText":"en cuanto a","translations":{"tr":["…e gelince","…konusunda"]},"tags":["discourse-marker"],"details":{"usage":"Konu başlığını tanıtır; en cuanto (…ir …irmez) ile karıştırma.","register":"neutral"},"examples":[{"text":"En cuanto al precio, lo hablamos luego.","tr":"Fiyata gelince, sonra konuşuruz."}]},
  {"id":"es-expr-con-respecto-a","languageId":"es","category":"expressions","level":"B2","sourceText":"con respecto a","translations":{"tr":["…ile ilgili olarak","…konusunda"]},"details":{"usage":"Respecto a da denir.","register":"formal"},"examples":[{"text":"Con respecto a su pregunta, le responderemos pronto.","tr":"Sorunuzla ilgili olarak size yakında dönüş yapacağız."}]},
  {"id":"es-expr-en-relacion-con","languageId":"es","category":"expressions","level":"B2","sourceText":"en relación con","translations":{"tr":["…ile ilgili olarak"]},"details":{"register":"formal"},"examples":[{"text":"Le escribo en relación con el anuncio.","tr":"İlanla ilgili olarak size yazıyorum."}]},
  {"id":"es-expr-en-cuanto","languageId":"es","category":"expressions","level":"B2","sourceText":"en cuanto","translations":{"tr":["…ir …irmez","…dığı anda"]},"details":{"usage":"Gelecek için subjuntivo: En cuanto llegues, llámame.","register":"neutral"},"examples":[{"text":"En cuanto llegue a casa, te llamo.","tr":"Eve varır varmaz seni ararım."}]},
  {"id":"es-expr-tan-pronto-como","languageId":"es","category":"expressions","level":"B2","sourceText":"tan pronto como","translations":{"tr":["…ir …irmez"]},"details":{"usage":"En cuanto ile aynı; biraz daha resmî.","register":"neutral"},"examples":[{"text":"Tan pronto como sepa algo, te aviso.","tr":"Bir şey öğrenir öğrenmez haber veririm."}]},
  {"id":"es-expr-a-medida-que","languageId":"es","category":"expressions","level":"B2","sourceText":"a medida que","translations":{"tr":["…dıkça"]},"details":{"register":"neutral"},"examples":[{"text":"A medida que pasa el tiempo, lo entiendo mejor.","tr":"Zaman geçtikçe daha iyi anlıyorum."}]},
  {"id":"es-expr-a-largo-plazo","languageId":"es","category":"expressions","level":"B2","sourceText":"a largo plazo","translations":{"tr":["uzun vadede"]},"details":{"usage":"Karşıtı: a corto plazo (kısa vadede).","register":"neutral"},"examples":[{"text":"A largo plazo, es una buena inversión.","tr":"Uzun vadede iyi bir yatırım."}]},
  {"id":"es-expr-a-corto-plazo","languageId":"es","category":"expressions","level":"B2","sourceText":"a corto plazo","translations":{"tr":["kısa vadede"]},"details":{"register":"neutral"},"examples":[{"text":"A corto plazo no veo cambios.","tr":"Kısa vadede bir değişiklik görmüyorum."}]},
  {"id":"es-expr-en-definitiva","languageId":"es","category":"expressions","level":"B2","sourceText":"en definitiva","translations":{"tr":["kısacası","sonuçta"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"En definitiva, no merece la pena.","tr":"Kısacası buna değmez."}]},
  {"id":"es-expr-al-fin-y-al-cabo","languageId":"es","category":"expressions","level":"B2","sourceText":"al fin y al cabo","translations":{"tr":["ne de olsa","sonuçta"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Ayúdale; al fin y al cabo, es tu hermano.","tr":"Ona yardım et; ne de olsa kardeşin."}]},
  {"id":"es-expr-dicho-de-otro-modo","languageId":"es","category":"expressions","level":"B2","sourceText":"dicho de otro modo","translations":{"tr":["başka bir deyişle"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Dicho de otro modo, hay que empezar de cero.","tr":"Başka bir deyişle, sıfırdan başlamak gerekiyor."}]},
  {"id":"es-expr-mejor-dicho","languageId":"es","category":"expressions","level":"B2","sourceText":"mejor dicho","translations":{"tr":["daha doğrusu"]},"tags":["discourse-marker"],"details":{"usage":"Kendini düzeltirken.","register":"neutral"},"examples":[{"text":"Llego el lunes; mejor dicho, el martes.","tr":"Pazartesi geliyorum; daha doğrusu salı."}]},
  {"id":"es-expr-es-mas","languageId":"es","category":"expressions","level":"B2","sourceText":"es más","translations":{"tr":["dahası","hatta"]},"tags":["discourse-marker"],"details":{"usage":"Daha güçlü bir argüman eklerken.","register":"neutral"},"examples":[{"text":"No me gusta; es más, me parece horrible.","tr":"Hoşuma gitmiyor; hatta bence berbat."}]},
  {"id":"es-expr-encima","languageId":"es","category":"expressions","level":"B2","sourceText":"encima","translations":{"tr":["üstüne üstlük","bir de"]},"tags":["discourse-marker"],"details":{"usage":"Olumsuz bir duruma bir kötülük daha eklerken.","register":"informal"},"examples":[{"text":"Llegó tarde y encima se quejó.","tr":"Geç geldi, üstüne bir de şikâyet etti."}]},
  {"id":"es-expr-y-eso-que","languageId":"es","category":"expressions","level":"B2","sourceText":"y eso que","translations":{"tr":["hem de","üstelik … olduğu hâlde"]},"details":{"usage":"Şaşırtıcı bir karşıtlığı vurgular.","register":"informal"},"examples":[{"text":"Suspendió, y eso que estudió mucho.","tr":"Kaldı, hem de çok çalıştığı hâlde."}]},
  {"id":"es-expr-en-cualquier-caso","languageId":"es","category":"expressions","level":"B2","sourceText":"en cualquier caso","translations":{"tr":["her durumda","ne olursa olsun"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"En cualquier caso, te llamo mañana.","tr":"Her durumda yarın seni ararım."}]},
  {"id":"es-expr-en-todo-caso","languageId":"es","category":"expressions","level":"B2","sourceText":"en todo caso","translations":{"tr":["her hâlükârda","olsa olsa"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"No es culpa suya; en todo caso, es mía.","tr":"Onun suçu değil; olsa olsa benim."}]},
  {"id":"es-expr-pase-lo-que-pase","languageId":"es","category":"expressions","level":"B2","sourceText":"pase lo que pase","translations":{"tr":["ne olursa olsun"]},"details":{"register":"neutral"},"examples":[{"text":"Pase lo que pase, estaré contigo.","tr":"Ne olursa olsun yanında olacağım."}]},
  {"id":"es-expr-de-lo-contrario","languageId":"es","category":"expressions","level":"B2","sourceText":"de lo contrario","translations":{"tr":["aksi takdirde","yoksa"]},"details":{"register":"neutral"},"examples":[{"text":"Date prisa; de lo contrario, perderemos el tren.","tr":"Acele et; yoksa treni kaçıracağız."}]},
  {"id":"es-expr-ni-mucho-menos","languageId":"es","category":"expressions","level":"B2","sourceText":"ni mucho menos","translations":{"tr":["hiç de değil","katiyen"]},"details":{"register":"neutral"},"examples":[{"text":"No es fácil, ni mucho menos.","tr":"Kolay değil, hiç de değil."}]},
  {"id":"es-expr-en-absoluto","languageId":"es","category":"expressions","level":"B2","sourceText":"en absoluto","translations":{"tr":["kesinlikle hayır","hiç"]},"details":{"usage":"Tek başına cevap olarak 'hiç de değil' anlamındadır.","register":"neutral"},"examples":[{"text":"—¿Le molesta el humo? —En absoluto.","tr":"—Duman rahatsız ediyor mu? —Hiç de değil."}]},
  {"id":"es-expr-ni-de-broma","languageId":"es","category":"expressions","level":"B2","sourceText":"ni de broma","translations":{"tr":["şakası bile olmaz","asla"]},"details":{"register":"informal"},"examples":[{"text":"¿Saltar en paracaídas? ¡Ni de broma!","tr":"Paraşütle atlamak mı? Şakası bile olmaz!"}]},
  {"id":"es-expr-que-mas-da","languageId":"es","category":"expressions","level":"B2","sourceText":"¡qué más da!","translations":{"tr":["ne fark eder!","boş ver!"]},"details":{"register":"informal"},"examples":[{"text":"¿Rojo o azul? ¡Qué más da!","tr":"Kırmızı mı mavi mi? Ne fark eder!"}]},
  {"id":"es-expr-como-que","languageId":"es","category":"expressions","level":"B2","sourceText":"¿cómo que...?","translations":{"tr":["ne demek …?","nasıl yani …?"]},"details":{"usage":"Şaşkınlık ya da itirazla birinin sözünü tekrarlar.","register":"informal"},"examples":[{"text":"¿Cómo que no vienes?","tr":"Ne demek gelmiyorsun?"}]},
  {"id":"es-expr-eso-si","languageId":"es","category":"expressions","level":"B2","sourceText":"eso sí","translations":{"tr":["ama şu var ki","yalnız"]},"tags":["discourse-marker"],"details":{"usage":"Önceki söze bir kayıt ya da şart ekler.","register":"neutral"},"examples":[{"text":"Puedes venir; eso sí, trae algo de comer.","tr":"Gelebilirsin; yalnız yiyecek bir şey getir."}]},
  {"id":"es-expr-el-caso-es-que","languageId":"es","category":"expressions","level":"B2","sourceText":"el caso es que","translations":{"tr":["mesele şu ki","işin aslı"]},"tags":["discourse-marker"],"details":{"register":"informal"},"examples":[{"text":"El caso es que no me acuerdo de su nombre.","tr":"Mesele şu ki adını hatırlamıyorum."}]},
