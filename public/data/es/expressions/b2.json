  {"id":"es-expr-cuanto-mas-mas","languageId":"es","category":"expressions","level":"B2","sourceText":"cuanto más... más...","translations":{"tr":["ne kadar çok... o kadar çok..."]},"details":{"register":"neutral"},"examples":[{"text":"Cuanto más estudias, más aprendes.","tr":"Ne kadar çok çalışırsan o kadar çok öğrenirsin."}]},
