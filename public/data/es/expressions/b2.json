  {"id":"es-expr-en-el-fondo","languageId":"es","category":"expressions","level":"B2","sourceText":"en el fondo","translations":{"tr":["aslında","özünde","içten içe"]},"details":{"register":"neutral"},"examples":[{"text":"Parece duro, pero en el fondo es muy sensible.","tr":"Sert görünüyor ama özünde çok duygusal."}]},
  {"id":"es-expr-de-paso","languageId":"es","category":"expressions","level":"B2","sourceText":"de paso","translations":{"tr":["hazır gelmişken","bu arada"]},"details":{"register":"neutral"},"examples":[{"text":"Voy al súper y, de paso, compro pan.","tr":"Markete gidiyorum, hazır gitmişken ekmek de alırım."}]},
  {"id":"es-expr-mas-bien","languageId":"es","category":"expressions","level":"B2","sourceText":"más bien","translations":{"tr":["daha çok","aslında"]},"details":{"usage":"Bir ifadeyi düzelterek daha doğrusunu verir.","register":"neutral"},"examples":[{"text":"No es guapo; es más bien simpático.","tr":"Yakışıklı değil; daha çok sevimli."}]},
  {"id":"es-expr-por-asi-decirlo","languageId":"es","category":"expressions","level":"B2","sourceText":"por así decirlo","translations":{"tr":["tabiri caizse","bir bakıma"]},"details":{"register":"neutral"},"examples":[{"text":"Es, por así decirlo, el jefe no oficial.","tr":"O, tabiri caizse, gayriresmî patron."}]},
  {"id":"es-expr-como-si-nada","languageId":"es","category":"expressions","level":"B2","sourceText":"como si nada","translations":{"tr":["hiçbir şey olmamış gibi"]},"details":{"register":"neutral"},"examples":[{"text":"Rompió el vaso y siguió hablando como si nada.","tr":"Bardağı kırdı ve hiçbir şey olmamış gibi konuşmaya devam etti."}]},
  {"id":"es-expr-sin-lugar-a-dudas","languageId":"es","category":"expressions","level":"B2","sourceText":"sin lugar a dudas","translations":{"tr":["hiç şüphesiz"]},"details":{"register":"formal"},"examples":[{"text":"Es, sin lugar a dudas, su mejor novela.","tr":"Hiç şüphesiz onun en iyi romanı."}]},
  {"id":"es-expr-no-cabe-duda-de-que","languageId":"es","category":"expressions","level":"B2","sourceText":"no cabe duda de que","translations":{"tr":["şüphe yok ki"]},"details":{"register":"formal"},"examples":[{"text":"No cabe duda de que ha mejorado.","tr":"Şüphe yok ki gelişti."}]},
  {"id":"es-expr-lo-mas-probable-es-que","languageId":"es","category":"expressions","level":"B2","sourceText":"lo más probable es que","translations":{"tr":["büyük ihtimalle"]},"details":{"usage":"Ardından subjuntivo gelir.","register":"neutral"},"examples":[{"text":"Lo más probable es que llueva.","tr":"Büyük ihtimalle yağmur yağacak."}]},
  {"id":"es-expr-teniendo-en-cuenta","languageId":"es","category":"expressions","level":"B2","sourceText":"teniendo en cuenta","translations":{"tr":["…ı göz önünde bulundurarak","…ı hesaba katarsak"]},"details":{"register":"neutral"},"examples":[{"text":"Teniendo en cuenta el precio, es un buen hotel.","tr":"Fiyatı hesaba katarsak iyi bir otel."}]},
  {"id":"es-expr-hay-que-tener-en-cuenta-que","languageId":"es","category":"expressions","level":"B2","sourceText":"hay que tener en cuenta que","translations":{"tr":["şunu göz önünde bulundurmak gerekir ki"]},"details":{"register":"neutral"},"examples":[{"text":"Hay que tener en cuenta que es su primer año.","tr":"Bunun onun ilk yılı olduğunu göz önünde bulundurmak gerek."}]},
  {"id":"es-expr-con-el-fin-de","languageId":"es","category":"expressions","level":"B2","sourceText":"con el fin de","translations":{"tr":["…mak amacıyla"]},"details":{"register":"formal"},"examples":[{"text":"Ahorra con el fin de comprar una casa.","tr":"Ev almak amacıyla para biriktiriyor."}]},
  {"id":"es-expr-a-lo-largo-de","languageId":"es","category":"expressions","level":"B2","sourceText":"a lo largo de","translations":{"tr":["boyunca"]},"details":{"usage":"Hem zaman hem mekân için: a lo largo del río.","register":"neutral"},"examples":[{"text":"A lo largo de su vida viajó mucho.","tr":"Hayatı boyunca çok seyahat etti."}]},
  {"id":"es-expr-junto-con","languageId":"es","category":"expressions","level":"B2","sourceText":"junto con","translations":{"tr":["ile birlikte"]},"details":{"register":"neutral"},"examples":[{"text":"Envíe el formulario junto con una foto.","tr":"Formu bir fotoğrafla birlikte gönderin."}]},
  {"id":"es-expr-a-base-de","languageId":"es","category":"expressions","level":"B2","sourceText":"a base de","translations":{"tr":["…sayesinde","…ile (yapılmış)"]},"details":{"usage":"Çaba/ yöntem ya da malzeme bildirir.","register":"neutral"},"examples":[{"text":"Aprendió a base de practicar todos los días.","tr":"Her gün pratik yaparak öğrendi."}]},
  {"id":"es-expr-en-principio","languageId":"es","category":"expressions","level":"B2","sourceText":"en principio","translations":{"tr":["prensipte","şimdilik"]},"details":{"usage":"Planın değişebileceğini ima eder.","register":"neutral"},"examples":[{"text":"En principio, la reunión es el jueves.","tr":"Şimdilik toplantı perşembe."}]},
  {"id":"es-expr-en-la-practica","languageId":"es","category":"expressions","level":"B2","sourceText":"en la práctica","translations":{"tr":["uygulamada","pratikte"]},"details":{"register":"neutral"},"examples":[{"text":"En la práctica, las cosas son más complicadas.","tr":"Uygulamada işler daha karmaşık."}]},
  {"id":"es-expr-efectivamente","languageId":"es","category":"expressions","level":"B2","sourceText":"efectivamente","translations":{"tr":["gerçekten de","aynen öyle"]},"tags":["discourse-marker"],"details":{"usage":"Bir tahmini ya da söyleneni onaylar.","register":"neutral"},"examples":[{"text":"—¿Es usted el señor Ruiz? —Efectivamente.","tr":"—Bay Ruiz siz misiniz? —Aynen öyle."}]},
  {"id":"es-expr-antes-que-nada","languageId":"es","category":"expressions","level":"B2","sourceText":"antes que nada","translations":{"tr":["her şeyden önce"]},"tags":["discourse-marker"],"details":{"register":"neutral"},"examples":[{"text":"Antes que nada, bienvenidos a todos.","tr":"Her şeyden önce, hepiniz hoş geldiniz."}]},
  {"id":"es-expr-ante-todo","languageId":"es","category":"expressions","level":"B2","sourceText":"ante todo","translations":{"tr":["her şeyden önce","her şeyin başında"]},"details":{"register":"neutral"},"examples":[{"text":"Ante todo, mantén la calma.","tr":"Her şeyden önce sakin ol."}]},
  {"id":"es-expr-en-particular","languageId":"es","category":"expressions","level":"B2","sourceText":"en particular","translations":{"tr":["özellikle","bilhassa"]},"details":{"register":"neutral"},"examples":[{"text":"Me interesa la historia, en particular la medieval.","tr":"Tarih ilgimi çekiyor, özellikle Orta Çağ."}]},
