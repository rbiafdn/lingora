  {"id":"es-slang-cana","languageId":"es","category":"slang","level":"B1","sourceText":"caña","translations":{"tr":["küçük bardak bira"]},"details":{"usage":"İspanya. 'Dar caña' = bastırmak, sıkıştırmak.","register":"informal"},"examples":[{"text":"¿Nos tomamos unas cañas?","tr":"Birkaç bira içelim mi?"}]},
