[
  {"id":"en-slang-awesome","languageId":"en","category":"slang","level":"A2","sourceText":"awesome","translations":{"tr":["harika","müthiş"]},"details":{"usage":"Günlük konuşmada \"great\" yerine çok sık kullanılır, özellikle Amerikan İngilizcesinde. Asıl anlamı \"hayranlık uyandıran\"dır. Arkadaşlar arasında rahatça kullanılır; resmî yazıda \"excellent\" ya da \"impressive\" tercih edilir.","register":"informal"},"examples":[{"text":"We're going to the beach? Awesome!","tr":"Plaja mı gidiyoruz? Harika!"}]},
  {"id":"en-slang-cool","languageId":"en","category":"slang","level":"A2","sourceText":"cool","translations":{"tr":["harika","süper","tamam"]},"details":{"usage":"Asıl anlamı \"serin\"dir; konuşmada \"harika, güzel\" ya da onay olarak \"tamam, olur\" anlamında kullanılır (\"Cool, see you at six\"). Arkadaş ortamında ve rahat iş sohbetlerinde yaygındır; resmî yazıda kullanılmaz.","register":"informal"},"examples":[{"text":"I'll pick you up at eight. — Cool, thanks!","tr":"Seni sekizde alırım. — Süper, sağ ol!"}]},
  {"id":"en-slang-cmon","languageId":"en","category":"slang","level":"A2","sourceText":"c'mon","translations":{"tr":["hadi","haydi"]},"tags":["reduced-form"],"details":{"usage":"Acele ettirirken, cesaretlendirirken ya da \"yapma ya\" derken.","register":"informal","expansion":"come on"},"examples":[{"text":"C'mon, we're late!","tr":"Hadi, geç kaldık!"}]},
  {"id":"en-slang-nope","languageId":"en","category":"slang","level":"A2","sourceText":"nope","translations":{"tr":["yok","hayır"]},"tags":["reduced-form"],"details":{"usage":"Samimi \"hayır\"; resmî ortamda kaba kaçabilir.","register":"informal","expansion":"no"},"examples":[{"text":"Are you hungry? — Nope.","tr":"Aç mısın? — Yok."}]},
  {"id":"en-slang-yep","languageId":"en","category":"slang","level":"A2","sourceText":"yep","translations":{"tr":["evet","he"]},"tags":["reduced-form"],"details":{"usage":"Samimi \"evet\"; \"yeah\"dan da kısa ve kesin.","register":"informal","expansion":"yes"},"examples":[{"text":"Ready? — Yep!","tr":"Hazır mısın? — Evet!"}]},
  {"id":"en-slang-nah","languageId":"en","category":"slang","level":"A2","sourceText":"nah","translations":{"tr":["yok","yok ya"]},"tags":["reduced-form"],"details":{"usage":"Rahat, samimi \"hayır\".","register":"informal","expansion":"no"},"examples":[{"text":"Want some? — Nah, I'm good.","tr":"İster misin? — Yok, sağ ol."}]},
  {"id":"en-slang-uh-huh","languageId":"en","category":"slang","level":"A2","sourceText":"uh-huh","translations":{"tr":["hı hı","evet"]},"tags":["reduced-form"],"details":{"usage":"Dinlediğini göstermek ya da \"evet\" demek için; resmî ortamda kullanma.","register":"informal","expansion":"yes"},"examples":[{"text":"Did you lock the door? — Uh-huh.","tr":"Kapıyı kilitledin mi? — Hı hı."}]},
  {"id":"en-slang-mate","languageId":"en","category":"slang","level":"A2","sourceText":"mate","translations":{"tr":["dostum","kanka"]},"details":{"usage":"İngiltere ve Avustralya'da arkadaşlar, hatta yabancılar arasında hitap.","register":"informal"},"examples":[{"text":"Cheers, mate!","tr":"Sağ ol dostum!"}]},
  {"id":"en-slang-buddy","languageId":"en","category":"slang","level":"A2","sourceText":"buddy","translations":{"tr":["dostum","arkadaş"]},"details":{"usage":"Arkadaş ya da tanımadığın erkeğe hitap; sert tonla tehditkâr da olabilir.","register":"informal"},"examples":[{"text":"Hey buddy, you dropped your wallet.","tr":"Hey dostum, cüzdanını düşürdün."}]},
  {"id":"en-slang-you-guys","languageId":"en","category":"slang","level":"A2","sourceText":"you guys","translations":{"tr":["siz","millet"]},"details":{"usage":"Bir gruba hitap; kadınları da kapsar.","register":"informal"},"examples":[{"text":"Are you guys ready?","tr":"Hazır mısınız millet?"}]}
]
