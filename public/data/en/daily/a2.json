[
  {"id":"en-daily-whats-up","languageId":"en","category":"daily","level":"A2","sourceText":"What's up?","translations":{"tr":["ne haber?"]},"details":{"context":"Arkadaşlarla selamlaşırken. Cevap genellikle \"Not much\" ya da \"Nothing much\".","register":"informal"},"examples":[{"text":"Hey Tom, what's up? — Not much, you?","tr":"Selam Tom, ne haber? — Pek bir şey yok, sende?"}]},
  {"id":"en-daily-no-worries","languageId":"en","category":"daily","level":"A2","sourceText":"No worries","translations":{"tr":["sorun değil","dert etme"]},"details":{"context":"Teşekkür ya da özre karşılık olarak. Özellikle Avustralya ve İngiltere'de çok yaygın.","register":"informal"},"examples":[{"text":"Sorry I'm late. — No worries!","tr":"Geç kaldığım için üzgünüm. — Sorun değil!"}]},
  {"id":"en-daily-sounds-good","languageId":"en","category":"daily","level":"A2","sourceText":"Sounds good","translations":{"tr":["tamam","kulağa iyi geliyor"]},"details":{"context":"Bir öneriyi ya da planı kabul ederken.","register":"neutral"},"examples":[{"text":"Let's meet at six. — Sounds good.","tr":"Altıda buluşalım. — Tamamdır."}]},
  {"id":"en-daily-hows-it-going","languageId":"en","category":"daily","level":"A2","sourceText":"How's it going?","translations":{"tr":["nasıl gidiyor?","naber?"]},"details":{"context":"Tanıdık biriyle selamlaşırken \"How are you?\" sorusunun samimi hâli. Cevap genellikle \"Good, thanks\", \"Not bad\" ya da \"Pretty good\".","register":"informal"},"examples":[{"text":"Hi Sarah, how's it going? — Pretty good, thanks.","tr":"Selam Sarah, nasıl gidiyor? — Gayet iyi, teşekkürler."}]},
  {"id":"en-daily-never-mind","languageId":"en","category":"daily","level":"A2","sourceText":"Never mind","translations":{"tr":["boş ver","önemli değil"]},"details":{"context":"Bir şeyin önemsiz olduğunu söylerken, bir özre karşılık verirken ya da söylediğini tekrar etmekten vazgeçerken. \"I don't mind\" (bana fark etmez) ile karıştırılmamalı.","register":"neutral"},"examples":[{"text":"Sorry, I forgot your book. — Never mind, I'll get it tomorrow.","tr":"Kusura bakma, kitabını unuttum. — Boş ver, yarın alırım."}]},
  {"id":"en-daily-long-time-no-see","languageId":"en","category":"daily","level":"A2","sourceText":"Long time no see","translations":{"tr":["görüşmeyeli uzun zaman oldu","nerelerdeydin?"]},"details":{"context":"Uzun süredir görmediğin biriyle karşılaştığında söylenir. Dil bilgisi açısından kurallı değildir ama kalıplaşmış bir ifadedir.","register":"informal"},"examples":[{"text":"Hey, Mark! Long time no see! How have you been?","tr":"Hey Mark! Görüşmeyeli uzun zaman oldu! Nasılsın?"}]},
  {"id":"en-daily-morning","languageId":"en","category":"daily","level":"A2","sourceText":"Morning!","translations":{"tr":["günaydın"]},"details":{"register":"informal","context":"\"Good morning\"ın kısa, samimi hâli."},"examples":[{"text":"Morning! Did you sleep well?","tr":"Günaydın! İyi uyudun mu?"}]},
  {"id":"en-daily-how-are-you-doing","languageId":"en","category":"daily","level":"A2","sourceText":"How are you doing?","translations":{"tr":["nasılsın?","nasıl gidiyor?"]},"details":{"register":"neutral","context":"Selamlaşırken; cevap genelde kısa: \"Good, thanks.\""},"examples":[{"text":"Hey Sam, how are you doing?","tr":"Selam Sam, nasılsın?"}]},
  {"id":"en-daily-how-have-you-been","languageId":"en","category":"daily","level":"A2","sourceText":"How have you been?","translations":{"tr":["nasılsın bakalım?","neler yaptın?"]},"details":{"register":"neutral","context":"Bir süredir görmediğin birine."},"examples":[{"text":"Hi! How have you been? It's been a while.","tr":"Selam! Nasılsın? Epeydir görüşmedik."}]},
  {"id":"en-daily-not-bad","languageId":"en","category":"daily","level":"A2","sourceText":"Not bad.","translations":{"tr":["fena değil"]},"details":{"register":"informal","context":"Hâlini soran birine; aslında \"iyi\" demek."},"examples":[{"text":"How's it going? — Not bad, thanks.","tr":"Nasıl gidiyor? — Fena değil, sağ ol."}]},
  {"id":"en-daily-pretty-good","languageId":"en","category":"daily","level":"A2","sourceText":"Pretty good.","translations":{"tr":["gayet iyi","iyi sayılır"]},"details":{"register":"informal","context":"Hâl hatır sorulduğunda."},"examples":[{"text":"How was the trip? — Pretty good, actually.","tr":"Gezi nasıldı? — Aslında gayet iyiydi."}]},
  {"id":"en-daily-all-good","languageId":"en","category":"daily","level":"A2","sourceText":"All good.","translations":{"tr":["her şey yolunda","sorun yok"]},"details":{"register":"informal","context":"Hâl sorulunca ya da özür dilenince."},"examples":[{"text":"Sorry I'm late! — All good, don't worry.","tr":"Geç kaldığım için kusura bakma! — Sorun yok, merak etme."}]},
  {"id":"en-daily-not-much","languageId":"en","category":"daily","level":"A2","sourceText":"Not much.","translations":{"tr":["pek bir şey yok","öyle işte"]},"details":{"register":"informal","context":"\"What's up?\" / \"What's new?\" sorusuna cevap."},"examples":[{"text":"What's up? — Not much. You?","tr":"Ne haber? — Pek bir şey yok. Sende?"}]},
  {"id":"en-daily-same-here","languageId":"en","category":"daily","level":"A2","sourceText":"Same here.","translations":{"tr":["bende de öyle","ben de"]},"details":{"register":"informal","context":"Karşındakinin söylediği senin için de geçerliyse."},"examples":[{"text":"I'm so tired today. — Same here.","tr":"Bugün çok yorgunum. — Ben de."}]},
  {"id":"en-daily-same-to-you","languageId":"en","category":"daily","level":"A2","sourceText":"Same to you.","translations":{"tr":["sana da","size de"]},"details":{"register":"neutral","context":"Bir dileğe aynı dilekle karşılık verirken."},"examples":[{"text":"Have a great weekend! — Same to you!","tr":"İyi hafta sonları! — Sana da!"}]},
  {"id":"en-daily-good-to-see-you","languageId":"en","category":"daily","level":"A2","sourceText":"Good to see you.","translations":{"tr":["seni görmek güzel"]},"details":{"register":"neutral","context":"Tanıdık biriyle karşılaşınca ya da ayrılırken."},"examples":[{"text":"Good to see you! How's the family?","tr":"Seni görmek güzel! Ailen nasıl?"}]},
  {"id":"en-daily-how-was-your-day","languageId":"en","category":"daily","level":"A2","sourceText":"How was your day?","translations":{"tr":["günün nasıl geçti?"]},"details":{"register":"neutral","context":"Akşam eve gelen birine, aile ya da arkadaş arasında."},"examples":[{"text":"Hi, love. How was your day?","tr":"Selam canım. Günün nasıl geçti?"}]},
  {"id":"en-daily-did-you-have-a-good-weekend","languageId":"en","category":"daily","level":"A2","sourceText":"Did you have a good weekend?","translations":{"tr":["hafta sonu nasıl geçti?"]},"details":{"register":"neutral","context":"Pazartesi iş yerinde/okulda sohbet açmak için."},"examples":[{"text":"Did you have a good weekend? — Yeah, really relaxing.","tr":"Hafta sonun iyi geçti mi? — Evet, çok dinlendirici."}]},
  {"id":"en-daily-welcome-back","languageId":"en","category":"daily","level":"A2","sourceText":"Welcome back!","translations":{"tr":["tekrar hoş geldin"]},"details":{"register":"neutral","context":"Tatilden, yolculuktan dönen birine."},"examples":[{"text":"Welcome back! How was Spain?","tr":"Tekrar hoş geldin! İspanya nasıldı?"}]},
  {"id":"en-daily-whats-new","languageId":"en","category":"daily","level":"A2","sourceText":"What's new?","translations":{"tr":["ne var ne yok?","yeni bir şey var mı?"]},"details":{"register":"informal","context":"Samimi selamlaşmadan sonra sohbet açmak için."},"examples":[{"text":"Hey! What's new with you?","tr":"Selam! Sende ne var ne yok?"}]},
  {"id":"en-daily-hows-work","languageId":"en","category":"daily","level":"A2","sourceText":"How's work?","translations":{"tr":["iş nasıl gidiyor?"]},"details":{"register":"neutral","context":"Tanıdık biriyle küçük sohbet."},"examples":[{"text":"So, how's work these days?","tr":"Eee, bu aralar iş nasıl?"}]},
  {"id":"en-daily-got-it","languageId":"en","category":"daily","level":"A2","sourceText":"Got it.","translations":{"tr":["anladım","tamamdır"]},"details":{"register":"informal","context":"Bir açıklamayı ya da talimatı anladığını belirtirken."},"examples":[{"text":"Turn left after the bank. — Got it.","tr":"Bankadan sonra sola dön. — Anladım."}]},
  {"id":"en-daily-good-for-you","languageId":"en","category":"daily","level":"A2","sourceText":"Good for you!","translations":{"tr":["aferin sana!","ne güzel!"]},"details":{"register":"neutral","context":"Birinin başarısına ya da iyi kararına sevinirken."},"examples":[{"text":"I finally quit smoking. — Good for you!","tr":"Sonunda sigarayı bıraktım. — Aferin sana!"}]},
  {"id":"en-daily-seriously","languageId":"en","category":"daily","level":"A2","sourceText":"Seriously?","translations":{"tr":["cidden mi?","ciddi misin?"]},"details":{"register":"informal","context":"Şaşkınlık ya da inanmazlık belirtirken."},"examples":[{"text":"I got the job! — Seriously? That's amazing!","tr":"İşi aldım! — Cidden mi? Harika!"}]},
  {"id":"en-daily-i-cant-believe-it","languageId":"en","category":"daily","level":"A2","sourceText":"I can't believe it!","translations":{"tr":["inanamıyorum!"]},"details":{"register":"neutral","context":"Çok şaşırtıcı iyi ya da kötü bir habere."},"examples":[{"text":"We won! I can't believe it!","tr":"Kazandık! İnanamıyorum!"}]},
  {"id":"en-daily-lucky-you","languageId":"en","category":"daily","level":"A2","sourceText":"Lucky you!","translations":{"tr":["şanslısın!","ne şanslısın!"]},"details":{"register":"informal","context":"Birinin güzel bir şeyi olduğunda, hafif imrenerek."},"examples":[{"text":"I'm off to Italy tomorrow. — Lucky you!","tr":"Yarın İtalya'ya gidiyorum. — Şanslısın!"}]},
  {"id":"en-daily-well-done","languageId":"en","category":"daily","level":"A2","sourceText":"Well done!","translations":{"tr":["aferin!","tebrikler!"]},"details":{"register":"neutral","context":"Birinin başarısını övmek için."},"examples":[{"text":"I passed my driving test! — Well done!","tr":"Ehliyet sınavını geçtim! — Aferin!"}]},
  {"id":"en-daily-i-see","languageId":"en","category":"daily","level":"A2","sourceText":"I see.","translations":{"tr":["anlıyorum","hı hı, anladım"]},"details":{"register":"neutral","context":"Dinlediğini ve anladığını göstermek için."},"examples":[{"text":"The train is delayed because of the snow. — I see.","tr":"Tren kar yüzünden gecikti. — Anlıyorum."}]},
  {"id":"en-daily-i-get-it","languageId":"en","category":"daily","level":"A2","sourceText":"I get it.","translations":{"tr":["anladım","kafama yattı"]},"details":{"register":"informal","context":"Bir şeyi sonunda anlayınca ya da birinin hâlini anladığını söylerken."},"examples":[{"text":"Oh, now I get it! Thanks.","tr":"Ha, şimdi anladım! Sağ ol."}]},
  {"id":"en-daily-exactly","languageId":"en","category":"daily","level":"A2","sourceText":"Exactly!","translations":{"tr":["aynen!","kesinlikle!"]},"details":{"register":"neutral","context":"Karşındakinin söylediğine tam katılırken."},"examples":[{"text":"So we just need more time? — Exactly!","tr":"Yani sadece daha fazla zamana mı ihtiyacımız var? — Aynen!"}]},
  {"id":"en-daily-thats-not-fair","languageId":"en","category":"daily","level":"A2","sourceText":"That's not fair!","translations":{"tr":["bu haksızlık!"]},"details":{"register":"neutral","context":"Bir durumu adaletsiz bulduğunda."},"examples":[{"text":"Why does he get a bigger piece? That's not fair!","tr":"Neden onun parçası daha büyük? Bu haksızlık!"}]},
  {"id":"en-daily-thats-weird","languageId":"en","category":"daily","level":"A2","sourceText":"That's weird.","translations":{"tr":["tuhaf","garip"]},"details":{"register":"informal","context":"Beklenmedik ya da anlamsız bir şeye."},"examples":[{"text":"The door was open when I got home. — That's weird.","tr":"Eve geldiğimde kapı açıktı. — Garip."}]},
  {"id":"en-daily-oh-my-god","languageId":"en","category":"daily","level":"A2","sourceText":"Oh my God!","translations":{"tr":["aman Tanrım!","hayret!"]},"details":{"register":"informal","context":"Büyük şaşkınlıkta; bazı dindar kişiler hoş karşılamaz, yerine \"Oh my gosh\" denir."},"examples":[{"text":"Oh my God, look at that view!","tr":"Aman Tanrım, şu manzaraya bak!"}]},
  {"id":"en-daily-im-sorry-to-hear-that","languageId":"en","category":"daily","level":"A2","sourceText":"I'm sorry to hear that.","translations":{"tr":["buna üzüldüm","çok üzüldüm"]},"details":{"register":"neutral","context":"Birinin kötü haberine kibarca karşılık."},"examples":[{"text":"My grandma is in hospital. — I'm sorry to hear that.","tr":"Babaannem hastanede. — Buna çok üzüldüm."}]},
  {"id":"en-daily-thats-too-bad","languageId":"en","category":"daily","level":"A2","sourceText":"That's too bad.","translations":{"tr":["çok kötü","ne yazık"]},"details":{"register":"neutral","context":"Hafif kötü habere; bazen ironik de olabilir."},"examples":[{"text":"I can't make it tonight. — That's too bad.","tr":"Bu akşam gelemiyorum. — Ne yazık."}]},
  {"id":"en-daily-who-knows","languageId":"en","category":"daily","level":"A2","sourceText":"Who knows?","translations":{"tr":["kim bilir?"]},"details":{"register":"neutral","context":"Bir şeyin sonucunu kimse bilemezken."},"examples":[{"text":"Will it be sunny tomorrow? — Who knows?","tr":"Yarın güneşli mi olur? — Kim bilir?"}]},
  {"id":"en-daily-just-kidding","languageId":"en","category":"daily","level":"A2","sourceText":"Just kidding.","translations":{"tr":["şaka yapıyorum","şakaydı"]},"details":{"register":"informal","context":"Az önce söylediğinin şaka olduğunu belirtirken."},"examples":[{"text":"I ate all the cake. Just kidding!","tr":"Pastanın hepsini yedim. Şakaydı!"}]},
  {"id":"en-daily-give-me-a-second","languageId":"en","category":"daily","level":"A2","sourceText":"Give me a second.","translations":{"tr":["bir saniye","bir dakika ver"]},"details":{"register":"informal","context":"Kısa süre beklemesini isterken."},"examples":[{"text":"Give me a second, I'm just finishing this email.","tr":"Bir saniye, şu e-postayı bitiriyorum."}]},
  {"id":"en-daily-just-a-minute","languageId":"en","category":"daily","level":"A2","sourceText":"Just a minute.","translations":{"tr":["bir dakika"]},"details":{"register":"neutral","context":"Birini kısa süre bekletirken."},"examples":[{"text":"Just a minute, I'll get my coat.","tr":"Bir dakika, montumu alayım."}]},
  {"id":"en-daily-could-you-say-that-again","languageId":"en","category":"daily","level":"A2","sourceText":"Could you say that again?","translations":{"tr":["tekrar söyler misin?"]},"details":{"register":"neutral","context":"Anlamadığın ya da duymadığın bir şeyi tekrarlatmak için."},"examples":[{"text":"Sorry, could you say that again?","tr":"Pardon, tekrar söyler misin?"}]},
  {"id":"en-daily-sorry-what-did-you-say","languageId":"en","category":"daily","level":"A2","sourceText":"Sorry, what did you say?","translations":{"tr":["pardon, ne dedin?"]},"details":{"register":"neutral","context":"Duymadığında."},"examples":[{"text":"Sorry, what did you say? It's so noisy here.","tr":"Pardon, ne dedin? Burası çok gürültülü."}]},
  {"id":"en-daily-pardon","languageId":"en","category":"daily","level":"A2","sourceText":"Pardon?","translations":{"tr":["efendim?","pardon?"]},"details":{"register":"neutral","context":"Duymadığın bir şeyi kibarca tekrar ettirirken."},"examples":[{"text":"Pardon? Could you repeat the number?","tr":"Efendim? Numarayı tekrarlar mısınız?"}]},
  {"id":"en-daily-what-do-you-mean","languageId":"en","category":"daily","level":"A2","sourceText":"What do you mean?","translations":{"tr":["ne demek istiyorsun?","nasıl yani?"]},"details":{"register":"neutral","context":"Söyleneni açıklatmak için."},"examples":[{"text":"What do you mean, it's closed?","tr":"Nasıl yani, kapalı mı?"}]},
  {"id":"en-daily-can-i-ask-you-something","languageId":"en","category":"daily","level":"A2","sourceText":"Can I ask you something?","translations":{"tr":["sana bir şey sorabilir miyim?"]},"details":{"register":"neutral","context":"Bir soruya geçmeden önce."},"examples":[{"text":"Can I ask you something? Are you happy here?","tr":"Sana bir şey sorabilir miyim? Burada mutlu musun?"}]},
  {"id":"en-daily-can-i-borrow","languageId":"en","category":"daily","level":"A2","sourceText":"Can I borrow…?","translations":{"tr":["…ödünç alabilir miyim?"]},"details":{"register":"neutral","context":"Bir şeyi geçici olarak istemek için."},"examples":[{"text":"Can I borrow your pen for a second?","tr":"Kalemini bir saniyeliğine alabilir miyim?"}]},
  {"id":"en-daily-after-you","languageId":"en","category":"daily","level":"A2","sourceText":"After you.","translations":{"tr":["önce siz buyurun"]},"details":{"register":"neutral","context":"Kapıda, asansörde birine yol verirken."},"examples":[{"text":"After you. — Oh, thank you!","tr":"Önce siz buyurun. — Aa, teşekkürler!"}]},
  {"id":"en-daily-help-yourself","languageId":"en","category":"daily","level":"A2","sourceText":"Help yourself.","translations":{"tr":["buyur, kendin al","çekinme, al"]},"details":{"register":"neutral","context":"Misafire yiyecek-içecek ikram ederken."},"examples":[{"text":"There's coffee in the kitchen. Help yourself.","tr":"Mutfakta kahve var. Çekinme, al."}]},
  {"id":"en-daily-watch-out","languageId":"en","category":"daily","level":"A2","sourceText":"Watch out!","translations":{"tr":["dikkat et!","dikkat!"]},"details":{"register":"neutral","context":"Ani bir tehlikeye karşı uyarırken."},"examples":[{"text":"Watch out! There's a car coming!","tr":"Dikkat! Araba geliyor!"}]},
  {"id":"en-daily-hurry-up","languageId":"en","category":"daily","level":"A2","sourceText":"Hurry up!","translations":{"tr":["acele et!","çabuk ol!"]},"details":{"register":"informal","context":"Birini hızlandırmak için; sert tonda kaba olabilir."},"examples":[{"text":"Hurry up, we're going to miss the train!","tr":"Acele et, treni kaçıracağız!"}]},
  {"id":"en-daily-let-me-think","languageId":"en","category":"daily","level":"A2","sourceText":"Let me think.","translations":{"tr":["bir düşüneyim"]},"details":{"register":"neutral","context":"Cevap vermeden önce zaman kazanmak için."},"examples":[{"text":"What's the best time? Let me think… Friday?","tr":"En uygun zaman ne? Bir düşüneyim… Cuma?"}]},
  {"id":"en-daily-wish-me-luck","languageId":"en","category":"daily","level":"A2","sourceText":"Wish me luck!","translations":{"tr":["bana şans dile!"]},"details":{"register":"informal","context":"Sınav, görüşme gibi önemli bir şeyden önce."},"examples":[{"text":"My interview is in ten minutes. Wish me luck!","tr":"Görüşmem on dakika sonra. Bana şans dile!"}]},
  {"id":"en-daily-its-my-fault","languageId":"en","category":"daily","level":"A2","sourceText":"It's my fault.","translations":{"tr":["benim hatam","suç bende"]},"details":{"register":"neutral","context":"Sorumluluğu üstlenirken."},"examples":[{"text":"Don't blame him. It's my fault.","tr":"Onu suçlama. Suç bende."}]},
  {"id":"en-daily-sorry-about-that","languageId":"en","category":"daily","level":"A2","sourceText":"Sorry about that.","translations":{"tr":["kusura bakma","onun için özür dilerim"]},"details":{"register":"neutral","context":"Küçük bir hata ya da rahatsızlık için."},"examples":[{"text":"Sorry about that. I'll fix it now.","tr":"Kusura bakma. Hemen düzelteceğim."}]},
  {"id":"en-daily-dont-worry-about-it","languageId":"en","category":"daily","level":"A2","sourceText":"Don't worry about it.","translations":{"tr":["dert etme","boş ver"]},"details":{"register":"neutral","context":"Özür dileyen birini rahatlatırken."},"examples":[{"text":"Sorry, I spilled some water. — Don't worry about it.","tr":"Pardon, biraz su döktüm. — Dert etme."}]},
  {"id":"en-daily-thanks-anyway","languageId":"en","category":"daily","level":"A2","sourceText":"Thanks anyway.","translations":{"tr":["yine de teşekkürler"]},"details":{"register":"neutral","context":"Birisi yardım edemediğinde bile teşekkür ederken."},"examples":[{"text":"Sorry, I don't know where it is. — Thanks anyway.","tr":"Kusura bakmayın, nerede olduğunu bilmiyorum. — Yine de teşekkürler."}]},
  {"id":"en-daily-my-pleasure","languageId":"en","category":"daily","level":"A2","sourceText":"My pleasure.","translations":{"tr":["ne demek, zevkti","rica ederim"]},"details":{"register":"neutral","context":"Teşekküre kibar karşılık; hizmet sektöründe yaygın."},"examples":[{"text":"Thank you for dinner. — My pleasure.","tr":"Yemek için teşekkürler. — Ne demek, benim için zevkti."}]},
  {"id":"en-daily-any-time","languageId":"en","category":"daily","level":"A2","sourceText":"Any time.","translations":{"tr":["her zaman","ne zaman istersen"]},"details":{"register":"informal","context":"Teşekküre samimi karşılık: yine yardım ederim."},"examples":[{"text":"Thanks for listening. — Any time.","tr":"Dinlediğin için sağ ol. — Her zaman."}]},
  {"id":"en-daily-can-i-get","languageId":"en","category":"daily","level":"A2","sourceText":"Can I get…?","translations":{"tr":["…alabilir miyim?"]},"details":{"register":"informal","context":"Kafe ve restoranda sipariş verirken; çok yaygın."},"examples":[{"text":"Can I get a large latte, please?","tr":"Büyük boy bir latte alabilir miyim?"}]},
  {"id":"en-daily-ill-have","languageId":"en","category":"daily","level":"A2","sourceText":"I'll have…","translations":{"tr":["ben … alayım"]},"details":{"register":"neutral","context":"Restoranda ne istediğini söylerken."},"examples":[{"text":"I'll have the chicken salad, please.","tr":"Ben tavuklu salata alayım, lütfen."}]},
  {"id":"en-daily-here-you-go","languageId":"en","category":"daily","level":"A2","sourceText":"Here you go.","translations":{"tr":["buyurun","al bakalım"]},"details":{"register":"neutral","context":"Birine bir şey uzatırken."},"examples":[{"text":"Here you go. That's your change.","tr":"Buyurun. Bu da para üstünüz."}]},
  {"id":"en-daily-keep-the-change","languageId":"en","category":"daily","level":"A2","sourceText":"Keep the change.","translations":{"tr":["üstü kalsın"]},"details":{"register":"neutral","context":"Taksici, garson gibi birine bahşiş olarak."},"examples":[{"text":"Here's twenty. Keep the change.","tr":"Buyurun yirmi. Üstü kalsın."}]},
  {"id":"en-daily-can-i-pay-by-card","languageId":"en","category":"daily","level":"A2","sourceText":"Can I pay by card?","translations":{"tr":["kartla ödeyebilir miyim?"]},"details":{"register":"neutral","context":"Ödeme yaparken."},"examples":[{"text":"Can I pay by card? — Sure, just tap it here.","tr":"Kartla ödeyebilir miyim? — Tabii, buraya dokundurun."}]},
  {"id":"en-daily-im-just-looking-thanks","languageId":"en","category":"daily","level":"A2","sourceText":"I'm just looking, thanks.","translations":{"tr":["sadece bakıyorum, teşekkürler"]},"details":{"register":"neutral","context":"Mağazada satıcı yardım teklif edince."},"examples":[{"text":"Can I help you? — I'm just looking, thanks.","tr":"Yardımcı olabilir miyim? — Sadece bakıyorum, teşekkürler."}]},
  {"id":"en-daily-do-you-have-this-in","languageId":"en","category":"daily","level":"A2","sourceText":"Do you have this in…?","translations":{"tr":["bunun … olanı var mı?"]},"details":{"register":"neutral","context":"Farklı beden ya da renk sorarken."},"examples":[{"text":"Do you have this in a medium?","tr":"Bunun M bedeni var mı?"}]},
  {"id":"en-daily-can-i-try-it-on","languageId":"en","category":"daily","level":"A2","sourceText":"Can I try it on?","translations":{"tr":["deneyebilir miyim?"]},"details":{"register":"neutral","context":"Giysi mağazasında."},"examples":[{"text":"Can I try it on? — Of course, the changing rooms are over there.","tr":"Deneyebilir miyim? — Tabii, kabinler şurada."}]},
  {"id":"en-daily-for-here-or-to-go","languageId":"en","category":"daily","level":"A2","sourceText":"For here or to go?","translations":{"tr":["burada mı, paket mi?"]},"details":{"register":"neutral","context":"Kafede, ABD'de sorulur; İngiltere'de \"Eat in or take away?\"."},"examples":[{"text":"For here or to go? — To go, please.","tr":"Burada mı, paket mi? — Paket lütfen."}]},
  {"id":"en-daily-could-we-have-the-bill-please","languageId":"en","category":"daily","level":"A2","sourceText":"Could we have the bill, please?","translations":{"tr":["hesabı alabilir miyiz?"]},"details":{"register":"neutral","context":"Restoranda; ABD'de \"the check\" denir."},"examples":[{"text":"Excuse me, could we have the bill, please?","tr":"Pardon, hesabı alabilir miyiz?"}]},
  {"id":"en-daily-is-this-seat-taken","languageId":"en","category":"daily","level":"A2","sourceText":"Is this seat taken?","translations":{"tr":["burası dolu mu?"]},"details":{"register":"neutral","context":"Boş görünen bir yere oturmadan önce."},"examples":[{"text":"Excuse me, is this seat taken? — No, go ahead.","tr":"Pardon, burası dolu mu? — Hayır, buyurun."}]},
  {"id":"en-daily-a-table-for-two-please","languageId":"en","category":"daily","level":"A2","sourceText":"A table for two, please.","translations":{"tr":["iki kişilik bir masa lütfen"]},"details":{"register":"neutral","context":"Restorana girince."},"examples":[{"text":"Hi, a table for two, please.","tr":"Merhaba, iki kişilik bir masa lütfen."}]},
  {"id":"en-daily-anything-else","languageId":"en","category":"daily","level":"A2","sourceText":"Anything else?","translations":{"tr":["başka bir şey?"]},"details":{"register":"neutral","context":"Satıcı ya da garson siparişin devamını sorarken."},"examples":[{"text":"One coffee. Anything else? — No, that's all.","tr":"Bir kahve. Başka bir şey? — Hayır, bu kadar."}]},
  {"id":"en-daily-thats-all-thanks","languageId":"en","category":"daily","level":"A2","sourceText":"That's all, thanks.","translations":{"tr":["bu kadar, teşekkürler"]},"details":{"register":"neutral","context":"Sipariş ya da alışveriş bitince."},"examples":[{"text":"Anything else? — That's all, thanks.","tr":"Başka bir şey? — Bu kadar, teşekkürler."}]},
  {"id":"en-daily-do-you-need-a-bag","languageId":"en","category":"daily","level":"A2","sourceText":"Do you need a bag?","translations":{"tr":["poşet ister misiniz?"]},"details":{"register":"neutral","context":"Kasada sorulur."},"examples":[{"text":"Do you need a bag? — No thanks, I've got one.","tr":"Poşet ister misiniz? — Hayır, teşekkürler, bende var."}]},
  {"id":"en-daily-enjoy-your-meal","languageId":"en","category":"daily","level":"A2","sourceText":"Enjoy your meal.","translations":{"tr":["afiyet olsun"]},"details":{"register":"neutral","context":"Garson yemeği getirince ya da masada."},"examples":[{"text":"Here's your pasta. Enjoy your meal!","tr":"Makarnanız. Afiyet olsun!"}]},
  {"id":"en-daily-im-starving","languageId":"en","category":"daily","level":"A2","sourceText":"I'm starving.","translations":{"tr":["açlıktan ölüyorum","çok açım"]},"details":{"register":"informal","context":"Çok aç olduğunu abartarak söylerken."},"examples":[{"text":"Can we eat now? I'm starving.","tr":"Artık yiyebilir miyiz? Açlıktan ölüyorum."}]},
  {"id":"en-daily-im-full","languageId":"en","category":"daily","level":"A2","sourceText":"I'm full.","translations":{"tr":["doydum","tokum"]},"details":{"register":"neutral","context":"Yemek ikram edilince."},"examples":[{"text":"More cake? — No thanks, I'm full.","tr":"Biraz daha pasta? — Hayır, teşekkürler, doydum."}]},
  {"id":"en-daily-whos-calling","languageId":"en","category":"daily","level":"A2","sourceText":"Who's calling?","translations":{"tr":["kim arıyor?","kiminle görüşüyorum?"]},"details":{"register":"neutral","context":"Telefonu açıp arayanı sorarken."},"examples":[{"text":"Can I speak to Mr Lee? — Who's calling, please?","tr":"Bay Lee ile görüşebilir miyim? — Kim arıyor acaba?"}]},
  {"id":"en-daily-can-i-take-a-message","languageId":"en","category":"daily","level":"A2","sourceText":"Can I take a message?","translations":{"tr":["not bırakmak ister misiniz?"]},"details":{"register":"neutral","context":"Aranan kişi yokken."},"examples":[{"text":"She's not in right now. Can I take a message?","tr":"Kendisi şu an yok. Not bırakmak ister misiniz?"}]},
  {"id":"en-daily-ill-call-you-back","languageId":"en","category":"daily","level":"A2","sourceText":"I'll call you back.","translations":{"tr":["seni geri ararım"]},"details":{"register":"neutral","context":"O an konuşamadığında."},"examples":[{"text":"I'm driving. I'll call you back in ten minutes.","tr":"Araba kullanıyorum. On dakika sonra seni geri ararım."}]},
  {"id":"en-daily-sorry-wrong-number","languageId":"en","category":"daily","level":"A2","sourceText":"Sorry, wrong number.","translations":{"tr":["pardon, yanlış numara"]},"details":{"register":"neutral","context":"Yanlış kişi arandığında."},"examples":[{"text":"Is this the pizza place? — Sorry, wrong number.","tr":"Pizzacı mı orası? — Pardon, yanlış numara."}]},
  {"id":"en-daily-can-you-hear-me","languageId":"en","category":"daily","level":"A2","sourceText":"Can you hear me?","translations":{"tr":["beni duyabiliyor musun?"]},"details":{"register":"neutral","context":"Telefonda ya da görüntülü görüşmede ses sorunu varken."},"examples":[{"text":"Hello? Can you hear me now?","tr":"Alo? Şimdi beni duyabiliyor musun?"}]},
  {"id":"en-daily-text-me","languageId":"en","category":"daily","level":"A2","sourceText":"Text me.","translations":{"tr":["bana mesaj at"]},"details":{"register":"informal","context":"Haber vermesini isterken."},"examples":[{"text":"Text me when you get home.","tr":"Eve varınca bana mesaj at."}]},
  {"id":"en-daily-let-me-know","languageId":"en","category":"daily","level":"A2","sourceText":"Let me know.","translations":{"tr":["haber ver","bana bildir"]},"details":{"register":"neutral","context":"Birinden bilgi beklediğinde."},"examples":[{"text":"Let me know if you need anything.","tr":"Bir şeye ihtiyacın olursa haber ver."}]},
  {"id":"en-daily-i-missed-your-call","languageId":"en","category":"daily","level":"A2","sourceText":"I missed your call.","translations":{"tr":["aramanı kaçırdım"]},"details":{"register":"neutral","context":"Cevapsız aramaya dönüş yaparken."},"examples":[{"text":"Hi, I missed your call. What's up?","tr":"Selam, aramanı kaçırdım. Ne oldu?"}]},
  {"id":"en-daily-talk-soon","languageId":"en","category":"daily","level":"A2","sourceText":"Talk soon.","translations":{"tr":["görüşürüz","yakında konuşuruz"]},"details":{"register":"informal","context":"Telefon ya da mesajın sonunda."},"examples":[{"text":"Okay, I've got to go. Talk soon!","tr":"Tamam, kapatmam lazım. Görüşürüz!"}]},
  {"id":"en-daily-youre-right","languageId":"en","category":"daily","level":"A2","sourceText":"You're right.","translations":{"tr":["haklısın"]},"details":{"register":"neutral","context":"Birine katılırken."},"examples":[{"text":"We should leave now. — You're right.","tr":"Artık çıkmalıyız. — Haklısın."}]},
  {"id":"en-daily-i-think-so-too","languageId":"en","category":"daily","level":"A2","sourceText":"I think so too.","translations":{"tr":["ben de öyle düşünüyorum"]},"details":{"register":"neutral","context":"Bir görüşe katılırken."},"examples":[{"text":"I think it's a good idea. — I think so too.","tr":"Bence iyi bir fikir. — Ben de öyle düşünüyorum."}]},
  {"id":"en-daily-i-dont-think-so","languageId":"en","category":"daily","level":"A2","sourceText":"I don't think so.","translations":{"tr":["sanmıyorum","pek sanmam"]},"details":{"register":"neutral","context":"Kibarca katılmazken ya da hayır derken."},"examples":[{"text":"Is the shop open now? — I don't think so.","tr":"Dükkân şu an açık mı? — Sanmıyorum."}]},
  {"id":"en-daily-not-really","languageId":"en","category":"daily","level":"A2","sourceText":"Not really.","translations":{"tr":["pek değil","pek sayılmaz"]},"details":{"register":"neutral","context":"Yumuşak bir \"hayır\"."},"examples":[{"text":"Do you like jazz? — Not really.","tr":"Caz sever misin? — Pek sayılmaz."}]},
  {"id":"en-daily-im-not-sure-about-that","languageId":"en","category":"daily","level":"A2","sourceText":"I'm not sure about that.","translations":{"tr":["bundan pek emin değilim"]},"details":{"register":"neutral","context":"Kibarca katılmadığını belirtirken."},"examples":[{"text":"He's the best player. — Hmm, I'm not sure about that.","tr":"O en iyi oyuncu. — Hmm, bundan pek emin değilim."}]},
  {"id":"en-daily-thats-true","languageId":"en","category":"daily","level":"A2","sourceText":"That's true.","translations":{"tr":["doğru","orası öyle"]},"details":{"register":"neutral","context":"Bir gerçeği kabul ederken."},"examples":[{"text":"It's cheaper by train. — That's true.","tr":"Trenle daha ucuz. — Doğru."}]},
  {"id":"en-daily-me-neither","languageId":"en","category":"daily","level":"A2","sourceText":"Me neither.","translations":{"tr":["ben de (değil)"]},"details":{"register":"informal","context":"Olumsuz bir cümleye katılırken; \"Me too\" burada yanlış olur."},"examples":[{"text":"I don't like horror films. — Me neither.","tr":"Korku filmlerini sevmem. — Ben de sevmem."}]},
  {"id":"en-daily-why-not","languageId":"en","category":"daily","level":"A2","sourceText":"Why not?","translations":{"tr":["neden olmasın?"]},"details":{"register":"informal","context":"Bir öneriyi kabul ederken."},"examples":[{"text":"Do you want to try sushi? — Why not?","tr":"Suşi denemek ister misin? — Neden olmasın?"}]},
  {"id":"en-daily-shall-we","languageId":"en","category":"daily","level":"A2","sourceText":"Shall we?","translations":{"tr":["gidelim mi?","başlayalım mı?"]},"details":{"register":"neutral","context":"Bir şeye başlamayı ya da gitmeyi önerirken."},"examples":[{"text":"The taxi's here. Shall we?","tr":"Taksi geldi. Gidelim mi?"}]},
  {"id":"en-daily-what-do-you-do","languageId":"en","category":"daily","level":"A2","sourceText":"What do you do?","translations":{"tr":["ne iş yapıyorsun?"]},"details":{"register":"neutral","context":"Meslek sorarken."},"examples":[{"text":"So, what do you do? — I'm a nurse.","tr":"Peki, ne iş yapıyorsun? — Hemşireyim."}]},
  {"id":"en-daily-have-you-been-here-before","languageId":"en","category":"daily","level":"A2","sourceText":"Have you been here before?","translations":{"tr":["daha önce buraya geldin mi?"]},"details":{"register":"neutral","context":"Restoran, şehir ya da etkinlikte sohbet açarken."},"examples":[{"text":"Have you been here before? The food is great.","tr":"Daha önce buraya geldin mi? Yemekleri harika."}]},
  {"id":"en-daily-any-plans-for-the-weekend","languageId":"en","category":"daily","level":"A2","sourceText":"Any plans for the weekend?","translations":{"tr":["hafta sonu için planın var mı?"]},"details":{"register":"informal","context":"İş yerinde ya da okulda küçük sohbet."},"examples":[{"text":"Any plans for the weekend? — Just relaxing.","tr":"Hafta sonu için planın var mı? — Sadece dinleneceğim."}]},
  {"id":"en-daily-whats-wrong","languageId":"en","category":"daily","level":"A2","sourceText":"What's wrong?","translations":{"tr":["ne oldu?","bir sorun mu var?"]},"details":{"register":"neutral","context":"Birinin keyifsiz olduğunu fark edince."},"examples":[{"text":"You look upset. What's wrong?","tr":"Üzgün görünüyorsun. Ne oldu?"}]},
  {"id":"en-daily-bless-you","languageId":"en","category":"daily","level":"A2","sourceText":"Bless you!","translations":{"tr":["çok yaşa!"]},"details":{"register":"neutral","context":"Biri hapşırınca."},"examples":[{"text":"Achoo! — Bless you! — Thanks.","tr":"Hapşu! — Çok yaşa! — Sağ ol."}]},
  {"id":"en-daily-ive-got-to-go","languageId":"en","category":"daily","level":"A2","sourceText":"I've got to go.","translations":{"tr":["gitmem lazım","kapatmam lazım"]},"details":{"register":"informal","context":"Konuşmayı ya da telefonu bitirirken."},"examples":[{"text":"Sorry, I've got to go. My bus is here.","tr":"Kusura bakma, gitmem lazım. Otobüsüm geldi."}]},
  {"id":"en-daily-it-was-nice-talking-to-you","languageId":"en","category":"daily","level":"A2","sourceText":"It was nice talking to you.","translations":{"tr":["seninle konuşmak güzeldi"]},"details":{"register":"neutral","context":"Yeni tanıştığın biriyle sohbeti bitirirken."},"examples":[{"text":"Well, it was nice talking to you. Enjoy the party!","tr":"Seninle konuşmak güzeldi. Partinin tadını çıkar!"}]},
  {"id":"en-daily-see-you-around","languageId":"en","category":"daily","level":"A2","sourceText":"See you around.","translations":{"tr":["görüşürüz","etrafta görüşürüz"]},"details":{"register":"informal","context":"Belirli bir buluşma olmadan vedalaşırken."},"examples":[{"text":"Nice meeting you. See you around!","tr":"Tanıştığıma memnun oldum. Görüşürüz!"}]},
  {"id":"en-daily-say-hi-to-for-me","languageId":"en","category":"daily","level":"A2","sourceText":"Say hi to… for me.","translations":{"tr":["…'e benden selam söyle"]},"details":{"register":"informal","context":"Birine selam iletmesini isterken."},"examples":[{"text":"Say hi to your mum for me.","tr":"Annene benden selam söyle."}]},
  {"id":"en-daily-bye-for-now","languageId":"en","category":"daily","level":"A2","sourceText":"Bye for now.","translations":{"tr":["şimdilik hoşça kal"]},"details":{"register":"informal","context":"Yakında tekrar konuşacağın birine veda."},"examples":[{"text":"I'll call you tomorrow. Bye for now!","tr":"Yarın ararım. Şimdilik hoşça kal!"}]},
  {"id":"en-daily-get-home-safe","languageId":"en","category":"daily","level":"A2","sourceText":"Get home safe.","translations":{"tr":["eve sağ salim var"]},"details":{"register":"informal","context":"Gece ayrılan bir arkadaşa."},"examples":[{"text":"Bye! Get home safe.","tr":"Hoşça kal! Eve sağ salim var."}]},
  {"id":"en-daily-its-getting-late","languageId":"en","category":"daily","level":"A2","sourceText":"It's getting late.","translations":{"tr":["geç oluyor"]},"details":{"register":"neutral","context":"Ayrılma zamanı geldiğini ima ederken."},"examples":[{"text":"It's getting late. We should head home.","tr":"Geç oluyor. Eve gitsek iyi olur."}]},
  {"id":"en-daily-ill-be-right-back","languageId":"en","category":"daily","level":"A2","sourceText":"I'll be right back.","translations":{"tr":["hemen dönerim"]},"details":{"register":"neutral","context":"Kısa süreliğine ayrılırken."},"examples":[{"text":"Hold my bag, I'll be right back.","tr":"Çantamı tut, hemen dönerim."}]},
  {"id":"en-daily-im-on-my-way","languageId":"en","category":"daily","level":"A2","sourceText":"I'm on my way.","translations":{"tr":["yoldayım","geliyorum"]},"details":{"register":"neutral","context":"Buluşma yerine gelmekte olduğunu söylerken."},"examples":[{"text":"Where are you? — I'm on my way!","tr":"Neredesin? — Yoldayım!"}]},
  {"id":"en-daily-you-can-do-it","languageId":"en","category":"daily","level":"A2","sourceText":"You can do it!","translations":{"tr":["yapabilirsin!"]},"details":{"register":"neutral","context":"Birini cesaretlendirirken."},"examples":[{"text":"Come on, one more kilometre. You can do it!","tr":"Hadi, bir kilometre daha. Yapabilirsin!"}]},
  {"id":"en-daily-itll-be-fine","languageId":"en","category":"daily","level":"A2","sourceText":"It'll be fine.","translations":{"tr":["her şey yoluna girecek","sorun olmayacak"]},"details":{"register":"neutral","context":"Endişeli birini rahatlatırken."},"examples":[{"text":"Don't worry about the interview. It'll be fine.","tr":"Görüşmeyi dert etme. Sorun olmayacak."}]},
  {"id":"en-daily-take-your-time","languageId":"en","category":"daily","level":"A2","sourceText":"Take your time.","translations":{"tr":["acele etme","rahat ol"]},"details":{"register":"neutral","context":"Birine acele etmemesini söylerken."},"examples":[{"text":"Take your time, there's no hurry.","tr":"Acele etme, aceleye gerek yok."}]},
  {"id":"en-daily-i-dont-mind","languageId":"en","category":"daily","level":"A2","sourceText":"I don't mind.","translations":{"tr":["fark etmez","bence sakıncası yok"]},"details":{"register":"neutral","context":"Seçenekler arasında tercihin olmadığında."},"examples":[{"text":"Tea or coffee? — I don't mind.","tr":"Çay mı kahve mi? — Fark etmez."}]},
  {"id":"en-daily-i-have-no-idea","languageId":"en","category":"daily","level":"A2","sourceText":"I have no idea.","translations":{"tr":["hiçbir fikrim yok"]},"details":{"register":"neutral","context":"Bir şeyi hiç bilmediğinde."},"examples":[{"text":"Where's the remote? — I have no idea.","tr":"Kumanda nerede? — Hiçbir fikrim yok."}]},
  {"id":"en-daily-it-doesnt-matter","languageId":"en","category":"daily","level":"A2","sourceText":"It doesn't matter.","translations":{"tr":["önemli değil","fark etmez"]},"details":{"register":"neutral","context":"Bir şeyin önemsiz olduğunu söylerken."},"examples":[{"text":"I forgot to bring the cake. — It doesn't matter.","tr":"Pastayı getirmeyi unuttum. — Önemli değil."}]},
  {"id":"en-daily-thats-it","languageId":"en","category":"daily","level":"A2","sourceText":"That's it.","translations":{"tr":["bu kadar","işte bu!"]},"details":{"register":"neutral","context":"Bir şeyin bittiğini ya da doğru olduğunu söylerken."},"examples":[{"text":"Just sign here and that's it.","tr":"Sadece buraya imza atın, bu kadar."}]},
  {"id":"en-daily-here-it-is","languageId":"en","category":"daily","level":"A2","sourceText":"Here it is.","translations":{"tr":["işte burada","buldum"]},"details":{"register":"neutral","context":"Aranan şeyi bulunca."},"examples":[{"text":"Where's my phone? Oh, here it is.","tr":"Telefonum nerede? Ha, işte burada."}]},
  {"id":"en-daily-congratulations","languageId":"en","category":"daily","level":"A2","sourceText":"Congratulations!","translations":{"tr":["tebrikler!","tebrik ederim!"]},"details":{"register":"neutral","context":"Başarı, düğün, doğum gibi güzel haberlerde."},"examples":[{"text":"I'm getting married! — Congratulations!","tr":"Evleniyorum! — Tebrikler!"}]},
  {"id":"en-daily-do-you-want-to-come","languageId":"en","category":"daily","level":"A2","sourceText":"Do you want to come?","translations":{"tr":["sen de gelmek ister misin?"]},"details":{"register":"neutral","context":"Birini bir plana davet ederken."},"examples":[{"text":"We're going to the cinema. Do you want to come?","tr":"Sinemaya gidiyoruz. Sen de gelmek ister misin?"}]},
  {"id":"en-daily-maybe-another-time","languageId":"en","category":"daily","level":"A2","sourceText":"Maybe another time.","translations":{"tr":["belki başka zaman"]},"details":{"register":"neutral","context":"Bir teklifi nazikçe geri çevirirken."},"examples":[{"text":"Coffee? — Not today, maybe another time.","tr":"Kahve? — Bugün olmaz, belki başka zaman."}]}
]
