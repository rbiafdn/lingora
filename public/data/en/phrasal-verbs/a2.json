  {"id":"en-pv-give-up","languageId":"en","category":"phrasal-verbs","level":"A2","sourceText":"give up","translations":{"tr":["vazgeçmek","bırakmak"]},"partOfSpeech":"verb","details":{"usage":"Bir alışkanlığı bırakmak ya da bir çabadan vazgeçmek için kullanılır.","separable":true,"similar":["quit","stop","back down"]},"examples":[{"text":"Don't give up!","tr":"Vazgeçme!"},{"text":"He gave up smoking last year.","tr":"Geçen yıl sigarayı bıraktı."}]},
  {"id":"en-pv-find-out","languageId":"en","category":"phrasal-verbs","level":"A2","sourceText":"find out","translations":{"tr":["öğrenmek","ortaya çıkarmak"]},"partOfSpeech":"verb","details":{"usage":"Bir bilgiyi araştırarak ya da tesadüfen öğrenmek.","separable":true,"similar":["discover","figure out","learn"]},"examples":[{"text":"I found out the truth yesterday.","tr":"Gerçeği dün öğrendim."}]},
  {"id":"en-pv-look-after","languageId":"en","category":"phrasal-verbs","level":"A2","sourceText":"look after","translations":{"tr":["ilgilenmek","bakmak"]},"partOfSpeech":"verb","details":{"usage":"Birine ya da bir şeye bakmak, sorumluluğunu almak. Nesne her zaman edattan sonra gelir.","separable":false,"similar":["take care of","care for"]},"examples":[{"text":"Can you look after my cat this weekend?","tr":"Bu hafta sonu kedime bakabilir misin?"}]},
  {"id":"en-pv-put-on","languageId":"en","category":"phrasal-verbs","level":"A2","sourceText":"put on","translations":{"tr":["giymek","takmak"]},"partOfSpeech":"verb","details":{"usage":"Kıyafet, ayakkabı, gözlük gibi şeyleri üzerine geçirmek. Nesne zamirse araya girer: \"put it on\". \"put on weight\" kilo almak demektir.","separable":true,"similar":["wear","get dressed","take off (zıt: çıkarmak)"]},"examples":[{"text":"Put your coat on, it's cold.","tr":"Montunu giy, hava soğuk."}]},
  {"id":"en-pv-take-off","languageId":"en","category":"phrasal-verbs","level":"A2","sourceText":"take off","translations":{"tr":["çıkarmak","havalanmak"]},"partOfSpeech":"verb","details":{"usage":"Giysi, ayakkabı vb. çıkarmak (ayrılabilir: \"take it off\"). Uçak için nesnesiz \"havalanmak\" anlamına gelir.","separable":true,"similar":["remove","put on (zıt: giymek)","land (zıt: iniş yapmak)"]},"examples":[{"text":"Take off your shoes, please.","tr":"Lütfen ayakkabılarını çıkar."},{"text":"The plane took off on time.","tr":"Uçak zamanında havalandı."}]},
  {"id":"en-pv-turn-on","languageId":"en","category":"phrasal-verbs","level":"A2","sourceText":"turn on","translations":{"tr":["açmak","çalıştırmak"]},"partOfSpeech":"verb","details":{"usage":"Işık, televizyon, makine gibi cihazları açmak. Nesne zamirse araya girer: \"turn it on\".","separable":true,"similar":["switch on","turn off (zıt: kapatmak)","turn up"]},"examples":[{"text":"Can you turn on the light?","tr":"Işığı açabilir misin?"}]},
  {"id":"en-pv-turn-off","languageId":"en","category":"phrasal-verbs","level":"A2","sourceText":"turn off","translations":{"tr":["kapatmak"]},"partOfSpeech":"verb","details":{"usage":"Işık, televizyon, musluk gibi şeyleri kapatmak. Nesne zamirse araya girer: \"turn it off\".","separable":true,"similar":["switch off","turn on (zıt: açmak)","turn down"]},"examples":[{"text":"Don't forget to turn off the lights.","tr":"Işıkları kapatmayı unutma."}]},
  {"id":"en-pv-pick-up","languageId":"en","category":"phrasal-verbs","level":"A2","sourceText":"pick up","translations":{"tr":["yerden almak","(birini) almak"]},"partOfSpeech":"verb","details":{"usage":"Yerden bir şey almak ya da birini arabayla bir yerden almak. Ayrıca telefonu açmak ve bir dili kulaktan kapmak anlamları da vardır.","separable":true,"similar":["collect","drop off (zıt: bırakmak)","get"]},"examples":[{"text":"Can you pick me up from the station?","tr":"Beni istasyondan alabilir misin?"},{"text":"She picked up the pen from the floor.","tr":"Kalemi yerden aldı."}]},
  {"id":"en-pv-ask-for","languageId":"en","category":"phrasal-verbs","level":"A2","sourceText":"ask for","translations":{"tr":["istemek","talep etmek"]},"partOfSpeech":"verb","details":{"separable":false,"usage":"\"You asked for it!\" = \"Kendin istedin, hak ettin!\""},"examples":[{"text":"She asked for a glass of water.","tr":"Bir bardak su istedi."}]},
