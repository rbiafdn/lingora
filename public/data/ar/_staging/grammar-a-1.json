{"t":"التَّعْرِيفُ وَالتَّنْكِيرُ","rom":"at-taʿrīf wa-t-tankīr","l":"A1","tr":["Belirlilik: ال ve tenvin"],"grammar":{"summary":"Arapçada belirli isim başına ال takısı alır, belirsiz isim ise sonunda tenvin (-un, -an, -in) taşır.","uses":["Belirli, bilinen bir şeyden söz etmek (الْكِتَابُ = kitap)","Herhangi bir şeyden söz etmek (كِتَابٌ = bir kitap)","Genel kavramlar ve türler (الْعِلْمُ = bilim)"],"sections":[{"kind":"other","title":"Belirsiz isim: tenvin","formula":[{"tr":"İsim","en":"اسم نكرة","role":"s"},{"tr":"Tenvin (-un/-an/-in)","en":"تنوين","role":"x"}],"examples":[{"text":"[s:هٰذَا] [o:كِتَابٌ].","reading":"Hādhā kitābun.","tr":"Bu bir kitap."},{"text":"[s:هٰذِهِ] [o:مَدْرَسَةٌ].","reading":"Hādhihi madrasatun.","tr":"Bu bir okul."}],"notes":["Tenvin, \"bir\" anlamı katar; Türkçedeki \"bir\" kelimesine karşılık gelir."]},{"kind":"other","title":"Belirli isim: ال","formula":[{"tr":"ال","en":"أداة التعريف","role":"x"},{"tr":"İsim (tenvinsiz)","en":"اسم معرفة","role":"s"}],"examples":[{"text":"[s:الْكِتَابُ] [o:جَدِيدٌ].","reading":"Al-kitābu jadīdun.","tr":"Kitap yeni."},{"text":"[s:الْبَابُ] [o:مَفْتُوحٌ].","reading":"Al-bābu maftūḥun.","tr":"Kapı açık."}]},{"kind":"other","title":"Güneş ve ay harfleri","formula":[{"tr":"ال + güneş harfi","en":"الحروف الشمسية","role":"x"},{"tr":"İsim (şeddeli)","en":"اسم","role":"s"}],"examples":[{"text":"[s:الشَّمْسُ] [o:حَارَّةٌ].","reading":"Ash-shamsu ḥārratun.","tr":"Güneş sıcak."},{"text":"[s:الْقَمَرُ] [o:جَمِيلٌ].","reading":"Al-qamaru jamīlun.","tr":"Ay güzel."}],"notes":["Güneş harflerinde (ت ث د ذ ر ز س ش ص ض ط ظ ل ن) ل okunmaz, sonraki harf şeddeli okunur."]}],"rules":["ال ve tenvin aynı isimde birlikte bulunmaz.","Özel isimler (مُحَمَّدٌ، مِصْرُ) ال almadan da belirlidir.","ال'nin hemzesi cümle başında \"a\" okunur, ortada düşer: فِي الْبَيْتِ = fī l-bayti."],"exceptions":["Bazı özel isimler ال ile kullanılır: الْقَاهِرَةُ، الْعِرَاقُ."],"mistakes":[{"wrong":"الْكِتَابٌ","right":"الْكِتَابُ","note":"ال alan isim tenvin almaz."},{"wrong":"al-shamsu","right":"ash-shamsu","note":"ش güneş harfidir; ل okunmaz, ş şeddeli okunur."}]}},
{"t":"الْمُذَكَّرُ وَالْمُؤَنَّثُ","rom":"al-mudhakkar wa-l-mu'annath","l":"A1","tr":["Cinsiyet ve tâ merbûta (ة)"],"grammar":{"summary":"Her Arapça isim eril ya da dişildir; dişil isimlerin çoğu tâ merbûta (ة) ile biter.","uses":["Sıfatı, zamiri ve fiili isme uydurmak","Meslek ve sıfatlardan kadın için biçim türetmek","هُوَ / هِيَ seçimini doğru yapmak"],"sections":[{"kind":"other","title":"Eril isim","formula":[{"tr":"İsim (işaretsiz)","en":"اسم مذكر","role":"s"},{"tr":"Eril haber","en":"خبر مذكر","role":"o"}],"examples":[{"text":"[s:الْبَيْتُ] [o:كَبِيرٌ].","reading":"Al-baytu kabīrun.","tr":"Ev büyük."},{"text":"[s:هٰذَا] [o:طَالِبٌ].","reading":"Hādhā ṭālibun.","tr":"Bu bir (erkek) öğrenci."}]},{"kind":"other","title":"Dişil isim: ة","formula":[{"tr":"İsim + ة","en":"اسم مؤنث + تاء مربوطة","role":"s"},{"tr":"Dişil haber","en":"خبر مؤنث","role":"o"}],"examples":[{"text":"[s:الْمَدِينَةُ] [o:كَبِيرَةٌ].","reading":"Al-madīnatu kabīratun.","tr":"Şehir büyük."},{"text":"[s:هٰذِهِ] [o:طَالِبَةٌ].","reading":"Hādhihi ṭālibatun.","tr":"Bu bir kız öğrenci."}]},{"kind":"other","title":"Erilden dişil türetme","formula":[{"tr":"Eril biçim","en":"مذكر","role":"s"},{"tr":"+ ة","en":"مؤنث","role":"x"}],"examples":[{"text":"[s:مُدَرِّسٌ] ← [x:مُدَرِّسَةٌ]","reading":"mudarrisun ← mudarrisatun","tr":"öğretmen (erkek) → öğretmen (kadın)"},{"text":"[s:أَحْمَدُ] [o:سَعِيدٌ] وَ[s:فَاطِمَةُ] [o:سَعِيدَةٌ].","reading":"Aḥmadu saʿīdun wa-Fāṭimatu saʿīdatun.","tr":"Ahmet mutlu, Fatma da mutlu."}]}],"rules":["ة tek başına \"-a\" okunur; ek veya tamlamada \"-at\" olur: مَدِينَةُ إِسْطَنْبُولَ = madīnatu Isṭanbūl.","Diğer dişil işaretleri: ـَاء (صَحْرَاءُ) ve ـَى (كُبْرَى).","Anlamca dişil olanlar (أُمٌّ، بِنْتٌ، أُخْتٌ) ة almadan dişildir."],"exceptions":["İşaretsiz dişil isimler: شَمْسٌ، أَرْضٌ، دَارٌ، يَدٌ، عَيْنٌ، حَرْبٌ.","ة ile biten bazı erkek isimleri eril kalır: حَمْزَةُ، خَلِيفَةٌ."],"mistakes":[{"wrong":"الشَّمْسُ حَارٌّ","right":"الشَّمْسُ حَارَّةٌ","note":"شَمْس işaretsiz dişil bir isimdir."},{"wrong":"أُمِّي طَيِّبٌ","right":"أُمِّي طَيِّبَةٌ","note":"أُمّ anlamca dişildir, sıfat dişil olur."}]}},
{"t":"الضَّمَائِرُ الْمُنْفَصِلَةُ","rom":"aḍ-ḍamā'ir al-munfaṣilah","l":"A1","tr":["Şahıs zamirleri"],"grammar":{"summary":"Ayrı yazılan şahıs zamirleri cümlenin öznesi olur; 2. ve 3. şahısta eril/dişil ayrımı vardır.","uses":["Kendini ve başkalarını tanıtmak","İsim cümlesinde özne (mübteda) olmak","Vurgu: \"ben\", \"sen\" demek"],"sections":[{"kind":"other","title":"Tekil zamirler","formula":[{"tr":"Zamir","en":"ضمير منفصل","role":"s"},{"tr":"Haber","en":"خبر","role":"o"}],"examples":[{"text":"[s:أَنَا] [o:طَالِبٌ].","reading":"Anā ṭālibun.","tr":"Ben öğrenciyim."},{"text":"[s:أَنْتَ] [o:مُهَنْدِسٌ] وَ[s:أَنْتِ] [o:طَبِيبَةٌ].","reading":"Anta muhandisun wa-anti ṭabībatun.","tr":"Sen (erkek) mühendissin, sen (kadın) doktorsun."},{"text":"[s:هُوَ] [o:مِنْ تُرْكِيَا] وَ[s:هِيَ] [o:مِنْ مِصْرَ].","reading":"Huwa min Turkiyā wa-hiya min Miṣra.","tr":"O (erkek) Türkiye'den, o (kadın) Mısır'dan."}],"notes":["أَنَا ben · أَنْتَ sen (e) · أَنْتِ sen (k) · هُوَ o (e) · هِيَ o (k)"]},{"kind":"other","title":"Çoğul zamirler","formula":[{"tr":"Zamir","en":"ضمير منفصل","role":"s"},{"tr":"Haber (çoğul)","en":"خبر","role":"o"}],"examples":[{"text":"[s:نَحْنُ] [o:أَصْدِقَاءُ].","reading":"Naḥnu aṣdiqā'u.","tr":"Biz arkadaşız."},{"text":"[s:هُمْ] [o:فِي الْبَيْتِ].","reading":"Hum fī l-bayti.","tr":"Onlar evde."}],"notes":["نَحْنُ biz · أَنْتُمْ siz (e) · أَنْتُنَّ siz (k) · هُمْ onlar (e) · هُنَّ onlar (k)"]},{"kind":"other","title":"İkil zamirler","formula":[{"tr":"İkil zamir","en":"ضمير المثنى","role":"s"},{"tr":"İkil haber","en":"خبر مثنى","role":"o"}],"examples":[{"text":"[s:أَنْتُمَا] [o:طَالِبَانِ].","reading":"Antumā ṭālibāni.","tr":"Siz ikiniz öğrencisiniz."},{"text":"[s:هُمَا] [o:أَخَوَانِ].","reading":"Humā akhawāni.","tr":"Onlar iki kardeş."}]}],"rules":["Şimdiki zamanda \"olmak\" fiili kullanılmaz: أَنَا طَالِبٌ = Ben öğrenciyim.","Hitap edilen ve sözü edilen kişinin cinsiyeti zamiri belirler (أَنْتَ / أَنْتِ، هُوَ / هِيَ).","Karışık topluluk için eril çoğul kullanılır (هُمْ، أَنْتُمْ)."],"exceptions":[],"mistakes":[{"wrong":"أَنَا أَكُونُ طَالِبٌ","right":"أَنَا طَالِبٌ","note":"Şimdiki zamanda \"olmak\" fiili eklenmez."},{"wrong":"أَنْتَ طَبِيبَةٌ (bir kadına)","right":"أَنْتِ طَبِيبَةٌ","note":"Kadına hitapta أَنْتِ (anti) kullanılır."}]}},
{"t":"الْجُمْلَةُ الِاسْمِيَّةُ","rom":"al-jumlah al-ismiyyah","l":"A1","tr":["İsim cümlesi (mübteda–haber)"],"grammar":{"summary":"İsimle başlayan cümle; mübteda (konu) ve haber (hakkında söylenen) iki parçadan oluşur, \"olmak\" fiili yoktur.","uses":["Bir şeyi tanımlamak ve nitelemek","Yer bildirmek (Kitap masada.)","\"Var\" demek (Odada bir adam var.)"],"sections":[{"kind":"other","title":"Mübteda + haber","formula":[{"tr":"Mübteda (belirli)","en":"مبتدأ","role":"s"},{"tr":"Haber (belirsiz)","en":"خبر","role":"o"}],"examples":[{"text":"[s:الْجَوُّ] [o:جَمِيلٌ].","reading":"Al-jawwu jamīlun.","tr":"Hava güzel."},{"text":"[s:الطَّالِبَةُ] [o:مُجْتَهِدَةٌ].","reading":"Aṭ-ṭālibatu mujtahidatun.","tr":"Kız öğrenci çalışkan."}]},{"kind":"other","title":"Haber: edat + isim","formula":[{"tr":"Mübteda","en":"مبتدأ","role":"s"},{"tr":"Haber (yer)","en":"خبر شبه جملة","role":"o"}],"examples":[{"text":"[s:الْكِتَابُ] [o:عَلَى الطَّاوِلَةِ].","reading":"Al-kitābu ʿalā ṭ-ṭāwilati.","tr":"Kitap masanın üstünde."},{"text":"[s:أَبِي] [o:فِي الْعَمَلِ].","reading":"Abī fī l-ʿamali.","tr":"Babam işte."}]},{"kind":"other","title":"Haber önde: \"var\"","formula":[{"tr":"Haber (öne alınmış)","en":"خبر مقدم","role":"o"},{"tr":"Mübteda (belirsiz)","en":"مبتدأ مؤخر","role":"s"}],"examples":[{"text":"[o:فِي الْغُرْفَةِ] [s:رَجُلٌ].","reading":"Fī l-ghurfati rajulun.","tr":"Odada bir adam var."},{"text":"[o:فِي الْمَدِينَةِ] [s:مَتْحَفٌ كَبِيرٌ].","reading":"Fī l-madīnati matḥafun kabīrun.","tr":"Şehirde büyük bir müze var."}]}],"rules":["Mübteda genellikle belirli, haber belirsizdir.","Haber, mübtedaya cinsiyet ve sayıda uyar: الْبِنْتُ صَغِيرَةٌ.","Mübteda ve haber merfûdur (-u / -un).","Mübteda belirsizse yer bildiren haber öne alınır."],"exceptions":[],"mistakes":[{"wrong":"الْبَيْتُ الْكَبِيرُ (\"Ev büyük\" anlamında)","right":"الْبَيْتُ كَبِيرٌ","note":"İkisi de ال alırsa cümle değil, \"büyük ev\" tamlaması olur."},{"wrong":"رَجُلٌ فِي الْغُرْفَةِ","right":"فِي الْغُرْفَةِ رَجُلٌ","note":"Belirsiz mübtedayla cümle başlamaz; yer bildiren haber öne alınır."}]}},
{"t":"أَسْمَاءُ الْإِشَارَةِ","rom":"asmā' al-ishārah","l":"A1","tr":["İşaret zamirleri"],"grammar":{"summary":"\"Bu, şu, o\" anlamındaki işaret zamirleri yakın/uzak, cinsiyet ve sayıya göre değişir.","uses":["Bir şeyi göstermek: Bu bir kalem.","Bir ismi belirtmek: bu kitap","Kişileri tanıtmak: Bu benim arkadaşım."],"sections":[{"kind":"other","title":"Yakın: هٰذَا / هٰذِهِ","formula":[{"tr":"İşaret zamiri","en":"اسم إشارة","role":"s"},{"tr":"Haber","en":"خبر","role":"o"}],"examples":[{"text":"[s:هٰذَا] [o:قَلَمٌ].","reading":"Hādhā qalamun.","tr":"Bu bir kalem."},{"text":"[s:هٰذِهِ] [o:سَيَّارَةٌ].","reading":"Hādhihi sayyāratun.","tr":"Bu bir araba."}]},{"kind":"other","title":"Uzak: ذٰلِكَ / تِلْكَ","formula":[{"tr":"İşaret zamiri (uzak)","en":"اسم إشارة للبعيد","role":"s"},{"tr":"Haber","en":"خبر","role":"o"}],"examples":[{"text":"[s:ذٰلِكَ] [o:مَسْجِدٌ].","reading":"Dhālika masjidun.","tr":"Şu bir cami."},{"text":"[s:تِلْكَ] [o:مَدْرَسَةٌ].","reading":"Tilka madrasatun.","tr":"Şu bir okul."}]},{"kind":"other","title":"İşaret + ال'li isim: \"bu kitap\"","formula":[{"tr":"İşaret + ال'li isim","en":"اسم إشارة + مشار إليه","role":"s"},{"tr":"Haber","en":"خبر","role":"o"}],"examples":[{"text":"[s:هٰذَا الْكِتَابُ] [o:مُفِيدٌ].","reading":"Hādhā l-kitābu mufīdun.","tr":"Bu kitap faydalı."},{"text":"[s:هٰؤُلَاءِ الطُّلَّابُ] [o:مِنَ الْيَابَانِ].","reading":"Hā'ulā'i ṭ-ṭullābu mina l-Yābāni.","tr":"Bu öğrenciler Japonya'dan."}]}],"rules":["İşaret + belirsiz isim cümle olur (هٰذَا كِتَابٌ = Bu bir kitap); işaret + ال'li isim tamlama olur (هٰذَا الْكِتَابُ = bu kitap).","Çoğul: هٰؤُلَاءِ (bunlar), أُولٰئِكَ (şunlar) — sadece insanlar için.","İnsan olmayan çoğullar için tekil dişil هٰذِهِ / تِلْكَ kullanılır."],"exceptions":["İkil biçimleri: هٰذَانِ (eril), هَاتَانِ (dişil)."],"mistakes":[{"wrong":"هٰذَا سَيَّارَةٌ","right":"هٰذِهِ سَيَّارَةٌ","note":"سَيَّارَة dişildir."},{"wrong":"هٰؤُلَاءِ كُتُبٌ","right":"هٰذِهِ كُتُبٌ","note":"İnsan dışı çoğullar tekil dişil gibi davranır."}]}},
{"t":"الضَّمَائِرُ الْمُتَّصِلَةُ","rom":"aḍ-ḍamā'ir al-muttaṣilah","l":"A1","tr":["İyelik ekleri (bitişik zamirler)"],"grammar":{"summary":"Bitişik zamirler isme eklenince iyelik (\"kitabım\"), fiile eklenince nesne (\"seni\"), edata eklenince \"bende, ona\" anlamı verir.","uses":["Sahiplik: kitabım, evin, adı","Nesne zamiri: beni, onu, sizi","Edatla: onda, benimle, senin için"],"sections":[{"kind":"other","title":"İsim + ek: iyelik","formula":[{"tr":"İsim (ال'siz) + ek","en":"اسم + ضمير متصل","role":"s"},{"tr":"Haber","en":"خبر","role":"o"}],"examples":[{"text":"[s:كِتَابِي] [o:جَدِيدٌ].","reading":"Kitābī jadīdun.","tr":"Kitabım yeni."},{"text":"[s:بَيْتُهُ] [o:كَبِيرٌ].","reading":"Baytuhu kabīrun.","tr":"Onun evi büyük."},{"text":"[s:اسْمُهَا] [o:مَرْيَمُ].","reading":"Ismuhā Maryamu.","tr":"Onun (kadın) adı Meryem."}],"notes":["ـِي -ım · ـكَ / ـكِ -ın · ـهُ / ـهَا onun · ـنَا -ımız · ـكُمْ -ınız · ـهُمْ onların"]},{"kind":"other","title":"Fiil + ek: nesne","formula":[{"tr":"Fiil","en":"فعل","role":"v"},{"tr":"Nesne eki","en":"ضمير متصل مفعول به","role":"o"}],"examples":[{"text":"[v:أُحِبُّكِ].","reading":"Uḥibbuki.","tr":"Seni (kadına) seviyorum."},{"text":"[s:أَحْمَدُ] [v:يَعْرِفُنِي].","reading":"Aḥmadu yaʿrifunī.","tr":"Ahmet beni tanıyor."}],"notes":["Fiilde \"beni\" ـنِي olur; isimde \"-ım\" ـِي olur."]},{"kind":"other","title":"Edat + ek","formula":[{"tr":"Edat + ek","en":"حرف جر + ضمير","role":"o"}],"examples":[{"text":"[s:الْهَدِيَّةُ] [o:لَكِ].","reading":"Al-hadiyyatu laki.","tr":"Hediye senin için."},{"text":"[v:ذَهَبْتُ] [o:مَعَهُمْ].","reading":"Dhahabtu maʿahum.","tr":"Onlarla gittim."}]}],"rules":["Ek alan isim ال almaz ama belirli sayılır.","ة ekten önce ت olur: سَيَّارَةٌ → سَيَّارَتِي.","ـهُ / ـهُمْ, i veya y sesinden sonra ـهِ / ـهِمْ olur: فِيهِ، عَلَيْهِمْ."],"exceptions":["أَبٌ ve أَخٌ ek alınca uzar: أَبُوهُ (babası), أَخُوكَ (kardeşin)."],"mistakes":[{"wrong":"الْكِتَابِي","right":"كِتَابِي","note":"Ek alan isim ال almaz."},{"wrong":"سَيَّارَةُي","right":"سَيَّارَتِي","note":"ة ekten önce açık ت olur."}]}},
{"t":"الْمِلْكِيَّةُ: عِنْدَ وَلِـ وَمَعَ","rom":"al-milkiyyah: ʿinda wa-li wa-maʿa","l":"A1","tr":["Sahiplik: \"var\" ve \"sahip olmak\""],"grammar":{"summary":"Arapçada \"sahip olmak\" fiili yoktur; عِنْدَ, لِـ veya مَعَ + zamir ile isim cümlesi kurulur.","uses":["Sahip olunan şeyler: Arabam var.","Aile: İki kardeşim var.","Yanında taşınan şey: Yanımda kalem var."],"sections":[{"kind":"other","title":"عِنْدَ + zamir","formula":[{"tr":"عِنْدَ + zamir","en":"ظرف + ضمير","role":"x"},{"tr":"Sahip olunan (belirsiz)","en":"مبتدأ مؤخر","role":"s"}],"examples":[{"text":"[x:عِنْدِي] [s:سَيَّارَةٌ].","reading":"ʿIndī sayyāratun.","tr":"Arabam var."},{"text":"[x:عِنْدَ أُخْتِي] [s:قِطَّةٌ].","reading":"ʿInda ukhtī qiṭṭatun.","tr":"Kız kardeşimin bir kedisi var."}]},{"kind":"other","title":"لِـ + zamir","formula":[{"tr":"لِـ + zamir","en":"حرف جر + ضمير","role":"x"},{"tr":"Sahip olunan","en":"مبتدأ مؤخر","role":"s"}],"examples":[{"text":"[x:لِي] [s:أَخَوَانِ].","reading":"Lī akhawāni.","tr":"İki erkek kardeşim var."},{"text":"[x:لَهُ] [s:بَيْتٌ كَبِيرٌ].","reading":"Lahu baytun kabīrun.","tr":"Onun büyük bir evi var."}]},{"kind":"other","title":"مَعَ: yanında","formula":[{"tr":"مَعَ + zamir","en":"ظرف + ضمير","role":"x"},{"tr":"Şey","en":"مبتدأ مؤخر","role":"s"}],"examples":[{"text":"[x:مَعِي] [s:قَلَمٌ].","reading":"Maʿī qalamun.","tr":"Yanımda bir kalem var."},{"text":"[q:هَلْ] [x:مَعَكَ] [s:نُقُودٌ]؟","reading":"Hal maʿaka nuqūdun?","tr":"Yanında para var mı?"}]},{"kind":"negative","title":"Olumsuz: لَيْسَ","formula":[{"tr":"لَيْسَ","en":"ليس","role":"a"},{"tr":"عِنْدَ + zamir","en":"ظرف + ضمير","role":"x"},{"tr":"Şey","en":"اسم ليس","role":"s"}],"examples":[{"text":"[a:لَيْسَ] [x:عِنْدِي] [s:وَقْتٌ].","reading":"Laysa ʿindī waqtun.","tr":"Vaktim yok."}]}],"rules":["Sahip olunan şey genelde belirsizdir ve merfû okunur.","لِـ daha kalıcı ilişkiler (aile, mülk), مَعَ \"şu an yanımda\" için kullanılır.","Geçmişte كَانَ eklenir: كَانَ عِنْدِي = vardı."],"exceptions":[],"mistakes":[{"wrong":"عِنْدِي السَّيَّارَةُ","right":"عِنْدِي سَيَّارَةٌ","note":"\"Bir arabam var\" anlamında isim belirsiz olur."},{"wrong":"لَا عِنْدِي وَقْتٌ","right":"لَيْسَ عِنْدِي وَقْتٌ","note":"İsim cümlesi لَيْسَ ile olumsuz yapılır."}]}},
{"t":"حُرُوفُ الْجَرِّ","rom":"ḥurūf al-jarr","l":"A1","tr":["Edatlar (fî, ilâ, min, ʿalâ)"],"grammar":{"summary":"Edatlar ismin önüne gelir ve ismi mecrûr (-i / -in) yapar; Türkçedeki -de, -e, -den eklerine karşılık gelir.","uses":["Yer: فِي (içinde), عَلَى (üstünde)","Yön: إِلَى (-e), مِنْ (-den)","Araç ve amaç: بِـ (ile), لِـ (için)"],"sections":[{"kind":"other","title":"Yer: فِي / عَلَى","formula":[{"tr":"Edat","en":"حرف جر","role":"x"},{"tr":"İsim (-i)","en":"اسم مجرور","role":"o"}],"examples":[{"text":"[s:الطُّلَّابُ] [x:فِي] [o:الْفَصْلِ].","reading":"Aṭ-ṭullābu fī l-faṣli.","tr":"Öğrenciler sınıfta."},{"text":"[s:الْمِفْتَاحُ] [x:عَلَى] [o:الطَّاوِلَةِ].","reading":"Al-miftāḥu ʿalā ṭ-ṭāwilati.","tr":"Anahtar masanın üstünde."}]},{"kind":"other","title":"Yön: مِنْ / إِلَى","formula":[{"tr":"Fiil","en":"فعل","role":"v"},{"tr":"مِنْ / إِلَى","en":"حرف جر","role":"x"},{"tr":"İsim (-i)","en":"اسم مجرور","role":"o"}],"examples":[{"text":"[v:سَافَرْتُ] [x:مِنْ] [o:إِسْطَنْبُولَ] [x:إِلَى] [o:الْقَاهِرَةِ].","reading":"Sāfartu min Isṭanbūla ilā l-Qāhirati.","tr":"İstanbul'dan Kahire'ye yolculuk ettim."},{"text":"[v:أَذْهَبُ] [x:إِلَى] [o:الْمَدْرَسَةِ].","reading":"Adhhabu ilā l-madrasati.","tr":"Okula gidiyorum."}]},{"kind":"other","title":"Bitişik edatlar: بِـ / لِـ","formula":[{"tr":"بِـ / لِـ + isim","en":"حرف جر + اسم مجرور","role":"o"}],"examples":[{"text":"[v:أَكْتُبُ] [o:بِالْقَلَمِ].","reading":"Aktubu bil-qalami.","tr":"Kalemle yazıyorum."},{"text":"[s:هٰذَا الْكِتَابُ] [o:لِلْأَطْفَالِ].","reading":"Hādhā l-kitābu lil-aṭfāli.","tr":"Bu kitap çocuklar için."}]}],"rules":["Edattan sonraki isim mecrûr olur: -i (belirli), -in (belirsiz).","بِـ، لِـ، كَـ tek harflidir ve sonraki kelimeye bitişik yazılır.","لِـ + الْ birleşince لِلْ olur; مِنْ + الْ → مِنَ الْ okunur."],"exceptions":[],"mistakes":[{"wrong":"فِي الْبَيْتُ","right":"فِي الْبَيْتِ","note":"Edattan sonra isim mecrûr (-i) olur."},{"wrong":"لِ الْوَلَدِ","right":"لِلْوَلَدِ","note":"لِـ + الْ bitişik ve tek ل'siz yazılır."}]}},
{"t":"أَدَوَاتُ الِاسْتِفْهَامِ","rom":"adawāt al-istifhām","l":"A1","tr":["Soru edatları"],"grammar":{"summary":"Evet/hayır soruları هَلْ veya أَ ile, bilgi soruları ise cümle başına gelen soru kelimeleriyle kurulur.","uses":["Evet/hayır soruları","Kim, ne, nerede, ne zaman, nasıl, neden, kaç soruları","Tanışma ve günlük konuşma"],"sections":[{"kind":"question","title":"Evet/hayır: هَلْ","formula":[{"tr":"هَلْ","en":"أداة استفهام","role":"q"},{"tr":"Cümle","en":"جملة","role":"s"}],"examples":[{"text":"[q:هَلْ] [s:أَنْتَ] [o:طَالِبٌ]؟","reading":"Hal anta ṭālibun?","tr":"Sen öğrenci misin?"},{"text":"[q:هَلْ] [v:تَتَكَلَّمُ] [o:الْعَرَبِيَّةَ]؟","reading":"Hal tatakallamu l-ʿarabiyyata?","tr":"Arapça konuşuyor musun?"}]},{"kind":"wh","title":"Ne, kim: مَا / مَاذَا / مَنْ","formula":[{"tr":"Soru kelimesi","en":"اسم استفهام","role":"q"},{"tr":"İsim / fiil","en":"اسم / فعل","role":"v"}],"examples":[{"text":"[q:مَا] [s:اسْمُكَ]؟","reading":"Mā smuka?","tr":"Adın ne?"},{"text":"[q:مَاذَا] [v:تَدْرُسُ]؟","reading":"Mādhā tadrusu?","tr":"Ne okuyorsun?"},{"text":"[q:مَنْ] [s:هٰذَا]؟","reading":"Man hādhā?","tr":"Bu kim?"}]},{"kind":"wh","title":"Nerede, nasıl, kaç: أَيْنَ / كَيْفَ / كَمْ","formula":[{"tr":"Soru kelimesi","en":"اسم استفهام","role":"q"},{"tr":"Cümlenin geri kalanı","en":"جملة","role":"s"}],"examples":[{"text":"[q:أَيْنَ] [s:الْمَطَارُ]؟","reading":"Ayna l-maṭāru?","tr":"Havalimanı nerede?"},{"text":"[q:كَيْفَ] [s:حَالُكَ]؟","reading":"Kayfa ḥāluka?","tr":"Nasılsın?"},{"text":"[q:كَمْ] [o:كِتَابًا] [v:قَرَأْتَ]؟","reading":"Kam kitāban qara'ta?","tr":"Kaç kitap okudun?"}],"notes":["مَتَى ne zaman · لِمَاذَا neden · أَيُّ hangi · مِنْ أَيْنَ nereden"]}],"rules":["مَا isim cümlesinde, مَاذَا fiil cümlesinde kullanılır.","كَمْ'den sonraki isim tekil ve mansûbdur (-an).","Soru kelimesi her zaman cümlenin başına gelir; cümlenin sırası değişmez."],"exceptions":[],"mistakes":[{"wrong":"مَاذَا اسْمُكَ؟","right":"مَا اسْمُكَ؟","note":"Fiilsiz isim cümlesinde مَا kullanılır."},{"wrong":"كَمْ كُتُبٌ؟","right":"كَمْ كِتَابًا؟","note":"كَمْ tekil ve mansûb isim ister."}]}},
{"t":"النَّعْتُ","rom":"an-naʿt","l":"A1","tr":["Sıfat ve uyum"],"grammar":{"summary":"Sıfat nitelediği isimden sonra gelir ve ona belirlilik, cinsiyet, sayı ve hâl bakımından uyar.","uses":["Bir ismi nitelemek: büyük bir ev","Belirli bir şeyi ayırt etmek: kırmızı araba","Kişileri ve eşyaları tarif etmek"],"sections":[{"kind":"other","title":"Belirsiz isim + belirsiz sıfat","formula":[{"tr":"İsim","en":"منعوت","role":"s"},{"tr":"Sıfat","en":"نعت","role":"o"}],"examples":[{"text":"[s:بَيْتٌ] [o:كَبِيرٌ]","reading":"baytun kabīrun","tr":"büyük bir ev"},{"text":"[v:اِشْتَرَيْتُ] [s:سَيَّارَةً] [o:جَدِيدَةً].","reading":"Ishtaraytu sayyāratan jadīdatan.","tr":"Yeni bir araba aldım."}]},{"kind":"other","title":"Belirli isim + ال'li sıfat","formula":[{"tr":"ال + isim","en":"منعوت معرفة","role":"s"},{"tr":"ال + sıfat","en":"نعت معرفة","role":"o"}],"examples":[{"text":"[s:الْبَيْتُ] [o:الْكَبِيرُ] جَمِيلٌ.","reading":"Al-baytu l-kabīru jamīlun.","tr":"Büyük ev güzel."},{"text":"[v:زُرْتُ] [s:الْمَدِينَةَ] [o:الْقَدِيمَةَ].","reading":"Zurtu l-madīnata l-qadīmata.","tr":"Eski şehri gezdim."}]},{"kind":"other","title":"Çoğul isimlerde uyum","formula":[{"tr":"Çoğul isim","en":"منعوت جمع","role":"s"},{"tr":"Sıfat (insan: çoğul / insan dışı: tekil dişil)","en":"نعت","role":"o"}],"examples":[{"text":"[s:طُلَّابٌ] [o:مُجْتَهِدُونَ]","reading":"ṭullābun mujtahidūna","tr":"çalışkan öğrenciler"},{"text":"[s:كُتُبٌ] [o:مُفِيدَةٌ]","reading":"kutubun mufīdatun","tr":"faydalı kitaplar"}]}],"rules":["Sıfat her zaman isimden sonra gelir.","Sıfat isme belirlilik, cinsiyet, sayı ve hâlde uyar.","İnsan olmayan çoğullar tekil dişil sıfat alır.","Belirli isim + belirsiz sıfat cümle olur: الْبَيْتُ كَبِيرٌ = Ev büyük."],"exceptions":[],"mistakes":[{"wrong":"كَبِيرٌ بَيْتٌ","right":"بَيْتٌ كَبِيرٌ","note":"Sıfat Türkçenin tersine isimden sonra gelir."},{"wrong":"سَيَّارَةٌ جَدِيدٌ","right":"سَيَّارَةٌ جَدِيدَةٌ","note":"Dişil isim dişil sıfat alır."},{"wrong":"كُتُبٌ مُفِيدُونَ","right":"كُتُبٌ مُفِيدَةٌ","note":"İnsan dışı çoğulun sıfatı tekil dişildir."}]}}
]
