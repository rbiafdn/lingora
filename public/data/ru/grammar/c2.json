[
  {"id":"ru-gr-otglagolnye-sushchestvitelnye-i-nominalizatsiya","languageId":"ru","category":"grammar","level":"C2","sourceText":"Отглагольные существительные и номинализация","translations":{"tr":["Fiilden türeme isimler ve adlaştırma"]},"details":{"reading":"Otglagól'nye sushchestvítel'nye i nominalizátsiya"},"grammar":{"summary":"Resmî ve bilimsel dilde fiil yerine -ние/-тие/-ка isim + -in hâli zinciri ve fiil + isim kalıpları kullanılır.","uses":["Resmî yazışma ve iş dili","Bilimsel metin ve rapor","Haber başlıkları"],"sections":[{"kind":"other","title":"Fiil → isim","formula":[{"tr":"Fiilden isim","en":"Отглагольное существительное","role":"v"},{"tr":"Nesne (-in hâli)","en":"Родительный падеж","role":"o"}],"examples":[{"text":"[v:Решение] [o:проблемы] займёт время.","reading":"Resheniye problemy zaymyot vremya.","tr":"Sorunun çözümü zaman alacak."}],"notes":["решить → решение, изучать → изучение, проверить → проверка."]},{"kind":"other","title":"Yapan: araç hâli","formula":[{"tr":"Fiilden isim","en":"Отглагольное существительное","role":"v"},{"tr":"Nesne (-in hâli)","en":"Родительный падеж","role":"o"},{"tr":"Yapan (araç)","en":"Творительный падеж","role":"s"}],"examples":[{"text":"[v:Обсуждение] [o:проекта] [s:руководством] перенесено.","reading":"Obsuzhdeniye proyekta rukovodstvom pereneseno.","tr":"Projenin yönetimce görüşülmesi ertelendi."}]},{"kind":"other","title":"Fiil + isim kalıpları","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Destek fiil","en":"Глагол-связка","role":"v"},{"tr":"Fiilden isim","en":"Отглагольное существительное","role":"o"}],"examples":[{"text":"[s:Комиссия] [v:провела] [o:проверку].","reading":"Komissiya provela proverku.","tr":"Komisyon denetim yaptı."},{"text":"[s:Мы] [v:оказали] [o:помощь] пострадавшим.","reading":"My okazali pomoshch' postradavshim.","tr":"Mağdurlara yardımda bulunduk."}]}],"rules":["Nesne -in hâline geçer: читать книгу → чтение книги.","Kalıplar: принять решение, оказать влияние, провести исследование, принять участие.","-in hâli zincirleri yazıda yaygın ama ağırdır; konuşmada fiil tercih edilir."],"mistakes":[{"wrong":"изучение русский язык","right":"изучение русского языка","note":"Nesne -in hâline geçer."},{"wrong":"сделать исследование","right":"провести исследование","note":"Resmî dilde kalıplaşmış destek fiil kullanılır."}]}},
  {"id":"ru-gr-vvodnye-slova-i-diskursivnye-markery","languageId":"ru","category":"grammar","level":"C2","sourceText":"Вводные слова и дискурсивные маркеры","translations":{"tr":["Ara sözler ve söylem belirleyicileri"]},"details":{"reading":"Vvódnye slová i diskursívnye markéry"},"grammar":{"summary":"впрочем, итак, кстати, между прочим, во-первых, однако gibi ara sözler metni düzenler, tutum ve bağlantı bildirir.","uses":["Sıralama: во-первых, во-вторых, наконец","Sonuç: итак, таким образом, следовательно","Konu değiştirme: кстати, между прочим","Düzeltme ve kanaat: впрочем, точнее, кажется, по-моему"],"sections":[{"kind":"other","title":"Sıralama ve sonuç","formula":[{"tr":"Ara söz","en":"Вводное слово","role":"x"},{"tr":"Cümle","en":"Предложение","role":"v"}],"examples":[{"text":"[x:Во-первых], [v:это дорого], [x:во-вторых], [v:неудобно].","reading":"Vo-pervykh, eto dorogo, vo-vtorykh, neudobno.","tr":"Birincisi pahalı, ikincisi kullanışsız."},{"text":"[x:Таким образом], [v:задача решена].","reading":"Takim obrazom, zadacha reshena.","tr":"Böylece sorun çözüldü."}]},{"kind":"other","title":"Konu geçişi","formula":[{"tr":"Ara söz","en":"Вводное слово","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"Tümleç","en":"Дополнение","role":"o"}],"examples":[{"text":"[x:Кстати], [s:ты] [v:видел] [o:Олега]?","reading":"Kstati, ty videl Olega?","tr":"Bu arada, Oleg'i gördün mü?"}]},{"kind":"other","title":"Düzeltme ve karşıtlık","formula":[{"tr":"Cümle","en":"Предложение","role":"v"},{"tr":"Ara söz","en":"Вводное слово","role":"x"},{"tr":"Düzeltme","en":"Уточнение","role":"o"}],"examples":[{"text":"[v:Фильм скучный]. [x:Впрочем], [o:актёры играют хорошо].","reading":"Fil'm skuchnyy. Vprochem, aktyory igrayut khorosho.","tr":"Film sıkıcı. Gerçi oyuncular iyi oynuyor."}]},{"kind":"other","title":"Kanaat ve olasılık","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Ara söz","en":"Вводное слово","role":"x"},{"tr":"Fiil","en":"Сказуемое","role":"v"}],"examples":[{"text":"[s:Он], [x:кажется], [v:уехал].","reading":"On, kazhetsya, uyekhal.","tr":"Galiba gitti."}]}],"rules":["Ara sözler iki yandan virgülle ayrılır.","однако cümle başında bağlaçsa virgülsüz, cümle ortasında ara sözse virgüllüdür.","Konuşmada: короче, в общем, значит; yazıda: следовательно, тем не менее."],"mistakes":[{"wrong":"Кажется он уехал.","right":"Кажется, он уехал.","note":"Ara söz virgülle ayrılır."},{"wrong":"Во первых, …","right":"Во-первых, …","note":"Tireyle yazılır."}]}},
  {"id":"ru-gr-prichastnye-i-deeprichastnye-oboroty","languageId":"ru","category":"grammar","level":"C2","sourceText":"Причастные и деепричастные обороты","translations":{"tr":["Ortaç ve zarf-fiil öbekleri (noktalama ve üslup)"]},"details":{"reading":"Prichástnye i deeprichástnye oboróty"},"grammar":{"summary":"Ortaç ve zarf-fiil öbekleri yazı dilini yoğunlaştırır; konuma göre virgül kuralları ve özne uyumu kesindir.","uses":["Akademik ve edebi yazı","Haber dili","Uzun который cümlelerini kısaltma"],"sections":[{"kind":"other","title":"Ortaç öbeği isimden sonra (virgüllü)","formula":[{"tr":"İsim","en":"Определяемое слово","role":"s"},{"tr":"Ortaç","en":"Причастие","role":"v"},{"tr":"Tümleç","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Студенты], [v:сдавшие] [o:экзамен], могут уйти.","reading":"Studenty, sdavshiye ekzamen, mogut uyti.","tr":"Sınavı geçen öğrenciler çıkabilir."}]},{"kind":"other","title":"Ortaç öbeği isimden önce (virgülsüz)","formula":[{"tr":"Ortaç","en":"Причастие","role":"v"},{"tr":"Tümleç","en":"Дополнение","role":"o"},{"tr":"İsim","en":"Определяемое слово","role":"s"}],"examples":[{"text":"[v:Сдавшие] [o:экзамен] [s:студенты] могут уйти.","reading":"Sdavshiye ekzamen studenty mogut uyti.","tr":"Sınavı geçen öğrenciler çıkabilir."}]},{"kind":"other","title":"Zarf-fiil öbeği","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"Zarf-fiil öbeği","en":"Деепричастный оборот","role":"o"}],"examples":[{"text":"[s:Он] [v:говорил], [o:не глядя на нас].","reading":"On govoril, ne glyadya na nas.","tr":"Bize bakmadan konuşuyordu."}]},{"kind":"other","title":"Kalıplaşmış öbekler","formula":[{"tr":"Kalıp","en":"Устойчивый оборот","role":"x"},{"tr":"Tümleç","en":"Дополнение","role":"o"},{"tr":"Ana cümle","en":"Главное предложение","role":"v"}],"examples":[{"text":"[x:Судя по] [o:всему], [v:он прав].","reading":"Sudya po vsemu, on prav.","tr":"Görünüşe bakılırsa haklı."}],"notes":["судя по, несмотря на, благодаря: özne kuralına tabi değildir."]}],"rules":["İsimden sonra gelen ortaç öbeği virgülle ayrılır, önce gelen ayrılmaz.","Zarf-fiil öbeği her konumda virgülle ayrılır.","Zarf-fiil kişisiz ve edilgen cümlede kullanılmaz; eylemcisi ana cümlenin öznesidir."],"mistakes":[{"wrong":"Подъезжая к станции, у меня слетела шляпа.","right":"Когда я подъезжал к станции, у меня слетела шляпа.","note":"Çehov'un ünlü örneği: özne uyumsuz."},{"wrong":"Студенты сдавшие экзамен могут уйти.","right":"Студенты, сдавшие экзамен, могут уйти.","note":"İsimden sonraki ortaç öbeği virgülle ayrılır."}]}},
  {"id":"ru-gr-infinitivnye-predlozheniya","languageId":"ru","category":"grammar","level":"C2","sourceText":"Инфинитивные предложения","translations":{"tr":["Mastar cümleleri"]},"details":{"reading":"Infinitívnye predlozhéniya"},"grammar":{"summary":"Yüklemi tek başına mastar olan cümleler; tereddüt, kaçınılmazlık, imkânsızlık, dilek veya sert emir bildirir.","uses":["Tereddüt: Что делать?","İmkânsızlık: Тебе не понять","Kaçınılmazlık: Быть беде","Dilek: Поспать бы!","Sert emir: Молчать!"],"sections":[{"kind":"other","title":"Soru: ne yapmalı","formula":[{"tr":"Soru kelimesi","en":"Вопросительное слово","role":"q"},{"tr":"Kişi (yönelme)","en":"Дательный падеж","role":"s"},{"tr":"Mastar","en":"Инфинитив","role":"v"}],"examples":[{"text":"[q:Что] [s:мне] [v:делать]?","reading":"Chto mne delat'?","tr":"Ne yapmalıyım?"},{"text":"[q:Куда] [v:идти]?","reading":"Kuda idti?","tr":"Nereye gitmeli?"}]},{"kind":"other","title":"İmkânsızlık","formula":[{"tr":"Kişi (yönelme)","en":"Дательный падеж","role":"s"},{"tr":"не","en":"Частица не","role":"x"},{"tr":"Mastar","en":"Инфинитив","role":"v"},{"tr":"Tümleç","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Тебе] [x:не] [v:понять] [o:этого].","reading":"Tebe ne ponyat' etogo.","tr":"Sen bunu anlayamazsın."}]},{"kind":"other","title":"Kaçınılmazlık","formula":[{"tr":"Mastar","en":"Инфинитив","role":"v"},{"tr":"Olay (yönelme)","en":"Дательный падеж","role":"o"}],"examples":[{"text":"[v:Быть] [o:беде].","reading":"Byt' bede.","tr":"Başımıza bir iş gelecek."}]},{"kind":"other","title":"Dilek ve sert emir","formula":[{"tr":"Mastar","en":"Инфинитив","role":"v"},{"tr":"бы","en":"Частица бы","role":"a"}],"examples":[{"text":"[v:Поспать] [a:бы] часок.","reading":"Pospat' by chasok.","tr":"Bir saatçik uyuyabilsem."},{"text":"[v:Молчать]!","reading":"Molchat'!","tr":"Susun!"}]}],"rules":["Eylemi yapan yönelme hâlindedir: Мне не уснуть.","Mastarla sert emir askerî, resmî ya da kaba tondadır.","Konuşma ve edebiyatta yaygındır."],"mistakes":[{"wrong":"Что я делать?","right":"Что мне делать?","note":"Kişi yönelme hâlinde."},{"wrong":"Ты не понять.","right":"Тебе не понять.","note":"İmkânsızlık yapısında yönelme hâli."}]}},
  {"id":"ru-gr-obshchefakticheskoye-znacheniye-nesovershennogo-vida","languageId":"ru","category":"grammar","level":"C2","sourceText":"Общефактическое значение несовершенного вида","translations":{"tr":["Süren görünüşün \"olgu\" anlamı"]},"details":{"reading":"Obshchefaktícheskoye znachéniye nesovershénnogo vída"},"grammar":{"summary":"НСВ geçmiş, sonucu değil eylemin olup olmadığını bildirebilir; deneyim ve geri alınmış eylemler için kullanılır.","uses":["Deneyim: Вы читали эту книгу?","Sonucu geri alınmış eylem: Кто-то открывал окно","Eylemin hiç olmaması: Я не брал твою ручку"],"sections":[{"kind":"other","title":"Deneyim sorusu","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil (НСВ geçmiş)","en":"Глагол НСВ прош. вр.","role":"v"},{"tr":"Tümleç?","en":"Дополнение?","role":"o"}],"examples":[{"text":"[s:Вы] [v:читали] [o:эту книгу]?","reading":"Vy chitali etu knigu?","tr":"Bu kitabı (hiç) okudunuz mu?"},{"text":"[s:Вы] [v:прочитали] [o:книгу]?","reading":"Vy prochitali knigu?","tr":"Kitabı okuyup bitirdiniz mi?"}]},{"kind":"other","title":"Geri alınmış sonuç","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil (НСВ geçmiş)","en":"Глагол НСВ прош. вр.","role":"v"},{"tr":"Tümleç","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Кто-то] [v:открывал] [o:окно].","reading":"Kto-to otkryval okno.","tr":"Biri pencereyi açmış (şimdi kapalı)."},{"text":"[s:Брат] [v:приходил] [o:ко мне].","reading":"Brat prikhodil ko mne.","tr":"Abim yanıma gelip gitti."}]},{"kind":"other","title":"Olumsuz: hiç yapmamak","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"не","en":"Частица не","role":"x"},{"tr":"Fiil (НСВ / СВ)","en":"Глагол НСВ / СВ","role":"v"},{"tr":"Tümleç","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Я] [x:не] [v:брал] [o:твою ручку].","reading":"Ya ne bral tvoyu ruchku.","tr":"Kalemini hiç almadım."},{"text":"[s:Я] [x:не] [v:взял] [o:ручку].","reading":"Ya ne vzyal ruchku.","tr":"Kalemi almadım (almam gerekiyordu)."}]}],"rules":["Soru eylemin kendisine yönelikse НСВ, sonucuna yönelikse СВ kullanılır.","приходить, брать, открывать gibi fiillerin НСВ geçmişi: eylem yapıldı ve geri alındı.","Olumsuz НСВ: eylem hiç olmadı; olumsuz СВ: beklenen sonuç gerçekleşmedi."],"mistakes":[{"wrong":"Ты когда-нибудь прочитал эту книгу?","right":"Ты когда-нибудь читал эту книгу?","note":"Deneyim sorusunda НСВ."},{"wrong":"Ко мне пришёл брат, но уже ушёл.","right":"Ко мне приходил брат.","note":"Gelip gittiyse НСВ geçmiş yeterli."}]}},
  {"id":"ru-gr-nepolnye-i-ellipticheskiye-predlozheniya","languageId":"ru","category":"grammar","level":"C2","sourceText":"Неполные и эллиптические предложения","translations":{"tr":["Eksiltili cümleler"]},"details":{"reading":"Nepólnye i elliptícheskiye predlozhéniya"},"grammar":{"summary":"Konuşma ve edebi dilde yüklem (özellikle hareket ve konuşma fiilleri) düşürülür; anlam bağlamdan ve hâl eklerinden anlaşılır.","uses":["Hareket fiilinin düşmesi: Я — домой","Konuşma fiilinin düşmesi: А он мне: «Нет!»","Paralel yapılar: Я люблю чай, а она — кофе"],"sections":[{"kind":"other","title":"Hareket fiili düşer","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Tire","en":"Тире","role":"x"},{"tr":"Yön","en":"Обстоятельство места","role":"o"}],"examples":[{"text":"[s:Я] [x:—] [o:домой].","reading":"Ya — domoy.","tr":"Ben eve (gidiyorum)."},{"text":"[s:Мы] [x:—] [o:в кино], а вы?","reading":"My — v kino, a vy?","tr":"Biz sinemaya (gidiyoruz), ya siz?"}]},{"kind":"other","title":"Paralel yapı","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"Tümleç","en":"Дополнение","role":"o"},{"tr":"а + özne — tümleç","en":"Неполное предложение","role":"x"}],"examples":[{"text":"[s:Я] [v:люблю] [o:чай], [x:а она — кофе].","reading":"Ya lyublyu chay, a ona — kofe.","tr":"Ben çay severim, o ise kahve."}]},{"kind":"other","title":"Konuşma fiili düşer","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Kime (yönelme)","en":"Дательный падеж","role":"o"},{"tr":"Aktarılan söz","en":"Прямая речь","role":"v"}],"examples":[{"text":"А [s:он] [o:мне]: «[v:Не знаю]!»","reading":"A on mne: «Ne znayu!»","tr":"O da bana: \"Bilmiyorum!\""}]}],"rules":["Yazıda düşen öğenin yerine tire konur.","Hâl ekleri düşen fiili gösterir: домой → gitmek, мне → söylemek.","Akademik yazıda sınırlı kullanılır."],"mistakes":[{"wrong":"Я люблю чай, а она кофе люблю.","right":"Я люблю чай, а она — кофе.","note":"Tekrar eden fiil düşer, yerine tire."},{"wrong":"Я домой. (yazıda)","right":"Я — домой.","note":"Yazıda eksilen yüklemin yerine tire konur."}]}},
  {"id":"ru-gr-ekspressivnye-konstruktsii","languageId":"ru","category":"grammar","level":"C2","sourceText":"Экспрессивные конструкции","translations":{"tr":["Duygusal vurgu yapıları"]},"details":{"reading":"Ekspressívnye konstrúktsii"},"grammar":{"summary":"Что за…!, Ну и…!, Как же…!, Тоже мне…!, Ещё бы! gibi kalıplar konuşmada hayranlık, şaşkınlık ve ironi bildirir.","uses":["Hayranlık veya hoşnutsuzluk: Что за погода!","Abartılı tepki: Ну и жара!","İroni: Тоже мне специалист!","Güçlü onay: Ещё бы!"],"sections":[{"kind":"other","title":"Что за + yalın hâl","formula":[{"tr":"Что за","en":"Что за","role":"q"},{"tr":"İsim (yalın)","en":"Именительный падеж","role":"o"}],"examples":[{"text":"[q:Что за] [o:погода]!","reading":"Chto za pogoda!","tr":"Ne biçim hava!"}],"notes":["Tonlamaya göre övgü ya da yergi olur."]},{"kind":"other","title":"Ну и + isim","formula":[{"tr":"Ну и","en":"Частица ну и","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[x:Ну и] [o:жара]!","reading":"Nu i zhara!","tr":"Amma da sıcak!"}]},{"kind":"other","title":"Как же / Какой же","formula":[{"tr":"Как же","en":"Как же","role":"q"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Сказуемое","role":"v"}],"examples":[{"text":"[q:Как же] [s:я] [v:устал]!","reading":"Kak zhe ya ustal!","tr":"Ne kadar da yoruldum!"}]},{"kind":"other","title":"İroni ve onay kalıpları","formula":[{"tr":"Kalıp","en":"Устойчивое выражение","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[x:Тоже мне] [o:специалист]!","reading":"Tozhe mne spetsialist!","tr":"Hah, uzmanmış!"},{"text":"[x:Ещё бы]!","reading":"Yeshchyo by!","tr":"Hem de nasıl! / Elbette!"}]}],"rules":["Anlamı büyük ölçüde tonlama belirler.","İroni kalıpları (Тоже мне, Нашёл время) kırıcı olabilir; dikkatli kullan.","Resmî dilde kullanılmaz."],"mistakes":[{"wrong":"Что за погоду!","right":"Что за погода!","note":"Что за + yalın hâl."},{"wrong":"Тоже мне специалиста!","right":"Тоже мне специалист!","note":"İsim yalın hâlde kalır."}]}},
  {"id":"ru-gr-knizhnye-sostavnye-soyuzy","languageId":"ru","category":"grammar","level":"C2","sourceText":"Книжные составные союзы","translations":{"tr":["Yazı dili bileşik bağlaçları"]},"details":{"reading":"Knízhnye sostavnýe soyúzy"},"grammar":{"summary":"в связи с тем что, тогда как, по мере того как, чем…тем, для того чтобы gibi bağlaçlar resmî metinde sebep, karşıtlık ve orantı bildirir.","uses":["Sebep: в связи с тем что, ввиду того что, вследствие того что","Karşıtlık: тогда как, в то время как","Orantı: по мере того как, чем…, тем…","Amaç: для того чтобы, с тем чтобы"],"sections":[{"kind":"other","title":"Sebep","formula":[{"tr":"Bağlaç","en":"Составной союз","role":"x"},{"tr":"Sebep cümlesi","en":"Придаточное причины","role":"o"},{"tr":"Ana cümle","en":"Главное предложение","role":"v"}],"examples":[{"text":"[x:В связи с тем что] [o:здание ремонтируется], [v:приём переносится].","reading":"V svyazi s tem chto zdaniye remontiruyetsya, priyom perenositsya.","tr":"Bina onarımda olduğu için kabul erteleniyor."}]},{"kind":"other","title":"Karşıtlık","formula":[{"tr":"Ana cümle","en":"Главное предложение","role":"v"},{"tr":"тогда как","en":"Союз тогда как","role":"x"},{"tr":"Karşıt cümle","en":"Придаточное","role":"o"}],"examples":[{"text":"[v:Север развивается быстро], [x:тогда как] [o:юг отстаёт].","reading":"Sever razvivayetsya bystro, togda kak yug otstayot.","tr":"Kuzey hızla gelişirken güney geride kalıyor."}]},{"kind":"other","title":"Orantı: чем…, тем…","formula":[{"tr":"Чем + karşılaştırma","en":"Чем + сравнительная степень","role":"x"},{"tr":"Cümle","en":"Предложение","role":"o"},{"tr":"тем + karşılaştırma","en":"Тем + сравнительная степень","role":"x"},{"tr":"Cümle","en":"Предложение","role":"v"}],"examples":[{"text":"[x:Чем больше] [o:ты читаешь], [x:тем лучше] [v:ты пишешь].","reading":"Chem bol'she ty chitayesh', tem luchshe ty pishesh'.","tr":"Ne kadar çok okursan o kadar iyi yazarsın."}]},{"kind":"other","title":"Amaç (resmî)","formula":[{"tr":"для того чтобы","en":"Союз для того чтобы","role":"x"},{"tr":"Mastar","en":"Инфинитив","role":"v"},{"tr":"Ana cümle","en":"Главное предложение","role":"o"}],"examples":[{"text":"[x:Для того чтобы] [v:получить визу], [o:необходимо заполнить анкету].","reading":"Dlya togo chtoby poluchit' vizu, neobkhodimo zapolnit' anketu.","tr":"Vize almak için form doldurmak gerekir."}]}],"rules":["Virgül genelde bağlacın önüne konur; vurgu için bölünebilir: В связи с тем, что…","в то время как hem zaman (-ken) hem karşıtlık bildirir.","Konuşmada sade karşılıklar tercih edilir: потому что, а, чтобы."],"mistakes":[{"wrong":"Чем больше читаешь, чем лучше пишешь.","right":"Чем больше читаешь, тем лучше пишешь.","note":"İkinci kısım тем ile başlar."},{"wrong":"благодаря того что","right":"благодаря тому что","note":"благодаря yönelme hâli ister."}]}},
  {"id":"ru-gr-modalnye-slova-i-vyrazheniya-veroyatnosti","languageId":"ru","category":"grammar","level":"C2","sourceText":"Модальные слова и выражения вероятности","translations":{"tr":["Olasılık ve kesinlik kalıpları"]},"details":{"reading":"Modál'nye slová i vyrazhéniya veroyátnosti"},"grammar":{"summary":"вряд ли, должно быть, наверняка, чуть не, чуть ли не gibi kalıplar konuşanın olasılık değerlendirmesini ince derecelerle verir.","uses":["Düşük olasılık: вряд ли, едва ли","Güçlü tahmin: должно быть, наверняка, скорее всего","Az kalsın: чуть не + СВ geçmiş","Abartılı yaklaşıklık: чуть ли не"],"sections":[{"kind":"other","title":"вряд ли / едва ли","formula":[{"tr":"вряд ли","en":"Модальная частица","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Сказуемое","role":"v"}],"examples":[{"text":"[x:Вряд ли] [s:он] [v:придёт].","reading":"Vryad li on pridyot.","tr":"Pek gelmez herhalde."}]},{"kind":"other","title":"должно быть / наверняка","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Ara söz","en":"Вводное слово","role":"x"},{"tr":"Fiil","en":"Сказуемое","role":"v"}],"examples":[{"text":"[s:Она], [x:должно быть], [v:устала].","reading":"Ona, dolzhno byt', ustala.","tr":"Herhalde yorulmuştur."}]},{"kind":"other","title":"чуть не + СВ","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"чуть не","en":"Частица чуть не","role":"x"},{"tr":"Fiil (СВ geçmiş)","en":"Глагол СВ прош. вр.","role":"v"},{"tr":"Tümleç","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Я] [x:чуть не] [v:опоздал] [o:на поезд].","reading":"Ya chut' ne opozdal na poyezd.","tr":"Neredeyse treni kaçırıyordum."}]},{"kind":"other","title":"чуть ли не","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"чуть ли не","en":"Частица чуть ли не","role":"x"},{"tr":"Tümleç","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Он] [v:звонит] [x:чуть ли не] [o:каждый день].","reading":"On zvonit chut' li ne kazhdyy den'.","tr":"Neredeyse her gün arıyor."}]}],"rules":["вряд ли olumlu fiille olumsuz tahmin verir: Вряд ли он придёт = Muhtemelen gelmez.","чуть не: olay gerçekleşmedi; не burada olumsuzluk değildir.","должно быть (herhalde) ara sözdür, должен быть (olmalı, gerekli) ile karıştırma."],"mistakes":[{"wrong":"Вряд ли он не придёт. (muhtemelen gelmez anlamında)","right":"Вряд ли он придёт.","note":"вряд ли zaten olumsuz tahmin içerir."},{"wrong":"Я чуть не опаздывал.","right":"Я чуть не опоздал.","note":"чуть не + СВ geçmiş."},{"wrong":"Он должен быть устал.","right":"Он, должно быть, устал.","note":"Tahmin anlamında ara söz должно быть."}]}}
]
