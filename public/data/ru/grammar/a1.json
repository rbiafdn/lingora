  {"id":"ru-gr-rod-sushchestvitelnykh","languageId":"ru","category":"grammar","level":"A1","sourceText":"Род существительных","translations":{"tr":["İsimlerin cinsiyeti"]},"details":{"reading":"Rod sushchestvítel'nykh"},"grammar":{"summary":"Rusçada her ismin cinsiyeti vardır (eril, dişil, nötr); cinsiyet çoğunlukla kelimenin sonundan anlaşılır.","uses":["Sıfatın, zamirin ve geçmiş zaman fiilinin doğru biçimini seçmek","İsmin hangi çekim grubuna girdiğini bilmek","İsmi он / она / оно ile doğru karşılamak"],"sections":[{"kind":"other","title":"Eril (мужской род): ünsüz, -й, -ь","formula":[{"tr":"İsim","en":"Существительное","role":"s"},{"tr":"Son: ünsüz / -й / -ь","en":"Мужской род","role":"x"}],"examples":[{"text":"[s:стол], [s:музей], [s:словарь]","reading":"stol, muzey, slovar'","tr":"masa, müze, sözlük"},{"text":"Где [s:музей]? — [x:Он] там.","reading":"Gde muzey? — On tam.","tr":"Müze nerede? — Orada."}]},{"kind":"other","title":"Dişil (женский род): -а, -я, -ь","formula":[{"tr":"İsim","en":"Существительное","role":"s"},{"tr":"Son: -а / -я / -ь","en":"Женский род","role":"x"}],"examples":[{"text":"[s:книга], [s:неделя], [s:тетрадь]","reading":"kniga, nedelya, tetrad'","tr":"kitap, hafta, defter"},{"text":"Где [s:книга]? — [x:Она] там.","reading":"Gde kniga? — Ona tam.","tr":"Kitap nerede? — Orada."}]},{"kind":"other","title":"Nötr (средний род): -о, -е, -мя","formula":[{"tr":"İsim","en":"Существительное","role":"s"},{"tr":"Son: -о / -е / -мя","en":"Средний род","role":"x"}],"examples":[{"text":"[s:окно], [s:море], [s:имя]","reading":"okno, more, imya","tr":"pencere, deniz, isim"},{"text":"Где [s:окно]? — [x:Оно] там.","reading":"Gde okno? — Ono tam.","tr":"Pencere nerede? — Orada."}]}],"rules":["Cinsiyet anlamdan değil kelimenin sonundan belirlenir: стол eril, книга dişil, окно nötr.","-ь ile biten isimler eril ya da dişil olabilir; sözlükten cinsiyetiyle birlikte öğrenilmelidir.","Sıfatlar, мой / моя / моё ve geçmiş zaman fiili ismin cinsiyetine uyar."],"exceptions":["папа, дедушка, мужчина -а ile bitse de erildir.","кофе erildir; -мя ile bitenler (имя, время) nötrdür."],"mistakes":[{"wrong":"Моя папа","right":"Мой папа","note":"папа anlamca eril olduğu için eril sözcük alır."},{"wrong":"Где окно? — Она там.","right":"Где окно? — Оно там.","note":"-о ile biten isim nötrdür, оно ile karşılanır."}]}},
  {"id":"ru-gr-mnozhestvennoye-chislo-sushchestvitelnykh","languageId":"ru","category":"grammar","level":"A1","sourceText":"Множественное число существительных","translations":{"tr":["İsimlerin çoğulu"]},"details":{"reading":"Mnózhestvennoye chisló sushchestvítel'nykh"},"grammar":{"summary":"Yalın hâlde çoğul çoğunlukla -ы / -и, nötr isimlerde -а / -я ile yapılır.","uses":["Birden fazla nesne veya kişiden söz etmek","Çoğul sıfat ve fiil biçimini seçmek"],"sections":[{"kind":"other","title":"-ы: sert ünsüz ve -а ile bitenler","formula":[{"tr":"Tekil","en":"Единственное число","role":"s"},{"tr":"→ -ы","en":"Окончание -ы","role":"x"}],"examples":[{"text":"[s:стол] → [s:столы], [s:мама] → [s:мамы]","reading":"stol → stoly, mama → mamy","tr":"masa → masalar, anne → anneler"}]},{"kind":"other","title":"-и: -й, -ь, -я ve г, к, х, ж, ш, ч, щ sonrası","formula":[{"tr":"Tekil","en":"Единственное число","role":"s"},{"tr":"→ -и","en":"Окончание -и","role":"x"}],"examples":[{"text":"[s:музей] → [s:музеи], [s:неделя] → [s:недели]","reading":"muzey → muzei, nedelya → nedeli","tr":"müze → müzeler, hafta → haftalar"},{"text":"[s:книга] → [s:книги], [s:нож] → [s:ножи]","reading":"kniga → knigi, nozh → nozhi","tr":"kitap → kitaplar, bıçak → bıçaklar"}]},{"kind":"other","title":"-а / -я: nötr isimler","formula":[{"tr":"Tekil (nötr)","en":"Средний род","role":"s"},{"tr":"→ -а / -я","en":"Окончание -а / -я","role":"x"}],"examples":[{"text":"[s:окно] → [s:окна], [s:море] → [s:моря]","reading":"okno → okna, more → morya","tr":"pencere → pencereler, deniz → denizler"}]},{"kind":"other","title":"Düzensiz çoğullar","formula":[{"tr":"Tekil","en":"Единственное число","role":"s"},{"tr":"Düzensiz çoğul","en":"Нерегулярное множественное","role":"x"}],"examples":[{"text":"[s:человек] → [s:люди], [s:ребёнок] → [s:дети], [s:друг] → [s:друзья]","reading":"chelovek → lyudi, rebyonok → deti, drug → druz'ya","tr":"insan → insanlar, çocuk → çocuklar, arkadaş → arkadaşlar"}]}],"rules":["г, к, х, ж, ш, ч, щ harflerinden sonra ы yazılmaz, и yazılır (yazım kuralı).","Bazı eril isimler vurgulu -а alır: дом → дома, город → города, глаз → глаза.","Çoğulda vurgu yer değiştirebilir: окнó → óкна."],"exceptions":["Bazı isimlerin sadece çoğulu vardır: деньги (para), очки (gözlük), часы (saat).","кофе, метро, такси gibi yabancı kökenli isimler hiç değişmez."],"mistakes":[{"wrong":"книгы","right":"книги","note":"к harfinden sonra ы değil и yazılır."},{"wrong":"человеки","right":"люди","note":"человек kelimesinin çoğulu düzensizdir."},{"wrong":"домы","right":"дома","note":"дом vurgulu -а ile çoğul yapar."}]}},
  {"id":"ru-gr-lichnyye-mestoimeniya","languageId":"ru","category":"grammar","level":"A1","sourceText":"Личные местоимения","translations":{"tr":["Şahıs zamirleri"]},"details":{"reading":"Líchnyye mestoiméniya"},"grammar":{"summary":"я, ты, он, она, оно, мы, вы, они; Türkçenin aksine özne zamiri genellikle söylenir.","uses":["Cümlenin öznesini belirtmek","Resmî hitapta Вы kullanmak","Cansız isimleri cinsiyetine göre он / она / оно ile karşılamak"],"sections":[{"kind":"other","title":"Tekil: я, ты, он, она, оно","formula":[{"tr":"Zamir","en":"Местоимение","role":"s"},{"tr":"Yüklem","en":"Сказуемое","role":"o"}],"examples":[{"text":"[s:Я] [o:студент].","reading":"Ya student.","tr":"Ben öğrenciyim."},{"text":"[s:Ты] [o:дома]?","reading":"Ty doma?","tr":"Evde misin?"}]},{"kind":"other","title":"Çoğul: мы, вы, они","formula":[{"tr":"Zamir","en":"Местоимение","role":"s"},{"tr":"Yüklem","en":"Сказуемое","role":"o"}],"examples":[{"text":"[s:Мы] [o:друзья].","reading":"My druz'ya.","tr":"Biz arkadaşız."},{"text":"[s:Они] [o:в Москве].","reading":"Oni v Moskve.","tr":"Onlar Moskova'da."}]},{"kind":"other","title":"Samimi ты / resmî Вы","formula":[{"tr":"ты / Вы","en":"ты / Вы","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Ты] [v:знаешь] [o:Анну]?","reading":"Ty znayesh' Annu?","tr":"Anna'yı tanıyor musun?"},{"text":"[s:Вы] [v:говорите] [o:по-русски]?","reading":"Vy govorite po-russki?","tr":"Rusça konuşuyor musunuz?"}]}],"rules":["Fiil kişiyi gösterse de zamir genellikle söylenir: Я читаю.","Вы hem çoğul \"siz\" hem tek kişiye resmî hitaptır; mektupta büyük harfle yazılır.","он / она / оно sadece insanlar için değil, her isim için cinsiyetine göre kullanılır."],"exceptions":["Edattan sonra он, она, оно, они н- alır: у него, с ней, к ним."],"mistakes":[{"wrong":"Где книга? — Он там.","right":"Где книга? — Она там.","note":"книга dişil olduğu için она kullanılır."},{"wrong":"Ты профессор? (hocaya)","right":"Вы профессор?","note":"Tanımadığınız ya da büyük birine Вы denir."}]}},
  {"id":"ru-gr-glagol-byt-v-nastoyashchem-vremeni","languageId":"ru","category":"grammar","level":"A1","sourceText":"Глагол «быть» в настоящем времени","translations":{"tr":["\"Olmak\" fiilinin şimdiki zamanda düşmesi"]},"details":{"reading":"Glagól «byt'» v nastoyáshchem vrémeni"},"grammar":{"summary":"Şimdiki zamanda \"olmak\" (быть) söylenmez: Я студент = Ben öğrenciyim.","uses":["Kimlik, meslek, nitelik bildirmek","Это ile bir şeyi tanıtmak","Yer bildirmek (Он дома.)"],"sections":[{"kind":"affirmative","title":"İsim cümlesi","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"(fiil yok)","en":"Нулевая связка","role":"a"},{"tr":"İsim / sıfat","en":"Сказуемое","role":"o"}],"examples":[{"text":"[s:Я] [o:студент].","reading":"Ya student.","tr":"Ben öğrenciyim."},{"text":"[s:Анна] — [o:врач].","reading":"Anna — vrach.","tr":"Anna doktor."}],"notes":["İki isim arasında yazıda tire konabilir: Москва — столица."]},{"kind":"other","title":"Это + isim","formula":[{"tr":"Это","en":"Это","role":"s"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[s:Это] [o:моя мама].","reading":"Eto moya mama.","tr":"Bu benim annem."},{"text":"[q:Кто] [s:это]? — [s:Это] [o:Иван].","reading":"Kto eto? — Eto Ivan.","tr":"Bu kim? — Bu İvan."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"не","en":"не","role":"a"},{"tr":"Yüklem","en":"Сказуемое","role":"o"}],"examples":[{"text":"[s:Он] [a:не] [o:врач].","reading":"On ne vrach.","tr":"O doktor değil."},{"text":"[s:Это] [a:не] [o:мой телефон].","reading":"Eto ne moy telefon.","tr":"Bu benim telefonum değil."}]},{"kind":"other","title":"Geçmiş ve gelecekte быть geri gelir","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"был / была / были · буду…","en":"быть","role":"a"},{"tr":"Yüklem","en":"Сказуемое","role":"o"}],"examples":[{"text":"[s:Я] [a:был] [o:дома].","reading":"Ya byl doma.","tr":"Evdeydim."},{"text":"[x:Завтра] [s:я] [a:буду] [o:дома].","reading":"Zavtra ya budu doma.","tr":"Yarın evde olacağım."}]}],"rules":["Şimdiki zamanda \"-dır / -im\" karşılığı bir fiil yoktur.","Geçmişte был / была / было / были, gelecekte буду / будешь… kullanılır.","есть \"var\" anlamında kullanılır, \"-dır\" anlamında kullanılmaz."],"exceptions":[],"mistakes":[{"wrong":"Я есть студент.","right":"Я студент.","note":"Şimdiki zamanda \"olmak\" fiili söylenmez."},{"wrong":"Это есть мой дом.","right":"Это мой дом.","note":"это ile de fiil kullanılmaz."}]}},
  {"id":"ru-gr-voprositelnyye-slova-i-voprosy","languageId":"ru","category":"grammar","level":"A1","sourceText":"Вопросительные слова и вопросы","translations":{"tr":["Soru kelimeleri ve soru cümlesi"]},"details":{"reading":"Voprosítel'nyye slová i voprósy"},"grammar":{"summary":"Evet/hayır sorusu sadece tonlamayla yapılır; soru kelimeleri (кто, что, где, когда…) cümlenin başına gelir.","uses":["Evet/hayır soruları sormak","Bilgi istemek: kim, ne, nerede, ne zaman, nasıl, neden"],"sections":[{"kind":"question","title":"Evet/hayır sorusu (tonlama)","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Yüklem? (ses yükselir)","en":"Сказуемое (интонация)","role":"v"}],"examples":[{"text":"[s:Ты] [v:студент]?","reading":"Ty student?","tr":"Öğrenci misin?"},{"text":"[s:Вы] [v:говорите] по-русски?","reading":"Vy govorite po-russki?","tr":"Rusça konuşuyor musunuz?"}],"notes":["Soru eki yoktur; sorulan kelimede ses yükselir."]},{"kind":"wh","title":"Soru kelimeli sorular","formula":[{"tr":"Soru kelimesi","en":"Вопросительное слово","role":"q"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil?","en":"Глагол","role":"v"}],"examples":[{"text":"[q:Где] [s:ты] [v:живёшь]?","reading":"Gde ty zhivyosh'?","tr":"Nerede yaşıyorsun?"},{"text":"[q:Что] [s:вы] [v:делаете]?","reading":"Chto vy delayete?","tr":"Ne yapıyorsunuz?"}]},{"kind":"other","title":"Кто? / Что?","formula":[{"tr":"Кто / Что","en":"Кто / Что","role":"q"},{"tr":"это?","en":"это","role":"s"}],"examples":[{"text":"[q:Кто] [s:это]? — Это [o:мой брат].","reading":"Kto eto? — Eto moy brat.","tr":"Bu kim? — Bu benim kardeşim."},{"text":"[q:Что] [s:это]? — Это [o:книга].","reading":"Chto eto? — Eto kniga.","tr":"Bu ne? — Bu bir kitap."}]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Да / Нет","en":"Да / Нет","role":"x"},{"tr":"Yüklem","en":"Сказуемое","role":"o"}],"examples":[{"text":"[x:Да], [s:я] [o:студент].","reading":"Da, ya student.","tr":"Evet, öğrenciyim."},{"text":"[x:Нет], [s:я] [a:не] [o:студент].","reading":"Net, ya ne student.","tr":"Hayır, öğrenci değilim."}]}],"rules":["кто canlılar (hayvanlar dahil), что cansızlar için kullanılır.","Diğer soru kelimeleri: когда (ne zaman), как (nasıl), почему (neden), сколько (kaç), куда (nereye), откуда (nereden).","где durulan yeri, куда gidilen yönü sorar."],"exceptions":[],"mistakes":[{"wrong":"Что это? (bir kediyi gösterirken)","right":"Кто это?","note":"Hayvanlar için de кто kullanılır."},{"wrong":"Где ты идёшь?","right":"Куда ты идёшь?","note":"Yön (nereye) için куда kullanılır."}]}},
  {"id":"ru-gr-otritsaniye-ne-i-nyet","languageId":"ru","category":"grammar","level":"A1","sourceText":"Отрицание: не и нет","translations":{"tr":["Olumsuzluk: не ve нет"]},"details":{"reading":"Otritsániye: ne i nyet"},"grammar":{"summary":"не olumsuzlanan kelimenin önüne gelir; нет hem \"hayır\" hem \"yok\" demektir.","uses":["Fiili ya da başka bir kelimeyi olumsuz yapmak","Hayır demek","Bir şeyin yokluğunu bildirmek"],"sections":[{"kind":"negative","title":"не + fiil","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"не","en":"не","role":"a"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Я] [a:не] [v:понимаю].","reading":"Ya ne ponimayu.","tr":"Anlamıyorum."},{"text":"[s:Она] [a:не] [v:говорит] [o:по-английски].","reading":"Ona ne govorit po-angliyski.","tr":"İngilizce konuşmuyor."}]},{"kind":"other","title":"не + başka kelime","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"не","en":"не","role":"a"},{"tr":"Olumsuzlanan kelime","en":"Отрицаемое слово","role":"o"}],"examples":[{"text":"[s:Я] [v:живу] [a:не] [o:в Москве].","reading":"Ya zhivu ne v Moskve.","tr":"Moskova'da yaşamıyorum (başka yerde)."},{"text":"[s:Это] [a:не] [o:мой телефон].","reading":"Eto ne moy telefon.","tr":"Bu benim telefonum değil."}]},{"kind":"other","title":"нет = hayır","formula":[{"tr":"Нет","en":"Нет","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"не","en":"не","role":"a"},{"tr":"Fiil","en":"Глагол","role":"v"}],"examples":[{"text":"[x:Нет], [s:я] [a:не] [v:знаю].","reading":"Net, ya ne znayu.","tr":"Hayır, bilmiyorum."}]},{"kind":"other","title":"нет + -in hâli = yok","formula":[{"tr":"У + kişi","en":"У + родительный падеж","role":"x"},{"tr":"нет","en":"нет","role":"a"},{"tr":"Şey (-in hâli)","en":"Родительный падеж","role":"o"}],"examples":[{"text":"[x:У меня] [a:нет] [o:времени].","reading":"U menya net vremeni.","tr":"Vaktim yok."},{"text":"[o:Анны] [a:нет] [x:дома].","reading":"Anny net doma.","tr":"Anna evde değil."}]}],"rules":["не her zaman olumsuzladığı kelimenin hemen önüne gelir.","Çift olumsuzluk normaldir: Я ничего не знаю (Hiçbir şey bilmiyorum).","Yokluk bildiren нет sonrasında isim -in hâline (родительный) girer."],"exceptions":[],"mistakes":[{"wrong":"Я знаю не.","right":"Я не знаю.","note":"не fiilin önüne gelir."},{"wrong":"У меня нет время.","right":"У меня нет времени.","note":"нет sonrasında -in hâli gelir."}]}},
  {"id":"ru-gr-nastoyashcheye-vremya-pervoye-spryazheniye","languageId":"ru","category":"grammar","level":"A1","sourceText":"Настоящее время: первое спряжение","translations":{"tr":["Şimdiki zaman: 1. çekim"]},"details":{"reading":"Nastoyáshcheye vrémya: pérvoye spryazhéniye"},"grammar":{"summary":"Çoğu -ать / -ять fiili 1. çekime girer: я -ю, ты -ешь, он -ет, мы -ем, вы -ете, они -ют.","uses":["Şu an olan eylemler","Alışkanlıklar ve genel durumlar (Rusçada şimdiki ve geniş zaman aynıdır)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil: -ю / -ешь / -ет / -ем / -ете / -ют","en":"Глагол (I спряжение)","role":"v"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Я] [v:читаю] [o:книгу].","reading":"Ya chitayu knigu.","tr":"Kitap okuyorum."},{"text":"[s:Они] [v:работают] [o:дома].","reading":"Oni rabotayut doma.","tr":"Evde çalışıyorlar."}],"notes":["читать: читаю, читаешь, читает, читаем, читаете, читают."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"не","en":"не","role":"a"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Он] [a:не] [v:знает] [o:ответ].","reading":"On ne znayet otvet.","tr":"Cevabı bilmiyor."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil?","en":"Глагол","role":"v"}],"examples":[{"text":"[s:Ты] [v:понимаешь]?","reading":"Ty ponimayesh'?","tr":"Anlıyor musun?"}]},{"kind":"wh","title":"Soru kelimeli","formula":[{"tr":"Soru kelimesi","en":"Вопросительное слово","role":"q"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil?","en":"Глагол","role":"v"}],"examples":[{"text":"[q:Что] [s:ты] [v:делаешь]?","reading":"Chto ty delayesh'?","tr":"Ne yapıyorsun?"},{"text":"[q:Где] [s:вы] [v:работаете]?","reading":"Gde vy rabotayete?","tr":"Nerede çalışıyorsunuz?"}]}],"rules":["Rusçada şimdiki zaman tek biçimdir: читаю = okuyorum / okurum.","Ünsüzle biten köklerde -у / -ут gelir: жить → живу, живёшь, живут.","Ek vurguluysa е → ё olur: идти → идёшь, жить → живёшь."],"exceptions":["-овать fiilleri -ую olur: рисовать → рисую, рисуешь.","писать → пишу, пишешь (с → ш değişimi)."],"mistakes":[{"wrong":"Я читать.","right":"Я читаю.","note":"Mastar çekimsiz kullanılmaz; özneye göre çekilir."},{"wrong":"Я рисоваю.","right":"Я рисую.","note":"-овать fiillerinde -ова- düşer, -у- gelir."},{"wrong":"Они читаят.","right":"Они читают.","note":"1. çekimde они eki -ют / -ут."}]}},
  {"id":"ru-gr-nastoyashcheye-vremya-vtoroye-spryazheniye","languageId":"ru","category":"grammar","level":"A1","sourceText":"Настоящее время: второе спряжение","translations":{"tr":["Şimdiki zaman: 2. çekim"]},"details":{"reading":"Nastoyáshcheye vrémya: vtoróye spryazhéniye"},"grammar":{"summary":"Çoğu -ить fiili ve bazı -еть / -ать fiilleri 2. çekime girer: я -ю/-у, ты -ишь, он -ит, мы -им, вы -ите, они -ят/-ат.","uses":["Şu an olan eylemler","Alışkanlıklar ve genel durumlar"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil: -ю / -ишь / -ит / -им / -ите / -ят","en":"Глагол (II спряжение)","role":"v"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Я] [v:говорю] [o:по-русски].","reading":"Ya govoryu po-russki.","tr":"Rusça konuşuyorum."},{"text":"[s:Они] [v:смотрят] [o:фильм].","reading":"Oni smotryat fil'm.","tr":"Film izliyorlar."}],"notes":["говорить: говорю, говоришь, говорит, говорим, говорите, говорят."]},{"kind":"other","title":"Sadece я biçiminde ünsüz değişimi","formula":[{"tr":"Özne: я","en":"я","role":"s"},{"tr":"Fiil (değişen ünsüz)","en":"Чередование согласных","role":"v"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Я] [v:люблю] [o:чай].","reading":"Ya lyublyu chay.","tr":"Çay severim."},{"text":"[s:Я] [v:хожу] [o:в школу].","reading":"Ya khozhu v shkolu.","tr":"Okula giderim."}],"notes":["любить → люблю, ходить → хожу, видеть → вижу; diğer kişiler değişmez: любишь, ходишь."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"не","en":"не","role":"a"},{"tr":"Fiil","en":"Глагол","role":"v"}],"examples":[{"text":"[s:Мы] [a:не] [v:курим].","reading":"My ne kurim.","tr":"Sigara içmeyiz."}]},{"kind":"wh","title":"Soru kelimeli","formula":[{"tr":"Soru kelimesi","en":"Вопросительное слово","role":"q"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil?","en":"Глагол","role":"v"}],"examples":[{"text":"[q:Что] [s:ты] [v:смотришь]?","reading":"Chto ty smotrish'?","tr":"Ne izliyorsun?"}]}],"rules":["ж, ш, ч, щ harflerinden sonra я / ю yerine а / у yazılır: слышать → слышу, слышат.","Bazı -еть fiilleri 2. çekimdir: смотреть, видеть, сидеть.","Çekim mastardan her zaman tahmin edilemez; fiili \"ты\" biçimiyle birlikte öğren."],"exceptions":["хотеть karışıktır: хочу, хочешь, хочет, хотим, хотите, хотят.","спать → сплю, спишь (2. çekim, -л- eklenir)."],"mistakes":[{"wrong":"Я любю.","right":"Я люблю.","note":"б harfinden sonra я biçiminde -л- eklenir."},{"wrong":"Он говорет.","right":"Он говорит.","note":"2. çekimde он eki -ит."},{"wrong":"Они хочут.","right":"Они хотят.","note":"хотеть çoğulda 2. çekime geçer."}]}},
  {"id":"ru-gr-prityazhatelnyye-mestoimeniya","languageId":"ru","category":"grammar","level":"A1","sourceText":"Притяжательные местоимения","translations":{"tr":["İyelik zamirleri"]},"details":{"reading":"Prityazhátel'nyye mestoiméniya"},"grammar":{"summary":"мой, твой, наш, ваш isimle cinsiyet ve sayıca uyuşur; его, её, их hiç değişmez.","uses":["Bir şeyin kime ait olduğunu söylemek","Чей? (kimin?) sorusuna cevap vermek"],"sections":[{"kind":"other","title":"мой / моя / моё / мои","formula":[{"tr":"İyelik zamiri","en":"Притяжательное местоимение","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[x:мой] [o:брат], [x:моя] [o:сестра], [x:моё] [o:письмо], [x:мои] [o:друзья]","reading":"moy brat, moya sestra, moyo pis'mo, moi druz'ya","tr":"kardeşim, kız kardeşim, mektubum, arkadaşlarım"}],"notes":["твой, наш, ваш da aynı şekilde: твоя, наше, ваши."]},{"kind":"other","title":"наш / ваш","formula":[{"tr":"İyelik zamiri","en":"Притяжательное местоимение","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[x:Наш] [o:дом] большой.","reading":"Nash dom bol'shoy.","tr":"Evimiz büyük."},{"text":"[x:Ваша] [o:машина] здесь?","reading":"Vasha mashina zdes'?","tr":"Arabanız burada mı?"}]},{"kind":"other","title":"его / её / их (değişmez)","formula":[{"tr":"его / её / их","en":"его / её / их","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[x:Его] [o:мама] — врач.","reading":"Yevo mama — vrach.","tr":"Onun annesi doktor."},{"text":"[x:Их] [o:дети] в школе.","reading":"Ikh deti v shkole.","tr":"Onların çocukları okulda."}]},{"kind":"wh","title":"Чей? Чья? Чьё? Чьи?","formula":[{"tr":"Чей / чья / чьё / чьи","en":"Чей","role":"q"},{"tr":"İsim?","en":"Существительное","role":"o"}],"examples":[{"text":"[q:Чья] это [o:сумка]? — [x:Моя].","reading":"Ch'ya eto sumka? — Moya.","tr":"Bu çanta kimin? — Benim."}]}],"rules":["мой, твой, наш, ваш sahibine değil ismin cinsiyetine uyar.","его (onun, erkek/nötr), её (onun, kadın), их (onların) hiç çekilmez.","его \"yevo\" okunur (г = v)."],"exceptions":[],"mistakes":[{"wrong":"Мой мама","right":"Моя мама","note":"мама dişildir; zamir isme uyar."},{"wrong":"Это моё книга.","right":"Это моя книга.","note":"книга dişil: моя."},{"wrong":"Ихние книги","right":"Их книги","note":"их değişmez; ихний halk ağzıdır."}]}},
  {"id":"ru-gr-soglasovaniye-prilagatelnykh","languageId":"ru","category":"grammar","level":"A1","sourceText":"Согласование прилагательных","translations":{"tr":["Sıfat uyumu"]},"details":{"reading":"Soglasovániye prilagátel'nykh"},"grammar":{"summary":"Sıfat ismin cinsiyetine, sayısına ve hâline uyar: новый дом, новая машина, новое окно, новые дома.","uses":["İsmi nitelemek","Какой? Какая? Какое? Какие? sorularına cevap vermek"],"sections":[{"kind":"other","title":"Eril: -ый / -ий / -ой","formula":[{"tr":"Sıfat","en":"Прилагательное (м. р.)","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[x:новый] [o:дом], [x:синий] [o:карандаш], [x:большой] [o:город]","reading":"novyy dom, siniy karandash, bol'shoy gorod","tr":"yeni ev, mavi kalem, büyük şehir"}]},{"kind":"other","title":"Dişil: -ая / -яя","formula":[{"tr":"Sıfat","en":"Прилагательное (ж. р.)","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[x:новая] [o:машина], [x:синяя] [o:сумка]","reading":"novaya mashina, sinyaya sumka","tr":"yeni araba, mavi çanta"}]},{"kind":"other","title":"Nötr: -ое / -ее","formula":[{"tr":"Sıfat","en":"Прилагательное (ср. р.)","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[x:новое] [o:окно], [x:синее] [o:море]","reading":"novoye okno, sineye more","tr":"yeni pencere, mavi deniz"}]},{"kind":"other","title":"Çoğul: -ые / -ие","formula":[{"tr":"Sıfat","en":"Прилагательное (мн. ч.)","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[x:новые] [o:дома], [x:синие] [o:глаза]","reading":"novyye doma, siniye glaza","tr":"yeni evler, mavi gözler"},{"text":"[s:Дом] [o:новый].","reading":"Dom novyy.","tr":"Ev yeni."}]}],"rules":["Vurgulu sonda eril ek -ой olur: большой, молодой.","г, к, х, ж, ш, ч, щ harflerinden sonra ы değil и yazılır: русский, хороший.","Çoğulda cinsiyet farkı yoktur: новые столы, новые книги."],"exceptions":[],"mistakes":[{"wrong":"красивый девушка","right":"красивая девушка","note":"Sıfat dişil isme uyar."},{"wrong":"русскый","right":"русский","note":"к harfinden sonra и yazılır."},{"wrong":"новый окно","right":"новое окно","note":"окно nötrdür."}]}},
  {"id":"ru-gr-imenitelnyy-padezh","languageId":"ru","category":"grammar","level":"A1","sourceText":"Именительный падеж","translations":{"tr":["Yalın hâl (Именительный)"]},"details":{"reading":"Imenítel'nyy padézh"},"grammar":{"summary":"Yalın hâl ismin sözlük biçimidir; öznede, это / вот sonrasında ve isim yüklemde kullanılır. Soruları: кто? что?","uses":["Cümlenin öznesi","İsim yüklem (Он врач.)","Bir şeyi tanıtmak, göstermek (Это…, Вот…)"],"sections":[{"kind":"other","title":"Özne","formula":[{"tr":"Özne (yalın)","en":"Подлежащее (им. п.)","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"}],"examples":[{"text":"[s:Мама] [v:работает].","reading":"Mama rabotayet.","tr":"Annem çalışıyor."},{"text":"[s:Студенты] [v:читают].","reading":"Studenty chitayut.","tr":"Öğrenciler okuyor."}]},{"kind":"other","title":"İsim yüklem","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Yüklem (yalın)","en":"Сказуемое (им. п.)","role":"o"}],"examples":[{"text":"[s:Мой брат] — [o:инженер].","reading":"Moy brat — inzhener.","tr":"Abim mühendis."}]},{"kind":"other","title":"Это / Вот + yalın","formula":[{"tr":"Это / Вот","en":"Это / Вот","role":"x"},{"tr":"İsim (yalın)","en":"Именительный падеж","role":"o"}],"examples":[{"text":"[x:Это] [o:Москва].","reading":"Eto Moskva.","tr":"Burası Moskova."},{"text":"[x:Вот] [o:мой дом].","reading":"Vot moy dom.","tr":"İşte evim."}]},{"kind":"other","title":"Tanışma: Меня зовут…","formula":[{"tr":"Меня зовут","en":"Меня зовут","role":"x"},{"tr":"Ad (yalın)","en":"Имя (им. п.)","role":"o"}],"examples":[{"text":"[x:Меня зовут] [o:Анна].","reading":"Menya zovut Anna.","tr":"Benim adım Anna."}]}],"rules":["Sözlükte isimler yalın tekil hâlde yazılır.","Rusçada 6 hâl vardır; yalın hâl dışındakiler isme ek getirir.","Kişinin adı Меня зовут kalıbında yalın hâldedir."],"exceptions":[],"mistakes":[{"wrong":"Это Москву.","right":"Это Москва.","note":"это sonrasında yalın hâl gelir."},{"wrong":"Меня зовут Анну.","right":"Меня зовут Анна.","note":"Ad yalın hâlde kalır."}]}},
  {"id":"ru-gr-predlozhnyy-padezh","languageId":"ru","category":"grammar","level":"A1","sourceText":"Предложный падеж","translations":{"tr":["-de hâli (Предложный)"]},"details":{"reading":"Predlózhnyy padézh"},"grammar":{"summary":"Yer (в / на + -е: где?) ve konu (о + -е: о чём?) bildirir; her zaman bir edatla kullanılır.","uses":["Nerede? sorusuna cevap vermek","Ne hakkında? sorusuna cevap vermek","Taşıtla gitmek (на машине)"],"sections":[{"kind":"other","title":"Yer: в / на + -е","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"в / на","en":"Предлог в / на","role":"x"},{"tr":"Yer (-е)","en":"Предложный падеж","role":"o"}],"examples":[{"text":"[s:Я] [v:живу] [x:в] [o:Москве].","reading":"Ya zhivu v Moskve.","tr":"Moskova'da yaşıyorum."},{"text":"[s:Книга] [x:на] [o:столе].","reading":"Kniga na stole.","tr":"Kitap masanın üstünde."}]},{"kind":"other","title":"Konu: о / об + -е","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"о / об","en":"Предлог о","role":"x"},{"tr":"Konu (-е)","en":"Предложный падеж","role":"o"}],"examples":[{"text":"[s:Мы] [v:говорим] [x:о] [o:работе].","reading":"My govorim o rabote.","tr":"İş hakkında konuşuyoruz."},{"text":"[s:Он] [v:думает] [x:об] [o:отпуске].","reading":"On dumayet ob otpuske.","tr":"Tatili düşünüyor."}]},{"kind":"other","title":"Ekler","formula":[{"tr":"İsim","en":"Существительное","role":"o"},{"tr":"→ -е / -и","en":"Окончание","role":"x"}],"examples":[{"text":"[o:стол] → [o:столе], [o:мама] → [o:маме], [o:музей] → [o:музее]","reading":"stol → stole, mama → mame, muzey → muzeye","tr":"masa, anne, müze"},{"text":"[o:тетрадь] → [o:тетради], [o:Россия] → [o:России], [o:здание] → [o:здании]","reading":"tetrad' → tetradi, Rossiya → Rossii, zdaniye → zdanii","tr":"defter, Rusya, bina"}],"notes":["-ь ile biten dişiller ve -ия / -ие ile bitenler -и alır."]},{"kind":"wh","title":"Где? / О чём?","formula":[{"tr":"Где / О чём","en":"Где / О чём","role":"q"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil?","en":"Глагол","role":"v"}],"examples":[{"text":"[q:Где] [s:ты] [v:работаешь]? — [x:В] [o:банке].","reading":"Gde ty rabotayesh'? — V banke.","tr":"Nerede çalışıyorsun? — Bankada."}]}],"rules":["в \"içinde\", на \"üstünde\"; açık alanlar ve etkinlikler için на: на работе, на улице, на концерте.","Ünlüyle başlayan kelimeden önce о → об olur: об Анне, об этом.","Bazı eril isimler vurgulu -у alır: в лесу, в саду, на полу, в аэропорту."],"exceptions":[],"mistakes":[{"wrong":"Я живу в Москва.","right":"Я живу в Москве.","note":"в sonrasında yer -е ekini alır."},{"wrong":"в работе","right":"на работе","note":"\"İşte\" anlamında работа на ile kullanılır."},{"wrong":"в Россие","right":"в России","note":"-ия ile bitenler -ии olur."}]}},
  {"id":"ru-gr-vinitelnyy-padezh","languageId":"ru","category":"grammar","level":"A1","sourceText":"Винительный падеж","translations":{"tr":["-i hâli (Винительный)"]},"details":{"reading":"Vinítel'nyy padézh"},"grammar":{"summary":"Doğrudan nesneyi (кого? что?) ve в / на ile gidilen yönü (куда?) bildirir.","uses":["Fiilin doğrudan nesnesi","Nereye? sorusuna cevap (в школу)","Zaman ifadeleri (в субботу)"],"sections":[{"kind":"other","title":"Cansız nesne","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Nesne (-i hâli)","en":"Винительный падеж","role":"o"}],"examples":[{"text":"[s:Я] [v:читаю] [o:книгу].","reading":"Ya chitayu knigu.","tr":"Kitap okuyorum."},{"text":"[s:Он] [v:пьёт] [o:воду].","reading":"On p'yot vodu.","tr":"Su içiyor."}],"notes":["Dişil -а → -у, -я → -ю; eril ve nötr cansız isimler değişmez (Я вижу стол)."]},{"kind":"other","title":"Canlı nesne","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Canlı nesne","en":"Одушевлённое (вин. п.)","role":"o"}],"examples":[{"text":"[s:Я] [v:люблю] [o:маму].","reading":"Ya lyublyu mamu.","tr":"Annemi seviyorum."},{"text":"[s:Я] [v:знаю] [o:Ивана].","reading":"Ya znayu Ivana.","tr":"İvan'ı tanıyorum."}],"notes":["Canlı eril isimler -а / -я alır: брат → брата."]},{"kind":"other","title":"Yön: в / на + -i hâli","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Hareket fiili","en":"Глагол движения","role":"v"},{"tr":"в / на","en":"в / на","role":"x"},{"tr":"Yön","en":"Винительный падеж","role":"o"}],"examples":[{"text":"[s:Я] [v:иду] [x:в] [o:школу].","reading":"Ya idu v shkolu.","tr":"Okula gidiyorum."},{"text":"[s:Мы] [v:едем] [x:на] [o:работу].","reading":"My yedem na rabotu.","tr":"İşe gidiyoruz."}]},{"kind":"wh","title":"Что? / Кого? / Куда?","formula":[{"tr":"Soru kelimesi","en":"Вопросительное слово","role":"q"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil?","en":"Глагол","role":"v"}],"examples":[{"text":"[q:Что] [s:ты] [v:читаешь]?","reading":"Chto ty chitayesh'?","tr":"Ne okuyorsun?"},{"text":"[q:Куда] [s:ты] [v:идёшь]?","reading":"Kuda ty idyosh'?","tr":"Nereye gidiyorsun?"}]}],"rules":["-ь ile biten dişil isimler değişmez: Я вижу дверь.","Zamirler: меня, тебя, его, её, нас, вас, их.","где? → -de hâli (в школе); куда? → -i hâli (в школу)."],"exceptions":[],"mistakes":[{"wrong":"Я читаю книга.","right":"Я читаю книгу.","note":"Doğrudan nesne -у alır."},{"wrong":"Я знаю Иван.","right":"Я знаю Ивана.","note":"Canlı eril nesne -а alır."},{"wrong":"Я иду в школе.","right":"Я иду в школу.","note":"Yön bildirirken -i hâli kullanılır."}]}},
  {"id":"ru-gr-konstruktsiya-u-menya-yest","languageId":"ru","category":"grammar","level":"A1","sourceText":"Конструкция «у меня есть»","translations":{"tr":["Sahiplik: \"benim … var\""]},"details":{"reading":"Konstrúktsiya «u menyá yest'»"},"grammar":{"summary":"Sahiplik у + kişi (-in hâli) + есть + sahip olunan şey (yalın) ile söylenir.","uses":["Bir şeye sahip olduğunu söylemek","Bir şeyin olmadığını söylemek","Birine bir şeyi olup olmadığını sormak"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"У + kişi (-in)","en":"У + родительный падеж","role":"x"},{"tr":"есть","en":"есть","role":"a"},{"tr":"Sahip olunan (yalın)","en":"Подлежащее","role":"s"}],"examples":[{"text":"[x:У меня] [a:есть] [s:машина].","reading":"U menya yest' mashina.","tr":"Arabam var."},{"text":"[x:У брата] [a:есть] [s:собака].","reading":"U brata yest' sobaka.","tr":"Kardeşimin köpeği var."}],"notes":["у меня, у тебя, у него, у неё, у нас, у вас, у них."]},{"kind":"negative","title":"Olumsuz: нет + -in hâli","formula":[{"tr":"У + kişi (-in)","en":"У + родительный падеж","role":"x"},{"tr":"нет","en":"нет","role":"a"},{"tr":"Şey (-in hâli)","en":"Родительный падеж","role":"o"}],"examples":[{"text":"[x:У меня] [a:нет] [o:машины].","reading":"U menya net mashiny.","tr":"Arabam yok."},{"text":"[x:У неё] [a:нет] [o:времени].","reading":"U neyo net vremeni.","tr":"Onun vakti yok."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"У + kişi","en":"У + родительный падеж","role":"x"},{"tr":"есть","en":"есть","role":"a"},{"tr":"Şey?","en":"Подлежащее","role":"s"}],"examples":[{"text":"[x:У тебя] [a:есть] [s:ручка]?","reading":"U tebya yest' ruchka?","tr":"Kalemin var mı?"}]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Да / Нет","en":"Да / Нет","role":"x"},{"tr":"есть / нет","en":"есть / нет","role":"a"}],"examples":[{"text":"[x:Да], [a:есть].","reading":"Da, yest'.","tr":"Evet, var."},{"text":"[x:Нет], [a:нет].","reading":"Net, net.","tr":"Hayır, yok."}]},{"kind":"other","title":"есть söylenmeyen durum: nitelik","formula":[{"tr":"У + kişi","en":"У + родительный падеж","role":"x"},{"tr":"Nitelik + isim","en":"Подлежащее","role":"s"}],"examples":[{"text":"[x:У него] [s:голубые глаза].","reading":"U nevo golubyye glaza.","tr":"Mavi gözleri var."}],"notes":["Sahiplik değil niteliği önemliyse есть söylenmez."]}],"rules":["Zamirler у sonrasında н- alır: у него, у неё, у них.","Olumsuzda нет kullanılır ve şey -in hâline girer.","Geçmiş: у меня был / была / было / были; olumsuz geçmiş: у меня не было + -in hâli."],"exceptions":[],"mistakes":[{"wrong":"Я имею машину.","right":"У меня есть машина.","note":"иметь günlük dilde sahiplik için pek kullanılmaz."},{"wrong":"У меня нет машина.","right":"У меня нет машины.","note":"нет sonrasında -in hâli gelir."},{"wrong":"У он есть брат.","right":"У него есть брат.","note":"у sonrasında zamir -in hâline girer ve н- alır."}]}},
  {"id":"ru-gr-proshedsheye-vremya","languageId":"ru","category":"grammar","level":"A1","sourceText":"Прошедшее время","translations":{"tr":["Geçmiş zaman"]},"details":{"reading":"Proshédsheye vrémya"},"grammar":{"summary":"Mastardaki -ть düşer, yerine cinsiyet ve sayıya göre -л, -ла, -ло, -ли gelir.","uses":["Geçmişte olan ya da süren eylemler","Geçmişteki durumlar (был, была)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil: -л / -ла / -ло / -ли","en":"Глагол (прош. вр.)","role":"v"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Он] [v:читал] [o:книгу].","reading":"On chital knigu.","tr":"Kitap okuyordu."},{"text":"[s:Она] [v:работала] [o:дома].","reading":"Ona rabotala doma.","tr":"Evde çalışıyordu."},{"text":"[s:Мы] [v:смотрели] [o:фильм].","reading":"My smotreli fil'm.","tr":"Film izledik."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"не","en":"не","role":"a"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Я] [a:не] [v:знала] [o:об этом].","reading":"Ya ne znala ob etom.","tr":"Bunu bilmiyordum. (kadın)"}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil?","en":"Глагол","role":"v"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Ты] [v:был] [o:в Москве]?","reading":"Ty byl v Moskve?","tr":"Moskova'da bulundun mu?"}]},{"kind":"wh","title":"Soru kelimeli","formula":[{"tr":"Soru kelimesi","en":"Вопросительное слово","role":"q"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil?","en":"Глагол","role":"v"}],"examples":[{"text":"[q:Что] [s:вы] [v:делали] [o:вчера]?","reading":"Chto vy delali vchera?","tr":"Dün ne yaptınız?"}]}],"rules":["Geçmiş zamanda kişi değil cinsiyet ve sayı önemlidir: я был (erkek), я была (kadın).","вы tek kişiye resmî hitapta da çoğul: Вы были?","Tamamlanmış görünüşlü fiil sonucu vurgular: прочитал (okuyup bitirdi)."],"exceptions":["идти → шёл, шла, шли; есть → ел, ела; мочь → мог, могла.","Bazı ünsüz köklerde erilde -л düşer: нести → нёс, несла."],"mistakes":[{"wrong":"Она был дома.","right":"Она была дома.","note":"Dişil özneyle -ла kullanılır."},{"wrong":"Мы был в кино.","right":"Мы были в кино.","note":"Çoğulda -ли."},{"wrong":"Я читала. (erkek konuşan)","right":"Я читал.","note":"Erkek konuşan kendisi için -л kullanır."}]}}
]
