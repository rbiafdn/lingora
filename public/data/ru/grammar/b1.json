[
  {"id":"ru-gr-glagoly-dvizheniya-s-pristavkami","languageId":"ru","category":"grammar","level":"B1","sourceText":"Глаголы движения с приставками","translations":{"tr":["Önekli hareket fiilleri"]},"details":{"reading":"Glagóly dvizhéniya s pristávkami"},"grammar":{"summary":"Önekler hareketin yönünü verir: при- gelmek, у- ayrılmak, в- girmek, вы- çıkmak, пере- karşıya geçmek, под- yaklaşmak, за- uğramak.","uses":["Varış ve ayrılışı anlatmak","Girme, çıkma, geçme, yaklaşma","Yol tarifi"],"sections":[{"kind":"other","title":"при- / у-: gelmek / ayrılmak","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Önek + идти / ехать","en":"Приставочный глагол","role":"v"},{"tr":"Yön","en":"Направление","role":"o"}],"examples":[{"text":"[s:Он] [v:пришёл] [o:домой].","reading":"On prishol domoy.","tr":"Eve geldi."},{"text":"[s:Она] [v:ушла] [o:на работу].","reading":"Ona ushla na rabotu.","tr":"İşe gitti (evden çıktı)."}]},{"kind":"other","title":"в- / вы-: girmek / çıkmak","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"в- / вы- + fiil","en":"Приставочный глагол","role":"v"},{"tr":"в / из","en":"Предлог","role":"x"},{"tr":"Yer","en":"Место","role":"o"}],"examples":[{"text":"[s:Мы] [v:вошли] [x:в] [o:комнату].","reading":"My voshli v komnatu.","tr":"Odaya girdik."},{"text":"[s:Он] [v:вышел] [x:из] [o:дома].","reading":"On vyshel iz doma.","tr":"Evden çıktı."}]},{"kind":"other","title":"пере- / под-: geçmek / yaklaşmak","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"пере- / под- + fiil","en":"Приставочный глагол","role":"v"},{"tr":"через / к","en":"Предлог","role":"x"},{"tr":"Yer","en":"Место","role":"o"}],"examples":[{"text":"[s:Мы] [v:перешли] [x:через] [o:улицу].","reading":"My pereshli cherez ulitsu.","tr":"Caddenin karşısına geçtik."},{"text":"[s:Автобус] [v:подъехал] [x:к] [o:остановке].","reading":"Avtobus pod'yekhal k ostanovke.","tr":"Otobüs durağa yanaştı."}]},{"kind":"other","title":"за- / до-: uğramak / varmak","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"за- / до- + fiil","en":"Приставочный глагол","role":"v"},{"tr":"в / до","en":"Предлог","role":"x"},{"tr":"Yer","en":"Место","role":"o"}],"examples":[{"text":"[s:Я] [v:зайду] [x:в] [o:магазин].","reading":"Ya zaydu v magazin.","tr":"Mağazaya uğrayacağım."},{"text":"[q:Как] [v:доехать] [x:до] [o:центра]?","reading":"Kak doyekhat' do tsentra?","tr":"Merkeze nasıl gidilir?"}]}],"rules":["идти önek alınca -йти olur: прийти, уйти, войти, выйти; süren çifti -ходить: приходить – прийти.","ехать önek alınca çifti -езжать olur: приезжать – приехать.","Önekli fiillerde tek yön / çift yön farkı kalkar, sadece görünüş farkı kalır."],"exceptions":[],"mistakes":[{"wrong":"Он приидёт.","right":"Он придёт.","note":"при + идти → прийти, придёт."},{"wrong":"Я приездил вчера.","right":"Я приехал вчера.","note":"Tek seferlik varış приехать; ездить önek almaz."},{"wrong":"Он вышел с дома.","right":"Он вышел из дома.","note":"в ile girilen yerden из ile çıkılır."}]}},
  {"id":"ru-gr-skloneniye-prilagatelnykh","languageId":"ru","category":"grammar","level":"B1","sourceText":"Склонение прилагательных","translations":{"tr":["Sıfat çekimi"]},"details":{"reading":"Sklonéniye prilagátel'nykh"},"grammar":{"summary":"Sıfat, nitelediği ismin hâline göre de çekilir; ekleri isim eklerinden farklıdır.","uses":["Hâl almış isimleri nitelemek","Edatlı yapılarda sıfat kullanmak"],"sections":[{"kind":"other","title":"Eril / nötr ekler","formula":[{"tr":"Sıfat (ek)","en":"Прилагательное","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[x:нового] [o:друга], [x:новому] [o:другу], [x:с новым] [o:другом], [x:о новом] [o:друге]","reading":"novovo druga, novomu drugu, s novym drugom, o novom druge","tr":"yeni arkadaşın / -ı, -a, -la, hakkında"}],"notes":["-ого (-in / -i), -ому (-e), -ым (araç), -ом (-de)."]},{"kind":"other","title":"Dişil ekler","formula":[{"tr":"Sıfat (ek)","en":"Прилагательное","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[x:новую] [o:книгу], [x:в новой] [o:книге], [x:с новой] [o:книгой]","reading":"novuyu knigu, v novoy knige, s novoy knigoy","tr":"yeni kitabı, yeni kitapta, yeni kitapla"}],"notes":["-ую (-i hâli), diğer tüm hâllerde -ой."]},{"kind":"other","title":"Çoğul ekler","formula":[{"tr":"Sıfat (ek)","en":"Прилагательное","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[x:новых] [o:книг], [x:новым] [o:книгам], [x:новыми] [o:книгами], [x:о новых] [o:книгах]","reading":"novykh knig, novym knigam, novymi knigami, o novykh knigakh","tr":"yeni kitapların, -a, -la, hakkında"}]},{"kind":"other","title":"Cümle içinde","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Edat","en":"Предлог","role":"x"},{"tr":"Sıfat + isim","en":"Словосочетание","role":"o"}],"examples":[{"text":"[s:Я] [v:живу] [x:в] [o:большом городе].","reading":"Ya zhivu v bol'shom gorode.","tr":"Büyük bir şehirde yaşıyorum."},{"text":"[s:Я] [v:говорил] [x:с] [o:новым учителем].","reading":"Ya govoril s novym uchitelem.","tr":"Yeni öğretmenle konuştum."}]}],"rules":["-ого / -его eklerinde г \"v\" okunur: нового (novovo).","Yumuşak sıfatlar (синий, летний) -его, -ему, -ей alır.","ж, ш, ч, щ sonrasında vurgusuz о → е: хорошего, хорошему."],"exceptions":[],"mistakes":[{"wrong":"в большой городе","right":"в большом городе","note":"Eril -de hâlinde sıfat -ом alır."},{"wrong":"Я вижу новая машина.","right":"Я вижу новую машину.","note":"Hem sıfat hem isim -i hâline girer."},{"wrong":"с хорошими друзьям","right":"с хорошими друзьями","note":"Çoğul araç hâli -ами / -ями."}]}},
  {"id":"ru-gr-skloneniye-sushchestvitelnykh-vo-mnozhestvennom-chisle","languageId":"ru","category":"grammar","level":"B1","sourceText":"Склонение существительных во множественном числе","translations":{"tr":["Çoğul isim çekimi"]},"details":{"reading":"Sklonéniye sushchestvítel'nykh vo mnózhestvennom chislé"},"grammar":{"summary":"Çoğulda -e hâli -ам, araç hâli -ами, -de hâli -ах tüm cinsiyetlerde ortaktır; en zoru -in hâli çoğuldur.","uses":["Çoğul isimleri hâllere sokmak","Sayı ve miktar sözcükleriyle çoğul -in hâli"],"sections":[{"kind":"other","title":"Ortak ekler: -ам, -ами, -ах","formula":[{"tr":"Edat","en":"Предлог","role":"x"},{"tr":"İsim (çoğul)","en":"Множественное число","role":"o"}],"examples":[{"text":"[x:к] [o:друзьям], [x:с] [o:друзьями], [x:о] [o:друзьях]","reading":"k druz'yam, s druz'yami, o druz'yakh","tr":"arkadaşlara, arkadaşlarla, arkadaşlar hakkında"},{"text":"[s:Мы] [v:гуляли] [x:по] [o:улицам].","reading":"My gulyali po ulitsam.","tr":"Sokaklarda dolaştık."}]},{"kind":"other","title":"-in hâli çoğul: -ов / -ев / -ей","formula":[{"tr":"Miktar","en":"Количество","role":"x"},{"tr":"İsim (-in, çoğul)","en":"Род. п., мн. ч.","role":"o"}],"examples":[{"text":"[x:много] [o:студентов], [x:пять] [o:музеев], [x:нет] [o:словарей]","reading":"mnogo studentov, pyat' muzeyev, net slovarey","tr":"çok öğrenci, beş müze, sözlük yok"}]},{"kind":"other","title":"-in hâli çoğul: eksiz","formula":[{"tr":"Miktar","en":"Количество","role":"x"},{"tr":"İsim (eksiz)","en":"Нулевое окончание","role":"o"}],"examples":[{"text":"[x:много] [o:книг], [x:пять] [o:окон], [x:нет] [o:мест]","reading":"mnogo knig, pyat' okon, net mest","tr":"çok kitap, beş pencere, yer yok"}],"notes":["-а / -я ve -о ile bitenlerde ek düşer; gerekirse araya о / е girer: окно → окон, девушка → девушек."]},{"kind":"other","title":"Canlı çoğul nesne","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Canlı nesne (= -in hâli)","en":"Винительный = родительный","role":"o"}],"examples":[{"text":"[s:Я] [v:вижу] [o:студентов]. / [s:Я] [v:вижу] [o:столы].","reading":"Ya vizhu studentov. / Ya vizhu stoly.","tr":"Öğrencileri görüyorum. / Masaları görüyorum."}]}],"rules":["Dişil ve nötr isimlerin -in hâli çoğulu çoğunlukla eksizdir: мам, слов.","-ж, -ш, -ч, -щ, -ь ile bitenler -ей alır: врачей, ночей.","Canlı çoğul nesnede -i hâli, -in hâliyle aynıdır."],"exceptions":["люди → людей, дети → детей, деньги → денег; sayıyla человек değişmez: пять человек."],"mistakes":[{"wrong":"много книгов","right":"много книг","note":"-а ile biten isimler -in çoğulda ek almaz."},{"wrong":"Я вижу студенты.","right":"Я вижу студентов.","note":"Canlı çoğul nesne -ов alır."},{"wrong":"пять человеков","right":"пять человек","note":"Sayıyla человек değişmez."}]}},
  {"id":"ru-gr-prevoskhodnaya-stepen","languageId":"ru","category":"grammar","level":"B1","sourceText":"Превосходная степень","translations":{"tr":["Üstünlük derecesi (en …)"]},"details":{"reading":"Prevoskhódnaya stépen'"},"grammar":{"summary":"En üstün derece самый + sıfat ile ya da yazı dilinde -ейший / -айший ekiyle yapılır.","uses":["Bir şeyin \"en …\" olduğunu söylemek","Herkesten / her şeyden daha … demek"],"sections":[{"kind":"other","title":"самый + sıfat","formula":[{"tr":"самый / самая…","en":"самый","role":"x"},{"tr":"Sıfat","en":"Прилагательное","role":"o"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[s:Это] [x:самый] [o:высокий дом] в городе.","reading":"Eto samyy vysokiy dom v gorode.","tr":"Bu, şehrin en yüksek binası."},{"text":"[s:Байкал] — [x:самое] [o:глубокое озеро] в мире.","reading":"Baykal — samoye glubokoye ozero v mire.","tr":"Baykal dünyanın en derin gölü."}]},{"kind":"other","title":"Karşılaştırma + всех / всего","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Karşılaştırma","en":"Сравнительная степень","role":"o"},{"tr":"всех / всего","en":"всех / всего","role":"x"}],"examples":[{"text":"[s:Он] [v:бегает] [o:быстрее] [x:всех].","reading":"On begayet bystreye vsekh.","tr":"Herkesten hızlı koşar."},{"text":"[o:Больше] [x:всего] [s:я] [v:люблю] [o:чай].","reading":"Bol'she vsego ya lyublyu chay.","tr":"En çok çayı severim."}]},{"kind":"other","title":"лучший / худший","formula":[{"tr":"лучший / худший","en":"лучший / худший","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[s:Это] [x:лучший] [o:ресторан] в городе.","reading":"Eto luchshiy restoran v gorode.","tr":"Bu, şehrin en iyi restoranı."}]},{"kind":"other","title":"-ейший / -айший (yazı dili)","formula":[{"tr":"Sıfat + -ейший","en":"Превосходная степень","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[x:интереснейшая] [o:книга], [x:важнейший] [o:вопрос], [x:величайший] [o:писатель]","reading":"interesneyshaya kniga, vazhneyshiy vopros, velichayshiy pisatel'","tr":"son derece ilginç kitap, en önemli soru, en büyük yazar"}]}],"rules":["самый sıfat gibi çekilir: в самом центре, самую дорогую.","всех = herkesten, всего = her şeyden.","лучший / худший tek başına \"en iyi / en kötü\" anlamı verir; самый лучший günlük dilde de yaygındır."],"exceptions":[],"mistakes":[{"wrong":"самый лучше","right":"самый лучший","note":"самый sıfatla kullanılır, karşılaştırma biçimiyle değil."},{"wrong":"в самый центре","right":"в самом центре","note":"самый da hâle göre çekilir."}]}},
  {"id":"ru-gr-vid-glagola-v-proshedshem-vremeni-i-imperative","languageId":"ru","category":"grammar","level":"B1","sourceText":"Вид глагола в прошедшем времени и императиве","translations":{"tr":["Görünüş kullanımı: geçmiş zaman ve emir"]},"details":{"reading":"Vid glagóla v proshédshem vrémeni i imperatíve"},"grammar":{"summary":"Geçmişte sonuç ve ardışık eylemler СВ, süreç, tekrar ve \"yapıldı mı?\" sorusu НСВ ile verilir; emirde de benzer ayrım vardır.","uses":["Ardışık ve eş zamanlı eylemleri anlatmak","Kesilen süreçleri anlatmak","Kibar rica ve davet"],"sections":[{"kind":"other","title":"Ardışık eylemler → СВ","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil СВ, fiil СВ…","en":"Совершенный вид","role":"v"}],"examples":[{"text":"[s:Он] [v:пришёл], [v:поужинал] и [v:лёг] спать.","reading":"On prishol, pouzhinal i lyog spat'.","tr":"Geldi, akşam yemeğini yedi ve yattı."}]},{"kind":"other","title":"Eş zamanlı eylemler → НСВ","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil НСВ","en":"Несовершенный вид","role":"v"},{"tr":"а / и","en":"Союз","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil НСВ","en":"Несовершенный вид","role":"v"}],"examples":[{"text":"[s:Я] [v:читал], [x:а] [s:она] [v:смотрела] [o:телевизор].","reading":"Ya chital, a ona smotrela televizor.","tr":"Ben okuyordum, o da televizyon izliyordu."}]},{"kind":"other","title":"Süreç kesiliyor: НСВ + СВ","formula":[{"tr":"Когда","en":"Когда","role":"x"},{"tr":"Süreç (НСВ)","en":"НСВ","role":"v"},{"tr":"Olay (СВ)","en":"СВ","role":"v"}],"examples":[{"text":"[x:Когда] [s:я] [v:шёл] домой, [v:начался] [s:дождь].","reading":"Kogda ya shol domoy, nachalsya dozhd'.","tr":"Eve giderken yağmur başladı."}]},{"kind":"question","title":"Yapıldı mı? → НСВ","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"уже","en":"уже","role":"x"},{"tr":"Fiil НСВ?","en":"Несовершенный вид","role":"v"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Вы] [x:уже] [v:смотрели] [o:этот фильм]?","reading":"Vy uzhe smotreli etot fil'm?","tr":"Bu filmi izlediniz mi?"}]},{"kind":"other","title":"Emir: СВ rica, НСВ davet","formula":[{"tr":"Emir (СВ / НСВ)","en":"Императив","role":"v"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[v:Закройте], пожалуйста, [o:окно].","reading":"Zakroyte, pozhaluysta, okno.","tr":"Pencereyi kapatır mısınız lütfen."},{"text":"[v:Входите], [v:садитесь]!","reading":"Vkhodite, sadites'!","tr":"Buyurun girin, oturun!"}]}],"rules":["Eylemin hiç yapılmadığı НСВ ile söylenir: Я не звонил (hiç aramadım).","Не позвонил = beklenen arama gerçekleşmedi.","Kibar davette (girin, oturun, alın) НСВ emir kullanılır."],"exceptions":[],"mistakes":[{"wrong":"Я каждый день позвонил маме.","right":"Я каждый день звонил маме.","note":"Tekrar eden eylem НСВ ile."},{"wrong":"Не закройте окно!","right":"Не закрывайте окно!","note":"Olumsuz emirde НСВ."}]}},
  {"id":"ru-gr-uslovnoye-nakloneniye-by","languageId":"ru","category":"grammar","level":"B1","sourceText":"Условное наклонение (бы)","translations":{"tr":["Şart kipi (бы)"]},"details":{"reading":"Uslóvnoye naklonéniye (by)"},"grammar":{"summary":"Geçmiş zaman biçimi + бы gerçek dışı durumları, dilekleri ve kibar istekleri anlatır; zamana bağlı değildir.","uses":["Gerçek dışı şart: если бы","Dilek ve kibar istek: хотел бы","Tavsiye: на твоём месте я бы…"],"sections":[{"kind":"other","title":"Gerçek dışı şart: если бы","formula":[{"tr":"Если бы","en":"Если бы","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil (geçmiş)","en":"Глагол (прош. вр.)","role":"v"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"бы","en":"бы","role":"a"},{"tr":"Fiil (geçmiş)","en":"Глагол (прош. вр.)","role":"v"}],"examples":[{"text":"[x:Если бы] [s:я] [v:знал], [s:я] [a:бы] [v:сказал].","reading":"Yesli by ya znal, ya by skazal.","tr":"Bilseydim söylerdim."},{"text":"[x:Если бы] [x:у меня] [v:было] [s:время], [s:я] [a:бы] [v:поехал] [o:на море].","reading":"Yesli by u menya bylo vremya, ya by poyekhal na more.","tr":"Vaktim olsaydı denize giderdim."}]},{"kind":"other","title":"Dilek ve kibar istek","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"хотел(а) бы","en":"хотел бы","role":"v"},{"tr":"İstenen","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Я] [v:хотел] [a:бы] [o:кофе].","reading":"Ya khotel by kofe.","tr":"Kahve isterdim."},{"text":"[s:Я] [v:хотела] [a:бы] [v:поехать] [o:в Россию].","reading":"Ya khotela by poyekhat' v Rossiyu.","tr":"Rusya'ya gitmek isterdim."}]},{"kind":"other","title":"Tavsiye","formula":[{"tr":"На твоём месте","en":"На твоём месте","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"бы","en":"бы","role":"a"},{"tr":"Fiil (geçmiş)","en":"Глагол (прош. вр.)","role":"v"}],"examples":[{"text":"[x:На твоём месте] [s:я] [a:бы] [v:отдохнул].","reading":"Na tvoyom meste ya by otdokhnul.","tr":"Senin yerinde olsam dinlenirdim."}]},{"kind":"other","title":"Gerçek şart (бы olmadan)","formula":[{"tr":"Если","en":"Если","role":"x"},{"tr":"Fiil (gelecek)","en":"Глагол (буд. вр.)","role":"v"},{"tr":"Sonuç (gelecek)","en":"Главное предложение","role":"o"}],"examples":[{"text":"[x:Если] [v:будет] [s:дождь], [s:мы] [v:останемся] [o:дома].","reading":"Yesli budet dozhd', my ostanemsya doma.","tr":"Yağmur yağarsa evde kalırız."}]}],"rules":["бы her zaman geçmiş zaman biçimiyle gelir: был бы, сделала бы.","Zaman bağlamdan anlaşılır: Если бы я знал = bilseydim / bilsem.","Gerçekleşebilecek şartta бы kullanılmaz; если + gelecek zaman."],"exceptions":[],"mistakes":[{"wrong":"Если бы я знаю, я бы скажу.","right":"Если бы я знал, я бы сказал.","note":"бы ile geçmiş biçim kullanılır."},{"wrong":"Если будет дождь, мы бы остались.","right":"Если будет дождь, мы останемся.","note":"Gerçek olasılıkta бы kullanılmaz."}]}},
  {"id":"ru-gr-otnositelnyye-predlozheniya-s-kotoryy","languageId":"ru","category":"grammar","level":"B1","sourceText":"Относительные предложения с «который»","translations":{"tr":["İlgi cümlesi: который"]},"details":{"reading":"Otnosítel'nyye predlozhéniya s «kotóryy»"},"grammar":{"summary":"который \"-en / -dığı\" anlamı verir; cinsiyet ve sayıyı önceki isimden, hâli kendi cümlesindeki görevinden alır.","uses":["İsmi bir cümleyle nitelemek","Türkçedeki -en / -dığı yapılarını kurmak"],"sections":[{"kind":"other","title":"Yalın hâl (özne)","formula":[{"tr":"İsim","en":"Существительное","role":"o"},{"tr":"который (yalın)","en":"который (им. п.)","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"}],"examples":[{"text":"Это [o:девушка], [s:которая] [v:живёт] [x:рядом].","reading":"Eto devushka, kotoraya zhivyot ryadom.","tr":"Bu yanımızda oturan kız."}]},{"kind":"other","title":"-i hâli (nesne)","formula":[{"tr":"İsim","en":"Существительное","role":"o"},{"tr":"которую / который…","en":"который (вин. п.)","role":"o"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"}],"examples":[{"text":"Это [o:книга], [o:которую] [s:я] [v:читаю].","reading":"Eto kniga, kotoruyu ya chitayu.","tr":"Bu okuduğum kitap."}]},{"kind":"other","title":"Edatla","formula":[{"tr":"İsim","en":"Существительное","role":"o"},{"tr":"Edat + который","en":"Предлог + который","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"}],"examples":[{"text":"Это [o:город], [x:в котором] [s:я] [v:родился].","reading":"Eto gorod, v kotorom ya rodilsya.","tr":"Bu doğduğum şehir."},{"text":"Это [o:друг], [x:с которым] [s:я] [v:работаю].","reading":"Eto drug, s kotorym ya rabotayu.","tr":"Bu birlikte çalıştığım arkadaş."}]},{"kind":"other","title":"Sahiplik: … которого","formula":[{"tr":"İsim","en":"Существительное","role":"o"},{"tr":"İsim + которого","en":"Существительное + которого","role":"x"},{"tr":"Fiil","en":"Глагол","role":"v"}],"examples":[{"text":"Это [o:студент], [x:отец которого] [v:работает] в банке.","reading":"Eto student, otets kotorogo rabotayet v banke.","tr":"Bu, babası bankada çalışan öğrenci."}]}],"rules":["который önünde her zaman virgül olur.","Cinsiyet / sayı önceki isimden, hâl ilgi cümlesindeki görevden gelir.","Sahiplikte который ismin arkasına gelir: отец которого."],"exceptions":[],"mistakes":[{"wrong":"Книга, который я читаю…","right":"Книга, которую я читаю…","note":"книга dişil ve okunan nesne → которую."},{"wrong":"Это город, который я родился.","right":"Это город, в котором я родился.","note":"Edat ve hâl ilgi cümlesine göre seçilir."}]}},
  {"id":"ru-gr-kosvennaya-rech","languageId":"ru","category":"grammar","level":"B1","sourceText":"Косвенная речь","translations":{"tr":["Dolaylı anlatım"]},"details":{"reading":"Kosvénnaya rech'"},"grammar":{"summary":"Aktarılan söz что, ли, soru kelimesi ya da чтобы ile bağlanır; zaman kayması yoktur.","uses":["Birinin söylediğini aktarmak","Soruları aktarmak (-ip -mediğini)","Emir ve ricaları aktarmak"],"sections":[{"kind":"other","title":"Bildirim: что","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"сказать / говорить","en":"Глагол речи","role":"v"},{"tr":"что","en":"Союз что","role":"x"},{"tr":"Aktarılan cümle","en":"Придаточное предложение","role":"o"}],"examples":[{"text":"[s:Он] [v:сказал], [x:что] [o:устал].","reading":"On skazal, chto ustal.","tr":"Yorulduğunu söyledi."},{"text":"[s:Она] [v:говорит], [x:что] [o:придёт завтра].","reading":"Ona govorit, chto pridyot zavtra.","tr":"Yarın geleceğini söylüyor."}]},{"kind":"other","title":"Evet/hayır sorusu: ли","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"спросить","en":"спросить","role":"v"},{"tr":"Sorulan kelime + ли","en":"Частица ли","role":"x"},{"tr":"Cümlenin geri kalanı","en":"Придаточное предложение","role":"o"}],"examples":[{"text":"[s:Он] [v:спросил], [x:знаю ли] [o:я адрес].","reading":"On sprosil, znayu li ya adres.","tr":"Adresi bilip bilmediğimi sordu."}]},{"kind":"other","title":"Soru kelimesiyle","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Soru kelimesi","en":"Вопросительное слово","role":"q"},{"tr":"Aktarılan cümle","en":"Придаточное предложение","role":"o"}],"examples":[{"text":"[s:Я] [a:не] [v:знаю], [q:где] [o:он живёт].","reading":"Ya ne znayu, gde on zhivyot.","tr":"Nerede yaşadığını bilmiyorum."}]},{"kind":"other","title":"Emir / rica: чтобы","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"чтобы","en":"чтобы","role":"x"},{"tr":"Özne + fiil (geçmiş)","en":"Придаточное предложение","role":"o"}],"examples":[{"text":"[s:Мама] [v:сказала], [x:чтобы] [o:я позвонил].","reading":"Mama skazala, chtoby ya pozvonil.","tr":"Annem aramamı söyledi."}]}],"rules":["Zaman kayması yoktur: «Я устал» → Он сказал, что устал; «Я приду» → Он сказал, что придёт.","ли sorulan kelimenin (genelde fiilin) hemen arkasına gelir.","Zamirler konuşana göre değişir: «Я устал» → Он сказал, что (он) устал."],"exceptions":[],"mistakes":[{"wrong":"Он спросил, если я знаю адрес.","right":"Он спросил, знаю ли я адрес.","note":"\"-ip -mediği\" sorusu если ile değil ли ile kurulur."},{"wrong":"Мама сказала, что я позвонил.","right":"Мама сказала, чтобы я позвонил.","note":"Emir aktarılırken чтобы + geçmiş biçim kullanılır."}]}},
  {"id":"ru-gr-soyuz-chtoby","languageId":"ru","category":"grammar","level":"B1","sourceText":"Союз «чтобы»","translations":{"tr":["Amaç ve istek: чтобы"]},"details":{"reading":"Soyúz «chtóby»"},"grammar":{"summary":"чтобы \"için / -mesi için\" anlamı verir: özne aynıysa mastar, farklıysa geçmiş zaman biçimi gelir.","uses":["Amaç bildirmek","Başkasından bir şey istemek (хочу, чтобы…)"],"sections":[{"kind":"other","title":"Aynı özne: чтобы + mastar","formula":[{"tr":"Ana cümle","en":"Главное предложение","role":"o"},{"tr":"чтобы","en":"чтобы","role":"x"},{"tr":"Mastar","en":"Инфинитив","role":"v"}],"examples":[{"text":"[s:Я] [v:учу] [o:русский], [x:чтобы] [v:работать] [o:в Москве].","reading":"Ya uchu russkiy, chtoby rabotat' v Moskve.","tr":"Moskova'da çalışmak için Rusça öğreniyorum."}]},{"kind":"other","title":"Farklı özne: чтобы + geçmiş biçim","formula":[{"tr":"Ana cümle","en":"Главное предложение","role":"o"},{"tr":"чтобы","en":"чтобы","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil (geçmiş biçim)","en":"Глагол (прош. форма)","role":"v"}],"examples":[{"text":"[s:Я] [v:хочу], [x:чтобы] [s:ты] [v:пришёл].","reading":"Ya khochu, chtoby ty prishol.","tr":"Gelmeni istiyorum."},{"text":"[v:Говори] громче, [x:чтобы] [s:все] [v:слышали].","reading":"Govori gromche, chtoby vse slyshali.","tr":"Herkes duysun diye yüksek sesle konuş."}]},{"kind":"other","title":"Hareket fiilinden sonra düz mastar","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Hareket fiili","en":"Глагол движения","role":"v"},{"tr":"Mastar (amaç)","en":"Инфинитив цели","role":"o"}],"examples":[{"text":"[s:Я] [v:пришёл] [o:помочь тебе].","reading":"Ya prishol pomoch' tebe.","tr":"Sana yardım etmeye geldim."}]}],"rules":["хотеть + başka özne → хочу, чтобы ты… (хочу ты ✗).","Farklı özneli чтобы cümlesinde fiil hep geçmiş biçimdedir, anlamı şimdi veya gelecektir.","чтобы önünde virgül olur."],"exceptions":[],"mistakes":[{"wrong":"Я хочу, что ты пришёл.","right":"Я хочу, чтобы ты пришёл.","note":"İstek ve amaç чтобы ile kurulur."},{"wrong":"Я хочу, чтобы ты придёшь.","right":"Я хочу, чтобы ты пришёл.","note":"чтобы + geçmiş biçim."}]}},
  {"id":"ru-gr-vozvratnoye-mestoimeniye-sebya-i-svoy","languageId":"ru","category":"grammar","level":"B1","sourceText":"Возвратное местоимение «себя» и «свой»","translations":{"tr":["Dönüşlü zamirler: себя ve свой"]},"details":{"reading":"Vozvrátnoye mestoiméniye «sebyá» i «svoy»"},"grammar":{"summary":"себя \"kendi(si)ni\", свой \"kendi\" demektir; ikisi de cümlenin öznesine geri döner.","uses":["Öznenin kendisine yönelen eylem","Öznenin kendine ait olanı belirtmek","Kalıplar: чувствовать себя, с собой"],"sections":[{"kind":"other","title":"себя","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"себя (çekimli)","en":"Возвратное местоимение","role":"x"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Он] [v:купил] [x:себе] [o:машину].","reading":"On kupil sebe mashinu.","tr":"Kendine araba aldı."},{"text":"[s:Она] [v:думает] [x:только о себе].","reading":"Ona dumayet tol'ko o sebe.","tr":"Sadece kendini düşünüyor."}]},{"kind":"other","title":"свой: özneye ait","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"свой / своя…","en":"Возвратно-притяжательное местоимение","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[s:Иван] [v:любит] [x:свою] [o:жену].","reading":"Ivan lyubit svoyu zhenu.","tr":"İvan karısını (kendi karısını) seviyor."}]},{"kind":"other","title":"свой ve его farkı","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"свой / его","en":"свой / его","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"}],"examples":[{"text":"[s:Иван] [v:взял] [x:свою] [o:книгу]. / [s:Иван] [v:взял] [x:его] [o:книгу].","reading":"Ivan vzyal svoyu knigu. / Ivan vzyal yevo knigu.","tr":"İvan kendi kitabını aldı. / İvan onun (başkasının) kitabını aldı."}]},{"kind":"other","title":"Kalıplar","formula":[{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"себя / с собой","en":"себя","role":"x"},{"tr":"Tümleç","en":"Обстоятельство","role":"o"}],"examples":[{"text":"[s:Я] [v:чувствую] [x:себя] [o:хорошо].","reading":"Ya chuvstvuyu sebya khorosho.","tr":"Kendimi iyi hissediyorum."},{"text":"[s:Я] [v:взял] [o:зонт] [x:с собой].","reading":"Ya vzyal zont s soboy.","tr":"Şemsiyeyi yanıma aldım."}]}],"rules":["себя'nın yalın hâli yoktur: себя, себе, собой, о себе.","3. kişide свой zorunludur; его / её başka birini gösterir.","свой özneyi nitelemez: Мой брат живёт здесь ✓, Свой брат ✗."],"exceptions":[],"mistakes":[{"wrong":"Он любит его жену. (kendi karısı)","right":"Он любит свою жену.","note":"Öznenin kendisine ait olan için свой."},{"wrong":"Как ты чувствуешь?","right":"Как ты себя чувствуешь?","note":"чувствовать себя kalıbı."},{"wrong":"Свой брат живёт здесь.","right":"Мой брат живёт здесь.","note":"свой özne konumunda kullanılmaz."}]}},
  {"id":"ru-gr-neopredelyonnyye-mestoimeniya-to-nibud","languageId":"ru","category":"grammar","level":"B1","sourceText":"Неопределённые местоимения (-то, -нибудь)","translations":{"tr":["Belgisiz zamirler: -то, -нибудь"]},"details":{"reading":"Neopredelyónnyye mestoiméniya (-to, -nibud')"},"grammar":{"summary":"-то \"belli ama bilinmeyen\" bir şeyi, -нибудь \"herhangi biri, fark etmez\" anlamını verir.","uses":["Kim / ne olduğu bilinmeyen biri veya bir şey","Sorularda ve isteklerde \"herhangi bir\"","Hiç …-dın mı? soruları (когда-нибудь)"],"sections":[{"kind":"other","title":"-то: var ama bilinmiyor","formula":[{"tr":"Zamir + -то","en":"Местоимение с -то","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Кто-то] [v:звонил] [o:тебе].","reading":"Kto-to zvonil tebe.","tr":"Biri seni aradı."},{"text":"[s:Он] [v:сказал] [o:что-то], но я не понял.","reading":"On skazal chto-to, no ya ne ponyal.","tr":"Bir şey söyledi ama anlamadım."}]},{"kind":"other","title":"-нибудь: herhangi biri (soru, emir, gelecek)","formula":[{"tr":"Zamir + -нибудь","en":"Местоимение с -нибудь","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Nesne","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Кто-нибудь] [v:знает] [o:ответ]?","reading":"Kto-nibud' znayet otvet?","tr":"Cevabı bilen var mı?"},{"text":"[v:Купи] [o:что-нибудь] поесть.","reading":"Kupi chto-nibud' poyest'.","tr":"Yiyecek bir şey al."}]},{"kind":"other","title":"Zarflar: где-то, когда-нибудь","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"где-то / когда-нибудь…","en":"Наречие","role":"x"}],"examples":[{"text":"[s:Я] [v:видел] [o:его] [x:где-то].","reading":"Ya videl yevo gde-to.","tr":"Onu bir yerde gördüm."},{"text":"[s:Ты] [x:когда-нибудь] [v:был] [o:в России]?","reading":"Ty kogda-nibud' byl v Rossii?","tr":"Hiç Rusya'da bulundun mu?"}]}],"rules":["Geçmiş zamanlı olumlu cümlede genelde -то: Кто-то пришёл.","Soru, emir, gelecek ve tekrarda genelde -нибудь: Позвони кому-нибудь.","Kısa çizgiyle yazılır ve zamir kısmı çekilir: кому-то, с кем-нибудь."],"exceptions":[],"mistakes":[{"wrong":"Вчера кто-нибудь пришёл.","right":"Вчера кто-то пришёл.","note":"Gerçekleşmiş belli bir olay → -то."},{"wrong":"Кто нибудь","right":"Кто-нибудь","note":"Kısa çizgi zorunludur."}]}},
  {"id":"ru-gr-otritsatelnyye-mestoimeniya","languageId":"ru","category":"grammar","level":"B1","sourceText":"Отрицательные местоимения","translations":{"tr":["Olumsuz zamirler: никто, ничего"]},"details":{"reading":"Otritsátel'nyye mestoiméniya"},"grammar":{"summary":"никто, ничего, никогда, нигде fiildeki не ile birlikte kullanılır; çift olumsuzluk zorunludur.","uses":["Kimse, hiçbir şey, hiçbir zaman, hiçbir yerde demek","нечего / некого: yapacak bir şey / kimse yok"],"sections":[{"kind":"negative","title":"ни- zamiri + не + fiil","formula":[{"tr":"ни- zamiri","en":"Отрицательное местоимение","role":"s"},{"tr":"не","en":"не","role":"a"},{"tr":"Fiil","en":"Глагол","role":"v"}],"examples":[{"text":"[s:Никто] [a:не] [v:пришёл].","reading":"Nikto ne prishol.","tr":"Kimse gelmedi."},{"text":"[s:Я] [o:ничего] [a:не] [v:знаю].","reading":"Ya nichego ne znayu.","tr":"Hiçbir şey bilmiyorum."}]},{"kind":"other","title":"Zarflar: никогда, нигде, никуда","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"никогда / нигде…","en":"Отрицательное наречие","role":"x"},{"tr":"не","en":"не","role":"a"},{"tr":"Fiil","en":"Глагол","role":"v"}],"examples":[{"text":"[s:Я] [x:никогда] [a:не] [v:был] [o:в Сибири].","reading":"Ya nikogda ne byl v Sibiri.","tr":"Sibirya'da hiç bulunmadım."},{"text":"[s:Он] [x:никуда] [a:не] [v:ходит].","reading":"On nikuda ne khodit.","tr":"Hiçbir yere gitmiyor."}]},{"kind":"other","title":"Edatla: ни + edat + zamir","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"ни + edat + zamir","en":"ни + предлог + местоимение","role":"x"},{"tr":"не","en":"не","role":"a"},{"tr":"Fiil","en":"Глагол","role":"v"}],"examples":[{"text":"[s:Я] [x:ни с кем] [a:не] [v:говорил].","reading":"Ya ni s kem ne govoril.","tr":"Kimseyle konuşmadım."},{"text":"[s:Она] [x:ни о чём] [a:не] [v:думает].","reading":"Ona ni o chom ne dumayet.","tr":"Hiçbir şey düşünmüyor."}]},{"kind":"other","title":"нечего / некого + mastar","formula":[{"tr":"Kişi (-e hâli)","en":"Дательный падеж","role":"o"},{"tr":"нечего / некого","en":"нечего / некого","role":"x"},{"tr":"Mastar","en":"Инфинитив","role":"v"}],"examples":[{"text":"[o:Мне] [x:нечего] [v:делать].","reading":"Mne nechego delat'.","tr":"Yapacak bir şeyim yok."},{"text":"[x:Некого] [v:спросить].","reading":"Nekogo sprosit'.","tr":"Soracak kimse yok."}]}],"rules":["ни- zamirleriyle fiile не mutlaka eklenir: Я ничего не знаю.","Edat ни ile zamirin arasına girer: ни с кем, ни о чём.","нечего / некого \"… yok\" anlamı verir; vurgu не üzerindedir ve kişi -e hâlindedir."],"exceptions":[],"mistakes":[{"wrong":"Я знаю ничего.","right":"Я ничего не знаю.","note":"Çift olumsuzluk zorunludur."},{"wrong":"Я не говорил с никем.","right":"Я ни с кем не говорил.","note":"Edat ни ile zamirin arasına girer."},{"wrong":"Я нечего делаю.","right":"Мне нечего делать.","note":"нечего + mastar, kişi -e hâlinde."}]}},
  {"id":"ru-gr-kratkiye-prilagatelnyye","languageId":"ru","category":"grammar","level":"B1","sourceText":"Краткие прилагательные","translations":{"tr":["Kısa sıfatlar"]},"details":{"reading":"Krátkiye prilagátel'nyye"},"grammar":{"summary":"Kısa sıfatlar sadece yüklemde kullanılır; geçici durum ya da kalıplaşmış anlam (рад, должен, готов, занят) bildirir.","uses":["Geçici durum: занят, болен","Kalıplar: рад, должен, готов, согласен, прав","\"Birine göre fazla / az\" anlamı: мал, велик"],"sections":[{"kind":"other","title":"Biçim: - / -а / -о / -ы","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Kısa sıfat","en":"Краткое прилагательное","role":"o"}],"examples":[{"text":"[s:Он] [o:занят]. / [s:Она] [o:занята]. / [s:Мы] [o:заняты].","reading":"On zanyat. / Ona zanyata. / My zanyaty.","tr":"O meşgul. / O (kadın) meşgul. / Biz meşgulüz."}]},{"kind":"other","title":"Kalıplar: рад, должен, готов","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"рад / должен / готов","en":"Краткое прилагательное","role":"a"},{"tr":"Mastar / tümleç","en":"Инфинитив","role":"v"}],"examples":[{"text":"[s:Я] [a:рад] [v:вас видеть].","reading":"Ya rad vas videt'.","tr":"Sizi gördüğüme sevindim."},{"text":"[s:Ты] [a:должен] [v:позвонить].","reading":"Ty dolzhen pozvonit'.","tr":"Araman gerekiyor."}]},{"kind":"other","title":"Durum: прав, болен","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Kısa sıfat","en":"Краткое прилагательное","role":"o"}],"examples":[{"text":"[s:Ты] [o:прав].","reading":"Ty prav.","tr":"Haklısın."},{"text":"[s:Она] [o:больна].","reading":"Ona bol'na.","tr":"O hasta."}]},{"kind":"other","title":"Uzun ve kısa farkı","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Kısa sıfat","en":"Краткое прилагательное","role":"o"},{"tr":"Kişi (-e hâli)","en":"Дательный падеж","role":"o"}],"examples":[{"text":"[s:Эти туфли] [o:малы] [o:мне].","reading":"Eti tufli maly mne.","tr":"Bu ayakkabılar bana küçük."},{"text":"[o:Маленькие] [s:туфли].","reading":"Malen'kiye tufli.","tr":"Küçük ayakkabılar."}]}],"rules":["Kısa sıfat çekilmez; sadece cinsiyet ve sayıya uyar.","должен \"zorunda / -meli\" anlamı verir: должен, должна, должны + mastar.","Geçmiş ve gelecek быть ile: Он был занят. Я буду рад."],"exceptions":[],"mistakes":[{"wrong":"Я радый.","right":"Я рад.","note":"рад sadece kısa biçimde kullanılır."},{"wrong":"Она должен работать.","right":"Она должна работать.","note":"Kısa sıfat cinsiyete uyar."},{"wrong":"Ты правый.","right":"Ты прав.","note":"\"Haklısın\" kısa sıfatla söylenir."}]}}
