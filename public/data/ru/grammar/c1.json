[
  {"id":"ru-gr-bezlichnye-predlozheniya","languageId":"ru","category":"grammar","level":"C1","sourceText":"Безличные предложения","translations":{"tr":["Kişisiz (öznesiz) cümleler"]},"details":{"reading":"Bezlíchnye predlozhéniya"},"grammar":{"summary":"Gramatik öznesi olmayan cümleler; yaşayan kişi yönelme hâlinde, fiil 3. tekil ya da nötr geçmiş biçimdedir.","uses":["Duygu ve bedensel durum: Мне холодно, Ему скучно","Gereklilik ve izin: надо, нужно, можно, нельзя","İstemsiz durum: Мне не спится, Мне хочется","Doğa olayları: Темнеет, Светает"],"sections":[{"kind":"other","title":"Yönelme hâli + durum kelimesi","formula":[{"tr":"Kişi (yönelme)","en":"Дательный падеж","role":"s"},{"tr":"быть (geçmiş/gelecek)","en":"Связка","role":"a"},{"tr":"Durum kelimesi","en":"Слово категории состояния","role":"v"}],"examples":[{"text":"[s:Мне] [v:холодно].","reading":"Mne kholodno.","tr":"Üşüyorum."},{"text":"[s:Ему] [a:было] [v:скучно].","reading":"Yemu bylo skuchno.","tr":"Canı sıkılıyordu."}]},{"kind":"other","title":"Gereklilik + mastar","formula":[{"tr":"Kişi (yönelme)","en":"Дательный падеж","role":"s"},{"tr":"надо / нужно / нельзя","en":"Модальное слово","role":"a"},{"tr":"Mastar","en":"Инфинитив","role":"v"}],"examples":[{"text":"[s:Тебе] [a:надо] [v:отдохнуть].","reading":"Tebe nado otdokhnut'.","tr":"Dinlenmen gerek."}]},{"kind":"other","title":"-ся fiilleri (istemsiz)","formula":[{"tr":"Kişi (yönelme)","en":"Дательный падеж","role":"s"},{"tr":"Fiil + -ся (3. tekil)","en":"Безличный глагол на -ся","role":"v"},{"tr":"Tümleç","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Мне] [x:не] [v:спится].","reading":"Mne ne spitsya.","tr":"Uykum gelmiyor."},{"text":"[s:Мне] [v:хочется] [o:пить].","reading":"Mne khochetsya pit'.","tr":"Canım su içmek istiyor."}]},{"kind":"other","title":"Doğa ve olaylar","formula":[{"tr":"Kişisiz fiil","en":"Безличный глагол","role":"v"},{"tr":"Tümleç","en":"Дополнение","role":"o"}],"examples":[{"text":"[v:Темнеет].","reading":"Temneyet.","tr":"Hava kararıyor."},{"text":"[o:Дорогу] [v:занесло] [o:снегом].","reading":"Dorogu zaneslo snegom.","tr":"Yolu kar kapladı."}]}],"rules":["Geçmişte было, gelecekte будет: Мне было холодно.","Fiil nötr tekil biçimdedir: Мне не хотелось.","Yokluk: нет / не было / не будет + -in hâli: Его не было дома."],"mistakes":[{"wrong":"Я холодно.","right":"Мне холодно.","note":"Durum bildiren yapıda kişi yönelme hâlinde."},{"wrong":"Мне был скучно.","right":"Мне было скучно.","note":"Kişisiz cümlede nötr biçim: было."},{"wrong":"Я не спится.","right":"Мне не спится.","note":"İstemsiz -ся fiilinde kişi yönelme hâlinde."}]}},
  {"id":"ru-gr-skloneniye-chislitelnykh","languageId":"ru","category":"grammar","level":"C1","sourceText":"Склонение числительных","translations":{"tr":["Sayıların çekimi"]},"details":{"reading":"Sklonéniye chislítel'nykh"},"grammar":{"summary":"Rusçada sayılar da hâl alır; ayrıca sayıdan sonraki isim 1, 2–4 ve 5+ kuralına göre biçim değiştirir.","uses":["Edatlı yapılar: с двумя друзьями, о пяти книгах","Tarih, yaş, uzaklık ve fiyat","Resmî ve yazılı metinlerdeki istatistik"],"sections":[{"kind":"other","title":"Yalın hâlde 1, 2–4, 5+","formula":[{"tr":"Sayı","en":"Числительное","role":"x"},{"tr":"İsim (uygun biçim)","en":"Существительное","role":"o"}],"examples":[{"text":"[x:один] [o:дом], [x:два] [o:дома], [x:пять] [o:домов]","reading":"odin dom, dva doma, pyat' domov","tr":"bir ev, iki ev, beş ev"},{"text":"[x:двадцать одна] [o:книга]","reading":"dvadtsat' odna kniga","tr":"yirmi bir kitap"}],"notes":["1 → tekil yalın, 2–4 → tekil -in hâli, 5–20 → çoğul -in hâli."]},{"kind":"other","title":"Diğer hâllerde uyum","formula":[{"tr":"Edat","en":"Предлог","role":"x"},{"tr":"Sayı (hâl)","en":"Числительное в падеже","role":"x"},{"tr":"İsim (çoğul, aynı hâl)","en":"Существительное","role":"o"}],"examples":[{"text":"[s:Я] [v:говорил] [x:с тремя] [o:студентами].","reading":"Ya govoril s tremya studentami.","tr":"Üç öğrenciyle konuştum."},{"text":"[s:Он] [v:живёт] [x:в двадцати] [o:километрах] от города.","reading":"On zhivyot v dvadtsati kilometrakh ot goroda.","tr":"Şehirden yirmi kilometre uzakta yaşıyor."}],"notes":["два: двух, двум, двумя; пять: пяти, пятью; сорок/девяносто/сто: сорока, девяноста, ста."]},{"kind":"other","title":"Tarihler: sıra sayısı","formula":[{"tr":"Gün (sıra, -in hâli)","en":"Порядковое числительное","role":"x"},{"tr":"Ay","en":"Месяц","role":"o"},{"tr":"Yıl (son kelime çekilir)","en":"Год","role":"o"}],"examples":[{"text":"[s:Я] [v:родился] [x:пятого] [o:мая] [o:тысяча девятьсот девяносто пятого года].","reading":"Ya rodilsya pyatogo maya tysyacha devyat'sot devyanosto pyatogo goda.","tr":"5 Mayıs 1995'te doğdum."}],"notes":["Bileşik sıra sayısında yalnızca son kelime çekilir."]}],"rules":["Bileşik asıl sayılarda her kelime çekilir: с двумястами пятьюдесятью рублями.","один ve два cinse göre değişir: одна книга, две книги.","2–4'ten sonra sıfat çoğul -in hâlinde: два новых дома."],"exceptions":["тысяча dişil isim gibi çekilir: с тысячей рублей.","полтора / полторы + tekil -in hâli: полтора часа."],"mistakes":[{"wrong":"пять друга","right":"пять друзей","note":"5 ve üstünde çoğul -in hâli."},{"wrong":"с пять друзьями","right":"с пятью друзьями","note":"Sayı da araç hâline girer."},{"wrong":"два новые дома","right":"два новых дома","note":"Eril/nötr isimde sıfat çoğul -in hâlinde."}]}},
  {"id":"ru-gr-uslovnye-predlozheniya-yesli-i-yesli-by","languageId":"ru","category":"grammar","level":"C1","sourceText":"Условные предложения: если и если бы","translations":{"tr":["Koşul cümleleri: если ve если бы"]},"details":{"reading":"Uslóvnye predlozhéniya: yésli i yésli by"},"grammar":{"summary":"Gerçek koşul если + uygun zamanla; gerçek dışı koşul если бы + geçmiş ve ana cümlede бы + geçmişle kurulur.","uses":["Gerçek ya da olası koşul","Gerçek dışı şimdiki veya geçmiş koşul","Bağlaçsız edebi koşul: Знал бы я…, Не будь…","раз = madem"],"sections":[{"kind":"other","title":"Gerçek koşul","formula":[{"tr":"если","en":"Союз если","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil (gelecek)","en":"Глагол буд. вр.","role":"v"},{"tr":"Ana cümle","en":"Главное предложение","role":"o"}],"examples":[{"text":"[x:Если] [s:ты] [v:придёшь], [o:мы поговорим].","reading":"Yesli ty pridyosh', my pogovorim.","tr":"Gelirsen konuşuruz."}],"notes":["Türkçeden farklı olarak her iki tarafta gelecek zaman."]},{"kind":"other","title":"Gerçek dışı koşul","formula":[{"tr":"если бы","en":"Союз если бы","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil (geçmiş)","en":"Глагол прош. вр.","role":"v"},{"tr":"Ana cümle + бы","en":"Главное предложение с бы","role":"o"}],"examples":[{"text":"[x:Если бы] [s:у меня] [v:было] [s:время], [o:я бы поехал].","reading":"Yesli by u menya bylo vremya, ya by poyekhal.","tr":"Vaktim olsaydı giderdim."}]},{"kind":"other","title":"Bağlaçsız koşul","formula":[{"tr":"Fiil (geçmiş / emir)","en":"Глагол","role":"v"},{"tr":"бы","en":"Частица бы","role":"a"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Ana cümle","en":"Главное предложение","role":"o"}],"examples":[{"text":"[v:Знал] [a:бы] [s:я] раньше, [o:не пришёл бы].","reading":"Znal by ya ran'she, ne prishyol by.","tr":"Önceden bilseydim gelmezdim."},{"text":"[x:Не] [v:будь] [s:тебя], [o:я бы пропал].","reading":"Ne bud' tebya, ya by propal.","tr":"Sen olmasaydın kaybolurdum."}],"notes":["Не будь + yalın hâl = …olmasaydı (edebi)."]}],"rules":["если + gelecek zaman: Если пойдёт дождь… (Yağmur yağarsa…).","если бы yapısında her iki tarafta da geçmiş biçim ve бы bulunur.","Ana cümle başa gelebilir: Я бы поехал, если бы мог."],"exceptions":["раз = madem: Раз ты пришёл, помоги."],"mistakes":[{"wrong":"Если ты приходишь завтра, мы поговорим.","right":"Если ты придёшь завтра, мы поговорим.","note":"Gelecek koşulda gelecek zaman."},{"wrong":"Если бы я знаю, я бы сказал.","right":"Если бы я знал, я бы сказал.","note":"если бы ile geçmiş biçim."},{"wrong":"Если бы у меня было время, я поеду.","right":"Если бы у меня было время, я бы поехал.","note":"Ana cümlede de бы + geçmiş."}]}},
  {"id":"ru-gr-ustupitelnye-konstruktsii","languageId":"ru","category":"grammar","level":"C1","sourceText":"Уступительные конструкции","translations":{"tr":["Karşıtlık yapıları (хотя, несмотря на)"]},"details":{"reading":"Ustupítel'nye konstrúktsii"},"grammar":{"summary":"хотя, несмотря на, как ни, что бы ни gibi yapılarla \"-e rağmen, ne kadar … -sa da\" anlamı verilir.","uses":["Cümleyle: хотя, несмотря на то что","İsimle: несмотря на + belirtme hâli","Genelleme: что бы ни, где бы ни, как бы ни","Çaba: как ни старался"],"sections":[{"kind":"other","title":"хотя + cümle","formula":[{"tr":"хотя","en":"Союз хотя","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"Ana cümle","en":"Главное предложение","role":"o"}],"examples":[{"text":"[x:Хотя] [s:он] [v:устал], [o:он продолжал работать].","reading":"Khotya on ustal, on prodolzhal rabotat'.","tr":"Yorgun olmasına rağmen çalışmaya devam etti."}]},{"kind":"other","title":"несмотря на + isim","formula":[{"tr":"несмотря на","en":"Предлог несмотря на","role":"x"},{"tr":"İsim (belirtme)","en":"Винительный падеж","role":"o"},{"tr":"Ana cümle","en":"Главное предложение","role":"s"}],"examples":[{"text":"[x:Несмотря на] [o:дождь], [s:мы] [v:пошли] гулять.","reading":"Nesmotrya na dozhd', my poshli gulyat'.","tr":"Yağmura rağmen yürüyüşe çıktık."}]},{"kind":"other","title":"Soru kelimesi + бы ни","formula":[{"tr":"Soru kelimesi","en":"Местоимение","role":"q"},{"tr":"бы","en":"Частица бы","role":"a"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"ни","en":"Частица ни","role":"x"},{"tr":"Fiil (geçmiş)","en":"Глагол прош. вр.","role":"v"}],"examples":[{"text":"[q:Что] [a:бы] [s:ты] [x:ни] [v:сказал], я не поверю.","reading":"Chto by ty ni skazal, ya ne poveryu.","tr":"Ne söylersen söyle, inanmam."},{"text":"[q:Где] [a:бы] [s:я] [x:ни] [v:был], я думаю о доме.","reading":"Gde by ya ni byl, ya dumayu o dome.","tr":"Nerede olursam olayım evi düşünürüm."}]},{"kind":"other","title":"как ни + fiil","formula":[{"tr":"как ни","en":"Союзное сочетание","role":"x"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Ana cümle","en":"Главное предложение","role":"o"}],"examples":[{"text":"[x:Как ни] [v:старался] [s:он], [o:ничего не вышло].","reading":"Kak ni staralsya on, nichego ne vyshlo.","tr":"Ne kadar uğraştıysa da bir şey çıkmadı."}]}],"rules":["несмотря на + belirtme hâli; cümleyle несмотря на то что.","бы ni yapılarındaki ни olumsuzluk değil, genelleme bildirir.","Konuşmada хотя cümlesinden sonra но gelebilir: Хотя устал, но работал."],"mistakes":[{"wrong":"Несмотря на дождя…","right":"Несмотря на дождь…","note":"несмотря на belirtme hâli ister."},{"wrong":"Что бы ты не сказал…","right":"Что бы ты ни сказал…","note":"Genellemede ни yazılır."}]}},
  {"id":"ru-gr-neopredelyonnye-mestoimeniya","languageId":"ru","category":"grammar","level":"C1","sourceText":"Неопределённые местоимения","translations":{"tr":["Belirsiz zamirler (-то, -нибудь, кое-)"]},"details":{"reading":"Neopredelyónnye mestoiméniya"},"grammar":{"summary":"-то belirli ama bilinmeyen, -нибудь herhangi biri, кое- konuşanın bildiği ama söylemediği kişi/şeyi bildirir.","uses":["-то: gerçekleşmiş olgular (Кто-то звонил)","-нибудь: soru, emir, gelecek, tekrar (Купи что-нибудь)","кое-: ima ve sır (Я кое-что знаю)","-либо: -нибудь'un resmî karşılığı"],"sections":[{"kind":"other","title":"-то","formula":[{"tr":"Zamir + -то","en":"Местоимение с -то","role":"s"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"Tümleç","en":"Дополнение","role":"o"}],"examples":[{"text":"[s:Кто-то] [v:звонил] [o:тебе].","reading":"Kto-to zvonil tebe.","tr":"Biri seni aradı."}]},{"kind":"other","title":"-нибудь","formula":[{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"Zamir + -нибудь","en":"Местоимение с -нибудь","role":"o"},{"tr":"Tümleç","en":"Дополнение","role":"x"}],"examples":[{"text":"[v:Купи] [o:что-нибудь] [x:на ужин].","reading":"Kupi chto-nibud' na uzhin.","tr":"Akşam yemeği için bir şeyler al."},{"text":"[s:Кто-нибудь] [v:знает] [o:ответ]?","reading":"Kto-nibud' znayet otvet?","tr":"Cevabı bilen var mı?"}]},{"kind":"other","title":"кое-","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"кое- + zamir","en":"Местоимение с кое-","role":"o"}],"examples":[{"text":"[s:Я] [v:хочу] [o:кое-что] тебе сказать.","reading":"Ya khochu koye-chto tebe skazat'.","tr":"Sana bir şey söylemek istiyorum."}]},{"kind":"other","title":"кое- + edat","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"кое + edat + zamir","en":"кое + предлог + местоимение","role":"o"}],"examples":[{"text":"[s:Я] [v:поговорил] [o:кое с кем].","reading":"Ya pogovoril koye s kem.","tr":"Biriyle (adını vermeyeyim) konuştum."}]}],"rules":["Gerçekleşmiş tek olayda -то; soru, emir ve gelecekte -нибудь.","кое- ile edat ortaya girer: кое о чём, кое у кого.","-то ve -нибудь tireyle yazılır."],"mistakes":[{"wrong":"Вчера кто-нибудь звонил мне.","right":"Вчера кто-то звонил мне.","note":"Gerçekleşmiş olayda -то."},{"wrong":"Я говорил с кое-кем.","right":"Я говорил кое с кем.","note":"Edat кое- ile zamir arasına girer."}]}},
  {"id":"ru-gr-otritsatelnye-mestoimeniya-na-ne-i-ni","languageId":"ru","category":"grammar","level":"C1","sourceText":"Отрицательные местоимения на не- и ни-","translations":{"tr":["не- ve ни- ile başlayan zamirler"]},"details":{"reading":"Otritsátel'nye mestoiméniya na ne- i ni-"},"grammar":{"summary":"ни- zamirleri olumsuz fiille çifte olumsuzluk kurar; vurgulu не- zamirleri + mastar \"…ecek kimse/şey yok\" anlamı verir.","uses":["Hiç kimse / hiçbir şey: никто не…, ничего не…","…ecek kimse/şey/yer yok: некого, нечего, некуда + mastar","Edatla bölünme: ни с кем, не с кем"],"sections":[{"kind":"other","title":"ни- + не + fiil","formula":[{"tr":"ни-zamir","en":"Отрицательное местоимение","role":"s"},{"tr":"не","en":"Частица не","role":"x"},{"tr":"Fiil","en":"Сказуемое","role":"v"}],"examples":[{"text":"[s:Никто] [x:не] [v:пришёл].","reading":"Nikto ne prishyol.","tr":"Kimse gelmedi."},{"text":"Я [o:ничего] [x:не] [v:знаю].","reading":"Ya nichego ne znayu.","tr":"Hiçbir şey bilmiyorum."}]},{"kind":"other","title":"не- + mastar (kişisiz)","formula":[{"tr":"Kişi (yönelme)","en":"Дательный падеж","role":"s"},{"tr":"не-zamir","en":"Отрицательное местоимение","role":"o"},{"tr":"Mastar","en":"Инфинитив","role":"v"}],"examples":[{"text":"[s:Мне] [o:некуда] [v:пойти].","reading":"Mne nekuda poyti.","tr":"Gidecek bir yerim yok."},{"text":"[o:Не с кем] [v:поговорить].","reading":"Ne s kem pogovorit'.","tr":"Konuşacak kimse yok."}]},{"kind":"other","title":"Edat araya girer","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"ни + edat + zamir","en":"Ни + предлог + местоимение","role":"o"},{"tr":"не","en":"Частица не","role":"x"},{"tr":"Fiil","en":"Сказуемое","role":"v"}],"examples":[{"text":"[s:Он] [o:ни о чём] [x:не] [v:думает].","reading":"On ni o chyom ne dumayet.","tr":"Hiçbir şey düşünmüyor."}]}],"rules":["ни- zamirleriyle fiilin önüne mutlaka не gelir.","не- zamirleri her zaman vurgulu (не́кого), ни- vurgusuzdur.","Geçmiş/gelecek: было / будет: Мне некого было спросить."],"exceptions":["некто ve нечто \"birisi, bir şey\" anlamındadır (kitabi)."],"mistakes":[{"wrong":"Никто пришёл.","right":"Никто не пришёл.","note":"Rusçada çifte olumsuzluk zorunlu."},{"wrong":"Мне ничего делать.","right":"Мне нечего делать.","note":"\"Yapacak şey yok\" anlamında не-zamir."},{"wrong":"Я не говорил никем.","right":"Я ни с кем не говорил.","note":"Edat ни ile zamirin arasına girer."}]}},
  {"id":"ru-gr-upravleniye-glagolov","languageId":"ru","category":"grammar","level":"C1","sourceText":"Управление глаголов","translations":{"tr":["Fiillerin hâl yönetimi"]},"details":{"reading":"Upravléniye glagólov"},"grammar":{"summary":"Rusça fiiller tümleçlerini belirli bir hâlde ve edatla ister; Türkçedeki hâlle çoğu zaman örtüşmez.","uses":["Yönelme hâli: помогать, звонить, мешать, советовать","Araç hâli: заниматься, интересоваться, гордиться, пользоваться","-in hâli: бояться, избегать, достигать","Edatlı: зависеть от, думать о, готовиться к"],"sections":[{"kind":"other","title":"Yönelme hâli (кому?)","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Tümleç (yönelme)","en":"Дательный падеж","role":"o"}],"examples":[{"text":"[s:Я] [v:помогаю] [o:маме].","reading":"Ya pomogayu mame.","tr":"Anneme yardım ediyorum."},{"text":"[v:Позвони] [o:мне] завтра.","reading":"Pozvoni mne zavtra.","tr":"Yarın beni ara."}]},{"kind":"other","title":"Araç hâli (чем?)","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Tümleç (araç)","en":"Творительный падеж","role":"o"}],"examples":[{"text":"[s:Он] [v:занимается] [o:спортом].","reading":"On zanimayetsya sportom.","tr":"Spor yapıyor."},{"text":"[s:Мы] [v:гордимся] [o:тобой].","reading":"My gordimsya toboy.","tr":"Seninle gurur duyuyoruz."}]},{"kind":"other","title":"-in hâli (чего?)","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Tümleç (-in hâli)","en":"Родительный падеж","role":"o"}],"examples":[{"text":"[s:Ребёнок] [v:боится] [o:темноты].","reading":"Rebyonok boitsya temnoty.","tr":"Çocuk karanlıktan korkuyor."}]},{"kind":"other","title":"Edat + hâl","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Глагол","role":"v"},{"tr":"Edat + isim","en":"Предлог + падеж","role":"o"}],"examples":[{"text":"[s:Всё] [v:зависит] [o:от погоды].","reading":"Vsyo zavisit ot pogody.","tr":"Her şey havaya bağlı."}]}],"rules":["Fiili sorusuyla ezberle: помогать кому?, бояться чего?","ждать: somut beklenen belirtme (жду маму), soyut -in hâli (жду ответа).","Türkçe \"-den\" her zaman от/из değildir: бояться + -in hâli."],"mistakes":[{"wrong":"Я помогаю маму.","right":"Я помогаю маме.","note":"помогать yönelme hâli ister."},{"wrong":"Он занимается спорт.","right":"Он занимается спортом.","note":"заниматься araç hâli ister."},{"wrong":"Я боюсь от собак.","right":"Я боюсь собак.","note":"бояться edatsız -in hâli ister."}]}},
  {"id":"ru-gr-poryadok-slov-i-aktualnoye-chleneniye","languageId":"ru","category":"grammar","level":"C1","sourceText":"Порядок слов и актуальное членение","translations":{"tr":["Kelime sırası ve bilgi yapısı"]},"details":{"reading":"Póryadok slov i aktuál'noye chlenéniye"},"grammar":{"summary":"Rusçada kelime sırası serbesttir; bilinen bilgi başa, yeni ve önemli bilgi sona gelir.","uses":["Yeni bilgiyi vurgulamak için sona koymak","Artikel olmadığından belirliliği sırayla vermek","Sayıyı isimden sonra koyarak yaklaşıklık bildirmek"],"sections":[{"kind":"other","title":"Bilinen → yeni","formula":[{"tr":"Bilinen bilgi","en":"Тема","role":"o"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"Yeni bilgi","en":"Рема","role":"s"}],"examples":[{"text":"[o:Эту книгу] [v:написал] [s:Толстой].","reading":"Etu knigu napisal Tolstoy.","tr":"Bu kitabı Tolstoy yazdı."},{"text":"[s:Толстой] [v:написал] [o:эту книгу].","reading":"Tolstoy napisal etu knigu.","tr":"Tolstoy bu kitabı yazdı."}]},{"kind":"other","title":"Yer başta, yeni özne sonda","formula":[{"tr":"Yer","en":"Обстоятельство места","role":"x"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"Yeni özne","en":"Подлежащее (рема)","role":"s"}],"examples":[{"text":"[x:В комнату] [v:вошла] [s:девочка].","reading":"V komnatu voshla devochka.","tr":"Odaya bir kız girdi."},{"text":"[s:Девочка] [v:вошла] [x:в комнату].","reading":"Devochka voshla v komnatu.","tr":"Kız odaya girdi."}],"notes":["Sondaki özne belirsiz (bir kız), baştaki belirli (kız) okunur."]},{"kind":"other","title":"Yaklaşıklık: isim + sayı","formula":[{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"İsim + sayı","en":"Существительное + числительное","role":"o"}],"examples":[{"text":"[s:Он] [v:ждал] [o:минут двадцать].","reading":"On zhdal minut dvadtsat'.","tr":"Yirmi dakika kadar bekledi."}]}],"rules":["Cümlenin sonundaki öğe yeni ve önemli bilgidir.","Tarafsız sıra: Özne – Yüklem – Tümleç.","İsim sayının önüne geçerse yaklaşık anlam doğar: часа два (iki saat kadar)."],"mistakes":[{"wrong":"Девочка вошла в комнату. (Odaya bir kız girdi anlamında)","right":"В комнату вошла девочка.","note":"Yeni bilgi olan özne sona gelir."},{"wrong":"— Где ты живёшь? — Я в Москве живу.","right":"— Где ты живёшь? — Я живу в Москве.","note":"Sorulan bilgi sona gelir; fiili sona atmak Türkçe alışkanlığıdır."}]}},
  {"id":"ru-gr-chastitsy-zhe-ved-to-razve-neuzheli","languageId":"ru","category":"grammar","level":"C1","sourceText":"Частицы: же, ведь, -то, разве, неужели","translations":{"tr":["Vurgu ve soru edatları"]},"details":{"reading":"Chastítsy: zhe, ved', -to, rázve, neuzhéli"},"grammar":{"summary":"же, ведь, -то, разве, неужели gibi edatlar cümleye vurgu, şaşkınlık, itiraz veya ortak bilgi tonu katar.","uses":["же: vurgu ve aynılık (тот же)","ведь: bilinen gerekçe (…ya, sonuçta)","разве / неужели: şüpheli ve şaşkın soru","-то: karşıtlıklı konu vurgusu (Я-то знаю)"],"sections":[{"kind":"other","title":"же","formula":[{"tr":"Vurgulanan kelime","en":"Выделяемое слово","role":"s"},{"tr":"же","en":"Частица же","role":"x"},{"tr":"Fiil","en":"Сказуемое","role":"v"}],"examples":[{"text":"[s:Я] [x:же] [v:говорил] тебе!","reading":"Ya zhe govoril tebe!","tr":"Sana söylemiştim ya!"},{"text":"Это [x:тот же] [o:человек].","reading":"Eto tot zhe chelovek.","tr":"Bu aynı adam."}]},{"kind":"other","title":"ведь","formula":[{"tr":"Ana cümle","en":"Главное предложение","role":"o"},{"tr":"ведь","en":"Частица ведь","role":"x"},{"tr":"Gerekçe","en":"Обоснование","role":"v"}],"examples":[{"text":"[o:Возьми зонт], [x:ведь] [v:идёт дождь].","reading":"Voz'mi zont, ved' idyot dozhd'.","tr":"Şemsiyeni al, yağmur yağıyor ya."}]},{"kind":"other","title":"разве / неужели","formula":[{"tr":"разве / неужели","en":"Вопросительная частица","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil?","en":"Сказуемое?","role":"v"}],"examples":[{"text":"[x:Неужели] [s:ты] [v:забыл]?","reading":"Neuzheli ty zabyl?","tr":"Yoksa unuttun mu? (inanamıyorum)"},{"text":"[x:Разве] [s:он] [v:не знает]?","reading":"Razve on ne znayet?","tr":"Bilmiyor mu ki?"}]},{"kind":"other","title":"-то","formula":[{"tr":"Kelime + -то","en":"Слово + -то","role":"s"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"Karşıtlık","en":"Противопоставление","role":"o"}],"examples":[{"text":"[s:Я-то] [v:знаю], [o:а он нет].","reading":"Ya-to znayu, a on net.","tr":"Ben biliyorum da o bilmiyor."}]}],"rules":["же vurgulanan kelimeden hemen sonra gelir, cümle başında olmaz.","неужели güçlü şaşkınlık, разве şüphe veya itiraz bildirir.","Bu edatlar konuşma diline aittir; resmî yazıda az kullanılır."],"mistakes":[{"wrong":"Же я говорил!","right":"Я же говорил!","note":"же cümle başında durmaz."},{"wrong":"Разве ты студент? (nötr soru olarak)","right":"Ты студент?","note":"разве nötr değil; şüphe ve itiraz katar."}]}},
  {"id":"ru-gr-pridatochnye-vremeni","languageId":"ru","category":"grammar","level":"C1","sourceText":"Придаточные времени","translations":{"tr":["Zaman yan cümleleri"]},"details":{"reading":"Pridátochnye vrémeni"},"grammar":{"summary":"когда, пока, пока не, как только, перед тем как, после того как gibi bağlaçlarla eylemlerin sırası ve süresi anlatılır.","uses":["Hemen ardından: как только (…ır …maz)","Eşzamanlılık: пока (-ken)","Sınır: пока не (-ene kadar)","Öncelik ve sonralık: перед тем как, до того как, после того как"],"sections":[{"kind":"other","title":"как только","formula":[{"tr":"как только","en":"Союз как только","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil (СВ)","en":"Глагол СВ","role":"v"},{"tr":"Ana cümle","en":"Главное предложение","role":"o"}],"examples":[{"text":"[x:Как только] [s:я] [v:приеду], [o:я позвоню].","reading":"Kak tol'ko ya priyedu, ya pozvonyu.","tr":"Varır varmaz ararım."}]},{"kind":"other","title":"пока / пока не","formula":[{"tr":"пока (не)","en":"Союз пока (не)","role":"x"},{"tr":"Özne","en":"Подлежащее","role":"s"},{"tr":"Fiil","en":"Сказуемое","role":"v"},{"tr":"Ana cümle","en":"Главное предложение","role":"o"}],"examples":[{"text":"[x:Пока] [s:ты] [v:спал], [o:я готовил ужин].","reading":"Poka ty spal, ya gotovil uzhin.","tr":"Sen uyurken ben yemek yaptım."},{"text":"[o:Подожди], [x:пока] [s:я] [x:не] [v:вернусь].","reading":"Podozhdi, poka ya ne vernus'.","tr":"Ben dönene kadar bekle."}],"notes":["пока не'deki не olumsuzluk değildir."]},{"kind":"other","title":"перед тем как / после того как","formula":[{"tr":"Bağlaç","en":"Составной союз","role":"x"},{"tr":"Mastar veya cümle","en":"Инфинитив / предложение","role":"v"},{"tr":"Ana cümle","en":"Главное предложение","role":"o"}],"examples":[{"text":"[x:Перед тем как] [v:уйти], [o:выключи свет].","reading":"Pered tem kak uyti, vyklyuchi svet.","tr":"Çıkmadan önce ışığı kapat."},{"text":"[x:После того как] [s:мы] [v:поели], [o:мы пошли гулять].","reading":"Posle togo kak my poyeli, my poshli gulyat'.","tr":"Yemek yedikten sonra yürüyüşe çıktık."}]}],"rules":["Gelecek anlamında yan cümlede de gelecek zaman kullanılır: Когда я приду…","Özne aynıysa перед тем как / до того как + mastar.","после того как ile СВ fiil daha sık kullanılır."],"mistakes":[{"wrong":"Когда я прихожу домой, я тебе позвоню.","right":"Когда я приду домой, я тебе позвоню.","note":"Gelecek anlamında gelecek zaman."},{"wrong":"Подожди, пока я вернусь.","right":"Подожди, пока я не вернусь.","note":"\"-ene kadar\" anlamında пока не."}]}},
  {"id":"ru-gr-prichinno-sledstvennye-soyuzy","languageId":"ru","category":"grammar","level":"C1","sourceText":"Причинно-следственные союзы","translations":{"tr":["Sebep-sonuç bağlaçları"]},"details":{"reading":"Prichínno-slédstvennye soyúzy"},"grammar":{"summary":"Sebep için потому что, так как, поскольку, из-за, благодаря; sonuç için поэтому, так что kullanılır; üslup ve anlam farkı vardır.","uses":["Sebep: потому что, так как, поскольку","İsimle sebep: благодаря (olumlu) / из-за (olumsuz)","Sonuç: поэтому, так что","Resmî: в связи с, вследствие"],"sections":[{"kind":"other","title":"потому что / так как","formula":[{"tr":"Ana cümle","en":"Главное предложение","role":"o"},{"tr":"Bağlaç","en":"Союз","role":"x"},{"tr":"Sebep cümlesi","en":"Придаточное причины","role":"v"}],"examples":[{"text":"[o:Я не пришёл], [x:потому что] [v:заболел].","reading":"Ya ne prishyol, potomu chto zabolel.","tr":"Hastalandığım için gelmedim."},{"text":"[x:Так как] [v:шёл дождь], [o:мы остались дома].","reading":"Tak kak shyol dozhd', my ostalis' doma.","tr":"Yağmur yağdığı için evde kaldık."}]},{"kind":"other","title":"благодаря / из-за + isim","formula":[{"tr":"Edat","en":"Предлог","role":"x"},{"tr":"İsim","en":"Существительное","role":"o"},{"tr":"Ana cümle","en":"Главное предложение","role":"v"}],"examples":[{"text":"[x:Благодаря] [o:тебе] [v:я сдал экзамен].","reading":"Blagodarya tebe ya sdal ekzamen.","tr":"Senin sayende sınavı geçtim."},{"text":"[x:Из-за] [o:пробки] [v:мы опоздали].","reading":"Iz-za probki my opozdali.","tr":"Trafik yüzünden geç kaldık."}]},{"kind":"other","title":"поэтому / так что","formula":[{"tr":"Sebep cümlesi","en":"Причина","role":"o"},{"tr":"поэтому / так что","en":"Союз следствия","role":"x"},{"tr":"Sonuç","en":"Следствие","role":"v"}],"examples":[{"text":"[o:Я устал], [x:поэтому] [v:лёг рано].","reading":"Ya ustal, poetomu lyog rano.","tr":"Yorgundum, bu yüzden erken yattım."}]}],"rules":["так как ve поскольку cümle başında olabilir; потому что genelde ikinci yarıdadır.","благодаря + yönelme hâli, из-за + -in hâli.","поэтому ve так что önünde virgül olur."],"mistakes":[{"wrong":"Благодаря дождю мы опоздали.","right":"Из-за дождя мы опоздали.","note":"благодаря yalnızca olumlu sonuçlarda."},{"wrong":"Потому что я устал, я лёг.","right":"Так как я устал, я лёг.","note":"Cümle başında так как veya поскольку."},{"wrong":"благодаря тебя","right":"благодаря тебе","note":"благодаря yönelme hâli ister."}]}}
]
