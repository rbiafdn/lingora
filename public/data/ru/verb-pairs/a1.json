  {"id":"ru-vp-videt-uvidet","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"видеть / увидеть","translations":{"tr":["görmek"]},"partOfSpeech":"verb","details":{"reading":"vídet' / uvídet'","usage":"видеть: görme durumu; увидеть: bir anda fark edip görmek."},"examples":[{"text":"Я увидел его в окне.","reading":"Ya uvidel yego v okne.","tr":"Onu pencerede gördüm."}]},
  {"id":"ru-vp-slyshat-uslyshat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"слышать / услышать","translations":{"tr":["duymak"]},"partOfSpeech":"verb","details":{"reading":"slýshat' / uslýshat'","usage":"слышать: duyma yetisi/durumu; услышать: bir sesi bir anda duymak."},"examples":[{"text":"Вдруг я услышал шум.","reading":"Vdrug ya uslyshal shum.","tr":"Birden bir gürültü duydum."}]},
  {"id":"ru-vp-smotret-posmotret","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"смотреть / посмотреть","translations":{"tr":["bakmak","izlemek"]},"partOfSpeech":"verb","details":{"reading":"smotrét' / posmotrét'","usage":"смотреть: izlemek, süreç; посмотреть: bir kez bakmak ya da izleyip bitirmek."},"examples":[{"text":"Посмотри, какая красивая птица!","reading":"Posmotri, kakaya krasivaya ptitsa!","tr":"Bak, ne güzel bir kuş!"}]},
  {"id":"ru-vp-pit-vypit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"пить / выпить","translations":{"tr":["içmek"]},"partOfSpeech":"verb","details":{"reading":"pit' / výpit'","usage":"пить: içmek, alışkanlık; выпить: belli bir miktarı içip bitirmek."},"examples":[{"text":"Он выпил стакан воды.","reading":"On vypil stakan vody.","tr":"Bir bardak su içti."}]},
  {"id":"ru-vp-yest-syest","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"есть / съесть","translations":{"tr":["yemek"]},"partOfSpeech":"verb","details":{"reading":"yest' / s'yést'","usage":"есть: yemek yemek, süreç; съесть: bir şeyi yiyip bitirmek."},"examples":[{"text":"Кто съел мой бутерброд?","reading":"Kto s'yel moy buterbrod?","tr":"Sandviçimi kim yedi?"}]},
  {"id":"ru-vp-uchit-vyuchit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"учить / выучить","translations":{"tr":["ezberlemek","öğrenmek"]},"partOfSpeech":"verb","details":{"reading":"uchít' / výuchit'","usage":"учить: çalışmak, ezberlemeye uğraşmak; выучить: öğrenip ezberlemiş olmak."},"examples":[{"text":"Я выучил все новые слова.","reading":"Ya vyuchil vse novyye slova.","tr":"Bütün yeni kelimeleri ezberledim."}]},
  {"id":"ru-vp-zvonit-pozvonit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"звонить / позвонить","translations":{"tr":["telefon etmek","aramak"]},"partOfSpeech":"verb","details":{"reading":"zvonít' / pozvonít'","usage":"звонить: sık sık/genelde aramak; позвонить: bir kez aramak."},"examples":[{"text":"Позвони маме вечером.","reading":"Pozvoni mame vecherom.","tr":"Akşam anneni ara."}]},
  {"id":"ru-vp-otvechat-otvetit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"отвечать / ответить","translations":{"tr":["cevap vermek"]},"partOfSpeech":"verb","details":{"reading":"otvechát' / otvétit'","usage":"отвечать: cevaplamak, cevap veriyor olmak; ответить: tek seferde cevap vermek."},"examples":[{"text":"Он не ответил на мой вопрос.","reading":"On ne otvetil na moy vopros.","tr":"Soruma cevap vermedi."}]},
  {"id":"ru-vp-sprashivat-sprosit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"спрашивать / спросить","translations":{"tr":["sormak"]},"partOfSpeech":"verb","details":{"reading":"spráshivat' / sprosít'","usage":"спрашивать: sık sık/genelde sormak; спросить: bir kez sormak."},"examples":[{"text":"Спроси у учителя.","reading":"Sprosi u uchitelya.","tr":"Öğretmene sor."}]},
  {"id":"ru-vp-nachinat-nachat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"начинать / начать","translations":{"tr":["başlamak","başlatmak"]},"partOfSpeech":"verb","details":{"reading":"nachinát' / nachát'","usage":"начинать: genelde/her gün başlamak; начать: belirli bir anda başlamak."},"examples":[{"text":"Мы начали урок в девять.","reading":"My nachali urok v devyat'.","tr":"Derse dokuzda başladık."}]},
  {"id":"ru-vp-zakanchivat-zakonchit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"заканчивать / закончить","translations":{"tr":["bitirmek"]},"partOfSpeech":"verb","details":{"reading":"zakánchivat' / zakónchit'","usage":"заканчивать: bitirmek üzere olmak, her gün bitirmek; закончить: bitirmiş olmak."},"examples":[{"text":"Я закончил работу и иду домой.","reading":"Ya zakonchil rabotu i idu domoy.","tr":"İşi bitirdim, eve gidiyorum."}]},
  {"id":"ru-vp-otkryvat-otkryt","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"открывать / открыть","translations":{"tr":["açmak"]},"partOfSpeech":"verb","details":{"reading":"otkryvát' / otkrýt'","usage":"открывать: genelde/her sabah açmak; открыть: bir kez açmak."},"examples":[{"text":"Откройте, пожалуйста, окно.","reading":"Otkroyte, pozhaluysta, okno.","tr":"Pencereyi açar mısınız lütfen?"}]},
  {"id":"ru-vp-zakryvat-zakryt","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"закрывать / закрыть","translations":{"tr":["kapamak","kapatmak"]},"partOfSpeech":"verb","details":{"reading":"zakryvát' / zakrýt'","usage":"закрывать: genelde kapatmak; закрыть: bir kez kapatıp bitirmek."},"examples":[{"text":"Магазин закрывают в восемь.","reading":"Magazin zakryvayut v vosem'.","tr":"Mağazayı sekizde kapatıyorlar."}]},
  {"id":"ru-vp-gotovit-prigotovit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"готовить / приготовить","translations":{"tr":["yemek yapmak","hazırlamak"]},"partOfSpeech":"verb","details":{"reading":"gotóvit' / prigotóvit'","usage":"готовить: yemek pişirmek, süreç; приготовить: hazırlayıp bitirmek."},"examples":[{"text":"Мама приготовила ужин.","reading":"Mama prigotovila uzhin.","tr":"Annem akşam yemeğini hazırladı."}]},
  {"id":"ru-vp-ponimat-ponyat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"понимать / понять","translations":{"tr":["anlamak"]},"partOfSpeech":"verb","details":{"reading":"ponimát' / ponyát'","usage":"понимать: anlıyor olmak (durum); понять: bir anda kavramak."},"examples":[{"text":"Я не понял, повторите, пожалуйста.","reading":"Ya ne ponyal, povtorite, pozhaluysta.","tr":"Anlamadım, tekrar eder misiniz?"}]},
  {"id":"ru-vp-pomogat-pomoch","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"помогать / помочь","translations":{"tr":["yardım etmek"]},"partOfSpeech":"verb","details":{"reading":"pomogát' / pomóch'","usage":"помогать: düzenli yardım etmek; помочь: belirli bir işte bir kez yardım etmek."},"examples":[{"text":"Помогите мне, пожалуйста!","reading":"Pomogite mne, pozhaluysta!","tr":"Bana yardım edin lütfen!"}]},
  {"id":"ru-vp-platit-zaplatit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"платить / заплатить","translations":{"tr":["ödemek"]},"partOfSpeech":"verb","details":{"reading":"platít' / zaplatít'","usage":"платить: genelde ödemek; заплатить: belirli bir tutarı ödemek."},"examples":[{"text":"Я уже заплатил за кофе.","reading":"Ya uzhe zaplatil za kofe.","tr":"Kahvenin parasını çoktan ödedim."}]},
  {"id":"ru-vp-prodavat-prodat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"продавать / продать","translations":{"tr":["satmak"]},"partOfSpeech":"verb","details":{"reading":"prodavát' / prodát'","usage":"продавать: satış yapmak, satmaya çalışmak; продать: satmış olmak."},"examples":[{"text":"Мы продали старую машину.","reading":"My prodali staruyu mashinu.","tr":"Eski arabamızı sattık."}]},
  {"id":"ru-vp-prikhodit-priyti","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"приходить / прийти","translations":{"tr":["gelmek (yürüyerek)"]},"partOfSpeech":"verb","details":{"reading":"prikhodít' / priytí","usage":"приходить: genelde/her gün gelmek; прийти: bir kez gelip varmak."},"examples":[{"text":"Он пришёл домой в шесть.","reading":"On prishyol domoy v shest'.","tr":"Eve altıda geldi."}]},
  {"id":"ru-vp-ukhodit-uyti","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"уходить / уйти","translations":{"tr":["gitmek","ayrılmak"]},"partOfSpeech":"verb","details":{"reading":"ukhodít' / uytí","usage":"уходить: ayrılıyor olmak, her gün çıkmak; уйти: gidip orada olmamak."},"examples":[{"text":"Директор уже ушёл.","reading":"Direktor uzhe ushyol.","tr":"Müdür çoktan çıktı."}]},
  {"id":"ru-vp-priyezzhat-priyekhat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"приезжать / приехать","translations":{"tr":["gelmek (araçla)"]},"partOfSpeech":"verb","details":{"reading":"priyezzhát' / priyékhat'","usage":"приезжать: sık sık gelmek; приехать: bir kez gelip varmak."},"examples":[{"text":"Брат приехал из Казани.","reading":"Brat priyekhal iz Kazani.","tr":"Kardeşim Kazan'dan geldi."}]},
