  {"id":"ru-vp-risovat-narisovat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"рисовать / нарисовать","translations":{"tr":["resim yapmak","çizmek"]},"partOfSpeech":"verb","details":{"reading":"risovát' / narisovát'","usage":"рисовать: resim yapmak, süreç; нарисовать: çizip bitirmek."},"examples":[{"text":"Дочь нарисовала кошку.","reading":"Doch' narisovala koshku.","tr":"Kızım bir kedi çizdi."}]},
