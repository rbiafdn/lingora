  {"id":"ru-vp-gulyat-pogulyat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"гулять / погулять","translations":{"tr":["gezmek","yürüyüş yapmak"]},"partOfSpeech":"verb","details":{"reading":"gulyát' / pogulyát'","usage":"гулять: gezmek, genelde yürüyüş yapmak; погулять: bir süre gezmek."},"examples":[{"text":"Мы погуляли в парке час.","reading":"My pogulyali v parke chas.","tr":"Parkta bir saat gezdik."}]},
  {"id":"ru-vp-rabotat-porabotat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"работать / поработать","translations":{"tr":["çalışmak"]},"partOfSpeech":"verb","details":{"reading":"rabótat' / porabótat'","usage":"работать: çalışmak, işte olmak; поработать: bir süre çalışmak."},"examples":[{"text":"Я ещё немного поработаю.","reading":"Ya yeshchyo nemnogo porabotayu.","tr":"Biraz daha çalışacağım."}]},
  {"id":"ru-vp-prosypatsya-prosnutsya","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"просыпаться / проснуться","translations":{"tr":["uyanmak"]},"partOfSpeech":"verb","details":{"reading":"prosypát'sya / prosnút'sya","usage":"просыпаться: her gün uyanmak; проснуться: bir kez uyanmak."},"examples":[{"text":"Сегодня я проснулся рано.","reading":"Segodnya ya prosnulsya rano.","tr":"Bugün erken uyandım."}]},
  {"id":"ru-vp-pokazyvat-pokazat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"показывать / показать","translations":{"tr":["göstermek"]},"partOfSpeech":"verb","details":{"reading":"pokázyvat' / pokazát'","usage":"показывать: göstermek, süreç ya da tekrar; показать: bir kez gösterip bitirmek."},"examples":[{"text":"Покажите, пожалуйста, это платье.","reading":"Pokazhite, pozhaluysta, eto plat'ye.","tr":"Şu elbiseyi gösterir misiniz?"}]},
  {"id":"ru-vp-iskat-nayti","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"искать / найти","translations":{"tr":["aramak / bulmak"]},"partOfSpeech":"verb","details":{"reading":"iskát' / naytí","usage":"Tam çift değil: искать = aramak (süreç); найти = bulmak (sonuç)."},"examples":[{"text":"Я долго искал ключи и наконец нашёл.","reading":"Ya dolgo iskal klyuchi i nakonets nashyol.","tr":"Anahtarları uzun süre aradım ve sonunda buldum."}]},
  {"id":"ru-vp-zabyvat-zabyt","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"забывать / забыть","translations":{"tr":["unutmak"]},"partOfSpeech":"verb","details":{"reading":"zabyvát' / zabýt'","usage":"забывать: sık sık unutmak; забыть: bir şeyi unutmuş olmak."},"examples":[{"text":"Я забыл телефон дома.","reading":"Ya zabyl telefon doma.","tr":"Telefonu evde unuttum."}]},
  {"id":"ru-vp-vspominat-vspomnit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"вспоминать / вспомнить","translations":{"tr":["hatırlamak"]},"partOfSpeech":"verb","details":{"reading":"vspominát' / vspómnit'","usage":"вспоминать: anmak, hatırlamaya çalışmak; вспомнить: aklına gelmek, hatırlamak."},"examples":[{"text":"Я не могу вспомнить его имя.","reading":"Ya ne mogu vspomnit' yego imya.","tr":"Adını hatırlayamıyorum."}]},
  {"id":"ru-vp-lyubit-polyubit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"любить / полюбить","translations":{"tr":["sevmek","sevmeye başlamak"]},"partOfSpeech":"verb","details":{"reading":"lyubít' / polyubít'","usage":"любить: sevmek (durum); полюбить: sevmeye başlamak, âşık olmak."},"examples":[{"text":"Я полюбил этот город с первого дня.","reading":"Ya polyubil etot gorod s pervogo dnya.","tr":"Bu şehri ilk günden sevdim."}]},
  {"id":"ru-vp-stroit-postroit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"строить / построить","translations":{"tr":["inşa etmek","yapmak"]},"partOfSpeech":"verb","details":{"reading":"stróit' / postróit'","usage":"строить: inşa ediyor olmak; построить: inşa edip bitirmek."},"examples":[{"text":"Этот дом построили в 1950 году.","reading":"Etot dom postroili v 1950 godu.","tr":"Bu ev 1950'de yapıldı."}]},
  {"id":"ru-vp-perevodit-perevesti","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"переводить / перевести","translations":{"tr":["çevirmek (dil)"]},"partOfSpeech":"verb","details":{"reading":"perevodít' / perevestí","usage":"переводить: çeviri yapmak, süreç; перевести: çevirip bitirmek."},"examples":[{"text":"Переведите этот текст на русский.","reading":"Perevedite etot tekst na russkiy.","tr":"Bu metni Rusçaya çevirin."}]},
  {"id":"ru-vp-povtoryat-povtorit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"повторять / повторить","translations":{"tr":["tekrarlamak","tekrar etmek"]},"partOfSpeech":"verb","details":{"reading":"povtoryát' / povtorít'","usage":"повторять: tekrar tekrar söylemek; повторить: bir kez tekrarlamak."},"examples":[{"text":"Повторите, пожалуйста, медленнее.","reading":"Povtorite, pozhaluysta, medlenneye.","tr":"Daha yavaş tekrar eder misiniz?"}]},
  {"id":"ru-vp-reshat-reshit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"решать / решить","translations":{"tr":["çözmek","karar vermek"]},"partOfSpeech":"verb","details":{"reading":"reshát' / reshít'","usage":"решать: çözmeye çalışmak, karar aşamasında olmak; решить: çözmek, karar vermiş olmak."},"examples":[{"text":"Я решил учить русский язык.","reading":"Ya reshil uchit' russkiy yazyk.","tr":"Rusça öğrenmeye karar verdim."}]},
  {"id":"ru-vp-pet-spet","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"петь / спеть","translations":{"tr":["şarkı söylemek"]},"partOfSpeech":"verb","details":{"reading":"pet' / spet'","usage":"петь: şarkı söylemek, süreç; спеть: bir şarkıyı söyleyip bitirmek."},"examples":[{"text":"Спой нам что-нибудь!","reading":"Spoy nam chto-nibud'!","tr":"Bize bir şey söyle!"}]},
  {"id":"ru-vp-vozvrashchatsya-vernutsya","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"возвращаться / вернуться","translations":{"tr":["geri dönmek"]},"partOfSpeech":"verb","details":{"reading":"vozvrashchát'sya / vernút'sya","usage":"возвращаться: dönüyor olmak, her gün dönmek; вернуться: dönmüş olmak."},"examples":[{"text":"Когда ты вернёшься?","reading":"Kogda ty vernyosh'sya?","tr":"Ne zaman döneceksin?"}]},
  {"id":"ru-vp-klast-polozhit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"класть / положить","translations":{"tr":["koymak (yatay)"]},"partOfSpeech":"verb","details":{"reading":"klast' / polozhít'","usage":"Yatay koymak. класть: genelde koymak; положить: bir kez koymak. Dikey için ставить."},"examples":[{"text":"Положи книгу на стол.","reading":"Polozhi knigu na stol.","tr":"Kitabı masaya koy."}]},
  {"id":"ru-vp-stavit-postavit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"ставить / поставить","translations":{"tr":["koymak (dik)"]},"partOfSpeech":"verb","details":{"reading":"stávit' / postávit'","usage":"Dik koymak (şişe, bardak). ставить: genelde koymak; поставить: bir kez koymak."},"examples":[{"text":"Поставь чашку на полку.","reading":"Postav' chashku na polku.","tr":"Fincanı rafa koy."}]},
  {"id":"ru-vp-opazdyvat-opozdat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"опаздывать / опоздать","translations":{"tr":["geç kalmak"]},"partOfSpeech":"verb","details":{"reading":"opázdyvat' / opozdát'","usage":"опаздывать: sık sık geç kalmak, geç kalıyor olmak; опоздать: bir kez geç kalmış olmak."},"examples":[{"text":"Извините, я опоздал.","reading":"Izvinite, ya opozdal.","tr":"Kusura bakmayın, geç kaldım."}]},
  {"id":"ru-vp-otdykhat-otdokhnut","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"отдыхать / отдохнуть","translations":{"tr":["dinlenmek","tatil yapmak"]},"partOfSpeech":"verb","details":{"reading":"otdykhát' / otdokhnút'","usage":"отдыхать: dinlenmek, tatilde olmak; отдохнуть: dinlenip yorgunluğu atmak."},"examples":[{"text":"Летом мы хорошо отдохнули.","reading":"Letom my khorosho otdokhnuli.","tr":"Yazın iyi dinlendik."}]},
  {"id":"ru-vp-poluchat-poluchit","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"получать / получить","translations":{"tr":["almak","elde etmek"]},"partOfSpeech":"verb","details":{"reading":"poluchát' / poluchít'","usage":"получать: düzenli almak (maaş); получить: bir kez almak (mektup, paket)."},"examples":[{"text":"Я получил твоё письмо.","reading":"Ya poluchil tvoyo pis'mo.","tr":"Mektubunu aldım."}]},
  {"id":"ru-vp-posylat-poslat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"посылать / послать","translations":{"tr":["göndermek","yollamak"]},"partOfSpeech":"verb","details":{"reading":"posylát' / poslát'","usage":"посылать: düzenli göndermek; послать: bir kez gönderip bitirmek."},"examples":[{"text":"Я послал тебе фото.","reading":"Ya poslal tebe foto.","tr":"Sana fotoğraf gönderdim."}]},
  {"id":"ru-vp-prinosit-prinesti","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"приносить / принести","translations":{"tr":["getirmek (elde)"]},"partOfSpeech":"verb","details":{"reading":"prinosít' / prinestí","usage":"приносить: genelde getirmek; принести: bir kez getirmek."},"examples":[{"text":"Принесите, пожалуйста, меню.","reading":"Prinesite, pozhaluysta, menyu.","tr":"Menüyü getirir misiniz?"}]},
  {"id":"ru-vp-stanovitsya-stat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"становиться / стать","translations":{"tr":["olmak (dönüşmek)"]},"partOfSpeech":"verb","details":{"reading":"stanovít'sya / stat'","usage":"становиться: giderek olmak; стать: bir şey olmak. Ardından araç hâli: стать врачом."},"examples":[{"text":"Он стал врачом.","reading":"On stal vrachom.","tr":"Doktor oldu."}]},
  {"id":"ru-vp-probovat-poprobovat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"пробовать / попробовать","translations":{"tr":["denemek","tadına bakmak"]},"partOfSpeech":"verb","details":{"reading":"próbovat' / popróbovat'","usage":"пробовать: deneyip durmak; попробовать: bir kez denemek, tadına bakmak."},"examples":[{"text":"Попробуйте этот суп!","reading":"Poprobuyte etot sup!","tr":"Bu çorbayı tadın!"}]},
  {"id":"ru-vp-moch-smoch","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"мочь / смочь","translations":{"tr":["-ebilmek"]},"partOfSpeech":"verb","details":{"reading":"moch' / smoch'","usage":"мочь: genel olarak yapabilmek; смочь: belirli bir durumda başarabilmek (çoğunlukla gelecek/geçmiş)."},"examples":[{"text":"Я не смогу прийти завтра.","reading":"Ya ne smogu priyti zavtra.","tr":"Yarın gelemeyeceğim."}]},
  {"id":"ru-vp-khotet-zakhotet","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"хотеть / захотеть","translations":{"tr":["istemek","canı çekmek"]},"partOfSpeech":"verb","details":{"reading":"khotét' / zakhotét'","usage":"хотеть: istemek (durum); захотеть: birden istemek, canı çekmek."},"examples":[{"text":"Я вдруг захотел мороженого.","reading":"Ya vdrug zakhotel morozhenogo.","tr":"Birden canım dondurma çekti."}]},
  {"id":"ru-vp-konchatsya-konchitsya","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"кончаться / кончиться","translations":{"tr":["bitmek","sona ermek"]},"partOfSpeech":"verb","details":{"reading":"konchát'sya / kónchit'sya","usage":"кончаться: bitmek üzere olmak; кончиться: bitmiş olmak."},"examples":[{"text":"Фильм уже кончился.","reading":"Fil'm uzhe konchilsya.","tr":"Film çoktan bitti."}]},
  {"id":"ru-vp-nachinatsya-nachatsya","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"начинаться / начаться","translations":{"tr":["başlamak (kendiliğinden)"]},"partOfSpeech":"verb","details":{"reading":"nachinát'sya / nachát'sya","usage":"Özne olay olur. начинаться: genelde başlamak; начаться: başlamış olmak."},"examples":[{"text":"Урок начался в десять.","reading":"Urok nachalsya v desyat'.","tr":"Ders onda başladı."}]},
  {"id":"ru-vp-idti-poyti","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"идти / пойти","translations":{"tr":["gitmek (yürüyerek)"]},"partOfSpeech":"verb","details":{"reading":"idtí / poytí","usage":"Hareket fiili. идти: şu an yolda olmak; пойти: yola çıkmak, gitmek (sonuç değil başlangıç)."},"examples":[{"text":"Вчера я пошёл в кино.","reading":"Vchera ya poshyol v kino.","tr":"Dün sinemaya gittim."}]}
