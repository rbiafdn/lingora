[
  {"id":"ru-vp-delat-sdelat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"делать / сделать","translations":{"tr":["yapmak"]},"partOfSpeech":"verb","details":{"reading":"délat' / sdélat'","usage":"делать: süreç ya da alışkanlık; сделать: işin bitip sonuç alınması."},"examples":[{"text":"Я уже сделал домашнее задание.","reading":"Ya uzhe sdelal domashneye zadaniye.","tr":"Ödevimi çoktan yaptım."}]},
  {"id":"ru-vp-chitat-prochitat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"читать / прочитать","translations":{"tr":["okumak"]},"partOfSpeech":"verb","details":{"reading":"chitát' / prochitát'","usage":"читать: okuma eylemi, süreç; прочитать: sonuna kadar okuyup bitirmek."},"examples":[{"text":"Вчера я читал весь вечер и прочитал книгу.","reading":"Vchera ya chital ves' vecher i prochital knigu.","tr":"Dün bütün akşam okudum ve kitabı bitirdim."}]},
  {"id":"ru-vp-pisat-napisat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"писать / написать","translations":{"tr":["yazmak"]},"partOfSpeech":"verb","details":{"reading":"pisát' / napisát'","usage":"писать: yazıyor olmak, yazma alışkanlığı; написать: yazıp bitirmek."},"examples":[{"text":"Напиши мне, когда приедешь.","reading":"Napishi mne, kogda priyedesh'.","tr":"Gelince bana yaz."}]},
  {"id":"ru-vp-govorit-skazat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"говорить / сказать","translations":{"tr":["söylemek","konuşmak"]},"partOfSpeech":"verb","details":{"reading":"govorít' / skazát'","usage":"говорить: konuşmak, genel söyleme; сказать: tek bir şeyi bir kez söylemek."},"examples":[{"text":"Скажите, пожалуйста, где метро?","reading":"Skazhite, pozhaluysta, gde metro?","tr":"Metro nerede, söyler misiniz?"}]},
  {"id":"ru-vp-brat-vzyat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"брать / взять","translations":{"tr":["almak"]},"partOfSpeech":"verb","details":{"reading":"brat' / vzyat'","usage":"брать: alışkanlık ya da tekrar; взять: belirli bir anda bir kez almak."},"examples":[{"text":"Возьми зонт, идёт дождь.","reading":"Voz'mi zont, idyot dozhd'.","tr":"Şemsiyeyi al, yağmur yağıyor."}]},
  {"id":"ru-vp-davat-dat","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"давать / дать","translations":{"tr":["vermek"]},"partOfSpeech":"verb","details":{"reading":"davát' / dat'","usage":"давать: düzenli/tekrar vermek; дать: bir kez verip tamamlamak. Дай! = Ver!"},"examples":[{"text":"Дай мне, пожалуйста, ручку.","reading":"Day mne, pozhaluysta, ruchku.","tr":"Bana kalemi verir misin?"}]},
