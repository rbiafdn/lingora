  {"id":"ru-vp-saditsya-sest","languageId":"ru","category":"verb-pairs","level":"A1","sourceText":"садиться / сесть","translations":{"tr":["oturmak (oturmaya geçmek)"]},"partOfSpeech":"verb","details":{"reading":"sadít'sya / sest'","usage":"садиться: oturuyor olmak, binmek; сесть: oturmak, bir kez binmek. Садитесь! = Buyurun oturun!"},"examples":[{"text":"Садитесь, пожалуйста.","reading":"Sadites', pozhaluysta.","tr":"Oturun lütfen."}]},
