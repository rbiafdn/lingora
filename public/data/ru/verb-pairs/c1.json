  {"id":"ru-vp-preumenshat-preumenshit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"преуменьшать / преуменьшить","translations":{"tr":["küçümsemek","olduğundan az göstermek"]},"partOfSpeech":"verb","details":{"reading":"preumen'shát' / preumén'shit'","usage":"преуменьшать: küçümsüyor olmak; преуменьшить: olduğundan az göstermiş olmak."},"examples":[{"text":"Не стоит преуменьшать риски.","reading":"Ne stoit preumen'shat' riski.","tr":"Riskleri küçümsememek gerek."}]},
  {"id":"ru-vp-ustupat-ustupit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"уступать / уступить","translations":{"tr":["yer vermek","boyun eğmek"]},"partOfSpeech":"verb","details":{"reading":"ustupát' / ustupít'","usage":"уступать: genelde yer vermek, geri kalmak; уступить: bir kez yer vermiş, taviz vermiş olmak."},"examples":[{"text":"Он уступил место пожилой женщине.","reading":"On ustupil mesto pozhiloy zhenshchine.","tr":"Yerini yaşlı bir kadına verdi."}]},
  {"id":"ru-vp-izlagat-izlozhit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"излагать / изложить","translations":{"tr":["açıklamak","anlatmak (yazılı)"]},"partOfSpeech":"verb","details":{"reading":"izlagát' / izlozhít'","usage":"излагать: aktarıyor olmak; изложить: görüşünü düzenli biçimde ortaya koymuş olmak."},"examples":[{"text":"Изложите суть дела кратко.","reading":"Izlozhite sut' dela kratko.","tr":"Meselenin özünü kısaca anlatın."}]},
  {"id":"ru-vp-obosnovyvat-obosnovat","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"обосновывать / обосновать","translations":{"tr":["gerekçelendirmek","temellendirmek"]},"partOfSpeech":"verb","details":{"reading":"obosnóvyvat' / obosnovát'","usage":"обосновывать: gerekçelendiriyor olmak; обосновать: gerekçesini ortaya koymuş olmak."},"examples":[{"text":"Автор хорошо обосновал свою позицию.","reading":"Avtor khorosho obosnoval svoyu pozitsiyu.","tr":"Yazar tutumunu iyi gerekçelendirdi."}]},
  {"id":"ru-vp-oprovergat-oprovergnut","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"опровергать / опровергнуть","translations":{"tr":["yalanlamak","çürütmek"]},"partOfSpeech":"verb","details":{"reading":"oprovergát' / oprovérgnut'","usage":"опровергать: yalanlıyor olmak; опровергнуть: kesin olarak çürütmüş olmak."},"examples":[{"text":"Министерство опровергло эти слухи.","reading":"Ministerstvo oproverglo eti slukhi.","tr":"Bakanlık bu söylentileri yalanladı."}]},
  {"id":"ru-vp-obnaruzhivat-obnaruzhit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"обнаруживать / обнаружить","translations":{"tr":["keşfetmek","tespit etmek"]},"partOfSpeech":"verb","details":{"reading":"obnarúzhivat' / obnarúzhit'","usage":"обнаруживать: zaman zaman ortaya çıkarmak; обнаружить: bir anda fark etmiş olmak."},"examples":[{"text":"Утром я обнаружил, что кошелёк пропал.","reading":"Utrom ya obnaruzhil, chto koshelyok propal.","tr":"Sabah cüzdanın kaybolduğunu fark ettim."}]},
  {"id":"ru-vp-vyyavlyat-vyyavit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"выявлять / выявить","translations":{"tr":["ortaya çıkarmak","tespit etmek"]},"partOfSpeech":"verb","details":{"reading":"vyyavlyát' / výyavit'","usage":"выявлять: tespit ediyor olmak (resmî); выявить: belirli bir şeyi ortaya çıkarmış olmak."},"examples":[{"text":"Проверка выявила серьёзные нарушения.","reading":"Proverka vyyavila ser'yoznyye narusheniya.","tr":"Denetim ciddi ihlaller ortaya çıkardı."}]},
  {"id":"ru-vp-iskazhat-iskazit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"искажать / исказить","translations":{"tr":["çarpıtmak"]},"partOfSpeech":"verb","details":{"reading":"iskazhát' / iskazít'","usage":"искажать: çarpıtıyor olmak; исказить: anlamı çarpıtmış olmak."},"examples":[{"text":"Журналист исказил мои слова.","reading":"Zhurnalist iskazil moi slova.","tr":"Gazeteci sözlerimi çarpıttı."}]},
  {"id":"ru-vp-navyazyvat-navyazat","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"навязывать / навязать","translations":{"tr":["dayatmak","zorla kabul ettirmek"]},"partOfSpeech":"verb","details":{"reading":"navyázyvat' / navyazát'","usage":"навязывать: dayatıp durmak; навязать: bir kez dayatmış olmak."},"examples":[{"text":"Не навязывай мне своё мнение.","reading":"Ne navyazyvay mne svoyo mneniye.","tr":"Bana fikrini dayatma."}]},
  {"id":"ru-vp-vdokhnovlyat-vdokhnovit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"вдохновлять / вдохновить","translations":{"tr":["ilham vermek"]},"partOfSpeech":"verb","details":{"reading":"vdokhnovlyát' / vdokhnovít'","usage":"вдохновлять: ilham kaynağı olmak; вдохновить: belirli bir esere ilham vermiş olmak."},"examples":[{"text":"Эта поездка вдохновила его на новую книгу.","reading":"Eta poyezdka vdokhnovila yego na novuyu knigu.","tr":"Bu gezi ona yeni bir kitap için ilham verdi."}]},
  {"id":"ru-vp-voploshchat-voplotit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"воплощать / воплотить","translations":{"tr":["hayata geçirmek","somutlaştırmak"]},"partOfSpeech":"verb","details":{"reading":"voploshchát' / voplotít'","usage":"воплощать: temsil etmek, cisimleştirmek; воплотить: fikri hayata geçirmiş olmak."},"examples":[{"text":"Архитектор воплотил свою идею в жизнь.","reading":"Arkhitektor voplotil svoyu ideyu v zhizn'.","tr":"Mimar fikrini hayata geçirdi."}]},
  {"id":"ru-vp-sovershenstvovat-usovershenstvovat","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"совершенствовать / усовершенствовать","translations":{"tr":["mükemmelleştirmek","geliştirmek"]},"partOfSpeech":"verb","details":{"reading":"sovershénstvovat' / usovershénstvovat'","usage":"совершенствовать: sürekli geliştirmek; усовершенствовать: belirli bir şeyi iyileştirmiş olmak."},"examples":[{"text":"Инженеры усовершенствовали двигатель.","reading":"Inzhenery usovershenstvovali dvigatel'.","tr":"Mühendisler motoru geliştirdi."}]},
  {"id":"ru-vp-ukreplyat-ukrepit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"укреплять / укрепить","translations":{"tr":["güçlendirmek","pekiştirmek"]},"partOfSpeech":"verb","details":{"reading":"ukreplyát' / ukrepít'","usage":"укреплять: güçlendiriyor olmak; укрепить: sağlamlaştırmış olmak."},"examples":[{"text":"Спорт укрепляет здоровье.","reading":"Sport ukreplyayet zdorov'ye.","tr":"Spor sağlığı güçlendirir."}]},
  {"id":"ru-vp-smyagchat-smyagchit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"смягчать / смягчить","translations":{"tr":["yumuşatmak","hafifletmek"]},"partOfSpeech":"verb","details":{"reading":"smyagchát' / smyagchít'","usage":"смягчать: yumuşatıyor olmak; смягчить: (cezayı, tonu) hafifletmiş olmak. 'гч' [хч] okunur."},"examples":[{"text":"Суд смягчил приговор.","reading":"Sud smyagchil prigovor.","tr":"Mahkeme cezayı hafifletti."}]},
  {"id":"ru-vp-usugublyat-usugubit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"усугублять / усугубить","translations":{"tr":["kötüleştirmek","ağırlaştırmak"]},"partOfSpeech":"verb","details":{"reading":"usugublyát' / usugubít'","usage":"усугублять: kötüleştiriyor olmak; усугубить: durumu daha da kötüleştirmiş olmak."},"examples":[{"text":"Ложь только усугубила ситуацию.","reading":"Lozh' tol'ko usugubila situatsiyu.","tr":"Yalan durumu daha da kötüleştirdi."}]},
  {"id":"ru-vp-ulazhivat-uladit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"улаживать / уладить","translations":{"tr":["halletmek","yoluna koymak"]},"partOfSpeech":"verb","details":{"reading":"ulázhivat' / uládit'","usage":"улаживать: halletmeye çalışmak; уладить: sorunu çözmüş olmak."},"examples":[{"text":"Не волнуйся, я всё улажу.","reading":"Ne volnuysya, ya vsyo ulazhu.","tr":"Merak etme, her şeyi hallederim."}]},
  {"id":"ru-vp-proyavlyat-proyavit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"проявлять / проявить","translations":{"tr":["göstermek (nitelik)","sergilemek"]},"partOfSpeech":"verb","details":{"reading":"proyavlyát' / proyavít'","usage":"проявлять: (ilgi, sabır) gösteriyor olmak; проявить: bir anda göstermiş olmak."},"examples":[{"text":"Он проявил настоящее мужество.","reading":"On proyavil nastoyashcheye muzhestvo.","tr":"Gerçek bir cesaret gösterdi."}]},
  {"id":"ru-vp-zatragivat-zatronut","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"затрагивать / затронуть","translations":{"tr":["değinmek","etkilemek"]},"partOfSpeech":"verb","details":{"reading":"zatrágivat' / zatrónut'","usage":"затрагивать: etkiliyor olmak; затронуть: bir konuya değinmiş, birine dokunmuş olmak."},"examples":[{"text":"Реформа затронет всех пенсионеров.","reading":"Reforma zatronet vsekh pensionerov.","tr":"Reform bütün emeklileri etkileyecek."}]},
  {"id":"ru-vp-vozlagat-vozlozhit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"возлагать / возложить","translations":{"tr":["yüklemek (sorumluluk)","bağlamak (umut)"]},"partOfSpeech":"verb","details":{"reading":"vozlagát' / vozlozhít'","usage":"возлагать надежды: umut bağlamak; возложить ответственность: sorumluluk yüklemiş olmak."},"examples":[{"text":"На него возложили всю ответственность.","reading":"Na nego vozlozhili vsyu otvetstvennost'.","tr":"Bütün sorumluluk ona yüklendi."}]},
  {"id":"ru-vp-pobuzhdat-pobudit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"побуждать / побудить","translations":{"tr":["teşvik etmek","sevk etmek"]},"partOfSpeech":"verb","details":{"reading":"pobuzhdát' / pobudít'","usage":"побуждать: teşvik ediyor olmak; побудить: birini bir şeye sevk etmiş olmak (к + yönelme)."},"examples":[{"text":"Что побудило вас сменить профессию?","reading":"Chto pobudilo vas smenit' professiyu?","tr":"Sizi meslek değiştirmeye ne sevk etti?"}]},
  {"id":"ru-vp-vynuzhdat-vynudit","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"вынуждать / вынудить","translations":{"tr":["zorlamak","mecbur bırakmak"]},"partOfSpeech":"verb","details":{"reading":"vynuzhdát' / výnudit'","usage":"вынуждать: zorluyor olmak; вынудить: mecbur bırakmış olmak. Я вынужден… = Mecburum…"},"examples":[{"text":"Обстоятельства вынудили нас уехать.","reading":"Obstoyatel'stva vynudili nas uyekhat'.","tr":"Koşullar bizi gitmeye mecbur bıraktı."}]},
  {"id":"ru-vp-sderzhivat-sderzhat","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"сдерживать / сдержать","translations":{"tr":["tutmak (söz)","dizginlemek"]},"partOfSpeech":"verb","details":{"reading":"sdérzhivat' / sderzhát'","usage":"сдерживать: zapt ediyor olmak; сдержать: sözünü tutmuş, kendini tutmuş olmak."},"examples":[{"text":"Он сдержал своё слово.","reading":"On sderzhal svoyo slovo.","tr":"Sözünü tuttu."}]},
  {"id":"ru-vp-ssylatsya-soslatsya","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"ссылаться / сослаться","translations":{"tr":["atıfta bulunmak","bahane etmek"]},"partOfSpeech":"verb","details":{"reading":"ssylát'sya / soslát'sya","usage":"ссылаться: atıf yapıyor olmak; сослаться: bir kaynağa/bahaneye dayanmış olmak (на + -i hâli)."},"examples":[{"text":"Он сослался на занятость.","reading":"On soslalsya na zanyatost'.","tr":"Meşguliyetini bahane etti."}]},
  {"id":"ru-vp-uklonyatsya-uklonitsya","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"уклоняться / уклониться","translations":{"tr":["kaçmak (görevden)","geçiştirmek"]},"partOfSpeech":"verb","details":{"reading":"uklonyát'sya / uklonít'sya","usage":"уклоняться: kaçınıp durmak; уклониться: bir kez kaçamak yapmış olmak (от + -in hâli)."},"examples":[{"text":"Он уклонился от прямого ответа.","reading":"On uklonilsya ot pryamogo otveta.","tr":"Doğrudan cevap vermekten kaçındı."}]},
  {"id":"ru-vp-podryvat-podorvat","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"подрывать / подорвать","translations":{"tr":["sarsmak","baltalamak"]},"partOfSpeech":"verb","details":{"reading":"podryvát' / podorvát'","usage":"подрывать: zayıflatıyor olmak; подорвать: (güveni, sağlığı) sarsmış olmak."},"examples":[{"text":"Скандал подорвал доверие к нему.","reading":"Skandal podorval doveriye k nemu.","tr":"Skandal ona olan güveni sarstı."}]}
