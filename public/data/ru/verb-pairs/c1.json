[
  {"id":"ru-vp-prenebregat-prenebrech","languageId":"ru","category":"verb-pairs","level":"C1","sourceText":"пренебрегать / пренебречь","translations":{"tr":["ihmal etmek","umursamamak"]},"partOfSpeech":"verb","details":{"reading":"prenebregát' / prenebréch'","usage":"пренебрегать: ihmal ediyor olmak (+ araç hâli); пренебречь: bir şeyi göz ardı etmiş olmak."},"examples":[{"text":"Он пренебрёг советом врача.","reading":"On prenebryog sovetom vracha.","tr":"Doktorun tavsiyesini umursamadı."}]},
