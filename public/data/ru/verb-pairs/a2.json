  {"id":"ru-vp-postupat-postupit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"поступать / поступить","translations":{"tr":["(okula) girmek","davranmak"]},"partOfSpeech":"verb","details":{"reading":"postupát' / postupít'","usage":"поступать: girmeye çalışmak, davranmak; поступить: kazanıp girmek."},"examples":[{"text":"Сестра поступила в университет.","reading":"Sestra postupila v universitet.","tr":"Kız kardeşim üniversiteyi kazandı."}]},
