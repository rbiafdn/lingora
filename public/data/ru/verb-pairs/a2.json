  {"id":"ru-vp-ostavatsya-ostatsya","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"оставаться / остаться","translations":{"tr":["kalmak"]},"partOfSpeech":"verb","details":{"reading":"ostavát'sya / ostát'sya","usage":"оставаться: genelde kalmak; остаться: belirli bir durumda kalmak."},"examples":[{"text":"Я останусь дома сегодня.","reading":"Ya ostanus' doma segodnya.","tr":"Bugün evde kalacağım."}]},
  {"id":"ru-vp-ostanavlivatsya-ostanovitsya","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"останавливаться / остановиться","translations":{"tr":["durmak","konaklamak"]},"partOfSpeech":"verb","details":{"reading":"ostanávlivat'sya / ostanovít'sya","usage":"останавливаться: genelde durmak, konaklamak; остановиться: bir kez durmak."},"examples":[{"text":"Автобус остановился у школы.","reading":"Avtobus ostanovilsya u shkoly.","tr":"Otobüs okulun önünde durdu."}]},
  {"id":"ru-vp-toropitsya-potoropitsya","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"торопиться / поторопиться","translations":{"tr":["acele etmek"]},"partOfSpeech":"verb","details":{"reading":"toropít'sya / potoropít'sya","usage":"торопиться: acele ediyor olmak; поторопиться: (bir kez) acele etmek, hızlanmak."},"examples":[{"text":"Поторопись, мы опаздываем!","reading":"Potoropis', my opazdyvayem!","tr":"Acele et, geç kalıyoruz!"}]},
  {"id":"ru-vp-uspevat-uspet","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"успевать / успеть","translations":{"tr":["yetişmek","zamanında yapabilmek"]},"partOfSpeech":"verb","details":{"reading":"uspevát' / uspét'","usage":"успевать: genelde yetişmek; успеть: belirli bir işe/araca yetişmek."},"examples":[{"text":"Мы успели на последний поезд.","reading":"My uspeli na posledniy poyezd.","tr":"Son trene yetiştik."}]},
  {"id":"ru-vp-sobirat-sobrat","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"собирать / собрать","translations":{"tr":["toplamak","biriktirmek"]},"partOfSpeech":"verb","details":{"reading":"sobirát' / sobrát'","usage":"собирать: toplamak, koleksiyon yapmak; собрать: toplayıp bitirmek (bavul vb.)."},"examples":[{"text":"Ты уже собрал чемодан?","reading":"Ty uzhe sobral chemodan?","tr":"Bavulunu topladın mı?"}]},
  {"id":"ru-vp-sobiratsya-sobratsya","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"собираться / собраться","translations":{"tr":["toplanmak","niyetlenmek","hazırlanmak"]},"partOfSpeech":"verb","details":{"reading":"sobirát'sya / sobrát'sya","usage":"собираться: niyetinde olmak, hazırlanmak; собраться: toplanmış/hazırlanmış olmak."},"examples":[{"text":"Вечером мы собрались у Ани.","reading":"Vecherom my sobralis' u Ani.","tr":"Akşam Anya'da toplandık."}]},
  {"id":"ru-vp-pereyezzhat-pereyekhat","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"переезжать / переехать","translations":{"tr":["taşınmak"]},"partOfSpeech":"verb","details":{"reading":"pereyezzhát' / pereyékhat'","usage":"переезжать: taşınıyor olmak; переехать: taşınmış olmak."},"examples":[{"text":"Мы переехали в новую квартиру.","reading":"My pereyekhali v novuyu kvartiru.","tr":"Yeni bir daireye taşındık."}]},
  {"id":"ru-vp-provodit-provesti","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"проводить / провести","translations":{"tr":["geçirmek (zaman)","düzenlemek"]},"partOfSpeech":"verb","details":{"reading":"provodít' / provestí","usage":"проводить: genelde zaman geçirmek; провести: belirli bir zamanı geçirmiş olmak."},"examples":[{"text":"Где вы провели отпуск?","reading":"Gde vy proveli otpusk?","tr":"İzninizi nerede geçirdiniz?"}]},
  {"id":"ru-vp-tratit-potratit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"тратить / потратить","translations":{"tr":["harcamak"]},"partOfSpeech":"verb","details":{"reading":"trátit' / potrátit'","usage":"тратить: harcayıp durmak; потратить: belirli bir miktarı harcamış olmak."},"examples":[{"text":"Я потратил все деньги.","reading":"Ya potratil vse den'gi.","tr":"Bütün parayı harcadım."}]},
  {"id":"ru-vp-zarabatyvat-zarabotat","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"зарабатывать / заработать","translations":{"tr":["kazanmak (para)"]},"partOfSpeech":"verb","details":{"reading":"zarabátyvat' / zarabótat'","usage":"зарабатывать: düzenli kazanmak; заработать: belirli bir miktar kazanmış olmak."},"examples":[{"text":"Сколько ты зарабатываешь?","reading":"Skol'ko ty zarabatyvayesh'?","tr":"Ne kadar kazanıyorsun?"}]},
  {"id":"ru-vp-obeshchat-poobeshchat","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"обещать / пообещать","translations":{"tr":["söz vermek"]},"partOfSpeech":"verb","details":{"reading":"obeshchát' / poobeshchát'","usage":"обещать: söz vermek (iki görünüşte de kullanılır); пообещать: bir kez söz vermiş olmak."},"examples":[{"text":"Он пообещал позвонить.","reading":"On poobeshchal pozvonit'.","tr":"Aramaya söz verdi."}]},
  {"id":"ru-vp-otpravlyat-otpravit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"отправлять / отправить","translations":{"tr":["göndermek"]},"partOfSpeech":"verb","details":{"reading":"otpravlyát' / otprávit'","usage":"отправлять: düzenli göndermek; отправить: bir kez göndermek (mesaj, paket)."},"examples":[{"text":"Я отправил тебе сообщение.","reading":"Ya otpravil tebe soobshcheniye.","tr":"Sana mesaj gönderdim."}]},
  {"id":"ru-vp-darit-podarit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"дарить / подарить","translations":{"tr":["hediye etmek"]},"partOfSpeech":"verb","details":{"reading":"darít' / podarít'","usage":"дарить: genelde hediye vermek; подарить: bir kez hediye etmiş olmak."},"examples":[{"text":"Что тебе подарили на день рождения?","reading":"Chto tebe podarili na den' rozhdeniya?","tr":"Doğum gününde sana ne hediye ettiler?"}]},
  {"id":"ru-vp-pozdravlyat-pozdravit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"поздравлять / поздравить","translations":{"tr":["kutlamak","tebrik etmek"]},"partOfSpeech":"verb","details":{"reading":"pozdravlyát' / pozdrávit'","usage":"поздравлять: kutluyor olmak, her yıl kutlamak; поздравить: bir kez kutlamak."},"examples":[{"text":"Поздравляю с днём рождения!","reading":"Pozdravlyayu s dnyom rozhdeniya!","tr":"Doğum günün kutlu olsun!"}]},
  {"id":"ru-vp-blagodarit-poblagodarit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"благодарить / поблагодарить","translations":{"tr":["teşekkür etmek"]},"partOfSpeech":"verb","details":{"reading":"blagodarít' / poblagodarít'","usage":"благодарить: teşekkür ediyor olmak; поблагодарить: bir kez teşekkür etmek."},"examples":[{"text":"Я поблагодарил его за помощь.","reading":"Ya poblagodaril yego za pomoshch'.","tr":"Yardımı için ona teşekkür ettim."}]},
  {"id":"ru-vp-izvinyatsya-izvinitsya","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"извиняться / извиниться","translations":{"tr":["özür dilemek"]},"partOfSpeech":"verb","details":{"reading":"izvinyát'sya / izvinít'sya","usage":"извиняться: özür diliyor olmak; извиниться: bir kez özür dilemek."},"examples":[{"text":"Он извинился за опоздание.","reading":"On izvinilsya za opozdaniye.","tr":"Geç kaldığı için özür diledi."}]},
  {"id":"ru-vp-proshchat-prostit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"прощать / простить","translations":{"tr":["affetmek"]},"partOfSpeech":"verb","details":{"reading":"proshchát' / prostít'","usage":"прощать: genelde affetmek; простить: belirli bir şeyi affetmiş olmak. Прости! = Affet!"},"examples":[{"text":"Прости меня, пожалуйста.","reading":"Prosti menya, pozhaluysta.","tr":"Lütfen beni affet."}]},
  {"id":"ru-vp-proshchatsya-poproshchatsya","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"прощаться / попрощаться","translations":{"tr":["vedalaşmak"]},"partOfSpeech":"verb","details":{"reading":"proshchát'sya / poproshchát'sya","usage":"прощаться: vedalaşıyor olmak; попрощаться: vedalaşmış olmak."},"examples":[{"text":"Он ушёл, не попрощавшись.","reading":"On ushyol, ne poproshchavshis'.","tr":"Vedalaşmadan gitti."}]},
  {"id":"ru-vp-zdorovatsya-pozdorovatsya","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"здороваться / поздороваться","translations":{"tr":["selamlaşmak"]},"partOfSpeech":"verb","details":{"reading":"zdoróvat'sya / pozdoróvat'sya","usage":"здороваться: genelde selam vermek; поздороваться: bir kez selamlaşmak."},"examples":[{"text":"Он даже не поздоровался.","reading":"On dazhe ne pozdorovalsya.","tr":"Selam bile vermedi."}]},
  {"id":"ru-vp-tselovat-potselovat","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"целовать / поцеловать","translations":{"tr":["öpmek"]},"partOfSpeech":"verb","details":{"reading":"tselovát' / potselovát'","usage":"целовать: öpmek, süreç; поцеловать: bir kez öpmek."},"examples":[{"text":"Мама поцеловала сына.","reading":"Mama potselovala syna.","tr":"Anne oğlunu öptü."}]},
  {"id":"ru-vp-obnimat-obnyat","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"обнимать / обнять","translations":{"tr":["sarılmak","kucaklamak"]},"partOfSpeech":"verb","details":{"reading":"obnimát' / obnyát'","usage":"обнимать: sarılıyor olmak; обнять: bir kez sarılmak."},"examples":[{"text":"Обними меня!","reading":"Obnimi menya!","tr":"Sarıl bana!"}]},
  {"id":"ru-vp-verit-poverit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"верить / поверить","translations":{"tr":["inanmak"]},"partOfSpeech":"verb","details":{"reading":"vérit' / povérit'","usage":"верить: inanmak (durum); поверить: (bir söze) inanmak, ikna olmak."},"examples":[{"text":"Я не поверил своим глазам.","reading":"Ya ne poveril svoim glazam.","tr":"Gözlerime inanamadım."}]},
  {"id":"ru-vp-boyatsya-ispugatsya","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"бояться / испугаться","translations":{"tr":["korkmak"]},"partOfSpeech":"verb","details":{"reading":"boyát'sya / ispugát'sya","usage":"Tam çift değil: бояться = korkmak (durum); испугаться = bir anda korkmak, ürkmek."},"examples":[{"text":"Ребёнок испугался собаки.","reading":"Rebyonok ispugalsya sobaki.","tr":"Çocuk köpekten korktu."}]},
