  {"id":"ru-vp-varit-svarit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"варить / сварить","translations":{"tr":["kaynatmak","pişirmek"]},"partOfSpeech":"verb","details":{"reading":"varít' / svarít'","usage":"варить: haşlamak, pişiriyor olmak; сварить: pişirip bitirmek (çorba, kahve)."},"examples":[{"text":"Я сварил кофе.","reading":"Ya svaril kofe.","tr":"Kahve yaptım."}]},
  {"id":"ru-vp-zharit-pozharit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"жарить / пожарить","translations":{"tr":["kızartmak"]},"partOfSpeech":"verb","details":{"reading":"zhárit' / pozhárit'","usage":"жарить: kızartıyor olmak; пожарить: kızartıp bitirmek."},"examples":[{"text":"Пожарь картошку.","reading":"Pozhar' kartoshku.","tr":"Patates kızart."}]},
  {"id":"ru-vp-pech-ispech","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"печь / испечь","translations":{"tr":["(fırında) pişirmek"]},"partOfSpeech":"verb","details":{"reading":"pech' / ispéch'","usage":"печь: fırında pişirmek, süreç; испечь: pişirip bitirmek (pasta, ekmek)."},"examples":[{"text":"Бабушка испекла пироги.","reading":"Babushka ispekla pirogi.","tr":"Büyükannem börek pişirdi."}]},
  {"id":"ru-vp-rezat-razrezat","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"резать / разрезать","translations":{"tr":["kesmek"]},"partOfSpeech":"verb","details":{"reading":"rézat' / razrézat'","usage":"резать: kesmek, doğramak; разрезать: kesip parçalara ayırmak."},"examples":[{"text":"Разрежь торт на восемь кусков.","reading":"Razrezh' tort na vosem' kuskov.","tr":"Pastayı sekiz parçaya kes."}]},
  {"id":"ru-vp-nalivat-nalit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"наливать / налить","translations":{"tr":["doldurmak (sıvı)"]},"partOfSpeech":"verb","details":{"reading":"nalivát' / nalít'","usage":"наливать: dolduruyor olmak; налить: bir kez doldurmak."},"examples":[{"text":"Налей мне чаю.","reading":"Naley mne chayu.","tr":"Bana çay doldur."}]},
  {"id":"ru-vp-padat-upast","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"падать / упасть","translations":{"tr":["düşmek"]},"partOfSpeech":"verb","details":{"reading":"pádat' / upást'","usage":"падать: düşmek, düşüyor olmak (kar yağmak); упасть: bir kez düşmek."},"examples":[{"text":"Он упал и ушиб колено.","reading":"On upal i ushib koleno.","tr":"Düştü ve dizini vurdu."}]},
  {"id":"ru-vp-veshat-povesit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"вешать / повесить","translations":{"tr":["asmak"]},"partOfSpeech":"verb","details":{"reading":"véshat' / povésit'","usage":"вешать: genelde asmak; повесить: bir kez asmak."},"examples":[{"text":"Повесь куртку в шкаф.","reading":"Poves' kurtku v shkaf.","tr":"Montunu dolaba as."}]},
  {"id":"ru-vp-uznavat-uznat","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"узнавать / узнать","translations":{"tr":["öğrenmek (bilgi)","tanımak"]},"partOfSpeech":"verb","details":{"reading":"uznavát' / uznát'","usage":"узнавать: öğrenmeye çalışmak, sık tanımak; узнать: öğrenmiş olmak, tanımak."},"examples":[{"text":"Я сразу узнал его голос.","reading":"Ya srazu uznal yego golos.","tr":"Sesini hemen tanıdım."}]},
  {"id":"ru-vp-prokhodit-proyti","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"проходить / пройти","translations":{"tr":["geçmek","geçip gitmek"]},"partOfSpeech":"verb","details":{"reading":"prokhodít' / proytí","usage":"проходить: geçiyor olmak; пройти: geçmiş olmak. Проходите! = Buyurun, içeri geçin!"},"examples":[{"text":"Как пройти к музею?","reading":"Kak proyti k muzeyu?","tr":"Müzeye nasıl gidilir?"}]},
  {"id":"ru-vp-kormit-nakormit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"кормить / накормить","translations":{"tr":["beslemek","yedirmek"]},"partOfSpeech":"verb","details":{"reading":"kormít' / nakormít'","usage":"кормить: besliyor olmak, düzenli beslemek; накормить: doyurmuş olmak."},"examples":[{"text":"Ты накормил кошку?","reading":"Ty nakormil koshku?","tr":"Kediyi besledin mi?"}]},
  {"id":"ru-vp-chistit-pochistit","languageId":"ru","category":"verb-pairs","level":"A2","sourceText":"чистить / почистить","translations":{"tr":["temizlemek","fırçalamak","soymak"]},"partOfSpeech":"verb","details":{"reading":"chístit' / pochístit'","usage":"чистить: temizliyor olmak, her gün fırçalamak; почистить: temizleyip bitirmek."},"examples":[{"text":"Почисти зубы перед сном.","reading":"Pochisti zuby pered snom.","tr":"Yatmadan önce dişlerini fırçala."}]}
