  {"id":"ru-vp-predlagat-predlozhit","languageId":"ru","category":"verb-pairs","level":"B1","sourceText":"предлагать / предложить","translations":{"tr":["önermek","teklif etmek"]},"partOfSpeech":"verb","details":{"reading":"predlagát' / predlozhít'","usage":"предлагать: öneride bulunuyor olmak; предложить: bir kez teklif etmek (evlilik dahil)."},"examples":[{"text":"Он предложил мне работу.","reading":"On predlozhil mne rabotu.","tr":"Bana iş teklif etti."}]},
