  {"id":"ru-abc-ikanye","languageId":"ru","category":"alphabet","level":"A2","sourceText":"Vurgusuz е, я → i","translations":{"tr":["vurgusuz e/ya, i'ye yakın"]},"details":{"reading":"ikánye","letterName":"иканье","usage":"Vurgulu heceden önce е ve я çoğunlukla kısa bir \"i\" gibi okunur."},"examples":[{"text":"сестра","reading":"sistrá","tr":"kız kardeş"}]},
  {"id":"ru-abc-sert-ve-yumusak-unsuzler","languageId":"ru","category":"alphabet","level":"A2","sourceText":"Sert ve yumuşak ünsüzler","translations":{"tr":["kalın/ince ünsüz"]},"details":{"reading":"tvyórdye / myágkiye","letterName":"твёрдые и мягкие","usage":"а, о, у, ы, э önünde ünsüz sert; е, ё, и, ю, я, ь önünde yumuşak (hafif y'li) okunur."},"examples":[{"text":"мат – мать","reading":"mat – mat'","tr":"mat (satrançta) – anne"}]},
  {"id":"ru-abc-hep-sert-hep-yumusak-unsuzler","languageId":"ru","category":"alphabet","level":"A2","sourceText":"Hep sert / hep yumuşak ünsüzler","translations":{"tr":["değişmeyen ünsüzler"]},"details":{"reading":"zh, sh, ts / ch, shch, y","letterName":"ж ш ц / ч щ й","usage":"ж, ш, ц hep sert, ч, щ, й hep yumuşaktır; bu yüzden жи, ши \"jı, şı\" diye okunur."},"examples":[{"text":"жизнь","reading":"zhizn'","tr":"hayat"}]},
  {"id":"ru-abc-yo","languageId":"ru","category":"alphabet","level":"A2","sourceText":"Ё her zaman vurguludur","translations":{"tr":["ё vurguyu gösterir"]},"details":{"reading":"yo","letterName":"ё","usage":"ё varsa vurgu oradadır; noktasız е yazılsa da \"yo\" okunur: всё \"fsyo\", все \"fsye\"."},"examples":[{"text":"всё","reading":"fsyo","tr":"her şey, hepsi"}]},
  {"id":"ru-abc-sonda-unsuz-sertlesmesi","languageId":"ru","category":"alphabet","level":"A2","sourceText":"Sonda ünsüz sertleşmesi","translations":{"tr":["sonda sert okuma"]},"details":{"reading":"b→p, d→t, g→k","letterName":"оглушение","usage":"Kelime sonunda б, в, г, д, ж, з sert eşi gibi okunur: п, ф, к, т, ш, с."},"examples":[{"text":"хлеб","reading":"khlyep","tr":"ekmek"}]},
  {"id":"ru-abc-ova-yeva","languageId":"ru","category":"alphabet","level":"A2","sourceText":"-ого / -его eklerinde г = v","translations":{"tr":["g, v okunur"]},"details":{"reading":"-óva / -yeva","letterName":"г → в","usage":"-ого, -его eklerinde г \"v\" okunur: сегодня \"sivódnya\", его \"yivó\"."},"examples":[{"text":"сегодня","reading":"sivódnya","tr":"bugün"}]}
