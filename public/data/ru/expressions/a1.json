  {"id":"ru-expr-u-menya-yest","languageId":"ru","category":"expressions","level":"A1","sourceText":"у меня есть","translations":{"tr":["benim … var"]},"tags":["structure"],"details":{"reading":"u menyá yest'","usage":"Rusçada sahiplik böyle kurulur; sahip olunan şey yalın hâlde.","register":"neutral"},"examples":[{"text":"У меня есть брат и сестра.","reading":"U menya yest' brat i sestra.","tr":"Bir erkek ve bir kız kardeşim var."}]},
