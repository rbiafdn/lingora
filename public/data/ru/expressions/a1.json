[
  {"id":"ru-expr-spasibo-za","languageId":"ru","category":"expressions","level":"A1","sourceText":"спасибо за…","translations":{"tr":["… için teşekkürler"]},"tags":["politeness"],"details":{"reading":"spasíbo za…","usage":"за'dan sonra isim -i hâlinde (винительный) gelir.","register":"neutral"},"examples":[{"text":"Спасибо за помощь.","reading":"Spasibo za pomoshch'.","tr":"Yardımın için teşekkürler."}]},
  {"id":"ru-expr-ne-za-chto","languageId":"ru","category":"expressions","level":"A1","sourceText":"не за что","translations":{"tr":["rica ederim","bir şey değil"]},"tags":["politeness"],"details":{"reading":"né za chto","usage":"Teşekküre en yaygın cevap; vurgu не'nin üstünde.","register":"neutral"},"examples":[{"text":"Спасибо! — Не за что.","reading":"Spasibo! — Ne za chto.","tr":"Teşekkürler! — Bir şey değil."}]},
  {"id":"ru-expr-izvinite-pozhaluysta","languageId":"ru","category":"expressions","level":"A1","sourceText":"извините, пожалуйста","translations":{"tr":["affedersiniz","özür dilerim"]},"tags":["politeness"],"details":{"reading":"izviníte, pozháluysta","usage":"Birine seslenirken ya da kibarca özür dilerken; samimisi извини.","register":"neutral"},"examples":[{"text":"Извините, пожалуйста, где метро?","reading":"Izvinite, pozhaluysta, gde metro?","tr":"Affedersiniz, metro nerede?"}]},
  {"id":"ru-expr-spasibo-ne-nado","languageId":"ru","category":"expressions","level":"A1","sourceText":"спасибо, не надо","translations":{"tr":["teşekkürler, gerek yok"]},"tags":["politeness"],"details":{"reading":"spasíbo, ne nádo","usage":"Bir teklifi kibarca reddetmek için.","register":"neutral"},"examples":[{"text":"Вам пакет нужен? — Спасибо, не надо.","reading":"Vam paket nuzhen? — Spasibo, ne nado.","tr":"Poşet ister misiniz? — Teşekkürler, gerek yok."}]},
  {"id":"ru-expr-menya-zovut","languageId":"ru","category":"expressions","level":"A1","sourceText":"меня зовут…","translations":{"tr":["benim adım …"]},"tags":["introduction"],"details":{"reading":"menyá zovút…","usage":"Kelimesi kelimesine: beni … diye çağırıyorlar.","register":"neutral"},"examples":[{"text":"Меня зовут Айше.","reading":"Menya zovut Ayshe.","tr":"Benim adım Ayşe."}]},
  {"id":"ru-expr-kak-vas-zovut","languageId":"ru","category":"expressions","level":"A1","sourceText":"как вас зовут?","translations":{"tr":["adınız ne?"]},"tags":["introduction"],"details":{"reading":"kak vas zovút?","usage":"Samimisi: как тебя зовут?","register":"neutral"},"examples":[{"text":"Простите, как вас зовут?","reading":"Prostite, kak vas zovut?","tr":"Affedersiniz, adınız ne?"}]},
  {"id":"ru-expr-mne-let","languageId":"ru","category":"expressions","level":"A1","sourceText":"мне … лет","translations":{"tr":["… yaşındayım"]},"tags":["introduction"],"details":{"reading":"mne … let","usage":"Yaş yönelme hâliyle söylenir; 1 → год, 2–4 → года, 5+ → лет.","register":"neutral"},"examples":[{"text":"Мне двадцать пять лет.","reading":"Mne dvadtsat' pyat' let.","tr":"Yirmi beş yaşındayım."}]},
  {"id":"ru-expr-ya-iz","languageId":"ru","category":"expressions","level":"A1","sourceText":"я из…","translations":{"tr":["… liyim","… den geliyorum"]},"tags":["introduction"],"details":{"reading":"ya iz…","usage":"из'den sonra isim -in hâlinde (родительный): из Турции.","register":"neutral"},"examples":[{"text":"Я из Турции, из Стамбула.","reading":"Ya iz Turtsii, iz Stambula.","tr":"Türkiyeliyim, İstanbul'danım."}]},
  {"id":"ru-expr-ya-ne-ponimayu","languageId":"ru","category":"expressions","level":"A1","sourceText":"я не понимаю","translations":{"tr":["anlamıyorum"]},"tags":["communication"],"details":{"reading":"ya ne ponimáyu","usage":"Konuşmada en çok işe yarayan kalıplardan.","register":"neutral"},"examples":[{"text":"Извините, я не понимаю.","reading":"Izvinite, ya ne ponimayu.","tr":"Pardon, anlamıyorum."}]},
  {"id":"ru-expr-povtorite-pozhaluysta","languageId":"ru","category":"expressions","level":"A1","sourceText":"повторите, пожалуйста","translations":{"tr":["tekrar eder misiniz"]},"tags":["communication"],"details":{"reading":"povtoríte, pozháluysta","usage":"Duyamadığında ya da anlamadığında.","register":"neutral"},"examples":[{"text":"Повторите, пожалуйста, ваш номер.","reading":"Povtorite, pozhaluysta, vash nomer.","tr":"Numaranızı tekrar eder misiniz?"}]},
  {"id":"ru-expr-govorite-medlenneye-pozhaluysta","languageId":"ru","category":"expressions","level":"A1","sourceText":"говорите медленнее, пожалуйста","translations":{"tr":["daha yavaş konuşun lütfen"]},"tags":["communication"],"details":{"reading":"govoríte médlenneye, pozháluysta","usage":"Konuşmada помедленнее (biraz daha yavaş) da çok yaygın.","register":"neutral"},"examples":[{"text":"Я плохо понимаю. Говорите медленнее, пожалуйста.","reading":"Ya plokho ponimayu. Govorite medlenneye, pozhaluysta.","tr":"Pek anlamıyorum. Daha yavaş konuşun lütfen."}]},
  {"id":"ru-expr-vy-govorite-po-angliyski","languageId":"ru","category":"expressions","level":"A1","sourceText":"вы говорите по-английски?","translations":{"tr":["İngilizce konuşuyor musunuz?"]},"tags":["communication"],"details":{"reading":"vy govoríte po-anglíyski?","usage":"Dil adları по- ile zarf olarak söylenir: по-турецки.","register":"neutral"},"examples":[{"text":"Извините, вы говорите по-английски?","reading":"Izvinite, vy govorite po-angliyski?","tr":"Affedersiniz, İngilizce konuşuyor musunuz?"}]},
  {"id":"ru-expr-ya-nemnogo-govoryu-po-russki","languageId":"ru","category":"expressions","level":"A1","sourceText":"я немного говорю по-русски","translations":{"tr":["biraz Rusça konuşuyorum"]},"tags":["communication"],"details":{"reading":"ya nemnógo govoryú po-rússki","usage":"Dil seviyeni söylerken; плохо (kötü) ile de kurulur.","register":"neutral"},"examples":[{"text":"Я немного говорю по-русски, но всё понимаю.","reading":"Ya nemnogo govoryu po-russki, no vsyo ponimayu.","tr":"Biraz Rusça konuşuyorum ama her şeyi anlıyorum."}]},
  {"id":"ru-expr-kak-skazat-po-russki","languageId":"ru","category":"expressions","level":"A1","sourceText":"как сказать … по-русски?","translations":{"tr":["… Rusça nasıl denir?"]},"tags":["communication"],"details":{"reading":"kak skazát' … po-rússki?","usage":"Bilmediğin kelimeyi sormak için.","register":"neutral"},"examples":[{"text":"Как сказать «kitap» по-русски?","reading":"Kak skazat' «kitap» po-russki?","tr":"«Kitap» Rusça nasıl denir?"}]},
