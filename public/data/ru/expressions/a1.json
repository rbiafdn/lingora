  {"id":"ru-expr-mozhno","languageId":"ru","category":"expressions","level":"A1","sourceText":"можно…?","translations":{"tr":["… olur mu?","… alabilir miyim?"]},"tags":["politeness"],"details":{"reading":"mózhno…?","usage":"İzin ve rica için çok yaygın; ardından mastar ya da isim gelir.","register":"neutral"},"examples":[{"text":"Можно воды?","reading":"Mozhno vody?","tr":"Biraz su alabilir miyim?"}]},
  {"id":"ru-expr-mne-kholodno","languageId":"ru","category":"expressions","level":"A1","sourceText":"мне холодно","translations":{"tr":["üşüyorum"]},"tags":["structure"],"details":{"reading":"mne khólodno","usage":"Duygu ve hâller мне + zarf ile söylenir: мне жарко, мне скучно.","register":"neutral"},"examples":[{"text":"Закрой окно, мне холодно.","reading":"Zakroy okno, mne kholodno.","tr":"Pencereyi kapat, üşüyorum."}]},
  {"id":"ru-expr-kotoryy-chas","languageId":"ru","category":"expressions","level":"A1","sourceText":"который час?","translations":{"tr":["saat kaç?"]},"tags":["time"],"details":{"reading":"kotóryy chas?","usage":"Konuşmada сколько времени? de aynı derecede yaygın.","register":"neutral"},"examples":[{"text":"Извините, который час?","reading":"Izvinite, kotoryy chas?","tr":"Affedersiniz, saat kaç?"}]},
  {"id":"ru-expr-skolko-vremeni","languageId":"ru","category":"expressions","level":"A1","sourceText":"сколько времени?","translations":{"tr":["saat kaç?"]},"tags":["time"],"details":{"reading":"skól'ko vrémeni?","usage":"Günlük konuşmada saat sormanın en yaygın yolu.","register":"informal"},"examples":[{"text":"Сколько времени? — Уже семь.","reading":"Skol'ko vremeni? — Uzhe sem'.","tr":"Saat kaç? — Yedi oldu bile."}]},
  {"id":"ru-expr-ya-dumayu-chto","languageId":"ru","category":"expressions","level":"A1","sourceText":"я думаю, что","translations":{"tr":["bence","… diye düşünüyorum"]},"tags":["opinion"],"details":{"reading":"ya dúmayu, chto","usage":"Görüş bildirmenin temel kalıbı; что atlanabilir.","register":"neutral"},"examples":[{"text":"Я думаю, что он прав.","reading":"Ya dumayu, chto on prav.","tr":"Bence o haklı."}]},
  {"id":"ru-expr-konechno","languageId":"ru","category":"expressions","level":"A1","sourceText":"конечно","translations":{"tr":["tabii","elbette"]},"tags":["discourse-marker"],"details":{"reading":"konéchno","usage":"Okunuşu «konéshno»; tek başına cevap olarak da kullanılır.","register":"neutral"},"examples":[{"text":"Ты придёшь? — Конечно!","reading":"Ty pridyosh'? — Konechno!","tr":"Gelecek misin? — Tabii ki!"}]},
