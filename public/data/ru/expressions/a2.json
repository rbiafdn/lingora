  {"id":"ru-expr-kak-obychno","languageId":"ru","category":"expressions","level":"A2","sourceText":"как обычно","translations":{"tr":["her zamanki gibi","her zamanki"]},"tags":["discourse-marker"],"details":{"reading":"kak obýchno","usage":"Kafede «her zamankinden» siparişinde de kullanılır.","register":"neutral"},"examples":[{"text":"Мне как обычно, пожалуйста.","reading":"Mne kak obychno, pozhaluysta.","tr":"Bana her zamankinden, lütfen."}]},
  {"id":"ru-expr-kak-vsegda","languageId":"ru","category":"expressions","level":"A2","sourceText":"как всегда","translations":{"tr":["her zamanki gibi","her zaman olduğu gibi"]},"tags":["discourse-marker"],"details":{"reading":"kak vsegdá","usage":"Bazen sitem bildirir: он, как всегда, опоздал.","register":"neutral"},"examples":[{"text":"Он, как всегда, опоздал.","reading":"On, kak vsegda, opozdal.","tr":"Her zamanki gibi geç kaldı."}]},
  {"id":"ru-expr-nu-vot","languageId":"ru","category":"expressions","level":"A2","sourceText":"ну вот","translations":{"tr":["işte","işte böyle"]},"tags":["discourse-marker"],"details":{"reading":"nu vot","usage":"Bir şeyin bittiğini ya da sonucu bildirir.","register":"informal"},"examples":[{"text":"Ну вот, мы и дома.","reading":"Nu vot, my i doma.","tr":"İşte, evdeyiz."}]},
