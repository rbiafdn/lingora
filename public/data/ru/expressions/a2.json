  {"id":"ru-expr-znayesh-znayete","languageId":"ru","category":"expressions","level":"A2","sourceText":"знаешь / знаете","translations":{"tr":["biliyor musun","bak"]},"tags":["discourse-marker"],"details":{"reading":"znáyesh' / znáyete","usage":"Konuşma başında dikkat çekmek için dolgu sözü.","register":"neutral"},"examples":[{"text":"Знаешь, я давно хотел тебе сказать…","reading":"Znayesh', ya davno khotel tebe skazat'…","tr":"Biliyor musun, sana uzun zamandır söylemek istiyordum…"}]},
  {"id":"ru-expr-ya-ne-uveren-a","languageId":"ru","category":"expressions","level":"A2","sourceText":"я не уверен(а)","translations":{"tr":["emin değilim"]},"tags":["opinion"],"details":{"reading":"ya ne uvéren(a)","usage":"Kararsızlık bildirir.","register":"neutral"},"examples":[{"text":"Я не уверена, что это хорошая идея.","reading":"Ya ne uverena, chto eto khoroshaya ideya.","tr":"Bunun iyi bir fikir olduğundan emin değilim."}]},
  {"id":"ru-expr-ya-soglasen-soglasna","languageId":"ru","category":"expressions","level":"A2","sourceText":"я согласен / согласна","translations":{"tr":["katılıyorum","kabul"]},"tags":["opinion"],"details":{"reading":"ya soglásen / soglásna","usage":"Erkek согласен, kadın согласна der; с + araç hâli: согласен с тобой.","register":"neutral"},"examples":[{"text":"Я с тобой согласен.","reading":"Ya s toboy soglasen.","tr":"Sana katılıyorum."}]},
  {"id":"ru-expr-ya-ne-soglasen-ne-soglasna","languageId":"ru","category":"expressions","level":"A2","sourceText":"я не согласен / не согласна","translations":{"tr":["katılmıyorum"]},"tags":["opinion"],"details":{"reading":"ya ne soglásen / ne soglásna","usage":"Kibar itiraz için: я не совсем согласен.","register":"neutral"},"examples":[{"text":"Извини, но я не согласна.","reading":"Izvini, no ya ne soglasna.","tr":"Kusura bakma ama katılmıyorum."}]},
