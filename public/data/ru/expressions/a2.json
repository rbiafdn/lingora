  {"id":"ru-expr-navernoye","languageId":"ru","category":"expressions","level":"A2","sourceText":"наверное","translations":{"tr":["herhalde","muhtemelen"]},"tags":["discourse-marker"],"details":{"reading":"navérnoye","usage":"Konuşmada en yaygın tahmin sözü.","register":"neutral"},"examples":[{"text":"Наверное, завтра будет холодно.","reading":"Navernoye, zavtra budet kholodno.","tr":"Herhalde yarın soğuk olacak."}]},
  {"id":"ru-expr-vsyo-ravno","languageId":"ru","category":"expressions","level":"A2","sourceText":"всё равно","translations":{"tr":["yine de","nasılsa"]},"tags":["discourse-marker"],"details":{"reading":"vsyo ravnó","usage":"Мне всё равно ise «umurumda değil, fark etmez» demektir.","register":"neutral"},"examples":[{"text":"Я устал, но всё равно пойду.","reading":"Ya ustal, no vsyo ravno poydu.","tr":"Yorgunum ama yine de gideceğim."}]},
