[
  {"id":"ru-expr-yesli-mozhno","languageId":"ru","category":"expressions","level":"A2","sourceText":"если можно","translations":{"tr":["mümkünse","olursa"]},"tags":["politeness"],"details":{"reading":"yésli mózhno","usage":"Ricayı yumuşatır, cümle sonuna eklenir.","register":"neutral"},"examples":[{"text":"Чай без сахара, если можно.","reading":"Chay bez sakhara, yesli mozhno.","tr":"Mümkünse şekersiz çay."}]},
  {"id":"ru-expr-budte-dobry","languageId":"ru","category":"expressions","level":"A2","sourceText":"будьте добры","translations":{"tr":["rica etsem","lütfen"]},"tags":["politeness"],"details":{"reading":"búd'te dobrý","usage":"Пожалуйста'dan daha kibar bir rica kalıbı.","register":"formal"},"examples":[{"text":"Будьте добры, дайте мне меню.","reading":"Bud'te dobry, dayte mne menyu.","tr":"Rica etsem bana menüyü verir misiniz?"}]},
  {"id":"ru-expr-s-udovolstviyem","languageId":"ru","category":"expressions","level":"A2","sourceText":"с удовольствием","translations":{"tr":["memnuniyetle","seve seve"]},"tags":["politeness"],"details":{"reading":"s udovól'stviyem","usage":"Bir teklifi ya da daveti sevinerek kabul ederken.","register":"neutral"},"examples":[{"text":"Пойдёшь с нами в кино? — С удовольствием!","reading":"Poydyosh' s nami v kino? — S udovol'stviyem!","tr":"Bizimle sinemaya gelir misin? — Seve seve!"}]},
  {"id":"ru-expr-izvinite-za-opozdaniye","languageId":"ru","category":"expressions","level":"A2","sourceText":"извините за опоздание","translations":{"tr":["geç kaldığım için özür dilerim"]},"tags":["politeness"],"details":{"reading":"izviníte za opozdániye","usage":"Toplantıya, derse geç girerken.","register":"neutral"},"examples":[{"text":"Извините за опоздание, автобус не пришёл.","reading":"Izvinite za opozdaniye, avtobus ne prishyol.","tr":"Geç kaldığım için kusura bakmayın, otobüs gelmedi."}]},
  {"id":"ru-expr-k-sozhaleniyu","languageId":"ru","category":"expressions","level":"A2","sourceText":"к сожалению","translations":{"tr":["maalesef","ne yazık ki"]},"tags":["discourse-marker"],"details":{"reading":"k sozhaléniyu","usage":"Kötü bir haberi yumuşatır; virgülle ayrılır.","register":"neutral"},"examples":[{"text":"К сожалению, я не могу прийти.","reading":"K sozhaleniyu, ya ne mogu priyti.","tr":"Maalesef gelemiyorum."}]},
  {"id":"ru-expr-k-schastyu","languageId":"ru","category":"expressions","level":"A2","sourceText":"к счастью","translations":{"tr":["neyse ki","çok şükür"]},"tags":["discourse-marker"],"details":{"reading":"k schást'yu","usage":"Olumlu bir durumu belirtir; virgülle ayrılır.","register":"neutral"},"examples":[{"text":"К счастью, никто не пострадал.","reading":"K schast'yu, nikto ne postradal.","tr":"Neyse ki kimse yaralanmadı."}]},
  {"id":"ru-expr-mne-ochen-zhal","languageId":"ru","category":"expressions","level":"A2","sourceText":"мне очень жаль","translations":{"tr":["çok üzgünüm","çok yazık"]},"tags":["politeness"],"details":{"reading":"mne óchen' zhal'","usage":"Üzüntü ve taziye bildirirken.","register":"neutral"},"examples":[{"text":"Мне очень жаль, что так получилось.","reading":"Mne ochen' zhal', chto tak poluchilos'.","tr":"Böyle olduğu için çok üzgünüm."}]},
  {"id":"ru-expr-ya-by-khotel-a","languageId":"ru","category":"expressions","level":"A2","sourceText":"я бы хотел(а)","translations":{"tr":["… isterdim"]},"tags":["politeness"],"details":{"reading":"ya by khotél(a)","usage":"Хочу'nun kibar hâli; kadın konuşursa хотела.","register":"neutral"},"examples":[{"text":"Я бы хотел заказать столик.","reading":"Ya by khotel zakazat' stolik.","tr":"Bir masa ayırtmak isterdim."}]},
  {"id":"ru-expr-u-menya-bolit","languageId":"ru","category":"expressions","level":"A2","sourceText":"у меня болит…","translations":{"tr":["… ağrıyor"]},"tags":["health"],"details":{"reading":"u menyá bolít…","usage":"Ağrıyan yer yalın hâlde; çoğulda болят.","register":"neutral"},"examples":[{"text":"У меня болит голова.","reading":"U menya bolit golova.","tr":"Başım ağrıyor."}]},
  {"id":"ru-expr-ya-plokho-sebya-chuvstvuyu","languageId":"ru","category":"expressions","level":"A2","sourceText":"я плохо себя чувствую","translations":{"tr":["kendimi kötü hissediyorum"]},"tags":["health"],"details":{"reading":"ya plókho sebyá chúvstvuyu","usage":"Hastalık bildirirken; iyisi: я хорошо себя чувствую.","register":"neutral"},"examples":[{"text":"Я сегодня не приду, я плохо себя чувствую.","reading":"Ya segodnya ne pridu, ya plokho sebya chuvstvuyu.","tr":"Bugün gelmeyeceğim, kendimi kötü hissediyorum."}]},
  {"id":"ru-expr-kstati","languageId":"ru","category":"expressions","level":"A2","sourceText":"кстати","translations":{"tr":["bu arada","aklıma gelmişken"]},"tags":["discourse-marker"],"details":{"reading":"kstáti","usage":"Konuya yeni bir şey eklerken ya da konuyu değiştirirken.","register":"neutral"},"examples":[{"text":"Кстати, ты видел Олега?","reading":"Kstati, ty videl Olega?","tr":"Bu arada, Oleg'i gördün mü?"}]},
  {"id":"ru-expr-na-samom-dele","languageId":"ru","category":"expressions","level":"A2","sourceText":"на самом деле","translations":{"tr":["aslında","gerçekte"]},"tags":["discourse-marker"],"details":{"reading":"na sámom déle","usage":"Görünenin aksine olan gerçeği belirtir.","register":"neutral"},"examples":[{"text":"На самом деле он очень добрый.","reading":"Na samom dele on ochen' dobryy.","tr":"Aslında o çok iyi biridir."}]},
  {"id":"ru-expr-po-moyemu","languageId":"ru","category":"expressions","level":"A2","sourceText":"по-моему","translations":{"tr":["bence","bana göre"]},"tags":["opinion"],"details":{"reading":"po-móyemu","usage":"Kişisel görüş bildirmenin en yaygın yolu; virgülle ayrılır.","register":"neutral"},"examples":[{"text":"По-моему, это хорошая идея.","reading":"Po-moyemu, eto khoroshaya ideya.","tr":"Bence bu iyi bir fikir."}]},
  {"id":"ru-expr-mne-kazhetsya","languageId":"ru","category":"expressions","level":"A2","sourceText":"мне кажется","translations":{"tr":["bana öyle geliyor ki","sanırım"]},"tags":["opinion"],"details":{"reading":"mne kázhetsya","usage":"Emin olmadan, yumuşak görüş bildirirken.","register":"neutral"},"examples":[{"text":"Мне кажется, будет дождь.","reading":"Mne kazhetsya, budet dozhd'.","tr":"Bana öyle geliyor ki yağmur yağacak."}]},
