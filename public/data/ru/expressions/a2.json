  {"id":"ru-expr-vo-vtorykh","languageId":"ru","category":"expressions","level":"A2","sourceText":"во-вторых","translations":{"tr":["ikincisi","ikinci olarak"]},"tags":["structure"],"details":{"reading":"vo-vtorýkh","usage":"Во-первых'ten sonra ikinci gerekçe.","register":"neutral"},"examples":[{"text":"Во-вторых, у меня нет денег.","reading":"Vo-vtorykh, u menya net deneg.","tr":"İkincisi, hiç param yok."}]},
