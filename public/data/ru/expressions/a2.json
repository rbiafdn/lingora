  {"id":"ru-expr-a-takzhe","languageId":"ru","category":"expressions","level":"A2","sourceText":"а также","translations":{"tr":["ve ayrıca","bir de"]},"tags":["connector"],"details":{"reading":"a tákzhe","usage":"Listeye bir öge eklerken.","register":"neutral"},"examples":[{"text":"Купи хлеб, молоко, а также сыр.","reading":"Kupi khleb, moloko, a takzhe syr.","tr":"Ekmek, süt, bir de peynir al."}]},
