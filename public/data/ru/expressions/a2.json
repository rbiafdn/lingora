  {"id":"ru-expr-i-tak-daleye","languageId":"ru","category":"expressions","level":"A2","sourceText":"и так далее","translations":{"tr":["ve benzeri","vesaire"]},"tags":["structure"],"details":{"reading":"i tak dáleye","usage":"Yazıda kısaca и т. д.","register":"neutral"},"examples":[{"text":"Купи овощи: картошку, морковь и так далее.","reading":"Kupi ovoshchi: kartoshku, morkov' i tak daleye.","tr":"Sebze al: patates, havuç vesaire."}]}
