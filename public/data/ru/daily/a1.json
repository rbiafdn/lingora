  {"id":"ru-daily-vo-skolko","languageId":"ru","category":"daily","level":"A1","sourceText":"Во сколько?","translations":{"tr":["saat kaçta?"]},"details":{"reading":"Vo skól'ko?","register":"neutral","context":"Bir olayın saatini sorarken."},"examples":[{"text":"Встречаемся завтра. — Во сколько?","reading":"Vstrechayemsya zavtra. — Vo skol'ko?","tr":"Yarın buluşuyoruz. — Saat kaçta?"}]},
  {"id":"ru-daily-khochesh-kofe","languageId":"ru","category":"daily","level":"A1","sourceText":"Хочешь кофе?","translations":{"tr":["kahve ister misin?"]},"details":{"reading":"Khóchesh' kófe?","register":"informal","context":"İkram ederken; kibarı хотите кофе?"},"examples":[{"text":"Хочешь кофе? — Да, с молоком.","reading":"Khochesh' kofe? — Da, s molokom.","tr":"Kahve ister misin? — Evet, sütlü."}]},
  {"id":"ru-daily-gde-zdes-tualet","languageId":"ru","category":"daily","level":"A1","sourceText":"Где здесь туалет?","translations":{"tr":["tuvalet nerede?"]},"details":{"reading":"Gde zdes' tualét?","register":"neutral","context":"Kafe, restoran ve mağazada."},"examples":[{"text":"Извините, где здесь туалет?","reading":"Izvinite, gde zdes' tualet?","tr":"Affedersiniz, tuvalet nerede?"}]},
  {"id":"ru-daily-schyot-pozhaluysta","languageId":"ru","category":"daily","level":"A1","sourceText":"Счёт, пожалуйста.","translations":{"tr":["hesap lütfen"]},"details":{"reading":"Schyot, pozháluysta.","register":"neutral","context":"Restoranda hesabı isterken; можно счёт? de denir."},"examples":[{"text":"Девушка, счёт, пожалуйста!","reading":"Devushka, schyot, pozhaluysta!","tr":"Bakar mısınız, hesap lütfen!"}]},
  {"id":"ru-daily-eto-vsyo","languageId":"ru","category":"daily","level":"A1","sourceText":"Это всё.","translations":{"tr":["bu kadar","hepsi bu"]},"details":{"reading":"Éto vsyo.","register":"neutral","context":"Sipariş ya da alışveriş bitince."},"examples":[{"text":"Что-нибудь ещё? — Нет, это всё.","reading":"Chto-nibud' yeshchyo? — Net, eto vsyo.","tr":"Başka bir şey? — Hayır, bu kadar."}]},
  {"id":"ru-daily-mne-pozhaluysta","languageId":"ru","category":"daily","level":"A1","sourceText":"Мне, пожалуйста…","translations":{"tr":["bana … lütfen"]},"details":{"reading":"Mne, pozháluysta…","register":"neutral","context":"Sipariş verirken; ardından istenen şey -i hâlinde."},"examples":[{"text":"Мне, пожалуйста, борщ и чай.","reading":"Mne, pozhaluysta, borshch i chay.","tr":"Bana borş ve çay lütfen."}]},
  {"id":"ru-daily-ochen-vkusno","languageId":"ru","category":"daily","level":"A1","sourceText":"Очень вкусно!","translations":{"tr":["çok lezzetli!"]},"details":{"reading":"Óchen' vkúsno!","register":"neutral","context":"Yemeği övüp ev sahibine teşekkür ederken."},"examples":[{"text":"Спасибо, очень вкусно!","reading":"Spasibo, ochen' vkusno!","tr":"Teşekkürler, çok lezzetli!"}]},
  {"id":"ru-daily-uzhe-pozdno","languageId":"ru","category":"daily","level":"A1","sourceText":"Уже поздно.","translations":{"tr":["geç oldu","saat geç"]},"details":{"reading":"Uzhé pózdno.","register":"neutral","context":"Ayrılmak için gerekçe gösterirken."},"examples":[{"text":"Уже поздно, давай спать.","reading":"Uzhe pozdno, davay spat'.","tr":"Geç oldu, hadi yatalım."}]},
  {"id":"ru-daily-ya-ustal-ustala","languageId":"ru","category":"daily","level":"A1","sourceText":"Я устал / устала.","translations":{"tr":["yoruldum"]},"details":{"reading":"Ya ustál / ustála.","register":"neutral","context":"Yorgunluk bildirirken; erkek устал, kadın устала."},"examples":[{"text":"Я так устала, хочу спать.","reading":"Ya tak ustala, khochu spat'.","tr":"Çok yoruldum, uyumak istiyorum."}]},
  {"id":"ru-daily-pozvoni-mne","languageId":"ru","category":"daily","level":"A1","sourceText":"Позвони мне!","translations":{"tr":["beni ara!"]},"details":{"reading":"Pozvoní mne!","register":"informal","context":"Vedalaşırken ya da mesajda; kibarı позвоните мне."},"examples":[{"text":"Позвони мне, когда освободишься.","reading":"Pozvoni mne, kogda osvobodish'sya.","tr":"İşin bitince beni ara."}]},
  {"id":"ru-daily-allo","languageId":"ru","category":"daily","level":"A1","sourceText":"Алло!","translations":{"tr":["alo!"]},"details":{"reading":"Alló!","register":"neutral","context":"Telefonu açarken."},"examples":[{"text":"Алло! Кто это?","reading":"Allo! Kto eto?","tr":"Alo! Kim o?"}]},
  {"id":"ru-daily-vot-pozhaluysta","languageId":"ru","category":"daily","level":"A1","sourceText":"Вот, пожалуйста.","translations":{"tr":["buyurun","işte"]},"details":{"reading":"Vot, pozháluysta.","register":"neutral","context":"Bir şey verirken, örneğin para ya da belge."},"examples":[{"text":"Ваш паспорт? — Вот, пожалуйста.","reading":"Vash pasport? — Vot, pozhaluysta.","tr":"Pasaportunuz? — Buyurun."}]},
  {"id":"ru-daily-oy","languageId":"ru","category":"daily","level":"A1","sourceText":"Ой!","translations":{"tr":["ay!","eyvah!"]},"details":{"reading":"Oy!","register":"informal","context":"Ani şaşkınlık, acı ya da küçük bir hata."},"examples":[{"text":"Ой, я забыл телефон!","reading":"Oy, ya zabyl telefon!","tr":"Eyvah, telefonu unuttum!"}]},
  {"id":"ru-daily-oy-izvini","languageId":"ru","category":"daily","level":"A1","sourceText":"Ой, извини!","translations":{"tr":["ay, pardon!"]},"details":{"reading":"Oy, izviní!","register":"informal","context":"Birine çarpınca ya da küçük bir hata yapınca."},"examples":[{"text":"Ой, извини, я не заметил тебя.","reading":"Oy, izvini, ya ne zametil tebya.","tr":"Ay, pardon, seni fark etmedim."}]},
  {"id":"ru-daily-nu-poka","languageId":"ru","category":"daily","level":"A1","sourceText":"Ну, пока!","translations":{"tr":["hadi, hoşça kal!"]},"details":{"reading":"Nu, poká!","register":"informal","context":"Konuşmayı toparlayıp vedalaşırken."},"examples":[{"text":"Ну, пока! Увидимся в школе.","reading":"Nu, poka! Uvidimsya v shkole.","tr":"Hadi, hoşça kal! Okulda görüşürüz."}]}
