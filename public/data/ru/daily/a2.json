  {"id":"ru-daily-prostite","languageId":"ru","category":"daily","level":"A2","sourceText":"Простите?","translations":{"tr":["efendim?","pardon?"]},"details":{"reading":"Prostíte?","register":"neutral","context":"Duyamadığında kibarca tekrar isterken."},"examples":[{"text":"Простите? Я не расслышал.","reading":"Prostite? Ya ne rasslyshal.","tr":"Efendim? Duyamadım."}]},
  {"id":"ru-daily-minutochku","languageId":"ru","category":"daily","level":"A2","sourceText":"Минуточку!","translations":{"tr":["bir dakika!","bir saniye!"]},"details":{"reading":"Minútochku!","register":"neutral","context":"Birini kısa süre bekletirken."},"examples":[{"text":"Минуточку, я сейчас посмотрю.","reading":"Minutochku, ya seychas posmotryu.","tr":"Bir dakika, hemen bakıyorum."}]},
  {"id":"ru-daily-sekundochku","languageId":"ru","category":"daily","level":"A2","sourceText":"Секундочку!","translations":{"tr":["bir saniye!"]},"details":{"reading":"Sekúndochku!","register":"informal","context":"Минуточку ile aynı, daha samimi."},"examples":[{"text":"Секундочку, найду ручку.","reading":"Sekundochku, naydu ruchku.","tr":"Bir saniye, kalem bulayım."}]},
  {"id":"ru-daily-poshli","languageId":"ru","category":"daily","level":"A2","sourceText":"Пошли!","translations":{"tr":["hadi gidelim!","yürüyün!"]},"details":{"reading":"Poshlí!","register":"informal","context":"Birlikte bir yere gitmeyi önerirken."},"examples":[{"text":"Все готовы? Пошли!","reading":"Vse gotovy? Poshli!","tr":"Herkes hazır mı? Hadi gidelim!"}]},
  {"id":"ru-daily-poyekhali","languageId":"ru","category":"daily","level":"A2","sourceText":"Поехали!","translations":{"tr":["hadi gidelim!","başlayalım!"]},"details":{"reading":"Poyékhali!","register":"informal","context":"Araçla yola çıkarken ya da bir işe başlarken."},"examples":[{"text":"Садись в машину, поехали!","reading":"Sadis' v mashinu, poyekhali!","tr":"Arabaya bin, hadi gidelim!"}]},
  {"id":"ru-daily-vperyod","languageId":"ru","category":"daily","level":"A2","sourceText":"Вперёд!","translations":{"tr":["ileri!","hadi!"]},"details":{"reading":"Vperyód!","register":"neutral","context":"Cesaretlendirirken ya da harekete geçirirken."},"examples":[{"text":"Ну что, вперёд!","reading":"Nu chto, vperyod!","tr":"Eee, hadi bakalım!"}]},
  {"id":"ru-daily-vnimaniye","languageId":"ru","category":"daily","level":"A2","sourceText":"Внимание!","translations":{"tr":["dikkat!"]},"details":{"reading":"Vnimániye!","register":"neutral","context":"Anons ve duyurularda."},"examples":[{"text":"Внимание! Поезд отправляется.","reading":"Vnimaniye! Poyezd otpravlyayetsya.","tr":"Dikkat! Tren kalkıyor."}]},
  {"id":"ru-daily-tishe","languageId":"ru","category":"daily","level":"A2","sourceText":"Тише!","translations":{"tr":["sessiz olun!","daha sessiz!"]},"details":{"reading":"Tíshe!","register":"neutral","context":"Gürültü yapanları susturmak için; daha sert hâli тихо!"},"examples":[{"text":"Тише, ребёнок спит!","reading":"Tishe, rebyonok spit!","tr":"Sessiz olun, bebek uyuyor!"}]},
  {"id":"ru-daily-khvatit","languageId":"ru","category":"daily","level":"A2","sourceText":"Хватит!","translations":{"tr":["yeter!","kes artık!"]},"details":{"reading":"Khvátit!","register":"neutral","context":"Bir şeye son vermek için; yemekte «yeter, teşekkürler» de demek."},"examples":[{"text":"Хватит спорить!","reading":"Khvatit sporit'!","tr":"Tartışmayı kesin artık!"}]},
  {"id":"ru-daily-ne-volnuysya","languageId":"ru","category":"daily","level":"A2","sourceText":"Не волнуйся!","translations":{"tr":["merak etme!","endişelenme!"]},"details":{"reading":"Ne volnúysya!","register":"neutral","context":"Birini rahatlatırken; kibarı не волнуйтесь."},"examples":[{"text":"Не волнуйся, я скоро приду.","reading":"Ne volnuysya, ya skoro pridu.","tr":"Merak etme, birazdan gelirim."}]},
  {"id":"ru-daily-ne-perezhivay","languageId":"ru","category":"daily","level":"A2","sourceText":"Не переживай!","translations":{"tr":["dert etme!","üzülme!"]},"details":{"reading":"Ne perezhiváy!","register":"informal","context":"Üzgün birini teselli ederken."},"examples":[{"text":"Не переживай, в следующий раз получится.","reading":"Ne perezhivay, v sleduyushchiy raz poluchitsya.","tr":"Dert etme, bir dahaki sefere olur."}]},
  {"id":"ru-daily-nichego-strashnogo","languageId":"ru","category":"daily","level":"A2","sourceText":"Ничего страшного.","translations":{"tr":["önemli değil","bir şey olmaz"]},"details":{"reading":"Nichegó stráshnogo.","register":"neutral","context":"Özre ya da küçük bir kazaya verilen cevap."},"examples":[{"text":"Извините, я опоздал. — Ничего страшного.","reading":"Izvinite, ya opozdal. — Nichego strashnogo.","tr":"Pardon, geç kaldım. — Önemli değil."}]},
  {"id":"ru-daily-vsyo-budet-khorosho","languageId":"ru","category":"daily","level":"A2","sourceText":"Всё будет хорошо.","translations":{"tr":["her şey yoluna girecek"]},"details":{"reading":"Vsyo búdet khoroshó.","register":"neutral","context":"Teselli ederken."},"examples":[{"text":"Не плачь, всё будет хорошо.","reading":"Ne plach', vsyo budet khorosho.","tr":"Ağlama, her şey yoluna girecek."}]},
  {"id":"ru-daily-nevazhno","languageId":"ru","category":"daily","level":"A2","sourceText":"Неважно.","translations":{"tr":["önemli değil","boş ver"]},"details":{"reading":"Nevázhno.","register":"neutral","context":"Bir konuyu kapatırken."},"examples":[{"text":"Что ты сказал? — Неважно.","reading":"Chto ty skazal? — Nevazhno.","tr":"Ne dedin? — Boş ver."}]},
  {"id":"ru-daily-mne-vsyo-ravno","languageId":"ru","category":"daily","level":"A2","sourceText":"Мне всё равно.","translations":{"tr":["bana fark etmez","umurumda değil"]},"details":{"reading":"Mne vsyo ravnó.","register":"neutral","context":"Tercihi olmadığında; tona göre kayıtsızlık bildirir."},"examples":[{"text":"Чай или кофе? — Мне всё равно.","reading":"Chay ili kofe? — Mne vsyo ravno.","tr":"Çay mı kahve mi? — Bana fark etmez."}]},
  {"id":"ru-daily-v-chyom-delo","languageId":"ru","category":"daily","level":"A2","sourceText":"В чём дело?","translations":{"tr":["sorun ne?","ne oluyor?"]},"details":{"reading":"V chyom délo?","register":"neutral","context":"Bir durumun nedenini sorarken; tona göre sert de olabilir."},"examples":[{"text":"В чём дело? Почему вы кричите?","reading":"V chyom delo? Pochemu vy krichite?","tr":"Sorun ne? Neden bağırıyorsunuz?"}]},
  {"id":"ru-daily-chto-s-toboy","languageId":"ru","category":"daily","level":"A2","sourceText":"Что с тобой?","translations":{"tr":["neyin var?","sana ne oldu?"]},"details":{"reading":"Chto s tobóy?","register":"informal","context":"Birinin davranışı ya da hâli tuhafsa."},"examples":[{"text":"Ты какой-то грустный. Что с тобой?","reading":"Ty kakoy-to grustnyy. Chto s toboy?","tr":"Biraz üzgün görünüyorsun. Neyin var?"}]},
  {"id":"ru-daily-ty-v-poryadke","languageId":"ru","category":"daily","level":"A2","sourceText":"Ты в порядке?","translations":{"tr":["iyi misin?"]},"details":{"reading":"Ty v poryádke?","register":"informal","context":"Düşen, üzülen ya da kötü görünen birine."},"examples":[{"text":"Ты упал! Ты в порядке?","reading":"Ty upal! Ty v poryadke?","tr":"Düştün! İyi misin?"}]},
  {"id":"ru-daily-chem-zanimayeshsya","languageId":"ru","category":"daily","level":"A2","sourceText":"Чем занимаешься?","translations":{"tr":["ne iş yapıyorsun?","ne yapıyorsun?"]},"details":{"reading":"Chem zanimáyesh'sya?","register":"informal","context":"Meslek ya da o anki uğraşı sorarken."},"examples":[{"text":"А ты чем занимаешься? — Я программист.","reading":"A ty chem zanimayesh'sya? — Ya programmist.","tr":"Sen ne iş yapıyorsun? — Programcıyım."}]},
  {"id":"ru-daily-ty-zanyat","languageId":"ru","category":"daily","level":"A2","sourceText":"Ты занят?","translations":{"tr":["meşgul müsün?"]},"details":{"reading":"Ty zányat?","register":"informal","context":"Kadına ты занята?; kibarı вы заняты?"},"examples":[{"text":"Ты занят? Можно тебя на минутку?","reading":"Ty zanyat? Mozhno tebya na minutku?","tr":"Meşgul müsün? Bir dakika gelebilir misin?"}]},
  {"id":"ru-daily-mozhno-vopros","languageId":"ru","category":"daily","level":"A2","sourceText":"Можно вопрос?","translations":{"tr":["bir şey sorabilir miyim?"]},"details":{"reading":"Mózhno voprós?","register":"neutral","context":"Soru sormadan önce kibarca."},"examples":[{"text":"Извините, можно вопрос?","reading":"Izvinite, mozhno vopros?","tr":"Affedersiniz, bir şey sorabilir miyim?"}]},
  {"id":"ru-daily-kak-proshyol-den","languageId":"ru","category":"daily","level":"A2","sourceText":"Как прошёл день?","translations":{"tr":["günün nasıl geçti?"]},"details":{"reading":"Kak proshyól den'?","register":"neutral","context":"Akşam eve gelen birine."},"examples":[{"text":"Привет, дорогой! Как прошёл день?","reading":"Privet, dorogoy! Kak proshyol den'?","tr":"Selam canım! Günün nasıl geçti?"}]},
  {"id":"ru-daily-kak-vykhodnyye","languageId":"ru","category":"daily","level":"A2","sourceText":"Как выходные?","translations":{"tr":["hafta sonu nasıldı?"]},"details":{"reading":"Kak vykhodnýye?","register":"informal","context":"Pazartesi iş yerinde sık sorulur."},"examples":[{"text":"Как выходные? Куда-нибудь ездил?","reading":"Kak vykhodnyye? Kuda-nibud' yezdil?","tr":"Hafta sonu nasıldı? Bir yere gittin mi?"}]},
  {"id":"ru-daily-chto-budem-delat","languageId":"ru","category":"daily","level":"A2","sourceText":"Что будем делать?","translations":{"tr":["ne yapacağız?","ne yapalım?"]},"details":{"reading":"Chto búdem délat'?","register":"neutral","context":"Plan yaparken ya da bir sorun karşısında."},"examples":[{"text":"Поезд ушёл. Что будем делать?","reading":"Poyezd ushyol. Chto budem delat'?","tr":"Tren gitti. Ne yapacağız?"}]},
  {"id":"ru-daily-chto-budesh-pit","languageId":"ru","category":"daily","level":"A2","sourceText":"Что будешь пить?","translations":{"tr":["ne içersin?"]},"details":{"reading":"Chto búdesh' pit'?","register":"informal","context":"İçecek ikram ederken ya da sipariş öncesi."},"examples":[{"text":"Что будешь пить? Чай, сок?","reading":"Chto budesh' pit'? Chay, sok?","tr":"Ne içersin? Çay, meyve suyu?"}]},
  {"id":"ru-daily-chto-posovetuyete","languageId":"ru","category":"daily","level":"A2","sourceText":"Что посоветуете?","translations":{"tr":["ne önerirsiniz?"]},"details":{"reading":"Chto posovétuyete?","register":"neutral","context":"Restoranda ya da mağazada tavsiye isterken."},"examples":[{"text":"Я здесь первый раз. Что посоветуете?","reading":"Ya zdes' pervyy raz. Chto posovetuyete?","tr":"Buraya ilk kez geliyorum. Ne önerirsiniz?"}]},
  {"id":"ru-daily-sdachi-ne-nado","languageId":"ru","category":"daily","level":"A2","sourceText":"Сдачи не надо.","translations":{"tr":["üstü kalsın"]},"details":{"reading":"Sdáchi ne nádo.","register":"neutral","context":"Taksi ya da restoranda bahşiş bırakırken."},"examples":[{"text":"Вот пятьсот рублей, сдачи не надо.","reading":"Vot pyat'sot rubley, sdachi ne nado.","tr":"Buyurun beş yüz ruble, üstü kalsın."}]},
  {"id":"ru-daily-skolko-s-menya","languageId":"ru","category":"daily","level":"A2","sourceText":"Сколько с меня?","translations":{"tr":["borcum ne kadar?","ne kadar tuttu?"]},"details":{"reading":"Skól'ko s menyá?","register":"neutral","context":"Ödeme yaparken toplam tutarı sorarken."},"examples":[{"text":"Сколько с меня? — Триста рублей.","reading":"Skol'ko s menya? — Trista rubley.","tr":"Borcum ne kadar? — Üç yüz ruble."}]},
  {"id":"ru-daily-mozhno-kartoy","languageId":"ru","category":"daily","level":"A2","sourceText":"Можно картой?","translations":{"tr":["kartla ödeyebilir miyim?"]},"details":{"reading":"Mózhno kártoy?","register":"neutral","context":"Ödeme yöntemini sorarken; nakit: наличными."},"examples":[{"text":"Можно картой? — Да, конечно.","reading":"Mozhno kartoy? — Da, konechno.","tr":"Kartla ödeyebilir miyim? — Evet, tabii."}]},
  {"id":"ru-daily-paket-nuzhen","languageId":"ru","category":"daily","level":"A2","sourceText":"Пакет нужен?","translations":{"tr":["poşet ister misiniz?"]},"details":{"reading":"Pakét núzhen?","register":"neutral","context":"Kasiyerin sorduğu standart soru."},"examples":[{"text":"Пакет нужен? — Да, один, пожалуйста.","reading":"Paket nuzhen? — Da, odin, pozhaluysta.","tr":"Poşet ister misiniz? — Evet, bir tane lütfen."}]},
  {"id":"ru-daily-ya-prosto-smotryu","languageId":"ru","category":"daily","level":"A2","sourceText":"Я просто смотрю.","translations":{"tr":["sadece bakıyorum"]},"details":{"reading":"Ya prósto smotryú.","register":"neutral","context":"Mağazada satıcıya cevap."},"examples":[{"text":"Вам помочь? — Спасибо, я просто смотрю.","reading":"Vam pomoch'? — Spasibo, ya prosto smotryu.","tr":"Yardımcı olayım mı? — Teşekkürler, sadece bakıyorum."}]},
  {"id":"ru-daily-chto-nibud-yeshchyo","languageId":"ru","category":"daily","level":"A2","sourceText":"Что-нибудь ещё?","translations":{"tr":["başka bir şey?"]},"details":{"reading":"Chtó-nibud' yeshchyó?","register":"neutral","context":"Satıcı ya da garsonun sorusu."},"examples":[{"text":"Два кофе. — Что-нибудь ещё?","reading":"Dva kofe. — Chto-nibud' yeshchyo?","tr":"İki kahve. — Başka bir şey?"}]},
  {"id":"ru-daily-zdes-ili-s-soboy","languageId":"ru","category":"daily","level":"A2","sourceText":"Здесь или с собой?","translations":{"tr":["burada mı, paket mi?"]},"details":{"reading":"Zdes' íli s sobóy?","register":"neutral","context":"Kafede ve fast food'da kasiyer sorar."},"examples":[{"text":"Здесь или с собой? — С собой.","reading":"Zdes' ili s soboy? — S soboy.","tr":"Burada mı, paket mi? — Paket."}]},
  {"id":"ru-daily-zdes-svobodno","languageId":"ru","category":"daily","level":"A2","sourceText":"Здесь свободно?","translations":{"tr":["burası boş mu?"]},"details":{"reading":"Zdes' svobódno?","register":"neutral","context":"Boş bir yere oturmadan önce; cevabı занято (dolu) olabilir."},"examples":[{"text":"Извините, здесь свободно? — Нет, занято.","reading":"Izvinite, zdes' svobodno? — Net, zanyato.","tr":"Pardon, burası boş mu? — Hayır, dolu."}]},
  {"id":"ru-daily-mne-pora","languageId":"ru","category":"daily","level":"A2","sourceText":"Мне пора.","translations":{"tr":["gitmem lazım","benim vaktim geldi"]},"details":{"reading":"Mne porá.","register":"neutral","context":"Bir yerden ayrılırken."},"examples":[{"text":"Ой, уже десять. Мне пора.","reading":"Oy, uzhe desyat'. Mne pora.","tr":"Ay, saat on olmuş. Gitmem lazım."}]},
  {"id":"ru-daily-ya-poshyol-poshla","languageId":"ru","category":"daily","level":"A2","sourceText":"Я пошёл / пошла.","translations":{"tr":["ben gidiyorum","ben kaçtım"]},"details":{"reading":"Ya poshyól / poshlá.","register":"informal","context":"Evden ya da bir ortamdan ayrılırken; erkek пошёл, kadın пошла."},"examples":[{"text":"Ну всё, я пошёл. Пока!","reading":"Nu vsyo, ya poshyol. Poka!","tr":"Tamam, ben kaçtım. Görüşürüz!"}]},
  {"id":"ru-daily-ya-opazdyvayu","languageId":"ru","category":"daily","level":"A2","sourceText":"Я опаздываю!","translations":{"tr":["geç kalıyorum!"]},"details":{"reading":"Ya opázdyvayu!","register":"neutral","context":"Aceleyle çıkarken ya da telefonda haber verirken."},"examples":[{"text":"Извини, я опаздываю на десять минут.","reading":"Izvini, ya opazdyvayu na desyat' minut.","tr":"Kusura bakma, on dakika gecikiyorum."}]},
  {"id":"ru-daily-ya-skoro-budu","languageId":"ru","category":"daily","level":"A2","sourceText":"Я скоро буду.","translations":{"tr":["birazdan oradayım","yakında gelirim"]},"details":{"reading":"Ya skóro búdu.","register":"neutral","context":"Telefonda ya da mesajda varış haberi."},"examples":[{"text":"Я уже в метро, скоро буду.","reading":"Ya uzhe v metro, skoro budu.","tr":"Metrodayım, birazdan oradayım."}]},
  {"id":"ru-daily-seychas-vernus","languageId":"ru","category":"daily","level":"A2","sourceText":"Сейчас вернусь.","translations":{"tr":["hemen dönüyorum"]},"details":{"reading":"Seychás vernús'.","register":"neutral","context":"Kısa süreliğine ayrılırken."},"examples":[{"text":"Подожди здесь, я сейчас вернусь.","reading":"Podozhdi zdes', ya seychas vernus'.","tr":"Burada bekle, hemen dönüyorum."}]},
  {"id":"ru-daily-ya-goloden-golodna","languageId":"ru","category":"daily","level":"A2","sourceText":"Я голоден / голодна.","translations":{"tr":["acıktım","açım"]},"details":{"reading":"Ya góloden / golodná","register":"neutral","context":"Konuşmada daha sık: я хочу есть."},"examples":[{"text":"Пойдём поедим, я голоден.","reading":"Poydyom poyedim, ya goloden.","tr":"Hadi bir şeyler yiyelim, acıktım."}]},
  {"id":"ru-daily-napishi-mne","languageId":"ru","category":"daily","level":"A2","sourceText":"Напиши мне!","translations":{"tr":["bana yaz!","mesaj at!"]},"details":{"reading":"Napishí mne!","register":"informal","context":"Mesaj atmasını isterken."},"examples":[{"text":"Напиши мне, как доедешь.","reading":"Napishi mne, kak doyedesh'.","tr":"Varınca bana mesaj at."}]},
  {"id":"ru-daily-rad-pomoch","languageId":"ru","category":"daily","level":"A2","sourceText":"Рад помочь!","translations":{"tr":["yardımcı olabildiysem ne mutlu!"]},"details":{"reading":"Rad pomóch'!","register":"neutral","context":"Teşekküre cevap; kadın рада помочь."},"examples":[{"text":"Спасибо за совет! — Рад помочь!","reading":"Spasibo za sovet! — Rad pomoch'!","tr":"Tavsiye için teşekkürler! — Ne demek, rica ederim!"}]},
  {"id":"ru-daily-slushayu","languageId":"ru","category":"daily","level":"A2","sourceText":"Слушаю.","translations":{"tr":["buyurun, dinliyorum"]},"details":{"reading":"Slúshayu.","register":"neutral","context":"Telefonu açarken, özellikle iş yerinde."},"examples":[{"text":"Да, слушаю вас.","reading":"Da, slushayu vas.","tr":"Evet, buyurun, dinliyorum."}]},
  {"id":"ru-daily-kto-govorit","languageId":"ru","category":"daily","level":"A2","sourceText":"Кто говорит?","translations":{"tr":["kiminle görüşüyorum?"]},"details":{"reading":"Kto govorít?","register":"neutral","context":"Telefonda arayanı sorarken."},"examples":[{"text":"Алло, кто говорит?","reading":"Allo, kto govorit?","tr":"Alo, kiminle görüşüyorum?"}]},
  {"id":"ru-daily-ya-perezvonyu","languageId":"ru","category":"daily","level":"A2","sourceText":"Я перезвоню.","translations":{"tr":["seni sonra ararım","geri ararım"]},"details":{"reading":"Ya perezvonyú.","register":"neutral","context":"Telefonda konuşamayacak durumdayken."},"examples":[{"text":"Я на совещании, перезвоню позже.","reading":"Ya na soveshchanii, perezvonyu pozzhe.","tr":"Toplantıdayım, sonra ararım."}]},
  {"id":"ru-daily-nu-vsyo","languageId":"ru","category":"daily","level":"A2","sourceText":"Ну всё.","translations":{"tr":["tamam, bu kadar","hadi bakalım"]},"details":{"reading":"Nu vsyo.","register":"informal","context":"Bir konuşmayı ya da işi bitirirken; tehdit tonunda «artık yeter»."},"examples":[{"text":"Ну всё, я пошёл.","reading":"Nu vsyo, ya poshyol.","tr":"Tamam, ben gidiyorum."}]},
  {"id":"ru-daily-vot-i-vsyo","languageId":"ru","category":"daily","level":"A2","sourceText":"Вот и всё.","translations":{"tr":["işte bu kadar","hepsi bu"]},"details":{"reading":"Vot i vsyo.","register":"neutral","context":"Bir anlatıyı ya da işi bitirirken."},"examples":[{"text":"Нажми сюда — вот и всё.","reading":"Nazhmi syuda — vot i vsyo.","tr":"Buraya bas, işte bu kadar."}]},
  {"id":"ru-daily-slava-bogu","languageId":"ru","category":"daily","level":"A2","sourceText":"Слава богу!","translations":{"tr":["çok şükür!","Allah'a şükür!"]},"details":{"reading":"Sláva bógu!","register":"neutral","context":"Rahatlama bildirir; dinî olmayan konuşmada da yaygın."},"examples":[{"text":"Слава богу, все живы!","reading":"Slava bogu, vse zhivy!","tr":"Çok şükür, herkes hayatta!"}]},
  {"id":"ru-daily-nakonets-to","languageId":"ru","category":"daily","level":"A2","sourceText":"Наконец-то!","translations":{"tr":["nihayet!","sonunda!"]},"details":{"reading":"Nakonéts-to!","register":"neutral","context":"Uzun bekleyişin ardından."},"examples":[{"text":"Наконец-то ты пришёл!","reading":"Nakonets-to ty prishyol!","tr":"Sonunda geldin!"}]},
  {"id":"ru-daily-vot-derzhi","languageId":"ru","category":"daily","level":"A2","sourceText":"Вот, держи.","translations":{"tr":["al, buyur","işte, tut"]},"details":{"reading":"Vot, derzhí.","register":"informal","context":"Birine bir şey uzatırken; kibarı вот, держите."},"examples":[{"text":"Вот, держи ключи.","reading":"Vot, derzhi klyuchi.","tr":"Al, anahtarlar."}]},
  {"id":"ru-daily-ogo","languageId":"ru","category":"daily","level":"A2","sourceText":"Ого!","translations":{"tr":["vay!","oha!"]},"details":{"reading":"Ogó!","register":"informal","context":"Büyüklük ya da miktar karşısında şaşkınlık."},"examples":[{"text":"Ого, какая очередь!","reading":"Ogo, kakaya ochered'!","tr":"Vay, ne kuyruk ama!"}]},
