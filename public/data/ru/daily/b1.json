[
  {"id":"ru-daily-kak-sam","languageId":"ru","category":"daily","level":"B1","sourceText":"Как сам?","translations":{"tr":["sen nasılsın?","n'aber?"]},"details":{"reading":"Kak sam?","register":"informal","context":"Erkek arkadaşlar arasında çok rahat; kadına как сама?"},"examples":[{"text":"Здорово! Как сам?","reading":"Zdorovo! Kak sam?","tr":"Selam! N'aber?"}]},
  {"id":"ru-daily-skolko-let-skolko-zim","languageId":"ru","category":"daily","level":"B1","sourceText":"Сколько лет, сколько зим!","translations":{"tr":["nerelerdesin, gözümüz yollarda kaldı!"]},"details":{"reading":"Skól'ko let, skól'ko zim!","register":"informal","context":"Uzun zaman sonra karşılaşınca, şakacı ve sıcak."},"examples":[{"text":"Сколько лет, сколько зим! Как ты?","reading":"Skol'ko let, skol'ko zim! Kak ty?","tr":"Ooo, görüşmeyeli ne kadar oldu! Nasılsın?"}]},
  {"id":"ru-daily-vzaimno","languageId":"ru","category":"daily","level":"B1","sourceText":"Взаимно!","translations":{"tr":["karşılıklı","ben de"]},"details":{"reading":"Vzaímno!","register":"neutral","context":"İyi dileklere ya da tanışma sözüne kısa cevap."},"examples":[{"text":"Приятно познакомиться! — Взаимно!","reading":"Priyatno poznakomit'sya! — Vzaimno!","tr":"Tanıştığımıza memnun oldum! — Ben de!"}]},
  {"id":"ru-daily-i-vam-togo-zhe","languageId":"ru","category":"daily","level":"B1","sourceText":"И вам того же!","translations":{"tr":["size de!","aynen size de"]},"details":{"reading":"I vam togó zhe!","register":"neutral","context":"İyi dileklere kibar karşılık."},"examples":[{"text":"Хорошего дня! — И вам того же!","reading":"Khoroshego dnya! — I vam togo zhe!","tr":"İyi günler! — Size de!"}]},
  {"id":"ru-daily-ni-pukha-ni-pera","languageId":"ru","category":"daily","level":"B1","sourceText":"Ни пуха ни пера!","translations":{"tr":["kolay gelsin!","bol şans!"]},"details":{"reading":"Ni púkha ni perá!","register":"informal","context":"Sınavdan önce batıl inançla söylenir; cevabı «К чёрту!»."},"examples":[{"text":"Ни пуха ни пера! — К чёрту!","reading":"Ni pukha ni pera! — K chyortu!","tr":"Bol şans! — Sağ ol! (kelimesi kelimesine: Şeytana!)"}]},
  {"id":"ru-daily-s-priyezdom","languageId":"ru","category":"daily","level":"B1","sourceText":"С приездом!","translations":{"tr":["hoş geldin!","gözümüz aydın!"]},"details":{"reading":"S priyézdom!","register":"neutral","context":"Yolculuktan dönen birini karşılarken."},"examples":[{"text":"С приездом! Как долетел?","reading":"S priyezdom! Kak doletel?","tr":"Hoş geldin! Uçuş nasıldı?"}]},
  {"id":"ru-daily-vyzdoravlivay","languageId":"ru","category":"daily","level":"B1","sourceText":"Выздоравливай!","translations":{"tr":["geçmiş olsun!","çabuk iyileş!"]},"details":{"reading":"Vyzdorávlivay!","register":"neutral","context":"Hasta birine; kibarı выздоравливайте."},"examples":[{"text":"Ты заболел? Выздоравливай скорее!","reading":"Ty zabolel? Vyzdoravlivay skoreye!","tr":"Hastalandın mı? Çabuk iyileş!"}]},
  {"id":"ru-daily-ne-boley","languageId":"ru","category":"daily","level":"B1","sourceText":"Не болей!","translations":{"tr":["hasta olma!","geçmiş olsun"]},"details":{"reading":"Ne boléy!","register":"informal","context":"Hasta birine ya da soğukta vedalaşırken samimi dilek."},"examples":[{"text":"Одевайся теплее и не болей!","reading":"Odevaysya tepleye i ne boley!","tr":"Sıkı giyin, hasta olma!"}]},
  {"id":"ru-daily-idyot","languageId":"ru","category":"daily","level":"B1","sourceText":"Идёт!","translations":{"tr":["olur!","tamam!"]},"details":{"reading":"Idyót!","register":"informal","context":"Bir öneriyi kabul ederken, samimi."},"examples":[{"text":"Пицца в восемь? — Идёт!","reading":"Pitstsa v vosem'? — Idyot!","tr":"Sekizde pizza? — Olur!"}]},
  {"id":"ru-daily-kak-skazhesh","languageId":"ru","category":"daily","level":"B1","sourceText":"Как скажешь.","translations":{"tr":["sen nasıl dersen"]},"details":{"reading":"Kak skázhesh'.","register":"informal","context":"Karşı tarafın kararına uyarken."},"examples":[{"text":"Едем на метро. — Как скажешь.","reading":"Yedem na metro. — Kak skazhesh'.","tr":"Metroyla gidiyoruz. — Sen nasıl dersen."}]},
  {"id":"ru-daily-da-ladno","languageId":"ru","category":"daily","level":"B1","sourceText":"Да ладно!","translations":{"tr":["hadi canım!","yok artık!"]},"details":{"reading":"Da ládno!","register":"informal","context":"İnanmama ya da şaşkınlık; bazen «boş ver» anlamında."},"examples":[{"text":"Она уже замужем? Да ладно!","reading":"Ona uzhe zamuzhem? Da ladno!","tr":"Evlendi mi? Hadi canım!"}]},
  {"id":"ru-daily-nichego-sebe","languageId":"ru","category":"daily","level":"B1","sourceText":"Ничего себе!","translations":{"tr":["vay canına!","hayret!"]},"details":{"reading":"Nichegó sebé!","register":"informal","context":"Etkileyici ya da şaşırtıcı bir şey karşısında."},"examples":[{"text":"Ничего себе, какая большая квартира!","reading":"Nichego sebe, kakaya bol'shaya kvartira!","tr":"Vay canına, ne büyük daire!"}]},
  {"id":"ru-daily-vot-eto-da","languageId":"ru","category":"daily","level":"B1","sourceText":"Вот это да!","translations":{"tr":["vay be!","işte buna derim!"]},"details":{"reading":"Vot éto da!","register":"informal","context":"Hayranlık ya da şaşkınlık."},"examples":[{"text":"Вот это да! Ты сам это сделал?","reading":"Vot eto da! Ty sam eto sdelal?","tr":"Vay be! Bunu kendin mi yaptın?"}]},
  {"id":"ru-daily-tak-derzhat","languageId":"ru","category":"daily","level":"B1","sourceText":"Так держать!","translations":{"tr":["böyle devam!"]},"details":{"reading":"Tak derzhát'!","register":"informal","context":"Birini başarısı için cesaretlendirirken."},"examples":[{"text":"Пять по математике? Так держать!","reading":"Pyat' po matematike? Tak derzhat'!","tr":"Matematikten beş mi? Böyle devam!"}]},
  {"id":"ru-daily-koshmar","languageId":"ru","category":"daily","level":"B1","sourceText":"Кошмар!","translations":{"tr":["kâbus!","felaket!"]},"details":{"reading":"Koshmár!","register":"informal","context":"Kötü durum karşısında abartılı tepki."},"examples":[{"text":"Пробки, дождь — кошмар!","reading":"Probki, dozhd' — koshmar!","tr":"Trafik, yağmur… tam bir kâbus!"}]},
  {"id":"ru-daily-nu-i-chto","languageId":"ru","category":"daily","level":"B1","sourceText":"Ну и что?","translations":{"tr":["ne olmuş yani?","ne fark eder?"]},"details":{"reading":"Nu i chto?","register":"informal","context":"Bir şeyi önemsizleştirirken; kaba kaçabilir."},"examples":[{"text":"Он старше меня. — Ну и что?","reading":"On starshe menya. — Nu i chto?","tr":"O benden büyük. — Ne olmuş yani?"}]},
  {"id":"ru-daily-vot-imenno","languageId":"ru","category":"daily","level":"B1","sourceText":"Вот именно!","translations":{"tr":["aynen!","işte tam olarak bu!"]},"details":{"reading":"Vot ímenno!","register":"informal","context":"Karşı tarafın söylediğini coşkuyla onaylarken."},"examples":[{"text":"Значит, он нас обманул? — Вот именно!","reading":"Znachit, on nas obmanul? — Vot imenno!","tr":"Demek bizi kandırdı? — Aynen öyle!"}]},
  {"id":"ru-daily-yeshchyo-by","languageId":"ru","category":"daily","level":"B1","sourceText":"Ещё бы!","translations":{"tr":["hem de nasıl!","olmaz mı!"]},"details":{"reading":"Yeshchyó by!","register":"informal","context":"Bir şeyin apaçık olduğunu coşkuyla onaylarken."},"examples":[{"text":"Тебе понравилось? — Ещё бы!","reading":"Tebe ponravilos'? — Yeshchyo by!","tr":"Beğendin mi? — Hem de nasıl!"}]},
  {"id":"ru-daily-ni-za-chto","languageId":"ru","category":"daily","level":"B1","sourceText":"Ни за что!","translations":{"tr":["asla!","hayatta olmaz!"]},"details":{"reading":"Ni za chto!","register":"neutral","context":"Kesin ret; vurgu что'da (не за что ile karıştırma)."},"examples":[{"text":"Прыгнуть с парашютом? Ни за что!","reading":"Prygnut' s parashyutom? Ni za chto!","tr":"Paraşütle atlamak mı? Asla!"}]},
  {"id":"ru-daily-da-net","languageId":"ru","category":"daily","level":"B1","sourceText":"Да нет.","translations":{"tr":["yok canım","yok, hayır"]},"details":{"reading":"Da net.","register":"informal","context":"Yumuşak ret; «evet» değil «hayır» demektir."},"examples":[{"text":"Ты устал? — Да нет, всё нормально.","reading":"Ty ustal? — Da net, vsyo normal'no.","tr":"Yoruldun mu? — Yok canım, iyiyim."}]},
  {"id":"ru-daily-chto-chto","languageId":"ru","category":"daily","level":"B1","sourceText":"Что-что?","translations":{"tr":["ne ne?","ne dedin?"]},"details":{"reading":"Chto-chto?","register":"informal","context":"Duyamadığında ya da şaşırınca tekrar isterken."},"examples":[{"text":"Что-что? Повтори!","reading":"Chto-chto? Povtori!","tr":"Ne dedin? Tekrar et!"}]},
  {"id":"ru-daily-ne-bespokoytes","languageId":"ru","category":"daily","level":"B1","sourceText":"Не беспокойтесь.","translations":{"tr":["zahmet etmeyin","merak etmeyin"]},"details":{"reading":"Ne bespokóytes'.","register":"formal","context":"Kibar biçimde rahatlatırken ya da yardımı geri çevirirken."},"examples":[{"text":"Не беспокойтесь, я сам дойду.","reading":"Ne bespokoytes', ya sam doydu.","tr":"Zahmet etmeyin, kendim giderim."}]},
  {"id":"ru-daily-byvayet","languageId":"ru","category":"daily","level":"B1","sourceText":"Бывает.","translations":{"tr":["olur böyle şeyler","olur öyle"]},"details":{"reading":"Byváyet.","register":"informal","context":"Bir aksiliği önemsizleştirirken."},"examples":[{"text":"Я разбил чашку. — Бывает.","reading":"Ya razbil chashku. — Byvayet.","tr":"Fincanı kırdım. — Olur öyle şeyler."}]},
  {"id":"ru-daily-yerunda","languageId":"ru","category":"daily","level":"B1","sourceText":"Ерунда!","translations":{"tr":["saçmalık!","boş ver, önemsiz!"]},"details":{"reading":"Yerundá!","register":"informal","context":"Bir şeyi önemsiz ya da saçma bulduğunda."},"examples":[{"text":"Царапина? Ерунда, заживёт.","reading":"Tsarapina? Yerunda, zazhivyot.","tr":"Çizik mi? Önemsiz, geçer."}]},
  {"id":"ru-daily-pustyaki","languageId":"ru","category":"daily","level":"B1","sourceText":"Пустяки!","translations":{"tr":["lafı mı olur!","önemsiz!"]},"details":{"reading":"Pustyakí!","register":"informal","context":"Teşekküre ya da özre alçakgönüllü cevap."},"examples":[{"text":"Спасибо, что помог! — Пустяки!","reading":"Spasibo, chto pomog! — Pustyaki!","tr":"Yardım ettiğin için sağ ol! — Lafı mı olur!"}]},
  {"id":"ru-daily-ne-obrashchay-vnimaniya","languageId":"ru","category":"daily","level":"B1","sourceText":"Не обращай внимания.","translations":{"tr":["aldırma","takma kafana"]},"details":{"reading":"Ne obrashcháy vnimániya.","register":"informal","context":"Birini önemsiz bir şeyi umursamamaya çağırırken."},"examples":[{"text":"Не обращай внимания, он всегда так шутит.","reading":"Ne obrashchay vnimaniya, on vsegda tak shutit.","tr":"Aldırma, o hep böyle şaka yapar."}]},
  {"id":"ru-daily-kakaya-raznitsa","languageId":"ru","category":"daily","level":"B1","sourceText":"Какая разница?","translations":{"tr":["ne fark eder?"]},"details":{"reading":"Kakáya ráznitsa?","register":"informal","context":"Bir ayrıntıyı önemsiz bulduğunda."},"examples":[{"text":"Синий или зелёный — какая разница?","reading":"Siniy ili zelyonyy — kakaya raznitsa?","tr":"Mavi ya da yeşil, ne fark eder?"}]},
  {"id":"ru-daily-yest-minutka","languageId":"ru","category":"daily","level":"B1","sourceText":"Есть минутка?","translations":{"tr":["bir dakikan var mı?"]},"details":{"reading":"Yest' minútka?","register":"informal","context":"Kısa bir konuşma için izin isterken."},"examples":[{"text":"Есть минутка? Надо поговорить.","reading":"Yest' minutka? Nado pogovorit'.","tr":"Bir dakikan var mı? Konuşmamız lazım."}]},
