  {"id":"ru-daily-ne-podskazhete","languageId":"ru","category":"daily","level":"B1","sourceText":"Не подскажете…?","translations":{"tr":["söyleyebilir misiniz…?"]},"details":{"reading":"Ne podskázhete…?","register":"neutral","context":"Yabancıya yol, saat vb. sormanın kibar yolu."},"examples":[{"text":"Не подскажете, как пройти к вокзалу?","reading":"Ne podskazhete, kak proyti k vokzalu?","tr":"Gara nasıl gidilir, söyleyebilir misiniz?"}]},
  {"id":"ru-daily-ya-nayelsya-nayelas","languageId":"ru","category":"daily","level":"B1","sourceText":"Я наелся / наелась.","translations":{"tr":["doydum"]},"details":{"reading":"Ya nayélsya / nayélas'.","register":"informal","context":"Daha fazla yemek ikram edilince; erkek наелся, kadın наелась."},"examples":[{"text":"Ещё кусочек? — Нет, спасибо, я наелся.","reading":"Yeshchyo kusochek? — Net, spasibo, ya nayelsya.","tr":"Bir parça daha? — Hayır, teşekkürler, doydum."}]},
  {"id":"ru-daily-sozvonimsya","languageId":"ru","category":"daily","level":"B1","sourceText":"Созвонимся!","translations":{"tr":["telefonlaşırız!"]},"details":{"reading":"Sozvonímsya!","register":"informal","context":"Vedalaşırken; kesin plan yapmadan."},"examples":[{"text":"Ладно, созвонимся вечером!","reading":"Ladno, sozvonimsya vecherom!","tr":"Tamam, akşam telefonlaşırız!"}]},
  {"id":"ru-daily-spishemsya","languageId":"ru","category":"daily","level":"B1","sourceText":"Спишемся!","translations":{"tr":["yazışırız!"]},"details":{"reading":"Spíshemsya!","register":"informal","context":"Mesajla iletişimde kalmak üzere vedalaşırken."},"examples":[{"text":"Пока, спишемся!","reading":"Poka, spishemsya!","tr":"Görüşürüz, yazışırız!"}]},
  {"id":"ru-daily-resheno","languageId":"ru","category":"daily","level":"B1","sourceText":"Решено!","translations":{"tr":["karar verildi!","tamam, öyleyse!"]},"details":{"reading":"Reshenó!","register":"neutral","context":"Tartışmayı bir kararla kapatırken."},"examples":[{"text":"Едем в Петербург. Решено!","reading":"Yedem v Peterburg. Resheno!","tr":"Petersburg'a gidiyoruz. Karar verildi!"}]},
  {"id":"ru-daily-kak-znayesh","languageId":"ru","category":"daily","level":"B1","sourceText":"Как знаешь.","translations":{"tr":["sen bilirsin"]},"details":{"reading":"Kak znáyesh'.","register":"informal","context":"Karşı tarafın kararına katılmadan saygı gösterirken; hafif sitemli."},"examples":[{"text":"Я не пойду к врачу. — Ну, как знаешь.","reading":"Ya ne poydu k vrachu. — Nu, kak znayesh'.","tr":"Doktora gitmeyeceğim. — Sen bilirsin."}]},
  {"id":"ru-daily-obrashchaytes","languageId":"ru","category":"daily","level":"B1","sourceText":"Обращайтесь!","translations":{"tr":["her zaman beklerim!","ne zaman isterseniz"]},"details":{"reading":"Obrashcháytes'!","register":"neutral","context":"Teşekküre cevap; tekrar yardım teklifi."},"examples":[{"text":"Спасибо большое! — Обращайтесь!","reading":"Spasibo bol'shoye! — Obrashchaytes'!","tr":"Çok teşekkürler! — Her zaman!"}]},
  {"id":"ru-daily-vas-ne-slyshno","languageId":"ru","category":"daily","level":"B1","sourceText":"Вас не слышно.","translations":{"tr":["sesiniz gelmiyor"]},"details":{"reading":"Vas ne slýshno.","register":"neutral","context":"Telefonda bağlantı kötüyken; samimisi тебя не слышно."},"examples":[{"text":"Алло! Вас не слышно, перезвоните.","reading":"Allo! Vas ne slyshno, perezvonite.","tr":"Alo! Sesiniz gelmiyor, tekrar arayın."}]},
  {"id":"ru-daily-vy-oshiblis-nomerom","languageId":"ru","category":"daily","level":"B1","sourceText":"Вы ошиблись номером.","translations":{"tr":["yanlış numara"]},"details":{"reading":"Vy oshíblis' nómerom.","register":"neutral","context":"Yanlış arayan birine."},"examples":[{"text":"Здесь нет Ивана, вы ошиблись номером.","reading":"Zdes' net Ivana, vy oshiblis' nomerom.","tr":"Burada İvan diye biri yok, yanlış numara."}]},
  {"id":"ru-daily-nu-chto-zh","languageId":"ru","category":"daily","level":"B1","sourceText":"Ну что ж.","translations":{"tr":["eh, ne yapalım","peki öyleyse"]},"details":{"reading":"Nu chto zh.","register":"neutral","context":"Bir durumu kabullenip devam ederken."},"examples":[{"text":"Ну что ж, попробуем ещё раз.","reading":"Nu chto zh, poprobuyem yeshchyo raz.","tr":"Eh, ne yapalım, bir daha deneriz."}]},
  {"id":"ru-daily-chto-podelayesh","languageId":"ru","category":"daily","level":"B1","sourceText":"Что поделаешь.","translations":{"tr":["ne yapalım","elden ne gelir"]},"details":{"reading":"Chto podélayesh'.","register":"informal","context":"Değiştirilemeyen bir durumu kabullenirken."},"examples":[{"text":"Опять дождь. Что поделаешь.","reading":"Opyat' dozhd'. Chto podelayesh'.","tr":"Yine yağmur. Ne yapalım."}]},
  {"id":"ru-daily-sam-vinovat","languageId":"ru","category":"daily","level":"B1","sourceText":"Сам виноват.","translations":{"tr":["kendi suçun","kendin ettin"]},"details":{"reading":"Sam vinovát.","register":"informal","context":"Birinin başına gelenin kendi hatası olduğunu söylerken; kadına сама виновата."},"examples":[{"text":"Не взял зонт — сам виноват.","reading":"Ne vzyal zont — sam vinovat.","tr":"Şemsiye almadın, kendi suçun."}]},
  {"id":"ru-daily-nu-i-pust","languageId":"ru","category":"daily","level":"B1","sourceText":"Ну и пусть.","translations":{"tr":["olsun","varsın öyle olsun"]},"details":{"reading":"Nu i pust'.","register":"informal","context":"Bir şeyi umursamadığını gösterirken."},"examples":[{"text":"Он обиделся? Ну и пусть.","reading":"On obidelsya? Nu i pust'.","tr":"Alındı mı? Varsın alınsın."}]},
  {"id":"ru-daily-ne-day-bog","languageId":"ru","category":"daily","level":"B1","sourceText":"Не дай бог!","translations":{"tr":["Allah korusun!"]},"details":{"reading":"Ne day bog!","register":"neutral","context":"Kötü bir ihtimalden söz ederken."},"examples":[{"text":"Не дай бог опоздать на самолёт!","reading":"Ne day bog opozdat' na samolyot!","tr":"Allah korusun, uçağı kaçırmak olmaz!"}]},
  {"id":"ru-daily-day-bog","languageId":"ru","category":"daily","level":"B1","sourceText":"Дай бог!","translations":{"tr":["inşallah!","Allah versin!"]},"details":{"reading":"Day bog!","register":"neutral","context":"İyi bir dileğe katılırken."},"examples":[{"text":"Надеюсь, всё получится. — Дай бог!","reading":"Nadeyus', vsyo poluchitsya. — Day bog!","tr":"Umarım her şey yolunda gider. — İnşallah!"}]},
  {"id":"ru-daily-tfu-tfu-tfu","languageId":"ru","category":"daily","level":"B1","sourceText":"Тьфу-тьфу-тьфу!","translations":{"tr":["tu tu tu, maşallah!","nazar değmesin!"]},"details":{"reading":"T'fu-t'fu-t'fu!","register":"informal","context":"İyi bir şeyden söz edince nazar değmesin diye; sol omuzun üstüne «tükürülür»."},"examples":[{"text":"Пока всё хорошо, тьфу-тьфу-тьфу!","reading":"Poka vsyo khorosho, t'fu-t'fu-t'fu!","tr":"Şimdilik her şey yolunda, nazar değmesin!"}]},
  {"id":"ru-daily-soydyot","languageId":"ru","category":"daily","level":"B1","sourceText":"Сойдёт.","translations":{"tr":["idare eder","olur, yeter"]},"details":{"reading":"Soydyót.","register":"informal","context":"Bir şeyin mükemmel olmasa da yeterli olduğunu söylerken."},"examples":[{"text":"Так нормально? — Сойдёт.","reading":"Tak normal'no? — Soydyot.","tr":"Böyle olur mu? — İdare eder."}]},
  {"id":"ru-daily-proshu","languageId":"ru","category":"daily","level":"B1","sourceText":"Прошу!","translations":{"tr":["buyurun!"]},"details":{"reading":"Proshú!","register":"formal","context":"Birine yol verirken ya da bir şey uzatırken."},"examples":[{"text":"Прошу, проходите!","reading":"Proshu, prokhodite!","tr":"Buyurun, geçin!"}]},
  {"id":"ru-daily-posle-vas","languageId":"ru","category":"daily","level":"B1","sourceText":"После вас.","translations":{"tr":["önce siz buyurun"]},"details":{"reading":"Pósle vas.","register":"formal","context":"Kapıda ya da sırada yol verirken."},"examples":[{"text":"Пожалуйста, после вас.","reading":"Pozhaluysta, posle vas.","tr":"Lütfen, önce siz buyurun."}]},
  {"id":"ru-daily-nu-i-nu","languageId":"ru","category":"daily","level":"B1","sourceText":"Ну и ну!","translations":{"tr":["vay vay!","hayret bir şey!"]},"details":{"reading":"Nu i nu!","register":"informal","context":"Şaşkınlık ya da hafif kınama."},"examples":[{"text":"Ну и ну! Кто это всё разбросал?","reading":"Nu i nu! Kto eto vsyo razbrosal?","tr":"Vay vay! Bunları kim etrafa saçtı?"}]},
  {"id":"ru-daily-vyshe-nos","languageId":"ru","category":"daily","level":"B1","sourceText":"Выше нос!","translations":{"tr":["kaldır başını!","moralini bozma!"]},"details":{"reading":"Výshe nos!","register":"informal","context":"Birinin moralini yükseltirken."},"examples":[{"text":"Выше нос! Ещё не всё потеряно.","reading":"Vyshe nos! Yeshchyo ne vsyo poteryano.","tr":"Moralini bozma! Henüz her şey bitmedi."}]},
  {"id":"ru-daily-derzhis","languageId":"ru","category":"daily","level":"B1","sourceText":"Держись!","translations":{"tr":["dayan!","güçlü ol!"]},"details":{"reading":"Derzhís'!","register":"informal","context":"Zor durumdaki birine destek; kibarı держитесь."},"examples":[{"text":"Держись, я скоро приеду.","reading":"Derzhis', ya skoro priyedu.","tr":"Dayan, birazdan geliyorum."}]},
  {"id":"ru-daily-kto-posledniy","languageId":"ru","category":"daily","level":"B1","sourceText":"Кто последний?","translations":{"tr":["sıranın sonu kim?"]},"details":{"reading":"Kto poslédniy?","register":"neutral","context":"Kuyruğa girerken kimin arkasına geçeceğini sorarken."},"examples":[{"text":"Извините, кто последний к врачу?","reading":"Izvinite, kto posledniy k vrachu?","tr":"Affedersiniz, doktor sırasının sonu kim?"}]},
  {"id":"ru-daily-vy-vykhodite","languageId":"ru","category":"daily","level":"B1","sourceText":"Вы выходите?","translations":{"tr":["iniyor musunuz?"]},"details":{"reading":"Vy vykhódite?","register":"neutral","context":"Kalabalık otobüs ya da metroda kapıya ilerlerken."},"examples":[{"text":"Вы выходите на следующей?","reading":"Vy vykhodite na sleduyushchey?","tr":"Bir sonraki durakta iniyor musunuz?"}]},
  {"id":"ru-daily-kak-zhe-tak","languageId":"ru","category":"daily","level":"B1","sourceText":"Как же так?","translations":{"tr":["bu nasıl olur?","olur mu böyle?"]},"details":{"reading":"Kak zhe tak?","register":"neutral","context":"Beklenmedik ve hoş olmayan bir habere tepki."},"examples":[{"text":"Ты потерял паспорт? Как же так?","reading":"Ty poteryal pasport? Kak zhe tak?","tr":"Pasaportunu mu kaybettin? Bu nasıl olur?"}]},
  {"id":"ru-daily-da-nu","languageId":"ru","category":"daily","level":"B1","sourceText":"Да ну!","translations":{"tr":["hadi be!","yok canım!"]},"details":{"reading":"Da nu!","register":"informal","context":"İnanmama ya da isteksizlik bildirir."},"examples":[{"text":"Он сдал на права? Да ну!","reading":"On sdal na prava? Da nu!","tr":"Ehliyeti mi aldı? Hadi be!"}]},
  {"id":"ru-daily-ne-za-chto-izvinyatsya","languageId":"ru","category":"daily","level":"B1","sourceText":"Не за что извиняться.","translations":{"tr":["özür dilemene gerek yok"]},"details":{"reading":"Né za chto izvinyát'sya.","register":"neutral","context":"Özür dileyen birini rahatlatırken."},"examples":[{"text":"Прости, что побеспокоил. — Не за что извиняться!","reading":"Prosti, chto pobespokoil. — Ne za chto izvinyat'sya!","tr":"Rahatsız ettiğim için kusura bakma. — Özür dilemene gerek yok!"}]},
  {"id":"ru-daily-tak-nechestno","languageId":"ru","category":"daily","level":"B1","sourceText":"Так нечестно!","translations":{"tr":["bu haksızlık!","böyle olmaz!"]},"details":{"reading":"Tak nechéstno!","register":"informal","context":"Oyunda ya da paylaşımda haksızlığa itiraz."},"examples":[{"text":"Ты взял два куска! Так нечестно!","reading":"Ty vzyal dva kuska! Tak nechestno!","tr":"İki parça aldın! Bu haksızlık!"}]}
