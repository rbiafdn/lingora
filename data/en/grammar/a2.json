  {"id":"en-gr-simple-past","languageId":"en","category":"grammar","level":"A2","sourceText":"Simple Past","translations":{"tr":["Geçmiş Zaman"]},"grammar":{"summary":"Geçmişte başlayıp bitmiş eylemleri anlatır.","uses":["Geçmişte tamamlanmış eylemler","Geçmişteki alışkanlıklar","Hikâye anlatımı","Ardı ardına olan geçmiş olaylar"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil-ed / 2. hâl","en":"Verb-ed / V2","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:I] [v:watched] [o:a film] yesterday.","tr":"Dün bir film izledim."},{"text":"[s:She] [v:went] [o:to Paris] last year.","tr":"Geçen yıl Paris'e gitti."}],"notes":["Düzenli fiiller -ed alır (work → worked); düzensiz fiillerin 2. hâli ezberlenir (go → went).","Fiil tüm öznelerle aynı kalır: I / he / they worked."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"did + not","en":"did + not","role":"a"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:I] [a:didn't] [v:see] [o:him].","tr":"Onu görmedim."},{"text":"[s:They] [a:did not] [v:call] [o:us].","tr":"Bizi aramadılar."}],"notes":["\"did\" geçmişi taşıdığı için fiil yalın kalır: didn't went ✗ → didn't go ✓"]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Did","en":"Did","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne?","en":"Object?","role":"o"}],"examples":[{"text":"[a:Did] [s:you] [v:finish] [o:your homework]?","tr":"Ödevini bitirdin mi?"},{"text":"[a:Did] [s:she] [v:call] [o:you]?","tr":"Seni aradı mı?"}]},{"kind":"negative-question","title":"Olumsuz soru","formula":[{"tr":"Didn't","en":"Didn't","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne?","en":"Object?","role":"o"}],"examples":[{"text":"[a:Didn't] [s:you] [v:like] [o:the film]?","tr":"Filmi beğenmedin mi?"},{"text":"[a:Didn't] [s:he] [v:tell] [o:you]?","tr":"Sana söylemedi mi?"}]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Yes / No","en":"Yes / No","role":"x"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"did(n't)","en":"did(n't)","role":"a"}],"examples":[{"text":"Yes, [s:I] [a:did].","tr":"Evet, bitirdim."},{"text":"No, [s:I] [a:didn't].","tr":"Hayır, bitirmedim."},{"text":"Yes, [s:she] [a:did].","tr":"Evet, aradı."}]},{"kind":"wh","title":"WH soruları","formula":[{"tr":"Soru kelimesi","en":"Wh-word","role":"q"},{"tr":"did","en":"did","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil (yalın)?","en":"Verb (base)?","role":"v"}],"examples":[{"text":"[q:Where] [a:did] [s:you] [v:go] last weekend?","tr":"Geçen hafta sonu nereye gittin?"},{"text":"[q:What] [a:did] [s:she] [v:say]?","tr":"Ne dedi?"}]}],"rules":["Olumlu cümlede fiilin 2. hâli kullanılır ve tüm öznelerle aynıdır.","Olumsuz ve soru cümlelerinde did kullanılır; did'den sonra fiil yalın hâle döner.","yesterday, last week, ago, in 2010 gibi belirli geçmiş zaman ifadeleriyle kullanılır.","Be fiilinin geçmişi was / were'dir ve did ile kullanılmaz: Were you at home? ✓ — Did you be at home? ✗"],"exceptions":["Düzensiz fiillerin 2. hâli kurala uymaz ve ezberlenir: go → went, see → saw, buy → bought, eat → ate.","Yazım: -e ile bitenler sadece -d alır (live → lived); ünsüz + y → -ied (study → studied); tek heceli ünsüz-ünlü-ünsüz ile bitenlerde son harf ikilenir (stop → stopped)."],"mistakes":[{"wrong":"I didn't went there.","right":"I didn't go there.","note":"did zaten geçmişi gösterir; fiil yalın kalır."},{"wrong":"Did you saw him?","right":"Did you see him?","note":"Soruda da did'den sonra fiil yalındır."},{"wrong":"I goed to school.","right":"I went to school.","note":"go düzensiz bir fiildir; -ed almaz."},{"wrong":"She was go to work.","right":"She went to work.","note":"Türkçedeki \"-di\" için was eklenmez; fiilin 2. hâli yeterlidir."}]}},
  {"id":"en-gr-be-going-to","languageId":"en","category":"grammar","level":"A2","sourceText":"Be Going To (Future)","translations":{"tr":["Gelecek zaman: be going to"]},"grammar":{"summary":"Önceden verilmiş kararları, planları ve şu anki belirtilere dayanan tahminleri anlatır.","uses":["Önceden verilmiş kararlar ve niyetler","Planlar","Şu an görülen bir belirtiye dayanan tahmin (Look at the clouds! It's going to rain.)"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"am/is/are going to","en":"am/is/are going to","role":"a"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:I] [a:am going to] [v:visit] [o:my grandparents] next week.","tr":"Gelecek hafta büyükannemle büyükbabamı ziyaret edeceğim."},{"text":"[s:She] [a:is going to] [v:learn] [o:Spanish].","tr":"İspanyolca öğrenecek."},{"text":"Look at those clouds! [s:It] [a:is going to] [v:rain].","tr":"Şu bulutlara bak! Yağmur yağacak."}],"notes":["be özneye göre am / is / are olur; going to sabittir."]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"am/is/are + not going to","en":"am/is/are + not going to","role":"a"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:We] [a:aren't going to] [v:buy] [o:a new car].","tr":"Yeni bir araba almayacağız."},{"text":"[s:She] [a:isn't going to] [v:come] [o:to the party].","tr":"Partiye gelmeyecek."},{"text":"[s:I] [a:am not going to] [v:tell] [o:anyone].","tr":"Kimseye söylemeyeceğim."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Am/Is/Are","en":"Am/Is/Are","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"going to","en":"going to","role":"a"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne?","en":"Object?","role":"o"}],"examples":[{"text":"[a:Are] [s:you] [a:going to] [v:study] [o:tonight]?","tr":"Bu akşam ders çalışacak mısın?"},{"text":"[a:Is] [s:he] [a:going to] [v:sell] [o:his house]?","tr":"Evini satacak mı?"}]},{"kind":"negative-question","title":"Olumsuz soru","formula":[{"tr":"Isn't/Aren't","en":"Isn't/Aren't","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"going to","en":"going to","role":"a"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne?","en":"Object?","role":"o"}],"examples":[{"text":"[a:Aren't] [s:you] [a:going to] [v:eat] [o:anything]?","tr":"Hiçbir şey yemeyecek misin?"},{"text":"[a:Isn't] [s:she] [a:going to] [v:call] [o:us]?","tr":"Bizi aramayacak mı?"}]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Yes / No","en":"Yes / No","role":"x"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"am/is/are(n't)","en":"am/is/are(n't)","role":"a"}],"examples":[{"text":"Yes, [s:I] [a:am].","tr":"Evet, çalışacağım."},{"text":"No, [s:I'm] [a:not].","tr":"Hayır, çalışmayacağım."},{"text":"Yes, [s:he] [a:is].","tr":"Evet, satacak."},{"text":"No, [s:he] [a:isn't].","tr":"Hayır, satmayacak."}],"notes":["Kısa cevapta going to tekrarlanmaz; sadece be fiili kullanılır."]},{"kind":"wh","title":"WH soruları","formula":[{"tr":"Soru kelimesi","en":"Wh-word","role":"q"},{"tr":"am/is/are","en":"am/is/are","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"going to","en":"going to","role":"a"},{"tr":"Fiil (yalın)?","en":"Verb (base)?","role":"v"}],"examples":[{"text":"[q:What] [a:are] [s:you] [a:going to] [v:do] [o:this weekend]?","tr":"Bu hafta sonu ne yapacaksın?"},{"text":"[q:Where] [a:is] [s:she] [a:going to] [v:stay]?","tr":"Nerede kalacak?"}]}],"rules":["Yapı am / is / are + going to + fiilin yalın hâlidir; be fiili atlanamaz.","Konuşma anından önce verilmiş kararlar ve planlar için kullanılır.","Şu an görülen bir belirtiye dayanan tahminlerde kullanılır: She's going to fall!","Konuşma anında verilen ani kararlar için be going to değil will kullanılır: The phone is ringing. — I'll answer it."],"exceptions":["Konuşma dilinde \"going to\" çoğunlukla \"gonna\" diye söylenir; resmî yazıda kullanılmaz.","go fiiliyle \"I'm going to go to the cinema\" doğrudur, ama tekrar olmaması için genelde şimdiki zaman tercih edilir: I'm going to the cinema tonight."],"mistakes":[{"wrong":"I going to visit her.","right":"I am going to visit her.","note":"Be fiili (am / is / are) atlanamaz."},{"wrong":"She is going to visits us.","right":"She is going to visit us.","note":"going to'dan sonra fiil yalın kalır."},{"wrong":"Are you going to studying tonight?","right":"Are you going to study tonight?","note":"going to'dan sonra -ing değil yalın fiil gelir."},{"wrong":"The phone is ringing. — I'm going to answer it.","right":"The phone is ringing. — I'll answer it.","note":"O anda verilen kararlarda will kullanılır."}]}},
  {"id":"en-gr-past-continuous","languageId":"en","category":"grammar","level":"A2","sourceText":"Past Continuous","translations":{"tr":["Geçmişte Süren Zaman"]},"grammar":{"summary":"Geçmişte belirli bir anda devam etmekte olan eylemleri anlatır (-iyordu).","uses":["Geçmişte belli bir anda süren eylem","Başka bir olayla kesilen eylem (when)","Aynı anda süren iki eylem (while)","Hikâyede arka plan anlatımı"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"was/were","en":"was/were","role":"a"},{"tr":"Fiil-ing","en":"Verb-ing","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:I] [a:was] [v:watching] [o:TV] at 8 o'clock.","tr":"Saat 8'de televizyon izliyordum."},{"text":"[s:They] [a:were] [v:playing] [o:football].","tr":"Futbol oynuyorlardı."}],"notes":["I / he / she / it → was; you / we / they → were"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"was/were + not","en":"was/were + not","role":"a"},{"tr":"Fiil-ing","en":"Verb-ing","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:She] [a:wasn't] [v:listening] [o:to me].","tr":"Beni dinlemiyordu."},{"text":"[s:We] [a:weren't] [v:sleeping].","tr":"Uyumuyorduk."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Was/Were","en":"Was/Were","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil-ing","en":"Verb-ing","role":"v"},{"tr":"Nesne?","en":"Object?","role":"o"}],"examples":[{"text":"[a:Were] [s:you] [v:working] at 10 last night?","tr":"Dün gece saat 10'da çalışıyor muydun?"},{"text":"[a:Was] [s:it] [v:raining]?","tr":"Yağmur yağıyor muydu?"}]},{"kind":"wh","title":"WH soruları","formula":[{"tr":"Soru kelimesi","en":"Wh-word","role":"q"},{"tr":"was/were","en":"was/were","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil-ing?","en":"Verb-ing?","role":"v"}],"examples":[{"text":"[q:What] [a:were] [s:you] [v:doing] at 9?","tr":"Saat 9'da ne yapıyordun?"},{"text":"[q:Where] [a:was] [s:he] [v:going]?","tr":"Nereye gidiyordu?"}]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Yes / No","en":"Yes / No","role":"x"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"was(n't) / were(n't)","en":"was(n't) / were(n't)","role":"a"}],"examples":[{"text":"Yes, [s:I] [a:was].","tr":"Evet, çalışıyordum."},{"text":"No, [s:it] [a:wasn't].","tr":"Hayır, yağmıyordu."}]},{"kind":"other","title":"When / While","formula":[{"tr":"Süren eylem (Past Cont.)","en":"Past Continuous","role":"v"},{"tr":"when","en":"when","role":"x"},{"tr":"Kesen eylem (Past Simple)","en":"Past Simple","role":"v"}],"examples":[{"text":"[s:I] [a:was] [v:cooking] when [s:the phone] [v:rang].","tr":"Telefon çaldığında yemek pişiriyordum."},{"text":"While [s:I] [a:was] [v:reading], [s:she] [a:was] [v:sleeping].","tr":"Ben okurken o uyuyordu."}],"notes":["Uzun/süren eylem Past Continuous, araya giren kısa eylem Past Simple olur."]}],"rules":["was/were + fiil-ing ile kurulur.","Kısa, araya giren eylem için Simple Past kullanılır: when + Past Simple.","while genellikle süren eylemle (Past Continuous) kullanılır."],"exceptions":["know, like, want, believe gibi durum fiilleri genelde -ing almaz: I knew him. ✓ — I was knowing him. ✗"],"mistakes":[{"wrong":"I was watch TV.","right":"I was watching TV.","note":"was/were'den sonra fiil -ing alır."},{"wrong":"They was playing.","right":"They were playing.","note":"they / we / you ile were kullanılır."},{"wrong":"When I was arriving, he left.","right":"When I arrived, he was leaving.","note":"Kısa, ani eylem Simple Past olur."}]}},
  {"id":"en-gr-will-future","languageId":"en","category":"grammar","level":"A2","sourceText":"Will (Future)","translations":{"tr":["Gelecek Zaman (Will)"]},"grammar":{"summary":"Gelecekle ilgili tahminleri, anlık kararları ve sözleri anlatır.","uses":["Gelecekle ilgili tahmin (I think…)","Konuşma anında verilen karar","Söz ve teklif","Gelecekteki kesin olaylar"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"will","en":"will","role":"a"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:I] [a:will] [v:call] [o:you] tomorrow.","tr":"Yarın seni ararım."},{"text":"[s:It] [a:will] [v:be] [o:sunny] tomorrow.","tr":"Yarın hava güneşli olacak."}],"notes":["Kısaltma: I'll, you'll, she'll, it'll, we'll, they'll"]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"will not (won't)","en":"will not (won't)","role":"a"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:I] [a:won't] [v:tell] [o:anyone].","tr":"Kimseye söylemeyeceğim."},{"text":"[s:She] [a:won't] [v:come] [o:to the party].","tr":"Partiye gelmeyecek."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Will","en":"Will","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne?","en":"Object?","role":"o"}],"examples":[{"text":"[a:Will] [s:you] [v:help] [o:me]?","tr":"Bana yardım eder misin?"},{"text":"[a:Will] [s:it] [v:rain] tomorrow?","tr":"Yarın yağmur yağacak mı?"}]},{"kind":"wh","title":"WH soruları","formula":[{"tr":"Soru kelimesi","en":"Wh-word","role":"q"},{"tr":"will","en":"will","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil (yalın)?","en":"Verb (base)?","role":"v"}],"examples":[{"text":"[q:What] [a:will] [s:you] [v:do]?","tr":"Ne yapacaksın?"},{"text":"[q:When] [a:will] [s:they] [v:arrive]?","tr":"Ne zaman varacaklar?"}]},{"kind":"short-answers","title":"Kısa cevaplar","formula":[{"tr":"Yes / No","en":"Yes / No","role":"x"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"will / won't","en":"will / won't","role":"a"}],"examples":[{"text":"Yes, [s:I] [a:will].","tr":"Evet, ederim."},{"text":"No, [s:it] [a:won't].","tr":"Hayır, yağmayacak."}]}],"rules":["will tüm öznelerle aynıdır; ardından fiil yalın gelir.","Tahminlerde sık kullanılır: I think / probably / maybe + will.","Önceden yapılmış planlar için be going to veya Present Continuous daha doğaldır."],"exceptions":["Teklif ve öneride I / we ile Shall kullanılır: Shall I open the window?"],"mistakes":[{"wrong":"I will to go.","right":"I will go.","note":"will'den sonra to gelmez."},{"wrong":"She wills come.","right":"She will come.","note":"will hiçbir özneyle ek almaz."},{"wrong":"I will going.","right":"I will go.","note":"will'den sonra fiil yalın kalır, -ing almaz."}]}},
  {"id":"en-gr-comparatives","languageId":"en","category":"grammar","level":"A2","sourceText":"Comparatives","translations":{"tr":["Karşılaştırma (Comparatives)"]},"grammar":{"summary":"İki şeyi karşılaştırmak için sıfatın -er veya more biçimi kullanılır (daha …).","uses":["İki kişiyi/şeyi karşılaştırma","Bir şeyin daha büyük, iyi, pahalı vb. olduğunu söyleme"],"sections":[{"kind":"other","title":"Kısa sıfat + -er + than","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"be","en":"be","role":"a"},{"tr":"Sıfat-er","en":"Adjective-er","role":"v"},{"tr":"than + nesne","en":"than + object","role":"o"}],"examples":[{"text":"[s:Tom] [a:is] [v:taller] [o:than his brother].","tr":"Tom kardeşinden daha uzun."},{"text":"[s:Today] [a:is] [v:colder] [o:than yesterday].","tr":"Bugün dünden daha soğuk."}],"notes":["Tek heceli sıfatlar ve -y ile biten iki heceliler: big → bigger, happy → happier"]},{"kind":"other","title":"more + uzun sıfat + than","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"be","en":"be","role":"a"},{"tr":"more + sıfat","en":"more + adjective","role":"v"},{"tr":"than + nesne","en":"than + object","role":"o"}],"examples":[{"text":"[s:This book] [a:is] [v:more interesting] [o:than that one].","tr":"Bu kitap ondan daha ilginç."},{"text":"[s:Cars] [a:are] [v:more expensive] [o:than bikes].","tr":"Arabalar bisikletlerden daha pahalı."}]},{"kind":"other","title":"Düzensiz biçimler","formula":[{"tr":"good / bad / far","en":"good / bad / far","role":"x"},{"tr":"better / worse / further","en":"better / worse / further","role":"v"}],"examples":[{"text":"[s:My English] [a:is] [v:better] [o:than last year].","tr":"İngilizcem geçen yıldan daha iyi."},{"text":"[s:The weather] [a:is] [v:worse] today.","tr":"Hava bugün daha kötü."}]},{"kind":"other","title":"less / not as … as","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"be","en":"be","role":"a"},{"tr":"not as + sıfat + as","en":"not as + adjective + as","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:My phone] [a:is] [v:not as fast as] [o:yours].","tr":"Telefonum seninki kadar hızlı değil."},{"text":"[s:This hotel] [a:is] [v:less expensive].","tr":"Bu otel daha ucuz."}]}],"rules":["Tek heceli sıfatlar -er alır: small → smaller.","İki ve daha fazla heceli sıfatlar more alır: beautiful → more beautiful.","Yazım: big → bigger (son harf ikilenir), easy → easier, nice → nicer."],"exceptions":["good → better, bad → worse, far → further/farther"],"mistakes":[{"wrong":"She is more tall than me.","right":"She is taller than me.","note":"Kısa sıfatlar more değil -er alır."},{"wrong":"It's more better.","right":"It's better.","note":"better zaten karşılaştırma biçimidir; more eklenmez."},{"wrong":"He is older then me.","right":"He is older than me.","note":"Karşılaştırmada then değil than kullanılır."}]}},
  {"id":"en-gr-superlatives","languageId":"en","category":"grammar","level":"A2","sourceText":"Superlatives","translations":{"tr":["En Üstünlük (Superlatives)"]},"grammar":{"summary":"Bir grubun en … olanını anlatmak için the + -est veya the most kullanılır.","uses":["Bir grup içinde en büyük, en iyi vb. olanı söyleme","Deneyimlerde: the best film I've ever seen"],"sections":[{"kind":"other","title":"the + kısa sıfat-est","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"be","en":"be","role":"a"},{"tr":"the + sıfat-est","en":"the + adjective-est","role":"v"},{"tr":"(in / of …)","en":"(in / of …)","role":"o"}],"examples":[{"text":"[s:Everest] [a:is] [v:the highest] mountain [o:in the world].","tr":"Everest dünyanın en yüksek dağıdır."},{"text":"[s:He] [a:is] [v:the youngest] [o:in our class].","tr":"Sınıfımızın en küçüğü o."}]},{"kind":"other","title":"the most + uzun sıfat","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"be","en":"be","role":"a"},{"tr":"the most + sıfat","en":"the most + adjective","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:This] [a:is] [v:the most beautiful] [o:city in Turkey].","tr":"Burası Türkiye'nin en güzel şehri."},{"text":"[s:It] [a:was] [v:the most difficult] [o:exam].","tr":"En zor sınavdı."}]},{"kind":"other","title":"Düzensiz biçimler","formula":[{"tr":"good / bad / far","en":"good / bad / far","role":"x"},{"tr":"the best / the worst / the furthest","en":"the best / the worst / the furthest","role":"v"}],"examples":[{"text":"[s:She] [a:is] [v:the best] [o:player in the team].","tr":"Takımın en iyi oyuncusu o."},{"text":"[s:That] [a:was] [v:the worst] [o:day of my life].","tr":"Hayatımın en kötü günüydü."}]}],"rules":["Superlative'den önce genellikle the kullanılır.","Yer için in (in the world, in the class), grup için of (of all) gelir.","Yazım: big → the biggest, happy → the happiest, nice → the nicest."],"exceptions":["good → the best, bad → the worst, far → the furthest"],"mistakes":[{"wrong":"He is most tall.","right":"He is the tallest.","note":"Kısa sıfatlar -est alır ve the ile kullanılır."},{"wrong":"It's the most best.","right":"It's the best.","note":"best zaten en üstünlük biçimidir."},{"wrong":"the biggest city of the world","right":"the biggest city in the world","note":"Yer bildiren ifadelerde in kullanılır."}]}},
  {"id":"en-gr-countable-and-uncountable-nouns","languageId":"en","category":"grammar","level":"A2","sourceText":"Countable & Uncountable Nouns","translations":{"tr":["Sayılabilen ve Sayılamayan İsimler"]},"grammar":{"summary":"Bazı isimler sayılabilir (an apple, two apples), bazıları sayılamaz (water, money).","uses":["a/an, some, many, much seçimini doğru yapma","Sayılamayan şeyleri ölçü birimiyle sayma (a glass of water)"],"sections":[{"kind":"other","title":"Sayılabilen isim","formula":[{"tr":"a / an / sayı","en":"a / an / number","role":"x"},{"tr":"İsim (tekil/çoğul)","en":"Noun (sing./plural)","role":"o"}],"examples":[{"text":"[s:I] [v:have] [x:an] [o:apple] and [x:two] [o:bananas].","tr":"Bir elmam ve iki muzum var."},{"text":"[s:There] [a:are] [x:three] [o:chairs].","tr":"Üç sandalye var."}]},{"kind":"other","title":"Sayılamayan isim","formula":[{"tr":"(some) + isim","en":"(some) + noun","role":"o"},{"tr":"tekil fiil","en":"singular verb","role":"a"}],"examples":[{"text":"[s:The water] [a:is] cold.","tr":"Su soğuk."},{"text":"[s:I] [v:need] [o:some money].","tr":"Biraz paraya ihtiyacım var."}],"notes":["Sayılamayan isimler a/an ve çoğul -s almaz."]},{"kind":"other","title":"Ölçü birimi + of","formula":[{"tr":"a / sayı","en":"a / number","role":"x"},{"tr":"ölçü","en":"unit","role":"x"},{"tr":"of + isim","en":"of + noun","role":"o"}],"examples":[{"text":"[a:Can] [s:I] [v:have] [x:a glass of] [o:water]?","tr":"Bir bardak su alabilir miyim?"},{"text":"[s:I] [v:bought] [x:two loaves of] [o:bread].","tr":"İki somun ekmek aldım."}],"notes":["a cup of tea, a piece of cake, a bottle of milk, a kilo of rice"]}],"rules":["Sayılabilen tekil isimler tek başına kullanılmaz; a/an/the/my vb. alır.","Sayılamayan isimler tekil fiil alır: The information is useful.","Yaygın sayılamayanlar: water, money, bread, rice, milk, information, advice, music, homework."],"exceptions":["Türkçede sayılan bazı isimler İngilizcede sayılamaz: advice, information, news, furniture, luggage.","Bazı isimler anlama göre değişir: a coffee (bir fincan kahve) / coffee (kahve, genel)."],"mistakes":[{"wrong":"I need an advice.","right":"I need some advice.","note":"advice sayılamaz; a/an almaz."},{"wrong":"The news are good.","right":"The news is good.","note":"news sayılamaz ve tekil fiil alır."},{"wrong":"two breads","right":"two loaves of bread","note":"Sayılamayan isimler ölçü birimiyle sayılır."}]}},
  {"id":"en-gr-some-any","languageId":"en","category":"grammar","level":"A2","sourceText":"Some / Any","translations":{"tr":["Some / Any (Biraz, Hiç)"]},"grammar":{"summary":"Belirsiz miktar için olumluda some, olumsuz ve soruda any kullanılır.","uses":["Sayılabilen çoğul ve sayılamayan isimlerle belirsiz miktar","Teklif ve rica soruları (some)"],"sections":[{"kind":"other","title":"Olumlu: some","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"some + isim","en":"some + noun","role":"o"}],"examples":[{"text":"[s:I] [v:bought] [o:some apples].","tr":"Birkaç elma aldım."},{"text":"[s:There] [a:is] [o:some milk] in the fridge.","tr":"Buzdolabında biraz süt var."}]},{"kind":"other","title":"Olumsuz: any","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"don't / isn't …","en":"don't / isn't …","role":"a"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"any + isim","en":"any + noun","role":"o"}],"examples":[{"text":"[s:We] [a:don't] [v:have] [o:any bread].","tr":"Hiç ekmeğimiz yok."},{"text":"[s:There] [a:aren't] [o:any chairs].","tr":"Hiç sandalye yok."}]},{"kind":"other","title":"Soru: any","formula":[{"tr":"Do / Is / Are","en":"Do / Is / Are","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"any + isim?","en":"any + noun?","role":"o"}],"examples":[{"text":"[a:Do] [s:you] [v:have] [o:any questions]?","tr":"Hiç sorunuz var mı?"},{"text":"[a:Is] [s:there] [o:any sugar]?","tr":"Hiç şeker var mı?"}]},{"kind":"other","title":"Teklif / rica: some","formula":[{"tr":"Would you like / Can I have","en":"Would you like / Can I have","role":"a"},{"tr":"some + isim?","en":"some + noun?","role":"o"}],"examples":[{"text":"[a:Would you like] [o:some tea]?","tr":"Biraz çay ister misin?"},{"text":"[a:Can I have] [o:some water]?","tr":"Biraz su alabilir miyim?"}]}],"rules":["some ve any sayılabilen çoğul ve sayılamayan isimlerle kullanılır.","Tekil sayılabilen isimle a/an kullanılır: an apple, some apples.","Aynı kural something / anything, someone / anyone için de geçerlidir."],"exceptions":["Olumlu cümlede any \"herhangi\" anlamında kullanılabilir: You can take any book."],"mistakes":[{"wrong":"I don't have some money.","right":"I don't have any money.","note":"Olumsuz cümlede any kullanılır."},{"wrong":"Are there some eggs?","right":"Are there any eggs?","note":"Normal sorularda any kullanılır."},{"wrong":"I have any friends here.","right":"I have some friends here.","note":"Olumlu cümlede some kullanılır."}]}},
  {"id":"en-gr-much-many-a-lot-of","languageId":"en","category":"grammar","level":"A2","sourceText":"Much / Many / A lot of","translations":{"tr":["Much / Many / A lot of (Çok)"]},"grammar":{"summary":"Çok miktar için sayılabilenle many, sayılamayanla much, her ikisiyle a lot of kullanılır.","uses":["Miktar sorma: How much / How many","Olumsuz ve soru cümlelerinde çokluk","Olumlu cümlede günlük dilde a lot of"],"sections":[{"kind":"other","title":"many + sayılabilen çoğul","formula":[{"tr":"many","en":"many","role":"x"},{"tr":"Çoğul isim","en":"Plural noun","role":"o"}],"examples":[{"text":"[s:I] [a:don't] [v:have] [x:many] [o:friends] here.","tr":"Burada pek arkadaşım yok."},{"text":"[a:Are] [s:there] [x:many] [o:people]?","tr":"Çok insan var mı?"}]},{"kind":"other","title":"much + sayılamayan","formula":[{"tr":"much","en":"much","role":"x"},{"tr":"Sayılamayan isim","en":"Uncountable noun","role":"o"}],"examples":[{"text":"[s:We] [a:don't] [v:have] [x:much] [o:time].","tr":"Fazla vaktimiz yok."},{"text":"[a:Did] [s:you] [v:spend] [x:much] [o:money]?","tr":"Çok para harcadın mı?"}]},{"kind":"other","title":"a lot of + her ikisi","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"a lot of","en":"a lot of","role":"x"},{"tr":"İsim","en":"Noun","role":"o"}],"examples":[{"text":"[s:She] [v:has] [x:a lot of] [o:books].","tr":"Çok kitabı var."},{"text":"[s:He] [v:drinks] [x:a lot of] [o:coffee].","tr":"Çok kahve içer."}]},{"kind":"other","title":"How much / How many","formula":[{"tr":"How much / How many","en":"How much / How many","role":"q"},{"tr":"İsim","en":"Noun","role":"o"},{"tr":"Soru yapısı?","en":"Question?","role":"a"}],"examples":[{"text":"[q:How many] [o:brothers] [a:do] [s:you] [v:have]?","tr":"Kaç erkek kardeşin var?"},{"text":"[q:How much] [o:water] [a:do] [s:you] [v:drink]?","tr":"Ne kadar su içersin?"}],"notes":["Fiyat sorarken: How much is it? (Ne kadar?)"]}],"rules":["many sayılabilen çoğul, much sayılamayan isimlerle kullanılır.","much ve many daha çok olumsuz ve soru cümlelerinde kullanılır.","Olumlu cümlede a lot of / lots of daha doğaldır."],"exceptions":["too much / too many / so many olumlu cümlede de doğaldır: There are too many cars."],"mistakes":[{"wrong":"How many money do you have?","right":"How much money do you have?","note":"money sayılamaz; much kullanılır."},{"wrong":"There are much people.","right":"There are a lot of people.","note":"people sayılabilir; olumluda a lot of daha doğal."},{"wrong":"I have a lot friends.","right":"I have a lot of friends.","note":"a lot'tan sonra isim gelirse of gerekir."}]}},
  {"id":"en-gr-must-have-to","languageId":"en","category":"grammar","level":"A2","sourceText":"Must / Have to","translations":{"tr":["Must / Have to (Zorunluluk)"]},"grammar":{"summary":"Zorunluluk için must ve have to, yasak için mustn't, gereksizlik için don't have to kullanılır.","uses":["Konuşanın gerekli gördüğü zorunluluk (must)","Kural veya dış zorunluluk (have to)","Yasak (mustn't)","Gerek olmaması (don't have to)"],"sections":[{"kind":"other","title":"must + fiil","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"must","en":"must","role":"a"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:I] [a:must] [v:study] [o:tonight].","tr":"Bu gece çalışmalıyım."},{"text":"[s:You] [a:must] [v:see] [o:this film]!","tr":"Bu filmi mutlaka izlemelisin!"}]},{"kind":"other","title":"have to / has to + fiil","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"have to / has to","en":"have to / has to","role":"a"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:I] [a:have to] [v:wear] [o:a uniform] at work.","tr":"İşte üniforma giymek zorundayım."},{"text":"[s:She] [a:has to] [v:get up] early.","tr":"Erken kalkmak zorunda."}],"notes":["Geçmiş: had to — I had to wait. (must'ın geçmişi yoktur)"]},{"kind":"other","title":"mustn't (yasak)","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"mustn't","en":"mustn't","role":"a"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:You] [a:mustn't] [v:smoke] [o:here].","tr":"Burada sigara içmemelisin (yasak)."},{"text":"[s:We] [a:mustn't] [v:be] [o:late].","tr":"Geç kalmamalıyız."}]},{"kind":"other","title":"don't have to (gerek yok)","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"don't / doesn't have to","en":"don't / doesn't have to","role":"a"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:You] [a:don't have to] [v:come].","tr":"Gelmek zorunda değilsin."},{"text":"[s:He] [a:doesn't have to] [v:work] [o:on Sundays].","tr":"Pazar günleri çalışmak zorunda değil."}]},{"kind":"other","title":"Soru: Do I have to …?","formula":[{"tr":"Do / Does","en":"Do / Does","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"have to + fiil?","en":"have to + verb?","role":"v"}],"examples":[{"text":"[a:Do] [s:I] [v:have to] pay now?","tr":"Şimdi ödemek zorunda mıyım?"},{"text":"[a:Does] [s:she] [v:have to] work today?","tr":"Bugün çalışmak zorunda mı?"}]}],"rules":["must ve have to'dan sonra fiil yalın gelir.","must tüm öznelerle aynıdır; have to he/she/it ile has to olur.","mustn't = yapma (yasak); don't have to = yapmana gerek yok."],"exceptions":["must'ın geçmiş ve gelecek biçimi yoktur; had to / will have to kullanılır."],"mistakes":[{"wrong":"You mustn't come if you're busy.","right":"You don't have to come if you're busy.","note":"Gerek yok anlamı için don't have to kullanılır."},{"wrong":"I must to go.","right":"I must go.","note":"must'tan sonra to gelmez."},{"wrong":"She have to work.","right":"She has to work.","note":"he/she/it ile has to kullanılır."}]}},
  {"id":"en-gr-should","languageId":"en","category":"grammar","level":"A2","sourceText":"Should","translations":{"tr":["Should (Tavsiye)"]},"grammar":{"summary":"Tavsiye vermek ve doğru olanı söylemek için should kullanılır (-meli, -malı).","uses":["Tavsiye ve öneri verme","Doğru/yanlış olanı söyleme","Fikir sorma: What should I do?"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"should","en":"should","role":"a"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:You] [a:should] [v:see] [o:a doctor].","tr":"Doktora görünmelisin."},{"text":"[s:We] [a:should] [v:leave] [o:now].","tr":"Şimdi çıkmalıyız."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"shouldn't","en":"shouldn't","role":"a"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:You] [a:shouldn't] [v:eat] [o:so much sugar].","tr":"Bu kadar çok şeker yememelisin."},{"text":"[s:He] [a:shouldn't] [v:drive] [o:so fast].","tr":"Bu kadar hızlı araba sürmemeli."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Should","en":"Should","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil (yalın)","en":"Verb (base)","role":"v"},{"tr":"Nesne?","en":"Object?","role":"o"}],"examples":[{"text":"[a:Should] [s:I] [v:call] [o:her]?","tr":"Onu aramalı mıyım?"},{"text":"[a:Should] [s:we] [v:take] [o:a taxi]?","tr":"Taksiye mi binelim?"}]},{"kind":"wh","title":"WH soruları","formula":[{"tr":"Soru kelimesi","en":"Wh-word","role":"q"},{"tr":"should","en":"should","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil (yalın)?","en":"Verb (base)?","role":"v"}],"examples":[{"text":"[q:What] [a:should] [s:I] [v:do]?","tr":"Ne yapmalıyım?"},{"text":"[q:Where] [a:should] [s:we] [v:meet]?","tr":"Nerede buluşalım?"}]}],"rules":["should tüm öznelerle aynıdır; ardından fiil yalın gelir.","Tavsiyeyi yumuşatmak için: I think you should… / I don't think you should…","should, must'tan daha yumuşaktır; zorunluluk değil tavsiyedir."],"exceptions":[],"mistakes":[{"wrong":"You should to rest.","right":"You should rest.","note":"should'dan sonra to gelmez."},{"wrong":"She shoulds go.","right":"She should go.","note":"should ek almaz."},{"wrong":"I think you shouldn't go.","right":"I don't think you should go.","note":"İngilizcede olumsuzluk genellikle think'e verilir."}]}},
  {"id":"en-gr-adverbs-of-frequency","languageId":"en","category":"grammar","level":"A2","sourceText":"Adverbs of Frequency","translations":{"tr":["Sıklık Zarfları"]},"grammar":{"summary":"always, usually, often, sometimes, never gibi zarflar bir şeyin ne sıklıkla olduğunu anlatır.","uses":["Alışkanlıkları ve rutinleri anlatma","How often…? sorusuna cevap verme"],"sections":[{"kind":"other","title":"Ana fiilden önce","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Sıklık zarfı","en":"Adverb of frequency","role":"x"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:I] [x:always] [v:drink] [o:coffee] in the morning.","tr":"Sabahları hep kahve içerim."},{"text":"[s:She] [x:never] [v:eats] [o:meat].","tr":"Hiç et yemez."}],"notes":["always (%100) – usually – often – sometimes – rarely – never (%0)"]},{"kind":"other","title":"be fiilinden sonra","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"be","en":"be","role":"a"},{"tr":"Sıklık zarfı","en":"Adverb of frequency","role":"x"},{"tr":"Nesne","en":"Object","role":"o"}],"examples":[{"text":"[s:He] [a:is] [x:usually] [o:late].","tr":"Genellikle geç kalır."},{"text":"[s:We] [a:are] [x:often] [o:tired] on Fridays.","tr":"Cuma günleri sık sık yorgun oluruz."}]},{"kind":"other","title":"Yardımcı fiilden sonra","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"don't / can / have","en":"don't / can / have","role":"a"},{"tr":"Sıklık zarfı","en":"Adverb of frequency","role":"x"},{"tr":"Fiil","en":"Verb","role":"v"}],"examples":[{"text":"[s:I] [a:don't] [x:often] [v:go] out.","tr":"Pek sık dışarı çıkmam."},{"text":"[s:You] [a:can] [x:always] [v:call] [o:me].","tr":"Beni her zaman arayabilirsin."}]},{"kind":"other","title":"How often …?","formula":[{"tr":"How often","en":"How often","role":"q"},{"tr":"do / does","en":"do / does","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil?","en":"Verb?","role":"v"}],"examples":[{"text":"[q:How often] [a:do] [s:you] [v:exercise]?","tr":"Ne sıklıkla spor yaparsın?"},{"text":"Twice a week.","tr":"Haftada iki kez."}],"notes":["once a day, twice a week, every day gibi ifadeler genelde cümle sonunda gelir."]}],"rules":["Sıklık zarfı ana fiilden önce, be fiilinden sonra gelir.","never zaten olumsuzdur; not ile kullanılmaz.","sometimes ve usually cümle başında da gelebilir: Sometimes I walk to work."],"exceptions":[],"mistakes":[{"wrong":"I go always to school by bus.","right":"I always go to school by bus.","note":"Zarf ana fiilden önce gelir."},{"wrong":"She always is happy.","right":"She is always happy.","note":"be fiilinden sonra gelir."},{"wrong":"I don't never eat fish.","right":"I never eat fish.","note":"never ile not birlikte kullanılmaz."}]}},
  {"id":"en-gr-possessive-pronouns","languageId":"en","category":"grammar","level":"A2","sourceText":"Possessive Pronouns","translations":{"tr":["İyelik Zamirleri (mine, yours…)"]},"grammar":{"summary":"mine, yours, his, hers, ours, theirs; isim yerine geçerek sahipliği gösterir (benimki, seninki).","uses":["İsmi tekrar etmeden sahiplik belirtme","Whose …? sorusuna cevap verme"],"sections":[{"kind":"other","title":"Sıfat → Zamir","formula":[{"tr":"my / your / his / her","en":"my / your / his / her","role":"x"},{"tr":"mine / yours / his / hers","en":"mine / yours / his / hers","role":"o"}],"examples":[{"text":"[s:This] [a:is] [x:my] book. → It's [o:mine].","tr":"Bu benim kitabım. → Benimki."},{"text":"[s:That] [a:is] [x:their] car. → It's [o:theirs].","tr":"O onların arabası. → Onlarınki."}],"notes":["my → mine, your → yours, his → his, her → hers, our → ours, their → theirs"]},{"kind":"other","title":"İsim yerine kullanım","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"be","en":"be","role":"a"},{"tr":"İyelik zamiri","en":"Possessive pronoun","role":"o"}],"examples":[{"text":"[s:This bag] [a:is] [o:hers], not [o:mine].","tr":"Bu çanta onun, benim değil."},{"text":"[s:My room] is small, but [s:yours] [a:is] big.","tr":"Benim odam küçük ama seninki büyük."}]},{"kind":"other","title":"Whose …?","formula":[{"tr":"Whose","en":"Whose","role":"q"},{"tr":"isim","en":"noun","role":"o"},{"tr":"is this / are these?","en":"is this / are these?","role":"a"}],"examples":[{"text":"[q:Whose] [o:phone] [a:is] [s:this]? — It's [o:his].","tr":"Bu kimin telefonu? — Onun."},{"text":"[q:Whose] [o:keys] [a:are] [s:these]? — They're [o:ours].","tr":"Bu anahtarlar kimin? — Bizim."}]}],"rules":["İyelik zamirinden sonra isim gelmez: It's mine. ✓ — It's mine book. ✗","İyelik zamirleri kesme işareti almaz: yours, hers, ours, theirs.","İsimle sahiplik için 's kullanılır: It's Tom's."],"exceptions":["its'in iyelik zamiri biçimi neredeyse hiç kullanılmaz."],"mistakes":[{"wrong":"This is mine car.","right":"This is my car.","note":"İsimden önce sıfat (my) kullanılır."},{"wrong":"The book is your's.","right":"The book is yours.","note":"İyelik zamirleri kesme işareti almaz."},{"wrong":"Is this pen yours or my?","right":"Is this pen yours or mine?","note":"İsim gelmiyorsa mine kullanılır."}]}},
  {"id":"en-gr-too-enough","languageId":"en","category":"grammar","level":"A2","sourceText":"Too / Enough","translations":{"tr":["Too / Enough (Fazla / Yeterli)"]},"grammar":{"summary":"too gereğinden fazlayı, enough yeterli miktarı anlatır.","uses":["Bir şeyin fazla olduğunu söyleme (too hot)","Bir şeyin yeterli olup olmadığını söyleme (old enough, enough money)"],"sections":[{"kind":"other","title":"too + sıfat","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"be","en":"be","role":"a"},{"tr":"too + sıfat","en":"too + adjective","role":"x"},{"tr":"(to + fiil)","en":"(to + verb)","role":"v"}],"examples":[{"text":"[s:This coffee] [a:is] [x:too hot] [v:to drink].","tr":"Bu kahve içilemeyecek kadar sıcak."},{"text":"[s:I] [a:am] [x:too tired].","tr":"Çok yorgunum (fazlasıyla)."}]},{"kind":"other","title":"sıfat + enough","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"be (not)","en":"be (not)","role":"a"},{"tr":"sıfat + enough","en":"adjective + enough","role":"x"},{"tr":"(to + fiil)","en":"(to + verb)","role":"v"}],"examples":[{"text":"[s:She] [a:is] [x:old enough] [v:to drive].","tr":"Araba sürecek yaşta."},{"text":"[s:The room] [a:isn't] [x:big enough].","tr":"Oda yeterince büyük değil."}]},{"kind":"other","title":"enough + isim","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil","en":"Verb","role":"v"},{"tr":"enough + isim","en":"enough + noun","role":"o"}],"examples":[{"text":"[s:We] [a:don't] [v:have] [o:enough time].","tr":"Yeterli vaktimiz yok."},{"text":"[a:Is] [s:there] [o:enough food] for everyone?","tr":"Herkese yetecek kadar yemek var mı?"}]},{"kind":"other","title":"too much / too many + isim","formula":[{"tr":"too much / too many","en":"too much / too many","role":"x"},{"tr":"İsim","en":"Noun","role":"o"}],"examples":[{"text":"[s:You] [v:eat] [x:too much] [o:sugar].","tr":"Çok fazla şeker yiyorsun."},{"text":"[s:There] [a:are] [x:too many] [o:people] here.","tr":"Burada çok fazla insan var."}]}],"rules":["too sıfattan önce gelir: too small.","enough sıfattan sonra, isimden önce gelir: big enough / enough money.","too olumsuz bir anlam taşır; sadece \"çok\" için very kullanılır."],"exceptions":[],"mistakes":[{"wrong":"It's enough big.","right":"It's big enough.","note":"enough sıfattan sonra gelir."},{"wrong":"The film was too good.","right":"The film was very good.","note":"too olumsuz anlam verir; olumlu için very."},{"wrong":"I have too much friends.","right":"I have too many friends.","note":"Sayılabilen çoğulla too many kullanılır."}]}},
  {"id":"en-gr-present-continuous-for-future-plans","languageId":"en","category":"grammar","level":"A2","sourceText":"Present Continuous for Future Plans","translations":{"tr":["Gelecek Planları için Şimdiki Zaman"]},"grammar":{"summary":"Kesinleşmiş, ayarlanmış gelecek planları için Present Continuous kullanılır.","uses":["Saati, yeri belli olan randevu ve planlar","Biletli, ayarlanmış etkinlikler","Genelde tonight, tomorrow, next week gibi zaman ifadesiyle"],"sections":[{"kind":"affirmative","title":"Olumlu cümle","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"am/is/are","en":"am/is/are","role":"a"},{"tr":"Fiil-ing","en":"Verb-ing","role":"v"},{"tr":"Gelecek zaman ifadesi","en":"Future time","role":"o"}],"examples":[{"text":"[s:I] [a:am] [v:meeting] [o:Sara tomorrow].","tr":"Yarın Sara'yla buluşuyorum."},{"text":"[s:We] [a:are] [v:flying] [o:to London on Friday].","tr":"Cuma günü Londra'ya uçuyoruz."}]},{"kind":"negative","title":"Olumsuz cümle","formula":[{"tr":"Özne","en":"Subject","role":"s"},{"tr":"am/is/are + not","en":"am/is/are + not","role":"a"},{"tr":"Fiil-ing","en":"Verb-ing","role":"v"},{"tr":"Gelecek zaman ifadesi","en":"Future time","role":"o"}],"examples":[{"text":"[s:She] [a:isn't] [v:coming] [o:tonight].","tr":"Bu akşam gelmiyor."},{"text":"[s:I] [a:am not] [v:working] [o:next week].","tr":"Gelecek hafta çalışmıyorum."}]},{"kind":"question","title":"Soru cümlesi","formula":[{"tr":"Am/Is/Are","en":"Am/Is/Are","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil-ing","en":"Verb-ing","role":"v"},{"tr":"Zaman ifadesi?","en":"Future time?","role":"o"}],"examples":[{"text":"[a:Are] [s:you] [v:doing] anything [o:this weekend]?","tr":"Bu hafta sonu bir şey yapıyor musun?"},{"text":"[a:Is] [s:he] [v:coming] [o:to the party]?","tr":"Partiye geliyor mu?"}]},{"kind":"wh","title":"WH soruları","formula":[{"tr":"Soru kelimesi","en":"Wh-word","role":"q"},{"tr":"am/is/are","en":"am/is/are","role":"a"},{"tr":"Özne","en":"Subject","role":"s"},{"tr":"Fiil-ing?","en":"Verb-ing?","role":"v"}],"examples":[{"text":"[q:What] [a:are] [s:you] [v:doing] tonight?","tr":"Bu akşam ne yapıyorsun?"},{"text":"[q:When] [a:are] [s:they] [v:leaving]?","tr":"Ne zaman ayrılıyorlar?"}]}],"rules":["Yapı şimdiki zamanla aynıdır; gelecek anlamı zaman ifadesinden anlaşılır.","Planlanıp ayarlanmış (randevu, bilet) durumlar için kullanılır.","Niyet için be going to, anlık karar ve tahmin için will daha doğaldır."],"exceptions":["Tahminlerde kullanılmaz: It will rain tomorrow. ✓ — It is raining tomorrow. ✗"],"mistakes":[{"wrong":"I meet my friend tomorrow.","right":"I'm meeting my friend tomorrow.","note":"Ayarlanmış kişisel planlarda Present Continuous daha doğaldır."},{"wrong":"What do you do tonight?","right":"What are you doing tonight?","note":"Bu akşamki planı sorarken Present Continuous kullanılır."},{"wrong":"Are you come tomorrow?","right":"Are you coming tomorrow?","note":"am/is/are'dan sonra fiil -ing alır."}]}}
]
