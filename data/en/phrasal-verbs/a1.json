[
  {"id":"en-pv-wake-up","languageId":"en","category":"phrasal-verbs","level":"A1","sourceText":"wake up","translations":{"tr":["uyanmak","uyandırmak"]},"partOfSpeech":"verb","details":{"usage":"Nesnesiz \"uyanmak\", nesneyle \"birini uyandırmak\" demektir. Nesne zamirse araya girer: \"wake me up\".","separable":true,"similar":["get up","fall asleep (zıt: uykuya dalmak)"]},"examples":[{"text":"I wake up at seven every day.","tr":"Her gün saat yedide uyanırım."},{"text":"Please wake me up at six.","tr":"Lütfen beni altıda uyandır."}]},
  {"id":"en-pv-get-up","languageId":"en","category":"phrasal-verbs","level":"A1","sourceText":"get up","translations":{"tr":["kalkmak","yataktan kalkmak"]},"partOfSpeech":"verb","details":{"usage":"Yataktan kalkmak ya da ayağa kalkmak. \"wake up\" gözünü açmak, \"get up\" yataktan çıkmaktır.","separable":false,"similar":["wake up","stand up"]},"examples":[{"text":"I usually get up early on weekdays.","tr":"Hafta içi genellikle erken kalkarım."}]},
  {"id":"en-pv-look-for","languageId":"en","category":"phrasal-verbs","level":"A1","sourceText":"look for","translations":{"tr":["aramak"]},"partOfSpeech":"verb","details":{"usage":"Kaybolan ya da ihtiyaç duyulan bir şeyi aramak. Nesne her zaman \"for\"dan sonra gelir. Telefonla aramak \"call\" ile söylenir.","separable":false,"similar":["search for","find (bulmak)"]},"examples":[{"text":"I'm looking for my keys.","tr":"Anahtarlarımı arıyorum."}]},
  {"id":"en-pv-come-back","languageId":"en","category":"phrasal-verbs","level":"A1","sourceText":"come back","translations":{"tr":["geri gelmek","dönmek"]},"partOfSpeech":"verb","details":{"usage":"Bulunulan yere geri dönmek. Nereden döndüğü \"come back from\" ile söylenir.","separable":false,"similar":["return","go back","get back"]},"examples":[{"text":"When are you coming back?","tr":"Ne zaman geri geliyorsun?"}]},
  {"id":"en-pv-go-out","languageId":"en","category":"phrasal-verbs","level":"A1","sourceText":"go out","translations":{"tr":["dışarı çıkmak","(biriyle) çıkmak"]},"partOfSpeech":"verb","details":{"usage":"Eğlenmek için dışarı çıkmak. \"go out with sb\" biriyle sevgili olmak demektir. Işık ya da ateş için \"sönmek\" anlamına da gelir.","separable":false,"similar":["hang out","eat out","stay in (zıt: evde kalmak)"]},"examples":[{"text":"Let's go out tonight.","tr":"Bu akşam dışarı çıkalım."}]},
  {"id":"en-pv-come-in","languageId":"en","category":"phrasal-verbs","level":"A1","sourceText":"come in","translations":{"tr":["içeri girmek"]},"partOfSpeech":"verb","details":{"separable":false},"examples":[{"text":"Come in and sit down.","tr":"Gel içeri, otur."}]},
  {"id":"en-pv-come-from","languageId":"en","category":"phrasal-verbs","level":"A1","sourceText":"come from","translations":{"tr":["-li olmak","gelmek (kaynak)"]},"partOfSpeech":"verb","details":{"separable":false},"examples":[{"text":"Where do you come from?","tr":"Nerelisin?"}]},
  {"id":"en-pv-sit-down","languageId":"en","category":"phrasal-verbs","level":"A1","sourceText":"sit down","translations":{"tr":["oturmak"]},"partOfSpeech":"verb","details":{"separable":false},"examples":[{"text":"Please sit down.","tr":"Lütfen oturun."}]},
  {"id":"en-pv-stand-up","languageId":"en","category":"phrasal-verbs","level":"A1","sourceText":"stand up","translations":{"tr":["ayağa kalkmak"]},"partOfSpeech":"verb","details":{"separable":false,"usage":"stand someone up (ayrılabilir): birini ekmek, randevuya gitmemek."},"examples":[{"text":"Everyone stood up when the judge came in.","tr":"Hâkim içeri girince herkes ayağa kalktı."}]}
