  {"id":"en-pv-run-out-of","languageId":"en","category":"phrasal-verbs","level":"B1","sourceText":"run out of","translations":{"tr":["(bir şey) bitmek","tükenmek"]},"partOfSpeech":"verb","details":{"usage":"Bir şeyin bitip elde kalmaması. Üç parçalıdır ve ayrılmaz: \"We've run out of milk.\" Nesnesiz \"run out\" da kullanılır: \"Time is running out.\"","separable":false,"similar":["use up","run low on","be out of"]},"examples":[{"text":"We've run out of milk.","tr":"Sütümüz bitti."}]},
  {"id":"en-pv-look-forward-to","languageId":"en","category":"phrasal-verbs","level":"B1","sourceText":"look forward to","translations":{"tr":["dört gözle beklemek","sabırsızlıkla beklemek"]},"partOfSpeech":"verb","details":{"usage":"Buradaki \"to\" bir edattır; ardından isim ya da fiil + -ing gelir: \"I look forward to seeing you\" (✗ to see). Resmî e-postaların sonunda sık kullanılır.","separable":false,"similar":["can't wait (for)","be excited about"]},"examples":[{"text":"I'm looking forward to the holiday.","tr":"Tatili dört gözle bekliyorum."},{"text":"I look forward to hearing from you.","tr":"Sizden haber almayı sabırsızlıkla bekliyorum."}]},
