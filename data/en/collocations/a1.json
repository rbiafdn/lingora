  {"id":"en-coll-take-a-photo","languageId":"en","category":"collocations","level":"A1","sourceText":"take a photo","translations":{"tr":["fotoğraf çekmek"]},"details":{"usage":"Türkçede \"çekmek\" dense de İngilizcede \"take\" kullanılır; \"pull a photo\" yanlıştır, \"make a photo\" da doğal değildir. Birinin fotoğrafını çekmek: take a photo of someone.","related":["take a picture","take a selfie","take notes"]},"examples":[{"text":"Can you take a photo of us?","tr":"Bizim bir fotoğrafımızı çekebilir misin?"}]},
  {"id":"en-coll-take-a-shower","languageId":"en","category":"collocations","level":"A1","sourceText":"take a shower","translations":{"tr":["duş almak"]},"details":{"usage":"Banyo ve dinlenme gibi kişisel eylemler \"take\" ya da \"have\" ile kurulur: \"take a shower\" daha çok Amerikan, \"have a shower\" daha çok İngiliz İngilizcesidir. \"do a shower\" ya da \"make a shower\" denmez.","related":["have a shower (BrE)","take a bath","take a nap"]},"examples":[{"text":"I take a shower every morning.","tr":"Her sabah duş alırım."}]},
  {"id":"en-coll-have-breakfast","languageId":"en","category":"collocations","level":"A1","sourceText":"have breakfast","translations":{"tr":["kahvaltı yapmak"]},"details":{"usage":"Öğünler \"have\" ile kullanılır ve öğün adından önce genelde \"a / the\" gelmez (have breakfast, have lunch). \"make breakfast\" ise kahvaltıyı hazırlamak demektir; \"do breakfast\" yanlıştır.","related":["have lunch","have dinner","make breakfast"]},"examples":[{"text":"We have breakfast at seven.","tr":"Saat yedide kahvaltı yaparız."}]},
  {"id":"en-coll-have-fun","languageId":"en","category":"collocations","level":"A1","sourceText":"have fun","translations":{"tr":["eğlenmek","iyi vakit geçirmek"]},"details":{"usage":"fun sayılamaz: \"have a fun\" yanlış."},"examples":[{"text":"Have fun at the party!","tr":"Partide iyi eğlenceler!"}]},
  {"id":"en-coll-have-lunch","languageId":"en","category":"collocations","level":"A1","sourceText":"have lunch","translations":{"tr":["öğle yemeği yemek"]},"details":{"usage":"Öğün adlarıyla \"eat\" değil genelde have; artikel yok: have lunch."},"examples":[{"text":"Let's have lunch together.","tr":"Birlikte öğle yemeği yiyelim."}]},
  {"id":"en-coll-have-dinner","languageId":"en","category":"collocations","level":"A1","sourceText":"have dinner","translations":{"tr":["akşam yemeği yemek"]},"details":{"usage":"\"have a dinner\" yanlış (özel bir yemek değilse)."},"examples":[{"text":"We usually have dinner at seven.","tr":"Genelde yedide akşam yemeği yeriz."}]},
